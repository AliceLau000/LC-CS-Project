d7ba77615": "\u901a\u8fc7\u73b0\u6709GFW\u5217\u8868\uff08\u5373\u884c\u653f\u533a\u57df\u3001\u6cb9\u68d5\u7279\u8bb8\u7ecf\u8425\u533a\u3001\u68d5\u6988\u6cb9\u5382\u3001\u4fdd\u62a4\u533a\u57df\u3001RSPO\u6cb9\u68d5\u7279\u8bb8\u7ecf\u8425\u533a\uff09\u521b\u5efa\u81ea\u5b9a\u4e49\u5217\u8868\u3002&nbsp;", "9125e0c12790b2d3de07b8832e4ca790": "\u67e5\u770b\u548c\u4e0b\u8f7d\u8d35\u7ec4\u7ec7\u8d26\u53f7\u4e2d\u6240\u6709\u7528\u6237\u7684\u6d3b\u52a8\u65e5\u5fd7\u3002&nbsp;", "b548d558b7d72463923a2286302ee246": "\u5317\uff08N\uff09\u548c\u4e1c\uff08E\uff09\u4e3a\u6b63\u503c\u3002&nbsp;", "7d7902e94af902f8ebd7ee47e01413d7": "\u5982\u679c\u4e0d\u614e\u5fd8\u8bb0\u8fd9\u4e00\u70b9\uff0c\u60a8\u7684\u70b9\u53ef\u80fd\u4f1a\u51fa\u73b0\u5728\u5730\u7403\u4e0a\u9519\u8bef\u7684\u4e00\u4fa7&nbsp;", "83041f03fb636f0c5aa1a884aa678ba6": "\u67e5\u770bGFW\u5217\u8868\u3001\u60a8\u7684\u5217\u8868\u4ee5\u53ca\u5171\u4eab\u7ed9\u60a8\u7684\u5217\u8868\u7684\u8bca\u65ad\u548c\u63a7\u5236\u9762\u677f\u7ed3\u679c\u3002", "ced7e904e8ed704bbbef390fef5a94ff": "\u4ee5\u4e0b\u6982\u8ff0\u4e86\u51c6\u5907\u5c06shapefile\u4e0a\u4f20\u5230GFW Pro\uff08Pro\uff09\u65f6\u7684\u63a8\u8350\u5de5\u4f5c\u6d41\u3002\u65e0\u8bba\u662fGIS\u65b0\u7528\u6237\u8fd8\u662f\u7ecf\u9a8c\u4e30\u5bcc\u7684GIS\u5206\u6790\u5e08\uff0c\u90fd\u5e94\u67e5\u770b\u8fd9\u4e9b\u6b65\u9aa4\uff0c\u4ee5\u4fbf\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u6f5c\u5728\u7684Pro\u6570\u636e\u4e0a\u4f20\u9519\u8bef\u3002&nbsp;", "1b1e066112cc853c73662c0db0f8bbb8": "\u5982\u679c\u6570\u636e\u4e2d\u7684\u67d0\u4e2a\u8981\u7d20\u4e0eGADM\u6570\u636e\u4e2d\u7684\u4efb\u4f55\u56fd\u5bb6\u90fd\u4e0d\u91cd\u53e0\uff0c\u60a8\u9700\u8981\u5c06\u5176\u79fb\u9664\u6216\u7f16\u8f91\u5176\u4f4d\u7f6e\u3002\u5173\u4e8e\u5728QGIS\u4e2d\u7f16\u8f91\u6570\u636e\u7684\u66f4\u591a\u4fe1\u606f\u8bf7\u89c1<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u3002&nbsp;", "2dee688bf5b115a22004745dbec42b1b": "\u4e0a\u4f20\u5230Pro\u7684shapefile\u5fc5\u987b\u4e3a\u70b9\u6216\u591a\u8fb9\u5f62\u51e0\u4f55\u56fe\u5f62\u3002\u70b9shapefile\u4ee3\u8868\u7cbe\u786e\u4f4d\u7f6e\uff0c\u5177\u6709\u7ecf\u5ea6\u548c\u7eac\u5ea6\u503c\u3002\u591a\u8fb9\u5f62shapefile\u4ee3\u8868\u5177\u6709\u9762\u79ef\u6216\u5f62\u72b6\u7684\u4f4d\u7f6e\u3002\u5177\u6709\u7ebf\u51e0\u4f55\u56fe\u5f62\u7684shapefile\u5fc5\u987b\u5728\u4e0a\u4f20\u5230Pro\u4e4b\u524d\u8f6c\u6362\u4e3a\u591a\u8fb9\u5f62\u3002&nbsp;", "088e09daeb327f34ba2014ff2453670d": "\u5982\u9700\u5728QGIS\u4e2d\u68c0\u67e5shapefile\u51e0\u4f55\u56fe\u5f62\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\u3002&nbsp;", "52c098f4ccd0a3f1d89eb63c67a39cb1": "\u5728\u201d\u6d4f\u89c8\u5668\u201c\u9762\u677f\u4e2d\u53f3\u952e\u5355\u51fb\u8f93\u5165\u7684shapefile\uff0c\u9009\u62e9\u201c\u56fe\u5c42\u5c5e\u6027\u201c\u3002\u5728\u201d\u56fe\u5c42\u5c5e\u6027\u201c\u7a97\u53e3\u7684\u201c\u4fe1\u606f\u201d\u6807\u7b7e\u9875\u4e0b\uff0c\u5728\u201c\u6765\u81ea\u63d0\u4f9b\u8005\u7684\u4fe1\u606f\u201d\u9879\u4e0b\u53ef\u627e\u5230\u51e0\u4f55\u56fe\u5f62\u4fe1\u606f\u3002&nbsp;", "c3c5a92fd30c85a69195683b164b3a7c": "\u5982\u9700\u5c06\u7ebf\u8f6c\u6362\u4e3a\u591a\u8fb9\u5f62\uff0c\u8bf7\u6253\u5f00\u201d\u5de5\u5177\u7bb1\u201c\u9762\u677f\uff0c\u5728\u201c\u77e2\u91cf\u51e0\u4f55\u56fe\u5f62\u201d\u6807\u7b7e\u9875\u4e0b\u9009\u62e9\u201c\u591a\u8fb9\u5f62\u5316\u201d\u5de5\u5177\u3002\u60a8\u53ef\u4ee5\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">StackExchange</a>\u4e2d\u4e86\u89e3\u5982\u4f55\u5728QGIS\u4e2d\u901a\u8fc7\u7ebf\u521b\u5efa\u591a\u8fb9\u5f62\u3002&nbsp;", "ed9d75be3063f043cb8a1d8c5ee658d2": "\u53f3\u952e\u5355\u51fb\u76ee\u5f55\u4e2d\u7684shapefile\uff0c\u6253\u5f00\u5c5e\u6027\u8868\u3002\u201c\u56fe\u5f62\u201d\u5b57\u6bb5\u5e94\u663e\u793a\u4e3a\u201c\u70b9\u201d\u6216\u201c\u591a\u8fb9\u5f62\u201d\u3002&nbsp;", "cf4799d3d5e3569aba9a6be191087378": "\u5982\u9700\u5c06\u7ebf\u8f6c\u6362\u4e3a\u591a\u8fb9\u5f62\uff0c\u8bf7\u4f7f\u7528\u201c\u6570\u636e\u7ba1\u7406\u201d\u5de5\u5177\u7bb1\u4e2d\u201c\u8981\u7d20\u201d\u5de5\u5177\u96c6\u4e2d\u7684\u201c\u8981\u7d20\u8f6c\u9762\u201d\u5de5\u5177\u3002&nbsp;", "5d3a9cae211085d5268d954b7978f5a1": "\u786e\u4fdd\u6570\u636e\u4f4d\u4e8e\u9646\u5730\u4e0a\u3002&nbsp;", "577e5776defaa471fd7cedc9717d79f9": "\u68c0\u67e5shapefile\u7684\u4f4d\u7f6e&nbsp;", "b7c997b10dd17e9b1b072360d170fcaa": "\u6240\u6709\u4f4d\u7f6e\u5fc5\u987b\u4f4d\u4e8e\u9646\u5730\u4e0a\uff0c\u5426\u5219Pro\u5c06\u8fd4\u56de\u9519\u8bef\u3002\u5982\u9700\u68c0\u67e5\u4f4d\u7f6e\uff0c\u60a8\u53ef\u4ee5\u5c06\u5176\u4e0e<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">GADM\u884c\u653f\u8fb9\u754c</a>\u6bd4\u8f83\uff08\u53ef\u6309\u56fd\u5bb6\u4e0b\u8f7d\uff09\u3002\u5982\u679c\u60a8\u7684\u6240\u6709\u4f4d\u7f6e\u90fd\u5728\u9646\u5730\u4e0a\uff0c\u4f46\u4ecd\u6536\u5230\u9519\u8bef\u6d88\u606f\uff0c\u8bf7\u53c2\u9605<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u7528\u6237\u652f\u6301\u95ee\u9898</a>\u83b7\u53d6\u66f4\u591a\u4fe1\u606f\u3002&nbsp;", "5e33b66beea61a1f925917845f79271f": "\u5982\u9700\u5728QGIS\u4e2d\u68c0\u67e5shapefile\u7684\u4f4d\u7f6e\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\u3002&nbsp;", "9ad603037260d588e4ee88267b78c171": "\u70b9\u51fbQGIS\u7f51\u9875\u9876\u90e8\u7684\u201c\u77e2\u91cf\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u7814\u7a76\u5de5\u5177\u201d\u548c\u201c\u6309\u4f4d\u7f6e\u9009\u62e9\u201d\u3002\u9009\u62e9\u60a8\u7684\u6570\u636e\u4f5c\u4e3a\u8f93\u5165\u5185\u5bb9\uff0c\u9009\u62e9GADM\u8fb9\u754c\u4f5c\u4e3a\u6bd4\u8f83\u56fe\u5c42\u3002\u5728\u53ef\u7528\u9009\u9879\u4e2d\u9009\u62e9\u201c\u76f8\u4ea4\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u8fd0\u884c\u201d\u3002&nbsp;", "9d957d2133df17892fb7ddada3f5cfa4": "\u8fd0\u884c\u5de5\u5177\u540e\uff0c\u6253\u5f00\u5c5e\u6027\u8868\u3002\u6240\u6709\u4ee5\u84dd\u8272\u9ad8\u4eae\u663e\u793a\u7684\u884c\u5747\u4ee3\u8868\u4e0eGADM\u6570\u636e\u91cd\u53e0\u4e14\u4f4d\u4e8e\u9646\u5730\u4e0a\u7684\u8981\u7d20\u3002\u5982\u679c\u672a\u9009\u4e2d\u67d0\u4e2a\u8981\u7d20\uff0c\u8bf7\u5c1d\u8bd5\u5c06\u5176\u4e0e\u90bb\u8fd1\u56fd\u5bb6\u7684\u8fb9\u754c\u8fdb\u884c\u6bd4\u8f83\u3002&nbsp;", "15b5a99ea9bc2a229610da3fed98f6b5": "\u70b9\u51fbQGIS\u7a97\u53e3\u9876\u90e8\u83dc\u5355\u4e2d\u7684\u201c\u77e2\u91cf\u201d\uff0c\u7136\u540e\u9009\u62e9\u201c\u6570\u636e\u7ba1\u7406\u5de5\u5177\u201d\u548c\u201c\u5408\u5e76\u77e2\u91cf\u56fe\u5c42\u201d\u3002\u9009\u62e9\u60a8\u7684\u6570\u636e\u548c\u6a21\u677fshapefile\u4f5c\u4e3a\u8f93\u5165\u5185\u5bb9\uff0c\u7136\u540e\u8fd0\u884c\u8be5\u5de5\u5177\u3002&nbsp;", "b81cccd72aed1f924009895b4e692090": "\u53f3\u952e\u5355\u51fb\u201d\u6d4f\u89c8\u5668\u201c\u9762\u677f\u4e2d\u7684\u65b0\u56fe\u5c42\uff0c\u6253\u5f00\u5c5e\u6027\u8868\u3002\u5982\u9700\u5feb\u901f\u8bc6\u522b\u591a\u4f59\u8981\u7d20\uff0c\u53ef\u53cc\u51fb\u5c5e\u6027\u8868\u4e2d\u7684\u4efb\u610f\u5217\u4ee5\u6392\u5e8f\u3002\u6a21\u677f\u5c5e\u6027\u8868\u4e2d\u7684\u6bcf\u4e00\u5217\u5747\u5df2\u586b\u5199\uff0c\u56e0\u6b64\uff0c\u8be5\u5185\u5bb9\u4f1a\u88ab\u79fb\u52a8\u5230\u7b2c\u4e00\u884c\u3002&nbsp;", "d5cee3a1788140ccfc5a0ca0fffecf3d": "\u5982\u9700\u586b\u5199\u5c5e\u6027\u8868\uff0c\u60a8\u9700\u8981\u542f\u7528\u7f16\u8f91\u5668\u3002\u5982\u679c\u60a8\u60f3\u586b\u5199\u8868\u683c\u4e2d\u7684\u5355\u4e2a\u5355\u5143\u683c\uff0c\u53ef\u4ee5\u70b9\u51fb\u8be5\u5355\u5143\u683c\uff0c\u7136\u540e\u5f00\u59cb\u8f93\u5165\u3002\u60a8\u53ef\u4ee5\u4f7f\u7528\u5b57\u6bb5\u8ba1\u7b97\u5668\u4e3a\u6574\u4e2a\u5217\u8d4b\u503c\u3002\u70b9\u51fb\u5c5e\u6027\u8868\u7a97\u53e3\u9876\u90e8\u7c7b\u4f3c\u7b97\u76d8\u7684\u56fe\u6807\u6253\u5f00\u5b57\u6bb5\u8ba1\u7b97\u5668\u3002&nbsp;", "6a2c62db71ad1f79b76fcd3f2932346f": "\u5982\u679c\u6570\u636e\u4e2d\u7684\u67d0\u4e2a\u8981\u7d20\u4e0eGADM\u6570\u636e\u4e2d\u7684\u4efb\u4f55\u56fd\u5bb6\u90fd\u4e0d\u91cd\u53e0\uff0c\u60a8\u9700\u8981\u5c06\u5176\u79fb\u9664\u6216\u7f16\u8f91\u5176\u4f4d\u7f6e\u3002\u5173\u4e8e\u5728ArcGIS\u4e2d\u7f16\u8f91\u6570\u636e\u7684\u66f4\u591a\u4fe1\u606f\u8bf7\u89c1<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u3002&nbsp;", "56e323be20ccedeb88e5b2c5b44124ad": "\u6587\u4ef6\u7c7b\u578b\u5305\u62ecCSV\u6216Excel\u6587\u4ef6\u3001\u5305\u542bshapefile\u7684zip\u6587\u4ef6\uff0c\u6216KML/KMZ\u6587\u4ef6\u3002\u5728\u63a8\u8fdb\u201c\u6dfb\u52a0\u4f4d\u7f6e\u201d\u5de5\u4f5c\u6d41\u65f6\uff0c\u9009\u62e9\u201c\u6587\u4ef6\u4e0a\u4f20\u201d\uff0c\u7136\u540e\u9009\u62e9\u201c\u6570\u636e\u6a21\u677f\u201d\u3002\u60a8\u53ef\u4ee5\u5728\u6b64\u5904\u9009\u62e9\u6bcf\u79cd\u6570\u636e\u7c7b\u578b\uff0c\u9605\u8bfb\u66f4\u591a\u5173\u4e8e\u6240\u9700\u5b57\u6bb5\u7684\u4fe1\u606f\uff0c\u4e86\u89e3\u6570\u636e\u7c7b\u578b\u6700\u9002\u7528\u7684\u573a\u666f\uff0c\u8bbf\u95ee\u5e2e\u52a9\u4e2d\u5fc3\u6587\u7ae0\u7684\u94fe\u63a5\uff0c\u4e0b\u8f7d\u6587\u4ef6\u6a21\u677f\u3002\u8bf7\u53c2\u8003\u6211\u4eec\u5173\u4e8e\u5982\u4f55<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u9009\u62e9\u5e76\u4e0b\u8f7d\u6a21\u677f</a>\u7684\u6307\u5357\uff0c\u83b7\u53d6\u8be6\u7ec6\u8bf4\u660e\u3002&nbsp;", "26cc24d0558c0842c40b89b8157805fe": "GFW Pro\u6839\u636e\u60a8\u7684\u6570\u636e\u683c\u5f0f\u63d0\u4f9b\u4e0d\u540c\u7684\u6570\u636e\u6a21\u677f\u3002\u5c06\u6587\u4ef6\u4e0a\u4f20\u5230GFW Pro\u8d26\u53f7\u65f6\uff0c\u5fc5\u987b\u786e\u4fdd\u6570\u636e\u683c\u5f0f\u6b63\u786e\uff0c\u4ee5\u4fbf\u4e0e\u76f8\u5173\u6a21\u677f\u5339\u914d\u3002&nbsp;", "5051f1c877b76839962a60adf7190c35": "\u5728\u9009\u62e9<strong>shapefile</strong>\u6a21\u677f\uff08\u591a\u8fb9\u5f62\u6216\u70b9\uff09\u65f6\uff0c\u8bf7\u786e\u4fdd\u6a21\u677fshapefile\u7684\u51e0\u4f55\u56fe\u5f62\u4e0e\u60a8\u6570\u636e\u4e2d\u7684\u51e0\u4f55\u56fe\u5f62\u76f8\u5339\u914d\uff0c\u5426\u5219\uff0c\u60a8\u5c06\u65e0\u6cd5\u5408\u5e762\u4e2a\u6587\u4ef6\u3002\u4e0b\u8f7d\u6a21\u677fshapefile\u540e\uff0c\u8bf7\u5728GIS\u8f6f\u4ef6\u4e2d\u52a0\u8f7d\u5e76\u6253\u5f00\u5c5e\u6027\u8868\u3002\u5728\u547d\u540d\u89c4\u5219\u65b9\u9762\uff0cshapefile\u7684\u5b57\u6bb5\u540d\u79f0\u6700\u591a\u5305\u542b10\u4e2a\u5b57\u7b26\uff0c\u6240\u6709\u7a7a\u683c\u5747\u5c06\u66ff\u6362\u4e3a\u4e0b\u5212\u7ebf\u3002&nbsp;", "26cd66add676415062b0a9bf6bbe4c91": "\u60a8\u53ef\u4ee5\u4f7f\u7528\u591a\u4e2a\u5de5\u5177\uff0c\u5c06\u6240\u9700\u5b57\u6bb5\u6dfb\u52a0\u5230\u60a8\u7684\u6570\u636e\u4e2d\u3002\u6700\u5feb\u7684\u65b9\u6cd5\u662f\u5c06\u6570\u636e\u4e0e\u6a21\u677fshapefile\u5408\u5e76\u3002\u6b64\u64cd\u4f5c\u5c06\u521b\u5efa\u4e00\u4e2a\u65b0shapefile\uff0c\u5305\u542b\u6570\u636e\u5c5e\u6027\u548c\u8981\u7d20\uff0c\u4ee5\u53ca\u6240\u9700\u5b57\u6bb5\u3002\u4f46\u662f\uff0c\u6b64\u64cd\u4f5c\u4f1a\u5c06\u4e00\u4e2a\u989d\u5916\u7684\u8981\u7d20\u6dfb\u52a0\u5230\u6a21\u677f\u4e2d\uff0c\u9700\u5c06\u5176\u79fb\u9664\u3002\u4ee5\u4e0b\u6b65\u9aa4\u5c06\u6307\u5bfc\u60a8\u5b8c\u6210\u6574\u4e2a\u6d41\u7a0b\u3002\u5982\u679c\u60a8\u4e0d\u614e\u79fb\u9664\u4e86\u67d0\u4e2a\u5b57\u6bb5\uff0c\u53ef\u624b\u52a8\u5c06\u5176\u6dfb\u52a0\u5230\u5c5e\u6027\u8868\u4e2d\u3002\u5982\u679c\u60a8\u5728\u4f7f\u7528\u5408\u5e76\u5de5\u5177\u65f6\u8f6f\u4ef6\u62a5\u9519\uff0c\u8bf7\u68c0\u67e5\u4ee5\u4e0b\u51e0\u70b9\u3002&nbsp;", "aa2d7cd41ab0afb945e4eba281f5aedd": "\u60a8\u7684\u6570\u636e\u4e0e\u6a21\u677fshapefile\u7684\u51e0\u4f55\u56fe\u5f62\u5fc5\u987b\u76f8\u540c\u3002\u6362\u8a00\u4e4b\uff0c\u5177\u6709\u591a\u8fb9\u5f62\u51e0\u4f55\u56fe\u5f62\u7684shapefile\u65e0\u6cd5\u4e0e\u5177\u6709\u70b9\u51e0\u4f55\u56fe\u5f62\u7684shapefile\u5408\u5e76\u3002\u8bf7\u518d\u6b21\u68c0\u67e5\u51e0\u4f55\u56fe\u5f62\uff0c\u5982\u6709\u9700\u8981\uff0c\u8bf7\u4e0b\u8f7d\u9002\u5f53\u7684\u6a21\u677fshapefile\u3002&nbsp;", "3f5429a57638d2702dfe29f8b6ae6de7": "\u5982\u679c\u60a8\u6b63\u5728\u5904\u7406\u591a\u8fb9\u5f62\u6570\u636e\uff0c\u95ee\u9898\u53ef\u80fd\u662f\u7531\u51e0\u4f55\u56fe\u5f62\u9519\u8bef\u5f15\u8d77\u7684\u3002\u8bf7\u53c2\u8003\u6559\u7a0b\u7ed3\u5c3e\u7684\u201c\u4fee\u590d\u51e0\u4f55\u56fe\u5f62\u9519\u8bef\u201d\u90e8\u5206\uff0c\u83b7\u53d6\u66f4\u591a\u4fe1\u606f\u3002&nbsp;", "cd25899e0075ed46db19033ea481a86b": "\u5982\u9700\u83b7\u53d6\u5173\u4e8e\u4e0d\u540c\u6a21\u677f\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u70b9\u51fb<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u3002&nbsp;", "d0e56fc5248c8bd243085a5652ce4c57": "\u5728QGIS\u4e2d\u5c06\u60a8\u7684\u6570\u636e\u4e0e\u6a21\u677fshapefile\u5408\u5e76&nbsp;", "cef4d3b2917ec1a37de65bba2190b032": "\u5982\u9700\u5728QGIS\u4e2d\u901a\u8fc7\u5408\u5e76Pro\u6a21\u677fshapefile\u4e0e\u611f\u5174\u8da3\u533a\u57df\u7684shapefile\u6765\u6dfb\u52a0\u6240\u9700\u5b57\u6bb5\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\u3002&nbsp;", "06f95b37021d40e9dab0b28d2b0af741": "\u4ee5\u4e0b\u8fc7\u7a0b\u9700\u8981\u624b\u52a8\u7f16\u8f91\u60a8\u7684\u6570\u636e\u3002\u5173\u4e8eQGIS\u4e2d\u7f16\u8f91\u5de5\u5177\u7684\u8be6\u7ec6\u4fe1\u606f\uff0c\u8bf7\u53c2\u89c1<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u2014\u2014\u638c\u63e1\u8fd9\u4e9b\u4fe1\u606f\u5bf9GIS\u65b0\u7528\u6237\u5c24\u4e3a\u6709\u7528\u3002\u5728\u7f16\u8f91\u6570\u636e\u65f6\uff0c\u8bf7\u8bb0\u5f97\u9891\u7e41\u4fdd\u5b58\u3002&nbsp;", "6f1d6087f96157c64481312383a1ca6e": "\u4ee5\u4e0b\u8fc7\u7a0b\u9700\u8981\u624b\u52a8\u7f16\u8f91\u60a8\u7684\u6570\u636e\u3002\u5173\u4e8eArcGIS\u4e2d\u7f16\u8f91\u5de5\u5177\u7684\u8be6\u7ec6\u4fe1\u606f\uff0c\u8bf7\u53c2\u89c1<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u2014\u2014\u638c\u63e1\u8fd9\u4e9b\u4fe1\u606f\u5bf9GIS\u65b0\u7528\u6237\u5c24\u4e3a\u6709\u7528\u3002\u5728\u7f16\u8f91\u6570\u636e\u65f6\uff0c\u8bf7\u8bb0\u5f97\u9891\u7e41\u4fdd\u5b58\u3002&nbsp;", "81aef810e4769a8c89af02b0c3537387": "\u70b9\u51fbArcMap\u7f51\u9875\u9876\u90e8\u83dc\u5355\u4e2d\u7684\u201c\u5730\u7406\u5904\u7406\u201d\uff0c\u7136\u540e\u9009\u62e9\u201c\u5408\u5e76\u201d\u3002\u9009\u62e9\u60a8\u7684\u6570\u636e\u548c\u6a21\u677fshapefile\u4f5c\u4e3a\u8f93\u5165\u5185\u5bb9\uff0c\u7136\u540e\u8fd0\u884c\u8be5\u5de5\u5177\u3002&nbsp;", "12cd81eeb2507b6ffd7137585e70634f": "\u5982\u9700\u7528\u60a8\u7684\u6570\u636e\u586b\u5199\u5c5e\u6027\u8868\uff0c\u60a8\u9700\u8981\u91cd\u65b0\u542f\u7528\u7f16\u8f91\u5668\u3002\u5982\u9700\u7f16\u8f91\u8868\u4e2d\u7684\u5355\u4e2a\u5355\u5143\u683c\uff0c\u4ec5\u9700\u70b9\u51fb\u8be5\u5355\u5143\u683c\uff0c\u7136\u540e\u5f00\u59cb\u8f93\u5165\u5373\u53ef\u3002\u60a8\u4e5f\u53ef\u4ee5\u4f7f\u7528\u5b57\u6bb5\u8ba1\u7b97\u5668\uff0c\u4e00\u6b21\u6027\u7f16\u8f91\u6574\u4e2a\u5217\u3002&nbsp;", "dc93d692f79a13eb6c5275898f9ca247": "\u60a8\u53ef\u4ee5\u53cc\u51fb\u5b57\u6bb5\u8ba1\u7b97\u5668\u6587\u672c\u6846\u4e0a\u65b9\u5217\u8868\u4e2d\u7684\u5b57\u6bb5\uff0c\u5c06\u503c\u4ece\u8be5\u5b57\u6bb5\u503c\u590d\u5236\u5230\u53e6\u4e00\u4e2a\u5b57\u6bb5\u3002&nbsp;", "10306bb72fc4651d9f41aa6e9c9c9aec": "\u60a8\u53ef\u4ee5\u8f93\u5165\u60a8\u60f3\u590d\u5236\u7684\u5b57\u6bb5\u540d\u79f0\uff0c\u5e76\u7528\u53cc\u5f15\u53f7\u62ec\u4f4f\uff08\u201c\u2026\u201d\uff09\uff0c\u4ece\u800c\u5c06\u503c\u4ece\u4e00\u4e2a\u5b57\u6bb5\u590d\u5236\u5230\u53e6\u4e00\u4e2a\u5b57\u6bb5\u3002\u67d0\u4e9b\u5b57\u6bb5\u4ec5\u63a5\u53d7\u6570\u5b57\u503c\uff0c\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u60a8\u5c06\u9700\u8981\u5c1d\u8bd5\u5c06\u503c\u590d\u5236\u5230\u5176\u4ed6\u5b57\u6bb5\u3002&nbsp;", "5a4cc42b06e93e624e57c09b0337a76a": "\u5728\u5b57\u6bb5\u8ba1\u7b97\u5668\u7a97\u53e3\uff0c\u52fe\u9009\u201c\u66f4\u65b0\u73b0\u6709\u5b57\u6bb5\u201d\uff0c\u4ece\u4e0b\u62c9\u83dc\u5355\u4e2d\u9009\u62e9\u60a8\u60f3\u7f16\u8f91\u7684\u5b57\u6bb5\u3002\u60a8\u60f3\u6dfb\u52a0\u7684\u503c\u5c06\u8f93\u5165\u201c\u8868\u8fbe\u5f0f\u201d\u6807\u7b7e\u9875\u4e0b\u7684\u6846\u4e2d\u3002\u60a8\u67093\u79cd\u8f93\u5165\u503c\u7684\u9009\u9879\u3002&nbsp;", "88ef7a4a190499a03478606cb8c2fcbe": "\u5982\u9700\u8f93\u5165\u6587\u672c\u503c\uff0c\u60a8\u53ef\u4ee5\u5c06\u6587\u672c\u8f93\u5165\u8868\u8fbe\u5f0f\u4e2d\uff0c\u5e76\u7528\u5355\u5f15\u53f7\u62ec\u4f4f\uff08\u2018\u2026\u2019\uff09\u3002\u60a8\u65e0\u6cd5\u5c06\u6587\u672c\u586b\u5165\u6570\u503c\u5b57\u6bb5\u3002&nbsp;", "1a9d09ab8bfda15b61fd8e1efa4c75d9": "\u5982\u9700\u8f93\u5165\u6570\u5b57\u503c\uff0c\u60a8\u4ec5\u9700\u8f93\u5165\u6570\u5b57\u5373\u53ef\u3002&nbsp;", "4a5b1cefa74cc07fddedaa9037e65347": "\u6dfb\u52a0\u65b0\u5b57\u6bb5\u65f6\uff0c\u7cfb\u7edf\u4f1a\u63d0\u793a\u60a8\u8f93\u5165\u5b57\u6bb5\u540d\u79f0\u548c\u6570\u636e\u7c7b\u578b\u3002\u5b57\u6bb5\u540d\u79f0\u662f\u6a21\u677f\u4e2d\u7684\u524d10\u4e2a\u5b57\u7b26\uff0c\u6240\u6709\u7a7a\u683c\u5747\u5c06\u66ff\u6362\u4e3a\u4e0b\u5212\u7ebf\u3002\u5982\u9700\u521b\u5efa\u5305\u542b\u6587\u672c\u7684\u5b57\u6bb5\uff0c\u8bf7\u9009\u62e9\u201c\u5b57\u7b26\u4e32\u201d\u4f5c\u4e3a\u6570\u636e\u7c7b\u578b\uff1b\u5bf9\u4e8e\u6570\u5b57\u503c\uff0c\u8bf7\u9009\u62e9\u201c\u5c0f\u6570\u503c\u201d\uff08\u4e5f\u79f0\u4e3a\u201c\u53cc\u7cbe\u5ea6\u201d\uff09\u3002&nbsp;", "6ce9ccb5479070210a8ca4b0d0bf7ea6": "\u8bf7\u8bb0\u5f97\u4fdd\u5b58\u60a8\u7684\u64cd\u4f5c\uff0c\u5e76\u4ed4\u7ec6\u68c0\u67e5\u5b57\u6bb5\u662f\u5426\u586b\u5165\u4e86\u60a8\u504f\u597d\u7684\u503c\u3002&nbsp;", "38f06dac64a2f8734eef351642c1aed4": "\u5728ArcGIS\u4e2d\u5c06\u60a8\u7684\u6570\u636e\u4e0e\u6a21\u677fshapefile\u5408\u5e76&nbsp;", "086fdaeac5649bc5cf870663c4e54bbf": "\u5982\u9700\u5728ArcGIS\u4e2d\u901a\u8fc7\u5408\u5e76Pro\u6a21\u677fshapefile\u4e0e\u611f\u5174\u8da3\u533a\u57df\u7684shapefile\u6765\u6dfb\u52a0\u6240\u9700\u5b57\u6bb5\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\u3002&nbsp;", "2143ddba7a2e011fb10a821d939b3c71": "\u521b\u5efa\u538b\u7f29\u6587\u4ef6\u5939\u4ee5\u5b58\u50a8\u60a8\u7684shapefile\uff0c\u786e\u4fdd\u5176\u5305\u542b\u6240\u6709\u5fc5\u8981\u7ec4\u4ef6\u3002shapefile\u5e76\u975e\u5355\u4e2a\u6587\u4ef6\u2014\u2014\u5b83\u7531\u591a\u4e2a\u6587\u4ef6\u7ec4\u6210\uff0c\u7528\u4e8e\u5b9a\u4e49\u5176\u51e0\u4f55\u56fe\u5f62\u3001\u4f4d\u7f6e\u3001\u6295\u5f71\u548c\u5c5e\u6027\u3002\u538b\u7f29\u6587\u4ef6\u5939\u5fc5\u987b\u5305\u542b.shp\u3001.shx\u3001.prj\u548c.dbf\u6587\u4ef6\uff0c\u4e14\u6240\u6709\u6587\u4ef6\u5fc5\u987b\u5171\u4eab\u901a\u7528\u540d\u79f0\u3002&nbsp;", "7a34c47869c0398951e76b5d110885d1": "\u8bf7\u52ff\u5728\u538b\u7f29\u6587\u4ef6\u524d\u521b\u5efa\u6587\u4ef6\u5939\u3002\u8bf7\u5206\u522b\u9009\u62e9\u6bcf\u4e2a\u6587\u4ef6\uff0c\u53f3\u952e\u5355\u51fb\u5e76\u9009\u62e9\u201c\u538b\u7f29\u5230...\u201d\uff0c\u7136\u540e\u9009\u62e9\u201cZIP\u6587\u4ef6\u201d\u3002&nbsp;", "a633668d2a2072fedd62106cce80a71b": "\u5982\u679c\u60a8\u5c1d\u8bd5\u4e0a\u4f20\u591a\u8fb9\u5f62\u6570\u636e\u5e76\u9047\u5230\u95ee\u9898\uff0c\u6216\u60a8\u65e0\u6cd5\u8fd0\u884c\u8f6f\u4ef6\u4e2d\u7684\u4efb\u4f55\u5de5\u5177\uff0c\u5219\u60a8\u7684\u6570\u636e\u4e2d\u53ef\u80fd\u5b58\u5728\u51e0\u4f55\u56fe\u5f62\u9519\u8bef\u3002\u5728\u8f6f\u4ef6\u4e2d\u7ed8\u5236\u591a\u8fb9\u5f62\u65f6\u5fc5\u987b\u9075\u5b88\u7279\u5b9a\u89c4\u8303\uff0c\u8fd9\u7c7b\u95ee\u9898\u5f88\u5e38\u89c1\u3002QGIS\u548cArcGIS\u90fd\u63d0\u4f9b\u4e86\u4fee\u590d\u6570\u636e\u7684\u5de5\u5177\uff0c\u4f46\u60a8\u9700\u8981\u786e\u8ba4\u8fd9\u4e9b\u9519\u8bef\u662f\u5426\u5bfc\u81f4\u4e86\u591a\u8fb9\u5f62\u7684\u8fb9\u754c\u53d8\u5f62\u3002\u901a\u5e38\uff0c\u8fd9\u4e9b\u53d8\u5f62\u975e\u5e38\u5c0f\uff0c\u4e0d\u4f1a\u5f71\u54cdPro\u4e2d\u7684\u5206\u6790\u3002&nbsp;", "3dd866056309ec8c28049356c5f257a5": "\u5982\u9700\u5728QGIS\u4e2d\u4fee\u590d\u51e0\u4f55\u56fe\u5f62\u9519\u8bef\uff0c\u8bf7\u6267\u884c\u4ee5\u4e0b3\u6b65\u3002&nbsp;", "15707d4d0c1170634fae2977908bc39b": "\u4f7f\u7528\u201c\u4fee\u590d\u51e0\u4f55\u56fe\u5f62\u201d\u5de5\u5177\uff0c\u521b\u5efa\u4fee\u590d\u7684\u6570\u636e\u526f\u672c\u3002\u518d\u6b21\u4f7f\u7528\u201c\u68c0\u67e5\u6709\u6548\u6027\u201d\u5de5\u5177\uff0c\u590d\u6838\u6240\u6709\u9519\u8bef\u662f\u5426\u5747\u5df2\u4fee\u590d\uff0c\u68c0\u67e5\u9519\u8bef\uff0c\u786e\u8ba4\u591a\u8fb9\u5f62\u662f\u5426\u4e25\u91cd\u53d8\u5f62\u3002&nbsp;", "3d618ea86ca54a0fcf5b5f61a0776e7b": "\u786e\u4fdd\u5df2\u5b89\u88c5\u5e76\u542f\u7528\u4e86<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u51e0\u4f55\u56fe\u5f62\u68c0\u67e5\u5668\u63d2\u4ef6</a>\u63d2\u4ef6\u3002\u9009\u62e9\u83dc\u5355\u680f\u4e2d\u7684\u201c\u63d2\u4ef6\u201d\uff0c\u7136\u540e\u9009\u62e9\u201c\u7ba1\u7406\u548c\u5b89\u88c5\u63d2\u4ef6\u201d\uff0c\u6253\u5f00\u201c\u5df2\u5b89\u88c5\u201d\u6807\u7b7e\u9875\u3002\u201c\u51e0\u4f55\u56fe\u5f62\u68c0\u67e5\u5668\"\u662f\u4e0eQGIS\u4e00\u8d77\u5b89\u88c5\u7684\u6838\u5fc3\u63d2\u4ef6\uff0c\u5e94\u8be5\u4f1a\u9ed8\u8ba4\u542f\u7528\u3002&nbsp;", "ff31b60cee4996115592748d091c8528": "\u53f3\u952e\u5355\u51fb\u60a8\u60f3\u7f16\u8f91\u7684\u5b57\u6bb5\uff0c\u5728\u9009\u9879\u4e2d\u9009\u62e9\u201c\u5b57\u6bb5\u8ba1\u7b97\u5668\u201d\uff0c\u4ece\u800c\u6253\u5f00\u5b57\u6bb5\u8ba1\u7b97\u5668\u3002\u60a8\u60f3\u8f93\u5165\u7684\u4efb\u4f55\u503c\u90fd\u53ef\u4ee5\u6dfb\u52a0\u5230\u65b0\u7f51\u9875\u5e95\u90e8\u7684\u6587\u672c\u6846\u4e2d\u3002\u60a8\u67093\u79cd\u8f93\u5165\u503c\u7684\u9009\u9879\u3002&nbsp;", "e205058c5549230c73568f31794bdbd1": "\u60a8\u53ef\u4ee5\u8f93\u5165\u8868\u8fbe\u5f0f\uff0c\u5e76\u7528\u53cc\u5f15\u53f7\u62ec\u4f4f\uff08\u201c\u2026\u201d\uff09\uff0c\u4ece\u800c\u8f93\u5165\u6587\u672c\u503c\u3002&nbsp;", "7cabf7c5aabfb4001ca6cc77effbbb84": "\u5982\u679c\u60a8\u5728\u8fc7\u7a0b\u4e2d\u4e0d\u614e\u5220\u9664\u5b57\u6bb5\uff0c\u53ef\u4ee5\u70b9\u51fb\u5c5e\u6027\u8868\u5de6\u4e0a\u89d2\u7684\u201c\u8868\u9009\u9879\u201d\u56fe\u6807\uff0c\u9009\u62e9\u201c\u6dfb\u52a0\u5b57\u6bb5\u201d\u4ee5\u6dfb\u52a0\u5176\u4ed6\u5b57\u6bb5\u3002\u6dfb\u52a0\u65b0\u5b57\u6bb5\u65f6\uff0c\u7cfb\u7edf\u4f1a\u63d0\u793a\u60a8\u8f93\u5165\u5b57\u6bb5\u540d\u79f0\u548c\u6570\u636e\u7c7b\u578b\u3002\u5b57\u6bb5\u540d\u79f0\u662f\u6a21\u677f\u4e2d\u7684\u524d10\u4e2a\u5b57\u7b26\uff0c\u6240\u6709\u7a7a\u683c\u5747\u5c06\u66ff\u6362\u4e3a\u4e0b\u5212\u7ebf\u3002\u5982\u9700\u521b\u5efa\u5305\u542b\u6587\u672c\u7684\u5b57\u6bb5\uff0c\u8bf7\u9009\u62e9\u201c\u5b57\u7b26\u4e32\u201d\u4f5c\u4e3a\u6570\u636e\u7c7b\u578b\uff1b\u5bf9\u4e8e\u6570\u5b57\u503c\uff0c\u8bf7\u9009\u62e9\u201c\u53cc\u7cbe\u5ea6\u201d\u3002&nbsp;\n", "db49309b0be72bd1fefe9f91d1b76ed4": "\u5728\u4e0a\u4f20\u60a8\u7684shapefile\u4e4b\u524d\uff0c\u60a8\u5e94\u5728GIS\u8f6f\u4ef6\u4e2d\u68c0\u67e5\u4ee5\u4e0b\u5185\u5bb9\u3002&nbsp;", "90925ab4c89f04e58bef81d7e435c5e5": "\u68c0\u67e5\u6295\u5f71\u662f\u5426\u8bbe\u7f6e\u4e3a<strong>WGS 84</strong>\u3002 \u5982\u679c\u5f53\u524d\u6295\u5f71\u672a\u4f7f\u7528WGS 84\uff0c\u5728QGIS\u4e2d\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u201c\u77e2\u91cf\u901a\u7528\u201d\u6807\u7b7e\u9875\u4e0b\u201c\u5904\u7406\u5de5\u5177\u7bb1\u201d\u4e2d\u7684\u201c\u91cd\u65b0\u6295\u5f71\u56fe\u5c42\u201d\u5de5\u5177\uff1b\u5728ArcGIS\u4e2d\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u201c\u6295\u5f71\u548c\u53d8\u6362\u201d\u9879\u4e0b\u201c\u6570\u636e\u7ba1\u7406\u5de5\u5177\u7bb1\u201d\u4e2d\u7684\u201c\u6295\u5f71\u201d\u5de5\u5177\u3002&nbsp;", "1a24587f463e0fab006777ee2e56bda6": "\u786e\u8ba4\u60a8\u7684\u6570\u636e\u6ca1\u6709M\u6216Z\u503c\u3002 \u5728\u201c\u6d4f\u89c8\u5668\u201d\u7a97\u53e3\uff08QGIS\uff09\u6216\u201c\u76ee\u5f55\u201d\uff08ArcGIS\uff09\u4e2d\u53f3\u952e\u5355\u51fbshapefile\uff0c\u6253\u5f00\u56fe\u5c42\u5c5e\u6027\u3002\u5982\u679c\u60a8\u5728\u4f7f\u7528QGIS\uff0c\u8bf7\u4f7f\u7528\u201c\u79fb\u9664M/Z\u503c\u201d\u5de5\u5177\u3002\u5982\u679c\u60a8\u5728\u4f7f\u7528ArcGIS\uff0c\u8bf7\u4f7f\u7528\u201c\u590d\u5236\u201d\u5de5\u5177\uff0c\u6253\u5f00\u5de5\u5177\u73af\u5883\uff0c\u7981\u7528M\u548cZ\u503c\u3002&nbsp;", "b73fae70e54ad81aec2c7b1605ee047d": "\u786e\u4fddshapefile\u4e2d\u7684\u8981\u7d20\u5c11\u4e8e150,000\u4e2a\u2014\u2014\u8fd9\u662fGFW Pro\u652f\u6301\u7684\u5217\u8868\u5927\u5c0f\u4e0a\u9650\u3002\u5982\u9700\u5728QGIS\u6216ArcGIS\u4e2d\u5c06\u5217\u8868\u62c6\u5206\u4e3a\u8f83\u5c0f\u7684\u90e8\u5206\uff0c\u8bf7\u6253\u5f00\u5c5e\u6027\u8868\uff0c\u9009\u62e9\u60a8\u60f3\u4ece\u539f\u59cb\u6570\u636e\u4e2d\u5206\u79bb\u7684\u884c\u3002\u5728QGIS\u4e2d\uff0c\u53f3\u952e\u5355\u51fb\u6570\u636e\uff0c\u4ece\u53ef\u7528\u9009\u9879\u4e2d\u9009\u62e9\u201c\u5c06\u6240\u9009\u8981\u7d20\u53e6\u5b58\u4e3a\u201d\uff1b\u5728ArcGIS\u4e2d\uff0c\u53f3\u952e\u5355\u51fb\u201c\u76ee\u5f55\u201d\u4e2d\u7684\u6570\u636e\uff0c\u4ece\u53ef\u7528\u9009\u9879\u4e2d\u9009\u62e9\u201c\u5bfc\u51fa\u201d\u3002&nbsp;", "13fed1ecd3ab208d6b163ef349ef694c": "\u63a5\u4e0b\u6765\uff0c\u5728\u6587\u4ef6\u8d44\u6e90\u7ba1\u7406\u5668\u4e2d\u627e\u5230\u60a8\u7684\u6570\u636e\uff0c\u6267\u884c\u4ee5\u4e0b\u64cd\u4f5c\uff1a&nbsp;", "37b9c2c1467509cf95b06291911200fd": "\u5982\u9700\u5728ArcGIS\u4e2d\u4fee\u590d\u51e0\u4f55\u56fe\u5f62\u9519\u8bef\uff0c\u8bf7\u6267\u884c\u4ee5\u4e0b2\u6b65\u3002&nbsp;", "7b6a3f18b4df4244f35d539588a19538": "\u6253\u5f00\u201c\u6570\u636e\u7ba1\u7406\u201d\u5de5\u5177\u7bb1\u3002\u4f7f\u7528\u201c\u8981\u7d20\u201d\u5de5\u5177\u96c6\u4e2d\u7684\u201c\u68c0\u67e5\u51e0\u4f55\u201d\u5de5\u5177\uff0cArcGIS\u4f1a\u751f\u6210\u4e00\u4e2a\u8868\u683c\uff0c\u8bc6\u522b\u6570\u636e\u4e2d\u7684\u9519\u8bef\u3002&nbsp;", "168f9a897eaa83459128a1b1162b5d96": "\u51c6\u5907\u7535\u5b50\u8868\u683c\u4ee5\u4f9b\u4e0a\u4f20&nbsp;", "fe0a7f3ffcf5bd1bf231de94b7d43096": "\u5c06\u6570\u636e\u586b\u5165\u7b2c1\u884c\u4ee5\u4e0b\u7684\u7535\u5b50\u8868\u683c\u4e2d\uff0c\u5e76\u6839\u636e\u8981\u6c42\u586b\u5199\u4ee5\u4e0b\u4fe1\u606f\uff1a", "2ec5dba3498c2374858162a129fc52cd": "<span style=\"color: initial;\">\u4f4d\u7f6e\u540d\u79f0</span>\u4f4d\u7f6e\u540d\u79f0<s></s>&nbsp;\u2014\u2014\u8f93\u5165\u5185\u5bb9\u53ea\u80fd\u5305\u542b\u5b57\u6bcd\u6570\u5b57\u5b57\u7b26\u548c\u4ee5\u4e0b\u7279\u6b8a\u5b57\u7b26\uff1a[]().-_\u3002\u9664\u6b64\u4e4b\u5916\u7684\u7279\u6b8a\u5b57\u7b26\u5c06\u5728\u5904\u7406\u8fc7\u7a0b\u4e2d\u88ab\u79fb\u9664\u3002&nbsp;<br>\u8bf7\u6ce8\u610f\uff0c\u8f93\u5165\u5185\u5bb9\u5fc5\u987b\u5c11\u4e8e63\u4e2a\u5b57\u7b26\u3002\u8d85\u51fa\u957f\u5ea6\u7684\u5b57\u7b26\u4e32\u5c06\u6839\u636e\u8be5\u4e0a\u9650\u88ab\u88c1\u526a\u3002&nbsp;", "bd1045c24d10a652ce763d853dcb209f": "\u5c0f\u6570\u4f4d\u9700\u8981\u7cbe\u786e&nbsp;", "3cc333e109aeea6c7503e59cdea3c420": "\u5efa\u8bae\u4f7f\u7528\u81f3\u5c116\u4f4d\u5c0f\u6570\uff0c\u4ee5\u786e\u4fdd\u4e9a\u6beb\u7c73\u7ea7\u7684\u7cbe\u5ea6\u3002&nbsp;", "b15dcef0792002073642a9fd3b17ad35": "6. \u5b8c\u6210Excel\u7535\u5b50\u8868\u683c\u6a21\u677f\u540e\uff0c\u8bf7\u5c06\u5176\u4fdd\u5b58\u5230\u7535\u8111\u4e0a\uff0c\u7136\u540e\u901a\u8fc7\u201c\u6587\u4ef6\u4e0a\u4f20\u201d\u56fe\u6807\u5c06\u5176\u6dfb\u52a0\u4e3a\u9644\u4ef6\u3002", "3a6b780d968144f5b56008cfc9f6b9e0": "5. \u8bf7\u52ff\u5220\u9664Excel\u7535\u5b50\u8868\u683c\u6a21\u677f\u4e2d\u7684\u4efb\u4f55\u5217\uff0c\u4e5f\u8bf7\u52ff\u66f4\u6539\u5176\u987a\u5e8f\u3002 \u5982\u679c\u60a8\u4e0d\u9700\u8981\u7279\u5b9a\u7684\u67d0\u4e00\u5217\uff0c\u8bf7\u5c06\u5176\u7559\u7a7a\u3002\u66f4\u6539\u8fd9\u4e9b\u6838\u5fc3\u5b57\u6bb5\u5c06\u5bfc\u81f4\u7cfb\u7edf\u65e0\u6cd5\u5206\u6790\u6570\u636e\u3002", "114df1e467fbbcb892a8afcd1a161904": "\u5750\u6807\u6ce8\u610f\u4e8b\u9879\uff1a&nbsp;", "77047ce1d259d0acf7a5ee326c33863c": "\u68c0\u67e5\u534a\u7403\u662f\u5426\u6b63\u786e&nbsp;", "fa4e581f74c5ffacf37866fc61669454": "\u8bf7\u59cb\u7ec8\u4f7f\u7528\u201c\u7eac\u5ea6\uff0c\u7ecf\u5ea6\u201d\u7684\u683c\u5f0f\u3002&nbsp;", "53eb2352fa973891710610ec0edc1cb0": "\u5982\u679c\u6570\u5b57\u770b\u8d77\u6765\u4f3c\u4e4e\u4e92\u6362\u4e86\uff0c\u8bf7\u518d\u6b21\u786e\u8ba4\u54ea\u4e2a\u4ee3\u8868\u7eac\u5ea6\uff08\u901a\u5e38\u5728-90\u523090\u4e4b\u95f4\uff09\uff0c\u54ea\u4e2a\u4ee3\u8868\u7ecf\u5ea6\uff08\u5728-180\u5230180\u4e4b\u95f4\uff09\u3002&nbsp;", "e92030faa1395760130299ce1134c50f": "\u518d\u6b21\u786e\u8ba4\u7ed9\u5b9a\u5750\u6807\u7684\u683c\u5f0f&nbsp;", "6704839371f80ec7522bbeb1de502360": "\u6709\u4e9b\u6570\u5b57\u53ef\u80fd\u5199\u6cd5\u4e0d\u540c\uff08\u4f8b\u5982\uff0c\u201cX\uff0cY\u201d\u800c\u975e\u201d\u7eac\u5ea6\uff0c\u7ecf\u5ea6\u201c\uff09\u3002&nbsp;", "18d44f6c57d53c74433819763f69d9f8": "\u5982\u679c\u770b\u8d77\u6765\u6709\u5f02\u5e38\uff0c\u8bf7\u9a8c\u8bc1\u5f53\u524d\u4f7f\u7528\u7684\u683c\u5f0f\u3002&nbsp;", "231e383d85399c71337c73dc31f9dbba": "Analysis_A\uff08\u9762\u79ef\u503c\uff0c\u5355\u4f4d\u4e3aHA\uff09*&nbsp;", "1ca3b1032870fb6e3e08af54ab758b34": "\u7528\u4e8e\u786e\u5b9a\u60a8\u7684\u5750\u6807\u5468\u56f4\u7684\u5206\u6790\u533a\u57df\u3002\u4ec5\u5728\u672a\u5b9a\u4e49\u201d\u5206\u6790\u533a\u57df\u201c\u65f6\u5fc5\u586b\u3002&nbsp;", "26948699843d5129d8e325be6a2a60ef": "*\u60a8\u65e0\u9700\u540c\u65f6\u586b\u5199\u5206\u6790\u534a\u5f84\u548c\u5206\u6790\u533a\u57df\u3002\u5206\u6790\u533a\u57df\u5fc5\u987b\u4ee5\u516c\u9877\u4e3a\u5355\u4f4d\u8f93\u5165\uff0c\u5206\u6790\u534a\u5f84\u5fc5\u987b\u4ee5\u5343\u7c73\u4e3a\u5355\u4f4d\u8f93\u5165\u2014\u2014\u5728\u76f8\u5173\u5b57\u6bb5\u4e2d\u4ec5\u9700\u8f93\u5165\u6570\u5b57\u3002&nbsp;", "781ef3db704e36e552a6a7bd6bc3d185": "\u5b8c\u6210KML\u6a21\u677f\u540e\uff0c\u8bf7\u5c06\u5176\u4fdd\u5b58\u5230\u7535\u8111\u4e0a\uff0c\u5e76\u901a\u8fc7\u201c\u6587\u4ef6\u4e0a\u4f20\u201d\u56fe\u6807\u5c06\u5176\u6dfb\u52a0\u4e3a\u9644\u4ef6\u3002&nbsp;", "89bacd756806c54c94022a4f9df56abb": "\u5982\u9700\u83b7\u53d6\u5173\u4e8e\u5982\u4f55\u51c6\u5907\u4e0a\u4f20\u6a21\u677f\u7684\u652f\u6301\uff0c\u8bf7\u53c2\u9605<a href=\"{{1}}\">GFW Pro\u5e2e\u52a9\u4e2d\u5fc3</a>\u4e2d\u7684<a href=\"{{0}}\">\u9010\u6b65\u8bf4\u660e</a>\u3002&nbsp;", "1dcae469e2a90c5c2b33f9ead651ddf0": "\u9009\u62e9\u5e76\u4e0b\u8f7d\u6b63\u786e\u7684\u6a21\u677f", "7b053361d6e9a37ab7cff30d7570fc88": "\u4e0b\u8f7d\u68d5\u6988\u6cb9ID\u5217\u8868\u7535\u5b50\u8868\u683c&nbsp;", "2670b95b1154c47e9f10ab17a6554148": "\u5b8c\u6210\u68d5\u6988\u6cb9ID\u5217\u8868\u7535\u5b50\u8868\u683c", "40b5d96181897fe107a87302c1784518": "\u6253\u5f00\u5df2\u4e0b\u8f7d\u7684Excel\u7535\u5b50\u8868\u683c\u6a21\u677f\u3002&nbsp;", "5efeb86a0243719cfa3d968ca8a57609": "\u7528\u4ee5\u4e0b\u4fe1\u606f\u586b\u5145\u6a21\u677f\uff1a&nbsp;", "921754a6401d36613e23a19a4db34aa9": "\u4f4d\u7f6e\u540d\u79f0\uff08\u60a8\u7684\u4f4d\u7f6e\u540d\u79f0\uff09&nbsp;\u2014\u2014\u8f93\u5165\u5185\u5bb9\u53ea\u80fd\u5305\u542b\u5b57\u6bcd\u6570\u5b57\u5b57\u7b26\u548c\u4ee5\u4e0b\u7279\u6b8a\u5b57\u7b26\uff1a[]().-_\u3002\u9664\u6b64\u4e4b\u5916\u7684\u7279\u6b8a\u5b57\u7b26\u5c06\u5728\u5904\u7406\u8fc7\u7a0b\u4e2d\u88ab\u79fb\u9664\u3002&nbsp;<br>\u8bf7\u6ce8\u610f\uff0c\u8f93\u5165\u5185\u5bb9\u5fc5\u987b\u5c11\u4e8e63\u4e2a\u5b57\u7b26\u3002\u8d85\u51fa\u957f\u5ea6\u7684\u5b57\u7b26\u4e32\u5c06\u6839\u636e\u8be5\u4e0a\u9650\u88ab\u88c1\u526a\u3002", "40e4413751f5d8ff457ef7847be09497": "\u68d5\u6988\u6cb9\u5382ID\uff08\u901a\u7528\u5de5\u5382\u5217\u8868\u4e2d\u5b9a\u4e49\u7684\u68d5\u6988\u6cb9\u5382ID\uff09&nbsp;", "aa16e13a3083ccf3ea344be9c786129d": "\u5728Google Earth\u4e2d\u6253\u5f00KML/KMZ\u6587\u4ef6&nbsp;", "0a11a1680912c0c3fe37fcba4df7acaa": "\u60a8\u53ef\u4ee5\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u8bbf\u95ee\u66f4\u591a\u5173\u4e8eKML\u6587\u4ef6\u7684\u4fe1\u606f\uff0c\u5728<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u8bbf\u95ee\u66f4\u591a\u5173\u4e8eGoogle Earth\u7684\u4fe1\u606f\u3002&nbsp;", "1992592be6edc846d4841249f58fc6f9": "\u5982\u9700\u5728ArcGIS\u4e2d\u68c0\u67e5shapefile\u51e0\u4f55\u56fe\u5f62\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\u3002&nbsp;", "b26467c4810c1aa3cea0643a76f9c0e3": "\u5982\u9700\u8f93\u5165\u6570\u5b57\u503c\uff0c\u60a8\u4ec5\u9700\u8f93\u5165\u6570\u5b57\u5373\u53ef\u3002&nbsp;\n", "f657fdc74cbad34b8c9fce6917d6c409": "\u5206\u6790\u534a\u5f84\uff08\u6570\u503c\uff09*\u2014\u2014\u9700\u8981\u5206\u6790\u7684\u534a\u5f84\uff0c\u5355\u4f4d\u4e3aKM\uff0c\u5982\u679c\u5df2\u5b9a\u4e49\u201c\u5206\u6790\u533a\u57df\u201d\uff0c\u5219\u65e0\u9700\u5b9a\u4e49\u6b64\u9879\u3002", "3336fe9fbaaacde6648857a313bb5326": "\u5206\u6790\u533a\u57df\uff08\u6570\u503c\uff09*\u2014\u2014\u9700\u8981\u5206\u6790\u7684\u533a\u57df\uff0c\u5355\u4f4d\u4e3aHA\uff0c\u5982\u679c\u5df2\u5b9a\u4e49\u201c\u5206\u6790\u534a\u5f84\u201d\uff0c\u5219\u65e0\u9700\u5b9a\u4e49\u6b64\u9879", "2a3298f71f5e1eb6857bf211579ad40c": "*\u60a8\u65e0\u9700\u540c\u65f6\u586b\u5199\u5206\u6790\u534a\u5f84\u548c\u5206\u6790\u533a\u57df\u3002\u5206\u6790\u533a\u57df\u5fc5\u987b\u4ee5\u516c\u9877\u4e3a\u5355\u4f4d\u8f93\u5165\uff0c\u5206\u6790\u534a\u5f84\u5fc5\u987b\u4ee5\u5343\u7c73\u4e3a\u5355\u4f4d\u8f93\u5165\u2014\u2014\u5728\u76f8\u5173\u5b57\u6bb5\u4e2d\u4ec5\u9700\u8f93\u5165\u6570\u5b57\u3002", "62ba0f5a536fb82eea6e9ef9e5790775": "4. \u60a8\u53ef\u4ee5\u5728\u201c\u5206\u6790\u533a\u57df\u201d\u5217\u4e4b\u540e\u6dfb\u52a0\u53ef\u9009\u7684\u81ea\u5b9a\u4e49\u5b57\u6bb5\u3002\u60a8\u53ef\u4ee5\u6dfb\u52a0\u7684\u989d\u5916\u81ea\u5b9a\u4e49\u5b57\u6bb5\u6ca1\u6709\u9650\u5236\u3002", "6fbd5964248fb56bd676cd7f6d7ba7d1": "\u5357\uff08S\uff09\u548c\u897f\uff08W\uff09\u4e3a\u8d1f\u503c\u3002&nbsp;", "1ee046f3acec119829bf1dffbac66324": "\u8bf7\u786e\u4fdd\u987a\u5e8f\u6b63\u786e\uff08\u7eac\u5ea6\uff0c \u7ecf\u5ea6\uff09&nbsp;", "d9f4675eb63ec527ab5afa907c481d11": "\u907f\u514d\u5728\u8ba1\u7b97\u8fc7\u7a0b\u4e2d\u8fc7\u65e9\u56db\u820d\u4e94\u5165\u3002", "2b651cf204841a7c48ea8ad3c30bf26b": "\u7528\u4e8e\u786e\u5b9a\u60a8\u7684\u5750\u6807\u5468\u56f4\u7684\u5206\u6790\u533a\u57df\u3002\u4ec5\u5728\u672a\u5b9a\u4e49\u201d\u5206\u6790\u534a\u5f84\u201c\u65f6\u5fc5\u586b\u3002&nbsp;", "8ff9e56c7ebd63a8c03750ce00d5a0f2": "\u68d5\u6988\u6cb9ID\u5217\u8868Excel\u7535\u5b50\u8868\u683c\u6a21\u677f\u9884\u89c8", "59a2b36a8f83eaae3f2d3288a66448bd": "\u4ee5\u4e0b\u6982\u8ff0\u4e86\u7528\u6237\u5728\u51c6\u5907\u5c06KML/KMZ\u6587\u4ef6\u4e0a\u4f20\u5230GFW Pro\uff08Pro\uff09\u65f6\u53ef\u4ee5\u9075\u5faa\u7684\u5de5\u4f5c\u6d41\u3002KML\uff08Keyhole Markup Language\uff09\u662f\u4e3a\u4e0eGoogle Earth\u914d\u5408\u4f7f\u7528\u800c\u5f00\u53d1\u7684\u5730\u7406\u7a7a\u95f4\u6587\u4ef6\u683c\u5f0f\u3002KMZ\u662fKML\u6587\u4ef6\u7684\u538b\u7f29\u7248\u672c\u3002\u65e0\u8bba\u662fGIS\u65b0\u7528\u6237\u8fd8\u662f\u7ecf\u9a8c\u4e30\u5bcc\u7684GIS\u5206\u6790\u5e08\uff0c\u90fd\u5e94\u67e5\u770b\u8fd9\u4e9b\u6b65\u9aa4\uff0c\u4ee5\u4fbf\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u6f5c\u5728\u7684Pro\u6570\u636e\u4e0a\u4f20\u9519\u8bef\u3002&nbsp;", "fddb24d449f86150ae4ad8a40e467908": "\u4f7f\u7528\u70b9\u6216\u591a\u8fb9\u5f62shapefile\u51e0\u4f55\u56fe\u5f62&nbsp;", "2d729cecb92e6306e66851c09d506684": "\u5750\u6807\u70b9\u548c\u57fa\u4e8e\u534a\u5f84\u7684\u51e0\u4f55\u56fe\u5f62\u793a\u4f8b\uff08\u5de6\uff09\uff0c\u4ee5\u53ca\u57fa\u4e8e\u591a\u8fb9\u5f62\u7684\u51e0\u4f55\u56fe\u5f62\u793a\u4f8b\uff08\u53f3\uff09\u3002&nbsp;", "58354baaffbc7060a9fb53e5b423ec10": "\u5982\u9700\u5728ArcGIS\u4e2d\u68c0\u67e5shapefile\u7684\u4f4d\u7f6e\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\u3002&nbsp;", "8ae4572a6d7caa94d1f4583c01ae6f28": "\u70b9\u51fb\u7f51\u9875\u9876\u90e8\u7684\u201c\u9009\u62e9\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u6309\u4f4d\u7f6e\u9009\u62e9\u201d\u3002\u5bf9\u4e8e\u9009\u62e9\u65b9\u6cd5\uff0c\u8bf7\u9009\u62e9\u201c\u4ece\u4e2d\u9009\u62e9\u8981\u7d20\u201d\u3002\u9009\u62e9\u60a8\u7684\u6570\u636e\u4f5c\u4e3a\u201c\u76ee\u6807\u56fe\u5c42\u201d\uff0c\u9009\u62e9GADM\u8fb9\u754c\u4f5c\u4e3a\u201c\u6e90\u56fe\u5c42\u201d\u3002\u5bf9\u4e8e\u201c\u7a7a\u95f4\u9009\u62e9\u65b9\u6cd5\u201d\uff0c\u9009\u62e9\u201c\u4e0e\u6e90\u56fe\u5c42\u8981\u7d20\u76f8\u4ea4\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u786e\u5b9a\u201d\u3002&nbsp;", "bc27f6a9b0e7f6c5582540dfc828f845": "\u5982\u9700\u5220\u9664\u591a\u4f59\u8981\u7d20\uff0c\u8bf7\u53f3\u952e\u5355\u51fb\u56fe\u5c42\uff0c\u9009\u62e9\u201c\u5207\u6362\u7f16\u8f91\u201d\u3002\u5728\u5c5e\u6027\u8868\u4e2d\u9009\u4e2d\u591a\u4f59\u7684\u8981\u7d20/\u884c\uff0c\u6309\u201c\u5220\u9664\u201d\u952e\u5c06\u5176\u79fb\u9664\u3002\u79fb\u9664\u591a\u4f59\u8981\u7d20\u540e\uff0c\u518d\u6b21\u53f3\u952e\u5355\u51fb\u56fe\u5c42\uff0c\u9009\u62e9\u201c\u5207\u6362\u7f16\u8f91\u201d\u3002\u7cfb\u7edf\u4f1a\u63d0\u793a\u60a8\u4fdd\u5b58\u66f4\u6539\u2014\u2014\u6b64\u64cd\u4f5c\u4e0d\u4f1a\u79fb\u9664shapefile\u4e2d\u7684\u6240\u9700\u5b57\u6bb5\u3002&nbsp;", "7756c0f73f7f68b1ab318beb559109fc": "\u586b\u5199\u5c5e\u6027\u8868\u65f6\uff0c\u8bf7\u6ce8\u610f\u4e0d\u8981\u70b9\u51fb\u201c\u5b57\u6bb5\u8ba1\u7b97\u5668\u201d\u56fe\u6807\u65c1\u8fb9\u7684\u7ea2\u8272\u201c\u5220\u9664\u5b57\u6bb5\u201d\u56fe\u6807\u3002\u5982\u679c\u4e0d\u614e\u70b9\u51fb\u4e86\u201c\u5220\u9664\u5b57\u6bb5\u201d\uff0c\u60a8\u53ef\u4ee5\u70b9\u51fb\u201c\u5220\u9664\u5b57\u6bb5\u201d\u56fe\u6807\u53e6\u4e00\u4fa7\u7684\u9ec4\u8272\u201c\u65b0\u5efa\u5b57\u6bb5\u201d\u56fe\u6807\uff0c\u6dfb\u52a0\u65b0\u5b57\u6bb5\u3002&nbsp;", "a59a6e670630539e2f6499bbc6ae7f6d": "\u5982\u9700\u4ece\u6a21\u677fshapefile\u4e2d\u5220\u9664\u989d\u5916\u8981\u7d20\uff0c\u8bf7\u53cc\u51fb\u5c5e\u6027\u8868\u4e2d\u7684\u4efb\u610f\u5217\u3002\u6a21\u677f\u5c5e\u6027\u8868\u4e2d\u7684\u6bcf\u4e00\u5217\u5747\u5df2\u586b\u5199\uff0c\u56e0\u6b64\uff0c\u8be5\u5185\u5bb9\u4f1a\u88ab\u79fb\u52a8\u5230\u9876\u90e8\u7684\u884c\u3002&nbsp;\n", "88baa66c12dad1eb923aa0f13f320117": "\u5982\u9700\u7f16\u8f91shapefile\uff0c\u8bf7\u4ece\u7f16\u8f91\u5de5\u5177\u680f\u9009\u62e9\u201c\u7f16\u8f91\u5668\u201d\uff0c\u7136\u540e\u9009\u62e9\u201c\u5f00\u59cb\u7f16\u8f91\u201d\uff0c\u9009\u62e9\u6b63\u786e\u7684\u56fe\u5c42\u3002\u70b9\u51fb\u201c\u5220\u9664\u201d\u952e\uff0c\u7136\u540e\u8fd4\u56de\u7f16\u8f91\u5de5\u5177\u680f\u4e0a\u7684\u83dc\u5355\uff0c\u5173\u95ed\u7f16\u8f91\u5668\u3002\u7cfb\u7edf\u4f1a\u63d0\u793a\u60a8\u4fdd\u5b58\u66f4\u6539\u2014\u2014\u6b64\u64cd\u4f5c\u4e0d\u4f1a\u79fb\u9664\u65b0shapefile\u4e2d\u7684\u6240\u9700\u5b57\u6bb5\u3002&nbsp;", "92dbf9186895de3701011e5954214abc": "\u5728\u5904\u7406\u5de5\u5177\u7bb1\u4e2d\uff0c\u6253\u5f00\u201c\u77e2\u91cf\u51e0\u4f55\u56fe\u5f62\u201d\u5de5\u5177\u96c6\uff0c\u4f7f\u7528\u201c\u68c0\u67e5\u6709\u6548\u6027\u201d\u5de5\u5177\u3002\u8be5\u5de5\u5177\u5c06\u521b\u5efa3\u4e2a\u56fe\u5c42\uff1a\u663e\u793a\u6b63\u786e\u591a\u8fb9\u5f62\u7684\u56fe\u5c42\uff08\u201d\u6709\u6548\u201c\uff09\u3001\u663e\u793a\u6709\u9519\u8bef\u7684\u591a\u8fb9\u5f62\u7684\u56fe\u5c42\uff08\u201d\u65e0\u6548\u201c\uff09\uff0c\u4ee5\u53ca\u4e00\u4e2a\u6307\u51fa\u9519\u8bef\u4f4d\u7f6e\u7684\u70b9\u56fe\u5c42\u3002&nbsp;", "9c0b2d6f28a98e1e5876ea67ade6a0fb": "\u4f7f\u7528\u201c\u4fee\u590d\u51e0\u4f55\u201d\u5de5\u5177\u4fee\u590d\u6570\u636e\u4e2d\u7684\u9519\u8bef\u3002\u518d\u6b21\u4f7f\u7528\u201c\u68c0\u67e5\u51e0\u4f55\u201d\u5de5\u5177\uff0c\u590d\u6838\u6240\u6709\u9519\u8bef\u662f\u5426\u5747\u5df2\u4fee\u590d\uff0c\u68c0\u67e5\u9519\u8bef\u4ee5\u786e\u4fdd\u591a\u8fb9\u5f62\u6ca1\u6709\u4e25\u91cd\u53d8\u5f62\u3002&nbsp;", "bb8d859712caa2270fe2b4ef5d46b535": "\u5982\u9700\u83b7\u53d6\u5173\u4e8e\u5982\u4f55\u4f7f\u7528GFW Pro\u7684\u652f\u6301\uff0c\u8bf7\u53c2\u9605<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">GFW Pro\u5e2e\u52a9\u4e2d\u5fc3</a>\u4e2d\u7684<a href=\"{{0}}\">\u9010\u6b65\u8bf4\u660e</a>\u3002&nbsp;", "57437600b2848d1db822e7fcb12a4817": "\u5982\u4f55\u5904\u7406\u4e0a\u4f20\u5185\u5bb9\u4e2d\u7684\u9519\u8bef", "66b00e7a58f94d08fea19b2f7d9c033f": "\u672c\u6307\u5357\u4fa7\u91cd\u4e8e\u5e2e\u60a8\u7406\u89e3\u4e0a\u4f20\u6570\u636e\u4e2d\u7684\u9519\u8bef\u3002&nbsp;", "9b2802e5016d6db7030af44eec719411": "\u7eac\u5ea6\uff08\u6570\u503c\uff09\u2014\u2014\u5750\u6807\u7684\u7eac\u5ea6\u503c\uff0c\u4f7f\u7528\u5341\u8fdb\u5236\u5ea6\u8868\u793a\u3002", "32afc29ba75a447082c9682ace643638": "\u7ecf\u5ea6\uff08\u6570\u503c\uff09\u2014\u2014\u5750\u6807\u7684\u7ecf\u5ea6\u503c\uff0c\u4f7f\u7528\u5341\u8fdb\u5236\u5ea6\u8868\u793a", "217dad56cfb7c2e4b4c5f28ca927e359": "\u4e0e\u60a8\u8d26\u53f7\u4e2d\u7684\u5176\u4ed6\u7528\u6237\u5185\u90e8\u5171\u4eab\u5217\u8868\u3002&nbsp;", "1a6af27ebf2b92c7b72cac7c4bcd1cf1": "Pro\u63a8\u8350\u7528\u6237\u4e0b\u8f7dQGIS\u6216ArcGIS\u4ee5\u7f16\u8f91shapefile\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">QGIS</a>\u662f\u4e00\u6b3e\u514d\u8d39\u8f6f\u4ef6\u5957\u88c5\uff0c\u9002\u7528\u4e8eWindows OS\u548cmacOS\u3002QGIS\u901a\u8fc7\u5176<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u7f51\u7ad9</a>\u63d0\u4f9b\u57f9\u8bad\u6750\u6599\uff0c\u8fd8\u53ef\u4ee5\u5728<a href=\"{{2}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u627e\u5230\u5404\u79cd\u8bed\u8a00\u7684\u5176\u4ed6\u6559\u7a0b\u3002<a href=\"{{3}}\" target=\"_blank\" rel=\"noreferrer noopener\">ArcGIS</a>\u662f\u4e00\u6b3e\u4e13\u6709\u8f6f\u4ef6\uff0c\u9002\u7528\u4e8eWindows OS\uff0c\u662f\u6700\u5f3a\u5927\u7684GIS\u8f6f\u4ef6\u5957\u88c5\u4e4b\u4e00\u3002<a href=\"{{4}}\" target=\"_blank\" rel=\"noreferrer noopener\">ArcGIS\u5e2e\u52a9\u7f51\u7ad9</a>\u662f\u6781\u4f73\u7684\u8d44\u6e90\u7f51\u7ad9\uff0c\u63d0\u4f9b\u4e86\u5173\u4e8e\u8f6f\u4ef6\u4f7f\u7528\u7684\u8fdb\u4e00\u6b65\u6307\u5357\uff0c\u4ee5\u53ca\u53ef\u4f9b\u7528\u6237\u53c2\u8003\u7684GIS\u57fa\u7840\u4fe1\u606f\u3002&nbsp;", "c1f22fae6bb71e879e4f6776f8f512db": "\u67e5\u770bGFW\u5217\u8868\u53ca\u8d35\u7ec4\u7ec7\u8d26\u53f7\u4e2d\u6240\u6709\u5217\u8868\u7684\u8bca\u65ad\u548c\u63a7\u5236\u9762\u677f\u7ed3\u679c\u3002&nbsp;", "ff68f0d283aac263770e3997d7500556": "\u7f16\u8f91\u548c\u5220\u9664\u4e0e\u8d35\u7ec4\u7ec7\u8d26\u53f7\u4e2d\u6240\u6709\u7528\u6237\u5173\u8054\u7684\u4f4d\u7f6e\u3002&nbsp;", "11a735f134894256e4f15f91176daa78": "API\u5bc6\u94a5\u8bbf\u95ee\u6743\u9650&nbsp;", "fcd84fa44a206a9af260a05a639d0d48": "\u5982\u6709\u5173\u4e8e\u4f7f\u7528\u60c5\u51b5\u3001\u5b9a\u4ef7\u3001\u8bb8\u53ef\u6216\u57fa\u4e8eAPI\u7684\u8bbf\u95ee\u7684\u4efb\u4f55\u95ee\u9898\uff0c\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">gfwprosales@wri.org</a>\u3002&nbsp;", "6857e18a1e2c82f9b062db17534e1dc9": "\u4ee5\u4e0b\u4e3a\u53ef\u4f9b\u4e0b\u8f7d\u7684\u6a21\u677f\uff1a&nbsp;", "c021f9cfe433decc320da059bd22441c": "\u793a\u4f8b\uff1a\u586b\u5199\u4e86\u4f4d\u7f6e\u540d\u79f0\u3001\u7eac\u5ea6\u3001\u7ecf\u5ea6\u548c\u5206\u6790\u534a\u5f84\u7684Excel\u7535\u5b50\u8868\u683c\u6a21\u677f\u3002", "7fcc99a369bddd0b0ca6c4cc747e720c": "\u683c\u5f0f", "4caabd21012b6d12f8d5379994393980": "\u76f8\u4e00\u81f4\u7684\u6a21\u677f\u3002", "e7f81a6de07255ba3f548d74bf426784": "\u5982\u4f55\u5c06\u6211\u8d26\u6237\u4e2d\u7684\u5730\u70b9\u5168\u90e8\u5220\u9664\uff1f", "66c9087b8a5ec29166173294884befb8": "\u9010\u4e00\u5220\u9664\u5730\u70b9\u6216\u5217\u8868\u3002\u5982\u679c\u60a8\u9700\u8981", "e2b4cf72a92eaad4dfb929b23ae8b603": "\u4e0e\u60a8\u8981\u4e0a\u4f20\u7684", "206ce74ff2ff29753e7ab26ecac9e7a0": "\u67d0\u4e2ashapefile\u6587\u4ef6\u3002", "96df9ac66e16bea505e2c682e448d3be": "\u5982\u4f55\u5f97\u77e5\u6211\u6b63\u5728\u8bd5\u56fe\u4e0a\u4f20\u5730\u70b9\u7684\u9519\u8bef\u4fe1\u606f\uff1f", "e90105a6cb9b0f1c95bee359b8c254a0": "\u5efa\u7acb\u5e76\u7ba1\u7406\u4ee3\u8868\u5ba2\u6237\u4f9b\u5e94\u57fa\u5730\u7684\u8d27\u6e90\u5730\u7ec4\u5408\u3002", "4d54335ba9a3ea1f7462243f58b7380d": "\u5206\u6790\u5e76\u603b\u7ed3\u6bc1\u6797\u98ce\u9669\u548c\u76f8\u5173\u6cd5\u89c4\uff0c\u4ee5\u53ca\u4e0d\u9075\u5b88\u5ba2\u6237\u7279\u5b9a\u53ef\u6301\u7eed\u53d1\u5c55\u627f\u8bfa\u7684\u98ce\u9669\u3002", "05e7dc946b33a78af57280b3f0b59a10": "\u5c06\u5206\u6790\u7ed3\u679c\u548c\u884d\u751f\u89c1\u89e3\u91cd\u65b0\u5305\u88c5\uff0c\u4ee5\u7528\u4e8e\u7a0b\u5e8f\u5316\u5206\u53d1\u548c\u6d88\u8d39\u3002", "2fdb4fdd5fa78fc104ca6dca14339893": "\u5c06\u98ce\u9669\u8bc4\u4f30\u7eb3\u5165\u5c3d\u804c\u8c03\u67e5\u6d41\u7a0b\uff0c\u5e76\u4e0e\u6574\u4e2a\u7ec4\u7ec7\u7684\u540c\u4e8b\u5171\u4eab\u98ce\u9669\u6c47\u603b\u4ee5\u53ca\u8fdb\u5c55\u8bc4\u4f30\u3002", "9c20f2154ddd42475793ee059c1ff50d": "\u94f6\u884c\u5bb6", "212bc635666e582d940101a0701ea9d6": "\u8bc4\u4f30\u7279\u5b9a\u5730\u70b9\u7684\u8d37\u6b3e\u98ce\u9669\u548c\u4e0e\u53ef\u6301\u7eed\u91d1\u878d\u76f8\u5173\u7684\u878d\u8d44\u8d44\u8d28\uff0c\u4ee5\u53ca\u57fa\u4e8e\u73af\u5883\u548c\u793e\u4f1a\u56e0\u7d20\u7684\u6295\u8d44\u7ec4\u5408\u5c42\u9762\u7684\u98ce\u9669\u3002", "dd4ded28bf92c146436c1c92455bfe45": "\u5236\u5b9a\u73af\u5883\u653f\u7b56\u548c\u8ba1\u5212\uff0c\u4ee5\u964d\u4f4e\u98ce\u9669\u3001\u589e\u52a0\u53ef\u6301\u7eed\u91d1\u878d\u6536\u5165\u6765\u6e90\uff0c\u5e76\u5bf9\u6267\u884c\u60c5\u51b5\u8fdb\u884c\u76d1\u6d4b\u3002", "faa8885daec6e7676ad04c791141a147": "\u6d88\u8d39\u54c1\u5236\u9020\u5546", "8d197f6fda5bcc9582e995589854097b": "\u8bc6\u522b\u5e76\u4f18\u5148\u5904\u7406\u4f9b\u5e94\u57fa\u5730\u5185\u7684\u98ce\u9669\u533a\u57df\uff0c\u4ee5\u76d1\u6d4b\u5bf9EUDR\u7684\u9075\u5b88\u60c5\u51b5\u4ee5\u53ca\u4f9b\u5e94\u5546\u5728\u5b9e\u73b0\u96f6\u6bc1\u6797\u76ee\u6807\u4e0a\u7684\u8fdb\u5c55\u3002&nbsp;", "4fd59a9fabf20732748abafe60214562": "\u54a8\u8be2/\u53ef\u8ffd\u6eaf\u6027\u5e73\u53f0\u63d0\u4f9b\u5546", "95484c18d4d7a7ad7d5d9b09d6ca2923": "\u4e0d\u53ef\u4ee5\uff0c\u8d26\u6237\u7ba1\u7406\u5458\u53ea\u80fd\u5bf9\u7528\u6237\u8fdb\u884c\u505c\u7528\u64cd\u4f5c\u3002 \u5982\u679c\u60a8\u60f3\u5f7b\u5e95", "3fcdb73d36d54f2cc22d0f68e6b6e182": "GFW Pro", "0f2aed3065ed39d036ddb042555d4ce6": "\u6dfb\u52a0\u65b0\u7528\u6237\u9700\u8981\u4e24\u4e2a\u6b65\u9aa4\uff08\u6dfb\u52a0\u548c\u6fc0\u6d3b\uff09\uff0c\u8bf7\u6309\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a", "54fdcd1f4473aa2e7135f0abe52dec52": "\u8fdb\u5165\u53f3\u4fa7\u6a2a\u6761\u4e0a\u7684\u4e2a\u4eba\u8d44\u6599\u56fe\u6807", "95b9352744200bf94e6f7fd896a1fe48": "\u9009\u62e9  \"\u6211\u7684\u4e2a\u4eba\u8d44\u6599\"", "c551e9abd83622cb9ae2ebfbfcb84716": "\u70b9\u51fb \"\u65b0\u5efa\"\u6309\u94ae", "4422a503ddbe6611d6c1abd8f22f3048": "\u8fdb\u5165\u201c\u7528\u6237\u7ba1\u7406\u201d", "003d4a0b971f1e6fc7d05b760b5ff463": "\u586b\u5199\u6240\u9700\u4fe1\u606f\uff08\u540d\u3001\u59d3\u3001\u90ae\u7bb1\u5730\u5740\u3001\u7535\u8bdd\u53f7\u7801\uff09\uff0c\u53ef\u4ee5\u9009\u62e9\u7f16\u8f91\u7528\u6237\u7684\u6743\u9650\u7c7b\u522b\u548c\u804c\u52a1\u3002", "efd3cd8c56afc794d379b40a1561a7c0": "\u4efb\u4f55\u6b63\u5728\u4f7f\u7528GFW Pro\u7684\uff0c\u60a8\u611f\u5174\u8da3\u7684\u5546\u54c1\u3002&nbsp;", "efec120c0284ff90ad971ce47c12868a": "\u70b9\u51fb\u4fdd\u5b58\uff0c\u60a8\u4f1a\u8df3\u8f6c\u5230\u201c\u6211\u7684\u4e2a\u4eba\u8d44\u6599\u201d", "5fd993b35f03faadaae3ae7a5a1ac4fd": "\u8fdb\u5165\u9875\u9762\u540e\u4e0b\u62c9\u5e76\u70b9\u51fb\u201c\u6fc0\u6d3b\u201d", "d9a726e6080480da3347b7ec40738d38": "IT\u767d\u540d\u5355", "6b1d578c264b69de5f13af199d633301": "\u8fd9\u6837", "5e6b1f8ef0fb3c5ebb89dfd6ffbe49ab": "\uff09\u3002\u8bf7\u4e0e\u60a8\u7684IT\u56e2\u961f\u5206\u4eab\u6211\u4eec\u7684URL\u3002", "539dbda27ac5b419773060cf45a6c047": "\u53ef\u4ee5\u4e0a\u4f20", "b4c0b6c75f651ee809fd20c087a4a533": "\u5730\u70b9", "75d56a55c16ad1fd04cf983e424b3739": "GFW Pro\u4f1a\u63d0\u4f9b", "6548c93200e6399a1e8af72f742cb3ac": "<strong>\u6fc0\u6d3b\u65b0\u7528\u6237</strong>\uff0c\u5728\"\u4e2a\u4eba\u8d44\u6599\"\u9875\u9762\u4e2d\u4e0b\u62c9\u81f3\"\u7528\u6237\"\u533a\u57df\u3002 \u60a8\u4f1a\u770b\u5230\u72b6\u6001\u4e3a \"\u5f85\u5b9a\"\u7684\u65b0\u7528\u6237\u3002 \u70b9\u51fb\u7528\u6237\u59d3\u540d\uff0c\u8f7d\u5165\u5176\u4e2a\u4eba\u8d44\u6599\u3002", "f2b72dc419c6cac3e2f9812285008736": "\u5982\u9700\u505c\u7528\u7ba1\u7406\u5458\u8d26\u6237\uff0c\u7ba1\u7406\u5458\u5fc5\u987b\u901a\u8fc7 <a href=\"{{0}}\">\u6b64\u5e2e\u52a9\u8868\u683c</a>\u5411\u6211\u4eec\u7684\u56e2\u961f\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\uff0c\u63d0\u51fa\u6b63\u5f0f\u7684\u505c\u7528\u7533\u8bf7\u3002", "9e925e9341b490bfd3b4c4ca3b0c1ef2": "\u800c\u975e", "50282e67bf96e6bdcb11df64ffdc5c6d": "\u9009\u62e9\u8981\u4e0a\u4f20\u7684\u6570\u636e\u7c7b\u578b&nbsp\uff1b", "cfb3519a206dbc72087d93b8d918f124": "\u60a8\u8981\u4e0a\u4f20\u7684\u6570\u636e\u91cf\u6709\u591a\u5927\uff1f \u6709\u4e9b\u6570\u636e\u683c\u5f0f\u66f4\u9002\u5408\u5904\u7406\u6d77\u91cf\u6570\u636e\u6761\u76ee\u3002&nbsp;", "817ef5ef6c8762cec3df8f4e44aa4250": "\u4ee5\u4e0b\u662f\u5404\u79cd\u4e0d\u540c\u7684\u53ef\u9009\u6570\u636e\u6a21\u677f\uff0c\u5b83\u4eec\u7684\u5fc5\u586b\u5b57\u6bb5\u4ee5\u53ca\u6700\u9002\u5408\u7684\u7a7a\u95f4\u6570\u636e\u7c7b\u578b\u7684\u8be6\u5c3d\u7ec6\u5206\u4ecb\u7ecd\u3002 &nbsp;", "d1c3d974a6c9ab90fb8a8463c2663e7d": "\u591a\u8fb9\u5f62Shapefile", "917e0128058d2a81bc38be43bd8b7e41": "\u7eac\u5ea6\uff08\u6570\u503c\uff09\u2013 \u5750\u6807\u7684\u7eac\u5ea6\u503c\uff0c\u4ee5\u5341\u8fdb\u5236\u7684\u5f62\u5f0f\u8868\u793a\u3002&nbsp\uff1b", "ca2a81ba058a7cfa873910b8d11e2cab": "\u6b64\u524d\uff0cGFW Pro\u4f7f\u7528\u7684\u662f\u9488\u5bf9\u4e0d\u540c\u5546\u54c1\u548c\u5730\u70b9\u7c7b\u578b\u7684\u6a21\u677f\u3002\u8fd9\u4e9b\u6a21\u677f\u4ecd\u7136\u53ef\u4ee5\u5728\u8fd9\u91cc\u627e\u5230[<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">LINK</a>]\uff0c\u4ee5\u4f9b\u60a8\u53c2\u8003\uff0c\u5e76\u5c06\u7ee7\u7eed\u548c\u6211\u4eec\u7684\u5e73\u53f0\u517c\u5bb9\u3002&nbsp\uff1b", "ce36d6ad444c5cdac73f46f6e2f80635": "\u9009\u62e9\u201d\u6587\u4ef6\u4e0a\u4f20\u201c\u5de5\u4f5c\u6d41\u7a0b\u3002&nbsp;", "250a52daf0781d64f73eb6c8d2925ba5": "\u4e0a\u4f20\u5de5\u4f5c\u6d41\u7a0b\u7684\u521d\u59cb\u6a21\u6001\u3002\u9009\u62e9\u201d\u6587\u4ef6\u4e0a\u4f20\u201c\uff0c\u5373\u53ef\u83b7\u53d6GFW Pro\u7684\u793a\u4f8b\u6a21\u677f\u3002", "5781004adcdeb2983c96be73dd4cd4df": "\u60a8\u4f1a\u8df3\u8f6c\u5230\u4e00\u4e2a\u65b0\u7684\u754c\u9762\uff0c\u70b9\u51fb \"\u6570\u636e\u6a21\u677f \"\u6309\u94ae\u3002 \u6b64\u65f6\u4f1a\u5f39\u51fa\u4e00\u4e2a\u6a21\u6001\u7a97\u53e3\uff0c\u663e\u793a\u6709\u4e0d\u540c\u7684GFW Pro\u6a21\u677f\u7c7b\u578b\u3002&nbsp;", "a0c0aaf22b3608dbd601d3fa3b879e6c": "\u70b9\u51fb\u4e0d\u540c\u7684\u6570\u636e\u7c7b\u578b\u9009\u9879\uff0c\u83b7\u53d6\u6709\u5173\u5fc5\u586b\u5b57\u6bb5\u4ee5\u53ca\u6a21\u677f\u6700\u9002\u5408\u54ea\u79cd\u6570\u636e\u7684\u4fe1\u606f\u3002&nbsp;", "d7657a59d04ee053386e5bcb6c9a5f09": "\u70b9\u51fb\u6570\u636e\u6a21\u677f\uff0c\u4e86\u89e3\u6bcf\u79cd\u6570\u636e\u7c7b\u578b\u7684\u8981\u6c42\u5e76\u4e0b\u8f7d\u793a\u4f8b\u6587\u4ef6\u3002", "6f85014bcd93eed330e8d3e6abd60f39": "\u627e\u5230\u8981\u4e0b\u8f7d\u7684\u6a21\u677f\u540e\uff0c\u70b9\u51fb\"\u4e0b\u8f7d \"\u6309\u94ae\u3002&nbsp;", "58feeb057d95cc3b5f26fa85049bd78b": "\u60a8\u53ef\u4ee5\u4ece\u4ee5\u4e0b\u94fe\u63a5\u4e86\u89e3\u66f4\u591a\u5173\u4e8e\u5982\u4f55\u5b8c\u5584\u6240\u9009\u6a21\u677f\u7684\u4fe1\u606f:&nbsp;", "442cb6cb570283806fb97b34637fa369": "\u5b8c\u6210\u8fd9\u4e24\u4e2a\u6b65\u9aa4\u540e\uff0c\u65b0\u7528\u6237\u5c31\u53ef\u4ee5\u767b\u5f55 GFW Pro\u4e86\uff08\u7ba1\u7406\u5458\u9700\u8981\u5bf9\u65b0\u7528\u6237\u8fdb\u884c\u6dfb\u52a0\u548c\u6fc0\u6d3b\u64cd\u4f5c\uff0c\u7136\u540e\u624d\u53ef\u4ee5\u767b\u5f55\uff09\u3002", "5af2e234d5386b0f8b8790719b0d0183": "\u5728\u601d\u8003\u5982\u4f55\u5c06\u6570\u636e\u4e0a\u4f20\u81f3GFW Pro\u65f6\uff0c\u8bf7\u8003\u8651\u4ee5\u4e0b\u8981\u7d20:&nbsp;", "1cfffc129efdd8e0c21746b952463eb3": "\u7535\u5b50\u8868\u683c\u6570\u636e \u2013 \u7528\u6237\u53ef\u4ee5\u5c06\u7535\u5b50\u8868\u683c\u4e2d\u7684\u6570\u636e\u4ee5.csv\u6216.xlsx\u7684\u683c\u5f0f\u4e0a\u4f20\u3002\u7535\u5b50\u8868\u683c\u6570\u636e\u53ef\u4ee5\u5305\u542b\u6709\u7279\u5b9a\u5206\u6790\u534a\u5f84\u6216\u533a\u57df\u7684\u5750\u6807\u70b9\uff0c\u4ee5\u53ca\u4f7f\u7528GFW Pro\u652f\u6301\u7684ID\u7cfb\u7edf\u8fdb\u884c\u8bc6\u522b\u7684\u5730\u70b9\u3002&nbsp\uff1b", "b666bb7ace82df121ad93b8730fc1df0": "\u60a8\u7684\u539f\u59cb\u6570\u636e\u6587\u4ef6\u662f\u4ec0\u4e48\u683c\u5f0f\u7684\uff1f \u6709\u4e9b\u6570\u636e\u683c\u5f0f\u4e4b\u95f4\u53ef\u4ee5\u8f7b\u677e\u8f6c\u6362\uff0c\u4f7f\u7528\u8fd9\u4e9b\u683c\u5f0f\u7684\u6570\u636e\u8fdb\u884c\u8f6c\u6362\u64cd\u4f5c\uff0c\u6216\u6839\u636eGFW Pro\u7684\u8981\u6c42\u8c03\u6574\u6587\u4ef6\u4f1a\u66f4\u5bb9\u6613\u3002&nbsp;", "bf1d6143cc1472d1c89e463db93328e1": "\u5fc5\u586b\u5b57\u6bb5\uff1a&nbsp\uff1b", "205e0e2e1a32fe954e3138c8f1c3759c": "Location_N\uff08\u5b57\u7b26\u4e32\uff09- \u5730\u70b9\u540d\u79f0&nbsp;- \u53ea\u80fd\u8f93\u5165\u5b57\u6bcd\u548c\u6570\u5b57\u5b57\u7b26\u53ca\u4ee5\u4e0b\u7279\u6b8a\u5b57\u7b26: []().-_\u3002\u9664\u6b64\u4e4b\u5916\u7684\u7279\u6b8a\u5b57\u7b26\u5728\u5904\u7406\u8fc7\u7a0b\u4e2d\u4f1a\u88ab\u5220\u9664\u3002&nbsp;<br>\u8fd8\u8bf7\u6ce8\u610f\uff0c\u8f93\u5165\u5185\u5bb9\u5fc5\u987b\u5c11\u4e8e63\u4e2a\u5b57\u7b26\u3002 \u8fc7\u957f\u7684\u5b57\u7b26\u4e32\u4f1a\u88ab\u5220\u51cf\uff0c\u4ee5\u7b26\u5408\u957f\u5ea6\u4e0a\u9650\u3002&nbsp;", "b6d542dad69e047ffaf3995f2b986cc0": "\u8bf7\u6ce8\u610f\uff0c\u591a\u8fb9\u5f62shapefiles\u6587\u4ef6\u5fc5\u987b\u4ee5\u5305\u542b .shp\u6587\u4ef6\u3001.shx\u6587\u4ef6\u3001.dbf\u6587\u4ef6\u548c .prj\u6587\u4ef6\u7684\u538b\u7f29\u6587\u4ef6\u5f62\u5f0f\u4e0a\u4f20\u81f3GFW Pro\u3002&nbsp;", "d898c10ed2e17c3484ec948aa6f4ea5e": "\u8bf7\u6ce8\u610f\uff0c\u70b9\u5f0fshapefile\u6587\u4ef6\u5fc5\u987b\u4ee5\u5305\u542b .shp\u6587\u4ef6\u3001.shx\u6587\u4ef6\u3001.dbf\u6587\u4ef6\u548c.prj \u6587\u4ef6\u7684\u538b\u7f29\u6587\u4ef6\u5f62\u5f0f\u4e0a\u4f20\u81f3GFW Pro\u3002&nbsp;", "573955c529213eae0f4ac1763b92bd54": "\u51c6\u5907\u597d\u8981\u4e0a\u4f20\u7684\u7535\u5b50\u8868\u683c", "599860f3013a2dad0b0981f06635b6f7": "\u4ee5\u53ca\u5176\u4ed6\u73af\u5883\u548c\u793e\u4f1a\u98ce\u9669\u6307\u6807\u3002&nbsp;", "7d613d07e5ae68f1373