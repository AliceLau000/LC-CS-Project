8\u7684\u5e10\u6237\u4e2d\u3002\u60a8\u5c06\u88ab\u5e26\u5230\u65b0\u533a\u57df\u7279\u5b9a\u7684\u8be6\u7ec6\u4fe1\u606f\u9875\u9762\u3002&nbsp;", "b97dd380cfeda0abc563b56a9e4d5ea6": "\u5982\u679c\u8981\u7f16\u8f91\u6216\u5220\u9664\u73b0\u6709\u533a\u57df\uff0c\u8bf7\u8f6c\u5230\u5173\u6ce8\u533a\u57df\u7684\u8be6\u7ec6\u4fe1\u606f\u9875\u9762\uff0c\u4e5f\u5c31\u662f\u5e94\u7528\u5728\u60a8\u521b\u5efa\u65b0\u533a\u57df\u540e\u8df3\u8f6c\u5230\u7684\u540c\u4e00\u9875\u9762\u3002\u5982\u679c\u60a8\u6765\u81ea\u7f51\u7ad9\u7684\u5176\u4ed6\u90e8\u5206\uff1a&nbsp;&nbsp;", "99433a6724db26b14f15ef311c7a6edc": "2. \u70b9\u51fb\u5c4f\u5e55\u53f3\u4e0a\u65b9\u7684\u201c\u7f16\u8f91\u201d\u6309\u94ae&nbsp;", "3d35810fb33efab7a879a9620702c66a": "1. \u5982\u679c\u60a8\u60f3\u7f16\u8f91\u6216\u5220\u9664\u4e00\u4e2a\u73b0\u6709\u7684\u56e2\u961f\uff0c\u8bf7\u524d\u5f80\u56e2\u961f\u7684\u8be6\u7ec6\u4fe1\u606f\u9875\u9762\u3002&nbsp;", "4b8787697de97e1119b8daba5ebfd489": "<strong>\u591a\u9009</strong>\uff1a\u7528\u6237\u53ef\u4ee5\u4ece\u9884\u5b9a\u5217\u8868\u4e2d\u9009\u62e9\u4e00\u4e2a\u6216\u591a\u4e2a\u9009\u9879\u3002\u5bf9\u4e8e\u6b64\u7c7b\u95ee\u9898\uff0c\u5982\u679c\u7528\u6237\u9009\u62e9\u4e86\u60a8\u6307\u5b9a\u7684\u4e00\u4e2a\u9009\u9879\uff0c\u60a8\u8fd8\u53ef\u4ee5\u5411\u7528\u6237\u8be2\u95ee\u66f4\u591a\u4fe1\u606f\u3002&nbsp;", "31162b170d9d72977005531230c91367": "\u81ea\u5b9a\u4e49\u7b2c\u4e00\u4e2a\u95ee\u9898", "968e941fdda6358086a9e4a160d73d2f": "\u6807\u8bb0\u4e3a\u5df2\u53d1\u5e03\u5e76\u4fdd\u5b58\u62a5\u544a\u6a21\u677f", "b550acc08a5463d1dde120efad165fd5": "3. \u4ece\u8868\u683c\u6240\u5217\u6a21\u677f\u4e2d\u627e\u5230\u8be5\u6a21\u677f\u3002\u6ce8\u610f\uff0c\u5982\u679c\u8981\u67e5\u627e\u7684\u6a21\u677f\u592a\u591a\uff0c\u53ef\u4ee5\u4f7f\u7528\u6a21\u677f\u8868\u683c\u4e0a\u9762\u7684\u7b5b\u9009\u9009\u9879\u6765\u5e2e\u52a9\u60a8\u627e\u5230\u60a8\u7684\u6a21\u677f\u3002\u60a8\u53ef\u4ee5\u6309\u7279\u5b9a\u5173\u6ce8\u533a\u57df\u5bf9\u5217\u8868\u8fdb\u884c\u5f52\u96c6\uff0c\u4e5f\u53ef\u4ee5\u641c\u7d22\u6a21\u677f\u7684\u540d\u79f0\u3002&nbsp;", "16eebdde56e50ffa5d0f6b9d59f3ce55": "\u5982\u4f55\u4fee\u6539\u548c\u5220\u9664\u56e2\u961f\u3002&nbsp;", "917de4c3f62a42c45d560e547bc160c9": "\u5982\u4f55\u5c06\u7ba1\u7406\u5458\u89d2\u8272\u8f6c\u7ed9\u5176\u4ed6\u7ba1\u7406\u8005\u3002&nbsp;", "4db104ddf36a5564a03305ee190128de": "\u60a8\u7684\u8d26\u6237\u4e2d\u81f3\u5c11\u8981\u6709\u4e00\u4e2a\u5173\u6ce8\u9886\u57df\u3002\u5982\u679c\u60a8\u8fd8\u6ca1\u6709\u521b\u5efa\u4e00\u4e2a\u5173\u6ce8\u9886\u57df\uff0c<a href=\"{{0}}\">\u9605\u8bfb\u672c\u6559\u7a0b\u4e86\u89e3\u5982\u4f55\u64cd\u4f5c\u3002</a>", "662dbe4df0661d806344ab0466ddb987": "\u4f5c\u4e3a<strong>\u7ba1\u7406\u5458</strong>\u6216<strong>\u7ba1\u7406\u8005</strong>\uff0c\u60a8\u53ef\u4ee5\u521b\u5efa\u6240\u6709\u56e2\u961f\u6210\u5458\u90fd\u53ef\u4ee5\u8bbf\u95ee\u7684\u5173\u6ce8\u533a\u57df\u548c\u81ea\u5b9a\u4e49\u62a5\u544a\u6a21\u677f\u2014\u2014\u4e0d\u9700\u8981\u91cd\u590d\u521b\u5efa\u5185\u5bb9\u3002&nbsp;", "8309533144e337ed7f799df3f91f56a9": "\u60a8\u53ef\u4ee5\u521b\u5efa\u6216\u52a0\u5165\u7684\u56e2\u961f\u5728\u6570\u91cf\u4e0a\u6ca1\u6709\u9650\u5236\u3002\u6bcf\u4e2a\u56e2\u961f\u6210\u5458\u90fd\u6709\u4e00\u4e2a\u7279\u5b9a\u7684\u89d2\u8272\u548c\u76f8\u5173\u7684\u6743\u9650\uff0c\u603b\u7ed3\u5982\u4e0b\uff1a&nbsp;", "1bca3ef310c973eca49870a989b66d6c": "\u5c06\u7ba1\u7406\u5458\u89d2\u8272\u8f6c\u7ed9\u5176\u4ed6\u7ba1\u7406\u8005&nbsp;", "3ca37ac5ebd3c24a5407a80b5cf0c59d": "3. \u70b9\u51fb\u201c\u6dfb\u52a0\u201d\u6309\u94ae\u53d1\u9001\u9080\u8bf7\u3002&nbsp;", "3c4a41186b83372af55445e840db2dc5": "2. \u70b9\u51fb\u5305\u542b\u8be5\u7528\u6237\u7684\u90a3\u4e00\u884c\u4e2d\u7684\u4e09\u4e2a\u5782\u76f4\u5706\u70b9&nbsp;", "47a0e93957485bdf724981e637efe3fd": "5. \u4ece\u5217\u8868\u4e2d\u627e\u5230\u60a8\u7684\u56e2\u961f\uff0c\u5e76\u70b9\u51fb\u65b9\u6846\u4ee5\u9009\u4e2d\u5b83\u3002\u786e\u4fdd\u56e2\u961f\u540d\u79f0\u53f3\u4fa7\u51fa\u73b0\u4e00\u4e2a\u7eff\u8272\u7684\u590d\u9009\u6807\u8bb0\u3002&nbsp;", "05f2f3d131340b7ea500aea6927c478f": "6. \u70b9\u51fb\u201c\u6dfb\u52a0\u201d\u6309\u94ae\u3002\u60a8\u4f1a\u770b\u5230\u56e2\u961f\u540d\u79f0\u51fa\u73b0\u5728\u201c\u4e0e\u6b64\u533a\u57df\u5173\u8054\u7684\u56e2\u961f\u201d\u6807\u9898\u4e0b\u65b9\u5217\u8868\u4e2d\u3002\u60a8\u4e5f\u53ef\u4ee5\u5728\u6b64\u79fb\u9664\u56e2\u961f\u4e0e\u8fd9\u4e2a\u533a\u57df\u7684\u5173\u8054\u5173\u7cfb\u3002&nbsp;", "c454c0feca92d827b4c51409baadf262": "\u5982\u4f55\u5c06\u81ea\u5b9a\u4e49\u6a21\u677f\u4e0e\u5173\u6ce8\u533a\u57df\u76f8\u5173\u8054\u3002&nbsp;", "41cd82c12437ec751f8ea09dd4c7dfc0": "Forest Watcher \u5728 Forest Watcher Mobile \u4e2d\u63d0\u4f9b\u4e86\u4e24\u4e2a\u9ed8\u8ba4\u62a5\u544a\u6a21\u677f\uff0c\u4f9b\u60a8\u7528\u4e8e\u91c7\u96c6\u73b0\u573a\u6570\u636e\u3002\u4f46\u662f\uff0c\u60a8\u53ef\u80fd\u4f1a\u53d1\u73b0\uff0c\u60a8\u9700\u8981\u6bd4\u9ed8\u8ba4\u6a21\u677f\u63d0\u4f9b\u7684\u66f4\u591a\u6216\u4e0d\u540c\u7684\u95ee\u9898\u6765\u652f\u6301\u60a8\u7684\u76d1\u63a7\u8ba1\u5212\u3002\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u60a8\u53ef\u4ee5\u5728 Forest Watcher Web \u4e2d\u521b\u5efa\u4e00\u4e2a\u81ea\u5b9a\u4e49\u62a5\u544a\u6a21\u677f\uff0c\u5e76\u4f7f\u7528 Forest Watcher Web \u5c06\u5176\u4e0e\u4e00\u4e2a\u6216\u591a\u4e2a\u5173\u6ce8\u533a\u57df\u5173\u8054\u8d77\u6765\u3002\u80fd\u591f\u8bbf\u95ee\u5173\u6ce8\u533a\u57df\u7684\u4efb\u4f55\u7528\u6237\u968f\u540e\u53ea\u8981\u540c\u6b65\u4ed6\u4eec\u7684\u8bbe\u5907\uff0c\u5c31\u53ef\u4ee5\u5728 Forest Watcher Mobile \u4e2d\u4f7f\u7528\u4ed6\u4eec\u7684\u81ea\u5b9a\u4e49\u6a21\u677f\u3002\u60a8\u53ef\u4ee5\u521b\u5efa\u7684\u81ea\u5b9a\u4e49\u62a5\u8868\u6a21\u677f\u5728\u6570\u91cf\u4e0a\u6ca1\u6709\u9650\u5236\u3002&nbsp;", "3a005648e8d936d8eae0792cfdb85b56": "<strong><a href=\"{{0}}\">\u5728 Forest Watcher \u4e0a\u7ba1\u7406\u56e2\u961f</a>\uff1a</strong>\u9605\u8bfb\u6709\u5173 Forest Watcher \u56e2\u961f\u4e0d\u540c\u89d2\u8272\u7684\u66f4\u591a\u6307\u5357\uff0c\u5305\u62ec\u5982\u4f55\u6210\u4e3a\u76d1\u5bdf\u5458\u6216\u7ba1\u7406\u8005\u3002 &nbsp;", "a1daad1bcdd1b644680ab165bd76fac8": "\u8bbe\u7f6e\u5e94\u7528&nbsp;", "486839632e92433fc4853e41a40f953f": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5982\u4f55\u5c06 Forest Watcher (FW) \u79fb\u52a8\u7248\u4e2d\u7684\u62a5\u544a\u548c\u8def\u7ebf\u540c\u6b65\u5230 FW \u7f51\u9875\u7248\u3002\u5982\u4f55\u5728 FW \u7f51\u9875\u7248\u4e2d\u67e5\u770b\u62a5\u544a\u548c\u8def\u7ebf\u3002&nbsp; \u8981\u5f00\u59cb\u672c\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a&nbsp; \u5728 FW \u79fb\u52a8\u7248\u4e2d\u521b\u5efa\u81f3\u5c11\u4e00\u4e2a\u533a\u57df\u3001\u62a5\u544a\u6216\u8def\u7ebf\u3002&nbsp; \u5206\u6b65\u6307\u5bfc&nbsp; \u4ece FW \u79fb\u52a8\u7248\u540c\u6b65\u62a5\u544a\u548c\u8def\u7ebf [\u2026]", "32d34aab8e6642e4a7b86e13cadd8fb4": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5982\u4f55\u66f4\u6539\u5750\u6807\u683c\u5f0f\u3002&nbsp; \u5982\u4f55\u8fdb\u5165\u79bb\u7ebf\u6a21\u5f0f\u3002&nbsp; \u5982\u4f55\u627e\u5230\u6709\u5173 Forest Watcher \u7684\u66f4\u591a\u4fe1\u606f\u3002&nbsp; \u8981\u5f00\u59cb\u672c\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a&nbsp; MyGFW \u8d26\u6237\u3002\u5982\u679c\u60a8\u6ca1\u6709\u8d26\u6237\uff0c\u8bf7\u8f6c\u5230\u6b64\u9875\u9762\u8fdb\u884c\u6ce8\u518c\u3002&nbsp; \u7b80\u4ecb&nbsp; Forest Watcher \u79fb\u52a8\u7248\u4e3a\u7528\u6237\u63d0\u4f9b\u4e86\u51e0\u4e2a [\u2026]", "2d7db4a0ab65c33299ed2992c99192a7": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5982\u4f55\u5728 Forest Watcher \u7f51\u9875\u7248\u4e2d\u4e3a\u60a8\u7684\u76d1\u63a7\u56e2\u961f\u9009\u62e9\u73af\u5883\u56fe\u5c42&nbsp; \u56e2\u961f\u6210\u5458\u5982\u4f55\u5728 Forest Watcher \u79fb\u52a8\u7248\u548c Forest Watcher \u7f51\u9875\u7248\u4e2d\u4f7f\u7528\u8fd9\u4e9b\u73af\u5883\u56fe\u5c42&nbsp; \u8981\u5f00\u59cb\u672c\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a&nbsp; MyGFW \u8d26\u6237\u3002\u5982\u679c\u60a8\u6ca1\u6709\u8d26\u6237\uff0c\u8bf7\u8f6c\u5230\u6b64\u9875\u9762 [...]", "6911a70cbf7303a4302da4282d3d7cf6": "\u52a0\u5165\u4e00\u4e2a\u76d1\u63a7\u56e2\u961f", "3ebe1db6c8d69eaba1506b8b72977919": "1. \u9009\u62e9<strong>\u7ed8\u5236\u65b0\u533a\u57df\u3002&nbsp;</strong>", "e8f3ab0e1132a449591b455521b98961": "4. \u4e3a\u60a8\u7684\u533a\u57df<strong>\u8f93\u5165\u4e00\u4e2a\u540d\u79f0</strong>\uff0c\u7136\u540e\u6309<strong>\u201c\u5b8c\u6210\u201d\u3002&nbsp;</strong>", "cf614d705e601efb2ebdb87b2829ae3f": "1. \u9009\u62e9<strong>\u4e0a\u4f20 shapefile \u6587\u4ef6</strong>\u3002&nbsp;", "0f6ee7d819822f321e8af9c8204feb87": "3. \u4e3a\u60a8\u7684\u533a\u57df<strong>\u8f93\u5165\u4e00\u4e2a\u540d\u79f0</strong>\uff0c\u7136\u540e\u6309<strong>\u201c\u5b8c\u6210\u201d\u3002</strong>&nbsp;", "ceb2c7c79776527a887a1f6e36116cd6": "4. \u60a8\u7684\u533a\u57df\u5c06\u663e\u793a\u5728<strong>\u201c\u533a\u57df\u201d</strong>\u754c\u9762\u4e2d\u7684<strong>\u201c\u6211\u7684\u533a\u57df\u201d</strong>\u4e0b\u3002&nbsp;&nbsp;", "d2ede1102881acab8f6fa97a594b0db8": "\u65b9\u6cd5 3\uff1a", "b5a7a4ca435ab9cea53298bbde1aec7f": "3. \u8fd9\u5c06\u6253\u5f00<strong>\u56fe\u5c42</strong>\u9762\u677f\u3002&nbsp;&nbsp;", "aa6e0503ca479178217d5a7140539258": "5. \u5982\u679c\u60a8\u60f3\u4e86\u89e3\u6709\u5173\u6bcf\u4e2a\u5e95\u56fe\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605\u6b64 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">GFW \u6559\u7a0b</a>\u4e2d\u7684\u7b2c 4 \u6b65\u3002&nbsp;&nbsp;", "a4b799e2516c784b83e4dcae8a694e3b": "\u5982\u4f55\u5728\u56fe\u5c42\u9762\u677f\u4e2d\u8fc7\u6ee4\u9884\u8b66\u60c5\u62a5\u3002&nbsp;", "3f386cf03d95d4b84cf7d72dccca1927": "\u5982\u4f55\u4e0b\u8f7d\u73af\u5883\u56fe\u5c42\u548c\u5e95\u56fe\u3002&nbsp;", "c3d5a778e1a2519e8a6e5e08eabd2ea3": "\u5982\u4f55\u5c06\u60a8\u7684\u8bbe\u5907\u8bbe\u7f6e\u4e3a\u79bb\u7ebf\u6a21\u5f0f&nbsp;", "5ee044e50b3450752f1b9a42e7e8f702": "\u4e3a\u786e\u4fdd\u80fd\u5728\u5b9e\u5730\uff08\u7f51\u7edc\u8fde\u63a5\u53d7\u9650\u6216\u65e0\u7f51\u7edc\u8fde\u63a5\u7684\u60c5\u51b5\u4e0b\uff09\u8bbf\u95ee Forest Watcher \u6570\u636e\uff0c\u60a8\u5e94\u8be5\u63d0\u524d\u4e0b\u8f7d\u9884\u8b66\u60c5\u62a5\u3001\u73af\u5883\u56fe\u5c42\u548c\u5e95\u56fe\u3002\u5982\u679c\u7f51\u901f\u8f83\u6162\uff0c\u4e0b\u8f7d\u9884\u8b66\u60c5\u62a5\u53ef\u80fd\u9700\u8981\u51e0\u4e2a\u5c0f\u65f6\u624d\u80fd\u5b8c\u6210\u3002\u56e0\u6b64\uff0c\u6211\u4eec\u5efa\u8bae\u81f3\u5c11\u5728\u5b9e\u5730\u8003\u5bdf\u524d\u4e00\u5929\u8fdb\u884c\u6b64\u64cd\u4f5c\u3002", "8e343004a9d5a3283ba15090f6ef2b9d": "3. \u4e3b\u5c4f\u5e55\u4e0a\u4f1a\u51fa\u73b0<strong>\u540c\u6b65\u5e94\u7528\u6570\u636e\u5230 Forest Watcher</strong>\u7684\u6307\u793a\u4fe1\u606f\u3002&nbsp;&nbsp;", "7729e4439be414663a918214faa3a1c1": "4. <strong>\u540c\u6b65\u5b8c\u6210</strong>\u540e\uff0c\u6307\u793a\u4fe1\u606f\u5c06\u6d88\u5931\u3002&nbsp;&nbsp;", "86ba150c4de5dca357c514cc043da02c": "5. \u9009\u62e9\u7279\u5b9a\u7684\u9884\u8b66\u7cfb\u7edf\uff1a&nbsp;&nbsp;", "0c448af8e92a3e51435654dc365bd31e": "2. \u8981\u4e0b\u8f7d\u73af\u5883\u56fe\u5c42\uff1a&nbsp;", "e14db6ba432888c07a0ee4dcecb56bab": "\u70b9\u6309<strong>\u201c\u7ba1\u7406\u73af\u5883\u56fe\u5c42\u201d</strong>\u6309\u94ae\u3002&nbsp;", "754473efa1333b86d0d5a4053fe34847": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp;\u5982\u4f55\u5728 Forest Watcher \u7f51\u9875\u7248\u4e2d\u7ba1\u7406\u611f\u5174\u8da3\u7684\u533a\u57df\u3002&nbsp; \u5728 Forest Watcher \u7f51\u9875\u7248\u4e2d\u521b\u5efa\u533a\u57df\u7684\u4e24\u79cd\u4e0d\u540c\u65b9\u6cd5\uff1a\u7ed8\u5236\u8fb9\u754c\u6216\u4e0a\u4f20\u5730\u7406\u7a7a\u95f4\u6587\u4ef6\u3002&nbsp; \u5982\u4f55\u4fee\u6539\u548c\u5220\u9664\u533a\u57df\u3002&nbsp; \u8981\u5b8c\u6210\u672c\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a&nbsp; MyGFW \u8d26\u6237\u3002\u5982\u679c\u60a8\u6ca1\u6709 [\u2026]", "da916b04c4a08db22352e492a5f31dfe": "\u5982\u679c\u60a8\u6ca1\u6709 MyGFW \u8d26\u6237\uff0c\u53ef\u4ee5\u70b9\u51fb<strong>\u6ce8\u518c</strong>\u6765\u521b\u5efa\u3002\u8fd9\u5c06\u4f7f\u60a8\u53ef\u4ee5\u901a\u8fc7 My GFW \u8d26\u6237\u5728 Forest Watcher \u5e94\u7528\u548c GlobalForestWatch.org \u7f51\u7ad9\u4e0a\u540c\u6b65\u60a8\u611f\u5174\u8da3\u7684\u533a\u57df\u548c\u6570\u636e\u3002&nbsp;", "891a149891e86ee29d68ed23914b10b3": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5728 Forest Watcher \u7f51\u9875\u7248\u4e2d\uff0c\u54ea\u91cc\u53ef\u4ee5\u521b\u5efa\u81ea\u5b9a\u4e49\u62a5\u544a\u6a21\u677f\u3002&nbsp; \u54ea\u4e9b\u95ee\u9898\u7c7b\u578b\u53ef\u4ee5\u6dfb\u52a0\u5230\u6a21\u677f\u4e2d\u3002&nbsp; \u5982\u4f55\u5728\u6a21\u677f\u4e2d\u5229\u7528\u6761\u4ef6\u903b\u8f91\u6765\u6839\u636e\u4ee5\u524d\u7684\u56de\u7b54\u663e\u793a\u6216\u9690\u85cf\u7279\u5b9a\u95ee\u9898\u3002&nbsp; \u5982\u4f55\u5c06\u81ea\u5b9a\u4e49\u6a21\u677f\u4e0e\u611f\u5174\u8da3\u7684\u533a\u57df\u5173\u8054\u3002&nbsp; \u8981 [\u2026]", "4de750a1125fd7fb2fac5a62c6fa3cc0": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5728 Forest Watcher \u7f51\u9875\u7248\u4e2d\uff0c\u54ea\u91cc\u53ef\u4ee5\u521b\u5efa\u56e2\u961f\u3002&nbsp; \u5982\u4f55\u9080\u8bf7\u7528\u6237\u52a0\u5165\u56e2\u961f\u3002&nbsp; \u5982\u4f55\u4e3a\u56e2\u961f\u6210\u5458\u5206\u914d\u6216\u5220\u9664\u7ba1\u7406\u4eba\u5458\u89d2\u8272\u3002&nbsp; \u5982\u4f55\u5c06\u60a8\u7684\u56e2\u961f\u4e0e\u611f\u5174\u8da3\u7684\u533a\u57df\u5173\u8054\u8d77\u6765\u3002&nbsp; \u5982\u4f55\u5c06\u7ba1\u7406\u5458\u89d2\u8272\u8f6c\u79fb\u7ed9\u53e6\u4e00\u4f4d\u7ba1\u7406\u4eba\u5458\u3002&nbsp; \u5982\u4f55\u4fee\u6539 [\u2026]", "a54107c7c14b855f34542dfeeb212678": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5982\u4f55\u5f00\u59cb\u5bf9\u611f\u5174\u8da3\u7684\u533a\u57df\u8fdb\u884c\u684c\u9762\u8c03\u67e5\u3002&nbsp; \u5982\u4f55\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u68ee\u6797\u6ee5\u4f10\u548c\u706b\u707e\u9884\u8b66\u3002&nbsp; \u54ea\u4e9b\u5e95\u56fe\u548c\u73af\u5883\u56fe\u5c42\u53ef\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u3002&nbsp; \u5982\u4f55\u6bd4\u8f83\u4e0d\u540c\u65e5\u671f\u7684\u9ad8\u6e05\u5730\u7403\u5f71\u50cf\u56fe\u3002&nbsp; \u8981\u5b8c\u6210\u672c\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a&nbsp; MyGFW [\u2026]", "7dd680f8e5dc537b943bca8d0b569ab0": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5728 Forest Watcher \u7f51\u9875\u7248\u4e2d\uff0c\u54ea\u91cc\u53ef\u4ee5\u521b\u5efa\u4efb\u52a1\u3002\u8bc6\u522b\u4efb\u52a1\u533a\u57df\u7684\u4e09\u79cd\u4e0d\u540c\u65b9\u6cd5\u3002&nbsp; \u7528\u4e8e\u81ea\u5b9a\u4e49\u4efb\u52a1\u7684\u9009\u9879\uff0c\u5305\u62ec\u5176\u4f18\u5148\u7ea7\u548c\u63a5\u6536\u8005\u3002&nbsp; \u5982\u4f55\u8ddf\u8e2a\u4efb\u52a1\u72b6\u6001\u3002&nbsp; \u5982\u4f55\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u4efb\u52a1\u3002&nbsp; \u5982\u4f55\u4fee\u6539\u548c\u5220\u9664 [\u2026]", "5eb4a52999c20602bc72f267873f3993": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5982\u4f55\u5728 Forest Watcher \u7f51\u9875\u7248\u4e2d\u52a0\u5165\u56e2\u961f&nbsp; \u5982\u4f55\u5728 Forest Watcher \u79fb\u52a8\u7248\u4e2d\u52a0\u5165\u56e2\u961f&nbsp; \u8981\u5f00\u59cb\u672c\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a&nbsp; MyGFW \u8d26\u6237\u3002\u5982\u679c\u60a8\u6ca1\u6709\u8d26\u6237\uff0c\u8bf7\u8f6c\u5230\u6b64\u9875\u9762\u8fdb\u884c\u6ce8\u518c\u3002&nbsp; \u81f3\u5c11\u4e00\u4efd\u6765\u81ea\u522b\u7684 Forest Watcher \u7684\u56e2\u961f\u9080\u8bf7 [...]", "7d1ef082b99285077fc0d6b9f6c5cd1e": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5728 Forest Watcher \u79fb\u52a8\u7248\u4e2d\uff0c\u54ea\u91cc\u53ef\u4ee5\u627e\u5230\u4efb\u52a1\u3002&nbsp; \u5982\u4f55\u5206\u7c7b\u4efb\u52a1\u3002&nbsp; \u5982\u4f55\u5c06\u4efb\u52a1\u6807\u8bb0\u4e3a\u201c\u6682\u505c\u201d\u4ee5\u901a\u77e5\u4efb\u52a1\u521b\u5efa\u8005\u60a8\u73b0\u5728\u65e0\u6cd5\u5b8c\u6210\u6b64\u4efb\u52a1\u3002&nbsp; \u5982\u4f55\u5f00\u59cb\u548c\u5b8c\u6210\u4efb\u52a1\u3002&nbsp; \u8981\u5f00\u59cb\u672c\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a&nbsp; MyGFW [\u2026]", "5f8734a0403e583ddf76affbb4d92a24": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5982\u4f55\u5728\u60a8\u7684\u624b\u673a\u6216\u8bbe\u5907\u4e0a\u8bbe\u7f6e Forest Watcher \u5e94\u7528\u3002&nbsp;&nbsp; \u8981\u5f00\u59cb\u672c\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a&nbsp; \u4ece Google Play\uff08Android \u8bbe\u5907\u4e0a\uff09\u6216 Apple App Store\uff08iPhone \u8bbe\u5907\u4e0a\uff09\u4e0b\u8f7d Forest Watcher \u79fb\u52a8\u5e94\u7528\u3002&nbsp; \u7b80\u4ecb&nbsp; Forest Watcher \u53ef\u4ee5\u5728\u4efb\u4f55\u914d\u5907\u4e0b\u8ff0\u7cfb\u7edf\u7684 iPhone \u4e0a\u8fd0\u884c [\u2026]", "9d6496ed7989a6388a72518c11d325d9": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5982\u4f55\u521b\u5efa\u611f\u5174\u8da3\u7684\u533a\u57df\u3002&nbsp; \u5982\u4f55\u901a\u8fc7\u52a0\u5165\u56e2\u961f\u6765\u76d1\u63a7\u533a\u57df\u3002&nbsp; \u5982\u4f55\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u548c\u81ea\u5b9a\u4e49\u60a8\u7684\u533a\u57df\u3002&nbsp; \u8981\u5f00\u59cb\u672c\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a&nbsp; \u521b\u5efa Forest Watcher \u8d26\u6237\uff08\u6709\u5173\u8bf4\u660e\uff0c\u8bf7\u53c2\u9605\u6559\u7a0b\u201c\u8bbe\u7f6e Forest Watcher \u79fb\u52a8\u5e94\u7528\u201d [\u2026]", "4bda9675744295c3826223a51eb11521": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5982\u4f55\u4ece\u4e3b\u5c4f\u5e55\u540c\u6b65\u9884\u8b66\u60c5\u62a5\u3002&nbsp; \u5982\u4f55\u5728\u56fe\u5c42\u9762\u677f\u4e2d\u8fc7\u6ee4\u9884\u8b66\u60c5\u62a5\u3002&nbsp; \u5982\u4f55\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u9884\u8b66\u60c5\u62a5\u3002&nbsp; \u5982\u4f55\u4e0b\u8f7d\u73af\u5883\u56fe\u5c42\u548c\u5e95\u56fe\u3002&nbsp; \u5982\u4f55\u5c06\u60a8\u7684\u8bbe\u5907\u8bbe\u7f6e\u4e3a\u79bb\u7ebf\u6a21\u5f0f&nbsp; \u8981\u5f00\u59cb\u672c\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a&nbsp; \u81f3\u5c11\u521b\u5efa\u4e00\u4e2a [\u2026]", "6c21148ed85fdefdaf0700fad6bee099": "1. \u6309<strong>\u201c\u8fd4\u56de\u201d</strong>\u6309\u94ae\u8fd4\u56de\u60a8\u7684\u533a\u57df\u3002\u5982\u679c\u60a8\u6ca1\u6709\u5728\u60a8\u7684\u533a\u57df\u4e2d\u770b\u5230\u4efb\u4f55\u9884\u8b66\uff0c\u5219\u53ef\u80fd\u9700\u8981\u8c03\u6574\u9884\u8b66\u7684\u65f6\u95f4\u8303\u56f4\uff08\u8bf7\u53c2\u9605\u4e0a\u9762\u7684\u201c\u5728\u56fe\u5c42\u9762\u677f\u4e2d\u8fc7\u6ee4\u9884\u8b66\u60c5\u62a5\u201d<strong></strong>\u4e2d\u7684\u7b2c 6 \u6b65<strong></strong>\uff09\u3002&nbsp;", "f32bc1bef9e07541ed0ecbccb58572e7": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5982\u4f55\u5728\u5730\u56fe\u4e0a\u9009\u62e9\u9884\u8b66\u5730\u5e26\u6216\u4f4d\u7f6e\u3002&nbsp; \u5982\u4f55\u5728\u5730\u56fe\u4e0a\u8ddf\u8e2a\u8def\u7ebf\u548c\u67e5\u770b\u8def\u7ebf\u3002&nbsp; \u5982\u4f55\u5728\u5730\u56fe\u4e0a\u521b\u5efa\u548c\u67e5\u770b\u62a5\u544a\u3002&nbsp; \u8981\u5f00\u59cb\u672c\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a&nbsp; \u4e0b\u8f7d\u9884\u8b66\u60c5\u62a5\uff08\u8bf7\u53c2\u9605\u4e0b\u8f7d [...] \u4e2d\u7684\u201c\u4ece\u4e3b\u5c4f\u5e55\u4e0b\u8f7d\u6216\u540c\u6b65\u9884\u8b66\u60c5\u62a5\u201d ", "95084822d6765b5a4afd5b20c633b434": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5982\u4f55\u5c06\u62a5\u544a\u5bfc\u51fa\u4e3a CSV\u3002&nbsp; \u5982\u4f55\u4e0e\u5176\u4ed6\u8bbe\u5907\u5171\u4eab Forest Watcher \u6570\u636e\u3002&nbsp; \u5982\u4f55\u5bfc\u5165\u5171\u4eab\u5305\u3002&nbsp; \u8981\u5f00\u59cb\u672c\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a&nbsp; \u81f3\u5c11\u521b\u5efa\u4e00\u4e2a\u533a\u57df\u3001\u62a5\u544a\u6216\u8def\u7ebf\u3002&nbsp; \u5206\u6b65\u6307\u5bfc&nbsp; \u5c06