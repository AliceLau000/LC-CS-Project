a\u6837\u6027\u7684\u70ed\u70b9\u5730\u533a\u4ee5\u53ca\u66f4\u591a\u5185\u5bb9", "c6136f055381646fee0e6bc4efcd3c7f": "\u8001\u864e\u6816\u606f\u5730\u7684\u60c5\u51b5\u5982\u4f55\uff1f", "35e3def79721ee4ce09444fa8862f374": "13 \u4e2a\u56fd\u5bb6\u7684\u76ee\u6807\u662f\u5230 2022 \u5e74\uff0c\u4e5f\u5c31\u662f\u4e0b\u4e00\u4e2a\u864e\u5e74\uff0c\u91ce\u751f\u8001\u864e\u7684\u6570\u91cf\u7ffb\u4e00\u756a\u3002\u67e5\u770b\u8fc7\u53bb\u4e00\u5e74\u8001\u864e\u91cd\u8981\u6816\u606f\u5730\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u3002", "c884ff9b7ddef6afc430ac4308a0f659": "\u60a8\u8fd8\u60f3\u5728 GFW \u4e0a\u770b\u5230\u54ea\u4e9b\u751f\u7269\u591a\u6837\u6027\u6570\u636e\u548c\u5206\u6790\uff1f", "3a1af15ed5f049f79d4e40b8d9328387": "\u70b9\u51fb\u5730\u56fe\u4e0a\u7684\u56fe\u5f62\u6216\u5212\u9009\u6216\u4e0a\u4f20\u56fe\u5f62\uff0c\u5206\u6790\u4f60\u611f\u5174\u8da3\u7684\u533a\u57df\u5185\u7684\u68ee\u6797\u53d8\u5316\u3002", "b73a4cc0c608505e0c7455f2ecb5e2da": "\u60a8\u60f3\u8981\u505a\u4ec0\u4e48\uff1f", "4c7d5d7dfde4a7bd82b54348182043d3": "\u5176\u4ed6\u8d44\u6e90", "1d444e7c06fd8d12b2518e4b8c9afaaa": "\u5728 GFW \u91cc\u4e86\u89e3\u66f4\u591a", "7490efe28ae51cd9fa665560f807928e": "\u5728\u5730\u56fe\u4e0a\u753b\u51fa\u60a8\u60f3\u8981\u5206\u6790\u7684\u533a\u57df", "ecb4630ea47ee008f15b17207039e6eb": "\u62d6\u653e\u60a8\u7684<b>\u591a\u8fb9\u5f62\u6570\u636e\u6587\u4ef6</b>\uff0c\u6216\u8005\u5355\u51fb\u6b64\u5904\u8fdb\u884c\u4e0a\u4f20", "b9918ed17b5c8babddabc5a536902195": "\u5efa\u8bae\u6587\u4ef6\u5927\u5c0f &lt; 1 MB", "b48050844e860e6f80edda86cf1c3fb6": "\u4e86\u89e3\u66f4\u591a\u5173\u4e8e\u652f\u6301\u7684\u6587\u4ef6\u683c\u5f0f\u7684\u4fe1\u606f", "eda72f3bc8f41ec45935ce566a28c1f6": "\u4e0a\u4f20\u8d44\u6599\u5373\u8868\u793a\u60a8\u540c\u610f<a href=\"{{0}}\" target=\"_blank\" rel=\"noopenner nofollower\">\u300aGFW\u670d\u52a1\u6761\u6b3e\u300b</a>", "939d2f1253fc999f3bfc8ab78968e83e": "\u5c0f\u989d\u8d44\u52a9\u91d1", "3d7691949c9a44fa9402dce2d05a0cfd": "\u5728\u68ee\u6797\u5730\u533a\u53ca\u5176\u5468\u56f4\u5f00\u5c55\u6d3b\u52a8\u7684\u6c11\u95f4\u793e\u4f1a\u7ec4\u7ec7\u662f\u68ee\u6797\u517b\u62a4\u548c\u7ba1\u7406\u7684\u4e00\u4e9b\u6700\u6709\u6548\u7684\u62e5\u62a4\u8005\u3002\u7136\u800c\uff0c\u4ed6\u4eec\u5f80\u5f80\u7f3a\u4e4f\u8d44\u6e90\u6216\u77e5\u8bc6\uff0c\u4e0d\u77e5\u9053\u5982\u4f55\u5c06\u6700\u65b0\u7684\u68ee\u6797\u76d1\u6d4b\u6280\u672f\u7eb3\u5165\u4ed6\u4eec\u7684\u7814\u7a76\u3001\u5ba3\u4f20\u548c\u5b9e\u5730\u5de5\u4f5c\u3002Small Grants Fund \u5411\u4e16\u754c\u5404\u5730\u7684\u7ec4\u7ec7\u63d0\u4f9b\u8d22\u653f\u548c\u6280\u672f\u652f\u6301\uff0c\u5229\u7528 Global Forest Watch \u7684\u5de5\u5177\u548c\u6570\u636e\u5c06\u68ee\u6797\u76d1\u6d4b\u4fe1\u606f\u8f6c\u5316\u4e3a\u884c\u52a8\u3002\u4e0e\u5f53\u5730\u7ec4\u7ec7\u5bc6\u5207\u5408\u4f5c\uff0c\u4e5f\u6709\u52a9\u4e8e GFW \u4e86\u89e3\u6211\u4eec\u5982\u4f55\u624d\u80fd\u6700\u597d\u5730\u8c03\u6574\u6211\u4eec\u7684\u5de5\u5177\uff0c\u4ee5\u6ee1\u8db3\u8fd9\u4e2a\u7528\u6237\u7fa4\u4f53\u7684\u72ec\u7279\u9700\u6c42\u3002", "7e5c5a593cc3969c9d5c2298bf01a1f9": " \u9879\u76ee\u4f18\u52bf", "a142d4c787404ab0f7fd6eb6a1f11d72": "Small Grants Fund \u9879\u76ee\u5229\u7528 GFW \u7684\u6570\u636e\u8bc1\u660e\u4e86\u793e\u533a\u76d1\u6d4b\u68ee\u6797\u7684\u597d\u5904\uff0c\u52a0\u5f3a\u793e\u533a\u571f\u5730\u6743\u7684\u76d1\u6d4b\uff1b\u63d0\u9192\u5f53\u5c40\u6ce8\u610f\u975e\u6cd5\u780d\u4f10\u68ee\u6797\uff0c\u5bf9\u8087\u4e8b\u8005\u5904\u4ee5\u7f5a\u6b3e\uff1b\u5e76\u53d1\u8d77\u8fd0\u52a8\uff0c\u63d0\u9ad8\u4eba\u4eec\u5bf9\u6bc1\u6797\u9a71\u52a8\u56e0\u7d20\u7684\u8ba4\u8bc6\uff0c\u8ffd\u7a76\u8d23\u4efb\u4eba\u7684\u8d23\u4efb\u3002", "fd69c5cf902969e6fb71d043085ddee6": "\u7ed3\u679c", "fd0ac2cb10ab547f9cb4c8852169a4e2": "<b>30 \u4e2a\u56fd\u5bb6\uff08\u5730\u533a\uff09</b>\u7684<b>44 \u4e2a\u9879\u76ee</b>", "6034da75b6d334b5836f3d7c6cefb03d": "\u4f7f\u7528 GFW \u76d1\u6d4b\u7684\u68ee\u6797\u9762\u79ef\u8d85\u8fc7<b>18 \u4ebf\u516c\u9877</b>", "24ec0a7895b5965fdefea7d0f42ecbcc": "\u8d85\u8fc7 <b>1,800</b> \u4eba\u5728\u7ecf\u8fc7\u57f9\u8bad\u540e\u6b63\u5728\u4f7f\u7528 GFW", "a8ba189929b5fead2f59850f81fd5f84": "Global Forest Watch \u6280\u672f\u7814\u7a76\u91d1\u65e8\u5728\u62db\u52df\u548c\u57f9\u8bad\u4f7f\u7528\u5f00\u521b\u6027\u7684\u6280\u672f\u89e3\u51b3\u65b9\u6848\u548c\u5927\u6570\u636e\u6765\u5e94\u5bf9\u65e5\u76ca\u4e25\u5cfb\u7684\u68ee\u6797\u95ee\u9898\u65b9\u9762\u6700\u4f18\u79c0\u548c\u6700\u806a\u660e\u7684\u68ee\u6797\u7ba1\u7406\u4eba\u5458\u3001\u5b88\u62a4\u8005\u548c\u5f8b\u5e08\uff0c\u5e76\u534f\u52a9\u5176\u4ed6\u7f51\u7edc\u4e2d\u7684\u5fd7\u540c\u9053\u5408\u8005\u3002\u8be5\u7814\u7a76\u91d1\u8ba1\u5212\u7684\u76ee\u6807\u662f\u901a\u8fc7\u5efa\u7acb\u4e00\u4e2a GFW \u9ad8\u7ea7\u7528\u6237\u548c\u652f\u6301\u8005\u7684\u793e\u533a\u6765\u534f\u52a9\u5728\u4f18\u5148\u56fd\u5bb6\u4f7f\u7528\u8be5\u5e73\u53f0\uff0c\u4ee5\u6b64\u6269\u5927\u5f71\u54cd\uff0c\u5e76\u5c31\u5982\u4f55\u5229\u7528 GFW \u5de5\u5177\u548c\u5176\u4ed6\u68ee\u6797\u76d1\u6d4b\u6280\u672f\u6765\u4fdd\u62a4\u5168\u7403\u4f18\u5148\u533a\u57df\u7684\u68ee\u6797\u8fbe\u6210\u7edf\u4e00\u5171\u8bc6\u3002\u7814\u7a76\u5458\u53ef\u4ee5\u662f\u5f53\u5730\u9886\u8896\u3001\u8c03\u67e5\u8bb0\u8005\u3001\u516c\u76ca\u5f8b\u5e08\u3001\u6797\u4e1a\u5de5\u4f5c\u8005\u3001\u73af\u5883\u6267\u6cd5\u8005\u3001\u81ea\u7136\u8d44\u6e90\u4fdd\u62a4\u8005\uff0c\u6216\u8005\u5f00\u653e\u6570\u636e\u4e13\u5bb6\uff0c\u4ed6\u4eec\u5e94\u5145\u6ee1\u70ed\u60c5\uff0c\u53bb\u4e3a\u653f\u5e9c\u548c\u5730\u65b9\u6d3b\u52a8\u5bb6\u63d0\u4f9b\u57f9\u8bad\u548c\u6301\u7eed\u652f\u6301\uff0c\u4ee5\u4fbf\u5176\u5728\u5de5\u4f5c\u4e2d\u9ad8\u6548\u5730\u4f7f\u7528\u68ee\u6797\u6570\u636e\u548c\u76d1\u6d4b\u6280\u672f\uff0c\u63d0\u9ad8\u4ed6\u4eec\u53c2\u4e0e\u76d1\u6d4b\u975e\u6cd5\u6bc1\u6797\u7684\u80fd\u529b\u3002", "d23d0d497e7081df38d26116b0845b78": "\u652f\u6301\u5c0f\u989d\u5956\u52a9\u91d1\u53ca\u5956\u5b66\u91d1", "fa6f3b897460ad83fec5dbdc740e096f": "\u5982\u679c\u60a8\u60f3\u4e3a\u652f\u6301\u793e\u533a\u3001\u516c\u6c11\u793e\u4f1a\u3001\u7ec4\u7ec7\u548c\u4f7f\u7528 GFW \u4fdd\u62a4\u548c\u53ef\u6301\u7eed\u7ba1\u7406\u5168\u7403\u68ee\u6797\u7684\u4e2a\u4eba\u505a\u8d21\u732e\uff0c\u8bf7\u901a\u8fc7<a class=\"text -paragraph -color-4 -light\" href=\"{{0}}\">gfwfund@wri.org</a>\u8054\u7cfb\u6211\u4eec\u3002", "d95bb64f30d9dab30e820afef3f247f6": "2020 - \u5580\u9ea6\u9686\u3001\u4e4c\u5e72\u8fbe", "7337bd82f29aeda2c715685840bf072c": "\u68ee\u6797\u8986\u76d6\u51cf\u5c11 - 2001-2021", "fc25f8978a28513d6d2aaf0a72b72c9a": "2010 \u5e74\uff0c{location} \u6709 {naturalForest} \u7684\u5929\u7136\u6797\uff0c\u5360\u5176\u9646\u5730\u9762\u79ef\u7684 {percentage} \u4ee5\u4e0a\u3002{year} \u5e74\uff0c\u5176\u5929\u7136\u6797\u51cf\u5c11\u4e86 {naturalLoss}\uff0c\u76f8\u5f53\u4e8e\u6392\u653e\u4e86 {emissions} \u4e8c\u6c27\u5316\u78b3 (CO\u2082)\u3002", "c7b732242336c54390de2996652a058a": "\u4ece 2001 \u5e74\u5230 2012 \u5e74\uff0c{location}\u7684\u6811\u6728\u8986\u76d6{gain}\u7b49\u4e8e{gainPercent}\u603b\u91cf\u7684{parent}\u3002", "3453e34338cbbcd043a3584465afc27a": "\u5728{startYear}\u548c{endYear}\u95f4\uff0c\u7531\u4e8e{location}\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\uff0c\u603b\u5171{value}{type}\uff08\u6bcf\u5e74{annualAvg}\uff09\u88ab\u91ca\u653e\u5230\u5927\u6c14\u4e2d\u3002", "03c6a183e5f84a42d6745d87b77f3834": "{location} \u7684\u706b\u707e\u8b66\u62a5\u6b21\u6570", "8a3ac709ae2b9471fa4852effb645cd4": "\u4ece {startYear}\u5230 {endYear}\uff0c {location}\u7684\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u4e86 {loss} \uff0c \u76f8\u5f53\u4e8e\u81ea{extentYear}\u6765\u51cf\u5c11\u4e86  {localPercent}\uff0c\u5360\u5168\u7403\u603b\u6570\u7684 {globalPercent} \u3002", "b73583b90d3eeb026f3a1930fa9a95b9": "\u5728 {location}\uff0c\u571f\u5730\u7528\u9014\u7684\u53d8\u66f4\u4ee5\u53ca\u6797\u4e1a\u90e8\u95e8\u662f\u4e8c\u6c27\u5316\u78b3 (CO\u2082) \u7684 {type}\uff0c{startYear} \u81f3 {endYear} \u5e74\u95f4\u5e73\u5747\u6bcf\u5e74\u622a\u5b58 {value}\u3002\u8fd9\u76f8\u5f53\u4e8e\u62b5\u6d88\u4e86 {location_alt} \u540c\u671f\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u603b\u91cf\u7684 {percentage}\u3002", "dcfb6b1d033bd6fd3ba4a3e6a4b0d50b": "\u5728\u6700\u8fd1\u7684 {timeframe}\uff0c\u5728 {location} \u63a2\u6d4b\u5230 {count} \u4e2a GLAD \u9884\u8b66\u5728 {indicator} \u4e4b\u5185\uff0c\u5f71\u54cd\u4e86\u5927\u7ea6 {area} \u7684\u9762\u79ef\u3002\u524d {topRegions} \u5360\u6240\u6709 GLAD \u9884\u8b66\u7684 {topPercent}\u3002", "b4e0ab4fdb271d5dcd79259bfe02f605": "\u5728 {start_year} \u5230 {end_year} \u4e4b\u95f4\uff0c{location} \u7ecf\u5386\u4e86\u603b\u8ba1 {total_alerts} \u6b21 {dataset} \u706b\u707e\u8b66\u62a5\u3002", "ecded18ab6590651cb4fa8a8d97ce389": "\u622a\u81f3{year}\uff0c{location}\u7684{percentage}\u4e3a\u6811\u6728\u8986\u76d6\u3002", "b5a7489e0c976281a08afcac6f4abe9f": "\u57282010\u5e74\uff0c{location}\u62e5\u6709{extent}\u6811\u6728\u8986\u76d6\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684{percentage}\uff0c\u76f8\u5f53\u4e8e{emission}\u7684\u4e8c\u6c27\u5316\u78b3\u6392\u653e\u91cf\u3002", "b7a44772e64f5c136028b1d1ffdcd8e6": "\u5728 {startYear} \u5e74\u548c {endYear} \u5e74\u4e4b\u95f4\uff0c\u7531\u4e8e {location} \u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\uff0c\u603b\u5171\u6709 {value} \u7684 {type} \u91ca\u653e\u5230\u5927\u6c14\u4e2d\u3002\u8fd9\u76f8\u5f53\u4e8e\u6bcf\u5e74 {annualAvg}\u3002", "348728793ad4c30c00710c3947cfc64c": "{location} \u7684\u706b\u707e\u8b66\u62a5", "4c00224594e9e57cef438e32d0f8ad00": "{startYear}\u4ece{endYear}\u5230{location}\uff0c\u6811\u6728\u8986\u76d6\u635f\u5931{loss}\uff0c\u76f8\u5f53\u4e8e\u81ea{percent}\u4ee5\u6765\u4e0b\u964d{extentYear}\uff0c\u4ee5\u53ca{emissions}\u7684 CO\u2082 \u6392\u653e\u91cf\u3002", "776d2e94bc3f817f2cf45203954cfad3": "\u5728 {location}\uff0c\u571f\u5730\u7528\u9014\u53d8\u66f4\u548c\u6797\u4e1a\u90e8\u95e8\u662f\u4e00\u79cd {type} \u7684\u4e8c\u6c27\u5316\u78b3 (CO\u2082)\uff1b\u4ece {startYear} \u5e74\u5230 {endYear} \u5e74\uff0c\u5e73\u5747\u6bcf\u5e74\u6392\u653e {value}\u3002\u8fd9\u5360\u540c\u671f {location_alt} \u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u603b\u91cf\u7684 {percentage}\u3002", "39f468e889872ef0f705187c7c291da7": "\u6839\u636e\u8054\u5408\u56fd\u7cae\u519c\u7ec4\u7ec7(FAO)\u7684\u7edf\u8ba1\uff0c{year}\u5e74{location}\u5730\u533a\u7684\u68ee\u6797\u780d\u4f10\u7387\u4e3a {rate}\u3002", "a3ba47f3c1c48c197dd0602d824ec2f3": "\u4ece 2001 \u5e74\u5230 2012 \u5e74\uff0c{indicator} {location} \u5185\u7684\u6797\u6728\u8986\u76d6\u589e\u52a0\u4e86 {gain}\u3002", "a21d1a8dc031cab4517e16a71c1fe9b5": "\u663e\u793a\u5e26\u6709 {selector} \u51a0\u5c42\u5bc6\u5ea6\u7684\u68ee\u6797\u78b3\u6e05\u9664\u91cf", "eb6d6a5525ec315276c07687bfe1b126": "\u5168\u4e16\u754c\u524d 5 \u540d\u56fd\u5bb6\u7684\u5e73\u5747 {label} \u662f {value}\u3002", "b58354dd34a665ed88de3ee5f9f5063f": "\u5728\u8fc7\u53bb {timeframe}\uff0c{location} \u53d1\u73b0 {totalFires} \u6b21\u706b\u707e\u8b66\u62a5\u3002", "19c0ae348c18b51b05e4b20e5903b748": "\u4ece2001\u5e74\u52302012\u5e74\uff0c{location}\u83b7\u5f97\u7684\u6811\u6728\u8986\u76d6\u5ea6{indicator}\u7b49\u4e8e{parent}\u4e2d\u6240\u6709\u6811\u6728\u8986\u76d6\u5ea6\u589e\u76ca\u7684{gainPercent}\u3002", "a6d462e43ecb16f40f9d00dcf07e0aae": "{location} \u7684\u706b\u707e\u8b66\u62a5", "9c7618f3e4ad03f7b2d74fbc872033e0": "{location} \u7531\u751f\u7269\u91cf\u635f\u5931\u6240\u9020\u6210\u7684\u6392\u653e", "73d4ed3ec251d4b8edec27c1a241a303": "\u5728{date}\u7684\u4e00\u5468\u5185\u62a5\u544a\u4e86{count} {dataset}\u4e2a\u706b\u707e\u8b66\u62a5\u3002\u4e0e\u5f80\u5e74\u7684\u540c\u4e00\u5468\u76f8\u6bd4\uff0c{status}\u662f\u8fd9\u4e2a\u60c5\u51b5\u3002", "ffe3ea88637a82f558c78a1ef2d4e759": "\u6839\u636e FAO \u7684\u6570\u636e\u663e\u793a\uff0c{location} {year} \u5e74\u7684\u53bb\u68ee\u6797\u5316\u901f\u7387\u4e3a {rate}\u3002", "f240fbc5e369043956380b30cc0777dd": "\u8be5\u5730\u533a