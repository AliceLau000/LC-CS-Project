020 \u5e74\u6570\u636e", "53cced8d281a1a0ace3cb6594daaa4f7": "\u4f4e", "9def22a5d61748806513db5b8044d877": "\u9ad8\u7f6e\u4fe1\u5ea6\u9884\u8b66", "f8991da611c7054655e713bb6b19dd86": "RADD\uff1a\u7531\u4e8e\u536b\u661f\u6545\u969c\uff0c\u5f53\u524d\u9884\u8b66\u9891\u7387\u964d\u4f4e\u3002\u8bf7\u901a\u8fc7<a class=\"caution-link\" rel=\"noopener noreferrer\" href=\"{{0}}\" target=\"_blank\">\u6b64\u8bba\u575b\u5e16\u5b50</a>\u4e86\u89e3\u6700\u65b0\u60c5\u51b5\u3002", "46be2c438b9e8139779338f0fe0540b2": "\u5c55\u793a\u9009\u5b9a\u533a\u57df\u5185\u57fa\u4e8e\u6811\u6728\u8986\u76d6\u589e\u52a0\u7684\u9762\u79ef\u6392\u540d\uff082001 \u5e74\u81f3 2012 \u5e74\uff09\u3002", "b951914ea67bf1aa1ac5d068fb85db72": "\u8bf7\u6ce8\u610f\uff0c\u4e91\u5c42\u8986\u76d6\u53ef\u80fd\u4f1a\u4e25\u91cd\u9650\u5236\u9884\u8b66\u7684\u53ef\u7528\u6027\uff0c\u5ef6\u8fdf\u5bf9\u6700\u8fd1\u5931\u8c03\u60c5\u51b5\u7684\u63a2\u6d4b\u3002\u9884\u8b66\u7684\u65e5\u671f\u5bf9\u5e94\u4e8e\u63a2\u6d4b\u65e5\u671f\uff0c\u540e\u8005\u53ef\u80fd\u4f1a\u56e0\u4e91\u5c42\u8986\u76d6\u800c\u6bd4\u5931\u8c03\u53d1\u751f\u65f6\u95f4\u665a\u6570\u5468\u751a\u81f3\u6570\u6708\u3002\u9884\u8b66\u4f1a\u63a2\u6d4b\u5bf9\u6811\u51a0\u8986\u76d6\u5f71\u54cd\u5927\u4e8e 50% \u7684\u6240\u6709\u5931\u8c03\u60c5\u51b5\uff0c\u4f46\u4e0d\u4f1a\u533a\u5206\u81ea\u7136\u53d8\u5316\u548c\u4eba\u4e3a\u53d8\u5316\u3002", "54358a914f51e1af19df8520159fe607": "\u6536\u5165", "4848b99676526a4a3e0d3b559bf6c742": "\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd (DRC) \u539f\u59cb\u68ee\u6797\u51cf\u5c11\u7684\u70ed\u70b9", "497602d3b2309479373975c715cd56fa": "2020 \u5e74\u54e5\u4f26\u6bd4\u4e9a\u70ed\u5e26\u539f\u59cb\u68ee\u6797\u51cf\u5c11\u60c5\u51b5", "1aefd85334882d790698303653bb4c96": "\u5728\u51cf\u5c11\u68ee\u6797\u780d\u4f10\u65b9\u9762\u8868\u73b0\u4e86\u6709\u9650\u8fdb\u6b65\u7684\u5176\u4ed6\u519c\u4e1a\u5927\u5b97\u5546\u54c1\u662f\u53ef\u53ef\u548c\u5496\u5561\uff0c\u4f46\u5236\u4f5c\u8be6\u7ec6\u7684\u53ef\u53ef\