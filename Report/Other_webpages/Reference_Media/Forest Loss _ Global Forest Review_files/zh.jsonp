u7403\u706b\u707e\u5929\u6c14\u6307\u6570", "a469de87afa8cf3aa7ec306e54a72dc6": "\u5168\u7403\u7a7a\u6c14\u8d28\u91cf\u6307\u6570", "b0f14c514150158940ef4c73cd7853d2": "\u65b0\u5174\u70ed\u70b9", "122e00c0f9f14fea93808c38661889e6": "\u6309\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\u5206\u5217\u7684\u68ee\u6797\u8986\u76d6\u51cf\u5c11", "8e3b10188f5e7f9b1bddd68899d33f7f": "2001-2019, 10km, \u5168\u7403, Hansen/UMD/Google/USGS/NASA", "b7513426cc6491427461c6f430ff7603": "\u6bcf\u5e74\uff0c30m\uff0c\u5168\u7403\uff0cHansen/UMD/Google/USGS/NASA", "17a1353d8ccc643d9376c8de607f36f4": "12\u5e74\uff0c30m\uff0c\u5168\u7403\uff0cHansen/UMD/Google/USGS/NASA", "63a7c9fdd41ba9034db1eaeb3b0159d4": "2002-2020, \u70ed\u5e26, Harris et al.", "5c8bae5a82f2f943776cbb22a27699e1": "\u70b9\u51fb\u5730\u56fe\u4e0a\u7684\u56fe\u5c42", "560c5023a12f3f768e794084999db7f7": "\u5206\u6790\u548c\u8ffd\u8e2a\u68ee\u6797\u53d8\u5316", "7a698b219bd2a6e09281e505f7245904": "\u7ed8\u5236\u6216\u4e0a\u4f20\u56fe\u5f62", "ecb3e1acab7a49a9217f4a03eb880c0f": "\u9ed8\u8ba4\u60c5\u51b5\u4e0b\uff0c<button>\u571f\u5730\u5229\u7528</button>\u548c<button>\u751f\u7269\u591a\u6837\u6027</button>\u6807\u7b7e\u9875\u4e2d\u7684\u5927\u591a\u6570\u6570\u636e\u5c42\u4e5f\u53ef\u4ee5\u8fdb\u884c\u5206\u6790\u3002", "30d64c77414a3261de6eb1d8a8b9d5ae": "\u5f62\u72b6\u5206\u6790\u6216\uff1a", "dd0857ebee2b2e375ba50386be0c17d9": "\u4e0a\u5468\u7684\u8b66\u62a5\uff1a", "64c9d98f1c7cb4c80a8d2fdfca5c42d6": "\u6700\u540e\u66f4\u65b0\u65f6\u95f4 {date}", "aacacbf9b71f7b7387995a59caff86d4": "\u4ece\u6211\u7684 GFW \u7ba1\u7406\u5df2\u4fdd\u5b58\u7684\u533a\u57df", "992b6dcfe38c2b1b7555d38bba839080": "\u9664\u4e86\u5728\u5730\u56fe\u4e0a\u53ef\u89c6\u5316\u6570\u636e\u5c42\u5916\uff0cGFW \u8fd8\u63d0\u4f9b\u4e86\u901a\u8fc7\u4eea\u8868\u677f\u4e0a\u7684\u4ea4\u4e92\u5f0f\u548c\u53ef\u5b9a\u5236\u7684\u6570\u636e\u56fe\u8868\u6765\u63a2\u7d22\u68ee\u6797\u7edf\u8ba1\u6570\u636e\u7684\u80fd\u529b\u3002", "8233bddecadb79b1606c57b8871c23c3": "GFW \u4e0a\u7684\u641c\u7d22\u5de5\u5177\u63d0\u4f9b\u4e86\u4e00\u79cd\u5feb\u901f\u67e5\u627e\u5730\u56fe\u533a\u57df\u3001\u4f4d\u7f6e\u6216\u6570\u636e\u5c42\u7684\u7b80\u4fbf\u65b9\u6cd5\u3002", "af1b98adf7f686b84cd0b443e022b7a0": "\u7c7b\u522b", "9c70933aff6b2a6d08c687a6cbb6b765": "\u5168\u7403", "d1510b602b191147f593b51f7404c771": "\u68ee\u6797\u53d8\u5316", "19b4066b3662e42bd4f89180f787d461": "\u5728\u5730\u56fe\u4e0a\u641c\u7d22\u67d0\u4e2a\u533a\u57df", "32f70cd56c9bc1aa34ea487c46fcc3b7": "\u53ef\u81ea\u5b9a\u4e49\u5e95\u56fe\u53ef\u7528\u4e8e\u76d1\u6d4b\u533a\u57df\uff0c\u4f20\u8fbe\u53ef\u80fd\u53d1\u751f\u68ee\u6797\u780d\u4f10\u7684\u5730\u70b9\u4fe1\u606f\uff0c\u662f\u6700\u91cd\u8981\u7684 GFW \u5de5\u5177\u4e4b\u4e00\u3002", "9460370bb0ca1c98a779b1bcc6861c2c": "\u6c34", "31a08738ee5317da5f2a8b203d859755": "\u751f\u7269\u591a\u6837\u6027", "2bf8dc68e2801f4473d2ca50e3bf5f4d": "\u5a92\u4f53\u6d3d\u8be2\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3 {{0}}<a class=\"css-du67jw eto5vyh0\" href=\"{{1}}\">Kaitlyn.Thayer@wri.org</a>.,", "217e9094884cac75b14de16288f27f55": "\u539f\u751f\u6797\u635f\u5931", "51ccb0291cda31b4aa51684b1351aa16": "\u6811\u6728\u8986\u76d6\u5b9a\u4e49\u4e3a\u6307\u622a\u81f32000\u5e74\uff0c\u6240\u6709\u9ad8\u5ea6\u8d85\u8fc75\u7c73\u7684\u690d\u88ab\u3002\u6811\u6728\u8986\u76d6\u6570\u636e\u662f\u9a6c\u91cc\u5170\u5927\u5b66\u3001Google\u3001USGS\u548c NASA \u7684\u5408\u4f5c\u6210\u679c\uff0c\u4f7f\u7528\u4e86\u9646\u5730\u536b\u661f\u56fe\u50cf\uff0c\u7ed8\u5236\u4e862000\u5e74\u548c2010\u5e7430\u7c73\u5206\u8fa8\u7387\u7684\u5168\u7403\u6811\u6728\u8986\u76d6\u56fe\u3002\u8bf7\u6ce8\u610f\uff0c\u201c\u6811\u6728\u8986\u76d6\u201d\u662f\u6307\u6811\u6728\u7684\u751f\u7269\u7269\u7406\u5b58\u5728\uff0c\u53ef\u80fd\u4ee5\u5929\u7136\u6797\u6216\u4eba\u5de5\u6797\u7684\u5f62\u5f0f\u5b58\u5728\uff0c\u5177\u6709\u4e0d\u540c\u7684\u6797\u51a0\u5bc6\u5ea6\u3002", "eb81622e009a6ab1fd0366fcde604aa8": "\u4e3a\u91c7\u53d6\u884c\u52a8\u800c\u8bbe\u8ba1\u7684\u68ee\u6797\u76d1\u6d4b", "846fd3fb8a30095b09923ced0d626bbd": "\u5168\u7403\u68ee\u6797\u89c2\u6d4b\u63d0\u4f9b\u6700\u65b0\u7684\u6570\u636e\u3001\u6280\u672f\u548c\u5de5\u5177\uff0c\u5e2e\u52a9\u5404\u5730\u7684\u4eba\u4eec\u66f4\u597d\u5730\u4fdd\u62a4\u68ee\u6797\u3002", "d7f3c66c87d92222e37993f6656ca75a": "\u8ba2\u9605\u5168\u7403\u68ee\u6797\u89c2\u6d4b\u7684\u7535\u5b50\u671f\u520a", "a1232d66d2b789b2199ec76a3235cd36": "\u901a\u8fc7\u6570\u636e\u63a2\u7d22\u4e16\u754c\u4e0a\u7684\u68ee\u6797", "c0937c79e6691b4fd1c9d9da0d02e30a": "\u6d4f\u89c8 100 \u591a\u4e2a\u5168\u7403\u548c\u5730\u65b9\u7684\u6570\u636e\u96c6\u4ee5\u4e86\u89e3\u4fdd\u80b2\u3001\u571f\u5730\u4f7f\u7528\u3001\u68ee\u6797\u7fa4\u843d\u7b49\u4fe1\u606f\u3002", "50c0cbfe91d60013a88da61012b002ac": "\u7387\u5148\u4e86\u89e3\u65b0\u70ed\u5e26\u68ee\u6797\u6ee5\u4f10\u60c5\u51b5", "0d07eef8ffeb97621120e6404e2f3488": "\u67e5\u770b\u3001\u5206\u6790\u53ca\u8ba2\u9605\uff0c\u83b7\u53d6\u6bcf\u5468\u6ee5\u4f10\u8b66\u62a5(GLAD)\u3002\u8be5\u8b66\u62a5\u663e\u793a\u4e86\u70ed\u5e26\u5730\u533a\u54ea\u4e9b\u5730\u533a\u7684\u68ee\u6797\u6b63\u5728\u51cf\u5c11\u3002", "8ba7519f06b2aefa96d7d4d4ff263179": "\u67e5\u770b GLAD \u8b66\u62a5", "7e7732ae01c6a2323c53b2f5d76379d8": "\u67e5\u770b\u6211\u4eec\u7684\u6570\u636e", "cc66c98bee084dbf00fe5edad1f35938": "\u60a8\u80fd\u7528 Global Forest Watch\u505a\u4ec0\u4e48\uff1f", "87ca33753f39efd43b36ed785cb10549": "<span>\u201c</span>\u4e9a\u9a6c\u900a\u4fdd\u80b2\u534f\u4f1a (ACA) \u81f4\u529b\u4e8e\u4fdd\u62a4\u4e9a\u9a6c\u900a\u5730\u533a\u7684\u751f\u7269\u591a\u6837\u6027\u3002\u501f\u52a9\u5168\u7403\u68ee\u6797\u89c2\u6d4b\u4e0a\u7684 GLAD \u6ee5\u4f10\u9884\u8b66\uff0c\u6211\u4eec\u53ef\u4ee5\u6570\u5929\u65f6\u95f4\u5185\u4fa6\u6d4b\u5230\u4fdd\u62a4\u533a\u4e2d\u7684\u975e\u6cd5\u6398\u91d1\u548c\u4f10\u6728\u884c\u4e3a\u3002\u901a\u8fc7\u5c06\u53ca\u65f6\u51c6\u786e\u7684\u4fe1\u606f\u4ea4\u5230\u51b3\u7b56\u8005\u624b\u4e2d\uff0c\u6211\u4eec\u770b\u5230\u4e86\u5f53\u5730\u7684\u653f\u5e9c\u5f53\u5c40\u5728\u6536\u5230\u9884\u8b66\u540e\u7684 24-48 \u5c0f\u65f6\u5185\u91c7\u53d6\u884c\u52a8\u3002<span>\u201d</span>", "7e8cd3a6266ea13d27d01a422e038224": "\u5168\u7403\u548c\u5404\u56fd\u5feb\u901f\u7edf\u8ba1\u6570\u636e", "03417d4446e88cba80a3b65b4a5ff6bf": "\u53ea\u9700\u51e0\u6b21\u5355\u51fb\uff0c\u5373\u53ef\u5206\u6790\u4e16\u754c\u4e0a\u4efb\u4f55\u5730\u65b9\u7684\u68ee\u6797\u53d8\u5316\u4ee5\u53ca\u8c03\u67e5\u5404\u79cd\u8d8b\u52bf\u3002", "c5ee7a81a096a0ad17fb38c9ff4d899c": "\u68ee\u6797\u4fe1\u606f\u5206\u6790", "a1a118d708a4b46d29dc236517f3e150": "\u5728 GFW \u535a\u5ba2\u4e0a\u9605\u8bfb\u6211\u4eec\u7684\u7814\u7a76\u56e2\u961f\u5173\u4e8e\u68ee\u6797\u7684\u6700\u65b0\u62a5\u9053\u548c\u53d1\u73b0\u3002", "4b16519aaf495daf9c8ea320d325cc2b": "\u5de5\u5177\u5e93", "7735b0873f595f37faa0ecceb6de3274": "\u501f\u52a9\u6211\u4eec\u7684\u7279\u5236 Web \u5e94\u7528\u7a0b\u5e8f\uff0c\u627e\u51fa\u6ee5\u4f10\u4e0e\u6c14\u5019\u53d8\u5316\u3001\u706b\u707e\u548c\u96fe\u973e\u3001\u6c34\u5b89\u5168\u4ee5\u53ca\u5927\u5b97\u5546\u54c1\u4f9b\u5e94\u94fe\u4e4b\u95f4\u7684\u5173\u8054\u3002", "33d2be673e073f206ee242a5086e9ed6": "\u6d4f\u89c8\u6211\u4eec\u7684 APP", "c1c425268e68385d1ab5074c17a94f14": "\u529f\u80fd", "d60cee38b7622cfa8151f41d4b4cda02": "\u5f00\u59cb\u5b66\u4e60", "89184a3f3043e8cb3b0c7ea36291b46a": "\u63a2\u7d22\u6570\u636e\u9762\u677f", "36f7b856b345f533829a44ff98ec8a11": "\u6d4f\u89c8\u7533\u8bf7", "1844cab201bec7994ddb46952eb0b303": "\u4ece\u60a8\u7684\u79fb\u52a8\u8bbe\u5907\u79bb\u7ebf\u8bbf\u95ee GFW \u7684\u68ee\u6797\u76d1\u6d4b\u548c\u9884\u8b66\u7cfb\u7edf\uff0c\u5e76\u6536\u96c6\u8be5\u533a\u57df\u7684\u6570\u636e", "f3f996673a45076cb8689eb77c984f3b": "\u5b89\u5168\u5730\u7ba1\u7406\u5927\u5b97\u5546\u54c1\u4f9b\u5e94\u94fe\u4e2d\u7684\u6bc1\u6797\u98ce\u9669", "efdaf9f44ce968366fa78277263abc1d": "\u5e2e\u52a9\u4e2d\u5fc3", "c427264d9ab834a9e73424a5a5e371e7": "\u8bbf\