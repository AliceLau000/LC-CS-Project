c5--sprite\"></use></svg>\u62ef\u6551\u533a\u57df", "0088ab13b0fdc3a913d2397edd138ff1": "\u68ee\u6797\u780d\u4f10\u9884\u8b66\u7684\u5730\u70b9", "2c3521def9a6a7e6e09b78616910a7b6": "\u2014\u20143900 \u4e07\u7f8e\u5143", "8e58cee87d23e4d5561b4732750714ed": "\u5c55\u793a\u622a\u81f3 2011 \u5e74\u5728\u9009\u5b9a\u533a\u57df\u88ab\u6797\u4e1a\u90e8\u95e8\u96c7\u7528\u7684\u4eba\u6570\uff0c\u4ee5\u53ca\u6309\u6027\u522b\u7ec6\u5206\u7684\u60c5\u51b5\u3002\u6b64\u6570\u5b57\u4ee3\u8868\u6797\u4e1a\u90e8\u95e8\u62a5\u544a\u7684\u6b63\u5f0f\u5c31\u4e1a\u60c5\u51b5\uff0c\u5df2\u8f6c\u6362\u6210\u5168\u804c\u7b49\u6548\u5c31\u4e1a\uff08\u5404\u9886\u57df\u8861\u91cf\u5c31\u4e1a\u7684\u5e38\u7528\u5355\u4f4d\uff09\u3002\u6b64\u6570\u5b57\u4e0d\u5305\u62ec\u672a\u62a5\u544a\u975e\u6b63\u5f0f\u95f4\u63a5\u5c31\u4e1a\u3002\u6839\u636e FAO \u7684\u8bf4\u6cd5\uff0c\u8fd9\u4e2a\u6570\u5b57\u53ef\u80fd\u4f4e\u4f30\u3002", "cf6c9df68ded66fc2c9d509d76ae22cc": "\u571f\u58e4", "db0978efdbb15ccf8b4711424b272eaf": "\u6728\u7ea4\u7ef4/\u6728\u6750\u2014\u20147.28Mha", "cf5ea7953dc47105e0eb179dbefaaf46": "\u6309\u5e74", "439985f5423922c7c3131a026578f64d": "\u6b64\u5c0f\u90e8\u4ef6\u5c55\u793a\u519c\u4e1a\u5927\u5b97\u5546\u54c1\u5411\u4e16\u754c\u5404\u56fd\u5bb6/\u5730\u533a\u7684\u6d41\u52a8\u60c5\u51b5\u3002\u8fdb\u53e3\u56fd\u5bb6/\u5730\u533a\u6309\u8d38\u6613\u91cf\u6392\u540d\uff08\u53ef\u6309\u5428\u548c\u5360\u5df4\u897f\u51fa\u53e3\u603b\u91cf\u767e\u5206\u6bd4\u8861\u91cf\uff09\u3002\u53ef\u5728\u8bbe\u7f6e\u83dc\u5355\u4e2d\u8c03\u6574\u7126\u70b9\u5927\u5b97\u5546\u54c1\u4ee5\u53ca\u65f6\u95f4\u8303\u56f4\u3002\u6839\u636e\u56fd\u5bb6/\u5730\u533a\uff0c\u5927\u5b97\u5546\u54c1\u4f9b\u5e94\u94fe\u53ef\u80fd\u5305\u62ec\u725b\u8089\u3001\u7c97\u68d5\u6988\u3001\u9e21\u8089\u3001\u5496\u5561\u3001\u53ef\u53ef\u3001\u7389\u7c73\u3001\u68c9\u82b1\u3001\u68d5\u6988\u4ec1\u3001\u867e\u3001\u5927\u8c46\u3001\u7518\u8517\u4ee5\u53ca\u6728\u6d46\u5927\u5b97\u5546\u54c1\u3002\u6b64\u5916\uff0c\u5df4\u897f\u548c\u5df4\u62c9\u572d\u8fd8\u63d0\u4f9b\u5730\u65b9\u5927\u8c46\u6570\u636e\u3002", "6cba152cb0b1e5c9b1c73f4203219703": "\u6b64\u6570\u636e\u6765\u81ea Trase\u2014\u2014\u4e00\u9879\u57fa\u4e8e\u79d1\u5b66\u7684\u72ec\u7acb\u5f00\u653e\u8ba1\u5212\uff0c\u63d0\u4f9b\u6709\u5173\u5168\u7403\u8d38\u6613\u519c\u4e1a\u5927\u5b97\u5546\u54c1\u7684\u751f\u4ea7\u3001\u4ea4\u6613\u548c\u53ef\u6301\u7eed\u53d1\u5c55\u3002\u901a\u8fc7\u5173\u8054\u4e0d\u540c\u7684\u6570\u636e\u6765\u6e90\u6765\u53cd\u6620\u7ecf\u7531\u8d38\u6613\u516c\u53f8\u5230\u8fdb\u53e3\u56fd\u5bb6/\u5730\u533a\u7684\u5168\u56fd\u548c\u5730\u65b9\u751f\u4ea7\u7684\u5927\u5b97\u5546\u54c1\uff0c\u8fd9\u4e2a\u5728\u7ebf\u5e73\u53f0\u5c55\u793a\u5927\u5b97\u5546\u54c1\u51fa\u53e3\u4e0e\u751f\u4ea7\u5730\u7684\u68ee\u6797\u780d\u4f10\u98ce\u9669\u53ca\u5176\u4ed6\u73af\u5883\u4e0e\u793e\u4f1a\u6307\u6807\u7684\u5173\u8054\u60c5\u51b5\uff0c\u4ece\u800c\u8ba9\u516c\u53f8\u3001\u653f\u5e9c\u548c\u5176\u4ed6\u5404\u65b9\u80fd\u4e86\u89e3\u98ce\u9669\u4ee5\u53ca\u786e\u5b9a\u751f\u4ea7\u53ef\u6301\u7eed\u6027\u7684\u63d0\u5347\u673a\u4f1a\u3002", "e15997c74a71c5d9263df6f7a21bc191": "\u963f\u62c9\u65af\u52a0", "1dde1d5449b7d80e16005290d4dfa060": "\u6240\u6709\u6570\u636e", "ce27b70600e92402aed23e76f99aa894": "\u519c\u4e1a &gt; \u68ee\u6797", "9fdc981eed7138f01609b64fd4c4bba0": "\u4ece {startYear} \u5e74\u5230 {endYear} \u5e74\uff0c\u6700\u5927\u7684\u571f\u5730\u8986\u76d6\u53d8\u5316\u662f\u4ece {firstCategory} \u5230 {secondCategory} \u7684\u8f6c\u6362\u9762\u79ef\u53d8\u5316\uff0c\u76f8\u5f53\u4e8e {amount}\uff0c\u5360\u5168\u90e8\u571f\u5730\u8986\u76d6\u7684 {percentage}\u3002", "63357697da5b6764ad6e6b53c18b1ca0": "\u6c14\u5019\u76f8\u5173\u5de5\u5177", "2b3fd4eaaa8d7dcbcdd26875d430c313": "\u6c34\u8d44\u6e90\u76f8\u5173\u5de5\u5177", "06f31595dd7529753fb8fdcb6cc5bbb6": "\u6240\u6709\u571f\u5730\u8986\u76d6", "cbe572e39c06d5e79b30fe01abe9299e": "\u78b3\u901a\u91cf\uff08\u6309\u5e74\uff09", "ffe4a926934e73c8d0e5cc5c16fb5f5a": "2010 \u5e74\uff0c{location} \u6709 {extent} \u7684\u6811\u6728\u8986\u76d6\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684 {percentage} \u4ee5\u4e0a\uff0c\u76f8\u5f53\u4e8e {emissions} \u4e8c\u6c27\u5316\u78b3\u6392\u653e\u3002", "6ba86fcd84c96551b8f8024b8f5df56b": "\u4e0e\u5176\u4ed6\u533a\u57df\u7684\u68ee\u6797\u8986\u76d6\u6bd4\u8f83", "e0d05c1a1b2d6f1a256f0bc5d9a4ae89": "\u5c55\u793a\u6240\u9009\u533a\u57df\u4e2d\u9009\u5b9a\u68ee\u6797\u7c7b\u578b\u4e0e\u5176\u4ed6\u533a\u57df\u7684\u6bd4\u8f83\u60c5\u51b5\u3002", "a73bb6bb68d3b1a6d05ed1fef74a20f3": "<strong>\u539f\u59cb\u68ee\u6797</strong><br>\u6b64\u5206\u6790\u4ec5\u8003\u8651\u4e86\u622a\u81f3 2000 \u5e74\u4e0e\u6811\u6728\u8986\u76d6\u6709\u91cd\u53e0\u7684\u539f\u59cb\u68ee\u6797\u533a\u57df\u3002\u6b64\u6570\u636e\u96c6\u53cd\u6620\u4e86 2001 \u5e74\u5168\u7403\u6cdb\u70ed\u5e26\u5730\u533a\u7684\u539f\u59cb\u68ee\u6797\u8303\u56f4\u3002", "60216d1911fa5d6ef6084e44b78ae3c9": "\u672a\u77e5\u79cd\u690d\u56ed", "aaeee5f40f1185b436a4bf6d2413717c": "\u6839\u636e\u9009\u5b9a\u533a\u57df\u5185\u6811\u6728\u79cd\u690d\u56ed\u7684\u8303\u56f4\u8fdb\u884c\u533a\u57df\u6392\u540d\uff0c\u5e76\u6309\u7269\u79cd\u6216\u7c7b\u578b\u663e\u793a\u8303\u56f4\u3002", "b69e29c3cd96167c1562d52bff30fab7": "\u6811\u6728\u8986\u76d6\u51cf\u5c11\u662f\u6307\u5927\u4e8e 5 \u7c73\u7684\u690d\u88ab\u6797\u5206\u6c34\u5e73\u66ff\u4ee3\u3002\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6570\u636e\u96c6\u662f\u9a6c\u91cc\u5170\u5927\u5b66\u3001Google\u3001USGS \u548c NASA \u7684\u5408\u4f5c\u7ed3\u679c\uff0c\u91c7\u7528 Landsat \u536b\u661f\u56fe\u50cf\u4ee5 30 \u00d7 30 \u7c73\u5206\u8fa8\u7387\u53cd\u6620\u6bcf\u5e74\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u60c5\u51b5\u3002\u8bf7\u6ce8\u610f\uff0c\u201c\u6811\u6728\u8986\u76d6\u51cf\u5c11\u201d\u4e0d\u540c\u4e8e\u201c\u68ee\u6797\u780d\u4f10\u201d\u2014\u2014\u6811\u6728\u8986\u76d6\u51cf\u5c11\u5305\u62ec\u5929\u7136\u6797\u548c\u79cd\u690d\u6797\u7684\u53d8\u5316\uff0c\u4e0d\u9700\u8981\u4eba\u4e3a\u5bfc\u81f4\u30022011 \u5e74\u4ee5\u6765\u7684\u6570\u636e\u662f\u91c7\u7528\u66f4\u65b0\u540e\u7684\u65b9\u6cd5\u4ea7\u751f\u7684\uff0c\u83b7\u53d6\u7684\u51cf\u5c11\u91cf\u53ef\u80fd\u4f1a\u589e\u52a0\u3002\u5728\u6bd4\u8f83 2001 \u5e74\u81f3 2010 \u5e74\u7684\u539f\u59cb\u6570\u636e\u4e0e\u672a\u6765\u5e74\u4efd\u7684\u6570\u636e\u65f6\uff0c\u5e94\u5f53\u8c28\u614e\u4ece\u4e8b\u3002", "9666d5f55bb172d115818218d4a08313": "\u6811\u6728\u79cd\u690d\u56ed\u6765\u81ea\u79cd\u690d\u6811\u6728\u7a7a\u95f4\u6570\u636e\u5e93 (SDPT)\u3002 SDPT \u5305\u542b 1.73 \u4ebf\u516c\u9877\u79cd\u690d\u6797\u548c 5000 \u4e07\u516c\u9877\u519c\u4e1a\u6811\u6728\uff0c\u5728 2015 \u5e74\u7ea6\u5360\u5168\u7403\u79cd\u690d\u6797\u9762\u79ef\u7684 82%\uff08FAO 2015 \u5e74\uff09\u3002\u7f16\u7e82 SDPT \u7684\u6b65\u9aa4\u5305\u62ec\u5728\u521b\u5efa\u534f\u8c03\u5c5e\u6027\u8868\u4e4b\u524d\u6e05\u7406\u548c\u5904\u7406\u6bcf\u4e2a\u5355\u72ec\u7684\u6570\u636e\u96c6\u3002", "e34a3a6ff98267d9199dfd6996b127ff": "GLAD \u68ee\u6797\u780d\u4f10\u9884\u8b66\u51fa\u81ea\u9a6c\u91cc\u5170\u5927\u5b66\u7684 GLAD \u5b9e\u9a8c\u5ba4\uff0c\u91c7\u7528 Landsat \u56fe\u50cf\u4ee5 30 \u7c73\u7684\u5206\u8fa8\u7387\u6309\u5468\u63a2\u6d4b\u6700\u8fd1\u7684\u68ee\u6797\u5931\u8c03\u60c5\u51b5\u3002GLAD \u9884\u8b66\u5f53\u524d\u53ef\u7528\u4e8e\u70ed\u5e26\u5730\u533a\uff0c\u5373\u5317\u7eac 30 \u5ea6\u548c\u5357\u7eac 30 \u5ea6\u4e4b\u95f4\u7684\u5730\u533a\u3002", "53baab74ead88c148f84a309c964bf43": "\u68ee\u6797\u7684\u7ecf\u6d4e\u5f71\u54cd", "6bc8cb77b306a2e4f6b396fb4afe9852": "\u5c55\u793a\u57fa\u51c6\u5e74\u7684\u516c\u5171\u5f00\u652f\u91d1\u989d\u548c\u6765\u81ea\u68ee\u6797\u7684\u6536\u5165\uff0c\u4ee5\u53ca\u6240\u6709\u56fd\u5bb6/\u5730\u533a\u95f4\u7684\u6392\u540d\u3002", "24c5d9b6f663d2003a122e93a100686b": "\u68ee\u6797 &gt; \u8349\u5730", "6c98d8c792205878aa6a2154a88eebab": "\u5982\u9700\u5a92\u4f53\u67e5\u8be2\uff0c\u8bf7\u5c06\u7535\u5b50\u90ae\u4ef6\u53d1\u9001\u81f3 <a href=\"{{0}}\">Kaitlyn.Thayer@wri.org</a>", "2a74d25443728a866f90118b71b7dbd9": "2019 - \u5c3c\u52a0\u62c9\u74dc", "601eb927815a465ed508dd27f2c9aad0": "\u539f\u751f\u6797", "c03077f9a8c706222cb1bd4414204686": "\u68ee\u6797\u8986\u76d6\u51cf\u5c11", "079a32829a31dddc24e85d8fcb4e9bcb": "\u6bcf\u65e5\uff0c10 m\uff0c\u70ed\u5e26\u5730\u533a\uff0cUMD/GLAD \u548c WUR", "0e8e3e3627e10523fc5685ddbfafa830": "- \u9605\u8bfb 2023 \u5e74\u7248\u7684<a class=\"text -paragraph -color-4 -bold\" href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u300a\u7533\u8bf7\u4eba\u6307\u5357\u300b</a>", "2dbc178888177db915a00eb57f7d7513": "\u5c06\u5728 2022 \u5e74 6 \u6708 1 \u65e5- 8 \u6708 1 \u65e5\u671f\u95f4\u63a5\u53d7\u7533\u8bf7\u3002<a class=\"text -paragraph -color-4 -bold\" href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">6 \u6708 1 \u65e5\u8d77\uff0c\u60a8\u53ef\u4ee5\u5728\u6b64\u7533\u8bf7\u3002</a>", "6af2f08b108d374528f6bfdacdabdb41": "\u6709\u5173 2023 \u5e74\u8d44\u52a9\u91d1\u5468\u671f\u7684\u4fe1\u606f\uff0c\u8bf7\u70b9\u51fb\u4e0b\u65b9\u94fe\u63a5\u3002", "320bc4c86c2e99a8754500a227a712b4": "Global Forest Watch \u5c0f\u989d\u8d44\u52a9\u91d1\u57fa\u91d1\u4f1a\u610f\u5728\u5efa\u8bbe\u6c11\u95f4\u793e\u56e2\u7ec4\u7ec7\u7684\u80fd\u529b\uff0c\u4f7f\u5176\u80fd\u6709\u6548\u4f7f\u7528 GFW \u5de5\u5177\u548c\u6570\u636e\uff0c\u51cf\u5c11\u975e\u6cd5\u6216\u8ba1\u5212\u5916\u7684\u6ee5\u4f10\u3002\u6210\u529f\u7684\u9879\u76ee\u80fd\u5c06\u6570\u636e\u8f6c\u5316\u4e3a\u884c\u52a8\uff0c\u8fd0\u7528 GFW \u514b\u670d\u5728\u5168\u7403\u68ee\u6797\u4fdd\u62a4\u5de5\u4f5c\u4e2d\u9047\u5230\u7684\u6311\u6218\u3002", "575430a60eaeb62aeb5dca13d87f37a1": "\u2014\u2014\u62a5\u540d&nbsp;<a class=\"text -paragraph -color-4 -bold\" href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">2023 \u5e74\u5ea6\u5c0f\u989d\u8d44\u52a9\u91d1\u57fa\u91d1\u4f1a\u7533\u8bf7\u4eba\u7f51\u7edc\u7814\u8ba8\u4f1a\uff08\u7f8e\u56fd\u4e1c\u90e8\u65f6\u95f4 6 \u6708 16 \u65e5\u4e0a\u5348 9:00\uff09</a>", "2caaa841558ba2c41db9d50719042362": "\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u6392\u653e", "9a08c0a1c50fc24b84e36d4f4ed84701": "\u68ee\u6797\u78b3\u6e05\u9664", "cd478076d2c4dfac0f68f55dcca738bc": "\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u51c0\u901a\u91cf", "4ed9ec851955854733a1e1ae42a2355d": "\u663e\u793a\u68d5\u6988\u6cb9\u5382\u7684\u4f4d\u7f6e\u3002", "a9dbcc79de4333ae553783d094cf656c": "2017\u5e7412\u6708", "e68fc54229540020ef82bbfc1014929a": "2011-2021 \u5e74\u6570\u636e\u4f7f\u7528<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u66f4\u65b0\u7684\u65b9\u6cd5</a>\u751f\u6210\u3002\u5728\u5bf9\u6bd4\u539f\u6765\u7684 2001-2010 \u5e74\u6570\u636e\u548c 2011-2021 \u5e74\u66f4\u65b0\u540e\u7684\u6570\u636e\u7684\u65f6\u5019\u5e94\u8be5\u683c\u5916\u5c0f\u5fc3\u3002", "4790a65e26df46f49642c054c2ce1a73": "\u6b64\u6570\u636e\u96c6\u5f97\u76ca\u4e8e\u4f4d\u4e8e\u9a6c\u91cc\u5170\u5927\u5b66\u3001Google\u3001USGS \u548c NASA \u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">GLAD</a>\uff08\u5168\u7403\u571f\u5730\u5206\u6790 &amp; \u63a2\u7d22) \u5b9e\u9a8c\u5ba4\u4e4b\u95f4\u7684\u5408\u4f5c\uff0c\u4ee5\u7ea6 30 \u00d7 30 \u7c73\u5206\u8fa8\u7387\u6d4b\u91cf\u5168\u7403\u571f\u5730\uff08\u9664\u4e86\u5357\u6781\u6d32\u548c\u5176\u4ed6\u5317\u6781\u5c9b\u5c7f\uff09\u7684\u6811\u6728\u8986\u76d6\u6d41\u5931\u9762\u79ef\u3002\u6570\u636e\u5229\u7528\u591a\u8c31\u536b\u661f\u56fe\u50cf\u751f\u6210\uff0c\u591a\u8c31\u536b\u661f\u56fe\u50cf\u6765\u81ea\u9646\u5730\u536b\u661f 5 \u53f7\u4e13\u9898\u5236\u56fe\u4eea (TM)\uff0c\u9646\u5730\u536b\u661f 7 \u53f7\u589e\u5f3a\u578b\u4e13\u9898\u5236\u56fe\u4eea (ETM+)\uff0c\u4ee5\u53ca\u9646\u5730\u536b\u661f 8 \u53f7\u9646\u5730\u6210\u50cf\u4eea (OLI) \u4f20\u611f\u5668\u3002\u8d85\u8fc7 100 \u4e07\u5f20\u536b\u661f\u56fe\u50cf\u88ab\u5904\u7406\u548c\u5206\u6790\uff0c\u5305\u62ec 2000-2012 \u5e74\u671f\u95f4 60 \u591a\u4e07\u5f20\u9646\u5730\u536b\u661f 7 \u53f7\u7684\u56fe\u50cf\uff0c40 \u591a\u4e07\u5f20 2011-2021 \u5e74\u671f\u95f4\u66f4\u65b0\u7684\u9646\u5730\u536b\u661f 5\u30017\u30018 \u53f7\u7684\u56fe\u50cf\u3002\u96c6\u5408\u536b\u661f\u56fe\u50cf\u4e2d\u6e05\u6670\u7684\u5730\u8868\u89c2\u6d4b\u6570\u636e\uff0c\u5e94\u7528\u76d1\u7763\u5b66\u4e60\u7b97\u6cd5\u8bc6\u522b\u6bcf\u50cf\u7d20\u6811\u6728\u8986\u76d6\u635f\u5931\u3002", "43f80a63b2dbac5d4cad2cf57bc5838f": "\u68ee\u6797\u78b3\u6e05\u9664 - 2001-2021", "08e46ade81e5e9920662504aadc747ee": "\u8be5\u6570\u636e\u96c6\u81ea\u521b\u5efa\u4ee5\u6765\u5df2\u7ecf\u66f4\u65b0\u4e86\u4e94\u6b21\uff0c\u73b0\u5728\u5305\u62ec\u4e86\u5230 2021 \u5e74\u7684\u635f\u5931\uff081.9 \u7248\u672c\uff09\u3002\u5206\u6790\u65b9\u6cd5\u5df2\u5728\u8bb8\u591a\u65b9\u9762\u8fdb\u884c\u4e86\u4fee\u6539\uff0c\u5305\u62ec\u76ee\u6807\u5e74\u4efd\u7684\u65b0\u6570\u636e\uff0c\u5bf9\u4e4b\u524d\u5e74\u4efd\u7684\u6570\u636e\u8fdb\u884c\u4e86\u91cd\u65b0\u5904\u7406\u5206\u6790\u65b9\u6cd5\u8fdb\u884c\u4e86\u591a\u65b9\u9762\u7684\u4fee\u6539\uff0c\u5305\u62ec\u76ee\u6807\u5e74\u4efd\u7684\u65b0\u6570\u636e\u3001\u524d\u51e0\u5e74\u7684\u91cd\u65b0\u5904\u7406\u6570\u636e\uff081.1 \u7248\u672c\u66f4\u65b0\u4e3a 2011 \u5e74\u548c 2012 \u5e74\uff0c1.2 \u7248\u672c\u66f4\u65b0\u4e3a 2012 \u5e74\u548c 2013 \u5e74\uff0c1.3 \u7248\u672c\u66f4\u65b0\u4e3a 2014 \u5e74\uff09\u4ee5\u53ca\u6539\u8fdb\u7684\u5efa\u6a21\u548c\u6821\u51c6\u3002\u8fd9\u4e9b\u4fee\u6539\u6539\u8fdb\u4e86 2011-2021 \u5e74\u7684\u53d8\u5316\u68c0\u6d4b\uff0c\u5305\u62ec\u66f4\u597d\u5730\u68c0\u6d4b\u706b\u707e\u9020\u6210\u7684\u5317\u65b9\u635f\u5931\u3001\u70ed\u5e26\u68ee\u6797\u4e2d\u7684\u5c0f\u519c\u8f6e\u4f5c\u519c\u4e1a\u3001\u9009\u62e9\u6027\u91c7\u4f10\u548c\u77ed\u5468\u671f\u4eba\u5de5\u6797\u3002\u6700\u7ec8\uff0c\u672a\u6765\u7684\u201c2.0 \u7248\u201d\u5c06\u5305\u62ec\u5bf9 2000-2010 \u5e74\u6570\u636e\u7684\u518d\u5904\u7406\uff0c\u4f46\u4e0e\u6b64\u540c\u65f6\uff0c\u5bf9\u539f\u59cb\u6570\u636e\u548c 1.7 \u7248\u672c\u7684\u96c6\u6210\u4f7f\u7528\u5e94\u8c28\u614e\u64cd\u4f5c\u3002\u53ef\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u8be6\u7ec6\u4e86\u89e3 1.7 \u7248\u672c\u66f4\u65b0\u3002", "0a84db5d24fc2a6821f61a8ef1c366ff": "\u5438\u6536\u91cf\u6570\u636e\u5b58\u5728\u65f6\u95f4\u4e0a\u7684\u4e0d\u4e00\u81f4\u6027\uff0c\u56e0\u4e3a\u6811\u6728\u8986\u76d6\u589e\u76ca\u4ee3\u8868 2000-2012 \u5e74\u7684\u7d2f\u8ba1\u603b\u6570\uff0c\u800c\u4e0d\u662f\u81f3 2021 \u5e74\u4f30\u8ba1\u7684\u5e74\u5ea6\u589e\u76ca\u3002", "b0e4090e2c13b55fef59995042d610c4": "\u78b3\u5438\u6536\u91cf\u53cd\u6620\u4e86 2001-2021 \u5e74\u6a21\u578b\u671f\u95f4\u7684\u603b\u5438\u6536\u91cf\uff0c\u800c\u4e0d\u662f\u53cd\u5e94\u8d8b\u52bf\u7684\u3001\u6309\u65f6\u95f4\u6392\u5217\u7684\u5e74\u5ea6\u503c\u3002 \u56e0\u6b64\uff0c\u6b64\u503c\u5fc5\u987b\u9664\u4ee5 21 \u624d\u80fd\u8ba1\u7b97\u5e73\u5747\u5e74\u5438\u6536\u91cf\u3002", "deeeaf402e72c983ab266b268c27a09e": "\u51c0\u901a\u91cf\u53cd\u6620\u4e86 2001-2021 \u5e74\u6a21\u578b\u5206\u6790\u671f\u95f4\u7684\u603b\u91cf\uff0c\u800c\u4e0d\u662f\u53cd\u5e94\u8d8b\u52bf\u7684\u3001\u6309\u65f6\u95f4\u6392\u5217\u7684\u5e74\u5ea6\u503c\u3002\u56e0\u6b64\uff0c\u6b64\u503c\u5fc5\u987b\u9664\u4ee5 21 \u624d\u80fd\u5f97\u51fa\u5e73\u5747\u5e74\u51c0\u901a\u91cf\u3002", "e379723af5c72d543e6287f5224b9038": "\u663e\u793a 2001 \u5e74\u81f3 2021 \u5e74\u95f4\u68ee\u6797\u4e0e\u5927\u6c14\u4e4b\u95f4\u7684\u78b3\u51c0\u4ea4\u6362\uff0c\u8ba1\u7b97\u503c\u4e3a\u7fa4\u4e1b\u66ff\u4ee3\u5e72\u6270\u4ea7\u751f\u7684\u68ee\u6797\u78b3\u6392\u653e\u91cf\u4e0e\u68ee\u6797\u751f\u957f\u4ea7\u751f\u7684\u78b3\u5438\u6536\u91cf\u4e4b\u95f4\u7684\u5dee\u503c", "0e183d1a62a6e374a84155cb26700129": "\u51c0\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf - 2001-2021", "18c5512f078a801a3f1c1829f6d2e1f6": "\u65b0\u5174\u7684\u70ed\u70b9\u5730\u533a- 2002-2021", "55289091a38d441863c5e921272ede0d": "\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u91cf - 2001-2021", "44fdb6d0070943522ae54ed5ec83c7ad": "\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11", "ad8fb5561357d2cb06a16e2c9cfc924d": "\u786e\u5b9a\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u533a\u57df\uff08\u4e0e\u6240\u6709\u5176\u4ed6\u6811\u6728\u8986\u76d6\u51cf\u5c11\u4fc3\u6210\u56e0\u7d20\u6bd4\u8f83\uff09", "2cf5734cc3949c9d202f35c258550d1e": "\uff08\u6bcf\u5e74\uff0c30m\uff0c\u5168\u7403\uff0cUMD/GLAD\uff09", "39a9926155e136d4188c2f279d8b9de7": "\u6bcf\u5e74\uff0c30m\uff0c\u5168\u7403\uff0cUMD/GLAD", "8b36e3867b681fbe6d4ec133cb9a4208": "\u6811\u6728\u8986\u76d6\u662f\u6307\u9ad8\u5ea6\u8d85\u8fc7 5 \u7c73\u7684\u6240\u6709\u690d\u88ab\uff0c\u5176\u5f62\u5f0f\u53ef\u4ee5\u662f\u6811\u51a0\u5bc6\u5ea6\u5728\u67d0\u4e2a\u8303\u56f4\u7684\u5929\u7136\u6797\u6216\u4eba\u5de5\u6797\u3002\u6811\u6728\u8986\u76d6\u51cf\u5c11\u662f\u6307\u4efb\u4f55\u5730\u76ae\u66ff\u4ee3\u5e72\u6270\uff08\u5373\uff0c\u5728 30 m \u50cf\u7d20\u5c3a\u5ea6\u4e0b\u6811\u6728\u8986\u76d6\u6811\u51a0\u5b8c\u5168\u6d88\u5931\uff09\uff0c\u53ef\u80fd\u4e0d\u4e00\u5b9a\u7b49\u540c\u4e8e\u68ee\u6797\u780d\u4f10\u3002", "3728a0a9882ab9a621f24cbb3a1403d9": "\u6b64\u6570\u636e\u4e0e GFW \u4e0a\u5168\u7403\u6811\u6728\u8986\u76d6\u51cf\u5c11\u5730\u56fe\u4e00\u81f4\uff0c\u4ec5\u53cd\u6620 2001 \u5e74\u81f3 2020 \u5e74\u95f4\u6bcf\u4e2a\u50cf\u7d20\u7684\u9996\u6b21\u5730\u76ae\u66ff\u4ee3\u68ee\u6797\u5e72\u6270\u3002\u5728\u6b64\u6570\u636e\u4e2d\uff0c\u672a\u63a2\u6d4b\u5728\u7814\u7a76\u671f\u65e9\u671f\u6700\u521d\u5e72\u6270\u540e\u68ee\u6797\u518d\u751f\u65f6\u53d1\u751f\u7684\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u533a\u57df\u3002", "cc7c2b91c58aeb098ae63a9e2f891449": "\u5bf9\u4e8e\u7528\u4f5c\u6b64\u6570\u636e\u96c6\u7684\u8f93\u5165\u7684 GFW \u4e0a\u7684\u57fa\u672c\u6811\u6728\u8986\u76d6\u51cf\u5c11\u5730\u56fe\uff0c\u5176\u5206\u6790\u65b9\u6cd5\u5df2\u901a\u8fc7\u591a\u79cd\u65b9\u5f0f\u8fdb\u884c\u4fee\u6539\uff0c\u76ee\u7684\u662f\u6539\u8fdb\u5bf9\u706b\u707e\u3001\u70ed\u5e26\u68ee\u6797\u7684\u5c0f\u5bb6\u8f6e\u4f5c\u519c\u4e1a\u3001\u9009\u62e9\u6027\u4f10\u6728\u4ee5\u53ca\u77ed\u5468\u671f\u4eba\u5de5\u6797\u5bfc\u81f4\u7684\u5317\u65b9\u68ee\u6797\u51cf\u5c11\u7684\u63a2\u6d4b\uff0c\u6570\u636e\u6db5\u76d6 2011 \u5e74\u81f3 2020 \u5e74\u8fd9\u6bb5\u65f6\u95f4\u3002\u7531\u4e8e\u5b58\u5728\u8fd9\u4e9b\u53d8\u5316\uff0c\u5728\u6bd4\u8f83 2000 \u5e74\u81f3 2010 \u4e0e 2011 \u5e74\u81f3 2020 \u5e74\u8fd9\u4e24\u4e2a\u65f6\u95f4\u6bb5\u7684\u8d8b\u52bf\u65f6\uff0c\u5e94\u5f53\u614e\u91cd\u3002\u60a8\u53ef\u4ee5<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5728\u6b64\u5904</a>\u8fdb\u4e00\u6b65\u4e86\u89e3\u5efa\u6a21\u8fc7\u7a0b\u7684\u65b0\u60c5\u51b5\u3002", "80352d0d4442f7420c1e94ad8013dad3": "\u6240\u663e\u793a\u6570\u636e\u7684\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u968f\u9009\u62e9\u5185\u5bb9\u800c\u6709\u5f02\u2014\u2014\u8bf7\u5229\u7528\u5730\u56fe\u4e0a\u7684\u56fe\u4f8b\u6765\u6539\u53d8\u6700\u5c0f\u6811\u6728\u8986\u76d6\u6811\u51a0\u5bc6\u5ea6\u9608\u503c\u3002", "bf90125381ddd0aa36e78136a85551bf": "\u5728\u7f29\u5c0f\uff08\u5c0f\u4e8e 13 \u7ea7\u7f29\u653e\uff09\u65f6\uff0c\u51cf\u5c11\u7684\u50cf\u7d20\u5e26\u9634\u5f71\uff08\u6839\u636e 30 \u7c73 \u00d7 30 \u7c73\u5c3a\u5ea6\u7684\u51cf\u5c11\u5bc6\u5ea6\u786e\u5b9a\uff09\u3002\u9634\u5f71\u989c\u8272\u8f83\u6df1\u7684\u50cf\u7d20\u4ee3\u8868\u6811\u6728\u8986\u76d6\u51cf\u5c11\u96c6\u4e2d\u5ea6\u8f83\u9ad8\u7684\u533a\u57df\uff0c\u800c\u9634\u5f71\u989c\u8272\u8f83\u6d45\u7684\u50cf\u7d20\u8868\u793a\u6811\u6728\u8986\u76d6\u51cf\u5c11\u96c6\u4e2d\u5ea6\u8f83\u4f4e\u3002\u5f53\u6570\u636e\u5904\u4e8e\u5b8c\u5168\u5206\u8fa8\u7387\u65f6\uff08\u7b49\u4e8e\u6216\u5927\u4e8e 13 \u7ea7\u7f29\u653e\uff09\uff0c\u50cf\u7d20\u9634\u5f71\u6ca1\u6709\u5dee\u5f02\u3002", "3683f20f1ea0a1effb532a56ef8d44a5": "\u7531\u4e8e\u5168\u7403\u68ee\u6797\u76d1\u6d4b\u6570\u636e\u6765\u6e90\u7684\u89c4\u6a21\u548c\u590d\u6742\u6027\u63d0\u5347\uff0c\u6b64\u6570\u636e\u7684\u5206\u6790\u4e0e\u89e3\u91ca\u5de5\u5177\u5bf9\u5e72\u9884\u6548\u679c\u7684\u91cd\u8981\u6027\u4e5f\u589e\u52a0\u4e86\uff0c\u56e0\u4e3a\u9700\u8981\u80fd\u5feb\u901f\u786e\u5b9a\u548c\u89e3\u91ca\u663e\u8457\u7684\u68ee\u6797\u51cf\u5c11\u60c5\u51b5\u3002\u65b0\u5174\u70ed\u70b9\u6570\u636e\u96c6\u53ef\u5728\u56fd\u5bb6\u5c42\u9762\u786e\u5b9a\u70ed\u5e26\u8303\u56f4\u5728 2002 \u5e74\u81f3 2021 \u5e74\u539f\u59cb\u68ee\u6797\u51cf\u5c11\u7684\u6700\u663e\u8457\u7684\u7fa4\u96c6\u3002\u201c\u70ed\u70b9\u201d\u4e00\u8bcd\u662f\u6307\u4ece\u7edf\u8ba1\u4e0a\u770b\uff0c\u5728\u51cf\u5c11\u7684\u7a7a\u95f4\u6a21\u5f0f\u4e0a\u5c55\u73b0\u51fa\u663e\u8457\u7684\u805a\u96c6\u6027\u7684\u533a\u57df\u3002\u5728\u6b64\u5206\u6790\u4e2d\uff0c\u89c2\u5bdf\u5230\u7684\u539f\u59cb\u68ee\u6797\u51cf\u5c11\u6a21\u5f0f\u4e5f\u8bb8\u53ef\u5f52\u56e0\u4e8e\u6839\u672c\u7684\uff08\u800c\u4e0d\u662f\u968f\u673a\u7684\uff09\u7a7a\u95f4\u8fc7\u7a0b\u3002\u5404\u79cd\u4e0d\u540c\u70ed\u70b9\u7c7b\u522b\u5982\u4e0b\u6240\u8ff0\uff1a<br>\u2014\u2014<strong>\u65b0\u589e</strong>\uff1a\u4ece\u7edf\u8ba1\u4e0a\u770b\uff0c\u4ec5\u5728 2021 \u5e74\u662f\u663e\u8457\u70ed\u70b9\u7684\u5730\u65b9\uff0c\u4e4b\u524d\u4ece\u672a\u6210\u4e3a\u70ed\u70b9\u3002<br>\u2014\u2014<strong>\u6563\u53d1</strong>\uff1a\u518d\u6b21\u51fa\u73b0\u540e\u53c8\u518d\u6b21\u6d88\u5931\u7684\u70ed\u70b9\u5730\u65b9\u3002\u4ece\u7edf\u8ba1\u4e0a\u770b\uff0c19 \u5e74\u4e2d\u6210\u4e3a\u663e\u8457\u70ed\u70b9\u7684\u5e74\u6570\u4e0d\u8db3 18 \u5e74\u3002<br>\u2014\u2014<strong>\u52a0\u5267</strong>\uff1a\u4ece\u7edf\u8ba1\u4e0a\u770b\uff0c19 \u5e74\u4e2d\u6210\u4e3a\u663e\u8457\u70ed\u70b9\u7684\u5e74\u6570\u8d85\u8fc7 17 \u5e74\uff08\u5927\u4e8e 90%\uff09\u7684\u5730\u65b9\uff0c\u5176\u4e2d\u5305\u62ec\u6700\u8fd1\u7684\u5e74\u4efd\uff082021 \u5e74\uff09\u3002\u6b64\u5916\uff0c\u6bcf\u5e74\u5927\u6570\u91cf\u805a\u96c6\u7684\u5f3a\u5ea6\u4e5f\u5728\u63d0\u5347\u3002<br>\u2014\u2014<strong>\u6301\u7eed</strong>\uff1a\u4ece\u7edf\u8ba1\u4e0a\u770b\uff0c19 \u5e74\u4e2d\u6210\u4e3a\u663e\u8457\u70ed\u70b9\u7684\u5e74\u6570\u8d85\u8fc7 17 \u5e74\uff08\u5927\u4e8e 90%\uff09\u7684\u5730\u65b9\uff0c\u5e76\u4e14\u6ca1\u6709\u660e\u663e\u7684\u8d8b\u52bf\u8868\u660e\u805a\u96c6\u5f3a\u5ea6\u968f\u65f6\u95f4\u5347\u964d\u3002<br>\u2014\u2014<strong>\u51cf\u7f13</strong>\uff1a\u4ece\u7edf\u8ba1\u4e0a\u770b\uff0c19 \u5e74\u4e2d\u6210\u4e3a\u663e\u8457\u70ed\u70b9\u7684\u5e74\u6570\u8d85\u8fc7 17 \u5e74\uff08\u5927\u4e8e 90%\uff09\u7684\u5730\u65b9\u3002\u6b64\u5916\uff0c\u6bcf\u5e74\u7684\u5927\u6570\u91cf\u805a\u96c6\u5f3a\u5ea6\u4e5f\u5728\u4e0b\u964d\uff0c\u6216\u8005\u6700\u8fd1\u4e00\u5e74\uff082021 \u5e74\uff09\u4e0d\u662f\u70ed\u70b9\u3002<br>\u65b0\u5174\u70ed\u70b9\u5206\u6790\u91c7\u7528 2002 \u5e74\u81f3 2021 \u5e74\u95f4 Hansen et al 2013 \u7684\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6570\u636e\u96c6\u30012001 \u5e74\u7684 Turubanova et al. 2018 \u539f\u59cb\u68ee\u6797\u8303\u56f4\u6570\u636e\u96c6\u4ee5\u53ca ESRI ArcGIS Emerging Hot Spot Analysis \u5730\u7406\u6570\u636e\u5904\u7406\u5de5\u5177\u3002\u5728\u6b64\u5206\u6790\u4e2d\uff0c\u539f\u59cb\u68ee\u6797\u662f\u6307\u5728\u6700\u8fd1\u7684\u5386\u53f2\u4e2d\u672a\u66fe\u5b8c\u5168\u6e05\u9664\u5e76\u518d\u751f\u7684\u6210\u719f\u5929\u7136\u6f6e\u6e7f\u70ed\u5e26\u68ee\u6797\u8986\u76d6\u3002\u68ee\u6797\u51cf\u5c11\u662f\u6307\u201c\u5730\u76ae\u66ff\u4ee3\u5e72\u6270\u201d\u6216\u8005 Landsat \u50cf\u7d20\u5c3a\u5ea6\u4e0a\u7684\u6811\u6728\u8986\u76d6\u6842\u51a0\u5b8c\u5168\u6d88\u5931\u3002\u65b0\u5174\u70ed\u70b9\u5206\u6790\u5de5\u5177\u7ed3\u5408\u4f7f\u7528\u4e24\u79cd\u7edf\u8ba1\u624b\u6bb5\uff0cGetis-Ord Gi* \u7edf\u8ba1\u7528\u4e8e\u786e\u5b9a\u68ee\u6797\u51cf\u5c11\u7684\u5730\u70b9\u4ee5\u53ca\u7a7a\u95f4\u805a\u96c6\u7a0b\u5ea6\uff0cMann-Kendall \u8d8b\u52bf\u6d4b\u8bd5\u7528\u4e8e\u8bc4\u4f30\u968f\u65f6\u95f4\u53d8\u5316\u7684\u65f6\u95f4\u8d8b\u52bf\u3002", "b6204c4f3408a1ac57d077f51533dbae": "2011 \u5e74\u81f3 2015 \u5e74\u95f4\u56e0\u91c7\u7528\u65b0\u7684\u536b\u661f\u6570\u636e\u548c\u65b9\u6cd5\u53d8\u5316\u800c\u5b9e\u73b0\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u63a2\u6d4b\u6539\u8fdb\u53ef\u80fd\u5bfc\u81f4\u8fd1\u5e74\u6bd4\u65e9\u5e74\u7684\u8bc4\u4f30\u503c\u9ad8\u3002", "562c21ab8e09b31d383e95dca5135d74": "\u68ee\u6797\u78b3\u6392\u653e\u4ee3\u8868\u5728\u6bcf\u4e2a\u5efa\u6a21\u5e74\u4efd\uff08megagrams CO2e ha-1\uff0c2001 \u5e74\u81f3 2021 \u5e74\uff09\u5730\u76ae\u66ff\u4ee3\u68ee\u6797\u5e72\u6270\u5f15\u8d77\u7684\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u3002\u6392\u653e\u5305\u62ec\u6240\u6709\u76f8\u5173\u751f\u6001\u7cfb\u7edf\u78b3\u6c60\uff08\u5730\u4e0a\u751f\u7269\u91cf\u3001\u5730\u4e0b\u751f\u7269\u91cf\u3001\u67af\u6728\u3001\u843d\u53f6\u3001\u571f\u58e4\uff09\u4ee5\u53ca\u6e29\u5ba4\u6c14\u4f53\uff08CO2\u3001CH4\u3001N2O\uff09\u3002\u6bcf\u4e2a\u50cf\u7d20\u7684\u6392\u653e\u8bc4\u4f30\u662f\u6309\u53d1\u751f\u5730\u76ae\u66ff\u4ee3\u5e72\u6270\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u7684\u201cIPCC \u6307\u5bfc\u51c6\u5219\u201d(IPCC Guidelines) \u8ba1\u7b97\u7684\uff0c\u8fd9\u5728 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a> \u7684 Global Forest Change \u5e74\u5ea6\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6570\u636e\u4e2d\u6709\u53cd\u6620\u3002\u6bcf\u4e2a\u50cf\u7d20\u6392\u653e\u7684\u78b3\u4ee5 2000 \u5e74\u7684\u78b3\u5bc6\u5ea6\u4e3a\u4f9d\u636e\uff0c\u5e76\u9488\u5bf9 2000 \u5e74\u81f3\u5e72\u6270\u53d1\u751f\u5e74\u4efd\u95f4\u7d2f\u79ef\u7684\u78b3\u8fdb\u884c\u4e86\u8c03\u6574\u3002\u6392\u653e\u53cd\u6620\u7684\u662f\u603b\u91cf\u4f30\u8ba1\uff0c\u5373\u4e0d\u5305\u62ec\u540e\u7eed\u518d\u751f\u5e26\u6765\u7684\u78b3\u6d88\u9664\u3002\u800c\u662f\u5728\u4f34\u968f\u68ee\u6797\u78b3\u6d88\u9664\u5c42\u4e2d\u8003\u8651\u6e05\u6797\u540e\u7684\u540e\u7eed\u518d\u751f\u5e26\u6765\u7684\u78b3\u6d88\u9664\u603b\u91cf\u3002\u6bcf\u4e2a\u50cf\u7d20\u5728\u5e72\u6270\u65f6\u6392\u653e\u7684\u90e8\u5206\uff08\u6392\u653e\u7cfb\u6570\uff09\u53d7\u591a\u4e2a\u56e0\u7d20\u5f71\u54cd\uff0c\u5176\u4e2d\u5305\u62ec\u5e72\u6270\u7684\u76f4\u63a5\u4fc3\u6210\u56e0\u7d20\uff0c\u4e0d\u7ba1\u706b\u707e\u662f\u5728\u5e72\u6270\u5e74\u4efd\u89c2\u5bdf\u5230\u7684\u8fd8\u662f\u5728\u89c2\u5bdf\u5230\u7684\u5e72\u6270\u4e8b\u4ef6\u4e4b\u524d\u89c2\u5bdf\u5230\u7684\uff0c\u4e5f\u4e0d\u7ba1\u5e72\u6270\u662f\u5426\u53d1\u751f\u5728\u6ce5\u7164\u4e0a\u7b49\u60c5\u51b5\u3002\u6240\u6709\u6392\u653e\u5747\u5047\u5b9a\u53d1\u751f\u5728\u5e72\u6270\u5e74\u4efd\u3002\u53ef\u4ee5\u4f7f\u7528 Hansen \u6811\u6728\u8986\u76d6\u51cf\u5c11\u6570\u636e\u5c06\u6392\u653e\u5206\u914d\u5230\u7279\u5b9a\u5e74\u4efd\u3002<br>\u6b64\u6392\u653e\u5c42\u5c5e\u4e8e <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a> \u4e2d\u6240\u8ff0\u68ee\u6797\u78b3\u901a\u91cf\u6a21\u578b\uff1b\u8be5\u6a21\u578b\u5f15\u5165\u4e86\u4e00\u79cd\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u7528\u4e8e\u4f30\u8ba1\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\uff0c\u4ee5\u4fbf\u5e2e\u52a9\u653f\u5e9c\u548c\u975e\u653f\u5e9c\u884c\u52a8\u53c2\u4e0e\u65b9\u8ddf\u8e2a\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf\uff0c\u4ee5\u53ca\u51cf\u5c11\u68ee\u6797\u78b3\u6392\u653e\u6216\u589e\u52a0\u68ee\u6797\u78b3\u6e05\u9664\u3002\u6240\u6709\u8f93\u5165\u5c42\u5747\u5df2\u91cd\u65b0\u91c7\u6837\u5230\u5e38\u89c1\u5206\u8fa8\u7387\u6bcf\u4e2a 0.00025 \u5ea6 x 0.00025 \u5ea6\u4ee5\u5339\u914d <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a>\u3002<br>\u6392\u653e\u6570\u636e\u53ef\u4f9b\u4ee5\u4e24\u79cd\u4e0d\u540c\u533a\u57df\u5355\u4f4d\u4e0b\u8f7d\uff1a1) \u5146\u514b CO2e \u6392\u653e ha-1\uff0c\u4ee5\u53ca 2) \u5146\u514b CO2e \u6392\u653e pixel-1\u3002\u7b2c\u4e00\u4e2a\u9002\u7528\u4e8e\u6392\u653e\u53ef\u89c6\u5316\uff08\u5236\u56fe\uff09\uff0c\u56e0\u4e3a\u5b83\u4ee3\u8868\u6bcf\u516c\u9877\u7684\u6392\u653e\u5bc6\u5ea6\u3002\u7b2c\u4e8c\u4e2a\u9002\u7528\u4e8e\u8ba1\u7b97\u5173\u6ce8\u533a\u57df (AOI) \u7684\u6392\u653e\uff0c\u56e0\u4e3a AOI \u4e2d\u7684\u50cf\u7d20\u503c\u53ef\u4ee5\u76f8\u52a0\u4ee5\u83b7\u53d6\u8be5\u533a\u57df\u7684\u6392\u653e\u603b\u91cf\u3002\u8ba1\u7b97\u91c7\u7528\u540e\u4e00\u4e2a\u5355\u4f4d\u7684\u503c\u65f6\uff0c\u6309\u6bcf\u4e2a\u50cf\u7d20\u5927\u5c0f\u8c03\u6574\u6bcf\u516c\u9877\u7684\u6392\u653e\u91cf\uff0c\u8be5\u503c\u56e0\u7eac\u5ea6\u800c\u6709\u5dee\u5f02\u3002", "d15e636c2d739a20a661fba66046626f": "\u7528\u4f5c\u4f30\u8ba1\u57fa\u7840\u7684\u6d3b\u52a8\u6570\u636e\u5305\u542b\u65f6\u95f4\u4e0d\u4e00\u81f4\u6027\uff1a", "db290667c2c68de1047e7cdbc7f0514c": "\u5168\u7403\u706b\u707e\u5929\u6c14\u6307\u6570\u2014\u20142022 \u5e74 5 \u6708 25 \u65e5", "5db7685ec3cf9e027bc6c47b2c901fd8": "\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11", "de4b80ebae8d37fba4b214ead260d126": "\u6b64\u6570\u636e\u96c6\u4e0d\u5305\u62ec\u4f1a\u5bfc\u81f4\u5728 30 m \u50cf\u7d20\u5c3a\u5ea6\u4e0b\u6811\u51a0\u5b9e\u8d28\u6027\u51cf\u5c11\u7684\u4f4e\u5f3a\u5ea6\u6797\u4e0b\u690d\u88ab\u68ee\u6797\u706b\u707e\u3002\u56e0\u5176\u4ed6\u4fc3\u6210\u56e0\u7d20\u5bfc\u81f4\u7684\u6700\u8fd1\u68ee\u6797\u51cf\u5c11\u4e2d\u7684\u706b\u707e\u4e5f\u4e0d\u5305\u62ec\u5728\u5185\u3002\u56e0\u6b64\uff0c\u6b64\u6570\u636e\u4e0d\u5305\u62ec\u673a\u68b0\u6e05\u9664\u6811\u51a0\u540e\u7684\u4f10\u6728\u711a\u70e7\uff08\u8fd9\u5728\u5200\u8015\u706b\u79cd\u519c\u4e1a\u548c\u5927\u89c4\u6a21\u68ee\u6797\u780d\u4f10\u4e2d\u5e38\u89c1\uff09\u3002", "a082762ac67991f095de35b0e080565b": "\u6b64\u6570\u636e\u7531\u9a6c\u91cc\u5170\u5927\u5b66\u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Global Land Analysis &amp; Discovery (GLAD) \u5b9e\u9a8c\u5ba4</a>\u751f\u6210\uff0c\u6d4b\u91cf\u7684\u662f\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u533a\u57df\uff0c\u5e76\u4e0e\u5168\u7403\u6240\u6709\u9646\u5730\uff08\u5357\u6781\u6d32\u53ca\u5176\u4ed6\u5317\u6781\u5c9b\u5c7f\u9664\u5916\uff09\u7684\u6240\u6709\u5176\u4ed6\u4fc3\u6210\u56e0\u7d20\u6bd4\u8f83\uff0c\u5206\u8fa8\u7387\u5927\u7ea6\u4e3a 30 \u7c73 \u00d7 30 \u7c73\u3002\u6570\u636e\u91c7\u7528 2001 \u5e74\u81f3 2020 \u5e74\u5168\u7403\u57fa\u4e8e Landsat \u7684\u5e74\u5ea6\u53d8\u5316\u63a2\u6d4b\u6307\u6807\u4f5c\u4e3a\u8f93\u5165\u6570\u636e\u751f\u6210\uff0c\u4f9d\u636e\u4e00\u5957\u6309\u5730\u533a\u6821\u51c6\u7684\u5206\u7c7b\u6811\u7ec4\u5408\u6a21\u578b\u3002\u7ed8\u56fe\u8fc7\u7a0b\u7684\u7ed3\u679c\u80fd\u4ee5\u4e00\u7ec4\u4e8c\u5143\u6620\u5c04\u7684\u65b9\u5f0f\u67e5\u770b\uff08\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u4e0e\u6240\u6709\u5176\u4ed6\u4fc3\u6210\u56e0\u7d20\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6bd4\u8f83\uff09\u3002", "a7c1c592cecbbf4447d32494ae3024a0": "\u5728\u6b64\u6570\u636e\u96c6\u4e2d\uff0c\u6811\u6728\u8986\u76d6\u662f\u6307\u9ad8\u5ea6\u8d85\u8fc7 5 \u7c73\u7684\u6240\u6709\u690d\u88ab\uff0c\u5176\u5f62\u5f0f\u53ef\u4ee5\u662f\u6811\u51a0\u5bc6\u5ea6\u5728\u67d0\u4e2a\u8303\u56f4\u7684\u5929\u7136\u6797\u6216\u4eba\u5de5\u6797\u3002\u6811\u6728\u8986\u76d6\u51cf\u5c11\u662f\u6307\u4efb\u4f55\u5730\u76ae\u66ff\u4ee3\u5e72\u6270\uff08\u5373\uff0c\u5728 30 m \u50cf\u7d20\u5c3a\u5ea6\u4e0b\u6811\u6728\u8986\u76d6\u6811\u51a0\u5b8c\u5168\u6d88\u5931\uff09\uff0c\u53ef\u80fd\u4e0d\u4e00\u5b9a\u7b49\u540c\u4e8e\u68ee\u6797\u780d\u4f10\u3002\u6811\u6728\u8986\u76d6\u51cf\u5c11\u53ef\u80fd\u662f\u4eba\u7c7b\u6d3b\u52a8\u7684\u7ed3\u679c\uff0c\u5305\u62ec\u6797\u4e1a\u5b9e\u8df5\uff0c\u5982\u4f10\u6728\u6216\u68ee\u6797\u780d\u4f10\uff08\u5929\u7136\u6797\u8f6c\u5316\u4e3a\u5176\u4ed6\u571f\u5730\u7528\u9014\uff09\u7b49\uff0c\u4ee5\u53ca\u81ea\u7136\u539f\u56e0\uff0c\u5982\u75be\u60a3\u6216\u98ce\u66b4\u635f\u5bb3\u7b49\u3002\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u4e2d\u7684\u706b\u707e\u53ef\u4ee5\u662f\u81ea\u7136\u706b\u707e\uff0c\u4e5f\u53ef\u4ee5\u662f\u4eba\u4e3a\u7528\u706b\u6d3b\u52a8\u3002", "65ea5aa373670c4e6696c3125db8e941": "\u6811\u6728\u8986\u76d6\u589e\u52a0\u4ee3\u8868 2000 \u5e74\u81f3 2012 \u5e74\u7d2f\u8ba1\u7684\u603b\u548c\uff0c\u800c\u4e0d\u662f\u5e74\u5ea6\u589e\u52a0\u3002", "45e92dc485bce4f3f94ef0d429df39d8": "2011 \u5e74\u81f3 2015 \u5e74\u95f4\u56e0\u91c7\u7528\u65b0\u7684\u536b\u661f\u6570\u636e\u548c\u65b9\u6cd5\u53d8\u5316\u800c\u5b9e\u73b0\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u63a2\u6d4b\u6539\u8fdb\u53ef\u80fd\u5bfc\u81f4\u8fd1\u5e74\u6bd4\u65e9\u5e74\u7684\u8bc4\u4f30\u503c\u9ad8\u3002", "49d4aa42b4054d427edf37a156942c06": "\u51c0\u68ee\u6797\u78b3\u901a\u91cf\u4ee3\u8868 2001 \u5e74\u81f3 2021 \u5e74\u95f4\u68ee\u6797\u4e0e\u5927\u6c14\u95f4\u51c0\u78b3\u4ea4\u6362\uff0c\u8ba1\u7b97\u7ed3\u679c\u662f\u6a21\u578b\u671f\u95f4\u68ee\u6797\u6392\u653e\u7684\u78b3\u4e0e\u68ee\u6797\u6d88\u9664\uff08\u6216\u56fa\u5b9a\uff09\u7684\u78b3\u4e4b\u95f4\u76f8\u5dee\u7684\u4f59\u91cf\uff08\u5146\u514b CO2e ha-1\uff09\u3002\u51c0\u78b3\u901a\u91cf\u7684\u8ba1\u7b97\u65b9\u6cd5\uff1a2001 \u5e74\u81f3 2021 \u5e74\u95f4\u6bcf\u4e2a\u5efa\u6a21\u50cf\u7d20\u4e2d\u7684\u5e73\u5747<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5e74\u603b\u6392\u653e</a>\u51cf\u53bb\u5e73\u5747<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5e74\u603b\u6d88\u9664</a>\uff1b\u8d1f\u503c\u610f\u5473\u7740\u68ee\u6797\u662f\u78b3\u51c0\u6c47\uff0c\u6b63\u503c\u610f\u5473\u7740\u68ee\u6797\u662f\u78b3\u51c0\u6765\u6e90\u3002\u51c0\u901a\u91cf\u6309 2000 \u5e74\u5b58\u5728\u68ee\u6797\u6216\u8005\u5728 2000 \u81f3 2012 \u5e74\u95f4\u7a33\u5b9a\u68ee\u6797\u7684\u6bcf\u4e2a\u50cf\u7d20\u4e2d\u7684\u5168\u56fd\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355\u7684\u201cIPCC \u6307\u5bfc\u51c6\u5219\u201d\u8ba1\u7b97\uff1b\u7a33\u5b9a\u68ee\u6797\u7684\u4f9d\u636e\u662f <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a> \u7684 Global Forest Change \u6811\u6728\u8986\u76d6\u53d8\u5316\u6570\u636e\u3002\u6b64\u5c42\u53cd\u6620\u6a21\u578b\u671f\u95f4\uff082001 \u5e74\u81f3 2021 \u5e74\uff09\u7684\u7d2f\u8ba1\u51c0\u901a\u91cf\uff0c\u5fc5\u987b\u9664\u4ee5 21 \u624d\u80fd\u83b7\u53d6\u5e73\u5747\u5e74\u51c0\u901a\u91cf\uff1b\u51c0\u901a\u91cf\u503c\u4e0d\u80fd\u5206\u914d\u5230\u6a21\u578b\u7684\u4e2a\u522b\u5e74\u4efd\u3002<br>\u6b64\u51c0\u901a\u91cf\u5c42\u5c5e\u4e8e <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a> \u4e2d\u6240\u8ff0\u7684\u68ee\u6797\u78b3\u901a\u91cf\u6a21\u578b\u3002\u6b64\u8bba\u6587\u5f15\u5165\u4e86\u4e00\u79cd\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u7528\u4e8e\u4f30\u8ba1\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\uff0c\u4ee5\u4fbf\u5e2e\u52a9\u653f\u5e9c\u548c\u975e\u653f\u5e9c\u884c\u52a8\u53c2\u4e0e\u65b9\u8ddf\u8e2a\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf\uff0c\u4ee5\u53ca\u51cf\u5c11\u68ee\u6797\u78b3\u6392\u653e\u6216\u589e\u52a0\u68ee\u6797\u78b3\u6e05\u9664\u3002\u6240\u6709\u8f93\u5165\u5c42\u5747\u5df2\u91cd\u65b0\u91c7\u6837\u5230\u5e38\u89c1\u5206\u8fa8\u7387\u6bcf\u4e2a 0.00025 \u5ea6 x 0.00025 \u5ea6\u4ee5\u5339\u914d <a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a>\u3002<br>\u51c0\u901a\u91cf\u5728\u6a21\u578b\u671f\u95f4\u53ef\u4f9b\u4ee5\u4e24\u79cd\u4e0d\u540c\u533a\u57df\u5355\u4f4d\u4e0b\u8f7d\uff1a1) \u5146\u514b CO2e ha-1\uff0c\u4ee5\u53ca 2) \u5146\u514b CO2e pixel-1\u3002\u7b2c\u4e00\u4e2a\u9002\u7528\u4e8e\u51c0\u901a\u91cf\u53ef\u89c6\u5316\uff08\u5236\u56fe\uff09\uff0c\u56e0\u4e3a\u5b83\u4ee3\u8868\u6bcf\u516c\u9877\u7684\u78b3\u901a\u91cf\u5bc6\u5ea6\u3002\u7b2c\u4e8c\u4e2a\u9002\u7528\u4e8e\u8ba1\u7b97\u5173\u6ce8\u533a\u57df (AOI) \u7684\u51c0\u901a\u91cf\uff0c\u56e0\u4e3a AOI \u4e2d\u7684\u50cf\u7d20\u503c\u53ef\u4ee5\u76f8\u52a0\u4ee5\u83b7\u53d6\u8be5\u533a\u57df\u7684\u78b3\u901a\u91cf\u603b\u548c\u3002\u8ba1\u7b97\u91c7\u7528\u540e\u4e00\u4e2a\u5355\u4f4d\u7684\u503c\u65f6\uff0c\u6309\u6bcf\u4e2a\u50cf\u7d20\u5927\u5c0f\u8c03\u6574\u6bcf\u516c\u9877\u7684\u51c0\u901a\u91cf\uff0c\u8be5\u503c\u56e0\u7eac\u5ea6\u800c\u6709\u5dee\u5f02\u3002\u5728\u4f30\u8ba1 2001 \u5e74\u81f3 2021 \u5e74\u95f4\u6307\u5b9a\u5e74\u6570\u4e2d\u53d1\u751f\u7684\u51c0\u901a\u91cf\u65f6\uff0c\u5c06\u63d0\u4f9b\u7684\u503c\u9664\u4ee5\u6a21\u578b\u6301\u7eed\u65f6\u95f4\uff0c\u7136\u540e\u4e58\u4ee5\u5173\u6ce8\u671f\u95f4\u5185\u7684\u5e74\u6570\u3002", "983dd6d9679bd9ead2a9f70e07deadd1": "\u68ee\u6797\u901a\u8fc7\u68ee\u6797\u6c47\u5b9e\u73b0\u7684\u5927\u6c14\u78b3\u6d88\u9664\uff08\u56fa\u78b3\uff09\u4ee3\u8868\u5728 2001 \u5e74\u81f3 2021 \u5e74\u95f4\u6a21\u578b\u671f\u95f4\u7a33\u5b9a\u6797\u548c\u65b0\u751f\u6797\u7684\u751f\u957f\u6240\u6355\u83b7\u7684\u78b3\u7684\u7d2f\u8ba1\uff08\u5146\u514b CO2 ha-1\uff09\u3002\u6d88\u9664\u5305\u62ec\u5730\u4e0a\u548c\u5730\u4e0b\u6d3b\u6811\u6728\u751f\u7269\u91cf\u4e2d\u78b3\u7684\u7d2f\u8ba1\u3002\u6839\u636e\u9488\u5bf9\u5269\u4f59\u68ee\u6797\u7684 IPCC Tier 1 \u5047\u8bbe\uff0c\u67af\u6728\u3001\u843d\u53f6\u548c\u571f\u58e4\u78b3\u6c60\u5e26\u6765\u7684\u6d88\u9664\u5047\u5b9a\u4e3a\u96f6\u3002\u5728\u6bcf\u4e2a\u50cf\u7d20\u4e2d\uff0c\u78b3\u6d88\u9664\u6309 2000 \u5e74\u5b58\u5728\u68ee\u6797\u6216\u8005\u5728 2000 \u81f3 2012 \u5e74\u95f4\u7a33\u5b9a\u68ee\u6797\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5168\u56fd\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u7684\u201cIPCC \u6307\u5bfc\u51c6\u5219\u201d\u8ba1\u7b97\uff1b\u7a33\u5b9a\u68ee\u6797\u7684\u4f9d\u636e\u662f <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a> \u7684 Global Forest Change \u6811\u6728\u8986\u76d6\u51cf\u5c11\u6570\u636e\u3002\u6bcf\u4e2a\u50cf\u7d20\u5b9e\u73b0\u7684\u78b3\u6d88\u9664\u57fa\u4e8e\u68ee\u6797\u7c7b\u578b\uff08\u4f8b\u5982\u7ea2\u6811\u6797\u3001\u4eba\u9020\u6797\uff09\u5730\u56fe\u3001\u751f\u6001\u533a\uff08\u4f8b\u5982\u6e7f\u6da6\u65b0\u70ed\u5e26\uff09\u3001\u68ee\u6797\u5e74\u9f84\uff08\u539f\u59cb\u6797\u3001\u8001\u6b21\u751f\u6797\uff09\u4ee5\u53ca\u78b3\u6d88\u9664\u7684\u5e74\u6570\u3002\u6b64\u5c42\u53cd\u6620\u6a21\u578b\u671f\u95f4\uff082001 \u5e74\u81f3 2021 \u5e74\uff09\u7684\u7d2f\u8ba1\u6d88\u9664\u91cf\uff0c\u5fc5\u987b\u9664\u4ee5 21 \u624d\u80fd\u83b7\u53d6\u6a21\u578b\u6301\u7eed\u671f\u95f4\u7684\u5e74\u5ea6\u5e73\u5747\u503c\uff1b\u6d88\u9664\u7387\u4e0d\u80fd\u5206\u914d\u5230\u6a21\u578b\u7684\u4e2a\u522b\u5e74\u4efd\u3002<br>\u6b64\u78b3\u6d88\u9664\u5c42\u5c5e\u4e8e <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a> \u4e2d\u6240\u8ff0\u7684\u68ee\u6797\u78b3\u901a\u91cf\u6a21\u578b\u3002\u6b64\u8bba\u6587\u5f15\u5165\u4e86\u4e00\u79cd\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u7528\u4e8e\u4f30\u8ba1\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\uff0c\u4ee5\u4fbf\u5e2e\u52a9\u653f\u5e9c\u548c\u975e\u653f\u5e9c\u884c\u52a8\u53c2\u4e0e\u65b9\u8ddf\u8e2a\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf\uff0c\u4ee5\u53ca\u51cf\u5c11\u68ee\u6797\u78b3\u6392\u653e\u6216\u589e\u52a0\u68ee\u6797\u78b3\u6e05\u9664\u3002\u6240\u6709\u8f93\u5165\u5c42\u5747\u5df2\u91cd\u65b0\u91c7\u6837\u5230\u5e38\u89c1\u5206\u8fa8\u7387\u6bcf\u4e2a 0.00025 \u5ea6 x 0.00025 \u5ea6\u4ee5\u5339\u914d Hansen et al. (2013)\u3002<br>\u6d88\u9664\u91cf\u5728\u6a21\u578b\u671f\u95f4\u53ef\u4f9b\u4ee5\u4e24\u79cd\u4e0d\u540c\u533a\u57df\u5355\u4f4d\u4e0b\u8f7d\uff1a1) \u5146\u514b CO2 \u6d88\u9664 ha-1\uff0c\u4ee5\u53ca 2) \u5146\u514b CO2 \u6d88\u9664 pixel-1\u3002\u7b2c\u4e00\u4e2a\u9002\u7528\u4e8e\u6d88\u9664\u53ef\u89c6\u5316\uff08\u5236\u56fe\uff09\uff0c\u56e0\u4e3a\u5b83\u4ee3\u8868\u6bcf\u516c\u9877\u7684\u6d88\u9664\u5bc6\u5ea6\u3002\u7b2c\u4e8c\u4e2a\u9002\u7528\u4e8e\u8ba1\u7b97\u5173\u6ce8\u533a\u57df (AOI) \u7684\u6d88\u9664\uff0c\u56e0\u4e3a AOI \u4e2d\u7684\u50cf\u7d20\u503c\u53ef\u4ee5\u76f8\u52a0\u4ee5\u83b7\u53d6\u8be5\u533a\u57df\u7684\u6d88\u9664\u603b\u91cf\u3002\u8ba1\u7b97\u91c7\u7528\u540e\u4e00\u4e2a\u5355\u4f4d\u7684\u503c\u65f6\uff0c\u6309\u6bcf\u4e2a\u50cf\u7d20\u5927\u5c0f\u8c03\u6574\u6bcf\u516c\u9877\u7684\u6d88\u9664\u91cf\uff0c\u8be5\u503c\u56e0\u7eac\u5ea6\u800c\u6709\u5dee\u5f02\u3002\u5728\u4f30\u8ba1 2001 \u5e74\u81f3 2021 \u5e74\u95f4\u6307\u5b9a\u5e74\u6570\u4e2d\u53d1\u751f\u7684\u6d88\u9664\u91cf\u4ee5\u4e0e\u6392\u653e\u6bd4\u8f83\u65f6\uff0c\u5c06\u78b3\u6d88\u9664\u603b\u91cf\u9664\u4ee5\u6a21\u578b\u6301\u7eed\u65f6\u95f4\uff0c\u7136\u540e\u4e58\u4ee5\u5173\u6ce8\u671f\u95f4\u5185\u7684\u5e74\u6570\u3002", "a55d519ac7b4726105af82759d568dd6": "<span></span>\u6bcf\u6708\u6458\u8981", "ee4488705a91abc8664527532b1caa98": "<button role=\"switch\" aria-label=\"toggle\" aria-checked=\"false\" class=\"c-toggle toggle-large\"></button>\u516c\u5f00\u6b64\u533a\u57df", "186f106fa0250dd7634d4da6ea4a6314": "\u662f\u5426\u8981\u63a5\u6536\u9884\u8b66\u901a\u77e5\uff1f", "cd1ff80f7bd1e3b513517ebee2c8236b": "\u5728\u5171\u4eab\u4e4b\u524d\uff0c\u60a8\u9700\u8981\u516c\u5f00\u60a8\u7684\u533a\u57df\u3002\u4efb\u4f55\u4eba\u5747\u53ef\u901a\u8fc7 URL \u67e5\u770b\u516c\u5f00\u533a\u57df\uff1b\u4ec5\u533a\u57df\u7684\u521b\u5efa\u8005\u53ef\u4ee5\u67e5\u770b\u79c1\u6709\u533a\u57df\u3002", "02f1c34b441078034695e0db8370bb5d": "\u6309 Enter \u952e\u521b\u5efa\u5e76\u5206\u9694\u6807\u7b7e", "f6e1a0cdf8523315f7116a15ebad69e7": "\u5df2\u4fdd\u5b58\u60a8\u7684\u533a\u57df", "ca6ba15f749e902c068d7ce5e3c70aeb": "\u60a8\u53ef\u4ee5\u5728\u201c\u6211\u7684 GFW\u201d\u4e2d\u67e5\u770b\u60a8\u6240\u6709\u7684\u533a\u57df", "5ad06e3251a8f933043ce62e433d04d4": "\u4fdd\u5b58\u5173\u6ce8\u533a\u57df", "af20d422ba8a9f132dfa7e04bba0a351": "\u547d\u540d\u6b64\u533a\u57df\u4f9b\u4ee5\u540e\u53c2\u8003 *", "71a361b5b0336165c888d1a21625d26d": "\u4e3a\u4e0d\u540c\u7684\u533a\u57df\u5206\u914d\u6807\u7b7e\u4ee5\u4fbf\u8fdb\u884c\u5f52\u7eb3\u6574\u7406", "598974ef11e9c1d0d3f2493b7ce0668f": "\u6211\u4eec\u5c06\u6839\u636e\u60a8\u7684\u7528\u6237\u8d44\u6599\u5411\u60a8\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\uff0c\u66f4\u65b0\u60a8\u9009\u62e9\u7684\u533a\u57df\u7684\u9884\u8b66\u548c\u68ee\u6797\u8986\u76d6\u53d8\u5316\u60c5\u51b5\u3002", "8d02fd86cc4f4b519b5680a06325c6c8": "Webhook URL\uff08\u53ef\u9009\uff09", "29c814ed7b1309bda3833fa0cae6a6da": "<span></span>\u4e00\u65e6\u68c0\u6d4b\u5230\u706b\u60c5", "b73a947bbb4006c4306f6e318c1e6d76": "<span></span>\u4e00\u65e6\u68c0\u6d4b\u5230\u68ee\u6797\u53d8\u5316", "1c4d5da68b4d8678eb0c06c7a1801d27": "\u8bed\u8a00 *", "ca7693284a19bf728c62548429e41def": "\u67ec\u57d4\u5be8<button><svg class=\"c-icon \" viewBox=\"0 0 32 32\"><use xlink:href=\"#close-41618f4c--sprite\"></use></svg></button>", "30819eaa9387a0cd230598e5a2efe240": "\u6bcf\u5e74\u90fd\u4f1a\u5bf9\u6797\u6728\u8986\u76d6\u635f\u5931\u3001<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u9a71\u52a8\u56e0\u7d20</a>\u548c\u70e7\u6bc1\u9762\u79ef\u8fdb\u884c\u66f4\u65b0\u30022023 \u5e74\u548c 2024 \u5e74\uff0c\u4e00\u4e9b\u6a21\u578b\u8f93\u5165\u6570\u636e\u96c6\u548c\u5e38\u91cf\u4e5f\u53d1\u751f\u4e86\u53d8\u5316\uff0c\u5982\u4e0b\u6240\u8ff0\u3002\u8bf7\u53c2\u9605<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8fd9\u7bc7\u535a\u6587</a>\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002", "adc1e67feeb7ea556c7b1523c95cd297": "\u5370\u5ea6\u5c3c\u897f\u4e9a<button><svg class=\"c-icon \" viewBox=\"0 0 32 32\"><use xlink:href=\"#close-41618f4c--sprite\"></use></svg></button>", "377f49f7820f754638860c5aafe28538": "\u5df4\u897f<button><svg class=\"c-icon \" viewBox=\"0 0 32 32\"><use xlink:href=\"#close-41618f4c--sprite\"></use></svg></button>", "1e4eeb47a79be5fab1fadb88668c06d9": "\u81ea\u7136\u8272", "13da4d5f626218f10d568b05f432815f": "\u989c\u8272\u9519\u8bef\uff08NIR)", "8884ba6b077d346fa3457129d36ade51": "\u5730\u7403\u5730\u56fe\u5e95\u56fe", "ee5d2322b75beb2706a5092fd768e90c": "\u63d0\u4f9b\u5168\u7403\u8303\u56f4\u5185\u7684\u57fa\u672c\u5730\u7406\u7279\u5f81\u3001\u884c\u653f\u533a\u5212\u5206\uff0c\u4ee5\u53ca\u57fa\u7840\u8bbe\u65bd\u4fe1\u606f\uff0c\u5e76\u4e3a\u4ea4\u4e92\u5f0f\u5730\u56fe\u4e0a\u663e\u793a\u7684\u6240\u6709\u6570\u636e\u96c6\u63d0\u4f9b\u91cd\u8981\u4fe1\u606f\u6765\u6e90", "c79d065bca1b492759434519ec181452": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8fd9\u91cc</a>\u4e5f\u63d0\u4f9b Planet Labs Inc. Mosaics \u4e0b\u8f7d\u3002", "c2b5e73361a4bf9d26a73413d0abee5e": "\u536b\u661f", "9767c1a534f55052d126db51a7b22331": "\u8fd1\u671f\u536b\u661f\u56fe\u7247", "357b097b9f53a96c9d1c2ba5e27c5194": "\u83b7\u53d6\u65e5\u671f", "2f44417567bc123bd7c60de8c2a2b444": "\u4e4b\u524d", "c9a8b30b20e7ffb36fb1f9d65bfe4531": "\u6700\u5927\u4e91\u5c42\u767e\u5206\u6bd4", "1540a08f897e0eaf6444c1a504cd78f3": "\u5206\u4eab\u6b64\u89c6\u56fe", "58c0a0e97e6d2f615bc264c2775fda44": "\u94fe\u63a5", "be8de5df79cf4d9d326d56365a81a61c": "\u8be5\u5de5\u5177\u663e\u793a\u7b26\u5408Sentinel-2\u548cLandsat 8\u536b\u661f\u7cfb\u7edf\u6240\u9009\u4e91\u8986\u76d6\u6807\u51c6\u7684\u6700\u65b0\u536b\u661f\u56fe\u50cf\u3002\u8be5\u5de5\u5177\u63d0\u4f9b\u4e86\u5173\u4e8e\u4e16\u754c\u5404\u5730\u690d\u88ab\u5065\u5eb7\u7684\u4fe1\u606f\uff0c\u4ee5\u53ca\u8fd1\u5b9e\u65f6\u8b66\u62a5\u7684\u53c2\u8003\u4fe1\u606f\u548c\u9a8c\u8bc1\u3002Sentinel-2\u7531\u6b27\u6d32\u822a\u5929\u5c40\u8fd0\u8425\uff0c\u53ef\u8986\u76d6\u5168\u7403\uff0c\u5206\u8fa8\u7387\u4e3a10\u7c73\uff0c\u6bcf10\u5929\u53ef\u83b7\u5f97\u66f4\u65b0\u56fe\u50cf\u3002\u7531\u7f8e\u56fd\u5730\u8d28\u8c03\u67e5\u5c40\u8fd0\u8425\u7684Landsat 8\u4e5f\u662f\u4e00\u9897\u5168\u7403\u536b\u661f\uff0c\u6bcf16\u5929\u53ef\u4ee5\u83b7\u5f97\u5206\u8fa8\u7387\u4e3a30\u7c73\u7684\u6700\u65b0\u56fe\u50cf\u3002", "ca919243a966bda4aae9eec8426078d4": "\u4e24\u4e2a\u536b\u661f\u90fd\u6709\u81ea\u7136\u989c\u8272\u56fe\u548c\u690d\u88ab\u5065\u5eb7\u56fe\u3002\u81ea\u7136\u989c\u8272\u56fe\u4f7f\u7528\u53ef\u89c1\u5149\uff08\u7ea2\u3001\u7eff\u548c\u84dd\uff09\u4fe1\u606f\u663e\u793a\u6b63\u5982\u4eba\u773c\u6240\u89c1\u7684\u5730\u7403\u8868\u9762\u3002\u690d\u88ab\u5065\u5eb7\u56fe\u7ed3\u5408\u7ea2\u5916\u7ebf\u548c\u8fd1\u7ea2\u5916\u6f2b\u53cd\u5c04\u4fe1\u606f\uff0c\u4f7f\u7528\u690d\u88ab\u5f52\u4e00\u5316\u6307\u6570 (NDVI) \u6765\u68c0\u6d4b\u690d\u88ab\u5065\u5eb7\u3002\u8fd9\u79cd\u65b9\u6cd5\u7684\u539f\u7406\u662f\uff0c\u5065\u5eb7\u690d\u88ab\u4f1a\u5438\u6536\u6700\u591a\u53ef\u89c1\u5149\u5e76\u53cd\u5c04\u6700\u591a\u7167\u5728\u8868\u9762\u7684\u8fd1\u7ea2\u5916\u5149\u3002\u5728\u89e3\u8bfb\u690d\u88ab\u5065\u5eb7\u56fe\u65f6\uff0c\u7ea2\u8272\u4ee3\u8868\u5065\u5eb7\u751f\u957f\u7684\u690d\u88ab\uff0c\u7eff\u8272\u4ee3\u8868\u88f8\u9732\u7684\u5730\u9762\uff0c\u9ed1\u8272\u4ee3\u8868\u6c34\u4f53\u3002", "52bdc1de2fafa0370a9129af4bee520d": "\u6bcf\u5929\u90fd\u6709\u65b0\u7684\u56fe\u7247\u51fa\u73b0\u3002\u56fe\u7247\u91cd\u8bbf\u65f6\u95f4\uff1aSentinel-2A\uff1a\u6bcf 10 \u5929\uff0cLandsat 8\uff1a\u6bcf 16 \u5929", "b71a64a79187c96abf29f31959f0aa50": "\u56fe\u50cf\u7c7b\u578b", "64f7871ead6202e6bc403274b41acb7b": "\u8981\u5bf9\u6b64\u533a\u57df\u8fdb\u884c\u6df1\u5165\u5206\u6790\uff0c\u8bf7\u8bbf\u95ee<a href=\"{{0}}\">\u533a\u57df\u4eea\u8868\u677f</a>\u3002", "4d43844d91104db28c883cf96952aa08": "\u4e86\u89e3\u66f4\u591a", "e661fbdd62c3babc129c3ba2526ea000": "\u4e0b\u8f7d\u6570\u636e", "30290cf1d9678ada9cb1ef2828eff6f3": "Global Forest Watch\uff08GFW\uff09\u662f\u4e00\u4e2a\u5728\u7ebf\u5e73\u53f0\uff0c\u63d0\u4f9b\u68ee\u6797\u76d1\u6d4b\u7684\u6570\u636e\u548c\u5de5\u5177\u3002\u901a\u8fc7\u5229\u7528\u5c16\u7aef\u79d1\u6280\uff0cGFW \u53ef\u8ba9\u4efb\u4f55\u4eba\u51e0\u4e4e\u5b9e\u65f6\u83b7\u53d6\u4fe1\u606f\uff0c\u4e86\u89e3\u5168\u7403\u5404\u5730\u68ee\u6797\u53d1\u751f\u53d8\u5316\u7684\u5730\u70b9\u548c\u65b9\u5f0f\u3002", "ffcba57dcb25568d2a7afecc8264994e": "\u6ca1\u6709<strong>\u5df4\u897f</strong>\u571f\u5730\u4f7f\u7528\u53ef\u7528\u6570\u636e\u96c6\u3002", "e61987a62e021e8bed141274a933ebbc": "\u5728 ARCGIS \u4e2d\u6253\u5f00", "75ac155377372f2131d67c86c5d12310": "\u6807\u8bc6\u6811\u6728\u8986\u76d6\u7684\u533a\u57df\u3002", "92f49efc15dea075939ddbdde493020e": "\u51e0\u4e4e\u5b9e\u65f6\u786e\u5b9a\u53ef\u80fd\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u533a\u57df\u3002", "8203ffdb9f8b76c30e1f38381faa54da": "\u8bc6\u522b\u6811\u6728\u8986\u76d6\u9000\u5316\u533a\u57df", "2cd4c506ab1168e95210551101df2dad": "\u663e\u793a\u6700\u591a3\u4e2a\u6708\u7684\u706b\u707e\u8b66\u62a5\u6570\u636e\u3002", "16bf7cf54994684582895e3702e0d3c0": "\u786e\u5b9a\u68ee\u6797\u8986\u76d6\u589e\u52a0\u533a\u57df\u3002", "9e04e2ad598ca8bab0cd627b10e22743": "\u6807\u8bc6\u4e16\u754c\u4e0a\u5269\u4e0b\u7684\u6700\u540e\u7684\u6574\u5757\u68ee\u6797\u666f\u89c2\uff0c\u5176\u5927\u5c0f\u8db3\u4ee5\u4fdd\u7559\u6240\u6709\u672c\u5730\u751f\u7269\u591a\u6837\u6027\uff0c\u5e76\u4e14\u81ea2013\u5e74\u4ee5\u6765\u6ca1\u6709\u4eba\u4e3a\u6539\u53d8\u7684\u8ff9\u8c61\u3002\u8be5\u5c42\u8fd8\u663e\u793a\u4e862000\u5e74\u81f32016\u5e74\u6574\u5757\u68ee\u6797\u666f\u89c2\u7684\u51cf\u5c11\u7a0b\u5ea6\u3002", "8b58301a10f0905c34b88043a37405c2": "\u663e\u793a 2015 \u5e74\u5168\u7403\u571f\u5730\u8986\u76d6\u5206\u5e03\u3002", "73f47d2daafde40ad9346966de8ac5ec": "\u663e\u793a\u9009\u4e2d\u56fd\u5bb6\u7684\u79cd\u690d\u8986\u76d6\u7387\u3002", "b27a84b9becf3a69219f439830e82f13": "\u6240\u9009\u5e74\u4efd\uff081996 \u81f3 2016 \u5e74\uff09\u5168\u7403\u7ea2\u6811\u6797\u8986\u76d6\u7387", "9db7420e448fd7a2a2aae50b4ca8f31a": "\u63d0\u4f9b\u53ef\u9009\u62e9\u6027\u780d\u4f10\u5929\u7136\u6797\u7684\u4f10\u6728\u7279\u8bb8\u6743\u7684\u8fb9\u754c\u3002", "e8daa42ec73f53269d312f4e71dc84b4": "\u663e\u793a\u653f\u5e9c\u5206\u914d\u7ed9\u77ff\u4ea7\u5f00\u91c7\u516c\u53f8\u7684\u533a\u57df\u8fb9\u754c\u3002", "5f0660096a55c59c3585aded1f35258d": "\u663e\u793a\u68d5\u6988\u6cb9\u5382\u4f4d\u7f6e\u3002", "16fcedf6f5a6a61a82fa7277c2de0de8": "\u6839\u636eRTRS\u6807\u51c6\u6307\u5bfc\u8d1f\u8d23\u4efb\u5927\u8c46\u751f\u4ea7\u7684\u6269\u5c55\u5e76\u8fdb\u884c\u5b9e\u5730HCVA\u8bc4\u4f30\u3002", "a764847c5a22f1c31ff7018d299e3a01": "\u663e\u793a\u653f\u5e9c\u6307\u5b9a\u516c\u53f8\u79cd\u690d\u6cb9\u68d5\u6988\u6797\u7684\u5730\u533a\u8fb9\u754c\u3002", "d69c45b1b71d8913e10963a8fd55d107": "\u201c\u77f3\u6cb9\u548c\u5929\u7136\u6c14\u7279\u8bb8\u7528\u5730\u201d\u662f\u6307\u653f\u5e9c\u5206\u914d\u7ed9\u52d8\u63a2\u548c\u751f\u4ea7\u77f3\u6cb9\u3001\u5929\u7136\u6c14\u548c\u5176\u4ed6\u78b3\u6c22\u5316\u5408\u7269\u7684\u516c\u53f8\u7684\u533a\u57df\u3002", "fe873275f9a43c23147c66a7dea28c9f": "\u663e\u793a\u7531\u653f\u5e9c\u5212\u62e8\u7ed9\u79c1\u4eba\u690d\u6797\u516c\u53f8\u7684\u533a\u57df\u7684\u8fb9\u754c\uff0c\u8fd9\u4e9b\u516c\u53f8\u690d\u6797\u7528\u4e8e\u751f\u4ea7\u6728\u6750\u4ee5\u53ca\u6728\u6d46\u7eb8\u548c\u7eb8\u5236\u54c1\u6240\u7528\u7684\u6728\u6d46\u3002", "b5b44d5be4401a55907ffad8036a1d9c": "\u663e\u793a\u571f\u8457\u4eba\u6c11\u6216\u5730\u65b9\u793e\u533a\u4eab\u6709\u7279\u5b9a\u8d44\u6e90\u6743\u548c\u6709\u9650\u571f\u5730\u8fdb\u5165\u6743\u7684\u533a\u57df\u8fb9\u754c\u3002", "6065f3c7e46b41b8b617a494f7a0eac6": "\u5c55\u793a\u6839\u636e\u5404\u79cd\u540d\u53f7\uff08\u5982\u56fd\u5bb6\u516c\u56ed\u3001\u56fd\u5bb6\u4fdd\u62a4\u533a\u548c\u91ce\u751f\u52a8\u7269\u4fdd\u62a4\u533a\uff09\u53d7\u5230\u6cd5\u5f8b\u4fdd\u62a4\u5e76\u5b9e\u73b0\u4fdd\u62a4\u76ee\u6807\u7684\u533a\u57df\u3002", "bb4cf52db0df43289b29d152b14bdcf4": "\u6807\u8bb0\u4e86\u4e16\u754c\u4e0a 50 \u4e2a\u4e3b\u8981\u6d41\u57df\u7684\u5927\u575d\u4f4d\u7f6e\u3002", "0d30f1cc72081cea5ba1ecd1332d4086": "\u663e\u793a\u521a\u679c\u76c6\u5730\u7b4f\u9053\u5ef6\u4f38\u60c5\u51b5\u3002", "65fc9dfe5774647f32b32388ccba4fe6": "\u663e\u793a\u7531\u571f\u8457\u4eba\u6c11\u6216\u5f53\u5730\u793e\u533a\u96c6\u4f53\u6301\u6709\u6216\u4f7f\u7528\u7684\u571f\u5730\u7684\u8fb9\u754c\u3002", "6ae920989cd58fedc2398aa66f54cff8": "\u663e\u793a\u5168\u7403\u5730\u4e0a\u6d3b\u4f53\u6728\u8d28\u751f\u7269\u91cf\u7684\u78b3\u5bc6\u5ea6\u503c\u3002", "fc08d31bf0662bc7495bbc59942c5a69": "\u786e\u5b9a\u8868\u571f\uff080-30\u5398\u7c73\u6df1\uff09\u4e2d\u7684\u6709\u673a\u78b3\u5bc6\u5ea6\u3002", "35151dc5de6c26c6f786a8fce16b8443": "\u663e\u793a\u68ee\u6797\u53d8\u5316\u5bf9\u5f53\u5730\u751f\u7269\u591a\u6837\u6027\u5b8c\u6574\u6027\u7684\u5f71\u54cd\u3002", "9ac03cb8b0b2b2462786a97d016ad009": "\u663e\u793a\u4e86\u91cd\u8981\u7684\u4fdd\u62a4\u533a\uff0c\u4fdd\u62a4\u533a\u5185\u5305\u542b\u8303\u56f4\u53ca\u6570\u91cf\u7686\u6709\u9650\u7684\u6fd2\u5371\u7269\u79cd\uff0c\u4e14\u8fd9\u4e9b\u7269\u79cd\u5728\u5730\u7403\u4e0a\u5176\u4ed6\u4efb\u4f55\u5730\u65b9\u5747\u65e0\u53d1\u73b0\u3002", "09ec28ae84406f2db2405ccb369ca3ea": "\u663e\u793aConservation International\u7684\u751f\u7269\u591a\u6837\u6027\u70ed\u70b9\u2014\u2014\u4f4d\u4e8e\u4e16\u754c\u5404\u5730\uff0c\u56e0\u9ad8\u5ea6\u7684\u5730\u65b9\u6027\u751f\u957f\u548c\u4eba\u7c7b\u5a01\u80c1\uff0c\u751f\u7269\u591a\u6837\u6027\u7684\u4fdd\u62a4\u8feb\u5728\u7709\u776b\u7684\u754c\u5b9a\u5730\u533a\u3002", "fa35d81fe238950a98321d7ceae1fd72": "\u663e\u793a\u4e24\u79cd\u6216\u4e24\u79cd\u4ee5\u4e0a\u7279\u6709\u9e1f\u7c7b\u5730\u7406\u5206\u5e03\u8303\u56f4\u53d1\u751f\u91cd\u53e0\u7684\u533a\u57df\u3002", "0d2a991c7b663709015412a63a246d4b": "\u8fd9\u4e09\u5c42\u663e\u793a\u4e86\u8001\u864e\u5f53\u524d\u6816\u606f\u5730\u7684\u4f4d\u7f6e\u3001\u6816\u606f\u5730\u6269\u5f20\u533a\u57df\u548c\u5173\u952e\u7684\u8001\u864e\u8d70\u5eca\u3002", "c4ef352f74e502ef5e7bc98e6f4e493d": "\u7c7b\u522b", "d61f69e45718a8c698790d62c8f8dab1": "\u79d8\u9c81\u68ee\u6797\u7279\u8bb8\u6743", "11f6c15f2f538bbb1906f67c421588f5": "\u79d8\u9c81\u6c38\u4e45\u751f\u4ea7\u6797", "e03a5987ffd3a3f8281a7295070172b7": "\u79d8\u9c81\u4fdd\u62a4\u533a", "63215fb8e94fe3022fc72911319678e0": "\u9488\u5bf9\u6728\u6750\u3001\u975e\u6728\u6750\u5236\u54c1\u3001\u4fdd\u62a4\u3001\u751f\u6001\u65c5\u6e38\u3001\u91ce\u751f\u52a8\u7269\u3001\u7eff\u5316\u548c\u9020\u6797\uff0c\u663e\u793a\u7531\u6797\u4e1a\u90e8\u95e8\u5206\u914d\u7684\u3001\u68ee\u6797\u4e0e\u91ce\u751f\u52a8\u7269\u8d44\u6e90 (OSINFOR) \u76d1\u67e5\u673a\u6784\u76d1\u7763\u7684\u533a\u57df\u8fb9\u754c\u3002", "1ce9c6d85aa4f2a8636e8a9ed82e39c2": "\u8986\u76d6\u6570\u636e\u5305\u62ec\u4e86\u6797\u4e1a\u90e8\u95e8\u6388\u4e88\u7684\u7279\u8bb8\u6743\u4fe1\u606f\uff0c\u53ef\u80fd\u4f1a\u7531\u4e8e\u8f6c\u8ba9\u3001\u89c4\u6a21\u8c03\u6574\u3001\u9762\u79ef\u8865\u507f\u7b49\u539f\u56e0\u800c\u53d1\u751f\u66f4\u65b0", "ef1898a89db4356a088c697466c887dd": "\u663e\u793a\u4e86\u88ab\u68ee\u6797\u7ba1\u7406\u673a\u6784\u5206\u914d\u7684\u4ee5\u53ca\u88ab\u68ee\u6797\u548c\u91ce\u751f\u751f\u7269\u8d44\u6e90\u76d1\u7763\u673a\u6784\uff08OSINFOR\uff09\u76d1\u7763\u7684\u533a\u57df\u7684\u8fb9\u754c\uff0c\u8fd9\u4e9b\u533a\u57df\u76ee\u7684\u4e3a\u6728\u6750\u3001\u975e\u6728\u6750\u4ea7\u54c1\u3001\u4fdd\u62a4\u533a\u3001\u751f\u6001\u65c5\u6e38\u3001\u91ce\u751f\u751f\u7269\u3001\u9020\u6797\u548c\u91cd\u65b0\u9020\u6797\u3002\u7279\u8bb8\u6743\u6388\u4e88\u8bb8\u53ef\u4eba\u4e13\u5c5e\u6743\uff0c\u53ef\u4ee5\u5728\u5404\u81ea\u7684\u540d\u79f0\u6240\u8bbe\u5b9a\u7684\u6761\u4ef6\u548c\u9650\u5236\u4e0b\u53ef\u6301\u7eed\u5730\u4f7f\u7528\u81ea\u7136\u8d44\u6e90\u3002\u7279\u8bb8\u6743\u8d4b\u4e88\u4e86\u6301\u6709\u8005\u53ef\u4ee5\u4f7f\u7528\u548c\u4eab\u53d7\u88ab\u6388\u6743\u7684\u81ea\u7136\u8d44\u6e90\uff0c\u5e76\u76f8\u5e94\u5730\u4eab\u6709\u6240\u51fa\u4ea7\u7684\u6c34\u679c\u548c\u4ea7\u54c1\u7684\u6240\u6709\u6743\u3002", "fcc6a16497d19f324d342422019baafd": "\u7279\u8bb8\u6743\u7684\u7c7b\u578b\u663e\u793a\u5728\u6bcf\u4e2a\u8fb9\u754c\u7684\u5c5e\u6027\u8d44\u6599\u91cc\uff0c\u5305\u62ec\uff1a", "c8a1b810b8e3768ef647735b222b3a6a": "<em>\u6728\u6750\u7279\u8bb8\u7ecf\u8425</em> -\u51c6\u4e88\u5728\u539f\u751f\u6797\u6216\u6b21\u751f\u6797\u5efa\u9020\u6c38\u4e45\u751f\u4ea7\u6797\u7684\u6728\u6750\u4e1a\u52a1\u3002\u7279\u8bb8\u7c7b\u522b\u6709\u4e8c\uff1a5,000 - 10,000 \u516c\u9877\u95f4\u7684\u571f\u5730\u9762\u79ef\uff0c\u6216\u8d85\u8fc7 10,000 \u516c\u9877\u7684\u571f\u5730\u9762\u79ef\uff0c\u4e8c\u8005\u53ef\u518d\u751f\u957f\u957f\u8fbe 40 \u5e74\u3002", "e4304116b7f2965533db9c190c449574": "<em>\u975e\u6728\u6750\u6797\u4ea7\u54c1</em>\u2014\u2014\u7528\u4e8e\u6536\u83b7\u975e\u6728\u6750\u4ea7\u54c1\u7684\u533a\u57df\uff0c\u6bd4\u5982\u6c34\u679c\uff0c\u82bd\u3001\u80f6\u4e73\u3001\u6811\u8102\u3001\u80f6\u3001\u82b1\u3001\u7ea4\u7ef4\u7b49\uff0c\u8fd9\u4e9b\u4ea7\u54c1\u7684\u6458\u91c7\u4e0d\u4f1a\u5f71\u54cd\u68ee\u6797\u8986\u76d6\u3002\u6700\u5927\u9762\u79ef\u4e0d\u8d85\u8fc7 10,000 \u516c\u9877\uff0c\u6700\u957f\u53ef\u5ef6\u671f\u81f3 40 \u5e74\u3002", "cceec082879455826684ef51003dc8d1": "<em>\u4fdd\u80b2\u7279\u8bb8\u6743</em> \u2014\u2014\u65e8\u5728\u901a\u8fc7\u4fdd\u62a4\u548c\u534f\u8c03\u4f7f\u7528\uff08\u5982\u7814\u7a76\u3001\u6559\u80b2\u548c\u751f\u6001\u4fee\u590d\uff09\uff0c\u5bf9\u91ce\u751f\u52a8\u690d\u7269\u7684\u4fdd\u80b2\u505a\u51fa\u76f4\u63a5\u8d21\u732e\u7684\u7279\u8bb8\u6743\u3002\u4e0d\u5141\u8bb8\u91c7\u4f10\u6728\u6750\u3002", "ead217b18a29838eb6e952af0c641d14": "<em>\u751f\u6001\u65c5\u6e38\u7279\u8bb8\u6743</em>\u2014\u2014\u5a31\u4e50\u548c\u751f\u6001\u65c5\u6e38\u76f8\u5173\u6d3b\u52a8\u7279\u8bb8\u6743\uff0c\u6709\u52a9\u4e8e\u8be5\u5730\u81ea\u7136\u3001\u52a8\u7269\u548c\u6587\u5316\u4ef7\u503c\u7684\u4fdd\u80b2\uff0c\u5e76\u8ba9\u672c\u5730\u793e\u533a\u53c2\u4e0e\u5230\u6709\u5229\u7684\u793e\u4f1a\u548c\u7ecf\u6d4e\u6d3b\u52a8\u4e2d\u3002\u4e0d\u5141\u8bb8\u5546\u4e1a\u91c7\u4f10\u3002\u533a\u57df\u6709\u6548\u671f\u56db\u5341\u5e74\uff0c\u6700\u5927\u9762\u79ef 10,000 \u516c\u9877\u3002", "4ed8d4cbcb1c1d9a41b0547213ca9088": "<em>\u91ce\u751f\u52a8\u7269\u7279\u8bb8\u6743</em>\u2014\u2014\u7528\u4f5c\u91ce\u751f\u52a8\u7269\u7ba1\u7406\uff0c\u65e8\u5728\u53ef\u6301\u7eed\u5730\u4eab\u6709\u8bb8\u53ef\u7269\u79cd\u7684\u516c\u5171\u571f\u5730\u3002\u6700\u957f\u53ef\u5ef6\u671f\u81f3 25 \u5e74\u3002", "4c99ecbe6065cbd1e1c0038d7b445abf": "<em>\u9020\u6797/\u7eff\u5316\u533a\u57df</em>\u2014\u2014\u88ab\u6307\u5b9a\u7528\u4e8e\u9020\u6797\u548c\u7eff\u5316\u6d3b\u52a8\u7684\u533a\u57df\u3002", "006556d3fe3c6b7e4dab145465f9d1f5": "\u6bcf\u4e2a\u8303\u56f4\u7684\u5c5e\u6027\u6570\u636e\u4e2d\u8fd8\u6807\u6ce8\u4e86\u76d1\u7ba1\u72b6\u6001\uff0c\u5305\u62ec\uff1a", "29242dc745c857653483e71b3b187cac": "<em>\u5df2\u76d1\u7763\u7684</em>\u2014\u2014\u68ee\u6797\u7279\u8bb8\u6743\uff0c\u5176\u4e2d OSINFOR \u901a\u8fc7\u73b0\u573a\u4e0e\u684c\u9762\u7814\u7a76\u5df2\u7ecf\u6838\u5b9e\u4e86\u7279\u8bb8\u6743\u5408\u7ea6\u548c/\u6216\u8fd0\u8425\u8ba1\u5212\u4e2d\u6761\u4ef6\u548c\u4e49\u52a1\u7684\u5c65\u884c\u3002", "f1530b9048b648424bfcb207b75274cb": "<em>\u672a\u88ab\u76d1\u7ba1\u7684</em>\u2014\u2014\u5f85\u76d1\u7ba1\u7684\u68ee\u6797\u7279\u8bb8\u6743", "68ad27f44d625021a1b1645216e53828": "\u4e00\u5e74\u4e24\u6b21", "6f63842186232b22173ef66b9014006a": "\u8fb9\u754c\u5728\u91cd\u65b0\u5206\u533a\u540e\u6709\u53ef\u80fd\u53d8\u5316", "9c707ae45ab33d5dd23dc5d3c67da18f": "\u6c38\u4e45\u751f\u4ea7\u6797\u662f\u6307\u81ea\u7136\u539f\u59cb\u68ee\u6797\u533a\u57df\uff0c\u5728\u8fd9\u91cc\u7ecf\u519c\u4e1a\u90e8\u6279\u51c6\uff0c\u4e2a\u4eba\u53ef\u4ee5\u4f18\u5148\u5229\u7528\u7ecf\u68ee\u6797\u548c\u91ce\u751f\u52a8\u690d\u7269\u7ba1\u7406\u90e8\u95e8\u5141\u8bb8\u7684\u6728\u6750\u3001\u68ee\u6797\u8d44\u6e90\u548c\u91ce\u751f\u52a8\u690d\u7269\u6765\u83b7\u53d6\u5229\u76ca\u3002", "08c5e20d69f62d60a4b116273c069e2f": "\u5728\u8fd9\u4e9b\u5730\u533a\uff0c\u53ef\u4ee5\u6388\u4e88\u4f7f\u7528\u4e0d\u540c\u4ea7\u54c1\u7684\u6728\u6750\u548c\u91ce\u751f\u52a8\u7269\u7684\u6743\u5229\uff0c\u53ea\u8981\u4e0d\u5f71\u54cd\u4e0a\u8ff0\u8d44\u6e90\u7684\u957f\u671f\u53d1\u5c55\u6f5c\u529b\u3002", "46fbe640843d44df482d0ad21fb5b16a": "\u663e\u793a\u79d8\u9c81\u7684\u5b98\u65b9\u68ee\u6797\u5206\u533a\u3002", "26f15597f6e3244a7f24fd30a293c632": "\u663e\u793a\u79d8\u9c81\u548c\u7f13\u51b2\u5730\u5e26\u7684\u56fd\u5bb6\u3001\u5730\u533a\u548c\u79c1\u4eba\u4fdd\u62a4\u533a\u4f4d\u7f6e\u3002", "5836394b2437481e45ade0fce0dbd9d7": "\u5f53\u4fdd\u62a4\u533a\u88ab\u4fee\u6539\u6216\u5efa\u7acb\u65f6\u66f4\u65b0", "d0f6a7e4d116236be62b878a450dd2a6": "\u8be5\u56fe\u5c42\u663e\u793a\u4e86\u4e09\u4e2a\u4e0d\u540c\u7ea7\u522b\u7684\u4fdd\u62a4\u533a\u53ca\u5176\u7f13\u51b2\u533a\u3002", "4cfa4e2623c945a3a8c8cb29bc312520": "<strong>\u56fd\u5bb6\u4fdd\u62a4\u533a</strong>\u7531\u56fd\u5bb6\u653f\u5e9c\uff0c\u6309\u7167\u81ea\u7136\u4fdd\u62a4\u533a\u56fd\u5bb6\u670d\u52a1 (SERNANP) \u8fdb\u884c\u7ba1\u7406\u3002\u8fd9\u4e9b\u533a\u57df\u5206\u6210\u4e09\u79cd\u4f7f\u7528\u7c7b\u522b\uff1a\u95f4\u63a5\u4f7f\u7528\u3001\u76f4\u63a5\u4f7f\u7528\u4ee5\u53ca\u4fdd\u7559\u533a\u3002\u5728\u95f4\u63a5\u4f7f\u7528\u533a\uff0c\u4e0d\u5141\u8bb8\u5929\u7136\u8d44\u6e90\u7684\u5f00\u91c7\u6216\u5176\u5b83\u7c7b\u578b\u7684\u73af\u5883\u6539\u9020\u3002\u8fd9\u4e9b\u533a\u57df\u53ea\u5141\u8bb8\u5728\u76d1\u7ba1\u7684\u6761\u4ef6\u4e0b\uff0c\u8fdb\u884c\u975e\u64cd\u63a7\u6027\u79d1\u5b66\u8c03\u67e5\uff0c\u4ee5\u53ca\u65c5\u6e38\u3001\u5a31\u4e50\u3001\u6559\u80b2\u548c\u6587\u5316\u6d3b\u52a8\u3002\u5728\u76f4\u63a5\u4f7f\u7528\u533a\uff0c\u5141\u8bb8\u6309\u7167\u7531\u76f8\u5173\u56fd\u5bb6\u5f53\u5c40\u6279\u51c6\u548c\u76d1\u7ba1\u7684\u7ba1\u7406\u89c4\u5212\u4e2d\u7684\u6307\u5bfc\u65b9\u9488\uff0c\u4e3b\u8981\u7531\u5f53\u5730\u6c11\u4f17\uff0c\u5bf9\u81ea\u7136\u8d44\u6e90\u8fdb\u884c\u4f7f\u7528\u3002\u4fdd\u7559\u533a\u4e3a\u6682\u5b9a\u7c7b\u522b\uff0c\u8fd9\u4e9b\u533a\u57df\u6709\u8ba4\u5b9a\u4e3a\u81ea\u7136\u4fdd\u62a4\u533a\u7684\u6761\u4ef6\uff0c\u4f46\u662f\u9700\u8981\u5177\u4f53\u7814\u7a76\u8c03\u67e5\u786e\u5b9a\u5176\u5f52\u5c5e\u548c\u7c7b\u522b\u3002", "6f540cd628a797d11f7fdd595c36db24": "\u5df4\u897f\u751f\u7269\u7fa4\u843d", "b404971cdfbc91e7452621c816d047fd": "<strong>\u533a\u57df\u4fdd\u62a4\u533a</strong>\u53d7\u4e3a\u56fd\u5bb6\u4fdd\u62a4\u533a\u5236\u5b9a\u7684\u76f8\u540c\u6cd5\u5f8b\u7684\u7ea6\u675f\uff0c\u4f46\u7531\u533a\u57df\u653f\u5e9c\u7ba1\u7406\u3002\u533a\u57df\u4fdd\u62a4\u533a\u4e0d\u5206\u7c7b\u522b\uff0c\u4f46\u8fd9\u5e76\u4e0d\u610f\u5473\u7740\u5b83\u4eec\u7684\u4fdd\u62a4\u76ee\u6807\u90fd\u76f8\u540c\u3002", "a9bc94467236ca3514b0228d8b5803d6": "<strong>\u7f13\u51b2\u533a</strong>\u662f\u6bd7\u90bb\u81ea\u7136\u4fdd\u62a4\u533a (PA) \u7684\u5730\u533a\uff0c\u7531\u4e8e\u4ed6\u4eec\u7684\u7279\u6027\u548c\u4f4d\u7f6e\uff0c\u9700\u8981\u7279\u6b8a\u5bf9\u5f85\u6765\u4fdd\u8bc1\u5bf9\u4fdd\u62a4\u533a\u7684\u4fdd\u80b2\u3002\u7f13\u51b2\u533a\u5185\u7684\u6d3b\u52a8\u4e0d\u5f97\u5a01\u80c1\u4fdd\u62a4\u533a\u5185\u7684\u5bf9\u8c61\u3002\u6240\u6709\u7f13\u51b2\u533a\u5185\u81ea\u7136\u8d44\u6e90\u7684\u4f7f\u7528\u90fd\u5fc5\u987b\u7ecf\u8fc7 SERNANP \u7684\u9884\u5148\u5ba1\u6279\u3002", "7204ecc4ec348f2f31a8a23a20caf34e": "<strong>\u79c1\u4eba\u4fdd\u62a4\u533a</strong>\u662f\u90e8\u5206\u6216\u5168\u90e8\u5efa\u7acb\u5728\u79c1\u4eba\u8d22\u4ea7\u4e0a\u7684\u4fdd\u62a4\u533a\u3002\u8fd9\u7247\u571f\u5730\u7684\u73af\u5883\u3001\u751f\u7269\u6216\u98ce\u666f\u5c5e\u6027\u4e0e\u56fd\u5bb6\u4fdd\u62a4\u533a\u7684\u8986\u76d6\u8303\u56f4\u76f8\u8f85\u76f8\u6210\uff0c\u652f\u6301\u751f\u7269\u591a\u6837\u6027\u4fdd\u62a4\uff0c\u589e\u52a0\u4e86\u79d1\u5b66\u8003\u5bdf\u3001\u6559\u80b2\u548c\u65c5\u6e38\u7684\u673a\u4f1a\u3002\u5bf9\u79c1\u4eba\u4fdd\u62a4\u533a\u7684\u8ba4\u53ef\u57fa\u4e8e\u56fd\u5bb6\u4e0e\u571f\u5730\u6240\u6709\u8005\u4e4b\u95f4\u7684\u534f\u8bae\uff0c\u5176\u76ee\u6807\u662f\u5728\u53ef\u518d\u751f 10 \u5e74\u4ee5\u4e0a\u7684\u65f6\u95f4\u5185\u4fdd\u62a4\u751f\u7269\u591a\u6837\u6027\u3002", "eea99556e0efdcf277388eb6164b36f8": "\u7f13\u51b2\u533a", "24717e350989c65756a73e91682e7f19": "\u56fd\u5bb6\u4fdd\u62a4\u533a", "0e7a6c2073722fc63b9259d8f833eddd": "\u79c1\u4eba\u4fdd\u62a4\u533a", "37f16d804a4d358bd9966e1f27782539": "\u533a\u57df\u4fdd\u62a4\u533a", "36ea8e25bb4d178c4b89550d4df01453": "\u56fd\u9645\u9e1f\u76df (2020)\u3002\u5173\u952e\u751f\u7269\u591a\u6837\u6027\u5730\u533a\u7684\u6570\u5b57\u8fb9\u754c\uff0c\u7531\u4e16\u754c\u5173\u952e\u751f\u7269\u591a\u6837\u6027\u5730\u533a\u6570\u636e\u5e93\u63d0\u4f9b\u3002\u7531 KBA Partnership \u5f00\u53d1\uff0c\u5305\u62ec\u56fd\u9645\u9e1f\u76df\u3001\u56fd\u9645\u81ea\u7136\u4fdd\u62a4\u8054\u76df\u3001\u7f8e\u56fd\u9e1f\u7c7b\u4fdd\u62a4\u534f\u4f1a\u3001Amphibian Survival Alliance\u3001CI \u4fdd\u62a4\u56fd\u9645\u57fa\u91d1\u4f1a\u3001\u5173\u952e\u751f\u6001\u7cfb\u7edf\u5408\u4f5c\u57fa\u91d1\u3001\u5168\u7403\u73af\u5883\u57fa\u91d1\u3001\u4e16\u754c\u91ce\u751f\u52a8\u7269\u4fdd\u62a4\u534f\u4f1a\u3001NatureServe\u3001Rainforest Trust\u3001\u82f1\u56fd\u7687\u5bb6\u9e1f\u7c7b\u4fdd\u62a4\u534f\u4f1a\u3001\u91ce\u751f\u52a8\u7269\u4fdd\u62a4\u534f\u4f1a\u548c\u4e16\u754c\u81ea\u7136\u57fa\u91d1\u4f1a\u30022021 \u5e74 6 \u6708\u7248\u3002\u53ef\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">http://keybiodiversityareas.org/kba-data/request</a>\u83b7\u53d6\u3002", "5e79a20254a28ffdb604f6cba5216c75": "2021 \u5e74 3 \u6708", "f8f645633362561d5648781d38544d97": "\u5df4\u897f\u571f\u5730\u5229\u7528\u548c\u571f\u5730\u8986\u76d6", "52310f193fdcbd3c22e738fdb951741f": "\u6b64\u6570\u636e\u96c6\u663e\u793a\u4e86\u5df4\u897f2000\u5e74\u81f32016\u5e74\u7684\u5e74\u5ea6\u571f\u5730\u5229\u7528\u548c\u571f\u5730\u8986\u76d6\u60c5\u51b5", "ca4e9a484115cced01e265212c4961c9": "Collection 3.1\u7684\u4f30\u8ba1\u7cbe\u5ea6\u4ecd\u5728\u51c6\u5907\u4e2d\u3002\u8be5\u65b9\u6cd5\u7684\u66f4\u591a\u8be6\u60c5\u8bf7\u53c2\u89c1 MapBiomas.org[http://mapbiomas.org/]", "f8297de2153f09e8cc1a6d23550a51db": "MapBiomas\u662f\u4e00\u4e2a\u7531\u591a\u5bb6\u673a\u6784\u53d1\u8d77\u7684\u9879\u76ee\uff0c\u5b83\u5229\u7528\u8c37\u6b4c\u5730\u7403\u5f15\u64ce\u4e2d\u5e94\u7528\u4e8e\u536b\u661f\u56fe\u50cf\u7684\u81ea\u52a8\u5206\u7c7b\u8fc7\u7a0b\uff0c\u4e3a\u5df4\u897f\u6240\u6709\u5730\u533a\u751f\u6210\u5e74\u5ea6\u571f\u5730\u8986\u76d6\u548c\u571f\u5730\u4f7f\u7528\u5730\u56fe\u3002\u8d85\u8fc720\u4e2a\u7ec4\u7ec7\u662f\u8fd9\u4e2a\u9879\u76ee\u7684\u534f\u4f5c\u673a\u6784\u3002", "a3f71e479ead4ca92db99a8cf47a1be4": "MapBiomas\u95e8\u6237\u7f51\u7ad9\u63d0\u4f9b\u4e86\u571f\u5730\u8986\u76d6\u548c\u571f\u5730\u4f7f\u7528\u53d8\u5316\u7684\u5730\u56fe\u548c\u7edf\u8ba1\u6570\u636e\u3002\u6240\u6709\u6570\u636e\u90fd\u53ef\u4ee5\u5728\u9879\u76ee\u7f51\u7ad9\u4e0a\u4e0b\u8f7d\uff0c\u5730\u56fe\u4e5f\u53ef\u4ee5\u4f5c\u4e3a\u8d44\u4ea7\u76f4\u63a5\u5728\u8c37\u6b4c\u5730\u7403\u5f15\u64ce\u5e73\u53f0\u4e0a\u4f7f\u7528\u3002", "e0c5743d1ffe1755dace613659cb1889": "\u5df4\u897f\u571f\u5730\u8986\u76d6", "fb3c3bad8226fc79d419dcbe03d6531c": "\u7267\u8349\u5730", "860b0b54726ce554a32511d0f0d5b2fa": "\u5b8f\u90fd\u62c9\u65af\u68ee\u6797\u7c7b\u578b", "175578d10124dc04173c91409a8ebb07": "\u8fd9\u4e2a\u6570\u636e\u96c6\u5c55\u793a\u4e86\u5df4\u897f6\u4e2a\u5927\u9646\u751f\u7269\u7fa4\u843d\u7684\u8fb9\u754c\uff0c\u5305\u62ec\u4e9a\u9a6c\u5b59\u7fa4\u843d\u3001\u559c\u62c9\u591a\u7fa4\u843d\u3001\u5361\u5ef7\u52a0\u7fa4\u843d\u3001\u5927\u897f\u6d0b\u68ee\u6797\u7fa4\u843d\u3001\u6f58\u5854\u7eb3\u5c14\u7fa4\u843d\u548c\u5357\u7f8e\u5927\u8349\u539f\u7fa4\u843d\u3002\u201d\u751f\u7269\u7fa4\u843d\u201c\u88ab\u5b9a\u4e49\u4e3a\u751f\u547d\uff08\u52a8\u7269\u548c\u690d\u7269\uff09\u7684\u96c6\u5408\uff0c\u8be5\u96c6\u5408\u7531\u533a\u57df\u6027\u8303\u56f4\u5185\u7684\u8fde\u7eed\u53ef\u8fa8\u8ba4\u7684\u690d\u88ab\u7c7b\u578b\u6784\u6210\uff0c\u8fd9\u4e9b\u690d\u88ab\u5177\u6709\u76f8\u4f3c\u5730\u7406\u6761\u4ef6\u548c\u5171\u540c\u5386\u53f2\uff0c\u8fd9\u6837\u7684\u6761\u4ef6\u5bfc\u81f4\u4e86\u72ec\u7279\u7684\u751f\u7269\u591a\u6837\u6027\u7684\u4ea7\u751f\u3002\u4f7f\u7528\u7684\u540d\u79f0\u901a\u5e38\u662f\u6700\u666e\u904d\u7684\uff0c\u5e76\u4e0e\u4e3b\u8981\u7684\u690d\u88ab\u7c7b\u578b\u6709\u6240\u8054\u7cfb\u3002\u4f8b\u5982\u6f58\u5854\u7eb3\u5c14\u7fa4\u843d\uff0c\u5b83\u662f\u4e16\u754c\u6700\u9ad8\u7684\u7701\u7ea7\u704c\u6c34\u5730\u8868\u3002", "2d480b4f34f25bdd0538ae0267d50daf": "\u4e9a\u9a6c\u900a\u751f\u7269\u7fa4\u843d\u7531\u6c14\u5019\u533a\u3001\u6797\u76f8\u548c\u5730\u7406\u4f4d\u7f6e\u754c\u5b9a\u3002\u5927\u897f\u6d0b\u68ee\u6797\u751f\u7269\u7fa4\u843d\u5360\u636e\u6574\u4e2a\u5df4\u897f\u5927\u9646\u4e1c\u5927\u897f\u6d0b\u4e1c\u5cb8\uff0c\u5e76\u5ef6\u4f38\u81f3\u4e1c\u5357\u90e8\u548c\u5357\u90e8\u5185\u9646\uff0c\u7531\u4e3b\u8981\u68ee\u6797\u690d\u88ab\u548c\u591a\u6837\u5730\u8c8c\u754c\u5b9a\u3002\u5f6d\u5df4\u8349\u539f\u4ec5\u9650\u4e8e\u5357\u91cc\u5965\u683c\u5170\u5fb7\u5dde\uff0c\u7531\u5e73\u539f\u5730\u8c8c\u4e0a\u7684\u4e00\u7ec4\u7530\u5730\u690d\u88ab\u754c\u5b9a\u3002\u585e\u62c9\u591a\u751f\u7269\u7fa4\u843d\u662f\u5df4\u897f\u7b2c\u4e8c\u5927\u7fa4\u843d\uff0c\u5176\u4e3b\u8981\u690d\u88ab\u4ece\u9a6c\u62c9\u5c3c\u6602\u5dde\u6d77\u5cb8\u4e00\u76f4\u5ef6\u4f38\u5230\u4e2d\u897f\u90e8\uff0c\u5361\u4e01\u52a0\u751f\u7269\u7fa4\u843d\u7684\u5178\u578b\u7279\u8272\u662f\u4e1c\u5317\u8179\u5730\u7684\u534a\u5e72\u65f1\u6c14\u5019\u3002\u5730\u56fe\u662f\u5df4\u897f\u73af\u5883\u90e8 (MMA) \u4e0e\u5df4\u897f\u5730\u7406\u548c\u7edf\u8ba1\u7814\u7a76\u6240 (IBGE) \u7684\u5408\u4f5c\u6210\u679c\u3002", "f66585a95e7288c4628e587137ff1ab8": "\u5df4\u897f\u5927\u9646", "3e84c5740a1ab87ee67fa367b3e1a4e6": "\u663e\u793a 6 \u4e2a\u5df4\u897f\u5927\u9646\u751f\u7269\u7fa4\u843d\u7684\u8fb9\u754c\u2014\u2014\u4e9a\u9a6c\u900a\u96e8\u6797\u3001\u70ed\u5e26\u9ad8\u8349\u8349\u539f\u3001\u6d45\u8272\u65f1\u70ed\u843d\u53f6\u77ee\u704c\u6728\u6797\u3001\u5927\u897f\u6d0b\u6cbf\u6d77\u68ee\u6797\u3001\u6f58\u5854\u7eb3\u5c14\u6e7f\u5730\u548c\u5f6d\u5df4\u8349\u539f", "93c93493bf6db18cbb67af71b313591c": "\u663e\u793a\u5df4\u897f\u5927\u9646\u516d\u4e2a\u751f\u7269\u7fa4\u843d\uff08Amaz\u00f4nia\u3001Cerrado\u3001Caatinga\u3001Mata Atl\u00e2ntica\u3001Pantanal\u548cPampa\uff09\u7684\u8fb9\u754c\u3002", "646520154978cf4d51b89a81d7bf9c5a": "\u6b64\u6570\u636e\u96c6\u663e\u793a\u5df4\u897f\u4ece1985\u5e74\u52302017\u5e74\u7684\u5e74\u5ea6\u571f\u5730\u4f7f\u7528\u548c\u571f\u5730\u8986\u76d6\u60c5\u51b5\u3002", "641f0880a89dc3902b7ec4a7942ce2ad": "<strong>\u5df4\u897f</strong>\u6ca1\u6709\u6c14\u5019\u6570\u636e\u96c6\u3002", "27d737daf525e330080946495f45d2dd": "\u65e0<strong>\u5df4\u897f</strong>\u7684\u751f\u7269\u591a\u6837\u6027\u6570\u636e\u96c6\u53ef\u7528\u3002", "e4e19af9108942d1d86ead511216a677": "\u672c\u6570\u636e\u663e\u793a\u67ec\u57d4\u5be8\u7528\u4e8e\u519c\u4e1a\u4ea7\u4e1a\u5316\u7684\u5df2\u77e5\u7ecf\u6d4e\u7528\u5730\u7279\u8bb8\u6743 (ELCs) \u7684\u4f4d\u7f6e", "47b24513ea9b9e95c97ed493e93b7eb2": "\u786e\u5b9a\u6d2a\u90fd\u62c9\u65af\u68ee\u6797\u7c7b\u578b\u548c\u571f\u5730\u8986\u76d6\u60c5\u51b5", "51dfe3d143139df137b90cb16acbe661": "5 \u00d7 5 \u7c73", "11154944cc328b5bf74b1d96c55f4959": "\u5730\u56fe\u7684\u786e\u8ba4\u662f\u901a\u8fc7\u5b9e\u5730\u6570\u636e\u4ee5\u53ca\u901a\u8fc7\u904d\u5e03\u5168\u56fd\u7684\u6bcf\u9694 3 \u516c\u91cc\u8bbe\u7f6e\u7684\u4e00\u4e2a\u65b9\u683c\u4e2d\u7684\u63a7\u5236\u70b9\uff08\u603b\u5171 15,777 \u4e2a\u70b9\uff09\u6765\u5b8c\u6210\u7684\u3002\u5730\u56fe\u5728 26 \u4e2a\u79cd\u7c7b\u4e2d\u603b\u4f53\u7684\u7cbe\u786e\u5ea6\u786e\u5b9a\u4e3a 90.9%\uff0c\u5176\u4e2d\u516b\u4e2a\u68ee\u6797\u7c7b\u522b\u7684\u7cbe\u786e\u5ea6\u4e3a 95%\u3002", "475875183b9d4facbd70854468dd94cc": "\u6b64\u57fa\u7840\u5730\u56fe\u7684\u884c\u653f\u8fb9\u754c\u6765\u81ea\u4e8e\u5f00\u653e\u8857\u9053\u5730\u56fe\uff0c\u5e76\u4e14\u5728\u6b64\u5730\u56fe\u4e0a\u53ea\u7528\u4e8e\u548c\u5176\u5b83\u5c42\u8fdb\u884c\u534f\u8c03\u3002", "6fb88137ebeed71de599f3a38524682c": "\u4e0e\u6d2a\u90fd\u62c9\u65af\u7684\u65e9\u671f\u68ee\u6797\u5730\u56fe\u76f8\u53cd\uff0c\u8be5\u7248\u672c\u6269\u5c55\u5230\u5176\u4ed6\u7c7b\u522b\u7684\u6797\u5730\u690d\u88ab\uff0c\u5305\u62ec\u6b21\u751f\u690d\u88ab\u3001\u5496\u5561\u548c\u519c\u6797\u4e1a\u533a\u57df\uff0c\u4ee5\u53ca\u68ee\u6797\u4e4b\u5916\u7684\u6811\u6728\u3002\u7267\u573a\u548c\u519c\u7530\u4e5f\u88ab\u6c47\u603b\u6210 1 \u7c7b\uff0c\u5305\u62ec\u7b2c\u4e8c\u5927\u571f\u5730\u8986\u76d6\u7c7b\u3002", "d116fdaf742505f2ce184fb2f4c32d40": "\u786e\u5b9a\u6d2a\u90fd\u62c9\u65af\u7684\u68ee\u6797\u7c7b\u578b\u548c\u571f\u5730\u8986\u76d6\u3002", "faf4d364783571ee35b13fb67f84524a": "\u5370\u5ea6\u5c3c\u897f\u4e9a\u571f\u5730\u8986\u76d6", "b29daf604a7ffdfb033688c9e6a03260": "\u5370\u5ea6\u5c3c\u897f\u4e9a\u6ce5\u70ad\u7530", "a85f2bf9159da6d492f53657d41eef1a": "\u5370\u5ea6\u5c3c\u897f\u4e9a\u571f\u5730\u8986\u76d6\u7684\u5b98\u65b9\u6570\u636e\u3002", "ce1656f6c35885ace170c8b04f46bd0f": "\u4eba\u5de5\u6797", "a2b7f64503da01f3b2082c4855b38524": "\u663e\u793a\u5370\u5ea6\u5c3c\u897f\u4e9a\u7684\u6ce5\u70ad\u5730", "8e5882ec4ac1e5201948154cf735fa98": "\u6b64\u56fe\u5c42\u663e\u793a\u5370\u5ea6\u5c3c\u897f\u4e9a\u6ce5\u70ad\u7530\u3002\u519c\u4e1a\u90e8\u62e5\u6709\u53ef\u7528\u7684\u6570\u5b57\u5730\u56fe\u3002\u6b64\u6570\u636e\u96c6\u7531\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240\u5236\u4f5c\u3002", "cb4c021b2ced3dc60f36709a024a2784": "\u663e\u793a\u5370\u5ea6\u5c3c\u897f\u4e9a\u7684\u6ce5\u70ad\u5730\u3002", "39630d69f7134a911786054381bf605c": "\u6ca1\u6709<strong>\u5370\u5ea6\u5c3c\u897f\u4e9a</strong>\u751f\u7269\u591a\u6837\u6027\u7684\u6570\u636e\u96c6\u3002", "b792437da17d4b9792bb60455c1939b8": "\u5370\u5c3c\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf", "072d0eed752ead8589cfca654d761d5c": "\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf\u662f\u4e00\u4e2a\u9488\u5bf9\u73af\u5883\u4fdd\u62a4\u529f\u80fd\u7684\u56fd\u5bb6\u6218\u7565\u533a\u57df\uff0c\u663e\u793a\u5b83\u7684\u8fb9\u754c\u3002", "0347e4bf336bb5c31c3f30b34bbc48c3": "\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf", "219905cd91300a8ffab146ef1e621fa7": "2013 \u5e74 11 \u6708 19 \u65e5", "12507f0621c0764056df442e6361cd2f": "\u8be5\u6570\u636e\u4e0d\u662f\u5370\u5ea6\u5c3c\u897f\u4e9a\u73af\u5883\u4e0e\u6797\u4e1a\u90e8\u95e8\u7684\u5b98\u65b9\u6570\u636e\u3002\u6240\u4ee5\uff0c\u8be5\u6570\u636e\u53ef\u80fd\u4e0e\u5b98\u65b9\u6570\u636e\u6709\u6240\u4e0d\u540c\uff0c\u5e76\u53ef\u80fd\u5b58\u5728\u8bef\u5dee\u3002", "911eb7e263c2b3f872752061ea2c470c": "\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf\u6a2a\u8de8\u5370\u5ea6\u5c3c\u897f\u4e9a\u82cf\u95e8\u7b54\u814a\u5c9b\u4e0a\u7684\u4e9a\u9f50\u7279\u533a\u548c\u5317\u82cf\u95e8\u8fbe\u814a\u7701\u3002\u8fd9\u7247\u5e7f\u9614\u800c\u53e4\u8001\u7684\u751f\u6001\u7cfb\u7edf\u8986\u76d6\u4e86\u8d85\u8fc7 260 \u4e07\u516c\u9877\u7684\u533a\u57df\uff0c\u9762\u79ef\u8d85\u8fc7\u65b0\u52a0\u5761\u7684 35 \u500d\uff0c\u6709\u4f4e\u5730\u96e8\u6797\u3001\u6ce5\u70ad\u6cbc\u6cfd\u68ee\u6797\u3001\u9ad8\u5c71\u3001\u6d77\u5cb8\u68ee\u6797\u4ee5\u53ca\u9ad8\u5c71\u8349\u7538\u3002\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf\u88ab\u516c\u8ba4\u4e3a\u4e1c\u5357\u4e9a\u6700\u4e30\u5bcc\u7684\u70ed\u5e26\u96e8\u6797\u4e4b\u4e00\uff0c\u5e76\u4e14\u662f\u4e9a\u6d32\u6700\u5927\u7684\u78b3\u6c47\u6797\u4e4b\u4e00\u3002\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf\u662f\u5730\u7403\u4e0a\u6700\u540e\u4e00\u4e2a\u6709\u7329\u7329\u3001\u7280\u725b\u3001\u5927\u8c61\u548c\u8001\u864e\u5728\u91ce\u5916\u5171\u540c\u751f\u5b58\u7684\u5730\u65b9\u3002\u8fd9\u56db\u4e2a\u7269\u79cd\u73b0\u5728\u90fd\u5df2\u88ab\u4e16\u754c\u81ea\u7136\u4fdd\u62a4\u8054\u76df (IUCN) \u5212\u5206\u4e3a\u6781\u5ea6\u6fd2\u5371\u7269\u79cd\u3002\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf\u662f\u82cf\u95e8\u7b54\u814a\u4ec5\u5b58\u7684\u80fd\u591f\u4f9b\u517b\u8fd9\u4e9b\u7269\u79cd\u7684\u53ef\u5b58\u6d3b\u65cf\u7fa4\u91cf\u7684\u6816\u606f\u5730\u3002\u56fd\u9645\u5b66\u672f\u9886\u5bfc\u671f\u520a\u300a\u79d1\u5b66\u300b\u4e0a\u7684\u4e00\u7bc7\u6587\u7ae0\u5c06\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf\u5217\u4e3a\u201c\u4e16\u754c\u4e0a\u6700\u4e0d\u53ef\u66ff\u4ee3\u7684\u5730\u533a\u4e4b\u4e00\u201d\u3002", "26f81eca0e3fcdc578c2827656c6aa8d": "\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf (Leuser Ecosystem) \u662f\u5370\u5c3c\u4e9a\u9f50\u7701\u7ecf\u6d4e\u53d1\u5c55\u7684\u91cd\u8981\u8d22\u5bcc\uff0c\u6bcf\u5e74\u81f3\u5c11\u8d21\u732e 3.5 \u4ebf\u7f8e\u5143\u7ecf\u6d4e\u4ef7\u503c\u3002\u5bf9\u4e8e\u4e9a\u9f50\u7701\u7ea6 4 \u767e\u4e07\u4eba\u53e3\u6765\u8bf4\uff0c\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf\u5c31\u50cf\u4e00\u4e2a\u751f\u547d\u4fdd\u969c\u7cfb\u7edf\u3002\u751f\u6001\u7cfb\u7edf\u670d\u52a1\u4e3b\u8981\u5305\u62ec\u6de1\u6c34\u4f9b\u5e94\u548c\u707e\u5bb3\u7f13\u89e3\u3002\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf\u7684\u68ee\u6797\u5c31\u50cf\u4e00\u5757\u6d77\u7ef5\uff0c\u5438\u6536\u96e8\u5b63\u7684\u5927\u96e8\uff0c\u5e76\u4f7f\u96e8\u6c34\u5728\u51e0\u4e2a\u6708\u5185\u66f4\u5747\u5300\u5730\u5411\u4e0b\u6e38\u5206\u6d41\u3002\u5728\u8fd9\u4e00\u73af\u5883\u654f\u611f\u5730\u533a\u8fdb\u884c\u6ee5\u4f10\u4f1a\u5e26\u6765\u4e25\u91cd\u540e\u679c\uff0c\u4e0d\u4ec5\u52a0\u5267\u6d2a\u707e\u548c\u5c71\u4f53\u6ed1\u5761\u7684\u7834\u574f\u7a0b\u5ea6\uff0c\u800c\u4e14\u9020\u6210\u793e\u533a\u548c\u4e0b\u6e38\u4ea7\u4e1a\u7684\u7ecf\u6d4e\u635f\u5931\u3002\u4e0d\u7ba1\u662f\u4ece\u5c40\u90e8\uff0c\u8fd8\u662f\u4ece\u5168\u7403\u6765\u770b\uff0c\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf\u90fd\u6709\u7740\u5de8\u5927\u7684\u73af\u5883\u4ef7\u503c\uff0c\u56e0\u4e3a\u5b83\u5728\u6c14\u5019\u8c03\u8282\u548c\u78b3\u50a8\u5b58\u65b9\u9762\u8d77\u7740\u975e\u5e38\u91cd\u8981\u7684\u4f5c\u7528\u3002\u65e9\u5728 19 \u4e16\u7eaa\uff0c\u4eba\u4eec\u5c31\u5f00\u59cb\u81f4\u529b\u4e8e\u5bf9\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf\u7684\u4fdd\u80b2\u5de5\u4f5c\uff0c\u90a3\u65f6\uff0c\u4f20\u7edf\u7684\u4e9a\u9f50\u7701\u9886\u5bfc\u4eba\u5411\u6b96\u6c11\u653f\u5e9c\u6e38\u8bf4\uff0c\u8bf7\u6c42\u4ed6\u4eec\u4fdd\u62a4\u8fd9\u7247\u4ece\u7fa4\u5c71\u7ef5\u5ef6\u81f3\u6d77\u5cb8\u7684\u81ea\u7136\u9057\u4ea7\u3002\u8ddd\u4eca\u66f4\u8fd1\u7684\u6cd5\u5f8b\u8d77\u5230\u4e86\u4fdd\u62a4\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf\u548c\u8d23\u4ee4\u4e9a\u9f50\u7701\u653f\u5e9c\u7ba1\u7406\u5176\u4fdd\u62a4\u548c\u4fee\u590d\u5de5\u4f5c\u7684\u4f5c\u7528\uff082006 \u5e74 11 \u53f7\u300a\u6cbb\u7406\u4e9a\u9f50\u7701\u7684\u56fd\u5bb6\u6cd5\u6848\u300b\u7b2c150\u6761\uff09\u3002\u6b64\u5916\uff0c\u4e9a\u9f50\u7701\u7684\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf\u51ed\u501f\u5176\u91cd\u8981\u7684\u73af\u5883\u4fdd\u62a4\u529f\u80fd\u800c\u6210\u4e3a\u56fd\u5bb6\u7ea7\u6218\u7565\u533a\u57df\uff082007 \u5e74 26 \u53f7\u4ee5\u53ca 2008 \u5e74 26 \u53f7\uff09\uff0c\u6709\u7740\u7279\u6b8a\u7684\u6cd5\u5f8b\u5730\u4f4d\uff0c\u7981\u6b62\u4e00\u5207\u6709\u788d\u73af\u4fdd\u7684\u6d3b\u52a8\uff0c\u5305\u62ec\u8015\u4f5c\u548c\u57fa\u7840\u8bbe\u65bd\u5efa\u8bbe\u3002", "4338cfcc7a2d94f1dd7943ad50ba2772": "\u5370\u5ea6\u5c3c\u897f\u4e9a\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf", "ac927a797f3788a9f95a6fd7721b6a58": "\u5370\u5ea6\u5c3c\u897f\u4e9a\u68ee\u6797\u9762\u79ef", "8212c144bce63ef08d4d79f016296804": "\u786e\u5b9a2000\u5e74\u5370\u5ea6\u5c3c\u897f\u4e9a\u5883\u5185\u672a\u53d7\u4fb5\u6270\u539f\u59cb\u6797\u548c\u9000\u5316\u539f\u59cb\u6797\u7684\u4f4d\u7f6e\u3002", "cdec770bb844a694301d8c0db0bef72f": "\u5370\u5ea6\u5c3c\u897f\u4e9a\u68ee\u6797\u5f00\u91c7\u7981\u4ee4", "1aaa2c5131fed6961d7da77a3ba49c0b": "\u6807\u8bc6\u4e86\u5370\u5c3c\u6682\u505c\u65b0\u7684\u68ee\u6797\u7279\u8bb8\u6743\u7684\u533a\u57df\uff0c\u65e8\u5728\u4fdd\u62a4\u5370\u5ea6\u5c3c\u897f\u4e9a\u7684\u6ce5\u70ad\u5730\u548c\u4e3b\u8981\u7684\u5929\u7136\u68ee\u6797\u514d\u53d7\u5f00\u53d1", "eff765e7aba65e707a3d1a34e300a112": "\u8868\u793a\u5370\u5ea6\u5c3c\u897f\u4e9a\u6682\u505c\u65b0\u68ee\u6797\u7279\u8bb8\u6743\u7684\u7981\u4ee4\u8303\u56f4\uff0c\u5176\u76ee\u7684\u662f\u4fdd\u62a4\u5370\u5ea6\u5c3c\u897f\u4e9a\u7684\u6ce5\u70ad\u5730\u548c\u539f\u59cb\u5929\u7136\u6797\u4e0d\u53d7\u672a\u6765\u53d1\u5c55\u7684\u5f71\u54cd\u3002", "1de519a2ec1e35cb75a55e135ce1f9ce": "\u5229\u6bd4\u91cc\u4e9a\u77ff\u4ea7\u52d8\u63a2\u8bb8\u53ef\u8bc1", "b594feca7df680cd726a3d554a5040f9": "\u5df2\u63d0\u8bae\u7684", "6486712fdb9df02936831391f504cec9": "\u5229\u6bd4\u91cc\u4e9a\u77ff\u4ea7\u5f00\u53d1\u534f\u5b9a", "74dc4c86547b4690c31beacd5485ffb9": "\u5229\u6bd4\u4e9a\u5f00\u53d1\u52d8\u63a2\u8bb8\u53ef\u8bc1", "0b475533d614aa840491ff842aa8cd49": "\u6c99\u635e\u8d8a\u68ee\u6797\u7279\u8bb8\u5f00\u91c7\u6743", "5e3575ac25c2655becfb2e7566b20c6e": "\u663e\u793a\u7802\u62c9\u8d8a\u68ee\u6797\u6728\u6750\u8bb8\u53ef\u8bc1\uff08\u91c7\u4f10\u7279\u8bb8\u6743\uff09\u7684\u5206\u5e03", "5f9bafa504fe14f51c03e0e32327d760": "\u9a6c\u6765\u897f\u4e9a\u7802\u62c9\u8d8a", "00b1286334721de4b3034138de24677a": "\u8fd9\u5f20\u5730\u56fe\u88ab\u8ba4\u4e3a\u662f\u4e0d\u5b8c\u6574\u7684\uff0c\u5b83\u7684\u521b\u5efa\u6765\u81ea\u5404\u79cd\u6765\u6e90\uff0c\u5305\u62ec\u73af\u5883\u5f71\u54cd\u8bc4\u4f30\uff08EIAs\uff09\u548c\u56fd\u5bb6\u6797\u4e1a\u90e8\uff08SFD\uff092010 \u5e74\u5730\u56fe\u3002", "1e34e142443e850c616bd5e4fdfd736d": "\u663e\u793a\u7802\u52b3\u8d8a\u4eba\u5de5\u6797\uff08\u4e00\u822c\u4e3a\u6210\u6750\u6728\uff09\u7684\u8bb8\u53ef\u8bc1\u5206\u5e03\u60c5\u51b5\u3002", "597a897919108e6145c3991160c871d0": "\u8fd9\u5f20\u5730\u56fe\u521b\u5efa\u81ea\u4e24\u5f20\u56fd\u5bb6\u6797\u4e1a\u90e8\u95e8 (SFD) 2010 \u5730\u56fe\uff0c\u8f85\u4ee5\u7279\u5b9a\u7684\u83b7\u8bb8\u53ef\u7684\u4eba\u518d\u4f10\u7684\u73af\u5883\u5f71\u54cd\u8bc4\u4f30 (EIA) \u4fe1\u606f\u3002\u90a3\u4e9b\u73b0\u6709\u7684 SFD \u5730\u56fe\u91cc\u8fd8\u6ca1\u6709\u8bc6\u522b\u7684\u5730\u533a\uff0c\u90a3\u4e9b\u548c\u4e2a\u4eba\u7f16\u53f7\u7684\u8bb8\u53ef\u8bc1\u76f8\u5173\u7684\u83b7\u8bb8\u53ef\u4eba\u7684\u540d\u5b57\uff08\u53ef\u80fd\u7684\u5730\u65b9\uff09\u5df2\u7ecf\u4ece\u516c\u53f8\u6587\u4ef6\u548c EIA \u7684\u533a\u57df\u9e1f\u77b0\u56fe\u4e2d\u5f97\u5230\u3002", "1f0875601edfe52ca9b0b5762bf68974": "\u5141\u8bb8\u53d1\u5e03\u65e5\u671f\u548c\u5b98\u65b9\u5730\u533a\uff08\u516c\u9877\uff09\u6765\u81ea\u5404\u79cd\u6765\u6e90\uff0c\u5305\u62ec EIA\u3002\u6839\u636e\u5404\u79cd\u6765\u6e90\uff08\u5305\u62ec EIA \u548c\u5b98\u65b9\u516c\u53f8\u6587\u4ef6\uff09\u786e\u5b9a\u5355\u72ec\u7684\u8bb8\u53ef\u8bc1\u516c\u53f8\u5c5e\u4e8e\u54ea\u4e9b\u4f01\u4e1a\u96c6\u56e2\u3002", "ecb12986ce0c1d2f92612fc3c25e546b": "\u8fd9\u4efd\u5730\u56fe\u4e0d\u5305\u62ec\u7802\u62c9\u8d8a\u5dde\u897f\u90e8\u7684\u6cd7\u91cc\u8857\u3001\u6728\u4e2d\u3001\u8bd7\u91cc\u963f\u66fc\u3001\u4e09\u9a6c\u62c9\u6c49\u548c\u53e4\u664b\u7701\u7684\u6728\u6750\u8bb8\u53ef\u8bc1\uff0c\u5c3d\u7ba1\u636e\u77e5\u8fd9\u4e9b\u7701\u9c9c\u6709\u8be5\u7c7b\u8bb8\u53ef\u8bc1\u3002\u8be5\u5730\u56fe\u4e0a\u663e\u793a\u7684\u8bb8\u53ef\u8bc1\u53ef\u80fd\u5df2\u8fc7\u671f\uff0c\u6216\u81ea 2010 \u5e74\u5df2\u53d1\u751f\u4fee\u8ba2\uff1b\u4e5f\u53ef\u80fd\u5df2\u4ea7\u751f\u6b64\u5904\u672a\u663e\u793a\u7684\u5176\u4ed6\u65b0\u8bb8\u53ef\u8bc1\u3002\u4e2a\u522b\u8bb8\u53ef\u8bc1\u53ef\u80fd\u5df2\u52a0\u5165\u6216\u8131\u79bb\u8be5\u6307\u5b9a\u516c\u53f8\u56e2\u4f53\u3002\u8fd9\u4efd\u5730\u56fe\u4e5f\u4e0d\u5305\u62ec\u201c\u5764\u7538\u6728\u6750\u201d\u8bb8\u53ef\u8bc1\u3002", "3ceb831200cdb605e316ca4560f1a16f": "\u4e00\u4e9b\u4f10\u6728\u8bb8\u53ef\u88ab\u5206\u6563\u5728\u4e0d\u8fde\u7eed\u533a\u57df\u3002\u5728\u67d0\u4e9b\u60c5\u51b5\u4e0b\u6bcf\u4e2a\u90e8\u5206\u90fd\u6709\u5355\u72ec\u7684\u8fb9\u754c\u6761\u76ee\uff1b\u5e76\u5728\u6807\u9898\u4e2d\u6ce8\u660e\u201c\u7b2c\u4e00\u90e8\u5206\u201d\u3002\u201c\u7b2c\u51e0\u90e8\u5206\u201d\u5e76\u975e\u5b98\u65b9\u540d\u79f0\uff0c\u800c\u662f\u4e00\u79cd GIS \u7528\u4e8e\u6574\u7406\u6570\u636e\u7684\u547d\u540d\u89c4\u8303\u3002", "c161afdb20d8d8c2ddfe869d06db23ae": "\u663e\u793a\u6c99\u635e\u8d8a\u68ee\u6797\u6728\u6750\u8bb8\u53ef\u8bc1\uff08\u4f10\u6728\u7279\u8bb8\u6743\uff09\u7684\u5206\u5e03\u60c5\u51b5\u3002", "b8695afbf813704d78311b08088eda46": "\u6c99\u635e\u8d8a\u68d5\u6988\u7279\u8bb8\u6743", "fd61a04c3d0624435944395991cce50a": "\u8bb8\u591a\u6cb9\u68d5\u5730\u7279\u8bb8\u7ecf\u8425\u6743\u88ab\u5206\u6210\u591a\u4e2a\u4e0d\u8fde\u7eed\u7684\u90e8\u5206\u3002\u5728\u4e00\u4e9b\u60c5\u51b5\u4e0b\uff0c\u6bcf\u4e2a\u90e8\u5206\u90fd\u6709\u7ed9\u51fa\u5355\u72ec\u7684\u6709\u5173\u8fb9\u754c\u7684\u6761\u76ee; \u5e76\u5728\u6807\u9898\u4e2d\u4f9d\u6b21\u6ce8\u91ca\u4e3a\u201c\u7b2c 1 \u90e8\u5206\u201d\u201c\u7b2c 2 \u90e8\u5206\u201d\u7b49\u3002\u8fd9\u4e9b\u201c\u90e8\u5206\u201d\u5e76\u975e\u5b98\u65b9\u540d\u79f0\uff0c\u800c\u662f\u5730\u7406\u4fe1\u606f\u7cfb\u7edf\uff08GIS\uff09\u5728\u6e05\u7406\u6570\u636e\u65f6\u4f7f\u7528\u7684\u7ea6\u5b9a\u547d\u540d\u3002", "73702b794571672a3290f5a2e94655d5": "\u663e\u793a\u6c99\u635e\u8d8a\u5730\u533a\u6cb9\u68d5\u7279\u8bb8\u7528\u5730\u7684\u8986\u76d6\u8303\u56f4\uff08\u82e5\u6709\u76f8\u5173\u4fe1\u606f\u7684\u8bdd\uff09\u3002", "d4f4565c83b0a5cec4321ca438415f0b": "\u6c99\u635e\u8d8a\u4eba\u5de5\u6797\u8bb8\u53ef\u8bc1 (LPFS)", "009de6e236dbfb9a1f4ed121708b9974": "\u7802\u62c9\u8d8a\u4eba\u5de5\u6797\u8bb8\u53ef\u8bc1\uff08LPFs\uff09", "ca0091c80dbfc96049a0a75d49985c70": "\u663e\u793a\u7802\u62c9\u8d8a\u79cd\u690d\u68ee\u6797\u8bb8\u53ef\u8bc1\u7684\u5206\u5e03\uff08\u4e00\u822c\u662f\u6728\u6750\u6811\uff09", "001db194be2f86a18ef7031f7a24939d": "2011\u5e741\u6708\u540e\u53d1\u51fa\u7684\u7528\u6750\u6797\u8bb8\u53ef\u8bc1\u4e0d\u5305\u62ec\u5728\u8be5\u5730\u56fe\u4e0a\u3002\u5176\u4e2d\u5305\u62ec\u8bb8\u53ef\u8bc1\u548c\u754c\u9650\u81ea\u8be5\u65e5\u8d77\u4e5f\u53ef\u80fd\u5df2\u88ab\u53d6\u6d88\u6216\u8fdb\u884c\u4e86\u4fee\u6539\u3002\u4e2a\u522b\u6301\u724c\u4eba\u7684\u6240\u6709\u6743\u4e5f\u53ef\u4ee5\u81ea\u5f97\u5230\u6b64\u79cd\u5206\u5e03\u4fe1\u606f\u540e\u53d1\u751f\u53d8\u5316\u3002\u5b98\u65b9\u603b\u9762\u79ef\u548c\u9002\u5b9c\u79cd\u690d\u5730\u533a\u4e5f\u53ef\u80fd\u6709\u53d8\u5316\u3002", "58c261205bd25a84210a429ddf81c0ba": "\u6b64\u6570\u636e\u96c6\u63d0\u4f9b\u4e86\u9a6c\u6765\u897f\u4e9a\u7802\u62c9\u8d8a\u5185\u5df2\u77e5\u7684\u4eba\u5de5\u6797\u8bb8\u53ef\u8bc1\uff08LPFs\uff09\u7684\u8fb9\u754c\u3002LPFs \u7684\u6700\u9ad8\u671f\u9650\u662f 60 \u5e74\uff0c\u800c\u4e14\u9762\u79ef\u5fc5\u987b\u5927\u4e8e 1,000 \u516c\u9877\u3002\u5c3d\u7ba1\u5b83\u4eec\u7684\u8bbe\u8ba1\u76ee\u7684\u662f\u79cd\u690d\u6210\u6750\u6728\uff08\u5927\u90e8\u5206\u662f\u5408\u6b22\u6811\uff09\uff0c\u8bb8\u53ef\u4eba\u4e5f\u53ef\u4ee5\u5728\u4ed6\u4eec\u7684\u8bb8\u53ef\u533a\u57df\u5185\u5355\u4e00\u5faa\u73af\u79cd\u690d\u4e00\u90e8\u5206\u6cb9\u68d5\u3002", "6f2e762572b1b646bae7f1a811734325": "\u672c\u6570\u636e\u96c6\u7ed3\u5408\u4e86\u622a\u81f3 2011 \u5e74 1 \u6708 11 \u65e5\u53d1\u5e03\u7684 LPF \u8fb9\u754c\uff0c\u5e76\u4e14\u88ab\u5305\u542b\u5728 2011 \u5e74 1 \u6708 11 \u65e5\u516c\u5e03\u7684\u7802\u62c9\u8d8a\u6797\u4e1a\u90e8 (SFD) LPF \u5730\u56fe\u4e0a\u3002\u7cbe\u786e\u8fb9\u754c\u6765\u6e90\u4e8e 2010 \u5e74\u7684 SFD \u539f\u59cb\u5730\u56fe\u4ee5\u53ca\u9488\u5bf9\u4e2a\u4eba\u7279\u8bb8\u6743\u7684\u73af\u5883\u5f71\u54cd\u8bc4\u4f30 (EIA) \u62a5\u544a\u3002", "e6ca6964abf0bb5c99cc1d67090dbf48": "\u57fa\u4e8e\u5df2\u516c\u5f00\u53d1\u5e03\u7684\u516c\u53f8\u8bb0\u5f55\u548c\u53c2\u8003\u8d44\u6599\uff0c\u5927\u578b\u4f01\u4e1a\u96c6\u56e2\u88ab\u6388\u4e88\u8bb8\u53ef\u8bc1\uff08\u53ca\u8bb8\u53ef\u8bc1\u9644\u4ef6\uff09\u3002\u8bb8\u53ef\u8bc1\u4e0a\u9762\u6807\u6ce8\u4e86\u5206\u914d\u7ed9\u6cb9\u68d5\u6988\u7684 LPF \u533a\u57df\u4fe1\u606f\uff0c\u8fd9\u4e9b\u533a\u57df\u7684\u8fb9\u754c\u5747\u5df2\u7ed8\u5236\uff0c\u5e76\u5305\u542b\u5728\u7802\u62c9\u8d8a\u6cb9\u68d5\u6988\u7279\u8bb8\u6743\u7684\u72ec\u7acb\u6570\u636e\u96c6\u4e2d\u3002LPF \u8bb8\u53ef\u8bc1\u7684\u7b7e\u53d1\u65e5\u671f\u3001\u5b98\u65b9\u89c4\u5b9a\u7684\u603b\u9762\u79ef\uff08\u516c\u9877\uff09\u4ee5\u53ca\u53ef\u79cd\u690d\u9762\u79ef\uff08\u516c\u9877\uff09\u76f4\u63a5\u4ece\u73af\u5883\u5f71\u54cd\u8bc4\u4f30 (EIA) \u62a5\u544a\u6216\u62a5\u544a\u5f15\u7528\u7684\u76f8\u5173\u53c2\u8003\u8d44\u6599\u4e2d\u83b7\u53d6\u3002\u6240\u63d0\u4f9b\u7684\u5404 LPF \u6388\u6743\u5355\u4f4d\u622a\u81f3 2012 \u5e74\u79cd\u690d\u9762\u79ef\u7684\u76f8\u5173\u4fe1\u606f\u5747\u6458\u81ea\u5b98\u65b9\u53d1\u5e03\u7684\u62a5\u544a\u6216\u8005\u76f8\u5173\u516c\u53f8\u7684\u7f51\u7ad9\u3002", "26deeea1648473c4017d02bf26b285a5": "\u9700\u8981\u6ce8\u610f\u7684\u662f\uff0cLPF \u8bb8\u53ef\u4e0e\u73b0\u5728\u7684\u6728\u6750\u8bb8\u53ef\u53d1\u751f\u91cd\u53e0\u662f\u5f88\u5e73\u5e38\u7684\u4e8b\uff08\u89c1\u7802\u62c9\u8d8a\u5355\u72ec\u4f10\u6728\u8bb8\u53ef\u6743\u6570\u636e\u96c6\uff09\u3002\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0cLPF \u7684\u6e05\u626b\u548c\u79cd\u690d\u53ea\u80fd\u5728 LPF \u5185\u7684\u4e2a\u4eba\u533a\u57df\u5185\u8fdb\u884c\uff0c\u5e76\u4e14\u8981\u7b49\u4f10\u6728\u8bb8\u53ef\u6301\u6709\u4eba\u5b8c\u6210\u5176\u6d3b\u52a8\u540e\u624d\u80fd\u8fdb\u884c\u3002", "06ba5f92ea3bf6368eb7c2ad4a0669c2": "\u6c99\u5df4\u6728\u6750\u79cd\u690d\u56ed\u8bb8\u53ef\u8bc1- 2014\u5e74", "07d10d5441a96fc3568b961007e58ceb": "\u6c99\u5df4\u4f10\u6728\u7279\u8bb8\u6743", "f0032c8183d64024601748b1111da2e0": "\u5c55\u73b0\u9a6c\u6765\u897f\u4e9a\u6c99\u5df4\u5dde\u5546\u4e1a\u68ee\u6797\u4fdd\u62a4\u533a\u68ee\u6797\u7ecf\u8425\u5355\u4f4d (FMUs) \u7684\u754c\u9650\uff0c\u4ee5\u53ca\u8bb8\u53ef\u8bc1\u6301\u6709\u4eba\u7684\u8eab\u4efd\u3002\u8fd8\u63d0\u4f9b\u6bcf\u5bb6\u5355\u4f4d\u57282014\u5e74\u7684\u6728\u6750\u751f\u4ea7\u91cf\u548c\u6765\u6e90\uff0c\u5e76\u5212\u5206\u51fa\u83b7\u5f97\u7b2c\u4e09\u65b9\u8ba4\u8bc1\u7684\u90a3\u4e9b\u4f9b\u5e94\u5546\u3002", "aa1d646d36300457d68292206bb4191d": "\u9a6c\u6765\u897f\u4e9a\u6c99\u5df4", "22ae276b5d9f84a8c3571c3a7b4a1d19": "\u4ee5\u524d\u9881\u53d1\u8fc7\u8bb8\u53ef\u8bc1\u7684\u5e76\u4e14\u91cd\u65b0\u5f52\u7c7b\u4e3a\u4e00\u7ea7\u68ee\u6797\u4fdd\u62a4\u533a\u7684\u5730\u533a\u5305\u542b\u5728\u5355\u72ec\u7684\u201c\u4fdd\u62a4\u533a\u201d\u6c99\u5df4\u6570\u636e\u96c6\u91cc\u9762\u3002\u8fd9\u5305\u62ec\u4e00\u4e9b\u88ab\u68ee\u6797\u7ba1\u7406\u59d4\u5458\u4f1a\uff08FSC\uff09\u8ba4\u8bc1\u7684\u5730\u533a", "b1a6e09c95b2f695808c0ce21f3caec6": "\u5f88\u591a\u5176\u5b83\u6301\u6709\u5546\u4e1a\u7ba1\u7406\u6267\u7167\u5e76\u4e14\u5305\u62ec\u5728\u8fd9\u4e2a\u6570\u636e\u96c6\u4e2d\u7684\u5730\u533a\u662f\u5927\u91cf\u91c7\u4f10\u540e\u7684\u5730\u533a\uff0c\u8fd9\u4e9b\u5730\u533a\u6709\u7740\u7ba1\u7406\u8ba1\u5212\uff0c\u800c\u8fd9\u4e9b\u8ba1\u5212\u4e0d\u5141\u8bb8\u4efb\u4f55\u65b0\u7684\u91c7\u4f10\u3002", "b9eee55f202cdfc2f776520c30f3021b": "\u8bb8\u53ef\u8bc1\u6301\u6709\u4eba\u7684\u8eab\u4efd\u53ef\u80fd\u5df2\u7ecf\u6539\u53d8\u3002", "031229c505e6c019efe4b5aace883077": "\u6bcf\u4e2a\u88ab\u8bb8\u53ef\u65b9\u57282014\u5e74\u751f\u4ea7\u7684\u6728\u6750\u91cf\uff08\u6765\u6e90\u4e8e SFD 2014\u5e74\u5e74\u5ea6\u62a5\u544a\uff09\uff0c\u6839\u636e\u6728\u6750\u7684\u6765\u6e90\u8fdb\u884c\u4e86\u5206\u89e3\uff1a\u68ee\u6797\u53ef\u6301\u7eed\u7ecf\u8425\uff08SFM\uff0c\u9009\u62e9\u6027\u5730\u5bf9\u81ea\u7136\u68ee\u6797\u8fdb\u884c\u780d\u4f10\uff09\u3001\u68ee\u6797\u8f6c\u6362\uff08\u6e05\u9664\u81ea\u7136\u68ee\u6797\uff09\u4ee5\u53ca\u683d\u690d\uff08\u4eba\u5de5\u6797\u79cd\u690d\u6728\u6750\uff09\u3002", "45c6ae91dae4f2a112a0d28b2025ef44": "\u663e\u793a\u6c99\u5df4\u5dde\u6728\u6750\u79cd\u690d\u8bb8\u53ef\u8bc1\u7684\u8fb9\u754c\u3002", "97f8a2f51d25ba21ff7c170a827624c2": "<strong>\u58a8\u897f\u54e5</strong>\u65e0\u68ee\u6797\u53d8\u5316\u6570\u636e\u96c6\u3002", "a809c153de3e7884b544afb39ea217fb": "\u663e\u793a\u58a8\u897f\u54e5\u68ee\u6797\u8986\u76d6\u9762\u79ef", "e5e29dc5ca0b98bc2a9bb710e535b89b": "2013 \u5e74\u6216 2014 \u5e74\uff08\u6839\u636e\u5730\u533a\u800c\u4e0d\u540c\uff09", "86732892b7c194cab0f58710ef472cf9": "\u6bcf\u4e2a\u5dde\u7684\u6570\u636e\u662f\u5355\u72ec\u5f00\u53d1\u7684 \u2014\u2014 \u56e0\u6b64\u4e0d\u540c\u5dde\u4e4b\u95f4\u53ef\u80fd\u4f1a\u6709\u4e00\u4e9b\u4e0d\u4e00\u81f4\u3002\u4e00\u4e9b\u5dde\u62e5\u6709\u4e0d\u5b8c\u6574\u7684\u4fe1\u606f\uff0c\u5c24\u5176\u662f\u65b0\u83b1\u6602\u5dde\u548c\u8428\u5361\u7279\u5361\u65af\u5dde\u3002", "5328c76043ed63d58f11cc3551658021": "\u58a8\u897f\u54e5\u68ee\u6797\u533a\u5212", "3b31973dde5efcfbedbcdbf1f1c7aa27": "\u6b64\u56fe\u5c42\u663e\u793a\u4e86\u58a8\u897f\u54e5\u5404\u4e2a\u5dde\u7684\u68ee\u6797\u8d44\u6e90\u5b58\u91cf\u4fe1\u606f\uff0c\u7531\u58a8\u897f\u54e5\u56fd\u5bb6\u68ee\u6797\u59d4\u5458\u4f1a (CONAFOR) \u4e3b\u5bfc\uff0c\u4e0e 32 \u4e2a\u5dde\u8054\u5408\u5236\u4f5c\u7684 2013 \u5e74\u6216 2014 \u5e74\u58a8\u897f\u54e5\u68ee\u6797\u8986\u76d6\u5730\u56fe\u3002\u5730\u56fe\u4f7f\u7528\u4e86\u591a\u4e2a\u6570\u636e\u6765\u6e90\uff1a1) \u9ad8\u5206\u8fa8\u7387\u7684 RapidEye \u56fe\u50cf\uff1b2) 2011 \u5e74 INEGI \u7684\u571f\u5730\u4f7f\u7528\u56fe\uff1b3) \u5730\u5f62\u6d4b\u91cf\u6570\u636e\uff1b4) CONAFOR \u6536\u96c6\u7684\u5b9e\u5730\u6570\u636e\u3002", "bc9ed986870bbfa56092c7e56cadfd03": "\u58a8\u897f\u54e5\u68ee\u6797\u5206\u7c7b", "5665b36f3be305e6e71637df93880520": "\u663e\u793a\u58a8\u897f\u54e5\u7684\u54ea\u4e9b\u5730\u533a\u88ab\u8ba4\u5b9a\u4e3a\u9002\u5408\u4fdd\u62a4\u3001\u751f\u4ea7\u548c\u6062\u590d\u3002", "8d1815dfe1bbc798d1bdcc82d7820a96": "\u58a8\u897f\u54e5\u68ee\u6797\u5206\u533a\u662f\u653f\u5e9c\u91c7\u7528\u7684\u4e00\u4e2a\u91cd\u8981\u5de5\u5177\uff0c\u901a\u8fc7\u751f\u7269\u3001\u73af\u5883\u3001\u793e\u4f1a\u7ecf\u6d4e\u3001\u5a31\u4e50\u548c\u4fee\u590d\u8fd9\u4e9b\u529f\u80fd\u6765\u8bc6\u522b\u3001\u5212\u5206\u548c\u7ba1\u7406\u68ee\u6797\u571f\u5730\u3002\u5206\u533a\u7684\u76ee\u7684\u5728\u4e8e\u66f4\u597d\u5730\u89c4\u5212\u8d44\u6e90\u7684\u5229\u7528\uff0c\u5e76\u4fc3\u8fdb\u68ee\u6797\u7684\u53ef\u6301\u7eed\u53d1\u5c55\u3002", "7d7fb229d0264fa84757b850ce231662": "<strong>\u4fdd\u62a4\u533a\uff1a</strong>\u9650\u5236\u6216\u8005\u7981\u6b62\u4f7f\u7528\u7684\u68ee\u6797\u571f\u5730", "37b8190a1a355d96c6c6e93ca75105ec": "\u81ea\u7136\u4fdd\u62a4\u533a", "45016e5d4b2baaa918130a0f1389cdc7": "\u9ad8\u6e7f\u6da6\u5e38\u7eff\u68ee\u6797\u8986\u76d6\u533a\u57df", "79e1ef41f1eb460c7495151ef3ee6f86": "\u690d\u88ab\u4fdd\u62a4", "ca9a98ea57452e9028105be9c109e23b": "\u9ad8\u4ea7\u6797\u5730", "382a50288e14011cc85ab5739f22d2cd": "\u4f4e\u751f\u4ea7\u529b\u6c34\u5e73\u68ee\u6797\u571f\u5730", "e8e73b2bf551e711d13d2aabcfc6ae1c": "\u690d\u88ab\u8986\u76d6\u65f1\u5730", "05f8115e8e2803d73591264622d5eac7": "\u9002\u5408\u4e8e\u68ee\u6797\u7684\u975e\u6797\u5730", "7a79ce6f269cfe4c333e6326f557f731": "<strong>\u6062\u590d\u533a</strong>\u6709\u9000\u5316\u8ff9\u8c61\u7684\u5730\u533a", "6a096442f4f4bbf91c853dec1a371125": "\u6709\u4e25\u91cd\u8150\u8680\u8ff9\u8c61\u7684\u5df2\u9000\u5316\u68ee\u6797\u5730\u533a", "c2691f53f27db04ffd2009e22c9a0f3d": "\u4e0d\u9002\u5408\u690d\u6811\u7684\u975e\u6797\u5730\uff0c\u6709\u4e25\u91cd\u4fb5\u8680\u8ff9\u8c61", "3b84b870062a7157929203ed01f7f3fc": "\u4e2d\u5ea6\u9000\u5316\u7684\u6797\u5730\u6216\u9996\u9009\u6797\u5730", "264b377d85fd6fb8157ade2d3a1ba856": "\u6797\u5730\u6216\u4f4e\u9000\u5316\u7684\u9996\u9009\u6797\u5730", "71dc0f995aa8d1b990df9d1e80d92a13": "\u6797\u5730\u6216\u6062\u590d\u7684\u9996\u9009\u6797\u5730\uff08\u91cd\u65b0\u9020\u6797\u3001\u7eff\u5316\u6216\u81ea\u7136\u66f4\u65b0\uff09", "536b0e07169327bc813ae513516e03f6": "\u663e\u793a\u58a8\u897f\u54e5\u68ee\u6797\u8986\u76d6\u7387\u3002", "7cfadce6308ca5f92fcc9287a74df217": "\u58a8\u897f\u54e5\u4fdd\u62a4\u5730\u533a", "499525e44d8d56ef8ff41393878b0766": "\u663e\u793a\u58a8\u897f\u54e5\u7684\u56fd\u5bb6\u3001\u5dde\u548c\u5e02\u4fdd\u62a4\u533a\u4ee5\u53ca\u81ea\u613f\u4fdd\u62a4\u533a\u7684\u4f4d\u7f6e\u3002", "bbf62506eca75a590693f049c941756e": "2016 \u5e74 1 \u6708\uff08\u5168\u56fd\uff09\uff0c2011 \u5e74 12 \u6708\uff08\u5dde\u3001\u5e02\uff09\u548c 2012 \u5e74 5 \u6708\uff08\u81ea\u613f\uff09", "9fb99a04efdefda5ce9faf8f7e41b436": "\u6b64\u6570\u636e\u96c6\u5305\u542b\u58a8\u897f\u54e5\u5404\u79cd\u4e0d\u540c\u7c7b\u578b\u4fdd\u62a4\u533a\u4fe1\u606f\u3002\u56fd\u5bb6\u4fdd\u62a4\u533a\u7531 CONANP \u7ba1\u7406\uff0c\u5dde\u548c\u5730\u65b9\u4fdd\u62a4\u533a\u7531\u5dde\u548c\u5730\u65b9\u673a\u6784\u7ba1\u7406\u3002\u81ea\u613f\u4fdd\u62a4\u533a\u662f\u79c1\u4eba\u4e1a\u4e3b\u81ea\u613f\u8ba4\u8bc1\u6210\u7acb\u7684\u4fdd\u62a4\u533a\uff0c\u6700\u4f4e\u5e74\u9650 15 \u5e74\u3002", "13f024abf0c5571167539d3d4b5a9329": "\u663e\u793a\u58a8\u897f\u54e5\u7684\u56fd\u5bb6\u3001\u5dde\u548c\u5e02\u4fdd\u62a4\u533a\u4ee5\u53ca\u81ea\u613f\u4fdd\u62a4\u533a\u7684\u4f4d\u7f6e\u3002", "a9a58ce091dd2a6fc457a269f8b148c3": "\u663e\u793a\u79d8\u9c81\u7684\u56fd\u5bb6\u3001\u5730\u533a\u548c\u79c1\u4eba\u4fdd\u62a4\u533a\u548c\u7f13\u51b2\u533a\u7684\u4f4d\u7f6e\u3002", "b3525f72f21c468c2a345b44a33dabf2": "\u7f8e\u56fd\u571f\u5730\u8986\u76d6 - 2001-2016", "da89df6c2641126deedb274c7edac680": "\u7f8e\u56fd\u571f\u5730\u8986\u76d6", "c6af1cf016e1699d66a03c67f2b1fbb3": "\u7f8e\u56fd\u672c\u571f\uff08\u4e0d\u5305\u62ec\u963f\u62c9\u65af\u52a0\u548c\u590f\u5a01\u5937\uff09", "a0aec5fe69226c1d99fdf66efd2c1714": "\u4e00\u9879 NLCD \u571f\u5730\u8986\u76d6\u4ea7\u54c1\u7684\u7cbe\u5ea6\u8bc4\u4f30\u663e\u793a\uff0c2001 \u5e74\u548c 2006 \u5e74\u4ea7\u54c1\u7684\u603b\u4f53\u7cbe\u5ea6\u5206\u522b\u4e3a 79% \u548c 78%\uff0c\u800c\u4e14\u4e24\u4e2a\u5e74\u5ea6\u7684\u6c34\u57df\u3001\u9ad8\u5bc6\u5ea6\u57ce\u5e02\u3001\u6240\u6709\u9ad8\u5730\u68ee\u6797\u3001\u704c\u6728\u4e1b\u4ee5\u53ca\u8015\u5730\u7684\u7cbe\u5ea6\u8d85\u8fc7 80%\u3002", "66c6e9856b96db8aa0c5e8fa0c513497": "\u571f\u5730\u8986\u76d6\u7c7b\u522b\u5305\u62ec\u6797\u5730\u3001\u79cd\u690d\u5730/\u8015\u5730\u3001\u6e7f\u5730\u3001\u8349\u5730\u3001\u6c34\u57df\u3001\u5df2\u5f00\u53d1\u5730\u57df\u548c\u8d2b\u7620\u5730\u57df\u3002\u571f\u5730\u8986\u76d6\u4fe1\u606f\u5bf9\u4e8e\u5f53\u5730\u3001\u5dde\u548c\u8054\u90a6\u5b98\u5458\u8fdb\u884c\u6709\u6548\u7684\u7ba1\u7406\u5341\u5206\u91cd\u8981\uff0c\u8fd9\u4e9b\u4fe1\u606f\u53ef\u4ee5\u5e2e\u52a9\u4ed6\u4eec\u8bc4\u4f30\u751f\u6001\u7cfb\u7edf\u548c\u5065\u5eb7\u72b6\u51b5\uff0c\u6784\u5efa\u5bcc\u8425\u517b\u5316\u548c\u519c\u836f\u6c61\u67d3\u5f84\u6d41\u6a21\u578b\uff0c\u7406\u89e3\u751f\u7269\u591a\u6837\u6027\u7684\u7a7a\u95f4\u6a21\u5f0f\uff0c\u89c4\u5212\u571f\u5730\u4f7f\u7528\uff0c\u83b7\u53d6\u5730\u8c8c\u79cd\u7c7b\u6570\u636e\u4ee5\u53ca\u5f00\u53d1\u571f\u5730\u7ba1\u7406\u653f\u7b56\u3002", "8cde635b0ee7c2869b48f66893fae639": "\u5df4\u897f\u751f\u7269\u7fa4\u843d - 2004", "85e1629b344fc251ac7b59355a9b4068": "2021 \u516d\u6708", "201acee133d0899f6730bd4db53e86f4": "2022 \u516d\u6708", "f72519a5285672989b5b64b6af154da3": "\u5728\u9ad8\u7a7a\u95f4\u5206\u8fa8\u7387\u4e0b\u5bf9\u5927\u8c46\u6269\u5f20\u63d0\u4f9b\u4e86\u4e00\u4e2a\u957f\u671f\u7684\u3001\u5927\u9646\u6027\u7684\u89c6\u89d2.", "3df908530cf0b9e0d95dd87b1a4811f1": "\u6b64\u6570\u636e\u4e0e GFW \u4e0a\u5168\u7403\u6811\u6728\u8986\u76d6\u51cf\u5c11\u5730\u56fe\u4e00\u81f4\uff0c\u4ec5\u53cd\u6620 2001 \u5e74\u81f3 2021 \u5e74\u95f4\u6bcf\u4e2a\u50cf\u7d20\u7684\u9996\u6b21\u5730\u76ae\u66ff\u4ee3\u68ee\u6797\u5e72\u6270\u3002\u5728\u6b64\u6570\u636e\u4e2d\uff0c\u672a\u63a2\u6d4b\u5728\u7814\u7a76\u671f\u65e9\u671f\u6700\u521d\u5e72\u6270\u540e\u68ee\u6797\u518d\u751f\u65f6\u53d1\u751f\u7684\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u533a\u57df\u3002", "1ab129d750abecb89c28df130a8ff61a": "\u6b64\u6570\u636e\u7531\u9a6c\u91cc\u5170\u5927\u5b66\u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Global Land Analysis &amp; Discovery (GLAD) \u5b9e\u9a8c\u5ba4</a>\u751f\u6210\uff0c\u6d4b\u91cf\u7684\u662f\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u533a\u57df\uff0c\u5e76\u4e0e\u5168\u7403\u6240\u6709\u9646\u5730\uff08\u5357\u6781\u6d32\u53ca\u5176\u4ed6\u5317\u6781\u5c9b\u5c7f\u9664\u5916\uff09\u7684\u6240\u6709\u5176\u4ed6\u4fc3\u6210\u56e0\u7d20\u6bd4\u8f83\uff0c\u5206\u8fa8\u7387\u5927\u7ea6\u4e3a 30 \u7c73 \u00d7 30 \u7c73\u3002\u6570\u636e\u91c7\u7528 2001 \u5e74\u81f3 2021 \u5e74\u5168\u7403\u57fa\u4e8e Landsat \u7684\u5e74\u5ea6\u53d8\u5316\u63a2\u6d4b\u6307\u6807\u4f5c\u4e3a\u8f93\u5165\u6570\u636e\u751f\u6210\uff0c\u4f9d\u636e\u4e00\u5957\u6309\u5730\u533a\u6821\u51c6\u7684\u5206\u7c7b\u6811\u7ec4\u5408\u6a21\u578b\u3002\u7ed8\u56fe\u8fc7\u7a0b\u7684\u7ed3\u679c\u80fd\u4ee5\u4e00\u7ec4\u4e8c\u5143\u6620\u5c04\u7684\u65b9\u5f0f\u67e5\u770b\uff08\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u4e0e\u6240\u6709\u5176\u4ed6\u4fc3\u6210\u56e0\u7d20\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6bd4\u8f83\uff09\u3002", "d9d400fcdf22e69ed8c5522fc18d8a11": "\u5bf9\u4e8e\u7528\u4f5c\u6b64\u6570\u636e\u96c6\u7684\u8f93\u5165\u7684 GFW \u4e0a\u7684\u57fa\u672c\u6811\u6728\u8986\u76d6\u51cf\u5c11\u5730\u56fe\uff0c\u5176\u5206\u6790\u65b9\u6cd5\u5df2\u901a\u8fc7\u591a\u79cd\u65b9\u5f0f\u8fdb\u884c\u4fee\u6539\uff0c\u76ee\u7684\u662f\u6539\u8fdb\u5bf9\u706b\u707e\u3001\u70ed\u5e26\u68ee\u6797\u7684\u5c0f\u5bb6\u8f6e\u4f5c\u519c\u4e1a\u3001\u9009\u62e9\u6027\u4f10\u6728\u4ee5\u53ca\u77ed\u5468\u671f\u4eba\u5de5\u6797\u5bfc\u81f4\u7684\u5317\u65b9\u68ee\u6797\u51cf\u5c11\u7684\u63a2\u6d4b\uff0c\u6570\u636e\u6db5\u76d6 2011 \u5e74\u81f3 2021 \u5e74\u8fd9\u6bb5\u65f6\u95f4\u3002\u7531\u4e8e\u5b58\u5728\u8fd9\u4e9b\u53d8\u5316\uff0c\u5728\u6bd4\u8f83 2000 \u5e74\u81f3 2010 \u4e0e 2011 \u5e74\u81f3 2021 \u5e74\u8fd9\u4e24\u4e2a\u65f6\u95f4\u6bb5\u7684\u8d8b\u52bf\u65f6\uff0c\u5e94\u5f53\u614e\u91cd\u3002\u60a8\u53ef\u4ee5<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5728\u6b64\u5904</a>\u8fdb\u4e00\u6b65\u4e86\u89e3\u5efa\u6a21\u8fc7\u7a0b\u7684\u65b0\u60c5\u51b5\u3002", "d7d6bcc7c5ea1851a35bb78ab1403fd8": "2016 \u5e74 10 \u6708", "0d015d96f63a8c12d96b8399482b593f": "\u672a\u5206\u7c7b ", "108e3c7857edfded5864d9c62619b019": "\u6b64\u6570\u636e\u96c6\u662f\u6d2a\u90fd\u62c9\u65af\u7b2c\u4e00\u4e2a\u9ad8\u5206\u8fa8\u7387\u7684\u68ee\u6797\u548c\u571f\u5730\u8986\u76d6\u5730\u56fe\uff0c\u7531\u6d2a\u90fd\u62c9\u65af\u653f\u5e9c\u673a\u6784 ICF\uff08\u56fd\u5bb6\u4fdd\u62a4\u548c\u68ee\u6797\u5f00\u53d1\u3001\u4fdd\u62a4\u533a\u548c\u91ce\u751f\u52a8\u7269\u5c40\uff09\u901a\u8fc7<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">REDD/CCAD-GIZ \u9879\u76ee</a>\u7684\u79d1\u6280\u548c\u8d22\u52a1\u652f\u6301\u5b8c\u6210\u7684\u3002\u53d6\u5f97\u5e76\u5206\u6790\u4e86 2013 \u5e74\u7684 RapidEye \u536b\u661f\u56fe\u50cf\uff0c\u7ed8\u5236\u51fa\u4e86\u6b64\u56fd\u5bb6\u5185\u68ee\u6797\u79cd\u7c7b\u7684\u7a7a\u95f4\u5206\u5e03\u56fe\u3002\u9664\u4e86\u7ed8\u5236\u51fa\u516b\u4e2a\u4e0d\u540c\u68ee\u6797\u79cd\u7c7b\uff0c\u6b64\u5730\u56fe\u8fd8\u63cf\u7ed8\u4e86\u5341\u4e94\u4e2a\u4eba\u7c7b\u571f\u5730\u4f7f\u7528\u7c7b\u522b\u7684\u8303\u56f4\u548c\u5206\u5e03\u3002", "937b47ced4a8aba4890f92ced21d3858": "\u5b8f\u90fd\u62c9\u65af\u68ee\u6797\u7c7b\u578b - 2013", "f940dd60dfcc07f1b063cb55dcfabe06": "\u5370\u5ea6\u5c3c\u897f\u4e9a\u6ce5\u70ad\u7530 - 2012", "80b2633b79f5ef2e0865ab49fdb9a47a": "\u5370\u5ea6\u5c3c\u897f\u4e9a\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf - 2013", "042677fe77616f9378144dc3c4e87da8": "\u5370\u5ea6\u5c3c\u897f\u4e9a\u68ee\u6797\u5f00\u91c7\u7981\u4ee4 - 2020", "a64d04f0f1fbfbbfe9cc210e964b4ee1": "\u6c99\u635e\u8d8a\u68ee\u6797\u7279\u8bb8\u5f00\u91c7\u6743 - 2010", "852233f8166875e11585290417f13a81": "\u6c99\u635e\u8d8a\u68d5\u6988\u7279\u8bb8\u6743 - 2010", "04f679784460538c6d65a9b8398e0222": "\u663e\u793a\u6c99\u635e\u8d8a\u5730\u533a\u6cb9\u68d5\u7279\u8bb8\u7528\u5730\u7684\u8986\u76d6\u8303\u56f4\uff08\u82e5\u6709\u76f8\u5173\u4fe1\u606f\u7684\u8bdd\u3002", "4b820299118634f4b4e9c43b457701b9": "\u6c99\u635e\u8d8a\u68ee\u6797\u7279\u8bb8\u5f00\u91c7\u6743 - 2014", "465f8ca89a1ea5ca61caca1f95d1756d": "\u56fd\u5bb6\u571f\u5730\u8986\u76d6\u6570\u636e (NLCD) \u571f\u5730\u8986\u76d6\u4ea7\u54c1\u5df2\u7ecf\u4e8e 2001 \u5e74\u30012006 \u5e74\u548c 2011 \u5e74\u53d1\u5e03\u3002NLCD 2016 \u5e74\u7684\u6b63\u5f0f\u7cbe\u5ea6\u8bc4\u4f30\u5c1a\u672a\u5f00\u5c55\u3002", "be05914b24e8ae496a212af98f386fe9": "\u7f8e\u56fd\u8054\u90a6\u6570\u636e\u514d\u8d39\u63d0\u4f9b\u4e14\u65e0\u9650\u5236\u3002\n<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">https://project-open-data.cio.gov/policy-memo/</a>", "6978c3dd35ccfe2f848ae1d0690bea42": "\u8be5\u5c42\u5c06\u663e\u793a2001\u5e74\u548c2016\u5e74\u4e4b\u95f4\u7684\u571f\u5730\u8986\u76d6\u53d8\u5316\u3002\u50cf\u7d20\u5728\u6b64\u671f\u95f4\u7684\u6539\u53d8\u663e\u793a\u571f\u5730\u8986\u76d6\u503c\u7684\u53d8\u5316\u3002\u6ca1\u6709\u53d8\u5316\u7684\u50cf\u7d20\u662f\u900f\u660e\u7684\u3002", "f8cad54a4c63725cd54b178a842470e3": "2016 \u5e74\u56fd\u5bb6\u571f\u5730\u8986\u76d6\u6570\u636e\u5e93 (NLCD 2016) \u662f\u7531\u7f8e\u56fd\u591a\u5206\u8fa8\u571f\u5730\u7279\u5f81\u534f\u4f1a (MRLC) \u521b\u5efa\u7684\u6700\u65b0\u56fd\u5bb6\u6570\u636e\u4ea7\u54c1\u3002MRLC \u662f\u8054\u90a6\u653f\u5e9c\u7684\u4e00\u4e2a\u56e2\u4f53\uff0c\u534f\u8c03\u548c\u751f\u6210\u5168\u56fd\u8303\u56f4\u5185\u4e00\u81f4\u3001\u91cd\u8981\u7684\u571f\u5730\u8986\u76d6\u4fe1\u606f\uff0c\u4f9b\u5404\u79cd\u73af\u4fdd\u3001\u571f\u5730\u7ba1\u7406\u548c\u5efa\u6a21\u5e94\u7528\u4f7f\u7528\u3002NLCD 2016 \u9996\u6b21\u63d0\u4f9b\u5bf9\u7f8e\u56fd 2001 \u5e74\u81f3 2016 \u5e74\u7684\u571f\u5730\u8986\u76d6\u53d8\u5316\u548c\u8d8b\u52bf\u5c55\u5f00\u5168\u9762\u3001\u7a7a\u95f4\u660e\u786e\u3001\u5168\u56fd\u6027\u7684\u8bc4\u4f30\u7684\u80fd\u529b\u3002\u4e0e\u524d\u4e24\u4e2a NLCD \u571f\u5730\u8986\u76d6\u4ea7\u54c1\u76f8\u540c\uff0cNLCD 2016 \u4f7f\u7528\u4e86\u5168\u7f8e\u8303\u56f4\u5185\u4e00\u81f4\u5e94\u7528\u7684 16 \u7c7b\u571f\u5730\u8986\u76d6\u5206\u7c7b\u4f53\u7cfb\uff0c\u7a7a\u95f4\u5206\u8fa8\u7387\u4e3a 30 \u7c73\u3002NLCD 2016 \u4e3b\u8981\u5efa\u7acb\u5728 2016 \u5e74\u524d\u540e\u9646\u5730\u536b\u661f\u6570\u636e\u51b3\u7b56\u6811\u5206\u7c7b\u7684\u57fa\u7840\u4e4b\u4e0a\u3002", "3bb3eecca085a22b82df8c75594a2306": "\u5728\u539f\u59cb\u5e73\u53f0\u5c06\u6570\u636e\u53ef\u89c6\u5316 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\"> \u6b64\u5904 </a>\u3002", "a406c1be28c4ef9e6a91b93e2d6e0e72": "\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u52a8\u753b\u5c55\u793a\u539f\u59cb\u6570\u636e\u3002", "95f8c6f75d048ae56bead6177be87879": "\u79d8\u9c81\u6c38\u4e45\u751f\u4ea7\u6797 - 2015", "a40d7c0ae4d5decee811012be22cc7c4": "\u79d8\u9c81\u68ee\u6797\u7279\u8bb8\u6743 - 2015", "9dd94ddff48ae07e14aec65b7ae84a32": "2016 \u5e74 6 \u6708", "ea06ddecb7577ddb8e954493d7dbf15a": "\u79d8\u9c81\u4fdd\u62a4\u533a - 2016", "8fad104bd31f11bfbb5d721fc23d2011": "\u6240\u663e\u793a\u7684\u6570\u636e\u6765\u81eaCollection 3.1\uff0c\u663e\u793a\u7684\u662f1985\u5e74\u81f32017\u5e74\u95f4\u6bcf\u5e74\u7684\u571f\u5730\u8986\u76d6\u548c\u571f\u5730\u4f7f\u7528\u60c5\u51b5\u3002\u4e13\u5bb6\u5206\u522b\u7ed8\u5236\u5df4\u897f\u6bcf\u4e2a\u751f\u7269\u7fa4\u843d\uff08Amazon\u3001Cerrado\u3001Caatinga\u3001Atlantic Forest\u3001Pampa\u548cPantanal\uff09\u7684\u571f\u5730\u8986\u76d6\u548c\u571f\u5730\u5229\u7528\u5730\u56fe\uff0c\u7136\u540e\u5c06\u8fd9\u4e9b\u5730\u56fe\u4e0e\u519c\u4e1a\u3001\u7267\u573a\u3001\u57ce\u5e02\u57fa\u7840\u8bbe\u65bd\u548c\u6cbf\u6d77\u5730\u533a\u7684\u6a2a\u5207\u56fe\u5408\u5e76\u3002\u6240\u6709\u5904\u7406\u5de5\u4f5c\u90fd\u662f\u5728\u9879\u76ee\u521b\u5efa\u7528\u6765\u8fd0\u884c\u8c37\u6b4c\u5730\u7403\u5f15\u64ce\u7684MapBiomas Workspace\u534f\u4f5c\u5e94\u7528\u4e2d\u7684Landsat\u56fe\u50cf\u4e0a\u5b8c\u6210\u7684\u3002\u8be5\u8fc7\u7a0b\u4f7f\u7528\u968f\u673a\u68ee\u6797\u5206\u7c7b\u5668\u5c0