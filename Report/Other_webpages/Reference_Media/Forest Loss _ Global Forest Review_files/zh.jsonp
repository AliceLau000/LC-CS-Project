b8f36ac2b2c41316e9cebf3923ef2d71": "\u6797\u578b", "ca71538d2a2120f899e04e0bb094382c": "\u5730\u56fe\u5bfc\u89c8 \u00b7 2/9", "c6a3f2715d997f74251acdb47d7d8008": "\u672a\u53d7\u4fb5\u6270\u539f\u59cb\u68ee\u6797\u666f\u89c2 (2000)", "28dfac44572a2ee2c3139f14c5ee876d": "\u521b\u5efa\u4e00\u4e2a\u5173\u6ce8\u533a\u57df \u00b7 2/4", "75aeb98e5241592ad6a6c2c4c78a16ef": "\u5e74", "623a5c128820f6be5e5fea4c81e2222d": "\u5730\u56fe\u5bfc\u89c8 \u00b7 4/9", "5c5536a63fa33d8d72bfb0e791bc6ae7": "\u5730\u56fe\u5bfc\u89c8 \u00b7 5/9", "4d7f3c8044473cd9f84b406c9d2b13db": "\u5730\u56fe\u5bfc\u89c8 \u00b7 8/9", "fb0dacca68fcf535814142e534f4fed1": "GFW Pro\u76ee\u524d\u63d0\u4f9b\u82f1\u8bed\u3001\u8461\u8404\u7259\u8bed\u548c\u897f\u73ed\u7259\u8bed\u7248\u672c\u3002", "e9a421c113eb02bc0331edeb24c6abe9": "\u5982\u679c\u5bf9GFW Pro\u6709\u7591\u95ee\uff0c\u6211\u5e94\u8be5\u4e0e\u8c01\u8054\u7cfb\uff1f", "91ea88efb2273d3c6ead8edf1bc1b74a": "\u6216\u4f7f\u7528\u672c\u9875\u9762\u5e95\u90e8\u7684\u8868\u683c\u8054\u7cfbGFW\u56e2\u961f\u3002", "9d06704cb8861be359ba1d2dd0a74ed8": "\u4e00\u6d41\u7684\u5b89\u5168\u7cfb\u7edf\uff0c\u5305\u62ec\u7528\u6237\u6743\u9650\u7ea7\u522b\u7ba1\u7406\u3002", "23e62d6cce359bc0c2fd430938993c99": "\u80fd\u591f\u5206\u6790\u5927\u91cf\u8d44\u4ea7\uff08\u4e00\u6b21\u6700\u591a\u53ef\u5206\u67901,500\u4e2a\u5730\u70b9\uff09\u7684\u98ce\u9669\u548c\u8d8b\u52bf\u3002", "21f99db6c0ea8006e05f2868c5d78b3d": "<strong>\u8981\u5bf9\u5916\u5171\u4eabGFW Pro\u8f93\u51fa\u7ed3\u679c\uff0c\u5fc5\u987b\u6309\u5e74\u4e3a\u6bcf\u4e2a\u5730\u70b9\u5206\u522b\u8d2d\u4e70\u5206\u8bb8\u53ef</strong>\u3002\u5411\u7b2c\u4e09\u65b9\u53d7\u4f17\uff08\u5982\u4f9b\u5e94\u94fe\u548c\u4e1a\u52a1\u5408\u4f5c\u4f19\u4f34\uff09\u53d1\u5e03\u3001\u5206\u53d1\u6216\u9500\u552e\u7279\u5b9a\u5730\u70b9\u7684\u5217\u8868\u5206\u6790\u8f93\u51fa\u7ed3\u679c\u53ca\u4efb\u4f55\u76f8\u5173GFW Pro\u5185\u5bb9\uff08\u5982\u7279\u5b9a\u5730\u70b9\u7684\u5730\u56fe\u6216\u5c4f\u5e55\u622a\u56fe\uff09\u65f6\uff0c\u5747\u9700\u9075\u5b88\u8fd9\u4e00\u8981\u6c42\u3002\u5206\u8bb8\u53ef\u6743\u67092\u79cd\u7c7b\u578b\uff1a&nbsp;", "f9c08cce1b6fd0c3cfcd0db3c505bb6a": "<strong>\u5b8c\u6574</strong>\u5206\u8bb8\u53ef\u6743\u5141\u8bb8\u5171\u4eab\u4efb\u4f55\u73b0\u6709\u68ee\u6797\u5217\u8868\u5206\u6790\u4e2d\u7684\u5177\u4f53\u5b9a\u91cf\u5206\u6790\u8f93\u51fa\u7ed3\u679c\u3002\u4f8b\u5982\uff0c\u5bf9\u4e8e\u5df2\u83b7\u5f97\u5206\u8bb8\u53ef\u7684\u6765\u6e90\u5730\u70b9\u800c\u8a00\uff1a&nbsp;\n", "571db50bc0b40dbd47209e9c9bc39839": "GFW Pro\u8bb8\u53ef\u534f\u8bae\u4e2d\u8be6\u8ff0\u4e86\u5206\u8bb8\u53ef\u6743\u7684\u8981\u6c42\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5e38\u89c1\u95ee\u9898\uff08FAQ\uff09</a>\u9875\u9762\uff08\u9700\u6709\u514d\u8d39GFW Pro\u8d26\u53f7\u624d\u80fd\u8bbf\u95ee\uff09\u4e2d\u63a2\u8ba8\u4e86\u4e00\u7cfb\u5217\uff08\u4f46\u5e76\u975e\u5168\u90e8\uff09\u793a\u4f8b\u60c5\u51b5\u3002\u5982\u679c\u4e0e\u672c\u4ef7\u683c\u8868\u6216FAQ\u4e2d\u5217\u51fa\u7684\u793a\u4f8b\u6709\u4efb\u4f55\u4e0d\u4e00\u81f4\u4e4b\u5904\uff0c\u5219\u5e94\u4ee5\u8bb8\u53ef\u534f\u8bae\u7684\u6761\u6b3e\u4e3a\u51c6\u3002&nbsp;", "f75bea80f053c926f22c810ec64cbe32": "\u5fc5\u987b\u7b26\u5408\u4ee5\u4e0b4\u9879\u8981\u6c42\u4e2d\u76843\u9879\uff1a", "c1e598d268d813c57b96c84cf4b3607b": "\u81f3\u5c111\u4e2a\u7279\u6b8a\u5b57\u7b26\uff1a^ $ * . [ ] { } ( ) ? \u2013 \u201d ! @ # % &amp; / , &gt; &lt; \u2018 : ; | _ ~", "0096b7f9b8fad55187da838aec0f11e9": "Olam\u4f7f\u7528GFW Pro\u6620\u5c04\u548c\u8f93\u5165\u4e861,000\u591a\u4e2a\u68d5\u6988\u6cb9\u91c7\u8d2d\u5730\u70b9\uff0c\u8bc6\u522b\u51fa\u4e00\u534a\u7684\u4f9b\u5e94\u5b58\u5728\u98ce\u9669\u3002", "317083fcb2e63b531810eda32d995444": "\u8c01\u521b\u5efa\u4e86GFW Pro\uff1f", "a3397b667f29269a81b02b5107e155be": "\u5728GFW Pro\u4e2d\uff0c\u67095\u4e2aGFW\u5217\u8868\u53ef\u4f9b\u4f7f\u7528\u3002\u8fd9\u4e9b\u5217\u8868\u4ee3\u8868\u7740\u7531WRI\u7684GFW\u56e2\u961f\u9009\u62e9\u6216\u521b\u5efa\u7684\u6570\u636e\u5c42\u3002\u60a8\u53ef\u4ee5\u4f7f\u7528\u8fd9\u4e9b\u5217\u8868\u521b\u5efa\u81ea\u5df1\u7684\u5217\u8868\u3002&nbsp;", "f04b507b5d317ead0714698dc607c280": "\u662f\u7684\u3002\u60a8\u53ef\u4ee5\u4f7f\u7528GFW Pro\u4e0a\u4f20\u60a8\u5e0c\u671b\u5206\u6790\u7684\u4f9b\u5e94\u94fe\u6216\u6295\u8d44\u5730\u70b9\u3002\u60a8\u53ef\u4ee5\u4e00\u6b21\u6dfb\u52a0\u4e00\u4e2a\u5730\u70b9\uff0c\u4e5f\u53ef\u4ee5\u4e00\u6b21\u4e0a\u4f20\u591a\u4e2a\u5730\u70b9\u3002GFW Pro\u53ef\u6839\u636e\u60a8\u8981\u4e0a\u4f20\u7684\u5927\u5b97\u5546\u54c1\u548c\u5730\u70b9\u683c\u5f0f\u63d0\u4f9b\u6a21\u677f\u3002", "94cb2d65d343503fd05a61daa65e4271": "\uff08WRI\uff09\u4e00\u76f4\u4e0e\u5904\u4e8e\u53ef\u6301\u7eed\u524d\u6cbf\u7684\u516c\u53f8\u548c\u91d1\u878d\u673a\u6784\u5408\u4f5c\uff0c\u4ee5\u4e86\u89e3GFW\u5982\u4f55\u652f\u6301\u96f6\u6bc1\u6797\u627f\u8bfa\u7684\u843d\u5b9e\uff0c\u4fc3\u8fdb\u53ef\u6301\u7eed\u7684\u5927\u5b97\u5546\u54c1\u751f\u4ea7\u548c\u8d38\u6613\u3002GFW Commodities\uff082018\u5e74\u505c\u7528\uff09\u5e94\u7528\u7a0b\u5e8f\u63d0\u4f9b\u4e86\u5730\u7406\u7a7a\u95f4\u6570\u636e\uff0c\u7528\u4e8e\u76d1\u6d4b\u548c\u5206\u6790\u6cb9\u68d5\u548c\u5927\u8c46\u4f9b\u5e94\u94fe\u4e2d\u7684\u6bc1\u6797\u98ce\u9669\u30022016\u5e74\uff0c\u5728\u4e0e60\u591a\u4f4d\u91d1\u878d\u884c\u4e1a\u4e13\u4e1a\u4eba\u58eb\u78cb\u5546\u540e\uff0cWRI\u53d1\u5e03\u4e86GFW Finance\u5e94\u7528\u7a0b\u5e8f\u539f\u578b\u3002\u8bb8\u591a\u5927\u5b97\u5546\u54c1\u516c\u53f8\u548c\u91d1\u878d\u673a\u6784\u5bf9\u8fd9\u4e24\u4e2a\u5e94\u7528\u7a0b\u5e8f\u8868\u73b0\u51fa\u4e86\u6781\u5927\u7684\u5174\u8da3\u548c\u9700\u6c42\u3002&nbsp;", "b9bf93f173e7f2a1a5b6af9cb3f4732e": "\u65b0\u95fb\u7a3f", "e632a4f54c5f21644e474d9d5c014290": "GFW Pro\u5982\u4f55\u786e\u4fdd\u6211\u7684\u6570\u636e\u5b89\u5168\uff1f", "77954edfca9594cd722462a040fba5f0": "GFW Pro\u517c\u5bb9\u6700\u65b0\u4e24\u7248\u7684Google Chrome\u3001Mozilla Firefox\u548cMicrosoft Edge\u3002\u60a8\u5fc5\u987b\u4f7f\u7528\u5176\u4e2d\u4e00\u79cd\u6d4f\u89c8\u5668\u624d\u80fd\u8bbf\u95eePro\u3002&nbsp;", "a9787fa9e695d7a3eecbee713ff19c58": "GFW Pro\u91c7\u7528\u4e00\u6d41\u505a\u6cd5\uff0c\u786e\u4fdd\u7cfb\u7edf\u5404\u65b9\u9762\u53ca\u5176\u7528\u6237\u6570\u636e\u7684\u5b8c\u6574\u6027\u548c\u5b89\u5168\u6027\u3002\u4e86\u89e3\u66f4\u591a\u5173\u4e8e\u5176\u5b89\u5168\u6027\u7684\u4fe1\u606f", "75cdcaf3f0607520f1534e43b96173d7": "\u672c\u5e94\u7528\u7a0b\u5e8f\u57fa\u4e8e\u4e00\u6d41\u7684\u5373\u65f6\u6570\u636e\u6253\u9020\uff0c\u6570\u636e\u6765\u81ea", "fee2b7ea79e91064452ba380b3463a79": "\u5141\u8bb8\u5728\u4e0d\u540c\u5b9e\u4f53\u4e4b\u95f4\u5171\u4eab\u548c\u62a5\u544a\u6709\u5173\u8d44\u4ea7\u7ec4\u5408\u7684\u4fe1\u606f\u3002", "e71ad5486935b36dbde56b2b5a337838": "\u8bf7\u770b\u8fd9\u4e2a", "f7abfc2577020c096befa91ab77dab81": "GFW Pro\u535a\u5ba2", "31d9e2f0d456bec3ad5bb19027fe7eb5": "GFW Pro\u80fd\u4e3a\u60a8\u505a\u4ec0\u4e48\uff1f", "c6cdad11b4e8ef2e6d3dafe4f26bfd8b": "\u94f6\u884c\u5bb6&nbsp;", "a2ff98f42b1d074d66de565d142c2ac0": "\u5728GFW Pro\u4e2d\u521b\u5efa\u6295\u8d44\u5730\u70b9\u7ec4\u5408\uff0c\u6839\u636e\u5730\u70b9\u7c7b\u578b\u8fdb\u884c\u91cf\u8eab\u5b9a\u5236\u7684\u7b5b\u67e5\u3002&nbsp;", "c577f2a7849ea64e25e09ad5213a0a6f": "\u5982\u679c\u6211\u7684\u4e34\u65f6\u5bc6\u7801\u6709\u95ee\u9898\uff0c\u6211\u8be5\u600e\u4e48\u529e\uff1f", "6875662bec691c6918f525dcafa4c45a": "\u81f3\u5c111\u4e2a\u5927\u5199\u5b57\u6bcd", "294b587bb8485d0e624a0002a0447a72": "\u81f3\u5c111\u4e2a\u6570\u5b57\u5b57\u7b26", "5056062955c63f74fe93625a923c1f2b": "GFW Pro\u662f\u4e00\u4e2a\u7ba1\u7406\u7cfb\u7edf\uff0c\u4f9b\u516c\u53f8\u548c\u94f6\u884c\u4f7f\u7528\uff0c\u5c06\u5730\u7406\u7a7a\u95f4\u6570\u636e\u8f6c\u5316\u4e3a\u5207\u5b9e\u53ef\u884c\u7684\u89c1\u89e3\u3002\u5982\u679c\u60a8\u5e0c\u671b\u4e00\u6b21\u4e0a\u4f20\u548c\u5206\u6790\u591a\u8fbe1,500\u4e2a\u5730\u70b9\uff0c\u4ee5\u8fd1\u5b9e\u65f6\u65b9\u5f0f\u6216\u5728\u591a\u5e74\u65f6\u95f4\u8de8\u5ea6\u5185\u5b89\u5168\u5730\u76d1\u63a7\u60a8\u7684\u4f9b\u5e94\u94fe\u548c\u6295\u8d44\uff0c\u6216\u62a5\u544a\u843d\u5b9e\u96f6\u6bc1\u6797\u627f\u8bfa\u7684\u8fdb\u5c55\uff0cGFW Pro\u53ef\u80fd\u662f\u60a8\u7684\u7406\u60f3\u5de5\u5177\u3002\u8bf7\u770b", "e80427c1481ba68e5d83ecd9910b77f9": "\u4e86\u89e3\u516c\u53f8\u5982\u4f55\u4f7f\u7528GFW Pro\u3002&nbsp;", "9d53325a8b911407d17996e80e593a5b": "\u6211\u53ef\u4ee5\u5171\u4eab\u6211\u7684GFW Pro\u8d26\u53f7\u4e2d\u7684\u4fe1\u606f\u5417\uff1f", "543b5872bc780d1a7c93243e2cfe1b55": "GFW Pro\u65e8\u5728\u6210\u4e3a\u4f9b\u5e94\u94fe\u76d1\u63a7\u7684\u4e00\u7ad9\u5f0f\u5e73\u53f0\uff0c\u670d\u52a1\u5404\u7c7b\u7528\u6237\uff0c\u4ece\u5e0c\u671b\u76d1\u63a7\u98ce\u9669\u548c\u8d8b\u52bf\u7684\u5168\u7403\u7528\u6237\uff0c\u5230\u5e0c\u671b\u6839\u636e\u8fd1\u5b9e\u65f6\u8b66\u62a5\u91c7\u53d6\u884c\u52a8\u7684\u672c\u5730\u5229\u76ca\u6538\u5173\u65b9\u3002\u6211\u4eec\u8ba1\u5212\u63a2\u7d22\u66f4\u591a\u611f\u5174\u8da3\u7684\u6570\u636e\u5c42\uff0c\u5e76\u5c06\u7ee7\u7eed\u56f4\u7ed5\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u3001\u66f4\u597d\u7684\u53ef\u8ffd\u6eaf\u6027\u548c\u793e\u4f1a\u98ce\u9669\u6307\u6807\u8fdb\u884c\u7814\u53d1\u3002GFW Pro\u6b63\u5728\u542f\u52a8\u7814\u7a76\uff0c\u4ee5\u91cf\u5316\u76d1\u63a7\u5bf9\u51cf\u5c11\u6bc1\u6797\u7684\u5f71\u54cd\u3002GFW Pro\u5c06\u7ee7\u7eed\u4f7f\u76d1\u63a7\u548c\u62a5\u544a\u6bc1\u6797\u548c\u571f\u5730\u4f7f\u7528\u60c5\u51b5\u53d8\u5f97\u524d\u6240\u672a\u6709\u5730\u7b80\u5355\u3002", "7992b91f14840fbc34f8245220ee6f09": "\u5236\u5b9a\u73af\u5883\u8ba1\u5212\u4ee5\u51cf\u8f7b\u98ce\u9669\u3001\u76d1\u63a7\u7ee9\u6548\u3002&nbsp;", "db97bf3d0c5858cb56855e07be0e6edd": "\u751f\u4ea7\u5546&nbsp;", "ee30ab0e034fd8fc053a956271832472": "\u5728GFW Pro\u4e2d\u521b\u5efa\u751f\u4ea7\u533a\u57df\u7ec4\u5408\uff08\u5982\u5927\u8c46\u519c\u573a\u3001\u68d5\u6988\u6cb9\u7279\u8bb8\u7ecf\u8425\u533a\uff09\u3002&nbsp;", "4efdd3ddaa39a1cfa2785fbfd3e4f295": "\u5728GFW Pro\u4e2d\u521b\u5efa\u4ece\u4f9b\u5e94\u5546\u5904\u83b7\u5f97\u7684\u751f\u4ea7\u5730\u70b9\u7ec4\u5408\u3002", "205e05d88f90f13d39f4acc9a92f9b7e": "\u5728\u4f9b\u5e94\u94fe\u4e2d\u786e\u5b9a\u4f18\u5148\u533a\u57df\uff0c\u4ee5\u9075\u5b88EUDR\u3001\u575a\u6301\u96f6\u6bc1\u6797\u627f\u8bfa\u3002", "173cfd17301ff0ea77dbf766fa35dc4f": "\u4e0a\u4f20\u5e76\u76d1\u63a7\u4ece\u4f9b\u5e94\u5546\u5904\u83b7\u5f97\u7684\u751f\u4ea7\u5730\u70b9\u7ec4\u5408\u3002", "446f47b726d10c3658aad553260e67f6": "\u5728\u60a8\u7684\u4f9b\u5e94\u4f53\u7cfb\u5185\u786e\u5b9a\u4f18\u5148\u533a\u57df\uff0c\u4ee5\u652f\u6301\u96f6\u6bc1\u6797\u627f\u8bfa\u3002", "69d727385ff236c22bbf1599855d7e52": "\u751f\u6548\u65e5\u671f\uff1a2024\u5e745\u670825\u65e5 GFW Pro\u5957\u9910\u548c\u4ef7\u683c \u9664\u4e0a\u8ff0\u5957\u9910\u5916\uff0cGFW Pro\u4f1a\u5458\u8d44\u683c\u8fd8\u5305\u62ec\u57fa\u4e8eAPI\u7684\u8bbf\u95ee\u3001\u65e0\u9650\u5236\u7684\u76d1\u63a7\u5730\u70b9\u5206\u6790\u3001\u4e0e\u5176\u4ed6GFW Pro\u4f1a\u5458\u65e0\u9650\u5236\u5730\u5171\u4eab\u5206\u6790\u7ed3\u679c\u3001\u5904\u7406\u516c\u9877\u6570\u548c\u5206\u8bb8\u53ef\u6743\u7684\u6298\u6263\uff0c\u4ee5\u53ca\u5176\u4ed6\u798f\u5229\u3002\u5982\u9700\u8ba2\u8d2d\u6216\u4e86\u89e3\u66f4\u591a\u4fe1\u606f[...]", "823c4e34650ae83cc2eda49a60ed32d0": "\u751f\u6548\u65e5\u671f\uff1a2024\u5e748\u670830\u65e5\u3002", "2cf2d73fba28fda6680b9ecee264fb6b": "GFW Pro\u5957\u9910\u548c\u4ef7\u683c", "326e644cb12b73e70c4068396e1c37c3": "\u9664\u4e0a\u8ff0\u5957\u9910\u5916\uff0cGFW Pro\u4f1a\u5458\u8d44\u683c\u8fd8\u5305\u62ec\u57fa\u4e8eAPI\u7684\u8bbf\u95ee\u3001\u65e0\u9650\u5236\u7684\u76d1\u63a7\u5730\u70b9\u5206\u6790\u3001\u4e0e\u5176\u4ed6GFW Pro\u4f1a\u5458\u65e0\u9650\u5236\u5730\u5171\u4eab\u5206\u6790\u7ed3\u679c\u3001\u5904\u7406\u516c\u9877\u6570\u548c\u5206\u8bb8\u53ef\u6743\u7684\u6298\u6263\uff0c\u4ee5\u53ca\u5176\u4ed6\u798f\u5229\u3002\u5982\u9700\u8ba2\u8d2d\u6216\u4e86\u89e3\u66f4\u591a\u5173\u4e8eGFW Pro\u4f1a\u5458\u8d44\u683c\u7684\u4fe1\u606f\uff0c\u8bf7\u8054\u7cfb<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">GFWPROsales@wri.org</a>\u3002&nbsp\uff1b", "81b7a9813b9a54ba3ce5f1d9163177f1": "\u6bc1\u6797\u62a5\u544a\uff08\u622a\u81f32020\u5e74\uff09<em>\u6d4b\u8bd5\u7248</em>", "0d41488733327198e1537a321bf098b2": "\u8fd1\u5b9e\u65f6\u8b66\u62a5", "8c160b984adef1009c3bc10d8f1f6540": "\u8bc6\u522b\u4f9b\u5e94\u94fe\u4e2d\u5b58\u5728\u98ce\u9669\u7684\u533a\u57df\uff0c\u8bc4\u4f30\u662f\u5426\u9075\u5b88EUDR\uff0c\u6216\u8bc4\u4f30\u96f6\u6bc1\u6797\u627f\u8bfa\u7684\u8fdb\u5c55\u3002", "dc312399d03b3e223129c08e748a6610": "\u6d88\u8d39\u54c1\u5236\u9020\u5546&nbsp;", "7d9166a4b636547bad54c4889f73a300": "\u8bc6\u522b\u6574\u4e2a\u4f9b\u5e94\u4f53\u7cfb\u4e2d\u5b58\u5728\u98ce\u9669\u7684\u533a\u57df\uff0c\u76d1\u63a7\u662f\u5426\u9075\u5b88EUDR\uff0c\u76d1\u63a7\u4f9b\u5e94\u5546\u96f6\u6bc1\u6797\u76ee\u6807\u7684\u8fdb\u5c55\u3002", "18cb9e1b7b246589472f0f234590f0f9": "\u7528\u6237\u53ef\u4ee5\u4f7f\u7528GFW Pro\u76d1\u63a7\u4efb\u4f55\u611f\u5174\u8da3\u7684\u5927\u5b97\u5546\u54c1\u3002\u6211\u4eec\u8fd8\u63d0\u4f9b\u725b\u3001\u5927\u8c46\u3001\u53ef\u53ef\u3001\u68d5\u6988\u6cb9\u7684\u6570\u636e\u4e0a\u4f20\u6a21\u677f\uff0c\u53ef\u76f4\u63a5\u4ece\u7cfb\u7edf\u5185\u4e0b\u8f7d\u3002&nbsp;", "1eba135716173be82bbf8ce41ed8c647": "\u6211\u53ef\u4ee5\u4f7f\u7528GFW Pro\u76d1\u63a7\u4ec0\u4e48\u5927\u5b97\u5546\u54c1\uff1f", "f1b3d9d7c778c3b80bd08cc6f3434fc2": "Global Forest Watch Pro\u4ef7\u683c\u8868", "f73a8419c66dccaa09669f87fe14f917": "Global Forest Watch Pro\u8bb8\u53ef\u534f\u8bae", "97fe029b4aa8708d82c97f1feb05d16b": "Global Forest Watch Pro\u4ef7\u683c\u8868", "d069e722322984d247e0f3a02062edd1": "Global Forest Watch Pro\u4ef7\u683c\u8868&nbsp;", "d260776c5399f8bcafff09f18440e07e": "\u751f\u6548\u65e5\u671f\uff1a2024\u5e745\u670825\u65e5", "5cb7fa05a0d00b8c0be6d6f9cc45676e": "\u5217\u8868\u5206\u6790", "7ae840d0b674897bfb690ae29ff347a3": "\u5982\u4e0b\u6240\u8ff0\uff0cGFW Pro\u63d0\u4f9b\u51e0\u79cd\u4e0d\u540c\u7c7b\u578b\u7684\u5206\u6790\uff0c\u53ef\u5728\u5305\u542b\u4e00\u4e2a\u6216\u591a\u4e2a\u5730\u70b9\u7684\u5217\u8868\u4e0a\u8fd0\u884c\uff0c\u6bcf\u79cd\u7c7b\u578b\u5747\u4e3a\u5217\u8868\u5206\u6790\u3002&nbsp;\u968f\u7740\u65f6\u95f4\u63a8\u79fb\uff0c\u5206\u6790\u7c7b\u578b\u8fd8\u4f1a\u7ee7\u7eed\u589e\u52a0\u3002\u6bcf\u4e2a\u5217\u8868\u5206\u6790\u7684\u8be6\u7ec6\u6570\u636e\u53ef\u4ee5\u4eceGFW Pro\u5e94\u7528\u7a0b\u5e8f\u4e0b\u8f7dCSV\u683c\u5f0f\u6587\u4ef6\uff0c\u4e5f\u53ef\u4ee5\u901a\u8fc7API\u83b7\u53d6\uff0c\u4ee5\u4fbf\u4e0e\u5176\u4ed6\u6570\u636e\u6e90\u7ed3\u5408\uff0c\u8fdb\u884c\u8fdb\u4e00\u6b65\u5206\u6790\u3002&nbsp;", "ba5e19fe205e1733f9e2f42fe0f10439": "\u5bf9\u4e8e\u7528\u6237\u6240\u9009\u5730\u70b9\uff0c\u672c\u5206\u6790\u6839\u636eScience Based Targets Network\uff08SBTN\uff09<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u81ea\u7136\u571f\u5730\u5730\u56fe</a>\u91cf\u5316\u4e86\u622a\u81f32020\u5e74\u7684\u81ea\u7136\u68ee\u6797\u4ee5\u53ca2020\u5e74\u540e\u8fd9\u4e9b\u81ea\u7136\u68ee\u6797\u533a\u57df\u5185\u6797\u6728\u690d\u88ab\u7684\u635f\u5931\u3002\u6839\u636eAccountability Framework initiative\uff08AFi\uff09\u5173\u4e8e\u65e0\u6bc1\u6797\u91c7\u8d2d\u5b9e\u8df5\u7684\u6307\u5357\u548cEuropean Union Deforestation Regulation\uff08<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">EUDR</a>\uff09\u4e2d\u5173\u4e8e\u91c7\u8d2d\u65e0\u6bc1\u6797\u4ea7\u54c1\u7684\u89c4\u5b9a\uff0c\u519c\u4e1a\u5927\u5b97\u5546\u54c1\u91c7\u8d2d\u533a\u57df\u5185\u81ea\u7136\u68ee\u6797\u7684\u780d\u4f10\u662f\u4e00\u9879\u6bc1\u6797\u6307\u6807\u3002\u672c\u62a5\u544a\u76ee\u524d\u5904\u4e8e\u201c\u6d4b\u8bd5\u7248\u201d\u72b6\u6001\uff0c\u7b49\u5f851.0\u7248\u672c\u7684SBTN\u81ea\u7136\u571f\u5730\u5730\u56fe\u6700\u7ec8\u5b8c\u6210\u540e\u5c06\u5176\u7eb3\u5165\u3002&nbsp;", "70133036289488087901d04598e20477": "<strong>\u884c\u653f\u533a\u57df</strong>\uff1a\u5168\u7403\u6240\u6709\u56fd\u5bb6\u3001\u5dde\u548c\u6b21\u7ea7\u5dde\u3002", "b082c83396e166144cb79abf178d619f": "\u6211\u80fd\u5c06\u81ea\u5df1\u7684\u6570\u636e\u4e0a\u4f20\u81f3GFW Pro\u5417\uff1f", "819fc5a490719a137f7d0f21e52b49e8": "\u60a8\u53ef\u4ee5\u5728\u56e2\u961f\u548c\u66f4\u5927\u8303\u56f4\u7684\u7ec4\u7ec7\u5185\u90e8\u5171\u4eab\u6570\u636e\u548c\u5206\u6790\u7ed3\u679c\u3002", "ba21fda39101b757e277e698674cdc3e": "GFW Pro\u7684\u613f\u666f\u662f\u4ec0\u4e48\uff1f", "64d43029c225a6fec4245ed85b39f29f": "\u901a\u8fc7GFW Pro\u4e0e\u540c\u4e8b\u5171\u4eab\u68ee\u6797\u98ce\u9669\u8bc4\u4f30\uff0c\u4ece\u540c\u4e8b\u5904\u83b7\u5f97\u4f18\u5148\u5730\u70b9\u3002&nbsp;", "1356a55b7eaade071db64070b6ef6a84": "\u53d1\u73b0\u4e0e\u5408\u89c4\u76f8\u5173\u7684\u68ee\u6797\u65b9\u9762\u89c1\u89e3\uff0c\u4ee5\u8bc4\u4f30\u98ce\u9669\u3001\u786e\u5b9a\u4f18\u5148\u6b21\u5e8f\u3002&nbsp;", "c65e83ff51faf501673268526c9fa742": "\u76d1\u63a7\u751f\u4ea7\u533a\u57df\u7684\u68ee\u6797\u780d\u4f10\u6216\u706b\u707e\u6d3b\u52a8\u3002&nbsp;", "30c8f360d6271f71d73e28ca37007ab1": "\u6807\u51fa\u5b58\u5728\u4ee4\u4eba\u62c5\u5fe7\u7684\u68ee\u6797\u780d\u4f10\u6216\u706b\u707e\u6d3b\u52a8\u7684\u751f\u4ea7\u533a\u57df\uff0c\u4ee5\u4fbf\u4f18\u5148\u4ecb\u5165\u3001\u91c7\u53d6\u7f13\u89e3\u63aa\u65bd\u3002&nbsp;", "39f7462615a7121d3bc2ebb1efe100a4": "\u4e0e\u540c\u4e8b\u6216\u4e70\u5bb6\u5171\u4eab\u8bc4\u4f30\u7ed3\u679c\u53ca\u51cf\u5c11\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u6d3b\u52a8\u7684\u8fdb\u5c55\u3002&nbsp;", "079acbb7e0065b546c214232b4ead60d": "\u5927\u5b97\u5546\u54c1\u4ea4\u6613\u5546&nbsp\uff1b", "7162384dbfe2af9cb8b282af558435f9": "\u5411\u540c\u4e8b\u53d1\u9001\u7efc\u5408\u98ce\u9669\u548c\u8fdb\u5c55\u8bc4\u4f30\uff0c\u4e3a\u4e70\u5bb6\u751f\u6210\u62a5\u544a\u3002\u5c06\u5176\u7eb3\u5165EUDR\u5c3d\u804c\u8c03\u67e5\u6d41\u7a0b\u3002", "44c41fa0dd4ce45c8fa415c0364a8573": "\u4e0d\u5305\u542b\u8fde\u7eed\u5b57\u7b26", "1b3e336c3388f8c4bdc7e43c5549fa26": "\u57282017\u5e741\u6708\u4e3e\u884c\u7684\u4e16\u754c\u7ecf\u6d4e\u8bba\u575b\u5e74\u4f1a\u4e0a\u3002", "d2468afd88b1adbe61add0429f97ca42": "\u5efa\u8bae\u4f7f\u7528\u4e0a\u4f20\u548c\u4e0b\u8f7d\u901f\u5ea6\u81f3\u5c11\u4e3a10 MBPS\u7684\u6709\u7ebf\u4e92\u8054\u7f51\u8fde\u63a5\u3002\u5728\u6b64\u5904\u6d4b\u8bd5\u60a8\u7684\u901f\u5ea6\uff1a", "097c48b5910864dbf45c0c54f8d5a841": "\u60a8\u53ef\u4ee5\u53c2\u9605\u6211\u4eec\u7684<a href=\"{{0}}\">\u670d\u52a1\u6761\u6b3e</a>\uff0c\u4e86\u89e3\u8d44\u683c\u8981\u6c42\u3002\u5982\u6709\u5176\u4ed6\u95ee\u9898\uff0c\u8bf7\u8054\u7cfb\u6211\u4eec\u7684\u56e2\u961f\uff1a<a href=\"{{1}}\">gfwprosupport@wri.org</a>\u3002", "baf2cd7a465c13788cf8fc6653097b0e": "\u521b\u5efa\u548c\u6301\u6709GFW Pro\u8d26\u53f7\u5747\u514d\u8d39\u3002\u6bcf\u4e2a\u7ec4\u7ec7\u6bcf\u5e74\u53ef\u514d\u8d39\u5bf9\u6bcf\u4e2a\u5730\u70b9\u8fdb\u884c5,000\u6b21\u5206\u6790\uff0c\u5904\u74061\u4ebf\u516c\u9877\u7684\u9762\u79ef\u3002\u4efb\u4f55\u672a\u4f7f\u7528\u7684\u514d\u8d39\u989d\u5ea6\u90fd\u5c06\u5728\u6bcf\u5e74\u66f4\u65b0\u8be5\u989d\u5ea6\u65f6\u8fc7\u671f\u3002\u5bf9\u4e8e\u5927\u591a\u6570\u7ec4\u7ec7\u800c\u8a00\uff0c\u8be5\u514d\u8d39\u989d\u5ea6\u8db3\u591f\u7528\u4e8e\u5185\u90e8\u8fd0\u8425\u3001\u53ef\u6301\u7eed\u6027\u8bc4\u4f30\uff0c\u4ee5\u53ca\u76f4\u63a5\u62a5\u544a\u7ed9\u653f\u5e9c\u76d1\u7ba1\u673a\u6784\u548c\u81ea\u613f\u6027\u627f\u8bfa\u7684\u975e\u8425\u5229\u7ba1\u7406\u8005\u3002\u5982\u9700\u4f7f\u7528\u8d85\u51fa\u5e74\u5ea6\u514d\u8d39\u989d\u5ea6\u7684\u5206\u6790\u6b21\u6570\u548c\u516c\u9877\u6570\uff0c\u6216\u9700\u83b7\u53d6\u5411\u7b2c\u4e09\u65b9\u53d1\u5e03\u3001\u5206\u53d1\u6216\u8f6c\u552eGFW Pro\u5185\u5bb9\u7684\u8bb8\u53ef\uff0c\u5219\u5c06\u6536\u53d6\u8d39\u7528\u3002\u66f4\u591a\u8be6\u60c5\u8bf7\u53c2\u9605\u6211\u4eec\u7684<a href=\"{{0}}\">\u4ef7\u683c\u8868</a>\u3002", "51d29b8f480bc5dec9862138f144d430": "GFW\u5408\u4f5c\u4f19\u4f34", "1f8fdce40b0505d4cfdff08a0696a93b": "\u548cWorld Resources Institute\u7684\u79d1\u5b66\u7814\u7a76\u3002\u6709\u5173GFW\u6570\u636e\u7684\u5177\u4f53\u4fe1\u606f\uff0c\u8bf7\u8bbf\u95ee", "03563c3bb78cf3ccc8eee6bfc7e8ede3": "<strong>\u6cb9\u68d5\u7279\u8bb8\u7ecf\u8425\u533a</strong>\uff1a\u82e5\u5e72\u56fd\u5bb6\u7684\u6cb9\u68d5\u7279\u8bb8\u7ecf\u8425\u533a\u3002", "4ea4a89c972a1f503f5b126327ab4cdb": "<strong>\u4fdd\u62a4\u533a</strong>\uff1aWorld Database on Protected Areas\u4e2d\u53d7\u6cd5\u5f8b\u4fdd\u62a4\u7684\u533a\u57df\uff08\u5982\u56fd\u5bb6\u516c\u56ed\u548c\u91ce\u751f\u52a8\u7269\u4fdd\u62a4\u533a\uff09\uff0c\u6216\u51fa\u4e8e\u4fdd\u62a4\u76ee\u7684\u800c\u53d7\u5230\u7ba1\u7406\u7684\u533a\u57df\u3002\u7531\u4e8e\u4f7f\u7528\u9650\u5236\uff0c\u65e0\u6cd5\u5728GFW Pro\u4ee5\u5916\u4e0b\u8f7d\u4fdd\u62a4\u533a\u6570\u636e\u3002", "c7ec95e6ff88e5ca0735f90d1f871245": "<strong>\u68d5\u6988\u6cb9\u5382</strong>\uff1a\u5168\u7403\u68d5\u6988\u6cb9\u5382\u7684\u884c\u4e1a\u6807\u51c6\u3002", "b0f16c467b9f616836ecb8c0f4071678": "<strong>RSPO\u68d5\u6988\u6cb9\u7279\u8bb8\u7ecf\u8425\u533a</strong>\uff1a \u7ecfRoundtable on Sustainable Palm Oil\u8ba4\u8bc1\u7684\u68d5\u6988\u6cb9\u7279\u8bb8\u7ecf\u8425\u533a\u3002\u7531\u4e8e\u4f7f\u7528\u9650\u5236\uff0c\u65e0\u6cd5\u5728GFW Pro\u4ee5\u5916\u4e0b\u8f7dRSPO\u7279\u8bb8\u7ecf\u8425\u533a\u6570\u636e\u3002", "55c2199e71f0daebaab259f1b7159e55": "\u7528\u6237\u5e94\u7262\u8bb0\uff0cGLAD\u6bc1\u6797\u8b66\u62a5\u53ef\u68c0\u6d4b\u6240\u6709\u7c7b\u578b\u7684\u6797\u6728\u690d\u88ab\u635f\u5931\uff0c\u65e0\u8bba\u5176\u662f\u7531\u4eba\u4e3a\uff08\u5982\u4f10\u6728\uff09\u8fd8\u662f\u81ea\u7136\u539f\u56e0\uff08\u5982\u5c71\u4f53\u6ed1\u5761\uff09\u5bfc\u81f4\u3002\u8b66\u62a5\u4e0d\u533a\u5206\u81ea\u7136\u6797\u6728\u690d\u88ab\u548c\u4eba\u5de5\u6797\u6728\u690d\u88ab\u3002\u9274\u4e8e\u8b66\u62a5\u7684\u9884\u671f\u6700\u7ec8\u7528\u9014\u662f\u5b9e\u5730\u5de1\u903b\uff0c\u56e0\u6b64\u5176\u8bbe\u8ba1\u4e5f\u8f83\u4e3a\u4fdd\u5b88\uff08\u5df2\u786e\u8ba4\u8b66\u62a5\u7684\u8bef\u62a5\u7387\u4e3a1%\uff0c\u800c\u6f0f\u62a5\u7387\u4e3a33%\uff09\u3002\u6700\u540e\uff0c\u867d\u7136\u8b66\u62a5\u6bcf\u5468\u66f4\u65b0\uff0c\u4f46\u6301\u7eed\u7684\u4e91\u5c42\u53ef\u80fd\u610f\u5473\u7740\u5728\u6bc1\u6797\u884c\u4e3a\u53d1\u751f\u540e\u7684\u51e0\u5468\u751a\u81f3\u51e0\u4e2a\u6708\u5185\u90fd\u65e0\u6cd5\u68c0\u6d4b\u5230\u8b66\u62a5\u3002\u6709\u5173GLAD\u6bc1\u6797\u8b66\u62a5\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605\u6211\u4eec\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">GLAD\u6bc1\u6797\u8b66\u62a5\u8be6\u89e3\u535a\u5ba2</a>\u3002&nbsp;", "ccbb42aa26afeed9521eb03a6cc7d2db": "\u751f\u6210\u9002\u7528\u4e8e\u62a5\u544a\u7684\u8bca\u65ad\u4fe1\u606f\u3002", "c08206cf87ff4820b61c06d8cc18a583": "\u8c01\u5728\u4f7f\u7528GFW Pro\uff1f", "a15709257e73090d1072119a988b31e8": "\u4e86\u89e3\u516c\u53f8\u5982\u4f55\u4f7f\u7528GFW Pro", "980f6bb120424a33b8bfb117f867acbc": "Mondel\u0113z International\u4f7f\u7528GFW Pro\u4e2d\u7684\u68ee\u6797\u53d8\u5316\u6570\u636e\u76d1\u63a7\u5176\u6574\u4e2a\u4f9b\u5e94\u94fe\u4e2d\u4e0e\u53ef\u53ef\u548c\u68d5\u6988\u76f8\u5173\u7684\u6bc1\u6797\u884c\u4e3a\u3002", "4c03ceaf348c6e93c039f6ae54340d82": "\u4f7f\u7528GFW Pro\uff0c\u516c\u53f8\u53ef\u4ee5\u901a\u8fc7\u4e13\u4e3a\u5927\u5b97\u5546\u54c1\u516c\u53f8\u548c\u94f6\u884c\u7684\u65e5\u5e38\u8fd0\u8425\u8bbe\u8ba1\u7684\u5206\u6790\u548c\u63a7\u5236\u9762\u677f\u8f7b\u677e\u7ba1\u7406\u5730\u7406\u7a7a\u95f4\u6570\u636e\u3002GFW Pro\u514d\u8d39\u4f9b\u6240\u6709\u4eba\u4f7f\u7528\uff0c\u5b83\u5c06\u590d\u6742\u7684\u5927\u5b97\u5546\u54c1\u4f9b\u5e94\u94fe\u4e2d\u7684\u7528\u6237\u51dd\u805a\u5728\u4e00\u8d77\uff0c\u91c7\u7528\u5171\u540c\u65b9\u6cd5\u91cf\u5316\u548c\u7ba1\u7406\u843d\u5b9e\u96f6\u6bc1\u6797\u627f\u8bfa\u7684\u8fdb\u5c55\uff0c\u9075\u5b88\u627f\u8bfa\uff0c\u5c55\u793a\u76d1\u7ba1\u5408\u89c4\u6027\u3002", "9bff3e332b4cdac5b2cb33faafe15398": "\u8d85\u8fc715\u5bb6\u9886\u5148\u516c\u53f8\u3001\u91d1\u878d\u673a\u6784\u548cNGO\u6b63\u5f0f\u8ba4\u53ef\u4e86GFW Pro\u7684\u613f\u666f\uff0c\u5373", "794df3791a8c800841516007427a2aa3": "\u8bb8\u53ef", "930cb9490725a9eca3271aeb4475faef": "GFW Pro\u662f\u4e00\u4e2a\u5728\u7ebf\u7ba1\u7406\u5e94\u7528\u7a0b\u5e8f\uff0c\u4e3a\u51cf\u5c11\u5927\u5b97\u5546\u54c1\u4f9b\u5e94\u94fe\u4e2d\u7684\u6bc1\u6797\u884c\u4e3a\u63d0\u4f9b\u652f\u6301\u3002GFW Pro\u5728\u5730\u4ea7\u3001\u4f9b\u5e94\u533a\u57df\u548c\u6295\u8d44\u7ec4\u5408\u5c42\u9762\u63d0\u4f9b\u5173\u952e\u51b3\u7b56\u5206\u6790\u3002\u65e0\u8bba\u7528\u6237\u662f\u5927\u5b97\u5546\u54c1\u73b0\u573a\u4eba\u5458\u8fd8\u662f\u8d22\u52a1\u9996\u5e2d\u98ce\u9669\u5b98\uff0c\u672c\u5e73\u53f0\u90fd\u80fd\u52a9\u529b\u5176\u7ba1\u7406\u548c\u76d1\u63a7\u6bc1\u6797\u98ce\u9669\u7684\u53d8\u5316\u3002&nbsp;&nbsp;", "e4b128e4d1b05968ecfec517cde0e651": "\u6b63\u5f0f\u63a8\u51fa", "8874e28db135428c7b0fbfaca8862d71": "\u8c01\u6709\u8d44\u683c\u83b7\u5f97GFW Pro\u8d26\u53f7\uff1f", "3ebc4c169a14323d867f371f8b0efd23": "\u4e00\u822c\u54a8\u8be2\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3", "e986a789e39f9560cad541789c418af7": "GFW Pro\u7684\u6838\u5fc3\u529f\u80fd\u662f\u4ec0\u4e48\uff1f", "a19b67485c2029d2ddfa246fbe0fecb5": "\u5982\u679c\u5927\u578b\u8d44\u4ea7\u7ec4\u5408\u4e2d\u7684\u67d0\u4e9b\u5185\u5bb9\u53d1\u751f\u53d8\u5316\uff0c\u53ef\u67e5\u770b\u8fd1\u5b9e\u65f6\u8b66\u62a5\u3002&nbsp;", "d6d5fafb8e4491cf48bd1ae46df207e0": "\u5728\u6574\u4e2a\u7ec4\u7ec7\u5185\u5171\u4eab\u7ec4\u5408\u3001\u534f\u8c03\u91c7\u8d2d\u51b3\u7b56\u3002\u5c06\u5176\u7eb3\u5165EUDR\u5c3d\u804c\u8c03\u67e5\u6d41\u7a0b\u3002", "735c54d5b38122169314bc94edd0054c": "\u5728\u6bcf\u4e2a\u5e74\u5ea6\u66f4\u65b0\u65e5\uff08\u901a\u5e38\u662f\u521b\u5efaGFW Pro\u8d26\u53f7\u7684\u5468\u5e74\u7eaa\u5ff5\u65e5\uff09\uff0c\u4f01\u4e1a\u8d26\u53f7\u5c06\u83b7\u5f97\u65b0\u7684\u514d\u8d39\u4f7f\u7528\u989d\u5ea6\uff0c\u5177\u4f53\u5982\u4e0b\uff1a&nbsp;", "e2ca35bb6b877586e634e0ee58ca396e": "\u5bf9MLA\u8fdb\u884c\u5206\u8bb8\u53ef\u4ee5\u4f9b\u5206\u53d1\u548c\u8f6c\u552e", "84bd415e590e660b6cacac6e3013149d": "GFW Pro\u4ef7\u683c\u8868v1.0", "484957d0998a1d5ec5b075b796b55b11": "\u5982\u60a8\u4ecd\u6709\u95ee\u9898\uff0c\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3<a href=\"{{0}}\">gfwprosupport@wri.org</a>\uff0c\u9644\u4e0a\u60a8\u7684\u6d4f\u89c8\u5668\u7c7b\u578b\u3001\u7248\u672c\u3001\u7f51\u901f\uff0c\u4ee5\u53ca\u60a8\u6536\u5230\u7684\u4efb\u4f55\u9519\u8bef\u6d88\u606f\u7684\u5c4f\u5e55\u622a\u56fe\u3002", "41cd9c716eaa49e15430f9c92061c41f": "GFW Pro\u5e2e\u52a9Mondel\u0113z International\u8f7b\u677e\u4e86\u89e3\u54ea\u91cc\u53d1\u751f\u4e86\u4e0e\u6cb9\u68d5\u76f8\u5173\u7684\u6bc1\u6797\u884c\u4e3a\uff0c\u786e\u5b9a\u5176\u4f9b\u5e94\u5546\u662f\u5426\u4e0e\u6bc1\u6797\u6709\u5173\uff0c\u5e76\u91c7\u53d6\u884c\u52a8\u6d88\u9664\u4e0d\u826f\u505a\u6cd5\u3002", "5bc5e1500a148526ba0bb305eb1a9416": "GFW Pro\u4e0a\u6bc1\u6797\u548c\u706b\u707e\u8b66\u62a5\u7684\u51c6\u786e\u6027\u5982\u4f55\uff1f", "1290b86106d7aaedce5a77ba1dd0b669": "\u57fa\u4e8e\u6d88\u8017\u7684\u8d39\u7528", "1c784e6127e3f98af585f8265bad99e3": "\u53d1\u73b0\u4e0e\u4fdd\u62a4\u533a\u91cd\u53e0\u7684\u533a\u57df\uff08\u662f/\u5426\uff09\uff1b&nbsp;", "2f30403cc5090ca2ef26ee01896f714e": "2020\u5e74\u540e\u53d1\u73b0\u81ea\u7136\u68ee\u6797\u635f\u5931\uff08\u662f/\u5426\uff09\uff1b\u53ca&nbsp;", "286a1795b090641164b2d9610f4e66d0": "\u81ea\u4e0a\u6b21\u5168\u7403\u6797\u6728\u690d\u88ab\u635f\u5931\u62a5\u544a\u4ee5\u6765\u53d1\u73b0\u6bc1\u6797\u8b66\u62a5\uff08\u662f/\u5426\uff09\u3002&nbsp;", "e9a6efb363bd501194a800d6aff5e706": "\u83b7\u5f97\u5206\u8bb8\u53ef\u6743\u5e76\u5c06\u5176\u5206\u914d\u7ed9\u67d0\u4e2a\u660e\u786e\u7684\u91c7\u8d2d\u5730\u70b9\u540e\uff0c\u5728\u968f\u540e\u7684\u4e00\u5e74\u5185\uff0c\u5982\u679c\u539f\u59cb\u7ed3\u8bba\uff08\u65e0\u8bba\u662f\u5b9a\u91cf\u7ed3\u8bba\u8fd8\u662f\u6458\u8981\u6027\u7684\u201c\u662f/\u5426\u201d\u7ed3\u8bba\uff09\u4fdd\u6301\u4e0d\u53d8\u3001\u51fa\u5904\u4e5f\u4fdd\u6301\u4e0d\u53d8\uff0c\u4e14\u6240\u6709\u4e0b\u6e38\u63a5\u6536\u65b9\u90fd\u9075\u5b88\u76f8\u540c\u7684\uff08\u4e0d\u505a\u4fee\u6539\u5e76\u6ce8\u660e\u51fa\u5904\uff09\u8981\u6c42\uff0c\u5219\u53ef\u4e0e\u6570\u91cf\u4e0d\u9650\u7684\u7b2c\u4e09\u65b9\u5171\u4eab\u76f8\u5173GFW Pro\u8f93\u51fa\u7ed3\u679c\u3002\u5728\u4e00\u5e74\u7684\u5206\u8bb8\u53ef\u671f\u7ed3\u675f\u540e\uff0c\u5728\u6709\u6548\u7684\u5206\u8bb8\u53ef\u671f\u5185\u4ea7\u751f\u7684\u8fc7\u5f80\u5185\u5bb9\u53ef\u4ee5\u7ee7\u7eed\u5171\u4eab\u3002&nbsp;", "9af740bda1dd27427a3b4f2f44213ee1": "<strong>\u5b58\u5728\u5b9e\u8d28\u6027\u533a\u522b\u7684\u884d\u751f\u5185\u5bb9\uff08\u6539\u7f16\u5185\u5bb9\uff09\u53ef\u4ee5\u516c\u5f00\u5171\u4eab</strong>\u3002\u6539\u7f16\u4e0d\u5e94\u4ec5\u662f\u5bf9GFW Pro\u5185\u5bb9\u8c03\u6574\u5927\u5c0f\u3001\u88c1\u526a\u3001\u6458\u5f55\u3001\u820d\u5165\u3001\u603b\u7ed3\u3001\u91cd\u65b0\u6392\u5217\u3001\u7ffb\u8bd1\u6216\u8f6c\u6362\u4e3a\u4e0d\u540c\u5a92\u4ecb\u3002\u6539\u7f16\u5fc5\u987b\u662f\u5b58\u5728\u5b9e\u8d28\u6027\u533a\u522b\u7684\u5185\u5bb9\uff0c\u5305\u542b\u5b58\u5728\u663e\u8457\u533a\u522b\u7684\u5206\u6790\u65b9\u6cd5\uff0c\u6216\u5305\u542b\u4f01\u4e1a\u81ea\u8eab\u6570\u636e\u6216\u4f01\u4e1a\u4ece\u5176\u4ed6\u6765\u6e90\u83b7\u5f97\u5e76\u6388\u6743\u7684\u6570\u636e\u3002\u5728\u6ce8\u660e\u51fa\u5904\u4e14\u9075\u5b88GFW Pro\u8bb8\u53ef\u534f\u8bae\u89c4\u5b9a\u7684\u524d\u63d0\u4e0b\uff0c\u8fd9\u4e9b\u884d\u751f\u5185\u5bb9\u53ef\u4ee5\u5728\u62a5\u544a\u4e2d\u53d1\u5e03\uff0c\u5e76\u516c\u5f00\u4f9b\u4e1a\u52a1\u548c\u4f9b\u5e94\u94fe\u5408\u4f5c\u4f19\u4f34\u53c2\u8003\u3002GFW Pro\u8bb8\u53ef\u534f\u8bae\u4e2d\u89c4\u5b9a\u7684\u9650\u5236\u6761\u4ef6\u9002\u7528\u3002&nbsp;", "cc9fa33684afce9cf6582819a1eb460c": "1\u4ebfHOP&nbsp;", "e25675eb18eefc7b11ccf668f98908e0": "5,000 MLA&nbsp;", "fd0bd0b91db44d8198ba5398fda26fe6": "\u786e\u8ba4\u60a8\u7684\u65b0\u6c38\u4e45\u5bc6\u7801\u7b26\u5408\u4ee5\u4e0b<strong>\u6240\u6709</strong>\u8981\u6c42\uff1a", "20b848ab41b97d857eb5e3707171cb56": "\u786e\u4fdd\u60a8\u8f93\u5165\u7684\u7535\u5b50\u90ae\u4ef6\u5730\u5740\u4e0e\u5305\u542b\u4e34\u65f6\u5bc6\u7801\u7684\u7535\u5b50\u90ae\u4ef6\u4e2d\u663e\u793a\u7684<strong>\u5b8c\u5168\u4e00\u81f4</strong>\u3002Pro\u4e2d\u7684\u5b57\u6bb5\u533a\u5206\u5927\u5c0f\u5199\u3002\u786e\u4fdd\u7535\u5b50\u90ae\u4ef6\u5730\u5740\u6216\u4e34\u65f6\u5bc6\u7801\u7684\u5f00\u5934\u6216\u7ed3\u5c3e\u6ca1\u6709\u7a7a\u683c\u3002", "aed03289740f0111e965c3583732e0ed": "\u81f3\u5c111\u4e2a\u5c0f\u5199\u5b57\u6bcd", "9781c4682c6cdfb31686cf39e4052491": "\u5fc5\u987b\u4e0d\u540c\u4e8e\u7528\u6237\u540d", "d6b2c64e8c6168145c8ec300eed5af2a": "\u672c\u5206\u6790\u53ef\u6839\u636e\u7528\u6237\u6240\u9009\u7684\u65f6\u95f4\u8de8\u5ea6\uff08\u5468\u3001\u6708\u3001\u5b63\u5ea6\u6216\u5e74\uff09\uff0c\u6309\u7167\u884c\u653f\u533a\u57df\uff0c\u6839\u636e\u5730\u70b9\u548c\u5bc6\u5ea6\u8ddf\u8e2a\u70ed\u5e26\u5730\u533a\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u7efc\u5408\u8b66\u62a5</a>\u6b21\u6570\u3002\u8b66\u62a5\u6b21\u6570\u5728GFW Pro\u4e2d\u6bcf\u5468\u66f4\u65b0\uff0c\u53ef\u80fd\u5305\u62ec\u9884\u5b9a\u66f4\u65b0\u65e5\u524d\u4e00\u5929\u7684\u6700\u65b0\u4e8b\u4ef6\u3002\u8fd9\u4e9b\u8b66\u62a5\u6b21\u6570\u548c\u5bc6\u5ea6\u6570\u636e\u53ef\u4ee5\u5e2e\u52a9\u7528\u6237\u8bc6\u522b\u6700\u8fd1\u7684\u6bc1\u6797\u6d3b\u52a8\uff0c\u786e\u5b9a\u9700\u8981\u4f18\u5148\u8fdb\u4e00\u6b65\u8c03\u67e5\u7684\u5730\u70b9\uff0c\u53ef\u4ee5\u901a\u8fc75\u7c73\u5206\u8fa8\u7387\u7684\u6bcf\u6708<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">Planet\u536b\u661f\u5f71\u50cf</a>\u8c03\u67e5\uff0c\u4e5f\u53ef\u4ee5\u52a8\u5458\u672c\u5730\u56e2\u961f\u8fdb\u884c\u8c03\u67e5\u548c\u5730\u9762\u5b9e\u51b5\u8003\u5bdf\u3002&nbsp;", "bb44b264c485a75632e016dd7778edbb": "\u5f53\u7528\u6237\u5bf9\u67d0\u4e2a\u5217\u8868\u8fd0\u884c\u66f4\u65b0\uff08\u5217\u8868\u66f4\u65b0\uff09\u65f6\uff0c\u5c06\u6d88\u80171\u4e2a\u6216\u591a\u4e2a\u76d1\u63a7\u5730\u70b9\u5206\u6790\uff08MLA\uff09\u989d\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5217\u8868\u4ec5\u5305\u542b1\u4e2a\u5730\u70b9\uff08\u65e0\u8bba\u662f\u591a\u8fb9\u5f62\u8fd8\u662f\u5e26\u534a\u5f84\u7684\u70b9\uff09\uff0c\u4e14\u4ec5\u9009\u62e9\u4e861\u79cd\u5217\u8868\u5206\u6790\u7c7b\u578b\uff0c\u5219\u8be5\u5217\u8868\u66f4\u65b0\u5c06\u6d88\u80171\u4e2aMLA\u3002\u5982\u679c\u5217\u8868\u542f\u7528\u4e863\u79cd\u5217\u8868\u5206\u6790\u7c7b\u578b\uff0c\u4e14\u5305\u542b5\u4e2a\u5730\u70b9\uff0c\u5219\u5c06\u6d88\u801715\u4e2aMLA\u2014\u2014\u6bcf\u4e2a\u5730\u70b9\u7684\u6bcf\u6b21\u5217\u8868\u5206\u6790\u6d88\u80171\u4e2aMLA\uff083 * 5\uff09\u3002&nbsp;", "0267bf6292e86ba1417a60f61bae520a": "\u76d1\u63a7\u5730\u70b9\u5206\u6790\uff08MLA\uff09", "ff1232290714a2e4426de2897293ffd4": "\u5f53\u4f01\u4e1a\u6210\u5458\u4f7f\u7528GFW Pro\u65f6\uff0c\u6211\u4eec\u4f1a\u901a\u8fc7\u5217\u8868\u5730\u70b9\u7684\u5217\u8868\u5206\u6790\u66f4\u65b0\u8ddf\u8e2a\u603b\u4f7f\u7528\u91cf\uff08MLA\u548cHOP\uff09\u3002\u4f7f\u7528\u91cf\u5c06\u9996\u5148\u6d88\u8017\u8d26\u53f7\u4e2d\u53ef\u7528\u7684\u514d\u8d39MLA\u548cHOP\uff0c\u7136\u540e\u6d88\u8017\u8d2d\u4e70\u7684\u989d\u5ea6\u3002\u514d\u8d39\u989d\u5ea6\u5fc5\u987b\u5728\u4e0b\u4e00\u4e2a\u66f4\u65b0\u65e5\u671f\u4e4b\u524d\u4f7f\u7528\uff0c\u5426\u5219\u5c06\u8fc7\u671f\u3002\u5f53\u4f7f\u7528\u91cf\u63a5\u8fd1\u5f53\u5e74\u53ef\u7528\u989d\u5ea6\u768490%\u65f6\uff0c\u6240\u6709\u7528\u6237\u90fd\u4f1a\u5728\u5e94\u7528\u7a0b\u5e8f\u5185\u6536\u5230\u4f7f\u7528\u91cf\u5c06\u8fbe\u5230\u4e0a\u9650\u7684\u901a\u77e5\u3002\u8fbe\u5230\u4e0a\u9650\u540e\uff0c\u5217\u8868\u66f4\u65b0\u529f\u80fd\u5c06\u65e0\u6cd5\u4f7f\u7528\uff0c\u76f4\u81f3\uff08\u5728\u66f4\u65b0\u65e5\u671f\uff09\u83b7\u5f97\u65b0\u7684\u989d\u5ea6\u6216\u8d2d\u4e70\u65b0\u7684\u989d\u5ea6\u3002\u5373\u4f7f\u8fbe\u5230\u8be5\u4e0a\u9650\uff0c\u4ecd\u53ef\u8bbf\u95ee\u4ee5\u524d\u5b8c\u6210\u7684\u5217\u8868\u5206\u6790\u548c\u6bcf\u5468\u8b66\u62a5\u62a5\u544a\u3002&nbsp;", "d765957ee05c552f869a3dafc8c1199d": "<strong>GFW Pro\u5217\u8868\u5206\u6790\u7684\u8f93\u51fa\u7ed3\u679c\u4ec5\u4f9b\u5185\u90e8\uff08\u6807\u51c6\uff09\u4f7f\u7528</strong>\u3002\u6b63\u5982GFW Pro\u8bb8\u53ef\u534f\u8bae\u6240\u8be6\u8ff0\uff0c\u4f01\u4e1a\u53ef\u5728\u5185\u90e8\u4f7f\u7528\u8fd9\u4e9b\u8f93\u51fa\u7ed3\u679c\uff0c\u4ee5\u505a\u51fa\u66f4\u53ef\u6301\u7eed\u7684\u91c7\u8d2d\u51b3\u7b56\uff0c\u540c\u65f6\u521b\u5efa\u884d\u751f\u5206\u6790\uff0c\u4ece\u800c\u63d0\u4f9b\u6307\u5bfc\uff0c\u6839\u636e\u98ce\u9669\u8bc4\u4f30\u6295\u8d44\u4e8e\u4e0e\u751f\u4ea7\u5546\u548c\u4f9b\u5e94\u5546\u7684\u4e92\u52a8\u5408\u4f5c\u3002\u4f01\u4e1a\u53ef\u5bf9\u5916\u5171\u4eab\u672a\u7ecf\u4fee\u6539\u4e14\u6ce8\u660e\u51fa\u5904\u7684GFW Pro\u8f93\u51fa\u7ed3\u679c\uff0c<em>\u800c\u65e0\u9700\u989d\u5916\u8d39\u7528</em>\uff0c\u524d\u63d0\u662f\u5c06\u8f93\u51fa\u7ed3\u679c\u76f4\u63a5\u4f20\u8f93\u7ed9\u653f\u5e9c\u76d1\u7ba1\u673a\u6784\uff0c\u4f5c\u4e3a\u91c7\u8d2d\u533a\u57df\u58f0\u660e\u7684\u4f50\u8bc1\uff0c\u6216\u4f20\u8f93\u7ed9\u7ba1\u7406\u666e\u904d\u516c\u8ba4\u7684\u81ea\u613f\u6027\u53ef\u6301\u7eed\u6027\u62a5\u544a\u6846\u67b6\u7684\u975e\u8425\u5229\u7ec4\u7ec7\uff0c\u4e14\u63a5\u6536\u65b9\u4e0d\u518d\u8fdb\u4e00\u6b65\u5206\u53d1GFW Pro\u7684\u539f\u59cb\u8f93\u51fa\u7ed3\u679c\u6216\u5c06\u5176\u5546\u4e1a\u5316\u3002&nbsp;", "5d29c058d413bea8b65ab4372fe26470": "<strong>\u57fa\u672c</strong>\u5206\u8bb8\u53ef\u6743\u5141\u8bb8\u5171\u4eab\u4efb\u4f55\u73b0\u6709\u68ee\u6797\u5217\u8868\u5206\u6790\u4e2d\u7b80\u5355\u7684\u201c\u662f/\u5426\u201d\u7ed3\u8bba\u3002\u4f8b\u5982\uff0c\u5bf9\u4e8e\u5df2\u83b7\u5f97\u5206\u8bb8\u53ef\u7684\u6765\u6e90\u5730\u70b9\u800c\u8a00\uff1a&nbsp;", "68e4e6600b800fd4f2c6de4999595d63": "\u5bfc\u822a\u81f3\u201c\u5730\u70b9\u201d\u4e3b\u9875\u4e0a\u7684\u5217\u8868&nbsp;", "f81107c28fd3ae5fc4b4f7c3b20e1de9": "\u8bf7\u9009\u62e9\u201c\u6ee5\u4f10\u62a5\u544a\u5206\u6790\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u66f4\u65b0\u201d\u3002\u6b64\u64cd\u4f5c\u4f1a\u63d0\u4ea4\u60a8\u7684\u5217\u8868\u8fdb\u884c\u6ee5\u4f10\u62a5\u544a KPI \u5206\u6790\u3002\u5206\u6790\u5b8c\u6210\u540e\uff0c\u5e73\u53f0\u5c06\u901a\u8fc7\u7535\u5b50\u90ae\u4ef6\u901a\u77e5\u60a8\uff0c\u60a8\u5373\u53ef\u67e5\u770b\u7ed3\u679c\u3002\u5728\u7ed3\u679c\u8ba1\u7b97\u8fc7\u7a0b\u4e2d\uff0c\u60a8\u65e0\u6cd5\u8bbf\u95ee\u60a8\u7684\u5217\u8868\u3002&nbsp;", "aeacbfd11fee23e641e6c1f13d38995d": "\u53ef\u4ee5\u3002\u8be5\u5206\u6790\u7684\u9996\u4e2a\u7248\u672c\u4e0e\u5546\u54c1\u548c\u5730\u70b9\u5206\u7c7b\u65e0\u5173\u3002\u76ee\u524d\uff0c\u8be5\u5206\u6790\u4ec5\u9002\u7528\u4e8e\u5355\u4e00\u5730\u70b9\u548c\u591a\u4e2a\u5730\u70b9\u5217\u8868\u3002&nbsp;&nbsp;", "37743b60fbe5a4d672ecb166c95a7145": "\u201c\u68ee\u6797\u53d8\u5316\u8bca\u65ad\u201d\u4e0e\u65b0\u7684\u201c\u6ee5\u4f10\u62a5\u544a KPI \u5206\u6790\u201d\u6709\u4f55\u4e0d\u540c\uff1f\u7ed3\u679c\u662f\u5426\u5177\u6709\u53ef\u6bd4\u6027\uff1f", "0c96e8b3b3cac7012e7c8ba1242117ef": "\u201c\u53ef\u5ffd\u7565\u98ce\u9669\u201d\u5730\u56fe\u548c\u6307\u6807\u662f\u4ec0\u4e48\uff1f", "9250db41acb66be1f9ccab9ccc67959c": "\u6ee5\u4f10\u62a5\u544a KPI \u5206\u6790", "6cc8b2984309e9e36e2ddec138fb6c55": "\u65e8\u5728\u8bc4\u4f30\u957f\u671f\u8d8b\u52bf\uff0c\u63d0\u4f9b\u6709\u5173\u571f\u5730\u5229\u7528\u53d8\u5316\u7684\u6df1\u5165\u6d1e\u5bdf&nbsp;", "0a55e6454eaf2f0385b436d49c32c87d": "\u65e8\u5728\u8bc4\u4f30\u5bf9\u4e8e\u81ea\u613f\u627f\u8bfa\u548c\u76d1\u7ba1\u8981\u6c42\u7684\u5408\u89c4\u60c5\u51b5&nbsp;", "b4a5f60f6a1a11d4fab4df20b0cb3b45": "2020 \u5e74\u5929\u7136\u6797\u8303\u56f4\u57fa\u7ebf\u56fe&nbsp;", "8dbd7b4ccd6ee7827653ca5c574200b3": "\u53ef\u5ffd\u7565\u98ce\u9669\u6307\u6807\u53ef\u88ab\u89c6\u4e3a\u786e\u5b9a\u5c3d\u804c\u8c03\u67e5\u5de5\u4f5c\u4f18\u5148\u6b21\u5e8f\u7684\u56e0\u7d20\u4e4b\u4e00\uff0c\u4f46\u5e76\u4e0d\u8868\u660e\u67d0\u4e2a\u884c\u653f\u533a\u57df\u5185\u7684\u6ee5\u4f10\u98ce\u9669\u4e3a\u96f6\u3002\u8be5\u6307\u6807\u53ef\u6eaf\u53ca\u65e2\u5f80\uff0c\u4f46\u4e0d\u80fd\u9884\u6d4b\u672a\u6765\u53ef\u80fd\u53d1\u751f\u7684\u6ee5\u4f10\u4e8b\u4ef6\u3002&nbsp;", "628452afde4cbc03a1b7b1ca1c5fca8a": "\u5929\u7136\u6797\u5730\u56fe\u662f <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">S</a>BTN \u81ea\u7136\u571f\u5730\u5730\u56fe\uff0c\u7279\u522b\u662f\u5176\u751f\u6001\u7cfb\u7edf\u56fe\u5c42<strong>* </strong>\uff08\u5728 Google Earth Engine \u5e94\u7528\u4e2d\u88ab\u79f0\u4e3a\u201c\u81ea\u7136\u571f\u5730\u2014\u2014\u7c7b\u522b\u201d\uff09\u7684\u884d\u751f\u4ea7\u54c1\u3002\u5929\u7136\u6797\u5730\u56fe\u5305\u542b\u4ee5\u4e0b\u7c7b\u522b\uff1a\u201c\u5929\u7136\u6797\u3001\u6e7f\u5730\u68ee\u6797\u3001\u6ce5\u70ad\u5730\u68ee\u6797\u548c\u7ea2\u6811\u6797\u201d\u3002&nbsp;", "2ed76b384f2626fc47aa68cc8daa3e07": "\u5982\u8981\u62a5\u544a\u60a8\u5728\u6d4b\u8bd5\u4e2d\u53d1\u73b0\u7684\u4efb\u4f55\u95ee\u9898\uff0c\u8bf7\u901a\u8fc7\u7535\u5b50\u90ae\u4ef6\u8054\u7cfb GFW Pro \u652f\u6301\u56e2\u961f\uff1a<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">gfwprosupport@wri.org</a>", "68de2a179a382714bc1a941825439dcb": "\u7f72\u540d&nbsp;", "351ee1427618bc7c5f209ae79213dbc5": "\u4ee5\u4e0a\u4ec5\u4e3a\u975e\u8be6\u5c3d\u6e05\u5355\uff0c\u5217\u4e3e\uff08\u8d85\u51fa\u5e74\u5ea6\u514d\u8d39\u7528\u91cf\u7684\uff09\u4f7f\u7528\u548c\uff08\u9488\u5bf9\u7279\u5b9a\u5730\u70b9\u8f93\u51fa\u7684\uff09\u53d1\u884c\u6743\u8d39\u7528\u53ef\u5b9e\u73b0\u7684\u53ef\u80fd\u60c5\u51b5\u3002GFW Pro \u7528\u6237\u53ef\u5c1d\u8bd5\u4e0d\u540c\u65b9\u6cd5\uff0c\u76f4\u81f3\u627e\u5230\u6700\u9002\u5408\u81ea\u8eab\u72ec\u7279\u8fd0\u8425\u6761\u4ef6\u7684\u6a21\u5f0f\u3002&nbsp;", "e451c0e2999188d4fe89dea9f5cab5d4": "\u5206\u8bb8\u53ef\u6743\u9002\u7528\u4e8e\u7279\u5b9a\u6765\u6e90\u5730\u70b9\uff0c\u65e0\u8bba\u662f\u519c\u573a\uff08\u591a\u8fb9\u5f62\uff09\u5185\u7684\u5b50\u5730\u5757\uff0c\u5730\u4ea7\u8fb9\u754c\uff08\u591a\u8fb9\u5f62\uff09\uff0c\u8fd8\u662f\u901a\u5e38\u88ab\u79f0\u4e3a\u201c\u68da\u201d\uff08\u4ee5\u4e00\u70b9\u4e3a\u4e2d\u5fc3\uff0c\u5177\u6709\u4e00\u5b9a\u534a\u5f84\u6216\u9762\u79ef\u8303\u56f4\uff09\u7684\u91c7\u8d2d\u533a\u57df\uff0c\u90fd\u5c5e\u4e8e\u6b64\u7c7b\u7279\u5b9a\u6765\u6e90\u5730\u70b9\u3002\u96f6\u6bc1\u6797\u58f0\u660e\u5e38\u9700\u8981\u9488\u5bf9\u8fd9\u4e9b\u7279\u5b9a\u5730\u70b9\u7684\u5b9a\u91cf\u6216\u53ef\u89c6\u5316\uff08\u57fa\u4e8e\u5730\u56fe\u7684\uff09\u8f93\u51fa\u7ed3\u679c\u4f5c\u4e3a\u4f50\u8bc1\uff0c\u56e0\u6b64\uff0c\u9664\u7ecf\u8bb8\u53ef\u7684\u76f4\u63a5\u5408\u89c4\u6027\u62a5\u544a\u7528\u9014\u5916\uff0c\u5176\u4ed6\u5f62\u5f0f\u7684\u5171\u4eab\u5747\u9700\u8981\u83b7\u5f97\u5206\u8bb8\u53ef\u6743\u3002&nbsp;", "be7af5eb8d7042621b3d882376703586": "\u6a21\u5f0f\uff0c\u6216\u5728\u6e05\u9664\u6d4f\u89c8\u5668\u7f13\u5b58\u540e\u3002&nbsp;", "bc0a43a5de6f76909fa0120161456873": "\u6211\u4eec\u7684\u76ee\u6807\u662f\u5c06 GFW Pro \u7528\u4f5c\u516c\u5171\u4ea7\u54c1\u63d0\u4f9b\u7ed9\u4f9b\u5e94\u94fe\u4e0a\u7684\u6240\u6709\u53c2\u4e0e\u8005\uff0c\u4ece\u800c\u4fc3\u8fdb\u66f4\u53ef\u6301\u7eed\u7684\u5546\u54c1\u91c7\u8d2d\u51b3\u7b56\u3002\u8d22\u529b\u6709\u9650\u4e0d\u5e94\u6210\u4e3a\u4eba\u4eec\u505a\u51fa\u66f4\u660e\u667a\u51b3\u7b56\u7684\u963b\u788d\uff0c\u5c24\u5176\u4e0d\u5e94\u6210\u4e3a\u5168\u7403\u519c\u4e1a\u4f9b\u5e94\u94fe\u4e0a\u7684\u8f83\u5c0f\u53c2\u4e0e\u8005\uff08\u5982\uff0c\u5f53\u5730\u751f\u4ea7\u5408\u4f5c\u793e\u53ca\u5176\u5c0f\u519c\u6237\uff09\u7684\u963b\u788d\u3002\u56e0\u6b64\uff0cGFW Pro \u4ecd\u53ef\u514d\u8d39\u4f9b\u7ec4\u7ec7\u5185\u90e8\u4f7f\u7528\uff0c\u4e14\u76f4\u63a5\u5408\u89c4\u62a5\u544a\u7528\u9014\u7684\u8d39\u7528\u4e5f\u5728\u7edd\u5927\u591a\u6570\u4e2d\u5c0f\u578b\u4f01\u4e1a\u9884\u671f\u6d88\u8d39\u6c34\u5e73\u5185\u3002&nbsp;", "49f873feab7ea507d3a2b5171a4556db": "\u6784\u5efa\u6db5\u76d6\u591a\u4e2a\u4f9b\u5e94\u5546\u7684\u91c7\u8d2d\u5730\u70b9\u7ec4\u5408\uff0c\u5e76\u5229\u7528\u8fc7\u5f80\u7684\u68ee\u6797\u8986\u76d6\u635f\u5931\u4fe1\u606f\u4e3a\u6bcf\u4e2a\u4f9b\u5e94\u5546\u751f\u6210\u8d8b\u52bf\u5206\u6790\uff0c\u636e\u6b64\u8f6c\u800c\u5411\u90a3\u4e9b\u5df2\u7ecf\u6d88\u9664\u6216\u6b63\u5728\u52aa\u529b\u6d88\u9664\u68ee\u6797\u780d\u4f10\u7684\u4f9b\u5e94\u5546\u8fdb\u884c\u91c7\u8d2d\uff1b\u6216&nbsp;", "d299ed110e2b8aa569a356c5504fd2b5": "\u76d1\u6d4b\u91c7\u8d2d\u5730\u70b9\u7ec4\u5408\uff0c\uff08\u501f\u52a9\u96c6\u6210\u7684\u6ee5\u4f10\u8b66\u62a5\uff09\u8fd1\u4e4e\u5b9e\u65f6\u5730\u8bc6\u522b\u6f5c\u5728\u7684\u6ee5\u4f10\u4e8b\u4ef6\uff0c\uff08\u901a\u8fc7 Planet \u5f71\u50cf\uff09\u8fdb\u884c\u8fdc\u7a0b\u8c03\u67e5\uff0c\u6216\uff08\u901a\u8fc7\u5728\u5b9e\u5730\u7684\u4f01\u4e1a\u5458\u5de5\uff09\u8fdb\u884c\u5b9e\u5730\u8c03\u67e5\uff0c\u7136\u540e\u4e0e\u4f9b\u5e94\u5546\u8054\u7cfb\uff0c\u963b\u6b62\u8fdb\u4e00\u6b65\u7684\u6ee5\u4f10\u5e76\u5b9e\u65bd\u4e0d\u5c31\u8ba1\u5212\u3002&nbsp;", "05fa4e63ca700ef1ef238602b12c99da": "\u987e\u95ee\u548c\u627f\u5305\u5546\u5c5e\u4e8e\u5185\u90e8\u7528\u6237\u5417\uff1f", "065d08b7ae80529ac8a32fac665ace53": "\u987e\u95ee\u548c\u627f\u5305\u5546\u4f7f\u7528\u8be5\u4f01\u4e1a GFW Pro \u8d26\u6237\u751f\u6210\u7684 MLA \u8f93\u51fa\u4e3a\u5ba2\u6237\u6570\u636e\uff0c\u5fc5\u987b\u4fdd\u7559\u5728\u8be5\u4f01\u4e1a\u4e2d\u3002\u7b2c\u4e09\u65b9\u5458\u5de5\u4e0d\u5f97\u63d0\u53d6\u3001\u4fdd\u7559\u3001\u5206\u53d1\u6216\u91cd\u65b0\u4f7f\u7528 MLA \u5185\u5bb9\u4ee5\u5411\u5176\u4ed6\u5ba2\u6237\u63d0\u4f9b\u670d\u52a1\u6216\u751f\u6210\u81ea\u5df1\u7684\u4ea7\u54c1\u3002\u4f46\u5982\u679c\u8be5\u4f01\u4e1a\u5148\u4e3a\u6bcf\u4e2a\u5730\u70b9\u53d6\u5f97\u5206\u8bb8\u53ef\u6743\uff0c\u7136\u540e\u5c06\u76f8\u5173 MLA \u5185\u5bb9\u7684\u4f7f\u7528\u6743\u6269\u5c55\u5230\u54a8\u8be2\u516c\u53f8\uff0c\u5219\u5c5e\u4e8e\u4f8b\u5916\u60c5\u5f62\u3002&nbsp;", "198b657e849311ebb4f47bdb9dafb6d8": "\u5bf9\u4e8e\u90a3\u4e9b\u5e0c\u671b\u63d0\u53d6 GFW Pro \u5206\u6790\u8f93\u51fa (MLA) \u5e76\u5c06\u5176\u5171\u4eab\u7ed9\u5546\u4e1a\u5408\u4f5c\u4f19\u4f34\u7684\u7528\u6237\u800c\u8a00\uff0c\u5206\u8bb8\u53ef\u6743\u4ee5\u4ed8\u8d39\u5f62\u5f0f\u4e3a\u4ed6\u4eec\u63d0\u4f9b\u4e86\u4fbf\u5229\u3002\u652f\u4ed8\u8fd9\u7b14\u8d39\u7528\u53ef\u63d0\u9ad8\u4e1a\u52a1\u6d41\u7a0b\u7684\u6548\u7387\uff0c\u56e0\u4e3a\u8bb8\u53ef\u6750\u6599\u7684\u6240\u6709\u4e0b\u6e38\u63a5\u6536\u65b9\u90fd\u53ef\u4ee5\u6cbf\u4f9b\u5e94\u94fe\u4f20\u9012\u6570\u636e\uff0c\u800c\u65e0\u9700\u91cd\u590d\u5de5\u4f5c\uff0c\u4e5f\u65e0\u9700\u652f\u4ed8\u989d\u5916\u8d39\u7528\u3002&nbsp;", "c59106a7cf64b67243291ecf62ebd136": "\u53e6\u4e00\u79cd\u65b9\u5f0f\u662f\uff0c\u4f9b\u5e94\u94fe\u4e0a\u7684\u6bcf\u4e2a\u53c2\u4e0e\u65b9\u90fd\u5c06\u539f\u5730\u70b9\u7684\u5730\u5757\u8fb9\u754c\u548c\u4f9b\u5e94\u94fe\u68da\u7684\u4fe1\u606f\u4f20\u9012\u7ed9\u5176\u4e0b\u6e38\u4e1a\u52a1\u5408\u4f5c\u4f19\u4f34\uff0c\u4f7f\u5f97\u5404\u65b9\u80fd\u5728 GFW Pro \u4e2d\u91cd\u65b0\u8fd0\u884c\u76f8\u540c\u7684\u5206\u6790\uff0c\u83b7\u5f97\u76f8\u540c\u7684\u7ed3\u679c\u3002\u8fd9\u79cd\u52b3\u52a8\u5bc6\u96c6\u578b\u65b9\u6cd5\u867d\u7136\u53ef\u4ee5\u907f\u514d\u4ea7\u751f\u5206\u8bb8\u53ef\u6743\u7684\u8d39\u7528\uff0c\u4f46\u4f1a\u5728\u4f9b\u5e94\u94fe\u7684\u6bcf\u4e2a\u73af\u8282\u4e0a\u8017\u8d39\u66f4\u591a\u65f6\u95f4\u548c\u8d44\u6e90\u3002&nbsp;", "7ff914b63c0f45eb2de273c666f48bcb": "\u9ad8\u6548\u4f7f\u7528\u5206\u8bb8\u53ef\u6743\uff0c\u53ef\u5e2e\u52a9\u7ec4\u7ec7\u7b80\u5316\u8d38\u6613\u5173\u7cfb\uff0c\u540c\u65f6\u4e5f\u80fd\u5bf9 GFW Pro \u63d0\u4f9b\u652f\u6301\u3002\u4e00\u4e9b\u53ef\u4f9b\u63a2\u7d22\u7684\u573a\u666f\u5982\u4e0b\uff1a&nbsp;", "bf827ce2e968088b4aeda0ddad618dbc": "\u4e00\u5bb6<strong>\u52a0\u5de5\u5546</strong>\u8981\u6c42\u4f9b\u5e94\u5546\u4e3a\u6750\u6599\u6765\u6e90\u5730\u70b9\u751f\u6210 GFW Pro \u5206\u6790\uff0c\u5e76\u4ee3\u8868\u4ed6\u4eec\u4e3a\u6bcf\u4e2a\u5730\u70b9\u83b7\u53d6\u5206\u8bb8\u53ef\u6743\u3002\u968f\u540e\uff0c\u8be5\u52a0\u5de5\u5546\u53ef\u521b\u5efa\u4e00\u4e2a\u6570\u636e\u5e93\uff0c\u5c06\u6bcf\u4e2a\u6765\u6e90\u7684\u4fe1\u606f\u4ee5\u8ba2\u9605\u7684\u5f62\u5f0f\u63d0\u4f9b\u7ed9\u4e70\u5bb6\uff0c\u4ece\u800c\u4f7f\u4e70\u5bb6\u80fd\u66f4\u8f7b\u677e\u5730\u5c65\u884c\u5408\u89c4\u6027\u4e49\u52a1\uff0c\u4e0e\u8be5\u52a0\u5de5\u5546\u5f00\u5c55\u4e1a\u52a1\u3002\u7531\u4e8e\u5df2\u83b7\u5f97\u5206\u8bb8\u53ef\u6743\uff0c\u4e0b\u6e38\u4e70\u5bb6\u53ef\u6309\u9700\u5c06 GFW Pro \u6570\u636e\u7528\u4f5c\u5408\u89c4\u6027\u8bc1\u636e\u548c\u7eb3\u5165\u62a5\u544a\u4e2d\uff08\u5047\u8bbe\u52a0\u5de5\u5546\u5411\u4e70\u5bb6\u6388\u4e88\u4e86\u6b64\u7c7b\u4f7f\u7528\u6743\uff09\u3002&nbsp;", "0bae223bb75b0dc3de651263ce60153d": "\u6539\u7f16\u6743\u7684\u4e00\u5927\u4f18\u52bf\u5728\u4e8e\uff0c\u5b83\u9f13\u52b1\u7528\u6237\u5bf9 GFW Pro \u8f93\u51fa\u7ed3\u679c\u8fdb\u884c\u521b\u65b0\u6027\u4f7f\u7528\uff0c\u4ee5\u6ee1\u8db3\u4f9b\u5e94\u94fe\u4e0a\u5404\u53c2\u4e0e\u65b9\u7684\u53ef\u6301\u7eed\u53d1\u5c55\u3001\u62a5\u544a\u548c\u5176\u4ed6\u4e1a\u52a1\u51b3\u7b56\u9700\u6c42\u3002&nbsp;", "efd8c0e0cd2cb7ceef641568f1fefac3": "\u672a\u6765\uff0cGFW Pro \u53ef\u80fd\u4f1a\u6784\u5efa\u5e94\u7528\u5185\u8bb8\u53ef\u3001\u62a5\u544a\u751f\u6210\u548c\u8ddf\u8e2a\u6280\u672f\uff0c\u4ee5\u7b80\u5316\u8bb8\u53ef\u5408\u89c4\u6027\u3002\u540c\u65f6\uff0c\u5c06\u5206\u8bb8\u53ef\u6743\u5206\u914d\u7ed9\u5730\u70b9\uff0c\u5728\u8bb8\u53ef\u671f\u9650\u5185\u8ddf\u8e2a\u751f\u6210\u7684\u62a5\u544a\uff0c\u4ee5\u53ca\u9075\u5b88\u5206\u8bb8\u53ef\u6743\u7684\u76f8\u5173\u8981\u6c42\uff0c\u662f\u6bcf\u4f4d GFW Pro \u5ba2\u6237\u548c\u5c06 GFW Pro \u8f93\u51fa\u96c6\u6210\u81f3\u5176\u4e1a\u52a1\u6d41\u7a0b\u548c\u4ea7\u54c1\u4e2d\u7684\u670d\u52a1\u63d0\u4f9b\u5546\u5e94\u8d1f\u7684\u8d23\u4efb\u3002&nbsp;", "717cf6eaa0ccc4e23b0ba69289e283e6": "\u5982\u9700\u5728\u5217\u8868\u5206\u6790\u5b8c\u6210\u540e\u67e5\u770b\u7ed3\u679c\uff0c\u8bf7\u5bfc\u822a\u81f3\u201c\u8bca\u65ad\u201d\u89c6\u56fe\u5e76\u4ece\u4e0b\u62c9\u83dc\u5355\u4e2d\u9009\u62e9\u201c\u6ee5\u4f10\u62a5\u544a\uff08\u622a\u81f3 2020 \u5e74\uff09\u201d\u3002\u4f7f\u7528\u201c\u8bca\u65ad\u201d\u4e0b\u8f7d\u6309\u94ae\u4e0b\u8f7d\u7ed3\u679c\uff0c\u5e76\u4f7f\u7528\u5730\u56fe\u529f\u80fd\u67e5\u770b\u5929\u7136\u6797\u5730\u56fe\u548c\u53ef\u5ffd\u7565\u98ce\u9669\u5730\u56fe\u3002&nbsp;", "a61a75c55642b92be92952d9ec2eeaca": "\uff08\u8bca\u65ad\u5217\u8868\u4e0b\u7684\uff09\u6ee5\u4f10\u62a5\u544a\u548c\u4e0b\u8f7d\u7684\u8be6\u7ec6\u5206\u6790\u62a5\u544a\u663e\u793a\u4e86\u67d0\u4e00\u884c\u653f\u533a\u57df\u4e2d\u635f\u5931\u4e86\u591a\u5c11\u5929\u7136\u6797\uff0c\u4ee5\u53ca\u8be5\u8f96\u533a\u662f\u5426\u88ab\u5f52\u7c7b\u4e3a\u53ef\u5ffd\u7565\u98ce\u9669\u533a\u57df\u6216\u4e0d\u53ef\u5ffd\u7565\u98ce\u9669\u533a\u57df\u3002\u4e0b\u8f7d\u7684\u8be6\u7ec6\u5206\u6790\u6309\u5730\u533a\u548c\u6b21\u5dde\u7ea7\u533a\u57df\u7ec6\u5206\u5217\u51fa\u4e86\u5929\u7136\u6797\u635f\u5931\u60c5\u51b5\uff0c\u5e76\u5bf9\u76f8\u5173\u7684\u53ef\u5ffd\u7565\u98ce\u9669\u8fdb\u884c\u4e86\u5206\u7c7b\u3002&nbsp;", "1fc89ad2d91cb74464c024a265da3558": "\u5929\u7136\u6797\u5730\u56fe\u4e0e SBTN \u7684\u81ea\u7136\u571f\u5730\u5730\u56fe\u6709\u4f55\u5173\u7cfb\uff1f", "e5e5a6100e3a3fdc25efd850427e1b31": "\u987e\u95ee\u662f\u5426\u80fd\u4f7f\u7528 GFW Pro \u63d0\u4f9b\u5ba2\u6237\u670d\u52a1\uff1f", "8427f110ca0cc51399a43a286234cc0e": "\u76ee\u524d\uff0c\u6211\u4eec\u6709\u4e24\u79cd\u7c7b\u578b\u7684\u5206\u8bb8\u53ef\u6743\uff1a&nbsp;", "0f5baae51420e8ac5a8316ad8e02d3f0": "\u6216\u8005\uff0c\u60a8\u4e5f\u53ef\u4ee5\u4f7f\u7528\u65b0\u7684\u4f01\u4e1a\u7535\u5b50\u90ae\u7bb1\u57df\u540d\u521b\u5efa\u65b0\u7684\u7528\u6237\u6863\u6848\uff0c\u7136\u540e\u505c\u7528\u8fc7\u65f6\u7684\u7528\u6237\u6863\u6848", "2841c0b2fddfcd2d02e88331e1aa717e": "\u6211\u6240\u5728\u7ec4\u7ec7\u7684 Pro \u8d26\u6237\u7ba1\u7406\u5458\u79bb\u804c\u4e86\uff0c\u6211\u8be5\u5982\u4f55\u8bbf\u95ee\u6211\u4eec\u7684\u4f01\u4e1a\u8d26\u6237\uff1f", "90f928c6b8c0f2ab7b9611774bcbff05": "\u5982\u679c\u6ca1\u6709\u73b0\u4efb Pro \u8d26\u6237\u7ba1\u7406\u5458\uff0c\u6216\u662f\u73b0\u4efb Pro \u8d26\u6237\u7ba1\u7406\u5458\u5728\u6307\u6d3e\u65b0\u7684 Pro \u8d26\u6237\u7ba1\u7406\u5458\u4e4b\u524d\u5df2\u7ecf\u79bb\u804c\uff0c\u5219\u9700\u8981\u6dfb\u52a0\u65b0\u7684 Pro \u8d26\u6237\u7ba1\u7406\u5458\u3002\u8bf7\u8054\u7cfb Pro \u56e2\u961f\u4ee5\u83b7\u53d6\u5e2e\u52a9\uff0c\u8054\u7cfb\u65b9\u5f0f\u4e3a <a href=\"{{0}}\">gfwprosupport@wri.org</a>\u3002", "338df7da62b46c8adba5540c88c7cb02": "\u901a\u5e38", "49f747da516b832280038d09b9cb4c71": "\u3002\u7528\u6237\u5c06\u5728\u6570\u636e\u66f4\u65b0", "e7c454bbc601ba292f2fbb47ffd508d6": "\u5c06\u5176\u7eb3\u5165\u5e73\u53f0", "9960b31c82dda08541ac0662f5a89e75": "\u6570\u636e\u96c6\u5e93 &; \u7f72\u540d", "dbb5418feee3c69e11643b6171da9040": "\u6536\u8d39\u6a21\u5f0f\u5e38\u89c1\u95ee\u9898", "7978b606e7f71e42ee8f9c1b3326fe58": "\u6587\u7ae0", "db3d8243d9270b1656fa69ebbc863afd": "\u6ee5\u4f10\u5173\u952e\u7ee9\u6548\u6307\u6807 (Key Performance Indicator, KPI) \u662f\u4ec0\u4e48\uff1f&nbsp;&nbsp;", "5f164656fa1fdbbccb432f5a89581c14": "\u8fd9\u4e9b\u6307\u6807\u53ef\u7528\u4e8e\u516c\u53f8\u548c\u4f01\u4e1a\u53ef\u6301\u7eed\u53d1\u5c55 (ESG) \u62a5\u544a\uff0c\u4e5f\u53ef\u7528\u4e8e EUDR \u7b49\u6cd5\u89c4\u8981\u6c42\u7684\u5f3a\u5236\u62ab\u9732\uff0c\u65e8\u5728\u4e3a\u4efb\u4f55\u7ec4\u7ec7\u63d0\u4f9b\u76d1\u6d4b\u96f6\u6bc1\u6797\u7ed3\u679c\u65b9\u9762\u7684\u652f\u6301\u3002&nbsp;", "da096fa6f24a82d7f92e3c5b63d52f2b": "\u6ee5\u4f10\u62a5\u544a KPI \u6709\u54ea\u4e9b\u65b0\u7684\u5206\u6790\u4f9d\u636e\uff1f&nbsp;", "0f1f717789a7190fa5f3d561cf52d4d1": "\u501f\u52a9\u8fd9\u4e9b KPI\uff0c\u7528\u6237\u53ef\u4ece\u8bc4\u4f30\u68ee\u6797\u8986\u76d6\u635f\u5931\u8f6c\u5411\u8bc4\u4f30\u5929\u7136\u6797\u635f\u5931\uff0c\u4ece\u800c\u5c06\u8c03\u67e5\u91cd\u70b9\u653e\u5728\u53ef\u80fd\u7684\u6ee5\u4f10\u884c\u4e3a\u4e0a\u3002\u8fd1\u4e4e\u5b9e\u65f6\u7684\u6ee5\u4f10\u8b66\u62a5\u53ef\u8fdb\u4e00\u6b65\u5b9e\u73b0\u4e3b\u52a8\u964d\u4f4e\u98ce\u9669\u3002\u8fd9\u4e9b\u5de5\u5177\u53ef\u4ee5\u5e2e\u52a9\u7ec4\u7ec7\u5efa\u7acb\u5065\u5168\u7684\u5c3d\u804c\u8c03\u67e5\u5b9e\u8df5\uff0c\u5206\u6790\u548c\u8bb0\u5f55\u8c03\u67e5\u7ed3\u679c\uff0c\u786e\u5b9a\u98ce\u9669\u7684\u4f18\u5148\u6b21\u5e8f\u5e76\u91c7\u53d6\u76f8\u5e94\u63aa\u65bd\uff0c\u5e76\u6ee1\u8db3\u5408\u89c4\u62a5\u544a\u8981\u6c42\u3002&nbsp;", "c7b31def5175f8d1f5a85f673b0225eb": "\u501f\u52a9\u57fa\u7840\u6570\u636e\u548c\u5206\u6790\uff0c\u7ec4\u7ec7\u53ef\u4ee5\u9a8c\u8bc1\u67d0\u4e2a\u5546\u54c1\u662f\u5426\u662f\u5728\u622a\u6b62\u65e5\u671f\uff08 2020 \u5e74 12 \u6708 31 \u65e5\uff09\u4e4b\u540e\uff0c\u5728\u88ab\u6bc1\u6797\u6216\u9000\u5316\u7684\u571f\u5730\u4e0a\u751f\u4ea7\u3001\u79cd\u690d\u6216\u517b\u6b96\u7684\u3002\u5206\u6790\u8fd8\u96c6\u6210\u4e86\u5929\u7136\u6797\u5730\u56fe\uff0c\u8be5\u5730\u56fe\u662f\u4f9d\u636e\u79d1\u5b66\u76ee\u6807\u7f51\u7edc (Science Based Targets Network, <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">SBTN</a>) \u5236\u5b9a\u7684\u571f\u5730\u76ee\u6807\u800c\u6784\u5efa\u7684\u81ea\u7136\u571f\u5730\u5730\u56fe\u7684\u5b50\u96c6\u3002\u8be5\u81ea\u7136\u6797\u7c7b\u522b\u4e0e EUDR \u5bf9\u68ee\u6797\u7684\u5b9a\u4e49\u5341\u5206\u63a5\u8fd1\u3002\u56e0\u6b64\uff0c\u6ee5\u4f10\u62a5\u544a KPI \u53ef\u88ab\u7eb3\u5165 EUDR \u7684\u5c3d\u804c\u8c03\u67e5\u6d41\u7a0b\u3002&nbsp;", "a15d2c643e068d5518a43549c74902b4": "\u5728\u5355\u6b21\u6216\u591a\u6b21\u4e0a\u4f20\u8fc7\u7a0b\u4e2d\uff0c\u7cfb\u7edf\u4f1a\u63d0\u793a\u60a8\u9009\u62e9\u8981\u5bf9\u6570\u636e\u8fdb\u884c\u5206\u6790\u7684\u7c7b\u578b\u3002\uff08\u8bf7\u6ce8\u610f\uff0c\u65b0\u5206\u6790\u6682\u4e0d\u53ef\u7528\u4e8e\u5927\u578b\u5217\u8868\u3002\uff09&nbsp;", "f68d227dcef6755e5a010dcb1fda2ef9": "\u60a8\u53ef\u4ee5\u4e0a\u4f20\u81f3 Pro \u8d26\u6237\u7684\u5217\u8868\u6570\u91cf\u6ca1\u6709\u9650\u5236\u3002\u5f53\u7136\uff0c\u5982\u679c\u60a8\u4e0d\u518d\u4f7f\u7528\u8fc7\u65f6\u7684\u5217\u8868\uff0c\u6211\u4eec\u4e5f\u5efa\u8bae\u60a8\u5c06\u5176\u4ece\u8d26\u6237\u4e2d\u5220\u9664\u3002", "146febb6326894953fa19f77a722481a": "\u8bf7\u68c0\u67e5\u60a8\u7684\u7f51\u901f\u2014\u2014\u6211\u4eec\u5efa\u8bae\u4f7f\u7528\u4e0a\u4f20\u548c\u4e0b\u8f7d\u901f\u5ea6\u81f3\u5c11\u4e3a 10 MBPS \u7684\u6709\u7ebf\u7f51\u7edc\u8fde\u63a5\u3002", "aba898cdd3fcc80dac766a4a172c370b": "\u5982\u679c\u60a8\u4f7f\u7528\u7684\u662f\u516c\u53f8 VPN\uff0c\u8bf7\u68c0\u67e5\u60a8\u6240\u5728\u7684\u7ec4\u7ec7\u662f\u5426\u8bbe\u6709\u9632\u706b\u5899\u6216\u5176\u4ed6\u5728\u7ebf\u5b89\u5168\u63aa\u65bd\u3002\u8bf7\u5c06\u6b64\u7535\u5b50\u90ae\u7bb1\u5730\u5740\u6269\u5c55\u540d\u548c\u7f51\u5740<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">\u5217\u8868</a>\u5206\u4eab\u7ed9\u60a8\u7684\u4fe1\u606f\u6280\u672f\u90e8\u95e8\uff0c\u4ee5\u786e\u4fdd\u60a8\u80fd\u4f7f\u7528 Pro \u7248\u672c\u7684\u6240\u6709\u529f\u80fd\u3002", "4984fdebe02b719570ee8792a164daf0": "\u4e0a\u4f20\u60a8\u7684\u6587\u4ef6", "f8e5e007e1e0baf2f91532b0bbb3b900": "\u6d4f\u89c8\u5668\u5904\u4e8e\u533f\u540d", "ba9462db7209b05ff2f173cf233969a4": "\u5982\u679c\u60a8\u4ecd\u9047\u5230\u95ee\u9898\uff0c\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3 <a href=\"{{0}}\">gfwprosupport@wri.org</a>\uff0c\u9644\u4e0a\u60a8\u7684\u6d4f\u89c8\u5668\u7c7b\u578b\u3001\u7248\u672c\u3001\u7f51\u901f\u548c\u6536\u5230\u7684\u6240\u6709\u9519\u8bef\u6d88\u606f\u7684\u622a\u5c4f\uff0c\u5e76\u5728\u53ef\u80fd\u60c5\u51b5\u4e0b\u9644\u4e0a\u60a8\u8981\u4e0a\u4f20\u7684\u6587\u4ef6\u526f\u672c\u3002", "538d443378c36e04e698b174b3a81946": "\u5982\u679c\u533a\u57df\u8fc7\u5927\uff08\u4e00\u822c\u800c\u8a00\uff0c\u5927\u4e8e 100 \u4e07\u516c\u9877\uff09\uff0c\u6216\u8005\u5982\u679c\u51e0\u4f55\u5f62\u72b6\u975e\u5e38\u590d\u6742\uff0c<span class=\"TrackChangeTextInsertion TrackedChange SCXW153325985 BCX8\"><span class=\"TextRun SCXW153325985 BCX8\" lang=\"EN-US\" xml:lang=\"EN-US\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW153325985 BCX8\">\u6216\u662f\u5728\u5904\u7406\u8fc7\u7a0b\u4e2d\u51fa\u73b0\u7cfb\u7edf\u4e2d\u65ad\uff0c\u5730\u70b9\u5206\u6790\u90fd\u6709\u53ef\u80fd\u5931\u8d25\u3002</span></span></span><span class=\"TextRun SCXW153325985 BCX8\" lang=\"EN-US\" xml:lang=\"EN-US\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW153325985 BCX8\">. </span></span>\u5982\u679c\u60a8\u9700\u8981\u6211\u4eec\u534f\u52a9\u4e0a\u4f20\u5730\u70b9\uff0c\u8bf7\u8054\u7cfb <a href=\"{{0}}\">gfwprosupport@wri.org</a>\u3002", "10be85a3c4a79640b55c11a751955283": "\u6211\u7684\u8d26\u6237\u53ef\u4ee5\u6709\u591a\u5c11\u7528\u6237\uff1f", "24bed2d6e311ad3926aa65dfa8e4d95e": "\u6211\u7684\u516c\u53f8\u6b63\u5728\u66f4\u6362\u7535\u5b50\u90ae\u7bb1\u57df\u540d\uff0c\u6211\u80fd\u5728 Pro \u8d26\u6237\u4fe1\u606f\u4e2d\u66f4\u65b0\u65b0\u7684\u7535\u5b50\u90ae\u7bb1\u5730\u5740\u5417\uff1f", "50d2a8d2a4faf3bef85ed7a92cb418d5": "\u5982\u679c\u60a8\u6240\u5728\u7684\u7ec4\u7ec7\u7ed3\u6784\u6216\u60a8\u7684\u7528\u6237\u7535\u5b50\u90ae\u7bb1\u57df\u540d\u53d1\u751f\u53d8\u5316\uff0c\u60a8\u7684\u73b0\u6709\u8d26\u6237", "e2fa538867c3830a859a5b17ab24644b": "\u8d26\u6237", "fcddea6301377e08a5d7862bdd784ce7": "\u8054\u7cfb GFW Pro ", "b3ae425d0643883c88cb6d544e059d95": "\u53d1\u5e03\u76f8\u5173\u8c03\u67e5\u7ed3\u679c\u7684\u5e94\u7528\u7a0b\u5e8f\u7684<strong>\u7528\u6237</strong>\u3002&nbsp;", "ef41a179faa3a39184f246fc0ad29976": "\u5728 GFW Pro \u4f1a\u5458\u6216 GFW Pro \u7f51\u7edc\u4f1a\u5458\u95f4\u5171\u4eab MLA \u8f93\u51fa\u3002&nbsp;", "ce48ddef1250faf76a88786a8ac2d3d8": "\u5206\u8bb8\u53ef\u6743\u7684\u9002\u7528\u60c5\u5f62\u6309\u5730\u70b9\u4ee5\u5e74\u8ba1\u3002\u8d2d\u4e70 SLR \u540e\uff0c\u7528\u6237\u5fc5\u987b\u5c06\u5176\u5206\u914d\u81f3\u5c06\u4e0e\u5916\u90e8\u5171\u4eab\u6570\u636e\u7684\u7279\u5b9a\u5730\u70b9\u3002\u5171\u4eab\u6743\u7684\u6709\u6548\u671f\u4e3a\u4e00\u5e74\uff0c\u4ece\u5730\u70b9\u5206\u914d\u4e4b\u65e5\u8d77\u7b97\uff08\u800c\u975e\u8d2d\u4e70\u65e5\u671f\uff09\uff0c\u5206\u914d\u540e\u4e0d\u5f97\u8f6c\u8ba9\u7ed9\u5176\u4ed6\u5730\u70b9\u3002\u67d0\u4e2a\u5730\u70b9\u83b7\u5f97\u8bb8\u53ef\u540e\uff0c\u5728\u8bb8\u53ef\u671f\u5185\uff0c\u4e3a\u8be5\u5730\u70b9\u751f\u6210\u7684\u4efb\u4f55\u62a5\u544a\u5747\u53ef\u88ab\u5171\u4eab\u3001\u5206\u53d1\u3001\u51fa\u7248\u3001\u8f6c\u552e\u6216\u6c38\u4e45\u8bb8\u53ef\uff0c\u4f46\u987b\u7b26\u5408\u8d2d\u4e70\u5e76\u5206\u914d\u7ed9\u8be5\u5730\u70b9\u7684\u5206\u8bb8\u53ef\u6743\u7c7b\u578b\u7684\u8303\u56f4\uff0c\u5e76\u9075\u5b88 GFW Pro <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8bb8\u53ef\u534f\u8bae</a>\u7684\u6761\u6b3e\u3002&nbsp;", "34d10c2fa6997a2ad9fb7a4d8dfab489": "\u4e0d\u884c\uff0c\u60a8\u4e0d\u80fd\u901a\u8fc7\u201c\u6211\u7684 GFW\u201d\u8bbf\u95ee Pro \u8d26\u6237\u3002\u51fa\u4e8e\u5b89\u5168\u8003\u8651\uff0c Pro \u8d26\u6237\u4f7f\u7528\u5355\u72ec\u7684\u53cc\u91cd\u7528\u6237\u8eab\u4efd\u9a8c\u8bc1\u7cfb\u7edf\u3002", "d9b17728f77800c8dc5941ce3f0214e3": "\u6211\u80fd\u901a\u8fc7\u201c\u6211\u7684 GFW\u201d\u767b\u5f55\u6211\u7684 Pro \u8d26\u6237\u5417\uff1f", "13f5ba6ecf4e8a7cbbec3b51d42d0686": "\u987e\u95ee\u53ef\u4f7f\u7528\u5176\u81ea\u5df1\u7684 GFW Pro \u8d26\u6237\u4e3a\u5ba2\u6237\u7ec4\u7ec7\u63d0\u4f9b\u670d\u52a1\uff0c\u4f46\u9700\u8981\u83b7\u5f97\u5206\u8bb8\u53ef\u6743\u624d\u80fd\u5411\u5ba2\u6237\u5171\u4eab\u7279\u5b9a\u4f4d\u7f6e\u7684 MLA \u5185\u5bb9\uff08\u6570\u636e/\u56fe\u50cf\uff09\u3002&nbsp;", "1756c0ae8581abca79e8bb7f278bf147": "\u4f8b\u5982\uff0c\u67d0\u5bb6\u54a8\u8be2\u516c\u53f8\u53ef\u4ece\u5ba2\u6237\u7ec4\u7ec7\u5904\u83b7\u5f97\u4e86\u539f\u59cb\u5730\u5757\u591a\u8fb9\u5f62\u3001\u5de5\u5382\u548c\u7ba1\u8f96\u533a\uff08\u5728 GFW Pro \u672f\u8bed\u4e2d\uff0c\u8fd9\u4e9b\u90fd\u5c5e\u4e8e\u201c\u5730\u70b9\u201d\uff09\u7684\u7ec4\u5408\u8d44\u6599\uff0c\u7136\u540e\u4f7f\u7528\u54a8\u8be2\u516c\u53f8\u7684 GFW Pro \u8d26\u6237\u5bf9\u8fd9\u4e9b\u5730\u70b9\u8fdb\u884c\u5206\u6790\u3002\u5982\u679c\u8be5\u54a8\u8be2\u516c\u53f8\u63d0\u4f9b\u7684\u62a5\u544a\u5bf9\u5ba2\u6237\u7684\u4f9b\u5e94\u94fe\u98ce\u9669\u6309<em>\u6c47\u603b</em>\u7c7b\u522b\u8fdb\u884c\u4e86\u7ec6\u5206\u548c\u6392\u540d\uff08\u5982\u5730\u7406\u533a\u57df\u3001\u5546\u54c1\u548c\u4f9b\u5e94\u5546\uff09\uff0c\u4f46\u4e0d\u5206\u4eab\u5177\u4f53\u7684 MLA \u8f93\u51fa\uff0c\u5219\u4e0d\u9700\u8981\u5206\u8bb8\u53ef\u6743\u3002\u5982\u679c\u8be5\u54a8\u8be2\u516c\u53f8\u9644\u4e0a\u4e86\u4ece MLA \u8f93\u51fa\u6216\u76f8\u5173\u5730\u56fe\u4e2d\u63d0\u53d6\u7684\u7279\u5b9a\u5730\u70b9\u7684\u8c03\u67e5\u7ed3\u679c\uff0c\u5219\u6bcf\u4e2a\u5730\u70b9\u90fd\u9700\u8981\u5206\u8bb8\u53ef\u6743\u3002&nbsp;", "c6f406de6ecfc507d1b48efe19c8289d": "\u8bf7\u6ce8\u610f\uff0c\u5f53 MLA \u8f93\u51fa\u88ab\u8f6c\u6362\u4e3a\u5b9e\u8d28\u4e0d\u540c\u7684\u6539\u7f16\u5185\u5bb9\uff08\u8be6\u89c1\u672c\u5e38\u89c1\u95ee\u9898\u4e2d\u201c\u6539\u7f16\u5185\u5bb9\u662f\u4ec0\u4e48\u201d\u95ee\u7b54\u90e8\u5206\u6240\u8ff0\uff09\uff0c\u5219\u4e0d\u9700\u8981\u5206\u8bb8\u53ef\u6743\u3002\u56e0\u6b64\uff0c\u54a8\u8be2\u516c\u53f8\u53ef\u4f7f\u7528 GFW Pro \u751f\u6210\u5206\u6790\u6210\u679c\uff0c\u5e76\u5c06\u5176\u4e0e\u72ec\u7acb\u5236\u4f5c\u6216\u83b7\u53d6\u5230\u7684\u6570\u636e\u76f8\u7ed3\u5408\uff0c\u521b\u5efa\u72ec\u7279\u7684\u5206\u6790\u6210\u679c\uff0c\u4ea4\u4ed8\u7ed9\u5ba2\u6237\u6216\u7528\u4e8e\u5546\u4e1a\u8f6c\u552e\u3002\u54a8\u8be2\u516c\u53f8\u5fc5\u987b\u4fdd\u7559 GFW Pro \u53ca\u590d\u5408\u7b2c\u4e09\u65b9\u6570\u636e\u6e90\u7684\u7f72\u540d\uff0c\u4e14\u9075\u5b88<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8bb8\u53ef\u534f\u8bae</a>\u4e2d\u89c4\u5b9a\u7684\u9650\u5236\u3002&nbsp;", "3a40fc77aeeafbcaee3e5f251e119790": "\u76f4\u63a5\u5408\u89c4\u6027\u62a5\u544a\u662f\u6307 GFW Pro \u7528\u6237\u5c06 MLA \u8f93\u51fa\u5171\u4eab\u4e3a<strong>\u76f4\u63a5</strong>\u63d0\u4ea4\u7ed9\u4ee5\u4e0b\u5404\u65b9\u7684\u5408\u89c4\u6027\u58f0\u660e\u7684\u652f\u6301\u8bc1\u636e\uff1a&nbsp;", "5bf63f130f080e253a67c1f9099943cf": "\u56fd\u5bb6\u6216\u5dde\u653f\u5e9c\u6307\u5b9a\u7684\u4e3b\u7ba1\u673a\u6784\uff0c\u8d1f\u8d23\u5728\u5176\u8f96\u533a\u5185\u5f3a\u5236\u6267\u884c\u76f8\u5173\u7684\u73af\u4fdd\u6216\u53ef\u6301\u7eed\u53d1\u5c55\u6cd5\u5f8b\u6cd5\u89c4\uff1b\u6216&nbsp;", "0ed0235ed15f94ca435130b619f2cc49": "\u56fd\u9645\u516c\u8ba4\u5e76\u5e7f\u6cdb\u91c7\u7528\u7684\u81ea\u613f\u6027\u73af\u4fdd\u6216\u53ef\u6301\u7eed\u6027\u62a5\u544a\u534f\u8bae\u7684\u975e\u8425\u5229\u6027\u7ba1\u7406\u673a\u6784\u3002&nbsp;", "8cc3054cab9c01ea7ab0c371280de4b5": "\u4f8b\u5982\uff0c\u5982\u679c\u67d0\u5bb6\u4f01\u4e1a\u4f7f\u7528 GFW Pro \u8fdb\u884c\u4e86\u591a\u4e2a\u7279\u5b9a\u5730\u70b9\u5206\u6790\uff0c\u5e76\u5c06\u76f8\u5173\u4ea7\u54c1\u91cf\u76f4\u63a5\u8fdb\u53e3\u5230\u6b27\u76df\uff0c\u6216\u5728\u81ea\u613f\u62a5\u544a\u534f\u8bae\uff08\u5982 CDP \u62a5\u544a\uff09\u4e2d\u58f0\u660e\u4e0d\u5b58\u5728\u6ee5\u4f10\u60c5\u51b5\u4e14\u5fc5\u987b\u63d0\u4f9b\u652f\u6301\u8bc1\u636e\uff0c\u5219\u63d0\u4ea4\u672a\u7ecf\u6539\u52a8\u7684\u68ee\u6797\u8986\u76d6\u7387\u3001\u68ee\u6797\u635f\u5931\u6570\u91cf\u3001 \u76f8\u5173\u611f\u5174\u8da3\u533a\uff08\u5982\u4fdd\u62a4\u533a\uff09\u548c\u4ece GFW Pro \u7528\u6237\u754c\u9762\u6355\u83b7\u7684\u5730\u56fe\u56fe\u50cf\u7684\u91cd\u53e0\u56fe\u50cf\u7684 MLA \u8f93\u51fa\uff0c\u5373\u88ab\u89c6\u4e3a\u7ecf\u8bb8\u53ef\u7684<em>\u76f4\u63a5</em>\u5408\u89c4\u6027\u62a5\u544a\u7528\u9014\u3002&nbsp;", "83c490e21e07df524d01e37c85d4b7ce": "\u6211\u4f55\u65f6\u9700\u8981\u8d2d\u4e70\u5206\u8bb8\u53ef\u6743\uff1f", "0afad8f4cb339ecd91d4de7d67e40214": "\u5f53\u9700\u8981\u5411\u5916\u90e8\u4ee5\u5b8c\u6574\u6216\u90e8\u5206\u5f62\u5f0f\u5171\u4eab\u5730\u70b9\u7684 MLA \u8f93\u51fa\u6216\u5185\u5bb9\u65f6\uff0c\u5219\u9700\u8981\u6709\u6bcf\u4e2a\u5f85\u5171\u4eab\u5730\u70b9\u7684\u5206\u8bb8\u53ef\u6743\u3002\u4f8b\u5982\uff0c\u5f53\u4f01\u4e1a\u4f7f\u7528 GFW Pro \u5236\u4f5c MLA \u8f93\u51fa\u65f6\uff0c\u5219\u9700\u8981\u5206\u8bb8\u53ef\u6743\u624d\u80fd\u5411\u4ee5\u4e0b\u7b2c\u4e09\u65b9\u5171\u4eab\u7279\u5b9a\u5730\u70b9\u7684\u5206\u6790\u3001\u56fe\u6807\u548c\u57fa\u4e8e\u5730\u56fe\u7684\u6ee5\u4f10\u8c03\u67e5\u7ed3\u679c\uff1a&nbsp;", "77c1cc635f5d8d78b9cad191a6172849": "<strong>\u4e70\u5bb6</strong>\u3002\u4f5c\u4e3a\u5408\u89c4\u6027\u62a5\u544a\u7684\u652f\u6301\u6570\u636e\u3002&nbsp;", "92aacee9f1fcc5a2f80b45c748060882": "<strong>\u4f9b\u5e94\u5546</strong>\u3002\u4ee5\u8981\u6c42\u5bf9\u65b9\u5bf9\u6240\u53d1\u73b0\u7684\u95ee\u9898\u4f5c\u51fa\u89e3\u91ca\u3002 &nbsp;", "aad8702c1811b6cb19d952fd75cb2351": "<strong>\u501f\u65b9</strong>\u3002\u4ee5\u8ba8\u8bba\u5177\u4f53\u7684\u501f\u8d37\u95ee\u9898\u6216\u673a\u4f1a\u3002&nbsp;", "f92aa40d40b0d8c98db3ca663d2943f5": "<strong>\u4fdd\u9669\u5546</strong>\u3002\u4ee5\u83b7\u5f97\u878d\u8d44\u6216\u4fdd\u9669\u3002&nbsp;", "967afbe46ce8e22a125085a3e5eb0cf3": "\u6211\u6700\u591a\u53ef\u4ee5\u5f80\u8d26\u6237\u4e0a\u4f20\u591a\u5c11\u4e2a\u5217\u8868\uff1f", "d509329838fcee3b2346bb940803ba85": "\u4ee4\u724c\u4ee3\u7801\u7684\u6709\u6548\u671f\u6709\u591a\u957f\uff1f", "519256a126e5b923e7508f5a973fbc4e": "\u5728 Pro \u7f51\u9875\u8f93\u5165\u7535\u5b50\u90ae\u7bb1\u548c\u5bc6\u7801\u540e\uff0c\u60a8\u5c06\u6536\u5230\u4e00\u6761\u6709\u6548\u671f\u7ea6\u4e3a 5 \u5206\u949f\u7684\u4ee4\u724c\u4ee3\u7801\u3002\u60a8\u5fc5\u987b\u8f93\u5165\u8be5\u4ee3\u7801\u624d\u80fd\u8bbf\u95ee Pro \u8d26\u6237\u3002\u5982\u679c\u60a8\u672a\u6536\u5230\u4ee4\u724c\u4ee3\u7801\uff0c\u8bf7\u70b9\u51fb\u9a8c\u8bc1\u9875\u9762\u4e0a\u7684\u201c\u91cd\u65b0\u53d1\u9001\u4ee4\u724c\u201d\u3002\u5982\u672a\u6536\u5230\u4ee4\u724c\uff0c\u8bf7\u68c0\u67e5\u60a8\u7684\u5783\u573e\u90ae\u4ef6\u6587\u4ef6\u5939\u3002", "fd47b8975af6b38d589d5dff079df387": "\u5982\u679c\u5728\u4e0a\u4f20\u8fc7\u7a0b\u7684\u7b2c 3 \u6b65\uff0c\u5217\u8868\u4e2d\u7684\u5730\u70b9\u5728\u56fd\u5bb6/\u5730\u533a\u3001\u5dde/\u7701\u548c\u6b21\u7ea7\u884c\u653f\u533a\u5212\u5b57\u6bb5\u663e\u793a\u4e3a\u201c\u65e0\u201d\uff0c\u8bf7\u68c0\u67e5\u4ee5\u786e\u4fdd\u5217\u8868\u4e2d\u7684\u6240\u6709\u5730\u70b9\u5747\u4f4d\u4e8e\u9646\u5730\u4e0a\u3002", "f80a1130553ad5403ad6979ca9a88ad9": "\u60a8\u7684\u8d26\u6237\u6ca1\u6709\u7528\u6237\u6570\u91cf\u9650\u5236\u3002", "93198a40f7b76ada875ce1a09f45b837": "\u6211\u7684 Pro \u8d26\u6237\u662f\u5426\u5b89\u5168\uff1f", "0f67728558a928a8900436ce93e46524": "Pro \u7248\u672c\u4f7f\u7528\u4e86\u4e00\u6d41\u7684\u8d26\u6237\u5b89\u5168\u534f\u8bae\uff0c\u5305\u62ec\u767b\u5f55\u65f6\u6709\u4e25\u683c\u7684\u5bc6\u7801\u8981\u6c42\u548c\u53cc\u56e0\u7d20\u9a8c\u8bc1\u30024 \u5c0f\u65f6\u4e0d\u6d3b\u52a8\u540e\uff0c Pro \u7f51\u9875\u5c06\u8d85\u65f6\u3002\u7cfb\u7edf\u4f1a\u81ea\u52a8\u9000\u51fa\u767b\u5f55\u60a8\u7684\u4e2a\u4eba\u6863\u6848\uff0c\u60a8\u9700\u8981\u91cd\u65b0\u767b\u5f55\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">\u5728\u6b64</a>\u8bbf\u95ee\u6709\u5173 Pro \u7248\u672c\u5b89\u5168\u529f\u80fd\u7684\u66f4\u591a\u4fe1\u606f\u3002", "386b2e7e9b834c3eb57073afa1dcf23f": "\u5c06\u88ab\u505c\u7528\uff0c\u60a8\u9700\u8981\u4e3a\u60a8\u7684\u7ec4\u7ec7\u521b\u5efa\u4e00\u4e2a\u65b0", "ca0759bc015797d50b4a076a3116d155": "\u5e2e\u52a9", "7abfd3ad1bb8823ef1dd9a1822873164": "\u8bf7\u63d0\u524d", "c8d71e1cbf3e577195bac624bfff0c2d": "\u5982\u9700\u66f4\u6362 Pro \u8d26\u6237\u7ba1\u7406\u5458\uff0c\u73b0\u4efb\u8d26\u6237\u8d85\u7ea7\u7ba1\u7406\u5458\u53ef\u5c06\u65b0\u7684 Pro \u8d26\u6237\u7ba1\u7406\u5458\u6dfb\u52a0\u4e3a\u7ec4\u7ec7 Pro \u8d26\u6237\u4e2d\u7684\u65b0\u7528\u6237\u3002\u7136\u540e\uff0c\u65b0\u7684 Pro \u8d26\u6237\u7ba1\u7406\u5458\u53ef\u5728\u7ec4\u7ec7 Pro \u8d26\u6237\u4e2d\u5c06\u73b0\u4efb Pro \u8d26\u6237\u7ba1\u7406\u5458\u505c\u7528\u3002", "0a565f884f6fc9afed791f0b91d13a88": "\u201c\u76f4\u63a5\u5408\u89c4\u6027\u62a5\u544a\u201d\u7528\u9014\u6307\u4ec0\u4e48\uff1f", "d101ed5ddebef533692337820e54fa07": "\u4e3a\u660e\u786e\u8d77\u89c1\uff0c<strong>\u4e0e\u5546\u4e1a\u5408\u4f5c\u4f19\u4f34\u5171\u4eab MLA \u8f93\u51fa\u4ee5\u5e2e\u52a9\u540e\u8005\u5b8c\u6210\u5408\u89c4\u6027\u62a5\u544a\u4e0d\u5c5e\u4e8e<em>\u76f4\u63a5</em>\u5408\u89c4\u6027\u62a5\u544a</strong>\u3002\u5982\u679c\u4e0e\u5546\u4e1a\u5408\u4f5c\u4f19\u4f34\u5171\u4eab\u3001\u6216\u4f5c\u4e3a\u4ea4\u6613\u7684\u4e00\u90e8\u5206\u800c\u5171\u4eab\u7279\u5b9a\u5730\u70b9\u7684 GFW Pro \u5206\u6790\u8f93\u51fa\u7ed3\u679c\u548c\u5730\u56fe\u5185\u5bb9\uff0c\u5219\u9700\u8981\u4e3a\u6bcf\u4e2a\u5730\u70b9\u8d2d\u4e70\u5206\u8bb8\u53ef\u6743\u3002&nbsp;", "198f95f77ed83ace83974d8250bf2699": "<strong>\u5ba2\u6237</strong>\u3002\u4ee5\u63d0\u51fa\u91c7\u8d2d\u884c\u52a8\u6307\u5357\u3002&nbsp;", "f4e2157752845533c514da2497aa25e9": "\u5206\u8bb8\u53ef\u6743\u53ef\u5171\u4eab\u54ea\u4e9b\u5185\u5bb9\uff1f&nbsp;", "95f1556533deb8f4369a02f0466d7c75": "\u6570\u636e", "5fd063665437a66a2ddd28397341fb1a": "\u6bcf\u5b63\u5ea6\u5728 GFW Pro \u4e2d\u66f4\u65b0\u4e00\u6b21", "caf4087721f9034780425f15e293319b": "\u6536\u5230\u901a\u77e5\u3002", "3806e611cc3ca8add825ccd204a50d11": "\uff0c\u4f46\u6211\u4eec\u4f1a\u6301\u7eed\u8bc4\u4f30\u65b0\u7684\u6570\u636e\u96c6\uff0c\u5e76\u5728\u53ef\u80fd\u60c5\u51b5\u4e0b", "97dd47710dfcf9ac24c9134432ba06e4": "\u65f6", "1553fc132c816eb9f3f5417851a2d5d1": "\u5173\u4e8e\u6ee5\u4f10 KPI \u7684\u5e38\u89c1\u95ee\u9898", "d58713c21ff7adc3128d17d76116e59f": "\u901a\u8fc7\u6ee5\u4f10 KPI \u5206\u6790\uff0c\u60a8\u53ef\u4ee5\u5f97\u77e5\u54ea\u4e9b\u5730\u70b9\u7684\u98ce\u9669\u53ef\u5ffd\u7565\u4e0d\u8ba1\uff0c\u5e2e\u52a9\u60a8\u6ee1\u8db3\u53cd\u6ee5\u4f10\u6761\u4f8b\u7684\u8981\u6c42\u3002\u672c\u6587\u63a2\u8ba8\u4e86\u6709\u5173\u201c\u5c06\u6ee5\u4f10 KPI \u5206\u6790\u5e94\u7528\u81f3\u5404\u5730\u70b9\u201d\u7684\u5e38\u89c1\u95ee\u9898\u3002\u501f\u52a9 GFW Pro \u7684\u65b0\u6ee5\u4f10\u62a5\u544a KPI\uff0c\u5404\u7ec4\u7ec7\u80fd\u9075\u5b88\u4e00\u7cfb\u5217\u81ea\u613f\u548c\u76d1\u7ba1\u62ab\u9732\u8981\u6c42\uff0c\u5305\u62ec\u300a\u6b27\u76df\u96f6\u6bc1\u6797\u6cd5\u6848\u300b(EU Deforestation Regulation, EUDR)\u3001[\u2026]", "0ea831fd113d95f43edd498e92b8f3f9": "\u901a\u8fc7\u6ee5\u4f10 KPI \u5206\u6790\uff0c\u60a8\u53ef\u4ee5\u5f97\u77e5\u54ea\u4e9b\u5730\u70b9\u7684\u98ce\u9669\u53ef\u5ffd\u7565\u4e0d\u8ba1\uff0c\u5e2e\u52a9\u60a8\u6ee1\u8db3\u53cd\u6ee5\u4f10\u6761\u4f8b\u7684\u8981\u6c42\u3002\u672c\u6587\u63a2\u8ba8\u4e86\u6709\u5173\u201c\u5c06\u6ee5\u4f10 KPI \u5206\u6790\u5e94\u7528\u81f3\u5404\u5730\u70b9\u201d\u7684\u5e38\u89c1\u95ee\u9898\u3002", "a2658a5b1ce93145fc9c158479395f91": "\u501f\u52a9 GFW Pro \u7684\u65b0\u6ee5\u4f10\u62a5\u544a KPI\uff0c\u5404\u7ec4\u7ec7\u80fd\u66f4\u8f7b\u677e\u5730\u9075\u5b88\u5305\u62ec\u300a\u6b27\u76df\u96f6\u6bc1\u6797\u6cd5\u6848\u300b(EUDR) \u5728\u5185\u7684\u4e00\u7cfb\u5217\u81ea\u613f\u548c\u76d1\u7ba1\u62ab\u9732\u8981\u6c42\u3002\u8fd9\u4e9b KPI \u5e7f\u6cdb\u9002\u7528\u4e8e\u96f6\u6bc1\u6797\u62a5\u544a\uff0c\u4e14\u9075\u5faa\u95ee\u8d23\u5236\u6846\u67b6\u5021\u8bae (Accountability Framework Initiative, AFi) \u53d1\u5e03\u7684\u6307\u5357\u3002\u7528\u6237\u53ef\u5728\u57fa\u7840\u6570\u636e\u96c6\u7684\u80cc\u666f\u4e0b\uff0c\u76f4\u89c2\u67e5\u770b\u91c7\u8d2d\u5730\u70b9\uff0c\u5728\u65b0\u5217\u8868\u4e2d\u8fd0\u884c\u5206\u6790\u6216\u66f4\u65b0\u73b0\u6709\u5217\u8868\u4ee5\u83b7\u5f97\u4e89\u7aef\u7ed3\u679c\uff0c\u5e76\u4e0b\u8f7d\u8be6\u7ec6\u7684\u5206\u6790\u7ed3\u679c\u3002&nbsp;", "25bd6d3ccd6233bd9e829a3af9b7b547": "2020 \u5e74\u5168\u7403\u5929\u7136\u6797\u8303\u56f4\u57fa\u7ebf\u56fe\u548c\u53ef\u5ffd\u7565\u98ce\u9669\u6307\u6807&nbsp;", "961a684a7d88f4e5131a293c4cbea5b5": "\u5982\u4f55\u5229\u7528\u6ee5\u4f10 KPI \u4e3a EUDR \u5408\u89c4\u63d0\u4f9b\u652f\u6301\uff1f&nbsp;", "31f1f17dd66858b369f83ff5ae998bba": "\u8bf7\u9009\u62e9\u6ee5\u4f10\u62a5\u544a\u5206\u6790\uff0c\u4ee5\u53ca\u4f60\u5e0c\u671b\u67e5\u770b\u7684\u5176\u4ed6\u4efb\u610f\u5206\u6790\u7c7b\u578b\uff0c\u7136\u540e\u5355\u51fb\u201c\u63d0\u4ea4\u201d\u3002\u5f53\u7ed3\u679c\u53ef\u4f9b\u67e5\u770b\u65f6\uff0c\u60a8\u5c06\u6536\u5230\u7535\u5b50\u90ae\u4ef6\u901a\u77e5\u3002&nbsp;&nbsp;", "da51d49f77ac779e9ddc2940116f8c73": "2000 \u5e74\u68ee\u6797\u8986\u76d6\u8303\u56f4\u57fa\u7ebf\u56fe&nbsp;", "36c3ca0c8ea5b60a0574395a2fb6616d": "\u4e0a\u4f20\u5730\u70b9\u5217\u8868\u65f6\uff0c\u6211\u4e3a\u4ec0\u4e48\u4f1a\u6536\u5230\u9519\u8bef\u6d88\u606f\uff1f", "73d880c62f066a35adfe7830eded2697": "\u6b64\u5916\uff0c\u8bf7\u5c1d\u8bd5", "b0bd1a0f968133aa42de9e9d7040a36c": "\u56e2\u961f\u4ee5\u83b7\u53d6", "20d4a8cd5c60efa964304448c4b64d03": "\u54ea\u4e9b\u60c5\u51b5\u5c5e\u4e8e\u201c\u5185\u90e8\u4f7f\u7528\u201d\uff1f", "28cec14d40a9da85b292140cfc0d6455": "\u5185\u90e8\u4f7f\u7528\u662f\u6307\u4ec5\u7528\u4e8e\u5185\u90e8\u51b3\u7b56\u76ee\u7684\u7684 MLA \u8f93\u51fa\u6216\u5185\u5bb9\uff08<em>\u5305\u62ec\u7279\u5b9a\u5730\u70b9\u7684\u7ed3\u679c\u3001\u6d4b\u91cf\u3001\u8868\u683c\u3001\u56fe\u8868\u548c\u56fe\u50cf</em>\uff09\uff0c\u65e0\u8bba\u8fd9\u4e9b\u8f93\u51fa\u6216\u5185\u5bb9\u662f\u901a\u8fc7\u7528\u6237\u754c\u9762 (UI) \u8bbf\u95ee\u3001\u6253\u5370\u4e3a PDF\u3001\u4ee5 CSV \u6587\u4ef6\u683c\u5f0f\u4e0b\u8f7d\u8fd8\u662f\u901a\u8fc7\u5e94\u7528\u7a0b\u5e8f\u63a5\u53e3 (API) \u67e5\u8be2\u3002\u4f8b\u5982\uff0c\u4f01\u4e1a\u53ef\u4ee5\uff1a&nbsp;", "6d2ede6aca4487ff2b56f0481d11feeb": "\u8bc4\u4f30\u519c\u4e1a\u8d37\u6b3e\u7533\u8bf7\uff0c\u5728\u7b26\u5408\u73af\u5883\u4fdd\u62a4\u3001\u519c\u4e1a\u751f\u4ea7\u548c\u53ef\u6301\u7eed\u91d1\u878d\u653f\u7b56\u7684\u57fa\u7840\u4e0a\u4f5c\u51fa\u6295\u8d44\u51b3\u7b56\u3002&nbsp;&nbsp;", "cb6106b0052b2943ace201e86fd97c77": "\u5728\u4e0a\u8ff0\u5404\u79cd\u60c5\u5f62\u4e0b\uff0c\u5185\u90e8\u51b3\u7b56\u53ca\u540e\u7eed\u884c\u52a8\u5747\u53ef\u5728\u4e0d\u4e0e\u5916\u754c\u5171\u4eab MLA \u8f93\u51fa\u7684\u60c5\u51b5\u4e0b\u8fdb\u884c\u3002\u7136\u800c\uff0c\u5982\u679c\u5fc5\u987b\u5411<em>\u5916\u90e8</em>\u4f01\u4e1a\u6216\u4ea4\u6613\u5408\u4f5c\u4f19\u4f34\u63d0\u4f9b\u6ee5\u4f10\u4e8b\u4ef6\uff08\u6216\u6ee5\u4f10\u4e8b\u4ef6\u4e0d\u5b58\u5728\uff09\u7684\u8bc1\u636e\uff0c\u5219\u9700\u4e3a\u5171\u4eab\u7279\u5b9a\u8f93\u51fa\uff08\u65e0\u8bba\u662f\u6570\u636e\u8fd8\u662f\u5730\u56fe\u56fe\u50cf\uff09\u7684\u6bcf\u4e2a\u5730\u70b9\u63d0\u4f9b\u5206\u8bb8\u53ef\u6743\u3002&nbsp;", "b5577086d8daad2aca1d4feb3fd00cb3": "\u5f53\u987e\u95ee\u548c\u627f\u5305\u5546\u4ee3\u8868\u4f01\u4e1a\u884c\u4e8b\u65f6\uff0c\u8be5\u4f01\u4e1a\u53ef\u5c06\u5176\u6dfb\u52a0\u4e3a GFW Pro \u8d26\u6237\u7684\u7528\u6237\u3002\u4f8b\u5982\uff0c\u67d0\u5bb6\u516c\u53f8\u53ef\u8058\u8bf7\u4e00\u5bb6\u53ef\u6301\u7eed\u91c7\u8d2d\u516c\u53f8\uff0c\u5e76\u6388\u6743\u91c7\u8d2d\u516c\u53f8\u7684\u987e\u95ee\u8bbf\u95ee\u81ea\u5bb6\u516c\u53f8\u7684 GFW Pro \u8d26\u6237\uff0c\u4ee5\u5bf9\u91c7\u8d2d\u94fe\u4e0a\u5b58\u5728\u7684\u6ee5\u4f10\u98ce\u9669\u8fdb\u884c\u6536\u8d39\u8bc4\u4f30\u3002\u8fdb\u884c\u5c3d\u804c\u8c03\u67e5\u6d3b\u52a8\u65f6\uff0c\u8be5\u4f01\u4e1a\u8fd8\u53ef\u5141\u8bb8\u4e3a\u6269\u5145\u4eba\u5458\u800c\u8058\u7528\u7684\u627f\u5305\u5546\u4f7f\u7528\u4f01\u4e1a\u7684 GFW Pro \u8d26\u6237\u3002GFW Pro \u8d26\u6237\u6301\u6709\u8005\u5e94\u5bf9\u8fd9\u4e9b\u53d7\u8058\u65b9\u4f7f\u7528 GFW Pro \u7684\u884c\u4e3a\u8d1f\u8d23\uff0c\u5305\u62ec\u76d1\u7ba1\u5e76\u786e\u4fdd\u4ed6\u4eec\u9075\u5b88 GFW Pro <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8bb8\u53ef\u534f\u8bae</a>\u7684\u6761\u6b3e\u3002&nbsp;", "6ca76215a704bc9b9db534d6339783d4": "\u5171\u4eab\u6b64\u7c7b\u6570\u636e\u7528\u4e8e\u7ecf\u8bb8\u53ef\u7684\u76f4\u63a5\u5408\u89c4\u6027\u62a5\u544a\uff08\u5177\u4f53\u89e3\u91ca\u53c2\u89c1\u524d\u6587\uff09\u3002&nbsp;", "92410c7b21b31edb6d92226d35fdd06d": "\u54ea\u4e9b GFW Pro \u6570\u636e\u53ef\u4ee5\u5728\u6ca1\u6709\u5206\u8bb8\u53ef\u6743\u7684\u60c5\u51b5\u4e0b\u5171\u4eab\uff1f", "92cc31a1d4d058743844cf6f48520279": "\u201c\u6539\u7f16\u6743\u201d\u53ef\u5141\u8bb8\u54ea\u4e9b\u64cd\u4f5c\uff1f", "33365d8f49fc400b7d6dbc4a7e6544af": "\u4e00\u5bb6\u6d88\u8d39\u54c1\u5236\u9020\u5546\u7684\u5185\u90e8\u79d1\u5b66\u5bb6\u53ef\u80fd\u4f1a\u5c06\u6765\u81ea\u7279\u5b9a\u5730\u533a\u7684\u5546\u54c1\u7684\u72ec\u7279\u54c1\u8d28\u6570\u636e\u4e0e\u6ee5\u4f10\u98ce\u9669\u6570\u636e\u76f8\u7ed3\u5408\uff0c\u4ece\u800c\u521b\u5efa\u4ea7\u54c1\u54c1\u8d28\u8bc4\u5206\u5236\u5ea6\uff0c\u4ee5\u786e\u5b9a\u662f\u5426\u9002\u5408\u5c06\u5176\u9500\u5f80\u4e0d\u540c\u5e02\u573a\u3002\u4e70\u5bb6\u53ef\u80fd\u5e0c\u671b\u5728\u505a\u51fa\u8d2d\u4e70\u51b3\u7b56\u65f6\u770b\u5230\u8fd9\u4e00\u8bc4\u5206\uff0c\u5e76\u5e0c\u671b\u5236\u9020\u5546\u80fd\u5c06\u8be5\u8bc4\u5206\u7eb3\u5165\u4ea7\u54c1\u8d44\u6599\u4ee5\u4f9b\u53c2\u8003\u3002\u5982\u82e5 GFW Pro \u8f93\u51fa\u7ed3\u679c\u6700\u7ec8\u4e0d\u4f1a\u4e0e\u53d1\u8d27\u4ea7\u54c1\u4e00\u8d77\u5206\u53d1\uff0c\u5219\u8be5\u8bc4\u5206\u5236\u5ea6\u5c5e\u4e8e\u7ecf\u8bb8\u53ef\u7684\u6539\u7f16\u3002&nbsp;", "e0697a1e4749d78298baaf746d417b6b": "\u8bf7\u6ce8\u610f\uff0c\u5728\u4f7f\u7528 GFW Pro \u548c\u7b2c\u4e09\u65b9\u6570\u636e\u6e90\u65f6\uff0c\u5fc5\u987b\u6839\u636e<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8bb8\u53ef\u534f\u8bae</a>\u548c GFW Pro <a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6570\u636e\u96c6\u5e93 &amp; \u7f72\u540d</a>\u4e2d\u7684\u6307\u5357\uff0c\u5728\u6539\u7f16\u6587\u4ef6\u4e2d\u9644\u4e0a\u9002\u5f53\u7684\u7f72\u540d\u3002&nbsp;", "3eb5547e0125e2370a493a0fd3b53fe8": "\u6d4f\u89c8\u8fd9\u4e9b\u5e38\u89c1\u95ee\u9898\uff0c\u4e86\u89e3\u6709\u5173 GFW Pro \u6536\u8d39\u6a21\u5f0f\u3001\u6536\u8d39\u573a\u666f\u548c\u4e0d\u6536\u8d39\u573a\u666f\u7684\u66f4\u591a\u4fe1\u606f\u3002\u5e38\u89c1\u95ee\u9898\u65e8\u5728\u63d0\u4f9b\u89e3\u91ca\uff0c\u6309\u573a\u666f\u7ed9\u4e88\u6307\u5bfc\uff0c\u4f46\u5982\u51fa\u73b0\u4efb\u4f55\u4e0d\u4e00\u81f4\u4e4b\u5904\uff0c\u5e94\u4ee5 GFW Pro \u73b0\u884c\u6709\u6548\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8bb8\u53ef\u534f\u8bae</a>\u548c<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u4ef7\u76ee\u8868</a>\u7684\u7528\u8bed\u4e3a\u51c6\u3002&nbsp;", "c61035564c455b77b54e28068bfbc10f": "\u6211\u80fd\u514d\u8d39\u4f7f\u7528 GFW Pro \u5417\uff1f", "2c2ee295bd70057fe48bb582eefe9296": "\u53ef\u4ee5\u3002\u6bcf\u5bb6\u4f01\u4e1a\u6bcf\u5e74\u90fd\u53ef\u83b7\u5f97\u514d\u8d39\u7684 GFW Pro \u4f7f\u7528\u989d\u3002\u514d\u8d39\u4f7f\u7528\u989d\u5ea6\u4e3a 5,000 \u4e2a\u76d1\u6d4b\u70b9\u5206\u6790 (MLAs) \u548c 1 \u4ebf\u516c\u9877 (HOPs)\u3002&nbsp;", "606fbc3d54cdf31d8e414967fda0dd88": "\u6bcf\u5e74\u7684\u514d\u8d39\u4f7f\u7528\u91cf\u53ca MLAs \u548c HOPs \u7684\u5b9a\u4e49\u8f7d\u4e8e\u6700\u65b0\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u4ef7\u76ee\u8868</a>\u4e2d\u3002&nbsp;", "8ac2a1d4a22bf7a6b239c5663091b972": "\u514d\u8d39\u4f7f\u7528\u91cf\u4e3a\u4ec0\u4e48\u6709\u9650\u989d\uff1f", "00f2b5521bd6904f5615059b74dc05fd": "\u90e8\u5206\u662f\u56e0\u4e3a\u300a\u6b27\u76df\u96f6\u6bc1\u6797\u6cd5\u6848\u300b(European Union Deforestation Regulation, EUDR) \u7684\u51fa\u53f0\u4f7f\u5f97 GFW Pro \u5f97\u5230\u4e86\u5404\u4f01\u4e1a\u548c\u7ec4\u7ec7\u7684\u5e7f\u6cdb\u91c7\u7528\uff1b\u540c\u65f6\uff0c\u6211\u4eec\u4e5f\u9700\u8981\u8fdb\u884c\u4ea7\u54c1\u6295\u8d44\uff08\u5982\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6ee5\u4f10\u62a5\u544a</a>\uff09\u3002\u8fd9\u4e9b\u90fd\u63a8\u52a8\u4e86\u6210\u672c\u7684\u589e\u52a0\u3002\u56e0\u6b64\uff0c\u4e3a\u5728\u4fdd\u6301 GFW Pro \u5e73\u53f0\u516c\u76ca\u6027\u7684\u540c\u65f6\u7ee7\u7eed\u6ee1\u8db3 GFW Pro \u7528\u6237\u7684\u9700\u6c42\uff0c\u5bf9\u4e8e\u8d85\u51fa\u5e74\u5ea6\u514d\u8d39\u7528\u91cf\u7684\u4f7f\u7528\u91cf\uff0c\u4ee5\u53ca\u4f7f\u7528\u7528\u4e8e\u5206\u53d1\u7684\u6388\u6743\u5185\u5bb9\uff0c\u6211\u4eec\u90fd\u9700\u8981\u7528\u6237\u652f\u4ed8\u5408\u7406\u8d39\u7528\u3002&nbsp;", "37841c7c708289f0cc30c13f4c44d9ee": "\u5bf9\u4e8e\u57fa\u4e8e\u7b2c\u4e09\u65b9\u6570\u636e\u6e90\u6784\u5efa\u7684\u3001\u4f7f\u7528\u6743\u8303\u56f4\u8f83\u7a84\u7684\u5206\u6790\u7ed3\u679c\uff08\u5982\u4f9d\u9760\u901a\u8fc7 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">IBAT Alliance</a> \u6388\u6743\u7684\u6570\u636e\u8fdb\u884c\u7684\u4fdd\u62a4\u533a\u91cd\u53e0\u5206\u6790\uff09\uff0c\u53ef\u80fd\u8fd8\u4f1a\u9002\u7528\u67d0\u4e9b\u89c4\u5219\u548c\u9650\u5236\u6709\u5173\u5177\u4f53\u9650\u5236\u548c\u7f72\u540d\u8981\u6c42\uff0c\u8bf7\u53c2\u9605 GFW Pro <a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8bb8\u53ef\u534f\u8bae</a>\u548c<a href=\"{{2}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6570\u636e\u96c6\u5e93 &amp; \u7f72\u540d</a>\u3002&nbsp;", "8b6fe1ab7b75b3b43e262a2380971e4f": "\u5171\u4eab GFW Pro \u8f93\u51fa\u4e3a\u4ec0\u4e48\u9700\u8981\u5206\u8bb8\u53ef\u6743\uff1f", "6fa7370d4cc980a9aca1a4f59747e1e5": "GFW Pro \u5e73\u53f0\u7684\u5b58\u5728\u5f97\u76ca\u4e8e\u6148\u5584\u6350\u52a9\u65b9\uff08\u5982 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Gordon and Betty Moore Foundation</a>\uff0c<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">NICFI</a>\uff0c<a href=\"{{2}}\" target=\"_blank\" rel=\"noreferrer noopener\">USAID</a>\uff09\u548c\u79c1\u8425\u90e8\u95e8\u7684\u652f\u6301\u8005\u7684\u6177\u6168\u76f8\u52a9\u3002\u968f\u7740\u96f6\u6bc1\u6797\u6761\u4f8b\u9010\u6b65\u53d1\u5c55\u9002\u5e94\u81ea\u613f\u6027\u7684\u96f6\u6bc1\u6797\u627f\u8bfa\uff0c\u6350\u52a9\u65b9\u5bf9\u65b0\u76d1\u6d4b\u529f\u80fd\u7684\u8d44\u52a9\u4e5f\u5728\u4e0d\u65ad\u53d1\u5c55\u4e3a\u5e94\u5bf9\u90a3\u4e9b\u9700\u8981\u591a\u65b9\u4e92\u8865\u624d\u80fd\u89e3\u51b3\u7684\u73af\u5883\u95ee\u9898\uff0c\u4f8b\u5982\u7981\u6b62\u6539\u53d8\u975e\u68ee\u6797\u81ea\u7136\u571f\u5730\u7684\u6027\u8d28\u3002\u8fd9\u610f\u5473\u7740 GFW Pro \u5728\u6838\u5fc3\u6ee5\u4f10\u5206\u6790\u65b9\u9762\u7684\u6295\u8d44\u5c06\u65e5\u76ca\u4f9d\u8d56\u4e8e\u5e73\u53f0\u5546\u4e1a\u7528\u6237\u7684\u652f\u6301\u3002&nbsp;", "34afc30e3bad8a37d312198f4e69d0b0": "\u4e00\u5bb6<strong>\u5408\u4f5c\u793e</strong>\u4e3a\u6bcf\u4e2a\u5c0f\u519c\u6237\u5730\u5757\u751f\u6210\u4e86 GFW Pro \u8f93\u51fa (MLA)\uff0c\u8be5\u4f7f\u7528\u91cf\u5728\u5e74\u5ea6\u514d\u8d39\u7528\u91cf\u8303\u56f4\u5185\u3002\u5f53\u5546\u54c1\u4e70\u5bb6\u8981\u6c42\u5408\u4f5c\u793e\u63d0\u4f9b\u591a\u8fb9\u5f62\u548c\u6570\u636e\u4f5c\u4e3a\u96f6\u6bc1\u6797\u58f0\u660e\u7684\u652f\u6491\u8bc1\u636e\u65f6\uff0c\u8fd9\u5bb6\u5408\u4f5c\u793e\u53ef\u5411\u4e70\u5bb6\u6536\u53d6\u516c\u5f00\u900f\u660e\u7684\u8bc1\u636e\u8d39\u7528\uff0c\u6216\u5c06\u8be5\u8bc1\u636e\u6210\u672c\uff08\u5373\u7279\u5b9a\u5730\u70b9\u7684\u5206\u8bb8\u53ef\u6743\uff09\u8ba1\u5165\u4ea7\u54c1\u4ef7\u683c\u3002\u5408\u4f5c\u793e\u751a\u81f3\u53ef\u4ee5\u901a\u8fc7\u5c06\u76f8\u540c\u7684 GFW Pro \u4fe1\u606f\u8f6c\u552e\u7ed9\u8d2d\u4e70\u540c\u4e00\u6765\u6e90\u5730\u70b9\u4ea7\u54c1\u7684\u591a\u4e2a\u4e70\u5bb6\u6765\u83b7\u53d6\u5fae\u8584\u5229\u6da6\u3002&nbsp;", "76429757eaed33cbea22c442fa80af9f": "\u4e00\u5bb6<strong>\u519c\u4e1a\u4fe1\u8d37\u673a\u6784</strong>\u4e3a\u501f\u65b9\u7684\u5730\u4ea7\u751f\u6210\u4e86 GFW Pro \u62a5\u544a\uff0c\u4ee5\u6838\u5b9e\u5176\u4ea7\u54c1\u662f\u5426\u7b26\u5408\u6709\u5438\u5f15\u529b\u7684\u5e02\u573a\uff08\u5982\u6b27\u76df\uff09\u7684\u51c6\u5165\u8d44\u683c\uff0c\u6216\u8bc4\u4f30\u5c06\u7eff\u8272\u91d1\u878d\u5de5\u5177\u4e0e\u8be5\u5730\u4ea7\u7684\u81ea\u7136\u690d\u88ab\u4fdd\u62a4\u76f8\u7ed3\u5408\u7684\u673a\u4f1a\u3002\u5982\u679c\u4fe1\u8d37\u673a\u6784\u968f\u540e\u5c06\u8fd9\u4e9b\u8d37\u6b3e\u6346\u7ed1\u8f6c\u552e\u7ed9\u5176\u4ed6\u65b9\uff0c\u8be5\u4fe1\u8d37\u673a\u6784\u53ef\u4ee5\u8d2d\u4e70\u5206\u8bb8\u53ef\u6743\uff0c\u4ee5\u4fbf\u5c06\u8fd9\u4e9b\u652f\u6301\u8bc1\u636e\u5171\u4eab\u7ed9\u4e0b\u6e38\u4e70\u5bb6\u3002&nbsp;", "0fbc40fd5f70c956bdaa144824a55435": "\u5bf9\u4e8e\u975e\u6bd7\u90bb\u3001\u975e\u91cd\u53e0\u3001\u4e14\u7531\u72ec\u7acb\u5404\u65b9\u62e5\u6709\u7684\u591a\u4e2a\u91c7\u8d2d\u5730\u70b9\u7684\u6c47\u603b\u6570\u636e\u6216\u5e73\u5747\u7ed3\u679c\uff0c\u53ef\u5728\u672a\u83b7\u5f97\u5404\u7ec4\u6210\u5730\u70b9\u5206\u8bb8\u53ef\u6743\u7684\u60c5\u51b5\u4e0b\u5171\u4eab\u3002\u5982\u679c\u65e0\u6cd5\u4ece\u6c47\u603b\u6570\u636e\u4e2d\u89e3\u6790\u79bb\u6563\u5730\u70b9\u7684 GFW Pro \u8f93\u51fa\uff0c\u5219\u8be5\u5185\u5bb9\u901a\u5e38\u4e0d\u9002\u5408\u7528\u4f5c\u8bc1\u636e\u6027\u5185\u5bb9\u3002\u4e0d\u8fc7\uff0c\u8fd9\u4e9b\u6c47\u603b\u6570\u636e\u5bf9\u4e8e\u62a5\u544a\u4f01\u4e1a\u5728\u5b9e\u73b0\u73af\u5883\u53ef\u6301\u7eed\u53d1\u5c55\u76ee\u6807\u65b9\u9762\u7684\u8fdb\u5c55\u8fd8\u662f\u5f88\u6709\u4ef7\u503c\u7684\u3002\u4fc3\u8fdb\u53ef\u6301\u7eed\u53d1\u5c55\u7ee9\u6548\u7684\u900f\u660e\u5316\u62a5\u544a\uff0c\u662f GFW Pro \u7684\u4e00\u5927\u91cd\u8981\u4f7f\u547d\uff0c\u56e0\u6b64\uff0c\u6211\u4eec\u9f13\u52b1\u7528\u6237\u4f7f\u7528\u6c47\u603b\u7684 GFW Pro \u7ed3\u679c\uff08\u4f46\u4e0d\u53ef\u6807\u8bc6\u5177\u4f53\u7684\u6765\u6e90\u5730\u70b9\uff09\uff0c\u5bf9\u5916\u90e8\u5171\u4eab\u6b64\u7c7b\u7ed3\u679c\u4e5f\u4e0d\u6536\u53d6\u8d39\u7528\u3002", "d30af845197d6c458030e29fb0aefc83": "GFW Pro \u7528\u6237\u6301\u6709\u8005\u53ef\u521b\u5efa\u5e76\u53d1\u5e03\u4ee5 GFW Pro \u5206\u6790\u4e3a\u57fa\u7840\u7684\u884d\u751f\u4f5c\u54c1\uff0c\u524d\u63d0\u662f\u8fd9\u4e9b\u884d\u751f\u4f5c\u54c1\u4e0e\u539f\u59cb\u8f93\u51fa\u7ed3\u679c\u6709\u5b9e\u8d28\u6027\u533a\u522b\u3002\u6240\u8c13\u201c\u5b9e\u8d28\u6027\u533a\u522b\u201d\uff0c\u662f\u6307 (1) \u8d26\u6237\u6301\u6709\u8005\u6216\u7b2c\u4e09\u65b9\u6765\u6e90\u7684\u6570\u636e\u548c\u5206\u6790\u5df2\u4e0e GFW Pro \u8f93\u51fa\u7ed3\u679c\u6574\u5408\uff0c\u521b\u5efa\u51fa\u5355\u51ed GFW Pro \u8f93\u51fa\u7ed3\u679c\u65e0\u6cd5\u5b9e\u73b0\u7684\u5185\u5bb9\uff0c\u6216 (2) \u901a\u8fc7\u4e00\u5b9a\u7684\u5206\u6790\u65b9\u6cd5\u5bf9\u539f\u59cb\u6570\u636e\u8fdb\u884c\u8f6c\u6362\uff0c\u4f7f\u63a5\u6536\u8005\u65e0\u6cd5\u901a\u8fc7\u9006\u5411\u5de5\u7a0b\u786e\u5b9a\u539f\u59cb\u7684 GFW Pro \u8f93\u51fa\u503c\u3002\u5982\uff1a&nbsp;", "17dc0d65e511d8b07f0c262cc738ef08": "\u5f02\u5e38\u9ad8", "422ab6318b3424703f84632f0a78ebd8": "\u63a2\u7d22\u8fd1\u671f\u5168\u7403\u706b\u707e\u8b66\u62a5\u8d8b\u52bf", "4bc811fe375f93d82249d9dec39b0e69": "\u76d1\u63a7\u60a8\u6240\u5728\u533a\u57df\u7684\u706b\u707e", "e89e2ca631dd581380ceed80e16d2c62": "\u4fdd\u5b58\u4e00\u4e2a\u533a\u57df\u5e76\u8ba2\u9605\uff0c\u4ee5\u4fbf\u5728\u68c0\u6d4b\u5230\u65b0\u7684\u706b\u707e\u8b66\u62a5\u65f6\u6536\u5230\u7535\u5b50\u90ae\u4ef6", "b0145ab43f646167f3ce0c623a07730d": "\u8bbf\u95ee\u57fa\u672c\u7684\u5730\u56fe\u5de5\u5177\uff1a\u7f29\u653e\u3001\u6269\u5c55\u5730\u56fe\u3001\u5171\u4eab\u6216\u5d4c\u5165\u3001\u6253\u5370\u548c\u6d4f\u89c8\u5730\u56fe\u3002\u8fd8\u53ef\u4ee5\u67e5\u770b\u7f29\u653e\u7ea7\u522b\u548c\u7eac\u5ea6/\u7ecf\u5ea6\u5750\u6807\u3002", "ead6d58e3ccea798da5811b5edb380a4": "{location}\u7684\u68ee\u6797\u7ecf\u6d4e\u5f71\u54cd", "1fdf6bbd34c65a073c23d425e6be913d": "\u706b\u707e\u8b66\u62a5\u8ba1\u6570\u4e5f\u4e0e\u663e\u8457\u6027\u6c34\u5e73\u76f8\u5173\u3002\u8fd9\u4e2a\u663e\u8457\u6027\u6c34\u5e73\u662f\u7531\u5728\u9009\u5b9a\u65f6\u95f4\u95f4\u9694\u5185\u7684\u706b\u707e\u8b66\u62a5\u6570\u91cf\u4e0e\u9884\u671f\u503c\uff08\u8003\u8651\u540c\u4e00\u65f6\u95f4\u6bb5\u5185\u6240\u6709\u53ef\u7528\u5386\u53f2\u6570\u636e\u8868\u73b0\uff09\u4e4b\u95f4\u7684\u5dee\u5f02\u51b3\u5b9a\u7684\u3002", "5416389df329a4bda67c8d299b613685": "\u867d\u7136\u91ce\u706b\u5728\u4e00\u4e9b\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u5185\u662f\u4e00\u79cd\u81ea\u7136\u73b0\u8c61\uff0c\u4f46\u706b\u707e\u5b63\u8282\u6b63\u53d8\u5f97\u66f4\u52a0\u6781\u7aef\u548c\u5e7f\u6cdb\uff0c\u751a\u81f3\u5728\u706b\u707e\u5e76\u975e\u5e38\u89c1\u4e14\u7834\u574f\u6027\u7279\u522b\u5927\u7684\u70ed\u5e26\u96e8\u6797\u4e5f\u662f\u5982\u6b64\u3002\u6c14\u5019\u53d8\u5316\u5bfc\u81f4\u5929\u6c14\u66f4\u70ed\u3001\u66f4\u5e72\u71e5\u4ee5\u53ca\u571f\u5730\u7ba1\u7406\u4e0d\u5584\uff0c\u4e3a\u66f4\u9891\u7e41\u3001\u66f4\u5927\u89c4\u6a21\u3001\u66f4\u9ad8\u5f3a\u5ea6\u7684\u91ce\u706b\u521b\u9020\u4e86\u6709\u5229\u6761\u4ef6\u3002", "7f6c73ee7b00a0e8bc9931227d6c385d": "\u5728GFW\u535a\u5ba2\u4e0a\u4e86\u89e3\u68ee\u6797\u548c\u706b\u707e\u4e4b\u95f4\u7684\u590d\u6742\u5173\u7cfb\u3002", "5449c52cd9e659a57842b5fc5264b58f": "+ \u9009\u62e9\u4e00\u4e2a\u4ea4\u53c9\u70b9", "809553ff6bc4c0ae9392a5aa7bd05b42": "\u67e5\u770b\u7d2f\u8ba1\u706b\u707e\u8b66\u62a5", "79d1ac41e7553ee5aa4af0d4cd10796f": "\u6b63\u5e38\u8303\u56f4", "447b2355935f03b8a09871a04bab527c": "\u4e86\u89e3\u5317\u65b9\u68ee\u6797\u7684\u68ee\u6797\u706b\u707e\u548c\u6c14\u5019\u53d8\u5316", "274e1492990ab112ad5d17db3025fe35": "\u603b\u751f\u7269\u91cf", "bcac788ecae50b663f66c691a8a9ba46": "\u91ce\u706b\u5c06\u4e8c\u6c27\u5316\u78b3\u548c\u5176\u4ed6\u6c61\u67d3\u7269\u91ca\u653e\u5230\u5927\u6c14\u4e2d\uff0c\u52a0\u5267\u5168\u7403\u53d8\u6696\uff0c\u4e25\u91cd\u60c5\u51b5\u4e0b\uff0c\u4f1a\u5bf9\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u9020\u6210\u4e0d\u53ef\u633d\u56de\u7684\u7834\u574f\u3002\u7531\u6b64\u4ea7\u751f\u7684\u70df\u96fe\u548c\u96fe\u973e\u53ef\u4ee5\u4f20\u64ad\u6570\u82f1\u91cc\uff0c\u4f7f\u4eba\u5438\u5165\u4e0d\u5065\u5eb7\u6c34\u5e73\u7684\u6c61\u67d3\u7269\uff0c\u9020\u6210\u516c\u5171\u536b\u751f\u5371\u673a\u3002\u5931\u63a7\u7684\u91ce\u706b\u5bfc\u81f4\u8d22\u4ea7\u548c\u81ea\u7136\u65c5\u6e38\u666f\u70b9\u88ab\u7834\u574f\u3001\u6c34\u6e90\u88ab\u6c61\u67d3\u3001\u7ecf\u6d4e\u56e0\u758f\u6563\u800c\u762b\u75ea\uff0c\u6bcf\u5e74\u56e0\u6b64\u9020\u6210\u6570\u5341\u4ebf\u7f8e\u5143\u7684\u7ecf\u6d4e\u635f\u5931\u3002", "e00b655d7d35f1f59c1810f5c1ee9e5a": "\u5728\u5730\u56fe\u4e0a\u63a2\u7d22\u706b\u707e\u8b66\u62a5", "b4d64688fbaaedc60202b37757c561dc": "\u8fd9\u4e2a\u5c0f\u90e8\u4ef6\u6839\u636e\u7528\u6237\u6240\u9009\u65f6\u671f\u8fd9\u4e9b\u884c\u653f\u533a\u57df\u5185\u53d1\u751f\u7684\u706b\u707e\u8b66\u62a5\u6570\u91cf\u5bf9\u5176\u8fdb\u884c\u6392\u5e8f\u3002\u7528\u6237\u8fd8\u53ef\u4ee5\u6839\u636e\u7279\u5b9a\u7684\u68ee\u6797\u533a\u57df\u6216\u68ee\u6797\u4f7f\u7528\u60c5\u51b5\u5bf9\u8fd9\u4e9b\u8b66\u62a5\u8fdb\u884c\u7b5b\u9009\u3002", "44e6a45489e752457ab860d882517c94": "\u5728\u9ad8\u7eac\u5ea6\u68ee\u6797\u4e2d\uff0c\u706b\u707e\u5c06\u91cd\u8981\u7684\u8425\u517b\u7269\u8d28\u91ca\u653e\u5230\u571f\u58e4\u4e2d\uff0c\u5e76\u5e2e\u52a9\u79cd\u5b50\u6563\u5e03\uff0c\u4ece\u800c\u5e2e\u52a9\u7ef4\u6301\u5065\u5eb7\u7684\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u3002\u5728\u70ed\u5e26\u68ee\u6797\u4e2d\uff0c\u5f53\u5730\u548c\u571f\u8457\u793e\u533a\u51e0\u4e2a\u4e16\u7eaa\u4ee5\u6765\u4e00\u76f4\u4f7f\u7528\u53d7\u63a7\u706b\u707e\u6765\u6e05\u9664\u571f\u5730\u4e0a\u7684\u6811\u6728\u4ee5\u7528\u4e8e\u519c\u4e1a\u3002", "0a4ffe08325b64e1942287b2e73e853d": "\u67e5\u770b\u706b\u707e\u8b66\u62a5\uff0c\u4e86\u89e3\u76ee\u524d\u53d1\u751f\u706b\u707e\u6700\u591a\u7684\u5730\u65b9\u3002", "b221c4d58e487b8cb0544376bf9f50fb": "\u5c06\u4eca\u5e74\u7d2f\u8ba1\u706b\u707e\u8b66\u62a5\u6570\u91cf\u4e0e\u5f80\u5e74\u8fdb\u884c\u6bd4\u8f83\u3002", "391ae85461754460b8a99fe371d54032": "\u6765\u81ea{location}\u7684\u5927\u5b97\u5546\u54c1\u6d41", "cfe329da8b5a6f07bf2218826d474244": "\u4e86\u89e3\u4e00\u4e2a\u7ec4\u7ec7\u5728\u5370\u5ea6\u5c3c\u897f\u4e9a\u5ed6\u5185\u7701\u7684\u6d88\u9632\u5b89\u5168\u5de5\u4f5c", "49d6220a34ce64f1e3af9e211c277e4f": "\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u4e16\u754c\u4efb\u610f\u5730\u70b9\u7684\u706b\u707e\u8b66\u62a5\u2014\u2014\u6bcf\u65e5\u66f4\u65b0\u3002", "3338aa16d3a7f1645e04c2f9966a954a": "\u5728\u91ce\u5916\u5bfc\u822a\u5e76\u62a5\u544a\u706b\u707e\u8b66\u62a5", "504a24f2e0ce1e776cf56e6d59c9cabd": "\u63a2\u7d22\u706b\u707e\u8b66\u62a5\u7684\u6700\u65b0\u8d8b\u52bf", "28e9d3786b66f81c5b37bb0caf0ef50a": "\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u706b\u707e\u8b66\u62a5", "11aadeb23dcb733c291eb2622ff31851": "\u4ece{startYear}\u5230{endYear}\u5e74\uff0c{location}<b>humid primary forest lost</b>\u603b\u8ba1{loss}\uff0c\u5360\u540c\u671f{total tree cover loss}\u7684{percent}\u3002\u8fd9\u6bb5\u65f6\u671f{location}\u6e7f\u6da6\u539f\u59cb\u6797\u603b\u9762\u79ef\u51cf\u5c11</b>{extentDelta}\u3002", "e31e33b83af40c63fd624bf835b692f5": "\u8ba1\u5212\u706b\u70e7\u3001\u6539\u5584\u57fa\u7840\u8bbe\u65bd\u7684\u7ef4\u62a4\u3001\u9632\u706b\u610f\u8bc6\u7684\u63d0\u9ad8\u53ca\u9632\u706b\u6559\u80b2\uff0c\u4ee5\u53ca\u7981\u706b\u4ee4\u7b49\u653f\u7b56\u5e72\u9884\u624b\u6bb5\u53ef\u4ee5\u964d\u4f4e\u68ee\u6797\u706b\u707e\u98ce\u9669\u3002\u907f\u514d\u68ee\u6797\u780d\u4f10\u548c\u68ee\u6797\u9000\u5316\u4e5f\u80fd\u63d0\u9ad8\u68ee\u6797\u5bf9\u706b\u707e\u7684\u62b5\u5fa1\u80fd\u529b\u3002", "960b44c579bc2f6818d2daaf9e4c16f0": "\u6b63\u5e38", "ef67b080c15fac5356023a1c97ee5f95": "\u641c\u7d22\u6570\u636e\u96c6\u3001\u4f4d\u7f6e\u6216\u5730\u7406\u5750\u6807\u3002", "7b0e17475ccbfda48f8d7333b2ca3b2f": "\u9ad8\u4e8e/\u4f4e\u4e8e\u6b63\u5e38\u8303\u56f4", "618349f1c892a92a1511700c90e1f13d": "{location}\u7684\u79cd\u690d\u56ed\u4f4d\u7f6e", "71e1513153cce90ee77c852d2c57bf90": "\u6eaf\u6e90\u5e73\u53f0\u670d\u52a1\u63d0\u4f9b\u5546\u53ef\u5c06 GFW Pro \u7684\u5206\u6790\u6570\u636e\u4e0e\u91c7\u8d2d\u5730\u70b9\u7684\u5176\u4ed6\u5404\u79cd\u4fe1\u606f\uff08\u5982\u7ecf\u6838\u5b9e\u7684\u6295\u8bc9\u6570\u91cf\uff09\u7ed3\u5408\u8d77\u6765\uff0c\u4e3a\u4ece\u8be5\u5730\u70b9\u91c7\u8d2d\u7684\u4ea7\u54c1\u5236\u5b9a\u7efc\u5408\u98ce\u9669\u8bc4\u5206\u3002\u5982\u679c\u8be5\u5206\u6570\u662f\u5448\u73b0\u7ed9\u6eaf\u6e90\u5e73\u53f0\u7528\u6237\u7684\u552f\u4e00\u6570\u503c\uff0c\u5219\u7279\u5b9a\u5730\u70b9\u7684 GFW Pro \u6570\u636e\u5c31\u6ca1\u6709\u88ab\u5206\u53d1\uff0c\u4e5f\u5c31\u65e0\u9700\u53d6\u5f97\u5206\u8bb8\u53ef\u6743\u3002\u5c06\u5404\u79cd\u56e0\u7d20\u5f52\u7ed3\u6210\u5355\u4e00\u7684\u98ce\u9669\u5206\u6570\uff0c\u8fd9\u79cd\u505a\u6cd5\u5b58\u5728\u56fa\u6709\u6743\u8861\u95ee\u9898\uff0c\u53ef\u80fd\u4f1a\u5f71\u54cd\u53ef\u6301\u7eed\u53d1\u5c55\u7684\u76ee\u6807\u3002\u56e0\u6b64\uff0c\u8fd9\u79cd\u505a\u6cd5\u5e94\u88ab\u89c6\u4e3a\u8bf4\u660e\u6027\u505a\u6cd5\uff0c\u800c\u975e\u63a8\u8350\u64cd\u4f5c\u3002&nbsp;", "97391fa727cb8a60c3fbbd2eb52aa966": "\u4e3a\u4ec0\u4e48\u6211\u5217\u8868\u4e2d\u7684\u5730\u70b9\u672a\u80fd\u5f97\u5230\u5206\u6790\uff1f", "04a619113d0c0da890d395b64f0bf8e0": "Pro \u7248\u672c\u7684\u6570\u636e\u591a\u4e45\u66f4\u65b0\u4e00\u6b21\uff1f", "9a52d8a9624bfa0264cd4eedba550a4f": "\u5982\u4f55\u6839\u636e\u6211\u7684\u6570\u636e\u751f\u6210\u6ee5\u4f10 KPI \u5206\u6790\uff1f", "ae5628e8de6240f2da899ec83b9c9099": "\u5bf9\u4e8e\u5df2\u7ecf\u5206\u6790\u8fc7\u7684\u73b0\u6709\u5217\u8868\uff1a&nbsp;&nbsp;", "812fe064104fcfd5963565bfdeb3172e": "\u8bf7\u6253\u5f00\u201c\u5730\u70b9\u201d\u9875\u9762\u4e0a\u7684\u201c\u2026\u201d\u83dc\u5355\uff0c\u7136\u540e\u5c06\u5206\u6790\u7c7b\u578b\u9009\u4e2d\u4e3a\u201c\u6ee5\u4f10\u62a5\u544a\uff08\u622a\u6b62\u65e5\u671f\u4e3a 2020 \u5e74\uff09\u201d&nbsp;", "e74759b68bd25b2084b97ad24ec9c34a": "&nbsp;&nbsp;&nbsp;&nbsp;\u5bf9\u4e8e\u65b0\u4e0a\u4f20\u81f3\u5e73\u53f0\u7684\u5217\u8868\uff1a&nbsp;", "ebd9d005d191e5ebb38786975b34bdd5": "\u6211\u662f\u5426\u80fd\u4e3a\u4efb\u610f\u7c7b\u578b\u7684\u5217\u8868/\u6570\u636e\u751f\u6210\u6ee5\u4f10 KPI \u5206\u6790\uff1f", "3ef54b77de0b7d053c9c05eabe0816f5": "\u68ee\u6797\u53d8\u5316\u8bca\u65ad", "a4a32c4764653e50488bff6ce2eb815b": "\u57fa\u7ebf", "d78c06cc4d7a5934262a90e76ee2cca4": "\u4e3b\u8981\u529f\u80fd", "3b8c7ed32bea14e6b0e98f85d44a642d": "\u53ef\u5ffd\u7565\u98ce\u9669\u5730\u56fe\u660e\u786e\u4e86\u56fd\u5bb6/\u5730\u533a\u5c42\u7ea7\u4ee5\u4e0b\u4e24\u4e2a\u7ea7\u522b\u7684\u6ee5\u4f10\u98ce\u9669\uff1b\u4f8b\u5982\uff0c\u5728\u56fd\u5bb6/\u5730\u533a&gt;\u5dde&gt;\u90e1\u53bf\u5c42\u7ea7\u6216\u56fd\u5bb6/\u5730\u533a&gt;\u5dde&gt;\u81ea\u6cbb\u5e02\u5c42\u7ea7\u4e2d\uff0c\u5206\u522b\u5c06\u4e8e\u90e1\u53bf\u6216\u81ea\u6cbb\u5e02\u4e00\u7ea7\u8fdb\u884c\u53ef\u5ffd\u7565\u98ce\u9669\u7684\u8bc4\u4f30\u3002\u603b\u4f53\u800c\u8a00\uff0c2021 \u5e74\u521d\u4ee5\u6765\uff0c\u98ce\u9669\u53ef\u5ffd\u7565\u4e0d\u8ba1\u7684\u884c\u653f\u533a\u57df\u5171\u5360\u56fd\u5bb6/\u5730\u533a\u7ea7\u7d2f\u8ba1\u6ee5\u4f10\u603b\u91cf\u7684\u4e0d\u8db3\u767e\u5206\u4e4b\u4e00 (1%)\u3002\u5168\u56fd\u6240\u6709\u5176\u4ed6\u884c\u653f\u533a\u57df\u5747\u5b58\u5728\u4e0d\u53ef\u5ffd\u7565\u7684\u6ee5\u4f10\u98ce\u9669\u3002&nbsp;", "2dbe104540729f5dbf9af84ba69c7f28": "\u5982\u679c\u9047\u5230\u6f0f\u6d1e\u6216\u9519\u8bef\uff0c\u6211\u5e94\u8be5\u8054\u7cfb\u8c01\uff1f", "786e2fbbea1a85ed51377eb5d7bbaf3a": "\u4ece Global Forest Watch Pro \u83b7\u53d6\u6216\u63d0\u53d6\u7684\u6570\u636e\u5fc5\u987b\u4f9d\u7167\u5e73\u53f0\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8bb8\u53ef\u534f\u8bae</a>\u548c<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u670d\u52a1\u6761\u6b3e</a>\u4e4b\u8981\u6c42\u6ce8\u660e\u51fa\u5904\u3002\u6b64\u8981\u6c42\u6db5\u76d6\u6240\u6709\u5f62\u5f0f\u7684\u5171\u4eab\uff0c\u5305\u62ec\u6570\u5b57\u7248\u3001\u7eb8\u8d28\u5370\u5237\u54c1\u6216\u6444\u5f71\u5a92\u4ecb\uff0c\u4ee5\u53ca\u6839\u636e\u4ece GFW Pro \u83b7\u53d6\u7684\u5185\u5bb9\u800c\u521b\u4f5c\u7684\u884d\u751f\u4f5c\u54c1\u6216\u6539\u7f16\u4f5c\u54c1\u3002\u6b64\u5916\uff0c\u5bf9\u4e8e\u5728\u5730\u56fe\u6216\u5b9a\u91cf\u8f93\u51fa\u4e2d\u4f7f\u7528\u7684\u7b2c\u4e09\u65b9\u4ea7\u54c1\uff0c\u5fc5\u987b\u6ce8\u660e\u5177\u4f53\u51fa\u5904\u3002&nbsp;", "03ce0a78fd648ddbdd3a2fbd65f0ba26": "\u5728\u6807\u6ce8\u51fa\u5904\u65f6\uff0c\u8bf7\u4f7f\u7528\u4ee5\u4e0b GFW Pro \u5f15\u7528\u683c\u5f0f\uff0c\u5e76\u5728\u5355\u72ec\u4e00\u884c\u4e2d\u9644\u4e0a\u4ee5\u4e0b\u6570\u636e\u96c6\u7684\u76f8\u5173\u5f15\u7528\uff08\u5f53\u51fa\u73b0\u5728\u8f93\u51fa\u5185\u5bb9\u4e2d\u6216\u88ab\u7eb3\u5165\u884d\u751f\u4f5c\u54c1\u4e2d\u4ee5\u4e0e\u5176\u4ed6\u65b9\u5171\u4eab\u65f6\uff0c\u8fd9\u4e9b\u6570\u636e\u96c6\u9700\u8981\u660e\u786e\u7f72\u540d\uff09\u3002&nbsp;", "adcd22bc01a78276c5138ff5cc72608a": "\u6709\u9650\u7684\u4f8b\u5916\u60c5\u5f62\u5305\u62ec\uff1a&nbsp;", "d9c8c82969a2b814fab5b9fa45c4ee89": "\u67e5\u770b\u5f53\u524d\u706b\u707e\u8b66\u62a5\u8d8b\u52bf\u662f\u6b63\u5e38\u3001\u504f\u9ad8\u8fd8\u662f\u504f\u4f4e", "d19d7920886bc4a438027fceb2e7119a": "\u4f7f\u7528Forest Watcher\u79fb\u52a8\u5e94\u7528\u5728\u91ce\u5916\u79bb\u7ebf\u5bfc\u822a\u5e76\u62a5\u544a\u706b\u707e\u8b66\u62a5\u3002", "68cec5416ab0c42281bf966f0341520b": "\u6700\u540e\uff0c\u7528\u6237\u53ef\u4ee5\u66f4\u6539\u8fd9\u4e2a\u5c0f\u90e8\u4ef6\u7684\u5ea6\u91cf\u5355\u4f4d\uff0c\u4ece\u800c\u80fd\u591f\u67e5\u770b\u6240\u9009\u65f6\u95f4\u95f4\u9694\u5185\u7684\u706b\u707e\u8b66\u62a5\u5bc6\u5ea6\u3001\u4e25\u91cd\u7a0b\u5ea6\u548c\u8b66\u62a5\u603b\u6570\u3002", "124d990d384e881b98256723ce86bd28": "\u5f02\u5e38\u9ad8", "87d74b9ef2445942aa20bc3510e98334": "\u63a2\u7d22\u68ee\u6797\u5730\u56fe\u96c6", "2c9eea2cf4fcc3cfb6dd006b5eb7f810": "\u524d\u5f80\u5e94\u7528", "6ac6d30635564599645f6012109115de": "\u6700\u8fd1{timeframe}\u5728{location}\uff0c\u6709\u6700\u591a{significant}\u706b\u707e\u8b66\u62a5\u6570\u91cf\u7684\u5730\u533a\u662f{topRegion}\uff0c\u5171\u6709{topRegionCount}\u6b21\u706b\u707e\u8b66\u62a5\u3002\u8fd9\u5360{location}\u4fa6\u6d4b\u5230\u7684\u6240\u6709\u8b66\u62a5\u7684{topRegionPerc}\uff0c\u76f8\u6bd4<b>2012</b>\u540c\u671f\u706b\u707e\u6570\u91cf\u504f{status}\u3002", "c53df31e20ec8b1f3656fd090f271c0f": "\u4e25\u91cd", "d344daa4fff1136ba20806e244269411": "\u6211\u4eec\u5c06\u706b\u707e\u9ad8\u5cf0\u5b63\u8282\u7684\u5f00\u59cb\u5b9a\u4e49\u4e3a\u5e73\u5747\u8b66\u62a5\u8ba1\u6570\u8d85\u8fc7\u5386\u53f2\u6570\u636e\u5e73\u5747\u9ad8\u8b66\u62a5\u8ba1\u6570\u7684\u4e00\u534a\u7684\u7b2c\u4e00\u5468", "a5450ec0c99f0b5c1282dcc1c2f91003": "*\u5730\u56fe\u4e0a\u53ef\u663e\u793a\u6700\u591a3\u4e2a\u6708\u7684\u706b\u707e\u6570\u636e", "3d21d5b421884c90cc2a5696195f0747": "\u6c14\u5019\u53d8\u5316\u3001\u68ee\u6797\u9000\u5316\u548c\u788e\u7247\u5316\u5bfc\u81f4\u5168\u7403\u8303\u56f4\u5185\u66f4\u5bb9\u6613\u53d1\u751f\u706b\u707e\u3002\u968f\u7740\u6c14\u5019\u8d8a\u6765\u8d8a\u70ed\u8d8a\u6765\u8d8a\u5e72\u71e5\uff0c\u706b\u707e\u2014\u2014\u65e0\u8bba\u662f\u7531\u4eba\u7c7b\u5f15\u8d77\u7684\u8fd8\u662f\u7531\u95ea\u7535\u5f15\u8d77\u7684\u2014\u2014\u66f4\u6709\u53ef\u80fd\u5728\u66f4\u5927\u7684\u533a\u57df\u4ee5\u66f4\u9ad8\u7684\u6e29\u5ea6\u71c3\u70e7\u3002\u68ee\u6797\u56e0\u4f10\u6728\u548c\u75be\u75c5\u800c\u9000\u5316\uff0c\u56e0\u780d\u4f10\u800c\u652f\u79bb\u7834\u788e\uff0c\u8fd9\u6837\u7684\u68ee\u6797\u4e5f\u66f4\u5bb9\u6613\u53d7\u5230\u706b\u707e\u7684\u5f71\u54cd\u3002", "db782064aff56316f7ce1245eb9eddd7": "+ \u589e\u52a0\u6bd4\u8f83\u5e74\u4efd", "9c3a49e9f3f9a150125beea809f58b75": "GFW\u5bf9\u706b\u707e\u7684\u6700\u65b0\u7814\u7a76\u548c\u89c1\u89e3", "62c00e3a61835b8164ec4d2772a3a2e2": "\u63a2\u7d22\u4e0e\u91cd\u8981\u68ee\u6797\u4e3b\u9898\u3001Places to Watch\uff08\u5728\u65b0\u8fd1\u68ee\u6797\u635f\u5931\u4e0a\u9700\u91cd\u70b9\u5173\u6ce8\u7684\u5730\u533a\uff09\u548c\u68ee\u6797\u6545\u4e8b\u6709\u5173\u7684\u6570\u636e\u3002", "8f05600136fd6568ec81a64d79225e4d": "\u63a2\u7d22\u5730\u56fe", "5f5a5db2cc5ad5afb6601bfde9c7b3d6": "\u8bf7\u6d4f\u89c8\u8fd9\u4e9b\u5e38\u89c1\u95ee\u9898\u89e3\u7b54\uff0c\u4ee5\u8fdb\u4e00\u6b65\u4e86\u89e3 GFW Pro \u8d39\u7528\u6a21\u5f0f\u4ee5\u53ca\u54ea\u4e9b\u60c5\u51b5\u6536\u8d39\u3001\u54ea\u4e9b\u60c5\u51b5\u4e0d\u6536\u8d39\u3002\u5e38\u89c1\u95ee\u9898\u89e3\u7b54\u65e8\u5728\u63d0\u4f9b\u89e3\u91ca\u548c\u9488\u5bf9\u5177\u4f53\u60c5\u51b5\u7684\u6307\u5357\uff0c\u4f46\u5982\u679c\u6709\u4e0d\u4e00\u81f4\u7684\u5730\u65b9\uff0c\u4ee5\u73b0\u884c GFW Pro <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8bb8\u53ef\u534f\u8bae</a>\u548c<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\" class=\"\">\u4ef7\u683c\u8868</a>\u4e3a\u51c6\u3002&nbsp;", "6abcb8e2bed6f08fac6c51926978bb2a": "\u60a8\u7684\u95ee\u9898\u6ca1\u6709\u5728\u8fd9\u91cc\u63d0\u5230\uff1f&nbsp;", "a6418ce868c21e4e7f38a129c760155b": "\u8bf7\u901a\u8fc7\u4e0b\u5217\u7535\u5b50\u90ae\u7bb1\u5411\u4e1a\u52a1\u56e2\u961f\u63d0\u51fa\u60a8\u7684\u95ee\u9898\uff1a<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">GFWPROsales@wri.org</a>\u3002&nbsp;", "b864ef345ad5fea7de4bb5a7858f3d7a": "Pro \u6570\u636e\u96c6\u5e93", "c3d054aa63dce5a6b76be94fbc343663": "\u79c1\u8425\u90e8\u95e8", "0025a6d8cb2204ede2f82fff4581a5ca": "2017\u5e74\uff0cWRI\u63d0\u8bae\u5c06GFW Commodities\u548cFinance\u529f\u80fd\u6574\u5408\u5230GFW Pro\u4e2d\uff0c\u8be5\u5e73\u53f0\u4e13\u4e3a\u5728\u519c\u4e1a\u4f9b\u5e94\u94fe\u4e2d\u8fd0\u8425\u7684\u516c\u53f8\u6253\u9020\uff0c\u4e3a\u5176\u63d0\u4f9b\u5185\u90e8\u7ba1\u7406\u548c\u51b3\u7b56\u652f\u6301\u7cfb\u7edf\u3002GFW Pro\u627f\u8bfa\u901a\u8fc7\u5b89\u5168\u3001\u53ef\u5b9a\u5236\u7684\u5de5\u4f5c\u6d41\u7a0b\u5e94\u7528\u7a0b\u5e8f\uff0c\u5c31\u4e0e\u571f\u5730\u76f8\u5173\u7684\u53ef\u6301\u7eed\u6027\u7ee9\u6548\u63d0\u4f9b\u9002\u7528\u4e8e\u4e1a\u52a1\u7684\u89c1\u89e3\uff0c\u4ece\u65e0\u6bc1\u6797\u5408\u89c4\u6027\u5206\u6790\u5f00\u59cb\uff0c\u4f46\u4e0d\u9650\u4e8e\u6b64\u3002&nbsp;", "9fd00dae267994cf34ac273c6348673b": "\u7f51\u8def\u7814\u8ba8\u4f1a", "fa9bdc8a1d6101be84925d68641db469": "\u8d44\u52a9\u91d1\u548c\u7814\u7a76\u57fa\u91d1", "ab593a683419b0234188673ccae3bb5a": "\u516c\u6c11\u793e\u4f1a", "114bd5b70f36ae253c4aad6a51ee1fb1": "\u6570\u636e\u548c\u7814\u7a76", "a65211dd62cc9b04cfb1d4ffaed51cbf": "\u7ba1\u7406 Forest Watcher Web \u62a5\u544a\u4e2d\u7684\u5a92\u4f53\u8bbf\u95ee\u6743\u9650", "375a8868124b56f39224a22bcd620777": "\u73b0\u5728\uff0c\u60a8\u53ef\u4ee5\u5728 Forest Watcher \u62a5\u544a\u4e2d\u8f7b\u677e\u8c03\u6574\u5bf9\u5f55\u97f3\u548c\u56fe\u50cf\u7684\u8bbf\u95ee\u6743\u9650\u3002\u5173\u4e8e\u6267\u884c\u6b64\u64cd\u4f5c\u7684\u8be6\u7ec6\u5206\u6b65\u6307\u5357\uff0c\u8bf7\u53c2\u9605\u6211\u4eec\u7684<a href=\"{{0}}\">\u65b0\u7248\u6559\u7a0b</a>\u3002", "723d5e8a39e83f7759abb8b2835497c7": "158 \u4e2a\u56fd\u5bb6/\u5730\u533a", "6606874445fbe444e2e7d03732363ac7": "\u8bc6\u522b\u8fd1\u4e4e\u5168\u7403\u8303\u56f4\u5185\u7684\u4eba\u5de5\u6797\u548c\u7ecf\u6d4e\u6797\u6728\u3002", "64de0ce82e227f5f866a51b93fa86806": "\u6728\u7ea4\u7ef4\u6216\u6728\u6750", "83b596721e0f24af22516166b5ced1e7": "2025\u5e74SGF\u7533\u8bf7\u4eba\u7f51\u7edc\u7814\u8ba8\u4f1a", "9180f298a424ba3f4fd5f918cdd68293": "\u6211\u4eec\u6700\u8fd1\u5c06GFW\u4e0a\u7684\u653f\u6cbb\u8fb9\u754c\u66f4\u65b0\u6210\u4e86\u6765\u81ea<a href=\"{{0}}\">GADM</a>\uff08\u5f00\u6e90\u653f\u6cbb\u8fb9\u754c\u6570\u636e\u96c6\uff09\u7684\u6700\u65b0\u7248\u672c\uff0c\u4ee5\u786e\u4fddGFW\u4e0a\u7684\u5730\u56fe\u3001\u7edf\u8ba1\u6570\u636e\u548c\u5206\u6790\u4f7f\u7528\u7684\u662f\u6700\u65b0\u3001\u6700\u51c6\u786e\u7684\u4fe1\u606f\u3002\u7ecf\u8fc7\u672c\u6b21\u66f4\u65b0\uff0c\u60a8\u53ef\u80fd\u4f1a\u6ce8\u610f\u5230\u56fd\u5bb6\u3001\u5730\u533a\u548c\u6b21\u533a\u57df\u7684\u8fb9\u754c\u53d1\u751f\u67d0\u4e9b\u53d8\u5316\u3002\u6211\u4eec\u5728<a href=\"{{1}}\">\u6700\u65b0\u535a\u5ba2</a>\u4e2d\u4ecb\u7ecd\u4e86\u6bcf\u9879\u53d8\u5316\u3002", "b34065768f406d089e342609a7b0a177": "\u5c0f\u989d\u8d44\u52a9\u57fa\u91d1\uff08Small Grants Fund\uff09\u73b0\u5df2\u5f00\u653e\u7533\u8bf7\u2014\u2014\u8be5\u57fa\u91d1\u65e8\u5728\u5efa\u8bbe\u6c11\u95f4\u793e\u4f1a\u7ec4\u7ec7\u4f7f\u7528GFW\u5de5\u5177\u548c\u6570\u636e\u4fdd\u62a4\u548c\u53ef\u6301\u7eed\u7ba1\u7406\u68ee\u6797\u7684\u80fd\u529b\u3002\u5982\u9700\u5728\u7533\u8bf7\u524d\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\uff0c\u6b22\u8fce\u53c2\u52a0\u6211\u4eec\u4e8e\u7f8e\u56fd\u4e1c\u90e8\u65f6\u95f44\u670829\u65e5\u4e0a\u53489:00\u4e3e\u529e\u76842025\u5e74SGF\u7533\u8bf7\u4eba\u7f51\u7edc\u7814\u8ba8\u4f1a\u3002\u4f1a\u8bae\u5c06\u63d0\u4f9b\u6cd5\u8bed\u548c\u897f\u73ed\u7259\u8bed\u5b9e\u65f6\u7ffb\u8bd1\u670d\u52a1\u3002<a href=\"{{0}}\" rel=\"noopener\" target=\"_blank\">\u5728\u6b64\u5904\u6ce8\u518c</a> | <a href=\"{{1}}\" rel=\"noopener\" target=\"_blank\">S\u2019inscrire ici</a> | <a href=\"{{2}}\" rel=\"noopener\" target=\"_blank\">Inscr\u00edbase aqu\u00ed</a>", "da2402bfd2c846fce0e90f6b968a8c89": "GFW\u5df2\u66f4\u65b0\u653f\u6cbb\u8fb9\u754c", "e9bd9b0710356e4342cf99b429bb7c5f": "\u82e5\u60f3\u8fdb\u4e00\u6b65\u8c03\u67e5\u548c\u6838\u5b9e\uff0c\u60a8\u53ef\u4ee5\u6fc0\u6d3b\u690d\u88ab\u5065\u5eb7\u56fe\u50cf\u3002\u56fe\u4e2d\uff0c\u8b66\u62a5\u53e0\u52a0\u5728\u7eff\u8272\u7684\u6591\u5757\u4e0a\uff0c\u4ee3\u8868\u88f8\u9732\u7684\u5730\u9762\u2014\u2014\u60a8\u73b0\u5728\u53ef\u4ee5\u6838\u5b9e\u8fd9\u4e2a\u533a\u57df\u662f\u5426\u53d8\u6210\u4e86\u7a7a\u5730\u3002", "071bcc8ee99663ab6f3d7676a86514dc": "\u5c06\u4e24\u6839\u624b\u6307\u7f6e\u4e8e\u5730\u56fe\u4e0a\uff0c\u5f20\u5f00\u624b\u6307\uff0c\u5373\u53ef\u653e\u5927\u60a8\u60f3\u76d1\u63a7\u7684\u533a\u57df\u3002\u60a8\u4e5f\u53ef\u4ee5\u5728\u5c4f\u5e55\u4e0a\u62d6\u52a8\u624b\u6307\uff0c\u79fb\u52a8\u5730\u56fe\u3002", "ad679534885e57a9299661bdf1b32cfc": "<a href=\"{{0}}\" target=\"_blank\" aria-label=\"undefined (opens in a new tab)\" rel=\"noreferrer noopener\">Forest Watcher</a>\u7f51\u7edc\u7248\u63d0\u4f9b\u53ef\u7f16\u8f91\u7684\u62a5\u544a\u6a21\u677f\uff0c\u8ba9\u81ea\u5b9a\u4e49\u6709\u4e86\u66f4\u591a\u53ef\u80fd\u3002\u521b\u5efa\u3001\u5ba1\u6838\u3001\u7ed9\u56e2\u961f\u6210\u5458\u5206\u6d3e\u62a5\u544a\u7b49\u529f\u80fd\u4e5f\u80fd\u6709\u6548\u4fc3\u8fdb\u56e2\u961f\u534f\u4f5c\u3002", "c06a0125385e13865ccf7a7e8a1a2ebc": "Forest Watcher\u7f51\u7edc\u7248\u662fForest Watcher\u79fb\u52a8\u5e94\u7528\u7684\u5728\u7ebf\u7f51\u7edc\u5e94\u7528\uff0c\u5177\u6709\u8865\u5145\u4f5c\u7528\u3002Forest Watcher\u7f51\u7edc\u7248\u53ef\u7528\u4e8e\u7ba1\u7406\u60a8\u5173\u6ce8\u7684\u533a\u57df\uff0c\u81ea\u5b9a\u4e49\u62a5\u544a\u6a21\u677f\uff0c\u914d\u7f6e\u7528\u6237\u56e2\u961f\uff0c\u5e76\u67e5\u770b\u548c\u4e0b\u8f7d\u901a\u8fc7\u79fb\u52a8\u5e94\u7528\u63d0\u4ea4\u7684\u62a5\u544a\u3002", "a3311709d56e6ec41261fd627533df71": "\u4ece\u6570\u636e\u5305\u4e2d\u5bfc\u5165\u6240\u6709\u6570\u636e\u6216\u7279\u5b9a\u9879\u76ee\u3002", "efae090ec5334b10bb0c1a080c77444a": "\u4e0e\u6811\u6728\u8986\u76d6\u7387\u548c\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u5bf9\u5e94\u7684\u9ed8\u8ba4\u6811\u51a0\u8986\u76d6\u5bc6\u5ea6\u4e3a&gt;30%\u3002", "d97ea0255944fd85fb3431079e6913b7": "\u4e00\u65e6\u60a8\u9009\u62e9\u4e86\u67d0\u4e2a\u533a\u57df\uff0c\u5c31\u53ef\u4ee5\u5728\u201c\u6982\u8ff0\u201d\u4e0b\u65b9\u67e5\u770b\u8be5\u533a\u57df\u7684\u68ee\u6797\u7edf\u8ba1\u6982\u8ff0\uff1b\u60a8\u4e5f\u53ef\u4ee5\u9009\u62e9\u67d0\u4e2a\u7c7b\u522b\uff0c\u67e5\u770b\u571f\u5730\u8986\u76d6\u3001\u68ee\u6797\u53d8\u5316\u3001\u571f\u5730\u5229\u7528\u3001\u706b\u707e\u6216\u6c14\u5019\u65b9\u9762\u7684\u5176\u4ed6\u7edf\u8ba1\u6570\u636e\u3002\u5e76\u975e\u6bcf\u4e2a\u533a\u57df\u90fd\u4f1a\u663e\u793a\u6240\u6709\u7c7b\u522b\u2014\u2014\u64cd\u4f5c\u9762\u677f\u9875\u9762\u53ea\u663e\u793a\u5305\u542b\u6240\u9009\u533a\u57df\u7684\u6570\u636e\u7684\u7c7b\u522b\u3002", "1eb8b1ea232a14ebf0aa1b78968ff65b": "\u901a\u8fc7\u7ed3\u5408GFW\u4e0a\u7684\u7a7a\u95f4\u6570\u636e\u548c\u60a8\u81ea\u5df1\u7684\u6570\u636e\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">MapBuilder</a>\u80fd\u5e2e\u60a8\u521b\u5efa\u4e00\u4e2a\u81ea\u5b9a\u4e49\u7684\u76d1\u6d4b\u5e94\u7528\u7a0b\u5e8f\u3002", "b939717de5837ea1411730164b9c158a": "\u62a5\u544a\u8868\u683c\u5c06\u88ab\u6fc0\u6d3b\u3002\u62cd\u6444\u6216\u9009\u62e9\u4e00\u5f20\u7167\u7247\uff0c\u9644\u5728\u62a5\u544a\u4e0a\u3002\u7167\u7247\u80fd\u4e3a\u8be5\u533a\u57df\u7684\u60c5\u51b5\u63d0\u4f9b\u89c6\u89c9\u8bc1\u636e\u3002\u5b8c\u6210\u540e\uff0c\u70b9\u51fb\u53f3\u4e0b\u89d2\u7684\u4e0b\u4e00\u6b65\u56fe\u6807\u3002", "9753cb9bd0292eca8a8933befb86e302": "\u6709\u5173MapBuilder\u7684\u5e38\u89c1\u95ee\u9898\uff0c\u8bf7\u8bbf\u95ee<a href=\"{{0}}\">\u8fd9\u91cc</a>\u3002", "bcf25c9edea273ed26152aae39aa809a": "\u8fdb\u4e00\u6b65\u653e\u5927\u533a\u57df\u8fd8\u80fd\u4f7f\u7a7a\u5730\u7684\u7279\u5f81\u66f4\u52a0\u6e05\u6670\uff0c\u6709\u52a9\u4e8e\u786e\u5b9a\u7a7a\u5730\u662f\u7531\u4eba\u4e3a\u539f\u56e0\u8fd8\u662f\u81ea\u7136\u539f\u56e0\u9020\u6210\u7684\uff0c\u4ee5\u53ca\u4fc3\u4f7f\u7a7a\u5730\u5f62\u6210\u7684\u56e0\u7d20\u6709\u54ea\u4e9b\uff08\u5982\u5c0f\u89c4\u6a21\u519c\u4e1a\u3001\u5546\u54c1\u519c\u4e1a\u3001\u91c7\u77ff\u3001\u4f10\u6728\u3001\u706b\u707e\u7b49\uff09\u3002", "71b259506d7ed11f74040bfd2b9fc76f": "\u7b80\u800c\u8a00\u4e4b\uff0c\u6700\u65b0\u536b\u661f\u56fe\u50cf\u5de5\u5177\u7684\u529f\u80fd\u5f3a\u5927\uff0c\u60a8\u53ef\u4ee5\u5728\u8fdb\u884c\u5b9e\u5730\u8003\u5bdf\u524d\u7528\u5b83\u76d1\u6d4b\u3001\u6838\u5b9e\u548c\u8c03\u67e5\u60a8\u5173\u6ce8\u7684\u533a\u57df\u3002\u5728\u5b9e\u5730\u8003\u5bdf\u524d\u786e\u5b9a\u6811\u6728\u8986\u76d6\u7387\u662f\u5426\u4e0b\u964d\uff0c\u53ef\u4ee5\u8282\u7701\u65f6\u95f4\u3001\u91d1\u94b1\u548c\u5176\u4ed6\u8d44\u6e90\uff0c\u8fd9\u6837\u60a8\u5c31\u80fd\u628a\u7cbe\u529b\u96c6\u4e2d\u5728\u68ee\u6797\u771f\u6b63\u9762\u4e34\u5a01\u80c1\u7684\u5730\u65b9\u3002\u6b64\u5916\uff0c\u60a8\u8fd8\u53ef\u4ee5\u628a\u5b83\u7528\u5728\u62a5\u544a\u3001\u653f\u7b56\u7b80\u62a5\u3001\u6f14\u8bb2\u548c\u5404\u4e2a\u5a92\u4f53\u4e2d\uff0c\u5c55\u793a\u53ef\u80fd\u53d1\u751f\u6bc1\u6797\u7684\u5730\u533a\u548c\u53ef\u80fd\u5bfc\u81f4\u6bc1\u6797\u7684\u539f\u56e0\u3002", "6ed93a9108eeb92c3cecf4024475e7f1": "\u6536\u4ef6\u4eba\u4f1a\u6536\u5230\u5bfc\u5165\u5e94\u7528\u7a0b\u5e8f\u5305\u7684\u63d0\u793a\uff0c\u9009\u62e9\u5bfc\u5165\u6240\u6709\u6570\u636e\u6216\u7279\u5b9a\u9879\u76ee\u3002\u518d\u6b21\u6536\u5230\u63d0\u793a\u65f6\uff0c\u70b9\u51fb\u9875\u9762\u5e95\u90e8\u7684\u201c\u5bfc\u5165\u6570\u636e\u5305\u201d\uff0c\u786e\u8ba4\u5bfc\u5165\u3002", "bc3e562dab17c4a0d1262ebd22c072aa": "\u70b9\u51fb\u201c\u5e95\u56fe\u201d\uff0c\u81ea\u5b9a\u4e49\u5e95\u56fe\u3002", "2c07431e2986379a8b47620b8e394ec3": "\u4fdd\u5b58\u533a\u57df\u540e\uff0c\u60a8\u5c06\u8fdb\u5165\u533a\u57df\u9875\u9762\u3002\u70b9\u51fb\u533a\u57df\u56fe\u7247\u4e0a\u7684\u4e0b\u8f7d\u56fe\u6807\uff0c\u4e0b\u8f7d\u60a8\u611f\u5174\u8da3\u7684\u533a\u57df\uff0c\u4f9b\u79bb\u7ebf\u65f6\u4f7f\u7528\u3002\u8fd9\u6837\u5373\u4f7f\u4e0d\u4e0a\u7f51\u4e5f\u80fd\u8bbf\u95ee\u5e94\u7528\u7a0b\u5e8f\u4e0a\u7684\u533a\u57df\u3002\u4e0b\u8f7d\u5b8c\u6210\u540e\uff0c\u5411\u4e0b\u7bad\u5934\u5c06\u53d8\u4e3a\u52fe\u53f7\u3002", "48c844fe60db5928f5dff7e41299aa7a": "\u5c06\u9f20\u6807\u60ac\u505c\u5728\u60a8\u611f\u5174\u8da3\u7684\u6570\u636e\u56fe\u8868\u7684\u67d0\u4e2a\u90e8\u5206\u3002\u8fd9\u65f6\u4f1a\u51fa\u73b0\u4e00\u4e2a\u4fe1\u606f\u6846\uff0c\u663e\u793a\u8be5\u6570\u636e\u70b9\u7684\u66f4\u591a\u4fe1\u606f\u3002", "194b817e0c700fb8683a50344e5128a8": "<strong>\u5730\u56fe\u6837\u5f0f</strong>\uff1a\u4e3a\u4e86\u63d0\u9ad8\u68ee\u6797\u76d1\u6d4b\u80fd\u529b\uff0cGFW\u63d0\u4f9b\u51e0\u79cd\u4e0d\u540c\u7684\u5e95\u56fe\u56fe\u50cf\uff0c\u5305\u62ec\uff1a\u9ed8\u8ba4\u3001Dark Matter\u3001Google Satellite\u548cLandsat\u3002\u66f4\u591a\u4fe1\u606f\u8bf7\u53c2\u89c1\u4e0b\u9762\u7684\u201c\u53ef\u7528\u5e95\u56fe\u201d\u4e00\u8282\u3002", "da885aa27c4b48964a77a0e09488124a": "\u753b\u597d\u5f62\u72b6\u540e\uff0c\u5728\u53f3\u4e0b\u89d2\u7684\u6587\u672c\u6846\u4e2d\u4e3a\u8be5\u533a\u57df\u53d6\u540d\uff0c\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u3002", "4e31d288bec26a14a0cd6e4cd35a8eb9": "\u641c\u7d22\u201c\u5b8c\u6574\u68ee\u6797\u666f\u89c2\u201d\u6765\u586b\u5145\u4e0e\u641c\u7d22\u76f8\u5173\u7684\u6570\u636e\u7ed3\u679c\u3002", "fa22f17512fee24a03c158efab10dcc3": "\u60a8\u4e5f\u53ef\u4ee5\u5728\u6b64\u89c6\u56fe\u4e2d\u7f16\u8f91\u60a8\u5173\u6ce8\u7684\u533a\u57df\u3002\u70b9\u51fb\u60f3\u7f16\u8f91\u7684\u533a\u57df\uff0c\u5728\u8be5\u533a\u57df\u540d\u79f0\u53f3\u8fb9\u4f1a\u51fa\u73b0\u4e00\u4e2a\u94c5\u7b14\u56fe\u6807\u3002\u70b9\u51fb\u94c5\u7b14\u56fe\u6807\uff0c\u6fc0\u6d3b\u5730\u56fe\u4e0a\u7684\u201c\u7f16\u8f91\u5173\u6ce8\u533a\u57df\u201d\u8868\u683c\u3002\u5728\u8be5\u8868\u683c\u4e2d\uff0c\u60a8\u53ef\u4ee5\u91cd\u65b0\u547d\u540d\u533a\u57df\uff0c\u6307\u5b9a\u6807\u7b7e\uff0c\u66f4\u65b0\u63a5\u6536\u8b66\u62a5\u901a\u77e5\u7684\u90ae\u7bb1\u5730\u5740\uff0c\u66f4\u6539\u8bed\u8a00\uff0c\u9009\u62e9\u60a8\u60f3\u63a5\u6536\u7684\u8b66\u62a5\u901a\u77e5\u7c7b\u578b\u3002\u60a8\u8fd8\u53ef\u4ee5\u5220\u9664\u4e0d\u518d\u9700\u8981\u7684\u533a\u57df\u3002", "8558742e8de838586cd979065d8e0321": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Amaz\u00f3nicos por la Amazon\u00eda (AMPA)</a>\u57282020\u5e749\u6708\u5236\u4f5c\u4e86Forest Watcher\u7f51\u7edc\u7248\u7684\u89c6\u9891\u6559\u7a0b\uff0c\u6f14\u793aForest Watcher\u7f51\u7edc\u7248\u7684\u4f7f\u7528\u65b9\u6cd5\u3002\u89c6\u9891\u8bed\u8a00\u4e3a\u897f\u73ed\u7259\u8bed\u3002", "ce5ed399cc823355755a25b7929fb62a": "\u80cc\u666f\u6570\u636e\u5c42\u73b0\u5728\u5217\u4e8e\u201c\u81ea\u5b9a\u4e49\u6570\u636e\u5c42\u201d\u4e0b\u3002", "531925ae9b387489b487f9d6fcfaf13b": "<strong>\u6a21\u677f</strong>\uff1a\u81ea\u5b9a\u4e49\u65b0\u7684\u62a5\u544a\u6a21\u677f\uff0c\u5728\u6a21\u677f\u9875\u9762\u4e0a\u8bbf\u95ee\u7528\u5df2\u4fdd\u5b58\u7684\u6a21\u677f\u521b\u5efa\u7684\u62a5\u544a\u3002\u56e2\u961f\u6210\u5458\u5728\u5b9e\u5730\u8003\u5bdf\u65f6\u7528\u62a5\u544a\u6a21\u677f\u8bb0\u5f55\u53d1\u73b0\u3002", "9da3f6fc1aa27b7e6c98f36768ca7de0": "\u63a5\u4e0b\u6765\u7cfb\u7edf\u4f1a\u63d0\u793a\u60a8\u9009\u62e9\u5e95\u56fe\u7c7b\u578b\u3002\u70b9\u51fb\u201c\u81ea\u5b9a\u4e49\u5e95\u56fe\u201d\uff0c\u9009\u62e9\u60a8\u60f3\u4e0a\u4f20\u7684\u81ea\u5b9a\u4e49\u5e95\u56fe\u6587\u4ef6\u3002Forest Watcher\u4ec5\u652f\u6301\u6587\u4ef6\u7c7b\u578b\u4e3a.mbtiles\u7684\u81ea\u5b9a\u4e49\u5e95\u56fe\u3002", "7736dd6d5530bbc29855ff26610367b0": "\u6d4f\u89c8\u6709\u5173MapBuilder\u7684\u5e38\u89c1\u95ee\u9898\uff0c\u8fdb\u4e00\u6b65\u4e86\u89e3\u5982\u4f55\u521b\u5efa\u81ea\u5b9a\u4e49\u76d1\u63a7\u5e94\u7528\u7a0b\u5e8f\u3002", "f3e49ccc482040048a0356126c835107": "\u8fd4\u56de\u5730\u56fe\u8bbe\u7f6e\uff0c\u70b9\u51fb\u5706\u5708\uff0c\u6fc0\u6d3b\u60a8\u9700\u8981\u7684\u6570\u636e\u5c42\u3002", "b857f8a155e9964e69c1dca5c23fd8bf": "\u70b9\u51fb\u201c\u8bbf\u95ee\u533a\u57df\u64cd\u4f5c\u9762\u677f\u201d\u5373\u53ef\u67e5\u770b\u5df2\u4fdd\u5b58\u7684\u81ea\u5b9a\u4e49\u533a\u57df\u7684\u64cd\u4f5c\u9762\u677f\u3002", "77f0f0e00cb17adb6b726a9f7f33446c": "\u6fc0\u6d3b\u60a8\u60f3\u8c03\u67e5\u7684\u533a\u57df\u7684\u8fd1\u671f\u536b\u661f\u56fe\u50cf\u3002\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u548c\u536b\u661f\u56fe\u901a\u8fc7\u8b66\u62a5\u4e0b\u65b9\u7684\u68d5\u8272\u7a7a\u5730\u5c55\u793a\u690d\u88ab\u4e27\u5931\u7684\u60c5\u51b5\u3002", "2228c0dbfcfcdec999a0d738424663cf": "\u767b\u5f55\u540e\uff0c\u60a8\u4fdd\u5b58\u7684\u6240\u6709\u533a\u57df\u90fd\u4f1a\u5728\u7f51\u9875\u4e0a\u5217\u51fa\u3002\u60a8\u53ef\u4ee5\u7f16\u8f91\u548c\u5206\u4eab\u8fd9\u4e9b\u533a\u57df\uff0c\u4e5f\u53ef\u4ee5\u70b9\u51fb\u201c\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u201d\uff0c\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u67d0\u4e2a\u533a\u57df\u6700\u8fd1\u4e00\u5468\u7684GLAD\u6bc1\u6797\u8b66\u62a5\u548cVIIRS\u706b\u707e\u8b66\u62a5\uff0c\u8fd8\u53ef\u4ee5\u67e5\u770b\u60a8\u662f\u5426\u8ba2\u9605\u4e86\u7279\u5b9a\u533a\u57df\u7684\u8b66\u62a5\u3002<a href=\"{{0}}\">\u70b9\u6b64</a>\u4e86\u89e3\u5982\u4f55\u7ba1\u7406\u5df2\u4fdd\u5b58\u7684\u533a\u57df\u3002", "10573b873d2fa5a365d558a45e328e47": "\u8bf7\u6c42", "3973fcb86f05573f334e479bde01a618": " \u4e3a\u60a8\u7684\u62a5\u544a\u6a21\u677f\u547d\u540d", "848cdb094cc5526e97423caebd766214": "\u70b9\u51fb\u201c\u5171\u4eab\u6240\u6709\u5e94\u7528\u7a0b\u5e8f\u6570\u636e\u3002\u201d", "89f4dd27817e1cd30603ea5bee96dab0": "\u70b9\u51fb\u201c\u6dfb\u52a0Global Forest Watch\u6570\u636e\u5c42\u3002\u201d", "24159138db8b23204e8ffb7813873896": "\u5728\u5730\u56fe\u4e0a\uff0c\u60a8\u53ef\u4ee5\u6d4f\u89c8\u5206\u6790\u51e0\u5341\u4e2a\u7a7a\u95f4\u6570\u636e\u5c42\u3002\u4ee5\u4e0b\u8fd9\u4e9b\u5173\u952e\u529f\u80fd\u5c06\u5e2e\u52a9\u60a8\u5229\u7528\u5730\u56fe\u6570\u636e\u53bb\u63a2\u7d22\u3001\u521b\u5efa\u548c\u5206\u4eab\u81ea\u5b9a\u4e49\u5730\u56fe\u56fe\u50cf\u3002", "e49817ae54011f09a5db0415a3cc3ddc": "\u9009\u62e9\u201c\u690d\u88ab\u5065\u5eb7\u201d\uff0c\u67e5\u770bNDVI\u56fe\u50cf\u3002\u7ea2/\u6a59\u8272\u4ee3\u8868\u690d\u88ab\u5065\u5eb7\uff0c\u7eff\u8272\u5219\u4ee3\u8868\u88f8\u9732\u7684\u5730\u9762\u3002\u9ed1/\u7d2b\u8272\u4ee3\u8868\u6c34\u4f53\u3002", "dbdbb807c44c87c39c80a87e29b71cae": "\u5e95\u56fe\u548c\u80cc\u666f\u6570\u636e\u5c42\u53ef\u5728\u8bbe\u7f6e\u9875\u9762\u8bbf\u95ee\u3002", "9d19d89d107813ea095be92dffec8e3b": "\u70b9\u51fb\u9f7f\u8f6e\u8bbe\u7f6e\u56fe\u6807\uff0c\u5373\u53ef\u81ea\u5b9a\u4e49\u6570\u636e\u56fe\u8868\u4e0a\u663e\u793a\u7684\u6570\u636e\u3002", "10ef289667f7b3d62efc1449adb16fa7": "\u82e5\u60f3\u5728\u5730\u56fe\u4e0a\u6807\u51fa\u60a8\u611f\u5174\u8da3\u7684\u533a\u57df\uff0c\u53ef\u4ee5\u5148\u641c\u7d22\u67d0\u4e2a\u5730\u5740\u3001\u56fd\u5bb6\u6216\u5750\u6807\uff0c\u6216\u8005\u653e\u5927\u67d0\u4e2a\u533a\u57df\u3002\u60f3\u901a\u8fc7\u5730\u5740\u3001\u56fd\u5bb6\u6216\u5750\u6807\u641c\u7d22\uff0c\u8bf7\u70b9\u51fb\u5730\u56fe\u53f3\u4e0a\u65b9\u7684\u641c\u7d22\u56fe\u6807\u3002\u60f3\u653e\u5927\u67d0\u4e2a\u533a\u57df\uff0c\u8bf7\u5c06\u60f3\u653e\u5927\u7684\u533a\u57df\u7f6e\u4e8e\u5730\u56fe\u5f53\u4e2d\uff0c\u7136\u540e\u70b9\u51fb\u53f3\u4e0a\u65b9\u7684\u653e\u5927\u56fe\u6807\u201c+\u201d\u3002", "b12618273a2052d894aba513a744fddc": "\u9009\u62e9\u4e0b\u8f7d\u6570\u636e\u6216\u4ec5\u5728\u7ebf\u4e0a\u8bbf\u95ee\uff0c\u7136\u540e\u70b9\u51fb\u201c\u6dfb\u52a0\u6570\u636e\u5c42\u3002\u201d", "c7c7146cbe62021c0fa93b38f0124f20": "\u53d1\u9001\u8bf7\u6c42", "aa52cda2a024724c42403f15c7bcc162": "\u8c03\u6574\u5e94\u7528\u7a0b\u5e8f\u8bbe\u7f6e", "733b82ee3ef9ae9620dd0c0dfe26af88": "\u83b7\u53d6\u5e2e\u52a9", "e474b7e568d486f12a129ad5bab39e85": "\u586b\u5199\u201c\u4fdd\u5b58\u5173\u6ce8\u533a\u57df\u201d\u8868\u683c\uff0c\u6839\u636e\u60a8\u7684\u76d1\u6d4b\u9700\u6c42\u5b9a\u5236\u8be5\u533a\u57df\u7684\u5404\u9879\u6307\u6807\u3002", "a59df2191167fc2f6f6498628beaac53": "\u751f\u7269\u591a\u6837\u6027\u5b8c\u6574\u5ea6\u88ab\u6fc0\u6d3b\u65f6\uff0c\u201c\u751f\u7269\u591a\u6837\u6027\u201d\u4e0a\u65b9\u4f1a\u51fa\u73b0\u4e00\u4e2a\u7eff\u8272\u5706\u5708\uff0c\u8868\u793a\u6fc0\u6d3b\u4e86\u4e00\u4e2a\u751f\u7269\u591a\u6837\u6027\u6570\u636e\u5c42\u3002", "3bbec7b5ff07fde7676d2410e89f05e7": "\u76f8\u5173\u535a\u5ba2", "7fa561447bc3267372b817e44bf809e2": "\u70b9\u51fb\u60a8\u8981\u5206\u6790\u7684\u4fdd\u62a4\u533a\u6570\u636e\u5c42\uff0c\u7136\u540e\u70b9\u51fb\u201c\u5206\u6790\u201d\u3002\u5206\u6790\u8fc7\u7a0b\u5c06\u81ea\u52a8\u8fd0\u884c\uff0c\u5e76\u5728\u56fe\u4f8b/\u5206\u6790\u9762\u677f\u4e2d\u751f\u6210\u6570\u636e\u56fe\u8868\u3002\u82e5\u60f3\u83b7\u53d6\u66f4\u591a\u6570\u636e\u56fe\u8868\uff0c\u8bf7\u6fc0\u6d3b\u989d\u5916\u7684\u201c\u7814\u7a76\u201d\u6570\u636e\u5c42\u3002", "ce0e1dda515b2013658dd56f9c18cb6b": "\u70b9\u51fb\u201c\u80cc\u666f\u6570\u636e\u5c42\u201d\u6765\u81ea\u5b9a\u4e49\u80cc\u666f\u6570\u636e\u5c42\u3002", "12e0da03f974f6b09dc75d27fa816368": "<strong>\u8c03\u6574\u6811\u51a0\u5bc6\u5ea6</strong>\u3002\u6709\u4e9b\u6570\u636e\u5c42\uff0c\u6bd4\u5982\u6811\u6728\u8986\u76d6\u7387\u548c\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\uff0c\u53ef\u4ee5\u8c03\u6574\u7528\u6765\u5b9a\u4e49\u201c\u6811\u6728\u8986\u76d6\u7387\u201d\u7684\u6700\u5c0f\u6811\u51a0\u5bc6\u5ea6\u767e\u5206\u6bd4\u3002\u6839\u636e\u4e0d\u540c\u7528\u6237\u6216\u56fd\u5bb6\u5bf9\u201c\u68ee\u6797\u201d\u7684\u5b9a\u4e49\u6765\u8c03\u6574\u6811\u51a0\u5bc6\u5ea6\u5341\u5206\u5fc5\u8981\uff0c\u56e0\u4e3a\u5bf9\u4e8e\u6811\u51a0\u8986\u76d6\u7387\u8fbe\u5230\u591a\u5c11\u624d\u7b97\u662f\u4e00\u5ea7\u68ee\u6797\uff0c\u4e16\u754c\u5404\u56fd\u5e76\u672a\u8fbe\u6210\u5171\u8bc6\u3002", "5a3c4ff1f7b1ddbdad13c0667d9b0b18": "\u7528Facebook\u3001Twitter\u6216Google\u767b\u5f55\u3002\u82e5\u60f3\u540c\u6b65Forest Watcher\u7f51\u7edc\u7248\u548c\u79fb\u52a8\u5e94\u7528\uff0c\u8bf7\u7528\u540c\u4e00\u5e10\u6237\u767b\u5f55\u3002", "acc4e8bba2e42eb9ee93856ae6790999": "\u5728\u6570\u636e\u4f9b\u5e94\u65b9\u5141\u8bb8\u7684\u60c5\u51b5\u4e0b\uff0cGFW\u7684\u6570\u636e\u53ef\u4f9b\u4e0b\u8f7d\u3002\u60a8\u53ef\u4ee5\u4ece\u7f51\u7ad9\u5404\u5904\uff08\u64cd\u4f5c\u9762\u677f\u3001\u5730\u56fe\u3001\u5f00\u653e\u6570\u636e\u95e8\u6237\uff09\u8bbf\u95ee\u7a7a\u95f4\u6570\u636e\u5c42\u7684\u4e0b\u8f7d\u7248\u672c\u548c\u57fa\u4e8e\u6570\u636e\u7684\u7edf\u8ba1\u8d44\u6599\u3002", "d4a38ab8931777b885124754a3d837d6": "<strong>\u8fb9\u754c</strong>\u3002\u70b9\u51fb\u8fb9\u754c\u56fe\u6807\uff0c\u5373\u53ef\u8c03\u6574\u5730\u56fe\u7684\u8fb9\u754c\u89c6\u56fe\uff0c\u8bbe\u7f6e\u5206\u4e3a\u56db\u79cd\u3002\u9ed8\u8ba4\u60c5\u51b5\u4e0b\uff0c\u5730\u56fe\u4e0a\u586b\u5145\u7684\u662f\u56fd\u5bb6\u548c\u5730\u533a\u7684\u660e\u786e\u653f\u6cbb\u8fb9\u754c\u3002\u60a8\u53ef\u4ee5\u66f4\u6539\u5730\u56fe\u89c6\u56fe\uff0c\u9009\u62e9\u4e0d\u663e\u793a\u8fb9\u754c\u3001\u9646\u5730\u751f\u6001\u533a\u6216\u6cb3\u6d41\u6d41\u57df\u3002 ", "3f674285fc812b2449a94b4730b4d084": "\u70b9\u51fb\u641c\u7d22\u56fe\u6807\uff0c\u5728\u5730\u56fe\u4e0a\u641c\u7d22\u67d0\u4e2a\u533a\u57df\u3002", "4f53e8869627e6b055e47d4d64595a78": "\u5c06\u7f51\u7ad9\u8bed\u8a00\u6539\u4e3a\u82f1\u8bed\u3001\u897f\u73ed\u7259\u8bed\u3001\u6cd5\u8bed\u3001\u5370\u5c3c\u8bed\u6216\u8461\u8404\u7259\u8bed\u3002", "192519f764966b9dbcc98eb31fb70786": "\u4f7f\u7528\u9876\u90e8\u83dc\u5355\u6d4f\u89c8Forest Watcher\u7f51\u7edc\u7248\u3002", "f3b9a0b6fb6b8d5d1245e019d484746a": "\u8d26\u6237\u7ba1\u7406", "a8d8cb443faf3404f891fa2c6e14658e": "<strong>\u81ea\u5b9a\u4e49\u5e95\u56fe</strong>\u3002\u6539\u53d8\u5e95\u56fe\u540e\uff0c\u60a8\u5c31\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u5730\u56fe\u80cc\u666f\u4e0b\u67e5\u770b\u6570\u636e\u3002\u5e95\u56fe\u8fb9\u754c\u53ef\u4ee5\u81ea\u5b9a\u4e49\uff0c\u60a8\u8fd8\u53ef\u4ee5\u9009\u62e9\u662f\u5426\u663e\u793a\u6807\u7b7e\u548c\u9053\u8def\u3002<a href=\"{{0}}\">\u70b9\u6b64</a>\u8fdb\u4e00\u6b65\u4e86\u89e3\u5982\u4f55\u9009\u62e9\u548c\u81ea\u5b9a\u4e49\u5e95\u56fe\u3002", "12f03a79ba6a8c188f7c159c5b7b95e8": "\u67e5\u627e\u6709\u5173GFW\u5de5\u5177\u3001\u6570\u636e\u548c\u7a0b\u5e8f\u7684\u5e38\u89c1\u95ee\u9898\u3002", "96f039070bb74a5875f919c22200a9cb": "\u5728\u8bbe\u7f6e\u9875\u9762\u7684\u201c\u6211\u7684\u56e2\u961f\u201d\u9009\u9879\u5361\u4e0a\u8bbf\u95ee\u60a8\u7684\u56e2\u961f\u3002", "f8146ee866ec7e71a90e85890fde8e1d": "\u70b9\u51fb\u5de6\u4e0b\u89d2\u7684\u76f8\u673a\u56fe\u6807\uff0c\u62cd\u6444\u6216\u6dfb\u52a0\u7167\u7247\u3002", "6968ac28f6d62f0671f6b0e820e2893d": "Forest Watcher\u79fb\u52a8\u5e94\u7528\u80fd\u5e2e\u60a8\u5728\u79bb\u7ebf\u72b6\u6001\u4e0b\u5b9e\u5730\u76d1\u6d4b\u68ee\u6797\u3002\u60a8\u53ef\u4ee5\u5728Forest Watcher\u4e0b\u8f7d\u5173\u6ce8\u533a\u57df\u7684\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u8b66\u62a5\uff0c\u524d\u5f80\u67e5\u770b\u8b66\u62a5\uff0c\u5e76\u8bb0\u5f55\u4e0e\u8b66\u62a5\u539f\u56e0\u6709\u5173\u7684\u8bc1\u636e\u3002", "cf9480823cd1aac38b87da1f0b2d51f2": "\u964d\u4f4e\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u7684\u4e0d\u900f\u660e\u5ea6\uff0c\u4ece\u800c\u63ed\u793a\u66f4\u591a\u9690\u542b\u7684\u8fd1\u671f\u536b\u661f\u56fe\u50cf\u3002", "cd691946578e8e9780e0b3e4030aac75": "\u5bf9\u4e8e\u5f62\u5f0f\u4e3a\u6587\u672c\u3001\u56fe\u50cf\u548c\u6570\u5b57\u7684\u95ee\u9898\uff0c\u56e2\u961f\u6210\u5458\u9700\u5728\u586b\u5199\u62a5\u544a\u65f6\u8f93\u5165\u56de\u7b54\u3002\u5bf9\u4e8e\u5355\u9009\u9898\u548c\u591a\u9009\u9898\uff0c\u68ee\u6797\u76d1\u6d4b\u5458\u5219\u9700\u9009\u51fa\u7b54\u6848\u3002", "9e5775c898c472e479d000b7aaf4ce45": "\u4e00\u65e6\u70b9\u51fb\u67d0\u4e2a\u6570\u636e\u5c42\uff0c\u5206\u6790\u8fc7\u7a0b\u5c06\u81ea\u52a8\u8fd0\u884c\uff0c\u5e76\u5728\u56fe\u4f8b/\u5206\u6790\u9762\u677f\u4e2d\u751f\u6210\u6570\u636e\u56fe\u8868\u3002\u9ed8\u8ba4\u5206\u6790\u5c06\u4e3a\u60a8\u63d0\u4f9b\u6811\u6728\u8986\u76d6\u635f\u5931\u3001\u6811\u6728\u8986\u76d6\u589e\u52a0\u548c\u6811\u6728\u8986\u76d6\u7387\u65b9\u9762\u7684\u6570\u636e\u3002\u82e5\u60f3\u83b7\u53d6\u66f4\u591a\u6570\u636e\u56fe\u8868\uff0c\u8bf7\u6fc0\u6d3b\u989d\u5916\u7684\u201c\u7814\u7a76\u201d\u6570\u636e\u5c42\u3002", "bcf9556718dcbcb9840e137833d38394": "<strong>\u89c1\u8bc1\u68ee\u6797\u6570\u636e\u968f\u65f6\u95f4\u800c\u53d8\u5316</strong>\u3002\u67d0\u4e9b\u68ee\u6797\u53d8\u5316\u6570\u636e\u5c42\uff0c\u5982\u6811\u6728\u8986\u76d6\u635f\u5931\uff0c\u53ef\u4ee5\u63d0\u4f9b\u6570\u636e\u968f\u65f6\u95f4\u53d8\u5316\u7684\u52a8\u753b\u3002\u70b9\u51fb\u65f6\u95f4\u6ed1\u5757\u5de6\u4fa7\u7684\u64ad\u653e\u56fe\u6807\uff0c\u5373\u53ef\u5728\u9009\u5b9a\u7684\u65e5\u671f\u8303\u56f4\u5185\u89c2\u770b\u6570\u636e\u53d8\u5316\u3002", "91a2e542aac9a8189316f142965e150d": "\u70b9\u51fb\u201c\u5750\u6807\u683c\u5f0f\u201d\u83dc\u5355\uff0c\u9009\u62e9\u60a8\u60f3\u8981\u7684\u5750\u6807\u683c\u5f0f\u3002\u9ed8\u8ba4\u683c\u5f0f\u4e3a\u201c\u5341\u8fdb\u5236\u201d\uff0c\u60a8\u4e5f\u53ef\u4ee5\u5728\u5341\u8fdb\u5236\u3001\u5ea6\u6570\u548cUTM\u4e4b\u95f4\u9009\u62e9\u3002\u9009\u5b9a\u540e\uff0c\u70b9\u51fb\u201c\u5b8c\u6210\u201d\u3002", "4f607655600bd5ed4036b48a03dafd1f": "\u4f7f\u7528\u5168\u7403\u68ee\u6797\u89c2\u6d4b", "53851c85a6763042b5f3623453497e2b": "\u70b9\u51fb\u505c\u6b62\u56fe\u6807\uff0c\u4e2d\u6b62\u60a8\u7684\u8def\u7ebf\u3002", "8c90018bd533d7372e23f91c462d81a6": "\u70b9\u51fb\u60a8\u611f\u5174\u8da3\u7684\u641c\u7d22\u7ed3\u679c\uff0c\u52a0\u8f7d\u548c\u6570\u636e\u6709\u5173\u7684\u4fe1\u606f\u9875\u3002", "d94c2ffb614a9759bc4bf816c7669e28": "<strong>\u5c55\u5f00\u5730\u56fe\u89c6\u56fe</strong>\u3002\u5982\u679c\u60a8\u60f3\u4ece\u5730\u56fe\u89c6\u56fe\u4e2d\u5220\u9664\u5730\u56fe\u8bbe\u7f6e\u5de5\u5177\uff0c\u8bf7\u70b9\u51fb\u5730\u56fe\u53f3\u4e0b\u65b9\u7684\u201c\u4ec5\u663e\u793a\u5730\u56fe\u201d\u56fe\u6807\u3002\u518d\u6b21\u70b9\u51fb\u8be5\u56fe\u6807\uff0c\u5373\u53ef\u8fd8\u539f\u8fd9\u4e9b\u5de5\u5177\u3002", "a6a5dc4d11cb99e689ea0860ed5c78f2": "\u70b9\u51fb\u4e3b\u9875\u4e0a\u7684\u201c\u8bbe\u7f6e\u201d\u3002", "acbd723f31e540bd2b40a912eb504bbc": "\u5f00\u53d1\u8005\u6587\u4ef6", "03866e49857374291e3e4a482ec989d0": "\u6570\u636e\u5c42\u7684\u53ef\u7528\u8bbe\u7f6e\u53ef\u4ee5\u4ece\u56fe\u4f8b/\u5206\u6790\u9762\u677f\u8bbf\u95ee\u3002", "87a87ba58e6145c827f729fc43615200": "\u82e5\u60f3\u5728\u5730\u56fe\u4e0a\u6fc0\u6d3b\u5e76\u67e5\u770b\u9009\u5b9a\u7684\u533a\u57df\uff0c\u8bf7\u8fd4\u56de\u5730\u56fe\uff0c\u70b9\u51fb\u9f7f\u8f6e\u8bbe\u7f6e\u56fe\u6807\u3002\u70b9\u51fb\u60f3\u6fc0\u6d3b\u7684\u6570\u636e\u5c42\u65c1\u8fb9\u7684\u5706\u5708\u56fe\u6807\u3002\u6fc0\u6d3b\u540e\uff0c\u60a8\u4f1a\u770b\u5230\u4e00\u4e2a\u7eff\u8272\u5c0f\u52fe\uff0c\u8fd9\u65f6\u60a8\u5c31\u80fd\u5728\u5730\u56fe\u4e0a\u770b\u5230\u6240\u9009\u6570\u636e\u5c42\u4e86\u3002", "b2b66600c7d86accc8d2692486302ca0": "\u201c\u524d\u5f80\u5168\u7403\u64cd\u4f5c\u9762\u677f\u201d\u5c06\u5e26\u60a8\u8fdb\u5165\u9ed8\u8ba4\u7684\u5168\u7403\u64cd\u4f5c\u9762\u677f\u3002\u60a8\u53ef\u4ee5\u5728\u6b64\u8fdb\u4e00\u6b65\u4e86\u89e3\u5982\u4f55\u5728\u64cd\u4f5c\u9762\u677f\u4e0a\u67e5\u770b\u5168\u7403\u3001\u56fd\u5bb6\u548c\u7701\u5730\u7ea7\u5730\u533a\u7684\u68ee\u6797\u7edf\u8ba1\u6570\u636e\u3002", "70ee5d34c3fbe0fac103f6b60be96004": "\u9009\u62e9\u201c\u65e0\u8fb9\u754c\u201d\u6765\u5220\u9664\u5730\u56fe\u4e0a\u7684\u6240\u6709\u8fb9\u754c\u3002", "750771d0465dc06df87fa6e3b0fea5ed": "\u4e0e\u5176\u4ed6\u8bbe\u5907\u5171\u4eab\u5e94\u7528\u7a0b\u5e8f\u7684\u5185\u5bb9", "7d71caae06e56abf67b5c15a99d819e5": "<strong>\u6dfb\u52a0\u548c\u5220\u9664\u6570\u636e\u5c42\u3002</strong>\u60a8\u53ef\u4ee5\u81ea\u5b9a\u4e49\u60f3\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u7684\u6570\u636e\u5c42\u3002\u82e5\u60f3\u5728\u5730\u56fe\u4e0a\u6dfb\u52a0\u6570\u636e\u5c42\uff0c\u8bf7\u70b9\u51fb\u5730\u56fe\u5de6\u4fa7\u7684\u5206\u7c7b\uff0c\u6fc0\u6d3b\u60f3\u67e5\u770b\u7684\u6570\u636e\u5c42\u3002\u5220\u9664\u6570\u636e\u5c42\u4e5f\u53ef\u4ee5\u6309\u4ee5\u4e0a\u6b65\u9aa4\u8fdb\u884c\uff0c\u6216\u8005\u70b9\u51fb\u56fe\u4f8b\u4e0a\u6570\u636e\u5c42\u65c1\u8fb9\u7684\u5220\u9664\u6570\u636e\u5c42\u56fe\u6807\u201cx\u201d\u3002\u5199\u6709\u6570\u5b57\u7684\u7eff\u8272\u5706\u5708\u4ee3\u8868\u60a8\u5728\u6bcf\u4e2a\u7c7b\u522b\u4e2d\u6fc0\u6d3b\u4e86\u591a\u5c11\u4e2a\u6570\u636e\u5c42\u3002", "8648f2dfff550b5e6086b1d633f2cedc": "\u524d\u5f80\u5730\u56fe\uff0c\u70b9\u51fb\u60a8\u5173\u6ce8\u7684\u56fd\u5bb6\u3002", "42467adab99aa872330e4cba535b7185": "\u5728\u7701\u5730\u7ea7\u5730\u56fe\u4e0a\u653e\u5927\u6765\u9009\u62e9\u6570\u636e\u5c42\u3002", "b01343d6093b405801e8aaf745e15806": "\u82e5\u60f3\u5728\u56fd\u5bb6\u7ea7\u5730\u56fe\u4e0a\u4fdd\u5b58\u548c\u8ba2\u9605\u4e00\u4e2a\u5730\u533a\uff0c\u9996\u5148\u8bf7\u70b9\u51fb\u5730\u56fe\u4e0a\u611f\u5174\u8da3\u7684\u56fd\u5bb6\u3002\u60a8\u4e5f\u53ef\u4ee5\u4f7f\u7528\u5de6\u4e0b\u89d2\u7684\u641c\u7d22\u5de5\u5177\u627e\u5230\u60f3\u8fdb\u884c\u5206\u6790\u7684\u56fd\u5bb6\u3002\u5728\u6b64\u8fdb\u4e00\u6b65\u4e86\u89e3\u5982\u4f55\u641c\u7d22\u67d0\u4e2a\u5730\u533a\u7684\u4fe1\u606f\u3002\u5728\u4e0b\u9762\u7b2c\u4e00\u4e2a\u4f8b\u5b50\u4e2d\uff0c\u9009\u5b9a\u5730\u533a\u4e3a\u8d8a\u5357\u3002", "03aa9854454cc425b887281d36223e04": "\u60a8\u53ef\u4ee5\u70b9\u51fb\u95ee\u9898\u6846\u53f3\u4e0b\u89d2\u7684\u5fc5\u586b\u56fe\u6807\uff0c\u5c06\u95ee\u9898\u53d8\u6210\u5fc5\u586b\u95ee\u9898\u3002\u586b\u5199\u62a5\u544a\u65f6\uff0c\u56e2\u961f\u6210\u5458\u5fc5\u987b\u56de\u7b54\u5fc5\u586b\u95ee\u9898\uff0c\u975e\u5fc5\u586b\u95ee\u9898\u53ef\u4ee5\u8df3\u8fc7\u3002", "c80e81e85118657f93a844e1d86797de": "\u4ece\u64cd\u4f5c\u9762\u677f\u4e0b\u8f7d\u7279\u5b9a\u533a\u57df\u7684\u7edf\u8ba1\u6570\u636e\uff08.csv\u548cExcel\u6587\u4ef6\uff09\u3002\u524d\u5f80\u60a8\u5173\u6ce8\u7684\u533a\u57df\u7684\u64cd\u4f5c\u9762\u677f\u540e\uff0c\u60a8\u4f1a\u770b\u5230\u4e0b\u8f7d\u6570\u636e\u7684\u4e24\u79cd\u9014\u5f84\u3002", "c7b59c2241b23da680f8d264fe2a5976": "\u70b9\u51fb\u201c\u6dfb\u52a0\u95ee\u9898\u201d\uff0c\u5f80\u62a5\u544a\u6a21\u677f\u6dfb\u52a0\u989d\u5916\u7684\u95ee\u9898\u3002", "ea24e72b7d68f9c2ca6b0d18b97de871": "\u62a5\u544a\u6a21\u677f\u51c6\u5907\u5c31\u7eea\u540e\uff0c\u70b9\u51fb\u5e95\u90e8\u7684\u672a\u53d1\u5e03/\u53d1\u5e03\u56fe\u6807\uff0c\u7136\u540e\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u6765\u6fc0\u6d3b\u5b83\u3002\u62a5\u544a\u6a21\u677f\u4e00\u65e6\u53d1\u5e03\uff0c\u5c31\u4e0d\u80fd\u518d\u7f16\u8f91\u3002\u52a1\u5fc5\u5728\u62a5\u544a\u6a21\u677f\u5b8c\u6210\u540e\u518d\u53d1\u5e03\u3002\u5982\u679c\u6ca1\u6709\u5b8c\u6210\uff0c\u8bf7\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u5c06\u5176\u4fdd\u5b58\u4e3a\u8349\u7a3f\uff0c\u4ee5\u540e\u518d\u7f16\u8f91\u3002", "04c707827c78ac116ceae499768dfcbd": "\u6709\u5173GFW Pro\u7684\u5e38\u89c1\u95ee\u9898\uff0c\u8bf7\u8bbf\u95ee<a href=\"{{0}}\">\u8fd9\u91cc</a>\u3002", "ae128f7212efb4fcac4bbadb5701ec8a": "\u5341\u5b57\u51c6\u7ebf\u4ee5\u52a0\u7eb3\u4e3a\u4e2d\u5fc3\uff0c\u70b9\u51fb\u653e\u5927\u56fe\u6807\u201c+\u201d\u5c31\u53ef\u4ee5\u653e\u5927\u5230\u8fd9\u4e2a\u56fd\u5bb6\u3002", "a8d522efe4d1e83ff5beb7e50d551a18": "\u6d4f\u89c8\u6709\u5173\u5730\u56fe\u548c\u64cd\u4f5c\u9762\u677f\u7684\u5e38\u89c1\u95ee\u9898\uff0c\u8fdb\u4e00\u6b65\u4e86\u89e3\u68ee\u6797\u76d1\u6d4b\u5de5\u5177\u548c\u5b83\u4eec\u63d0\u4f9b\u7684\u6570\u636e\u3002", "0bf518901699c41db7af76e1ef64a957": "\u8bbe\u7f6e\u5e94\u7528\u7a0b\u5e8f", "bcb0ee987f2c823ff6ece42bbd11f34f": "\u6211\u5df2\u9605\u8bfb\u5e76\u540c\u610fGFW\u7684\u9690\u79c1\u653f\u7b56\u3002", "ec507e2c7a0cb7ddb1601ded6212a3e1": "\u70b9\u51fb\u201c\u4fdd\u62a4\u533a\u201d\u5de6\u8fb9\u7684\u56fe\u6807\uff0c\u6fc0\u6d3b\u8be5\u6570\u636e\u5c42\u3002", "de2ff2ba208db250731b110b4df40d54": "\u70b9\u51fb\u201c\u5206\u4eab\u201d\u56fe\u6807\uff0c\u590d\u5236\u94fe\u63a5\u4e0e\u4ed6\u4eba\u5206\u4eab\u3002", "5d8eeaf69355ac4c820aa3064881f198": "\u82e5\u60f3\u5728\u64cd\u4f5c\u9762\u677f\u53f3\u4fa7\u7684\u5730\u56fe\u4e0a\u67e5\u770b\u7279\u5b9a\u6570\u636e\u56fe\u8868\u7684\u6570\u636e\uff0c\u8bf7\u70b9\u51fb\u6570\u636e\u56fe\u8868\u53f3\u4e0a\u65b9\u7684\u201c\u5728\u5730\u56fe\u4e0a\u663e\u793a\u201d\u3002", "24bb6315a5d71a67104fefaa2af0d54a": "\u70b9\u51fb\u60a8\u5173\u6ce8\u7684\u4fdd\u62a4\u533a\u6570\u636e\u5c42\uff0c\u70b9\u51fb\u201c\u5206\u6790\u201d\uff0c\u8fd0\u884c\u5206\u6790\u8fc7\u7a0b\u3002", "9270214ddb8a64da3d6799e85280bc8f": "\u8fd4\u56de\u533a\u57df\u9875\u9762\u3002", "9546ce24bc9fa615a27bab4490e061cd": "\u70b9\u51fb\u5730\u56fe\uff0c\u7528\u70b9\u72b6\u6807\u8bb0\u660e\u786e\u60a8\u5173\u6ce8\u7684\u533a\u57df\u7684\u8fb9\u754c\u3002", "5ee6a4dbe2fd2ff1326a8244a092efb4": "\u5b8c\u6210\u60a8\u60f3\u753b\u7684\u56fe\u5f62\u5373\u53ef\u6fc0\u6d3b\u5206\u6790\u8fc7\u7a0b\uff0c\u83b7\u53d6\u8be5\u533a\u57df\u7684\u5206\u6790\u7ed3\u679c\u3002", "d2dbd07cd7e1a70bc657c2601613c19a": "\u9996\u5148\u524d\u5f80\u4e3b\u9875\uff0c\u7136\u540e\u70b9\u51fb\u201c\u8bbe\u7f6e\u201d\u3002\u70b9\u51fb\u201c\u5171\u4eab\u6240\u6709\u5e94\u7528\u7a0b\u5e8f\u6570\u636e\u201d\uff0c\u751f\u6210\u4e00\u4e2a\u5305\u542b\u5e94\u7528\u7a0b\u5e8f\u4e0a\u6240\u6709\u5b58\u6863\u5185\u5bb9\u7684\u6587\u4ef6\u3002", "5d3cccf094d8c86f694ecde751783709": "\u60a8\u53ef\u4ee5\u5728\u8bbe\u7f6e\u9875\u9762\u7684\u201c\u6211\u7684\u56e2\u961f\u201d\u9009\u9879\u5361\u4e2d\u8bbf\u95ee\u60a8\u7684\u56e2\u961f.&nbsp\u3002", "68421095bda5f00f4fbc0f2997c3d64b": "\u91c7\u77ff\u7279\u8bb8\u6743\u80cc\u666f\u6570\u636e\u5c42\u73b0\u5728\u5217\u4e8e\u201cGFW\u6570\u636e\u5c42\u201d\u4e0b\u3002", "317307adf37909f3c52e861645feb63c": "\u5206\u6790\u81ea\u5b9a\u4e49\u533a\u57df", "acb0bf0b8ecbe56e350f7e1f28c7e143": "\u70b9\u51fb\u201c\u81ea\u5b9a\u4e49\u5e95\u56fe\u3002\u201d", "d4c736db2dd05147ab9ac367097774b3": "GFW\u8d44\u6599\u6863\u6848", "2977f07c62b77329e1127f6f6426a9c8": "\u53c2\u52a0\u7f51\u7edc\u7814\u8ba8\u4f1a\uff0c\u4e86\u89e3\u5982\u4f55\u4f7f\u7528Forest Watcher\u5728\u79bb\u7ebf\u72b6\u6001\u4e0b\u5b9e\u5730\u76d1\u6d4b\u68ee\u6797\u3002", "44fc6527bdc216fc00e0dbc9810a3b64": "\u4f7f\u7528\u201c\u67e5\u627e\u6570\u636e\u201d\u641c\u7d22\u680f\u641c\u7d22\u60a8\u60f3\u770b\u7684\u6570\u636e\u5c42\u3002", "be0879f07e03f949e19184d4c36f1fec": "\u63a2\u7d22\u6d4f\u89c8\u5176\u4ed6\u8d44\u6599\u2014\u2014\u5305\u62ec\u5408\u4f5c\u4f19\u4f34\u5236\u4f5c\u7684\u57f9\u8bad\u6750\u6599\u548cGFW\u6559\u7a0b\u6863\u6848\uff0c\u4e86\u89e3\u5982\u4f55\u5229\u7528Forest Watcher\u5728\u79bb\u7ebf\u72b6\u6001\u4e0b\u5b9e\u5730\u76d1\u6d4b\u68ee\u6797\u3002", "acf637999df4787ca2e85a6c69f98715": "\u6587\u4ef6\u5c06\u81ea\u52a8\u4fdd\u5b58\u5728\u60a8\u9009\u5b9a\u7684\u76ee\u7684\u5730\u3002", "0834ddbc28896b4026eb46551e553462": "\u60a8\u53ef\u4ee5\u7528Facebook\u3001Twitter\u3001Google\u6216\u90ae\u7bb1\u767b\u5f55\uff0c\u7136\u540e\u8bbe\u7f6e\u5e94\u7528\u7a0b\u5e8f\u3002\u5171\u4eab\u8bbe\u5907\u7684\u56e2\u961f\u901a\u5e38\u4f1a\u4e3a\u56e2\u961f\u521b\u5efa\u5171\u4eab\u8d26\u6237\uff0c\u8fd9\u6837\u6301\u6709\u767b\u5f55\u540d\u548c\u5bc6\u7801\u7684\u6210\u5458\u90fd\u53ef\u4ee5\u8bbf\u95ee\u4fdd\u5b58\u5728\u8d26\u6237\u4e2d\u7684\u533a\u57df\u3001\u62a5\u544a\u548c\u8def\u7ebf\u3002", "b1c30051da2618f862129f6c152e07d8": "\u5927\u591a\u6570\u7528\u6237\u662f\u4ece\u8fd9\u91cc\u5f00\u59cb\u7684\uff01", "904c584e4df52801abdaeb87d059c4b1": "\u9009\u5b9a\u7684\u80cc\u666f\u6570\u636e\u5c42\u73b0\u5728\u53ef\u4ee5\u5728\u5730\u56fe\u4e0a\u770b\u5230\u3002", "599e7a910c0ef3d36ef7553de9290f00": "\u5ba2\u670d\u4e2d\u5fc3\u5c06\u63d0\u4f9b\u4fe1\u606f\u8d44\u6e90\uff0c\u5e26\u60a8\u4e86\u89e3Global Forest Watch\u63d0\u4f9b\u7684\u68ee\u6797\u76d1\u6d4b\u6570\u636e\u3001\u6280\u672f\u548c\u5de5\u5177\u3002", "fc156bd278d5943531bbf255636a7ff8": "\u524d\u5f80\u60a8\u60f3\u5206\u4eab\u7684\u5185\u5bb9\u3002\u60a8\u53ef\u4ee5\u4ece\u4e3b\u9875\u8bbf\u95ee\u533a\u57df\u3001\u62a5\u544a\u548c\u8def\u7ebf\u3002", "be6b3e44c6c27948c8b5547ca0634a49": "\u70b9\u51fb\u8fb9\u754c\u56fe\u6807\uff0c\u81ea\u5b9a\u4e49\u5730\u56fe\u4e0a\u7684\u8fb9\u754c\u3002\u9ed8\u8ba4\u4e3a\u201c\u653f\u6cbb\u8fb9\u754c\u201d\u3002", "56d0e1ffad5faf6e9c6d5f621c767a19": "\u81ea\u5b9a\u4e49\u5730\u56fe\u4e0a\u53ef\u89c1\u7684\u5e95\u56fe\u3002", "8d0245dedb3e4e661d8f509a2d20feab": "\u70b9\u51fb\u4fe1\u606f\u56fe\u6807\u201ci\u201d\uff0c\u6fc0\u6d3b\u4fe1\u606f\u5f39\u7a97\u3002", "e772828cae9bc7ddaef5bcc2a964c508": "\u4ece\u64cd\u4f5c\u9762\u677f\u4e0b\u8f7d\u6570\u636e", "04b91c07ca65c17a12bfa6129e64f902": "<strong>\u8c03\u6574\u6570\u636e\u56fe\u8868\u8bbe\u7f6e\uff0c\u4e0b\u8f7d\u6570\u636e\uff0c\u8fdb\u4e00\u6b65\u4e86\u89e3\u6570\u636e\uff0c\u5206\u4eab\u6570\u636e\u56fe\u8868</strong>\u3002\u8c03\u6574\u6bcf\u4e2a\u6570\u636e\u56fe\u8868\u7684\u8bbe\u7f6e\uff0c\u5982\u571f\u5730\u7c7b\u522b\u3001\u6811\u51a0\u5bc6\u5ea6\u548c\u65e5\u671f\u8303\u56f4\u3002\u60a8\u8fd8\u53ef\u4ee5\u4e0b\u8f7d\u5355\u4e2a\u6570\u636e\u56fe\u8868\u4e0a\u7684\u6570\u636e\uff0c\u8fdb\u4e00\u6b65\u4e86\u89e3\u6570\u636e\uff0c\u5171\u4eab\u6216\u5d4c\u5165\u6570\u636e\u56fe\u8868\u3002\u82e5\u60f3\u5171\u4eab\u5355\u4e2a\u6570\u636e\u56fe\u8868\uff0c\u8bf7\u5355\u51fb\u5171\u4eab\u56fe\u6807\uff0c\u751f\u6210\u6293\u53d6\u6570\u636e\u56fe\u8868\u7684\u4e13\u5c5e\u94fe\u63a5\uff0c\u4e0e\u4ed6\u4eba\u5206\u4eab\uff0c\u60a8\u4e5f\u53ef\u4ee5\u751f\u6210HTML\uff0c\u5728\u5916\u90e8\u7f51\u7ad9\u5185\u5d4c\u5165\u6570\u636e\u56fe\u8868\u3002", "20847993c79d4e38456d9c6e9817f7e9": "\u4e0b\u8f7d\u5b8c\u6bd5\u540e\uff0c\u56fe\u6807\u4e0a\u7684\u5411\u4e0b\u7bad\u5934\u5c06\u53d8\u4e3a\u52fe\u53f7\u3002", "fe9c00d4265bde171abbfdd65d364207": "\u5c06\u4e24\u6839\u624b\u6307\u653e\u5728\u5c4f\u5e55\u4e0a\uff0c\u5f20\u5f00\u624b\u6307\uff0c\u653e\u5927\u5730\u56fe\u3002", "e0ff1f052f96a63b01564bafaad4031a": "\u70b9\u51fb\u5c4f\u5e55\u521b\u5efa\u70b9\u72b6\u6807\u8bb0\uff0c\u6807\u8bb0\u60a8\u60f3\u5173\u6ce8\u7684\u533a\u57df\u3002", "b7c84132ffc956dd5fc0c2c1f3e4be76": "\u60a8\u53ef\u4ee5\u5728GFW\u4e0a\u7684\u5730\u56fe&amp;\u64cd\u4f5c\u9762\u677f\u4e0a\u6d4f\u89c8\u6570\u767e\u4e2a\u7a7a\u95f4\u6570\u636e\u96c6\uff0c\u8fd9\u4e9b\u6570\u636e\u96c6\u6709\u52a9\u4e8e\u89e3\u91ca\u4e16\u754c\u5404\u5730\u68ee\u6797\u53d8\u5316\u7684\u65f6\u95f4\u3001\u5730\u70b9\u548c\u539f\u56e0\u3002", "ab362fdd283a41b1bec98cc424dea4d6": "\u201c\u661f\u7403\u201d\u5e95\u56fe\u63d0\u4f9b\u5206\u8fa8\u7387\u4e3a5\u7c73\u7684\u9a6c\u8d5b\u514b\u56fe\u50cf\uff0c\u6bcf\u6708\u66f4\u65b0\u4e00\u6b21\u3002", "cd18ba4a3b8af1aff150f23f5d0f1b16": "\u518d\u6b21\u70b9\u51fb\u4e0b\u62c9\u83dc\u5355\uff0c\u9009\u62e9\u4e00\u4e2a\u5b50\u533a\u57df\u3002", "57e9eb16aa96d5beee181da68633f507": "\u70b9\u51fb\u60a8\u611f\u5174\u8da3\u7684\u7c7b\u522b\uff0c\u5411\u4e0b\u6eda\u52a8\u67e5\u770b\u76f8\u5173\u6570\u636e\u56fe\u8868\u3002", "532c794797eb937592bbd3ce12d91071": "\u70b9\u51fb\u201c\u5bfc\u5165\u6570\u636e\u5305\u201d\uff0c\u786e\u8ba4\u5bfc\u5165\u3002", "31095c0b8380050e8f2d11c36b160fe1": "\u6d4f\u89c8\u6709\u5173Forest Watcher\u7684\u5e38\u89c1\u95ee\u9898\uff0c\u8fdb\u4e00\u6b65\u4e86\u89e3\u5982\u4f55\u5728\u79bb\u7ebf\u72b6\u6001\u4e0b\u5b9e\u5730\u76d1\u6d4b\u68ee\u6797\u3002", "e428f90484ed65c134d62396166f257f": "\u901a\u8fc7\u53ef\u7528\u9009\u9879\u4e4b\u4e00\u767b\u5f55Forest Watcher\u3002", "179cec59bb5d92b7cddb615e48b0b595": "\u5728\u6587\u672c\u6846\u4e2d\u8f93\u5165\u6a21\u677f\u7684\u540d\u79f0\uff0c\u7136\u540e\u5f80\u62a5\u544a\u6a21\u677f\u91cc\u6dfb\u52a0\u95ee\u9898\u3002", "9d27c7d59ae01829e66494e2c736804a": "\u9009\u62e9\u201c\u5341\u8fdb\u5236\u5ea6\u201d\u641c\u7d22\uff0c\u6309\u7ecf\u7eac\u5ea6\u8fdb\u884c\u641c\u7d22\u3002\u8f93\u5165\u7ecf\u7eac\u5ea6\u4fe1\u606f\uff0c\u7136\u540e\u70b9\u51fb\u201c\u524d\u5f80\u8be5\u5730\u201d\uff0c\u5730\u56fe\u4f1a\u81ea\u52a8\u8c03\u6574\u5230\u8be5\u5730\u3002GFW \u8fd8\u6839\u636e\u5341\u5b57\u51c6\u7ebf\u4f4d\u7f6e\u63d0\u4f9b\u5730\u56fe\u4e0a\u6240\u6709\u533a\u57df\u7684\u7ecf\u7eac\u5ea6\u503c\u3002\u60a8\u53ef\u4ee5\u5728\u5730\u56fe\u53f3\u4e0b\u89d2\u627e\u5230\u8fd9\u4e9b\u4fe1\u606f\u3002", "fe90bf2fa492054305520ba641235012": "\u70b9\u51fb\u540e\u9000\u7bad\u5934\u56fe\u6807\u8fd4\u56de\u9996\u9875\uff0c\u70b9\u51fb\u201c\u533a\u57df\u201d\u8fd4\u56de\u533a\u57df\u9875\u9762\u3002", "aef2009ba539e02a754d46748b22a151": "\u70b9\u51fb\u5de6\u4e0b\u89d2\u7684\u5f00\u59cb\u56fe\u6807\uff0c\u5f00\u59cb\u8ffd\u8e2a\u60a8\u4ece\u5f53\u524d\u4f4d\u7f6e\u5230\u6240\u9009\u76ee\u7684\u5730\u7684\u8def\u7ebf\u3002\u60a8\u53ef\u4ee5\u9009\u62e9\u8bb0\u5f55\u60a8\u5230\u76ee\u7684\u5730\u7684\u5355\u7a0b\u8def\u7ebf\uff0c\u4e5f\u53ef\u4ee5\u9009\u62e9\u8bb0\u5f55\u8fd4\u56de\u539f\u51fa\u53d1\u70b9\u7684\u5f80\u8fd4\u8def\u7ebf\u3002", "8fc0cdc123260588a440693791f23a41": "\u7533\u8bf7\u4e00\u4e2a\u7f51\u7edc\u7814\u8ba8\u4f1a\u4e3b\u9898", "6f69b306d319b874f2efdc67d1c25b53": "\u70b9\u51fb \"+\" \u56fe\u6807\u4e0a\u4f20\u65b0\u7684\u81ea\u5b9a\u4e49\u57fa\u56fe\u3002", "b02efe46d93c91b74ec64b7184df6e61": "\u6dfb\u52a0\u7167\u7247\u540e\uff0c\u60a8\u4f1a\u88ab\u63d0\u793a\u56de\u7b54\u4e00\u7cfb\u5217\u95ee\u9898\u6765\u63cf\u8ff0\u60a8\u5728\u8be5\u533a\u57df\u53d1\u73b0\u7684\u4e1c\u897f\u3002\u5b8c\u6210\u540e\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u5c06\u62a5\u544a\u4fdd\u5b58\u81f3\u60a8\u7684\u8bbe\u5907\u6216\u5220\u9664\u62a5\u544a\u3002\u60a8\u4e5f\u53ef\u4ee5\u4fdd\u5b58\u62a5\u544a\u8349\u7a3f\uff0c\u4e4b\u540e\u901a\u8fc7\u70b9\u51fb\u53f3\u4e0a\u65b9\u7684\u56fe\u6807\u8fd4\u56de\u3002\u8fd4\u56de\u7b2c 16 \u6b65\u6765\u521b\u5efa\u53e6\u4e00\u4efd\u62a5\u544a\u3002", "36c69c795ab73cfd086efada12fd8493": "\u5728\u5730\u56fe\u4e0a\u653e\u5927\u663e\u793a\u51fa\u60a8\u611f\u5174\u8da3\u7684\u533a\u57df\u540e\uff0c\u70b9\u51fb\u7f29\u5c0f \u201c-\u201d \u56fe\u6807\u4e0b\u65b9\u7684\u7ed8\u5236\u591a\u8fb9\u5f62\u56fe\u6807\u3002\u4ece\u8fd9\u91cc\uff0c\u901a\u8fc7\u70b9\u51fb\u5730\u56fe\u8bbe\u70b9\u6765\u754c\u5b9a\u60a8\u611f\u5174\u8da3\u7684\u533a\u57df\u3002\u8fd9\u4e9b\u70b9\u5c06\u754c\u5b9a\u60a8\u611f\u5174\u8da3\u7684\u533a\u57df\u8fb9\u754c\u3002\u8981\u5173\u95ed\u60a8\u7ed8\u5236\u7684\u56fe\u5f62\uff0c\u53ef\u4ee5\u70b9\u51fb\u201c\u5b8c\u6210\u201d\u6216\u70b9\u51fb\u60a8\u8bbe\u4e0b\u7684\u7b2c\u4e00\u4e2a\u70b9\u3002", "e46fe67b329e9fc23dfa41555601e132": "\u6d4f\u89c8\u5173\u4e8e GFW Pro \u7684\u5e38\u89c1\u95ee\u9898\uff0c\u8be6\u7ec6\u4e86\u89e3\u8be5\u5de5\u5177\u53ca\u5176\u6240\u63d0\u4f9b\u7684\u6570\u636e\u5982\u4f55\u80fd\u5e2e\u52a9\u7ba1\u7406\u5546\u54c1\u4f9b\u5e94\u94fe\u4e2d\u7684\u6bc1\u6797\u98ce\u9669\u3002", "eb9f4717dfbb945c8501a8a57e5b99dd": "\u5f52\u6863\u7684 GFW \u6750\u6599", "e14d8569f4aaa646a77083dcd3b022dd": "\u4e00\u65e6\u9009\u62e9\u4e86\u60a8\u7684\u80cc\u666f\u56fe\u5c42\uff0c\u70b9\u51fb\u5de6\u4e0a\u89d2\u7684\u540e\u9000\u7bad\u5934\u56fe\u6807\u8fd4\u56de\u5730\u56fe\u3002\u70b9\u51fb\u8bbe\u7f6e\u9f7f\u8f6e\u56fe\u6807\uff0c\u7136\u540e\u70b9\u51fb \u201c\u80cc\u666f\u56fe\u5c42\u201d\u65c1\u8fb9\u7684\u5706\u5708\u6765\u6fc0\u6d3b\u60a8\u9009\u62e9\u7684\u56fe\u5c42\u3002\u8fd9\u4e9b\u56fe\u5c42\u73b0\u5728\u5c31\u4f1a\u5728\u5730\u56fe\u4e0a\u663e\u793a\u51fa\u6765\u3002", "7b563db8bd2d95cffa43bad9a8d92d87": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Amaz\u00f3nicos por la Amazon\u00eda (AMPA)</a>\u4e8e 2020 \u5e74 9 \u6708\u7f16\u5199\u4e86\u79d8\u9c81\u73af\u5883\u72af\u7f6a\u6d3b\u52a8\u62a5\u544a\u5b9e\u7528\u624b\u518c\uff0c\u4e3a\u975e\u6728\u6750\u548c\u4fdd\u62a4\u7279\u8bb8\u6743\u6301\u6709\u4eba\u62a5\u544a\u79d8\u9c81\u73af\u5883\u72af\u7f6a\u6d3b\u52a8\u5fc5\u987b\u9075\u5b88\u7684\u6b65\u9aa4\u548c\u8981\u6c42\u63d0\u4f9b\u6307\u5bfc\u3002\u8be5\u624b\u518c\u63d0\u4f9b\u897f\u73ed\u7259\u6587\u7248\u672c\u3002", "560ca03566283ef3e6c9e1ad3a42573e": "\u70b9\u51fb\u5355\u4e2a\u6570\u636e\u56fe\u8868\u4e2d\u7684\u4e0b\u8f7d\u56fe\u6807\uff0c\u4e0b\u8f7d\u8be5\u6570\u636e\u56fe\u8868\u7684\u6570\u636e\u3002", "59365a340c0489722e7d698d6d40b2bb": "<a href=\"{{0}}\">\u5728\u6b64</a>\u8be6\u7ec6\u4e86\u89e3\u5982\u4f55\u4fdd\u5b58\u611f\u5174\u8da3\u7684\u533a\u57df\u3002", "b907ab287066b0565e8dcecd40324581": "\u5982\u679c\u60a8\u60f3\u76d1\u6d4b\u548c\u5206\u6790\u60a8\u611f\u5174\u8da3\u7684\u7279\u5b9a\u533a\u57df\uff0c\u800c\u8be5\u533a\u57df\u4e0d\u5c5e\u4e8e GFW \u4e0a\u73b0\u6709\u6570\u636e\u5c42\u7684\u4e00\u90e8\u5206\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u5206\u6790\u5de5\u5177\u7ed8\u5236\u56fe\u5f62\u6216\u4e0a\u4f20\u56fe\u5f62\u6587\u4ef6\u3002\u4e3a\u6b64\uff0c\u9996\u5148\u5bfc\u822a\u5230\u56fe\u4f8b/\u5206\u6790\u9762\u677f\u4e0a\u7684\u201c\u5206\u6790\u201d\u9009\u9879\u5361\uff0c\u7136\u540e\u70b9\u51fb\u201c\u7ed8\u5236\u6216\u4e0a\u4f20\u56fe\u5f62\u201d\u3002", "08bde844a031218183f25a7ea4b8bae0": "\u70b9\u51fb\u4fe1\u606f \u201ci\u201d \u56fe\u6807\u53ef\u6fc0\u6d3b\u5bf9\u5e94\u6797\u6728\u8986\u76d6\u7387\u635f\u5931\u7684\u5f39\u7a97\u3002", "762e66018f3fe79b5f16586ae32bd4d8": "<strong>\u9009\u62e9\u60a8\u611f\u5174\u8da3\u7684\u533a\u57df</strong>\u3002\u6216\u8005\u4fdd\u6301\u9ed8\u8ba4\u7684\u5168\u7403\u89c6\u56fe\uff0c\u6216\u8005\u9009\u62e9\u4f60\u60f3\u67e5\u770b\u5176\u68ee\u6797\u7edf\u8ba1\u6570\u636e\u7684\u56fd\u5bb6\u3002\u9009\u62e9\u56fd\u5bb6\u540e\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u4e00\u4e2a\u5730\u65b9\u533a\u57df\u3002 <a href=\"{{0}}\">\u5728\u6b64</a>\u8be6\u7ec6\u4e86\u89e3\u5173\u4e8e\u5728\u4eea\u8868\u677f\u4e0a\u67e5\u770b\u5168\u7403\u3001\u56fd\u5bb6\u548c\u5730\u65b9\u68ee\u6797\u7edf\u8ba1\u6570\u636e\u7684\u4fe1\u606f\u3002", "2493958fc9284c03deb5b4e5387a4857": "\u4ee5\u4e0b\u60a8\u5c06\u4e86\u89e3\u5230\u54ea\u4e9b\u6570\u636e\u5c42\u4e0e\u5206\u6790\u5de5\u5177\u517c\u5bb9\uff0c\u4ee5\u53ca\u5982\u4f55\u8fd0\u884c\u5206\u6790\u4e00\u4e2a\u56fd\u5bb6\u6216\u5730\u65b9\u3001\u5982\u4f55\u5206\u6790\u201c\u611f\u5174\u8da3\u7684\u533a\u57df\u201d\u80cc\u666f\u56fe\u5c42\u548c\u5982\u4f55\u5206\u6790\u5730\u56fe\u4e0a\u7684\u81ea\u5b9a\u4e49\u533a\u57df\u3002", "dae7a337a8655e70f9783852924eda44": "\u9009\u62e9\u4e86 Landsat \u57fa\u56fe\uff0c\u53ef\u63d0\u4f9b Landsat \u536b\u661f\u56fe\u50cf\u7684\u80cc\u666f\u3002", "6a26f548831e6a8c26bfbbd9f6ec61e0": "\u5e2e\u52a9", "b242a12fab3d6398e4f50f6eadc7fb29": "<strong>\u6dfb\u52a0\u548c\u5220\u9664\u6570\u636e\u5c42\u7279\u5b9a\u4fe1\u606f\u3002</strong>\u67d0\u4e9b\u6570\u636e\u5c42\u53ef\u80fd\u6709\u989d\u5916\u7684\u7ec4\u4ef6\uff0c\u60a8\u53ef\u4ee5\u7528\u6fc0\u6d3b\u6570\u636e\u5c42\u672c\u8eab\u7684\u76f8\u540c\u65b9\u5f0f\u6fc0\u6d3b\u8fd9\u4e9b\u7ec4\u4ef6\u3002\u8fd9\u4e9b\u7ec4\u4ef6\u53ef\u4ee5\u5728\u56fe\u4f8b\u4e0a\u7684\u6570\u636e\u5c42\u4e0b\u65b9\u627e\u5230\u3002", "253a967769db44856c04380e528f6580": "\u70b9\u51fb\u201c\u57fa\u56fe\u201d\u6216\u201c\u80cc\u666f\u56fe\u5c42\u201d\u4ee5\u8bbf\u95ee\u76f8\u5e94\u7684\u529f\u80fd\u3002", "d2447aff02e279c2dc7bc77809a0b538": "\u5728\u5bfc\u822a\u81f3\u8be5\u5730\u70b9\u7684\u540c\u65f6\uff0c\u5f00\u59cb\u56fe\u6807\u5f00\u59cb\u8ddf\u8e2a\u60a8\u7684\u8def\u7ebf\u3002\u8def\u7ebf\u8ddf\u8e2a\u529f\u80fd\u5f88\u6709\u7528\uff0c\u56e0\u4e3a\u5b83\u53ef\u4ee5\u628a\u62b5\u8fbe\u76ee\u7684\u5730\u7684\u8def\u5f84\u4fdd\u5b58\u4e0b\u6765\uff0c\u4f9b\u4ee5\u540e\u91cd\u8bbf\u8be5\u5730\u65f6\u53c2\u8003\u3002", "bb681d54ea30ed855e7f03af1f833184": "\u9009\u62e9\u540e\uff0c\u5e94\u7528\u5185\u5bb9\u5c06\u88ab\u81ea\u52a8\u5bfc\u5165\uff0c\u6536\u4ef6\u4eba\u5c06\u8fd4\u56de\u9996\u9875\u3002\u6570\u636e\u6210\u529f\u5bfc\u5165\u540e\uff0c\u4f1a\u51fa\u73b0\u4e00\u6761\u7eff\u8272\u7684\u786e\u8ba4\u4fe1\u606f\u544a\u77e5\u4ed6\u4eec\u3002\u8fd9\u65f6\u5019\uff0c\u65e0\u8bba\u662f\u5426\u8054\u7f51\uff0c\u4ed6\u4eec\u90fd\u53ef\u4ee5\u8bbf\u95ee\u5206\u4eab\u7684\u6240\u6709\u5e94\u7528\u5185\u5bb9\u3002", "e595d71295a0e0bca9772ad0418dfce5": "\u4e00\u65e6\u60a8\u9009\u62e9\u4e86\u4e00\u4e2a\u611f\u5174\u8da3\u7684\u533a\u57df\uff0c\u60a8\u53ef\u4ee5\u5728\u201c\u6458\u8981\u201d\u4e0b\u67e5\u770b\u8be5\u533a\u57df\u7684\u68ee\u6797\u7edf\u8ba1\u6570\u636e\u6458\u8981\uff1b\u6216\u8005\u60a8\u53ef\u4ee5\u9009\u62e9\u4e00\u4e2a\u7c7b\u522b\uff0c\u67e5\u770b\u66f4\u591a\u4e0e\u571f\u5730\u8986\u76d6\u3001\u68ee\u6797\u53d8\u5316\u3001\u571f\u5730\u4f7f\u7528\u3001\u706b\u707e\u6216\u6c14\u5019\u76f8\u5173\u7684\u7edf\u8ba1\u6570\u636e\u3002\u5e76\u975e\u6240\u6709\u533a\u57df\u7684\u6240\u6709\u6570\u636e\u7c7b\u522b\u90fd\u4f1a\u4e88\u4ee5\u663e\u793a\u2014\u2014\u4eea\u8868\u677f\u9875\u9762\u53ea\u663e\u793a\u5305\u542b\u6240\u9009\u533a\u57df\u6570\u636e\u7684\u7c7b\u522b\u3002", "91bdb56ce7ef86bca055ac4eb93af83e": "\u5173\u95ed\u60a8\u7684\u56fe\u5f62\uff0c\u7136\u540e\u7ed9\u60a8\u7684\u533a\u57df\u547d\u540d\u5e76\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u3002", "050461cf546e9e331d4fceb248388b9e": "\u5411\u4e0b\u6eda\u52a8\u67e5\u770b\u6240\u9009\u533a\u57df\u7684\u68ee\u6797\u7edf\u8ba1\u6570\u636e\u56fe\u8868\u3002", "7a629b76e6ddd3156f9e2d31dbe8dccd": "\u5728\u8fd9\u4e2a\u9875\u9762\u4e0a\uff0c\u60a8\u6709\u66f4\u591a\u7684\u9009\u9879\u53ef\u4f9b\u7ba1\u7406\u60a8\u4fdd\u5b58\u7684\u611f\u5174\u8da3\u533a\u57df\u3002\u60a8\u53ef\u4ee5\u6309\u6307\u5b9a\u6807\u7b7e\u6216\u521b\u5efa\u65e5\u671f\u6765\u5bf9\u8fd9\u4e9b\u533a\u57df\u52a0\u4ee5\u7ec4\u7ec7\uff0c\u6216\u641c\u7d22\u5173\u952e\u8bcd\u6765\u5feb\u901f\u627e\u5230\u4e00\u4e2a\u533a\u57df\u3002\u60a8\u8fd8\u53ef\u4ee5\u5feb\u901f\u67e5\u770b\u6700\u8fd1\u4e00\u5468\u7684 GLAD \u6bc1\u6797\u548c VIIRS \u706b\u707e\u8b66\u62a5\u3002\u5728\u6bcf\u4e2a\u611f\u5174\u8da3\u7684\u533a\u57df\u53f3\u4fa7\uff0c\u60a8\u4f1a\u6ce8\u610f\u5230\u201c\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u201d\u3001\u201c\u7f16\u8f91\u201d\u548c\u201c\u5206\u4eab\u201d\u56fe\u6807\u3002\u201c\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u201d\u5c06\u5e26\u60a8\u524d\u5f80\u5730\u56fe\u4e0a\u7684\u8be5\u533a\u57df\uff1b\u201c\u7f16\u8f91\u201d\u5c06\u5e26\u60a8\u524d\u5f80\u201c\u7f16\u8f91\u611f\u5174\u8da3\u7684\u533a\u57df\u201d\u8868\u683c\uff0c\u5728\u6b64\u60a8\u53ef\u4ee5\u5bf9\u8be5\u533a\u57df\u8fdb\u884c\u66f4\u6539\uff1b\u201c\u5206\u4eab\u201d\u5c06\u751f\u6210\u4e00\u4e2a\u552f\u4e00\u94fe\u63a5\u4f9b\u60a8\u4e0e\u4ed6\u4eba\u5206\u4eab\u60a8\u7684\u533a\u57df\u3002\u60a8\u8fd8\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u8be5\u533a\u57df\u7684\u56fe\u50cf\u6765\u6253\u5f00\u8be5\u533a\u57df\u7684\u4eea\u8868\u677f\uff1b<a href=\"{{0}}\">\u5728\u6b64</a>\u8be6\u7ec6\u4e86\u89e3\u5173\u4e8e\u5728\u4eea\u8868\u677f\u4e0a\u67e5\u770b\u67d0\u81ea\u5b9a\u4e49\u533a\u57df\u68ee\u6797\u7edf\u8ba1\u6570\u636e\u7684\u4fe1\u606f\u3002", "033569ff90f18b85b44d18d06fe1e721": "\u8fd9\u4e2a\u6d41\u7a0b\u5bf9\u4e8e\u5730\u65b9\u533a\u57df\u6765\u8bf4\u662f\u4e00\u6837\u7684\u3002\u53ea\u9700\u653e\u5927\u5e76\u70b9\u51fb\u611f\u5174\u8da3\u533a\u57df\u7684\u8fb9\u754c\uff0c\u6216\u4f7f\u7528\u641c\u7d22\u5de5\u5177\u67e5\u627e\u8be5\u5730\u533a\u3002\u5728\u4e0b\u9762\u7b2c\u4e8c\u4e2a\u4f8b\u5b50\u4e2d\uff0c\u9009\u62e9\u4e86\u5df4\u897f\u7684\u9a6c\u6258\u683c\u7f57\u7d22\u3002", "3e5c41403a98a98a221e41a5e9eb07c7": "GFW \u4e0a\u7684\u641c\u7d22\u5de5\u5177\u63d0\u4f9b\u4e86\u4e00\u79cd\u5feb\u901f\u67e5\u627e\u5730\u56fe\u533a\u57df\u3001\u4f4d\u7f6e\u6216\u6570\u636e\u5c42\u7684\u7b80\u4fbf\u65b9\u6cd5\u3002", "7a27d8aefa5a63bf705c3a8a3fb64158": "\u9996\u5148\uff0c\u5bfc\u822a\u5230\u8bbe\u5907\u4e0a\u7684\u6587\u4ef6\u4f4d\u7f6e\u3002\u70b9\u51fb\u5e76\u6309\u4f4f\u6587\u4ef6\uff0c\u76f4\u5230\u5f39\u51fa\u4e00\u4e2a\u9009\u9879\u83dc\u5355\u3002\u5728\u8fd9\u4e2a\u4f8b\u5b50\u4e2d\uff0c\u5728 iOS \u8bbe\u5907\u4e0a\u521b\u5efa\u4e86\u4e00\u4e2a\u6307\u5b9a\u7684 \u201cForest Watcher\u201d \u6587\u4ef6\u5939\u6765\u4fdd\u5b58\u6587\u4ef6\u3002", "882e5beaf50230209960127c50a32526": "\u8981\u6dfb\u52a0 GFW \u56fe\u5c42\uff0c\u8bf7\u70b9\u51fb\u201c\u6dfb\u52a0 Global Forest Watch \u56fe\u5c42\u201d\u3002\u5728\u8fd9\u91cc\uff0c\u60a8\u53ef\u4ee5\u6eda\u52a8\u6d4f\u89c8 GFW \u63d0\u4f9b\u7684\u5176\u4ed6\u80cc\u666f\u56fe\u5c42\u3002", "a5fea0bba0ad49c2d2dc86f57f3cd091": "<a href=\"{{0}}\">\u5728\u6b64</a>\u8be6\u7ec6\u4e86\u89e3\u5173\u4e8e\u4e0e\u5176\u4ed6\u8bbe\u5907\u5206\u4eab\u81ea\u5b9a\u4e49\u57fa\u56fe\u548c\u80cc\u666f\u56fe\u5c42\u7684\u4fe1\u606f\u3002", "dc9a6d1eeac7af8a8aa159f1c9681539": "\u9009\u62e9\u201c\u6570\u636e\u96c6\u201d\u641c\u7d22\uff0c\u8f93\u5165\u60a8\u611f\u5174\u8da3\u7684\u6570\u636e\u5c42\u540d\u79f0\u6216\u4e0e\u6570\u636e\u76f8\u5173\u7684\u8bcd\u8bed\u3002\u8f93\u5165\u540e\uff0c\u7a97\u53e3\u5c06\u81ea\u52a8\u5f39\u51fa\u6240\u6709\u76f8\u5173\u6570\u636e\u5c42\u3002", "e021d493343b878adbcd4d23c8f7b39f": "\u63a2\u7d22\u7f51\u7edc\u7814\u8ba8\u4f1a\uff0c\u4e86\u89e3\u5982\u4f55\u4f7f\u7528 MapBuilder \u521b\u5efa\u81ea\u5b9a\u4e49\u76d1\u63a7\u5e94\u7528\u3002", "509e0d31e11f5977dafc9f9865e28eb5": "\u5982\u679c\u60a8\u6709\u591a\u4e2a\u5df2\u4fdd\u5b58\u7684\u533a\u57df\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u5305\u542b\u60a8\u6b63\u5728\u67e5\u770b\u7684\u533a\u57df\u540d\u79f0\u7684\u4e0b\u62c9\u83dc\u5355\u6765\u8bbf\u95ee\u5b83\u4eec\u3002\u9009\u62e9\u4e0d\u540c\u533a\u57df\u7684\u540d\u79f0\u5c06\u4ea7\u751f\u4e00\u4e2a\u5305\u542b\u8be5\u533a\u57df\u68ee\u6797\u7edf\u8ba1\u6570\u636e\u7684\u4eea\u8868\u677f\u3002", "45a76ef0cec46c2ed73fae19add9a7ec": "\u6240\u6709\u5bfc\u5165\u7684\u6570\u636e\u73b0\u5728\u90fd\u53ef\u4ee5\u4f7f\u7528\u3002", "6e582e90c144e7cd2bd7e5468949e447": "\u5bfc\u822a\u5230\u8bbe\u7f6e\u9875\u9762\uff0c\u8bbe\u7f6e\u3001\u67e5\u770b\u548c\u7f16\u8f91\u60a8\u7684\u56e2\u961f\u3002\u56e2\u961f\u53ef\u4ee5\u7531\u4efb\u4f55\u62e5\u6709 MyGFW \u8d26\u6237\u7684\u56e2\u961f\u6210\u5458\u7ec4\u6210\uff0c\u5e76\u4e14\u60a8\u53ef\u4ee5\u5c06\u4fdd\u5b58\u5728\u81ea\u5df1\u8d26\u6237\u4e2d\u7684\u4efb\u4f55\u611f\u5174\u8da3\u7684\u533a\u57df\u5206\u914d\u7ed9\u4ed6\u4eec\u3002\u5982\u679c\u60a8\u5df2\u7ecf\u5efa\u7acb\u4e86\u56e2\u961f\uff0c\u53ef\u4ee5\u70b9\u51fb\u53f3\u4e0a\u65b9\u7684\u201c\u7f16\u8f91\u201d\u5bf9\u5176\u8fdb\u884c\u7f16\u8f91\u3002", "0eadf66db751e5453e08eed7f7204973": "\u8f93\u5165\u60a8\u7684\u95ee\u9898\u5e76\u9009\u62e9\u60a8\u9996\u9009\u7684\u95ee\u9898\u683c\u5f0f\u3002", "d8eee45611fe9fa7624f7ca6420719ae": "\u5728\u90a3\u91cc\uff0c\u60a8\u4f1a\u770b\u5230\u4e24\u4e2a\u9009\u9879\uff1a\u201c\u70b9\u51fb\u5730\u56fe\u4e0a\u7684\u4e00\u4e2a\u56fe\u5c42\u201d\u548c\u201c\u7ed8\u5236\u6216\u4e0a\u4f20\u56fe\u5f62\u201d\u3002\u9009\u62e9\u201c\u70b9\u51fb\u5730\u56fe\u4e0a\u7684\u4e00\u4e2a\u56fe\u5c42\u201d\u9009\u9879\uff0c\u7136\u540e\u70b9\u51fb\u60a8\u8981\u5206\u6790\u7684\u5730\u56fe\u56fe\u5c42\u3002\u7f29\u5c0f\u53ef\u4ee5\u8ba9\u60a8\u9009\u62e9\u6574\u4e2a\u56fd\u5bb6\uff0c\u800c\u653e\u5927\u53ef\u4ee5\u8ba9\u60a8\u9009\u62e9\u5730\u65b9\u8fb9\u754c\u3002\u60a8\u8fd8\u53ef\u4ee5\u4f7f\u7528\u5de6\u4e0b\u89d2\u7684\u641c\u7d22\u5de5\u5177\uff0c\u627e\u5230\u60a8\u60f3\u5206\u6790\u7684\u56fd\u5bb6\u3001\u7701\u3001\u5dde\u6216\u5730\u533a\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u8be6\u7ec6\u4e86\u89e3\u5173\u4e8e\u641c\u7d22\u67d0\u4e2a\u533a\u57df\u7684\u4fe1\u606f\u3002", "5462253a3d0c971df1307effb2cba869": "\u89c2\u770b\u897f\u73ed\u7259\u8bed\u7684\u6f14\u793a\u3002", "21dfcd42937230f9a2c5a67c2ddcb38c": "\u5728\u8fd9\u91cc\uff0c\u70b9\u51fb\u201c\u5206\u4eab\u201d\u5c06\u6587\u4ef6\u53d1\u9001\u7ed9\u5176\u4ed6\u7528\u6237\u3002", "6f5626ea980fa7c05aecdf921c52950c": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">dashboards</a>\u5e2e\u52a9\u56de\u7b54\u6709\u5173\u4efb\u4f55\u533a\u57df\u68ee\u6797\u53d8\u5316\u7684\u91cd\u8981\u95ee\u9898\uff0c\u5e76\u4f7f\u60a8\u80fd\u591f\u901a\u8fc7\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u56fe\u5f62\uff08\u90fd\u6e90\u81ea\u7a7a\u95f4\u6570\u636e\u5206\u6790\uff09\u67e5\u770b\u6570\u4ee5\u767e\u8ba1\u7684\u7edf\u8ba1\u6570\u636e\u3002\u5e76\u4e14\u53ef\u6839\u636e\u60a8\u7684\u9700\u8981\u5c06\u7edf\u8ba1\u6570\u636e\u5b9a\u5236\u4e3a\u4e00\u822c\u6216\u7279\u5b9a\u7684\u7edf\u8ba1\u6570\u636e\uff0c\u5e76\u53ef\u8f7b\u677e\u5206\u4eab\u548c\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "984ace4fd098e2edf60660d4d801f36d": "\u81ea\u5b9a\u4e49\u5730\u56fe\u4e0a\u53ef\u89c1\u7684\u62a5\u544a\u3002", "45c199982d6cd7ade16b84cc4d4f282c": "\u6fc0\u6d3b\u690d\u88ab\u5065\u5eb7\u72b6\u51b5\u56fe\u50cf\uff0c\u5e2e\u52a9\u8bc6\u522b\u53ef\u80fd\u5b58\u5728\u6797\u6728\u8986\u76d6\u7387\u635f\u5931\u95ee\u9898\u7684\u533a\u57df\u3002\u7eff\u8272\u6591\u5757\u8868\u793a\u88f8\u9732\u5730\u9762\u548c\u53ef\u80fd\u5b58\u5728\u7684\u7a7a\u5730\u3002", "86a48d595dde6d01f8de45e921ac4235": "\u60a8\u8fd8\u53ef\u4ee5\u5728\u8bbe\u7f6e\u9875\u9762\u4e0a\u70b9\u51fb\u201c\u5206\u4eab\u6240\u6709\u5e94\u7528\u6570\u636e\u201d\uff0c\u4e0e\u53e6\u4e00\u53f0\u8bbe\u5907\u5206\u4eab\u6240\u6709\u5e94\u7528\u5185\u5bb9\uff08\u533a\u57df\u3001\u80cc\u666f\u56fe\u5c42\u3001\u57fa\u56fe\u3001\u8def\u7ebf\u548c\u62a5\u544a\uff09\u3002", "8bd6f42b67c7179ed598392ba5d032f6": "\u70b9\u51fb\u9996\u9875\u7684\u201c\u62a5\u544a\u201d\u8fdb\u5165\u62a5\u544a\u9875\u9762\u3002", "940747803e8d5ee276cdc4bb519e393f": "\u5408\u4f5c\u65b9\u6750\u6599", "4c19f41caeb79e57d3a43d96d0b17168": "\u901a\u8fc7\u63a2\u7d22\u5176\u4ed6\u6750\u6599\uff0c\u5305\u62ec\u5408\u4f5c\u65b9\u5236\u4f5c\u7684\u57f9\u8bad\u6750\u6599\u548c\u5b58\u6863\u7684 GFW \u6559\u7a0b\uff0c\u5b66\u4e60\u5982\u4f55\u4f7f\u7528 MapBuilder \u6765\u6784\u5efa\u4e00\u4e2a\u81ea\u5b9a\u4e49\u7684\u76d1\u63a7\u5e94\u7528\u3002", "1c359aaaa34836f8430a2169212fadca": "\u7ed9\u60a8\u611f\u5174\u8da3\u7684\u533a\u57df\u547d\u540d\u3002", "11c45b302fda80008aba22cfe7581553": "\u6587\u4ef6\u53d1\u9001\u540e\uff0c\u6536\u4ef6\u4eba\u5e94\u9009\u62e9\u5728 Forest Watcher \u4e2d\u6253\u5f00\u6587\u4ef6\u3002\u5728 iOS \u8bbe\u5907\u4e0a\uff0c\u9009\u62e9\u201c\u590d\u5236\u5230  Forest Watcher\u201d\u3002", "8546390b76a8abf7c431d11b0fe94154": "\u70b9\u51fb\u201c\u4e0b\u8f7d\u201d\u4e0b\u62c9\u83dc\u5355\uff0c\u9009\u62e9\u60a8\u7684\u9996\u9009\u683c\u5f0f\u3002", "80b165b7b6fe83cd137dc44a3c696e5e": "\u70b9\u51fb\u9876\u90e8\u83dc\u5355\u4e0a\u7684\u201c\u62a5\u544a\u201d\uff0c\u5bfc\u822a\u5230\u62a5\u544a\u7f51\u9875\uff0c\u67e5\u770b\u56e2\u961f\u7684\u62a5\u544a\u3002\u62a5\u544a\u7531\u56e2\u961f\u6210\u5458\u586b\u5199\u5e76\u63d0\u4ea4\uff0c\u5305\u62ec\u4ed6\u4eec\u5728\u73b0\u573a\u53d1\u73b0\u7684\u4fe1\u606f\u3002\u60a8\u53ef\u4ee5\u6309\u533a\u57df\u3001\u65e5\u671f\u6216\u6a21\u677f\u5bf9\u62a5\u544a\u8fdb\u884c\u7b5b\u9009\uff0c\u4e5f\u53ef\u4ee5\u641c\u7d22\u62a5\u544a\u3002", "4f4530c316acb00cd26553246e6f30b9": "\u8981\u4fdd\u5b58\u81ea\u5b9a\u4e49\u533a\u57df\uff0c\u53ef\u4ee5\u4f7f\u7528\u5206\u6790\u5de5\u5177\u7ed8\u5236\u6216\u4e0a\u4f20\u4e00\u4e2a\u56fe\u5f62\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u8be6\u7ec6\u4e86\u89e3\u5173\u4e8e\u5206\u6790\u5730\u56fe\u4e0a\u81ea\u5b9a\u4e49\u533a\u57df\u7684\u4fe1\u606f\u3002\u5728\u4e0b\u9762\u7684\u7b2c\u4e09\u4e2a\u4f8b\u5b50\u4e2d\uff0c\u5df2\u7ecf\u5728\u5580\u9ea6\u9686\u90a3\u5757\u521b\u5efa\u4e86\u4e00\u4e2a\u81ea\u5b9a\u4e49\u56fe\u5f62\u3002", "9392d43be7a0f909099a866c4f07adbe": "Open Data Portal \u5141\u8bb8\u7528\u6237\u4e0b\u8f7d GFW \u4e0a\u7684\u6570\u636e\u5b50\u96c6\u3002\u60a8\u53ef\u4ee5\u901a\u8fc7\u4e0a\u8ff0\u65b9\u6cd5\u6216\u76f4\u63a5\u8fdb\u5165 <a aria-label=\"undefined (opens in a new tab)\" href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">data.globalforestwatch.org</a> \u8bbf\u95ee\u8be5\u7f51\u9875\u3002", "03bea06384c321d35e6a3f3a550eac08": "\u56de\u7b54\u5b8c\u4e00\u7cfb\u5217\u95ee\u9898\u540e\uff0c\u70b9\u51fb \u201c\u53d1\u9001\u201d\u5c06\u62a5\u544a\u4fdd\u5b58\u81f3\u60a8\u7684\u8bbe\u5907\u3002", "4348bb57f5619bbed989f76e7f3f1e50": "\u62a5\u544a\u56fe\u6807\u5141\u8bb8\u60a8\u5728\u5bfc\u822a\u5230\u67d0\u4e2a\u533a\u57df\u7684\u8fc7\u7a0b\u4e2d\u6216\u5230\u8fbe\u60a8\u7684\u76ee\u7684\u5730\u65f6\u8bb0\u5f55\u4efb\u4f55\u53d1\u73b0\u3002\u5982\u679c\u60a8\u5728\u524d\u5f80\u76ee\u7684\u5730\u7684\u9014\u4e2d\u6ce8\u610f\u5230\u68ee\u6797\u780d\u4f10\u6216\u5176\u4ed6\u5a01\u80c1\uff0c\u800c\u8fd9\u4e9b\u5a01\u80c1\u5e76\u6ca1\u6709\u4ee5\u8b66\u62a5\u5f62\u5f0f\u6807\u660e\uff0c\u60a8\u53ef\u4ee5\u5728\u8be5\u5730\u70b9\u8bbe\u7f6e\u4e00\u679a\u56fe\u9489\u5e76\u521b\u5efa\u4e00\u4efd\u62a5\u544a\u3002", "ee467608a8239e2a76d1198ad40e7956": "\u53ef\u7528\u7684\u57fa\u56fe", "86f99d59d49bf0aed2b54e095d321411": "\u4e3a\u4e86\u8fdb\u4e00\u6b65\u8c03\u67e5\uff0c\u9009\u62e9\u4e86\u8fc7\u53bb\u56db\u5468\u5185\u7684\u8fd1\u671f\u536b\u661f\u56fe\u50cf\u3002\u964d\u4f4e\u4e86\u6700\u5927\u4e91\u5c42\u8986\u76d6\u7387\uff0c\u5e76\u4e3a\u56fe\u50cf\u9009\u62e9\u4e86\u201c\u81ea\u7136\u8272\u201d\u3002\u8fd9\u5c06\u5e2e\u52a9\u60a8\u5f00\u59cb\u7740\u624b\u9a8c\u8bc1\u8b66\u62a5\u662f\u5426\u6307\u793a\u4efb\u4f55\u7a7a\u5730\u3002", "a6e345fdb0b2ccfb6bcad38b6d41f6fc": "\u70b9\u51fb\u201c\u80cc\u666f\u56fe\u5c42\u201d\u65c1\u8fb9\u7684\u5706\u5708\uff0c\u6fc0\u6d3b\u60a8\u5728\u5730\u56fe\u4e0a\u9009\u62e9\u7684\u56fe\u5c42\u3002", "87259f6c901830b5c9d6750da8bc2477": "\u81ea\u5b9a\u4e49\u5730\u56fe\u4e0a\u53ef\u89c1\u7684\u8b66\u62a5\u3002", "397e2044749869d78973cc4860996401": "\u9664\u4e86\u5728\u5730\u56fe\u4e0a\u53ef\u89c6\u5316\u6570\u636e\u5c42\u5916\uff0cGFW \u8fd8\u63d0\u4f9b\u4e86\u901a\u8fc7\u4eea\u8868\u677f\u4e0a\u7684\u4ea4\u4e92\u5f0f\u548c\u53ef\u5b9a\u5236\u7684\u6570\u636e\u56fe\u8868\u6765\u63a2\u7d22\u68ee\u6797\u7edf\u8ba1\u6570\u636e\u7684\u80fd\u529b\u3002\u4ee5\u4e0b\u662f\u60a8\u5982\u4f55\u67e5\u770b\u548c\u5b9a\u5236\u8fd9\u4e9b\u6570\u636e\u7684\u6b65\u9aa4\u3002", "3f9da569989021260d25f998bf38a444": "\u70b9\u51fb\u6570\u636e\u56fe\u8868\u53f3\u4e0a\u65b9\u7684\u4fe1\u606f \"i \" \u56fe\u6807\uff0c\u53ef\u4ee5\u4e86\u89e3\u5173\u4e8e\u65b9\u6cd5\u3001\u6765\u6e90\u3001\u8986\u76d6\u65e5\u671f\u7b49\u66f4\u591a\u4fe1\u606f\u3002", "6af85ac5a968be00881e28e748d67732": "<strong>\u8bbf\u95ee\u8fd1\u671f\u536b\u661f\u56fe\u50cf</strong>\u3002\u8fd1\u671f\u536b\u661f\u56fe\u50cf\u63d0\u4f9b\u6709\u5173\u4e16\u754c\u5404\u5730\u690d\u88ab\u5065\u5eb7\u72b6\u51b5\u7684\u4fe1\u606f\uff0c\u5f80\u5f80\u6709\u52a9\u4e8e\u9a8c\u8bc1\u8fd1\u5b9e\u65f6\u6bc1\u6797\u548c\u706b\u707e\u8b66\u62a5\u3002\u63d0\u4f9b\u6765\u81ea Sentinel-2 \u548c Landsat 8 \u7684\u536b\u661f\u56fe\u50cf\uff0c\u6bcf\u5929\u90fd\u6709\u65b0\u7684\u56fe\u50cf\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u8be6\u7ec6\u4e86\u89e3\u5173\u4e8e\u4f7f\u7528\u8fd1\u671f\u536b\u661f\u56fe\u50cf\u8c03\u67e5\u68ee\u6797\u53d8\u5316\u7684\u4fe1\u606f\u3002", "f8e84d8def280fe0e8cc1812a4a1880c": "\u5728\u6bcf\u4e2a\u7c7b\u522b\u4e0b\uff0c\u60a8\u4f1a\u770b\u5230\u663e\u793a\u68ee\u6797\u7edf\u8ba1\u6570\u636e\u7684\u4ea4\u4e92\u5f0f\u6570\u636e\u56fe\u8868\u3002\u6bcf\u4e2a\u56fe\u8868\u90fd\u5305\u542b\u4e86\u60a8\u6240\u9009\u533a\u57df\u5185\u53ef\u7528\u7684\u6570\u636e\u56fe\u793a\u3002", "0961bf1832b469536ec41f5b64cd83a9": "\u901a\u8fc7\u201c+ \u6dfb\u52a0\u56fd\u5bb6\u201d\u4e0b\u62c9\u83dc\u5355\u53ef\u4ee5\u8bbf\u95ee\u7279\u5b9a\u56fd\u5bb6\u7684\u6570\u636e\u3002", "1de44e27d7201770e8abbf0e65052b9c": "Forest Watcher \u73b0\u573a\u624b\u518c\u7f16\u5199\u4e8e 2019 \u5e74 11 \u6708\uff0c\u65e8\u5728\u6f14\u793a\u5982\u4f55\u5229\u7528 Forest Watcher \u79fb\u52a8\u5e94\u7528\u5728\u7ebf\u4e0b\u548c\u73b0\u573a\u76d1\u6d4b\u6797\u533a\u3002\u8be5\u73b0\u573a\u624b\u518c\u6709\u82f1\u6587\u3001\u897f\u73ed\u7259\u6587\u3001\u8461\u8404\u7259\u6587\u3001\u6cd5\u6587\u3001\u5370\u5c3c\u6587\u548c\u8377\u5170\u6587\u7248\u672c\u3002", "4802ef544435b5391962c22bc61ce18e": "\u70b9\u51fb\u4e0b\u62c9\u83dc\u5355\uff0c\u9009\u62e9\u6216\u641c\u7d22\u60a8\u611f\u5174\u8da3\u7684\u56fd\u5bb6\u3002", "c019181958d29049fdd2d2e2c24c06ce": "\u8f93\u5165\u57fa\u56fe\u7684\u540d\u79f0\uff0c\u7136\u540e\u70b9\u51fb\u201c\u5bfc\u5165\u57fa\u56fe\u201d\u3002", "617be136a9e4be8ead96ab14ede0e8ed": "\u4ece\u8fd9\u91cc\uff0c\u60a8\u4f1a\u88ab\u63d0\u793a\u9009\u62e9\u60a8\u7684\u6587\u4ef6\u3002\u4ece\u60a8\u7684\u8bbe\u5907\u4e2d\u9009\u62e9\u6587\u4ef6\uff0c\u60a8\u4f1a\u88ab\u5b9a\u5411\u5230\u4e00\u4e2a\u65b0\u7684\u9875\u9762\uff0c\u5728\u8fd9\u91cc\u60a8\u53ef\u4ee5\u4e3a\u80cc\u666f\u56fe\u5c42\u547d\u540d\u3002\u5728\u7ed9\u60a8\u7684\u80cc\u666f\u56fe\u5c42\u547d\u540d\u540e\uff0c\u70b9\u51fb\u5c4f\u5e55\u5e95\u90e8\u7684\u201c\u5bfc\u5165\u56fe\u5c42\u201d\u3002", "2ffa86f56e2f18bb164d99e168de5fed": "\u5728\u641c\u7d22\u680f\u4e2d\u8f93\u5165\u6570\u636e\u5c42\u7684\u540d\u79f0\u6216\u76f8\u5173\u672f\u8bed\u6765\u641c\u7d22\u6570\u636e\u5c42\u3002", "09fc91f0c6fefb1c8207de9cfaa9ac44": "\u82e5\u8981\u5f00\u59cb\uff0c\u8bf7\u70b9\u51fb\u83dc\u5355\u4e0a\u7684\u201c\u641c\u7d22\u201d\u7c7b\u522b\u3002\u4ece\u8fd9\u91cc\uff0c\u60a8\u5c06\u6709\u51e0\u4e2a\u9009\u9879\u53ef\u4f9b\u641c\u7d22\u611f\u5174\u8da3\u7684\u533a\u57df\uff1a\u4f4d\u7f6e\u3001\u6570\u636e\u96c6\u3001\u5750\u6807\u3001\u5341\u8fdb\u5236\u5ea6\u548c UTM \u5750\u6807\u3002", "f0d6fb4c2f9d9a185a6bfac9f16d9b5b": "\u5728 GFW \u7684\u53ef\u7528\u80cc\u666f\u56fe\u5c42\u4e2d\u6eda\u52a8\uff0c\u7136\u540e\u70b9\u51fb\u60a8\u60f3\u6dfb\u52a0\u7684\u56fe\u5c42\u3002", "27ae07f3155341e669ed983715eb0698": "\u4e0a\u4f20 GFW \u56fe\u5c42", "72b48f15561d44f9ea86382276d5d050": "\u8c03\u67e5<em>\uff08\u6570\u636e\u5c42\u8868\u793a\u67d0\u79cd\u6d4b\u91cf\u7ed3\u679c\uff0c\u53ef\u6fc0\u6d3b\u5b83\u4ee5\u63d0\u4f9b\u533a\u57df\u5185\u7684\u53d8\u5316\u4fe1\u606f\u2014\u2014\u5c06\u51fa\u73b0\u5728\u5206\u6790\u5c0f\u7ec4\u4ef6\u4e2d\uff09</em>", "63b911d458981c6cb6bb9221eb9dd4f4": "\u70b9\u51fb\u201c\u4e0b\u8f7d\u6570\u636e\u201d\u8bbf\u95ee\u7f51\u9875\uff0c\u5728\u6b64\u60a8\u53ef\u4ee5\u4e0b\u8f7d\u6797\u6728\u8986\u76d6\u7387\u635f\u5931\u6570\u636e\u3002", "0e2654549989a9460b55276d8a9a6836": "\u4ece\u8fd9\u91cc\uff0c\u60a8\u53ef\u4ee5\u7740\u624b\u5f00\u59cb\u91c7\u53d6\u5fc5\u8981\u7684\u63aa\u65bd\u8fdb\u884c\u5b9e\u5730\u8c03\u67e5\u5e76\u91c7\u53d6\u9002\u5f53\u7684\u884c\u52a8\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u8be6\u7ec6\u4e86\u89e3 Forest Watcher \u79fb\u52a8\u5e94\u7528\u5982\u4f55\u80fd\u591f\u5e2e\u52a9\u60a8\u79bb\u7ebf\u548c\u5b9e\u5730\u8c03\u67e5\u68ee\u6797\u53d8\u5316\u3002", "a9a4af4047d29a3fa055b38491325ca0": "\u5728\u6a21\u677f\u7f51\u9875\u4e0a\u8bbf\u95ee\u60a8\u4fdd\u5b58\u7684\u62a5\u544a\u6a21\u677f\u3002", "49703e7be95d78d4e229517a91f32838": "\u62a5\u544a\u6a21\u677f\u5b9a\u7a3f\u540e\u5c06\u5176\u53d1\u5e03\uff0c\u7136\u540e\u518d\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u3002", "993c9b08642b3d74c6fed0e1485aeda7": "\u70b9\u51fb\u94c5\u7b14\u56fe\u6807\uff0c\u4e3a\u60a8\u611f\u5174\u8da3\u7684\u533a\u57df\u8f93\u5165\u4e00\u4e2a\u540d\u79f0\uff0c\u7136\u540e\u70b9\u51fb\u201c\u5b8c\u6210\u201d\u3002", "c5bc5a6bdd8726869dcb41515623a2e3": "\u82e5\u8981\u5206\u4eab\u6574\u4e2a\u4eea\u8868\u677f\uff0c\u8bf7\u70b9\u51fb\u4eea\u8868\u677f\u53f3\u4e0a\u65b9\u7684\u5206\u4eab\u56fe\u6807\uff0c\u5373\u53ef\u751f\u6210\u552f\u4e00\u94fe\u63a5\u4f9b\u60a8\u5206\u4eab\u7ed9\u4ed6\u4eba\u3002\u82e5\u8981\u5206\u4eab\u5355\u4e2a\u56fe\u8868\uff0c\u8bf7\u70b9\u51fb\u4efb\u4f55\u6570\u636e\u56fe\u8868\u53f3\u4e0a\u65b9\u7684\u5206\u4eab\u56fe\u6807\uff0c\u5373\u53ef\u751f\u6210\u552f\u4e00\u94fe\u63a5\u4f9b\u60a8\u5206\u4eab\u7ed9\u4ed6\u4eba\uff0c\u6216\u751f\u6210 HTML \u4f9b\u60a8\u5c06\u8be5\u6570\u636e\u56fe\u8868\u5d4c\u5165\u5916\u90e8\u7f51\u7ad9\u3002", "7aa7c9bc28ba4179c52e01ea7baacd06": "\u53ef\u4ee5\u4ece\u53f3\u4e0b\u89d2\u8bbf\u95ee\u53ef\u7528\u7684\u5730\u56fe\u8bbe\u7f6e\u3002", "677ceaa3eb3eb3c3abcbe701ec948b1f": "\u76f8\u5173\u7684\u9010\u6b65\u8bf4\u660e", "c89daaee6e70eb77a650f6a986fa6e83": "\u5728\u8bbe\u5907\u4e0a\u627e\u5230\u6587\u4ef6\u540e\uff0c\u70b9\u51fb\u5e76\u6309\u4f4f\u6587\u4ef6\u4ee5\u663e\u793a\u8bbe\u5907\u7684\u9009\u9879\u83dc\u5355\u3002", "8d46e6dd4c57eb228cc2fb7c58d9329e": "MapBuilder \u53ef\u4ee5\u5e2e\u52a9\u60a8\u53ef\u89c6\u5316\u548c\u53e0\u52a0\u7a7a\u95f4\u6570\u636e\u4ece\u800c\u66f4\u597d\u5730\u4e86\u89e3\u7279\u5b9a\u5730\u65b9\u53d1\u751f\u7684\u4e8b\u60c5\uff0c\u4e00\u76ee\u4e86\u7136\u5730\u67e5\u770b\u5730\u56fe\u7279\u5f81\u2014\u2014\u6570\u636e\u3001\u5206\u6790\u7279\u5f81\u3001\u536b\u661f\u56fe\u50cf\u548c\u57fa\u56fe\u2014\u2014\u4fe1\u606f\u5e76\u8fdb\u884c\u5373\u65f6\u5206\u6790\uff0c\u4ee5\u67e5\u770b\u6570\u636e\u5982\u4f55\u968f\u65f6\u95f4\u53d8\u5316\u7684\u7edf\u8ba1\u6570\u636e\u3002\u5728 MapBuilder \u5e94\u7528\u4e0a\u521b\u5efa\u7684\u533a\u57df\u4e5f\u5c06\u4e0e GFW \u4e3b\u5e73\u53f0\u4e0a\u7684 <a rel=\"noreferrer noopener\" href=\"{{0}}\" target=\"_blank\">MyGFW</a> \u533a\u57df\u8ba2\u9605\u548c\u4eea\u8868\u677f\u540c\u6b65\u3002", "35f1beacb415239e2bbe804c919cd072": "\u5f53\u60a8\u9009\u62e9\u5b8c\u8981\u5206\u4eab\u7684\u6587\u4ef6\u540e\uff0c\u518d\u6b21\u70b9\u51fb\u201c\u5206\u4eab\u201d\u56fe\u6807\u3002\u7136\u540e\uff0c\u60a8\u5c06\u88ab\u5b9a\u5411\u81f3\u5c06\u6587\u4ef6\u4fdd\u5b58\u5728\u60a8\u7684\u8bbe\u5907\u4e0a\u3002\u91cd\u65b0\u547d\u540d\u60a8\u7684\u6587\u4ef6\u5e76\u9009\u62e9\u6240\u9700\u4f4d\u7f6e\uff0c\u7136\u540e\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u3002\u7136\u540e\u5c31\u53ef\u4ee5\u4ece\u60a8\u9009\u62e9\u7684\u4f4d\u7f6e\u8bbf\u95ee\u8be5\u6587\u4ef6\u3002", "f5cb4df05a7b2a9cb492522db83a6837": "\u70b9\u51fb\u5730\u56fe\u8bbe\u7f6e\u201c\u9ed8\u8ba4\u201d\u56fe\u6807\u4ee5\u8bbf\u95ee\u57fa\u56fe\u3002", "a933ec2d6952757e3d6667354a6ed036": "\u5206\u6790\u80cc\u666f\u56fe\u5c42", "0a1d90bce32066d96b7a207ca71abb72": "\u70b9\u51fb\u4eea\u8868\u677f\u9876\u90e8\u7684\u4e0b\u8f7d\u56fe\u6807\uff0c\u4e0b\u8f7d\u5173\u4e8e\u6797\u6728\u8986\u76d6\u8303\u56f4\u3001\u589e\u76ca\u548c\u5e74\u5ea6\u635f\u5931\u3001\u4e8c\u6c27\u5316\u78b3\u6392\u653e\u91cf\u548c\u751f\u7269\u91cf\u635f\u5931\u7684\u4e00\u822c\u7edf\u8ba1\u6570\u636e\uff08\u4ec5\u5728\u5168\u7403\u3001\u56fd\u5bb6\u548c\u5730\u65b9\u4eea\u8868\u677f\u4e2d\u63d0\u4f9b\uff09\u3002", "c7d869d8f126e083f9a7f5199062eb2f": "\u9009\u62e9\u201c\u6cb3\u6d41\u6d41\u57df\u201d\uff0c\u6839\u636e MapBox \u6570\u636e\u663e\u793a\u5168\u7403\u6cb3\u6d41\u6d41\u57df\u3002", "7e88b1a1e06788b6b8fe598dfd05024d": "\u8ba2\u9605\u4ee5\u63a5\u6536\u6709\u5173\u60a8\u611f\u5174\u8da3\u7684\u533a\u57df\u7684\u6bc1\u6797\u548c/\u6216\u706b\u707e\u8b66\u62a5\u901a\u77e5\u3002", "ac128ee48cb0a61fa93cd19c8f90525d": "\u8981\u901a\u8fc7 Open Data Portal \u9996\u9875\u8bbf\u95ee\u6570\u636e\u5c42\uff0c\u60a8\u9700\u8981\u5728\u641c\u7d22\u680f\u4e2d\u8f93\u5165\u6570\u636e\u5c42\u7684\u540d\u79f0\u3002\u60a8\u4e0d\u9700\u8981\u77e5\u9053\u786e\u5207\u7684\u540d\u79f0\uff0c\u641c\u7d22\u529f\u80fd\u53ef\u4ee5\u8bc6\u522b\u5173\u952e\u8bcd\u3002", "2486d086fc446c6a672b613f7cd3bc6b": "\u70b9\u51fb\u201c\u7ba1\u7406\u80cc\u666f\u56fe\u5c42\u201d\uff0c\u4e0b\u8f7d\u3001\u5206\u4eab\u548c\u4e0a\u4f20\u80cc\u666f\u56fe\u5c42\u3002", "1c9e08158bb5408443a3de9444b726e1": "\u5176\u4ed6\u6750\u6599", "230da3dfeb91ae9132fe1ba139b98c1d": "\u82e5\u8981\u4e0b\u8f7d\u6570\u636e\uff0c\u8bf7\u70b9\u51fb\u201c\u4e0b\u8f7d\u201d\u3002\u89c6\u6570\u636e\u5c42\u60c5\u51b5\uff0c\u60a8\u5c06\u80fd\u9009\u62e9\u4ee5\u7279\u5b9a\u7684\u683c\u5f0f\u4e0b\u8f7d\u6570\u636e\u3002", "13b624fb5e6af20d2d4583acfac0ec77": "Sentinel-2 \u536b\u661f\u56fe\u50cf\u8986\u76d6\u5370\u5ea6\u5c3c\u897f\u4e9a\u4e00\u5904\u6797\u6728\u8986\u76d6\u7387\u53d1\u751f\u4e0b\u964d\u7684\u6cb9\u68d5\u7279\u8bb8\u533a\u3002\u5df2\u8c03\u4f4e\u4e86\u4e24\u4e2a\u6570\u636e\u5c42\u7684\u4e0d\u900f\u660e\u5ea6\uff0c\u4ee5\u4fbf\u80fd\u770b\u5f97\u66f4\u6e05\u695a\u3002", "d41ba6d283f8fa22b6612ec03c9c3e22": "<strong>\u63a2\u7d22\u68ee\u6797\u8bdd\u9898\u3001Places to Watch \u548c\u6545\u4e8b</strong>\u3002\u5c06\u4e0e\u68ee\u6797\u53d8\u5316\u7684\u5f71\u54cd\u548c\u9a71\u52a8\u56e0\u7d20\u6709\u5173\u7684\u6570\u636e\u53ef\u89c6\u5316\uff0c\u5b83\u4eec\u5173\u7cfb\u5230\u6c14\u5019\u3001\u751f\u7269\u591a\u6837\u6027\u3001\u6c34\u8d44\u6e90\u3001\u5927\u5b97\u5546\u54c1\u548c\u706b\u707e\u7b49\u8bdd\u9898\u3002Places to Watch \u663e\u793a\u6700\u8fd1\u53d1\u751f\u91cd\u5927\u68ee\u6797\u635f\u5931\u7684\u533a\u57df\uff0c\u5e76\u4ee5\u6545\u4e8b\u5f62\u5f0f\u8be6\u8ff0\u6bcf\u4e2a\u5730\u70b9\u6240\u53d1\u751f\u7684\u4e8b\u60c5\u3002", "837c6e17b370571f3f69feb9ed29622b": "\u4e3a\u5173\u8054\u56fe\u5c42\u6307\u5b9a\u4e00\u4e2a\u540d\u79f0\uff0c\u7136\u540e\u70b9\u51fb\u201c\u5bfc\u5165\u56fe\u5c42\u201d\u3002", "e4d167a0b1202e9e440f2a5573b36712": "\u5f62\u72b6\u5c06\u51fa\u73b0\u5728\u5730\u56fe\u4e0a\uff0c\u5206\u6790\u5c06\u81ea\u52a8\u8fd0\u884c\uff0c\u5e76\u5728\u5206\u6790\u9009\u9879\u5361\u4e2d\u751f\u6210\u6570\u636e\u56fe\u8868\u3002", "d9ca93840af3eda9dfe961f596b8577b": "\u4f7f\u7528\u6700\u8fd1\u7684\u536b\u661f\u56fe\u50cf\uff0c\u653e\u5927\u627e\u5230\u8981\u8c03\u67e5\u7684\u5730\u70b9\u3002", "d80ecf324d64988df226bb4147b44325": "\u9009\u62e9\u201cUTM \u5750\u6807\u201d\u641c\u7d22\u53ef\u641c\u7d22\u57fa\u4e8e\u901a\u7528\u6a2a\u622a\u9762\u9ea6\u5361\u6258 (Universal Transverse Mercator, UTM) \u5750\u6807\u7cfb\u7edf\u7684\u5750\u6807\u3002\u8f93\u5165 UTM \u5750\u6807\u6570\u636e\uff0c\u7136\u540e\u5355\u51fb\u201c\u524d\u5f80\u5730\u70b9\u201d\uff0c\u5730\u56fe\u5c06\u81ea\u52a8\u8c03\u6574\u5230\u8be5\u5730\u70b9\u3002", "75224c7d7fabe0ddc1b7ad982039dc8a": "X \u56fe\u6807\u53ef\u53d6\u6d88\u9009\u62e9\u5df2\u9009\u5b9a\u6216\u5df2\u5b9a\u4f4d\u7684\u9884\u8b66\u3002", "77b0d6b648dbd34f44af0ac0f200cebe": "\u6709\u4e9b\u6570\u636e\u56fe\u5c42\uff0c\u6bd4\u5982\u68ee\u6797\u780d\u4f10\u9884\u8b66\uff0c\u4f1a\u63d0\u4f9b\u65e5\u5386\u6765\u9009\u62e9\u65e5\u671f\u8303\u56f4\u3002", "268f242ae0eb58eed21f48dc271ebeb2": "\u4e0b\u9762\u7684\u6b65\u9aa4\u6d89\u53ca\u5982\u4f55\u5c06\u81ea\u5b9a\u4e49\u5e95\u56fe\u3001\u5173\u8054\u56fe\u5c42\u548c GFW \u56fe\u5c42\u76f4\u63a5\u4e0a\u4f20\u5230\u8bbe\u5907\u3002", "27f9e2b02013fa131e1e0d36930c1bf6": "GFW \u5141\u8bb8\u4fdd\u5b58\u3001\u76d1\u6d4b\u548c\u6d4f\u89c8\u5173\u6ce8\u533a\u57df\u7684\u6570\u636e\uff0c\u4e0d\u7ba1\u662f\u4fdd\u5b58\u81ea\u5b9a\u4e49\u5f62\u72b6\u3001\u6574\u4e2a\u56fd\u5bb6\u8fd8\u662f\u4e9a\u56fd\u5bb6\u5730\u533a\u3002\u5728\u5730\u56fe\u4e0a\u4fdd\u5b58\u4e86\u533a\u57df\u540e\uff0cGFW \u4f1a\u751f\u6210\u4e00\u4e2a\u4eea\u8868\u677f\uff0c\u4e0a\u9762\u6709\u53ef\u81ea\u5b9a\u4e49\u7684\u4e92\u52a8\u6570\u636e\u56fe\u8868\uff0c\u53ef\u5b9e\u73b0\u7279\u5b9a\u4e8e\u8be5\u533a\u57df\u7684\u68ee\u6797\u7edf\u8ba1\u6570\u636e\u53ef\u89c6\u5316\u3002\u4e0b\u9762\u662f\u5982\u4f55\u67e5\u770b\u548c\u81ea\u5b9a\u4e49\u6b64\u6570\u636e\u7684\u6b65\u9aa4\u3002", "b1aa065b7402e20678541f396dcb1a3f": "\u5c06\u9f20\u6807\u60ac\u505c\u5728\u6570\u636e\u56fe\u8868\u4e0a\u7684\u68ee\u6797\u7edf\u8ba1\u6570\u636e\u4e0a\uff0c\u53ef\u67e5\u770b\u66f4\u591a\u4fe1\u606f\u3002", "efdfacc27adc2519a79e57b579593f13": "\u70b9\u51fb\u201c\u81ea\u5b9a\u4e49\u5173\u8054\u56fe\u5c42\u201d\u53ef\u6dfb\u52a0\u81ea\u5df1\u7684\u6570\u636e\u3002", "69e090e528b4a8b522f56b82c1c87120": "\u901a\u8fc7\u5f39\u51fa\u7a97\u53e3\u9876\u90e8\u7684\u201c\u83b7\u5f97\u65e5\u671f\u201d\u4e0b\u62c9\u83dc\u5355\uff0c\u53ef\u4ee5\u8bbf\u95ee\u6307\u5b9a\u65e5\u671f\u524d 1 \u5468\u30012 \u5468\u30014 \u5468\u30012 \u4e2a\u6708\u30013 \u4e2a\u6708\u30016 \u4e2a\u6708\u4ee5\u53ca 12 \u4e2a\u6708\u7684\u56fe\u50cf\u3002\u9ed8\u8ba4\u83b7\u5f97\u65e5\u671f\u4e3a\u5f53\u524d\u65e5\u671f\u524d 3 \u4e2a\u6708\uff0c\u4f46\u53ef\u901a\u8fc7\u5355\u51fb\u65e5\u671f\u66f4\u6539\u3002", "2f3e68c67cad06a430a5a738b1dbfd67": "<strong>\u66f4\u6539\u5728\u5730\u56fe\u4e0a\u6b63\u5728\u67e5\u770b\u7684\u5e95\u56fe</strong>\u3002\u5728\u9996\u6b21\u8bbf\u95ee\u5730\u56fe\u65f6\uff0c\u5e95\u56fe\u4f1a\u8bbe\u7f6e\u4e3a\u9ed8\u8ba4\u503c\uff0c\u5e76\u4f1a\u5448\u73b0\u653f\u6cbb\u7586\u754c\uff08\u4e0d\u540c\u4e8e\u6d41\u57df\u6216\u9646\u5730\u751f\u6001\u533a\uff09\u3002\u901a\u8fc7\u5355\u51fb\u5730\u56fe\u53f3\u4e0b\u65b9\u7684\u5730\u56fe\u8bbe\u7f6e\u201c\u9ed8\u8ba4\u201d\u56fe\u6807\uff0c\u53ef\u4ee5\u66f4\u6539\u5e95\u56fe\u3002<a href=\"{{0}}\">\u5728\u6b64\u5904</a>\u8fdb\u4e00\u6b65\u4e86\u89e3\u5982\u4f55\u66f4\u6539\u5e95\u56fe\u548c\u8fb9\u754c\u7c7b\u578b\u3002", "8a7f03c9c398516738774f4ef2975486": "\u901a\u8fc7\u5355\u51fb\u6807\u7b7e\u56fe\u6807\uff0c\u81ea\u5b9a\u4e49\u5730\u56fe\u4e0a\u7684\u6807\u7b7e\u3002\u9ed8\u8ba4\u60c5\u51b5\u4e0b\uff0c\u201c\u663e\u793a\u6807\u7b7e\u201d\u5904\u4e8e\u9009\u4e2d\u72b6\u6001\u3002", "1d44165a990dfb4cefd1407b14685f70": "\u5bfc\u822a\u5230\u5173\u6ce8\u533a\u57df\uff0c\u62a5\u544a\u53d1\u73b0\u7684\u5185\u5bb9", "4bda824ca341b18d87ce747602703f73": "\u5355\u51fb\u201c\u521b\u5efa\u6a21\u677f\u201d\u53ef\u521b\u5efa\u65b0\u7684\u62a5\u544a\u6a21\u677f\u3002\u5728\u6b64\u5904\uff0c\u9009\u62e9\u8981\u5c06\u65b0\u62a5\u544a\u6a21\u677f\u5206\u914d\u5230\u7684\u533a\u57df\uff0c\u5e76\u4f7f\u7528\u4e0b\u62c9\u83dc\u5355\u9009\u62e9\u9ed8\u8ba4\u8bed\u8a00\u3002", "1fb55ee62366768dd27a200f5cca26db": "\u901a\u8fc7\u5355\u51fb\u201c\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u201d\u56fe\u6807\uff0c\u9009\u62e9\u4e86\u5546\u54c1\u4e3b\u9898\u89c6\u56fe\u3002", "d261254c9e37e27ae4584dcd0bc52e6b": "\u641c\u7d22 GFW \u5e2e\u52a9\u4e2d\u5fc3", "88952fcd79c90dcc45a4d9565e720608": "\u81ea\u5b9a\u4e49\u5730\u56fe\u4e0a\u53ef\u89c1\u7684\u5173\u8054\u56fe\u5c42\u3002", "79f845ec877858fd3e2201ee43a1f384": "\u4ece\u8bbe\u5907\u4e2d\u9009\u62e9\u6587\u4ef6\u3002", "1213c8f4926bb5322f3ab343b109f49c": "\u8f93\u5165\u5750\u6807\u4fe1\u606f\u53ef\u76f4\u63a5\u5728\u5730\u56fe\u4e0a\u5bfc\u822a\u5230\u8be5\u5730\u70b9\u3002", "97fa45757e1b462a85a852ce379e5403": "\u4f7f\u7528\u53ef\u7528\u9009\u9879\u4e4b\u4e00\u767b\u5f55 Forest Watcher Web\u3002", "ea23b15ce6a48130e04e4323f739b7e2": "\u70b9\u51fb\u5de6\u4e0b\u65b9\u7684\u505c\u6b62\u56fe\u6807\u53ef\u505c\u6b62\u8bb0\u5f55\u8def\u7ebf\u3002\u53ef\u4ee5\u4fdd\u5b58\u8def\u7ebf\u4f9b\u5c06\u6765\u53c2\u8003\uff0c\u4e5f\u53ef\u5c06\u5176\u5220\u9664\u3002\u5982\u679c\u9009\u62e9\u4fdd\u5b58\u8def\u7ebf\uff0c\u7cfb\u7edf\u5c06\u63d0\u793a\u4e3a\u8def\u7ebf\u6307\u5b9a\u540d\u79f0\u5e76\u5b9a\u4e49\u5176\u96be\u5ea6\u3002\u5b8c\u6210\u540e\uff0c\u70b9\u51fb\u201c\u4fdd\u5b58\u8def\u7ebf\u201d\u3002", "21b7a2c1122e2bf4613bae1ef33e27c8": "\u8bb0\u8005", "7eb75d4047d85b9ae79c11d175b3435a": "<strong>\u8c03\u6574\u548c\u5171\u4eab\u5730\u56fe\u89c6\u56fe</strong>\u3002\u4f7f\u7528\u5730\u56fe\u53f3\u4e0b\u65b9\u7684\u524d\u4e09\u4e2a\u56fe\u6807\uff0c\u653e\u5927\u3001\u7f29\u5c0f\u6216\u5c55\u5f00\u5730\u56fe\u4ee5\u4ece\u89c6\u56fe\u4e2d\u9690\u85cf\u9762\u677f\u3002\u5728\u6b64\u5904\uff0c\u53ef\u4ee5\u5355\u51fb\u5171\u4eab\u56fe\u6807\u6765\u751f\u6210\u4e00\u4e2a\u552f\u4e00\u94fe\u63a5\uff0c\u7528\u4e8e\u83b7\u53d6\u786e\u5207\u7684\u5730\u56fe\u89c6\u56fe\u4e0e\u4ed6\u4eba\u5171\u4eab\u3002\u6b64\u5916\uff0c\u4e5f\u53ef\u4ee5\u751f\u6210 HTML\uff0c\u5c06\u5730\u56fe\u89c6\u56fe\u5d4c\u5165\u5728\u5916\u90e8\u7f51\u7ad9\u4e2d\u3002<a href=\"{{0}}\">\u5728\u6b64\u5904</a>\u8fdb\u4e00\u6b65\u4e86\u89e3\u5982\u4f55\u8c03\u6574\u5730\u56fe\u8bbe\u7f6e\u3002", "946ddff05e9602cc930ff62c79a165cb": "\u8c01\u4f7f\u7528 GFW Pro\uff1f", "bf635b58ae2e678feb8af5536baf2866": "\u5206\u6790\u7684\u7ed3\u679c\u4f1a\u586b\u5145\u5728\u5370\u5ea6\u5c3c\u897f\u4e9a\u6cb9\u68d5\u6988\u6811\u7279\u8bb8\u7ecf\u8425\u6743\u533a\u57df\u7684\u56fe\u4f8b/\u5206\u6790\u9762\u677f\u4e0a\u3002", "1a2eb25636ecd220c3bfab55bfc0b854": "\u4e0b\u9762\u7684\u4fe1\u606f\u6d89\u53ca\u5982\u4f55\u8bbe\u7f6e Forest Watcher Web\uff0c\u5b9a\u4e49\u5173\u6ce8\u533a\u57df\uff0c\u521b\u5efa\u62a5\u544a\u6a21\u677f\uff0c\u67e5\u770b\u56e2\u961f\u63d0\u4ea4\u7684\u62a5\u544a\uff0c\u4ee5\u53ca\u7ba1\u7406\u56e2\u961f\u3002", "9feb80d20ef482bdfdc00ba97196a371": "\u6d4f\u89c8\u9010\u6b65\u8bf4\u660e\uff0c\u4e86\u89e3\u5982\u4f55\u4f7f\u7528 MapBuilder \u6765\u6784\u5efa\u81ea\u5b9a\u4e49\u76d1\u6d4b\u5e94\u7528\u7a0b\u5e8f\u3002", "1e05b54c51f2243f9bfe0806f3a88d1c": "\u5355\u51fb\u201c\u4e0b\u8f7d\u7b54\u6848\u201d\u53ef\u4e0b\u8f7d\u6240\u6709\u5df2\u63d0\u4ea4\u62a5\u544a\u4e2d\u7684\u7b54\u6848\u3002", "a73bc671946550eb73b81f022af1c4fa": "<strong>\u8bbe\u7f6e</strong>\uff1a\u5728\u8bbe\u7f6e\u7f51\u9875\u4e0a\u7ba1\u7406\u56e2\u961f\u3002\u56e2\u961f\u53ef\u7531\u6709 MyGFW \u8d26\u6237\u7684\u4efb\u4f55\u56e2\u961f\u6210\u5458\u7ec4\u6210\uff0c\u5e76\u53ef\u4e3a\u56e2\u961f\u5206\u914d\u4efb\u4f55\u5df2\u4fdd\u5b58\u5230\u8d26\u6237\u7684\u5173\u6ce8\u533a\u57df\u3002", "5d07abb0000c8e0062837f5f4d1c5dea": "\u901a\u8fc7\u4e3a\u8def\u7ebf\u6307\u5b9a\u540d\u79f0\u5e76\u8bc4\u5b9a\u5176\u96be\u5ea6\uff0c\u4fdd\u5b58\u8def\u7ebf\u3002", "dea6f9e414d78a69c9463408ad61646d": "\u8c01\u4f7f\u7528 MapBuilder\uff1f", "fd3f1b1d2aeca7addcd0fc06dd26fbbc": "\u7cfb\u7edf\u5c06\u63d0\u793a\u9009\u62e9\u8981\u5bfc\u51fa\u548c\u5171\u4eab\u7684\u6587\u4ef6\u3002\u9009\u5b9a\u7684\u6587\u4ef6\u51c6\u5907\u597d\u5bfc\u51fa\u65f6\uff0c\u201c\u5171\u4eab\u201d\u56fe\u6807\u5c06\u53d8\u7eff\u3002", "c90fe0925c93c66887e5ed74f91a4a12": "\u901a\u8fc7\u5355\u51fb\u4eea\u8868\u677f\u53f3\u4e0a\u65b9\u7684\u4e0b\u8f7d\u56fe\u6807\uff0c\u53ef\u4e0b\u8f7d\u6574\u4e2a\u4eea\u8868\u677f\u7684\u6570\u636e\uff1b\u901a\u8fc7\u5355\u51fb\u6570\u636e\u56fe\u8868\u53f3\u4e0a\u65b9\u7684\u4e0b\u8f7d\u56fe\u6807\uff0c\u53ef\u4e0b\u8f7d\u4e2a\u522b\u6570\u636e\u56fe\u8868\u7684\u6570\u636e\u3002<a href=\"{{0}}\">\u5728\u6b64\u5904</a>\u8fdb\u4e00\u6b65\u4e86\u89e3\u5982\u4f55\u4ece\u4eea\u8868\u677f\u4e0b\u8f7d\u6570\u636e\u3002", "81bd8ae7813b8c5544ad0b149338a9c2": "2020 \u5e74 4 \u6708 1 \u65e5\u81f3 2020 \u5e74 5 \u6708 16 \u65e5\u7684\u68ee\u6797\u780d\u4f10\u9884\u8b66\u5df2\u6fc0\u6d3b\u3002\u8fd9\u4f1a\u663e\u793a\u8be5\u671f\u95f4\u53ef\u80fd\u7684\u68ee\u6797\u780d\u4f10\u5730\u70b9\u3002", "33afc9964f1ff3ce9ba4b811f73e88a0": "<strong>\u663e\u793a\u9053\u8def</strong>\uff1a\u901a\u8fc7\u663e\u793a\u9053\u8def\u529f\u80fd\uff0c\u53ef\u4ee5\u5728\u653e\u5927\u65f6\u663e\u793a\u6216\u79fb\u9664\u5730\u56fe\u4e0a\u7684\u9053\u8def\u3002\u9ed8\u8ba4\u60c5\u51b5\u4e0b\uff0c\u5728\u9996\u6b21\u8bbf\u95ee\u5730\u56fe\u65f6\uff0c\u201c\u9690\u85cf\u9053\u8def\u201d\u5904\u4e8e\u9009\u4e2d\u72b6\u6001\u3002", "ff63715aa0d2775e9c5d2ecd84063c44": "<strong>\u533a\u57df</strong>\uff1a\u7ba1\u7406\u5df2\u4fdd\u5b58\u7684\u5173\u6ce8\u533a\u57df\uff0c\u4ee5\u53ca\u5728\u533a\u57df\u4e2d\u521b\u5efa\u7684\u62a5\u544a\uff1b\u6216\u8005\u5728\u533a\u57df\u7f51\u9875\u4e0a\u521b\u5efa\u65b0\u7684\u5173\u6ce8\u533a\u57df\u3002\u53ef\u4ee5\u5c06\u5173\u6ce8\u533a\u57df\u5206\u914d\u7ed9\u7279\u5b9a\u7684\u56e2\u961f\u8fdb\u884c\u76d1\u6d4b\u3002", "3dba9e49551d3b90c9a957de29cce2cb": "\u6d4f\u89c8\u7f51\u7edc\u7814\u8ba8\u4f1a\u4ee5\u4e86\u89e3\u5982\u4f55\u4f7f\u7528\u5730\u56fe\u548c\u4eea\u8868\u677f\u6765\u76d1\u6d4b\u5168\u7403\u5404\u5730\u7684\u68ee\u6797\u53d8\u5316\u60c5\u51b5\u3002", "ec5c09cf61367bbd7ce32b1f4db4e75d": "\u81ea\u5b9a\u4e49\u5173\u8054\u56fe\u5c42\u4f1a\u81ea\u52a8\u5bfc\u5165\u3002\u53ef\u4ee5\u5728\u7ba1\u7406\u5173\u8054\u56fe\u5c42\u9875\u9762\u4e0a\u7684\u201c\u81ea\u5b9a\u4e49\u56fe\u5c42\u201d\u4e0b\u627e\u5230\u81ea\u5b9a\u4e49\u5173\u8054\u56fe\u5c42\u3002", "6a21855994c3b65b2fca42a45211aab6": "<strong>\u663e\u793a\u6807\u7b7e</strong>\uff1a\u901a\u8fc7\u663e\u793a\u6807\u7b7e\u529f\u80fd\uff0c\u53ef\u4ee5\u6dfb\u52a0\u6216\u79fb\u9664\u5730\u56fe\u7684\u6587\u672c\u6807\u7b7e\u3002\u9ed8\u8ba4\u60c5\u51b5\u4e0b\uff0c\u5728\u9996\u6b21\u8bbf\u95ee\u5730\u56fe\u65f6\uff0c\u201c\u663e\u793a\u6807\u7b7e\u201d\u5904\u4e8e\u9009\u4e2d\u72b6\u6001\u3002", "f76a4bb6b67055ee81647382f8cc46f1": "\u521b\u5efa\u548c\u7ba1\u7406\u62a5\u544a\u6a21\u677f", "7f695efcd446815d61bdd8425240d8de": "\u7ba1\u7406\u5730\u56fe\u4e2d\u7684\u4fdd\u5b58\u533a\u57df", "5584e7b75b2380a36f782b74a6efbc98": "\u5df2\u751f\u6210\u5370\u5ea6\u5c3c\u897f\u4e9a\u4fdd\u5b58\u7684\u6cb9\u68d5\u6988\u6811\u7279\u8bb8\u7ecf\u8425\u6743\u533a\u57df\u7684\u4eea\u8868\u677f\u3002", "696d79da821e9e838570baeef6eeeb58": "\u70b9\u51fb\u53f3\u4e0a\u65b9\u7684\u8bbe\u7f6e\u9f7f\u8f6e\u56fe\u6807\uff0c\u7136\u540e\u70b9\u51fb\u201c\u5173\u8054\u56fe\u5c42\u201d\u4e0b\u65b9\u7684\u8bbe\u7f6e\u9f7f\u8f6e\u56fe\u6807\uff0c\u53ef\u8bbf\u95ee\u53ef\u7528\u7684\u5173\u8054\u56fe\u5c42\u3002", "7de7ff86c71949c8bc6051a5b1a20aa8": "\u5bfc\u51fa\u4e2a\u522b\u533a\u57df\u3001\u62a5\u544a\u3001\u8def\u7ebf\u3001\u5e95\u56fe\u548c\u5173\u8054\u56fe\u5c42", "fa4955ec1f9feaeaadaad9d00f3b875c": "\u5982\u679c\u8981\u5171\u4eab\u7279\u5b9a\u7684 app \u5185\u5bb9\uff0cForest Watcher \u4e5f\u53ef\u4ee5\u8ddf\u5176\u4ed6\u7528\u6237\u5171\u4eab\u4e2a\u522b\u7684\u6570\u636e\u6587\u4ef6\u3002\u6b64\u9009\u9879\u53ef\u4f9b\u79bb\u7ebf\u548c\u5728\u7ebf\u4f7f\u7528\u3002\u8bf7\u6ce8\u610f\uff0c\u8981\u52a0\u8f7d\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u9884\u8b66\uff0c\u9700\u8981\u6709\u4e92\u8054\u7f51\u6216\u8702\u7a9d\u6570\u636e\u8fde\u63a5\u3002", "109a9237476780c8a9bf4f4c18728c40": "\u7136\u540e\uff0c\u7cfb\u7edf\u4f1a\u6307\u793a\u5c06\u6587\u4ef6\u4fdd\u5b58\u5728\u60a8\u7684\u8bbe\u5907\u4e0a\u3002\u91cd\u547d\u540d\u6587\u4ef6\uff0c\u9009\u62e9\u6240\u9700\u7684\u4f4d\u7f6e\uff0c\u7136\u540e\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u3002\u4e4b\u540e\uff0c\u53ef\u901a\u8fc7\u6240\u9009\u4f4d\u7f6e\u8bbf\u95ee\u8be5\u6587\u4ef6\u3002\u5728\u4e0b\u9762\u7684\u201c\u8ddf\u5176\u4ed6\u8bbe\u5907\u5171\u4eab app \u5185\u5bb9\u201d\u90e8\u5206\uff0c\u4e86\u89e3\u5982\u4f55\u8ddf\u5176\u4ed6\u8bbe\u5907\u5171\u4eab\u6b64\u5185\u5bb9\u3002", "b03a1b9b8425b84a56a1b17b893ca444": "\u5728\u8bbe\u7f6e\u9875\u9762\u4e0a\u70b9\u51fb\u201c\u5e95\u56fe\u201d\u3002\u5728\u6b64\u5904\uff0c\u53ef\u4ee5\u7ba1\u7406 app \u4e0a\u7684\u9ed8\u8ba4\u5e95\u56fe\u548c\u81ea\u5b9a\u4e49\u5e95\u56fe\u3002\u70b9\u51fb\u53f3\u4e0a\u65b9\u7684 + \u56fe\u6807\u53ef\u4e0a\u4f20\u81ea\u5b9a\u4e49\u5e95\u56fe\u3002", "7e3bf8007f23a812053cf5dbe3fdaab4": "\u6700\u8fd1\u7684\u536b\u661f\u56fe\u50cf\u5de5\u5177\u63d0\u4f9b\u7684\u4fe1\u606f\u6d89\u53ca\u5168\u7403\u5404\u5730\u7684\u690d\u88ab\u5065\u5eb7\u60c5\u51b5\uff0c\u53ef\u5e2e\u52a9\u9a8c\u8bc1\u51c6\u5b9e\u65f6\u9884\u8b66\u3002\u6bcf\u5929\u4f1a\u6709\u65b0\u56fe\u50cf\u586b\u5145\u8fdb\u6765\uff0c\u663e\u793a\u6765\u81ea Sentinel-2 \u548c Landsat 8 \u7cfb\u7edf\u7684\u6700\u65b0\u536b\u661f\u56fe\u50cf\u3002", "9e3e07ceea306bdb0eec2d90e3502d35": "\u5047\u8bbe\u8981\u7ba1\u7406\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u7684\u8fd9\u4e2a\u533a\u57df\u3002\u5728\u6b64\u4f8b\u4e2d\uff0c\u53ef\u4ee5\u770b\u5230\u68ee\u6797\u780d\u4f10\u9884\u8b66\u662f\u5982\u4f55\u4e0e\u81ea\u7136\u8272\u536b\u661f\u56fe\u50cf\u4e2d\u7684\u68d5\u8272\uff08\u5373\u5df2\u6e05\u9664\uff09\u533a\u57df\u4fdd\u6301\u4e00\u81f4\u7684\u3002", "c32439e7b7c72164acd2f59e2af9b2af": "\u5355\u51fb\u5e76\u62d6\u52a8\u6ed1\u5757\u5230\u6240\u9700\u767e\u5206\u6bd4\uff0c\u53ef\u8c03\u6574\u4e91\u8986\u76d6\u767e\u5206\u6bd4\u3002\u9ed8\u8ba4\u8bbe\u7f6e\u4e3a 25%\uff0c\u5373\u4ec5\u52a0\u8f7d\u4e91\u8986\u76d6\u5c11\u4e8e 25% \u7684\u536b\u661f\u56fe\u50cf\u3002\u6700\u5927\u4e91\u8986\u76d6\u767e\u5206\u6bd4\u8d8a\u9ad8\uff0c\u51fa\u73b0\u5728\u641c\u7d22\u4e2d\u7684\u56fe\u50cf\u5c31\u8d8a\u591a\uff1b\u4f46\u662f\uff0c\u5176\u4e2d\u6709\u4e9b\u56fe\u50cf\u53ef\u80fd\u4f1a\u88ab\u4e91\u906e\u76d6\u800c\u770b\u4e0d\u6e05\u3002", "e7ad3ff3166b8afee01312173558cd3b": "\u5355\u51fb\u536b\u661f\u56fe\u6807\u53ef\u6fc0\u6d3b\u8be5\u5de5\u5177\u3002", "4f57e350689456d87601114c0b387ef4": "\u5730\u56fe\u89c6\u56fe\u8bbe\u7f6e", "4f4f015481a1dec344a6c0c2e616350c": "<a href=\"{{0}}\">\u5728\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u5728\u5730\u56fe\u4e0a\u4fdd\u5b58\u533a\u57df\uff1b\u5728<a href=\"{{1}}\">\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u67e5\u770b\u5168\u7403\u3001\u56fd\u5bb6\u548c\u4e9a\u56fd\u5bb6\u533a\u57df\u7684\u68ee\u6797\u7edf\u8ba1\u6570\u636e\u3002", "1a0bd1ea8d81a56e8433e9bb8006bd4d": "\u70b9\u51fb\u8bbe\u7f6e\u9f7f\u8f6e\u56fe\u6807\u53ef\u81ea\u5b9a\u4e49\u5730\u56fe\u4e0a\u7684\u53ef\u89c1\u5185\u5bb9\u3002\u5728\u6b64\u5904\uff0c\u53ef\u4ee5\u6dfb\u52a0\u6216\u79fb\u9664\u9884\u8b66\u3001\u8def\u7ebf\u3001\u62a5\u544a\u6216\u5173\u8054\u56fe\u5c42\uff0c\u5e76\u53ef\u66f4\u6539\u5e95\u56fe\u3002\u6309\u63a5\u4e0b\u6765\u7684\u4e94\u4e2a\u6b65\u9aa4\u64cd\u4f5c\uff0c\u4e86\u89e3\u5982\u4f55\u81ea\u5b9a\u4e49\u5730\u56fe\u89c6\u56fe\u3002", "ba7b17dfd5c01f468aa5de37c691bbc7": "\u4ece\u8bbe\u5907\u7684\u6587\u4ef6\u4e2d\u9009\u62e9\u548c\u4e0a\u4f20\u81ea\u5b9a\u4e49\u5e95\u56fe\u3002", "29318e5e9e92a538d8f94bee708190e4": "\u5206\u6790\u5de5\u5177\u662f\u8bc4\u4f30\u5730\u56fe\u4e0a\u67d0\u4e2a\u533a\u57df\u5185\u68ee\u6797\u53d8\u5316\u60c5\u51b5\u7684\u7b80\u4fbf\u65b9\u5f0f\u3002\u53ef\u4ee5\u5206\u6790\u56fd\u5bb6/\u5730\u533a\u3001\u4e9a\u56fd\u5bb6\u7ea7\u533a\u57df\u3001\u5173\u8054\u56fe\u5c42\u4e2d\u7684\u5f62\u72b6\u6216\u81ea\u5b9a\u4e49\u533a\u57df\u3002\u5206\u6790\u5de5\u5177\u4e5f\u53ef\u7528\u4e8e\u751f\u6210\u53ef\u89c6\u5316\u5185\u5bb9\u548c\u6570\u636e\u56fe\u8868\uff0c\u7528\u4e8e\u653f\u7b56\u7b80\u62a5\u3001\u62a5\u544a\u548c\u6587\u7ae0\u3002", "5df96764a69b5b4d2f7a01e2a7d3b2ee": "\u8981\u6dfb\u52a0\u81ea\u5df1\u7684\u5173\u8054\u56fe\u5c42\uff0c\u8bf7\u70b9\u51fb\u201c\u81ea\u5b9a\u4e49\u5173\u8054\u56fe\u5c42\u201d\u3002\u652f\u6301\u7684\u6587\u4ef6\u7c7b\u578b\u5305\u62ec\uff1a.json\u3001.geojson\u3001.topojson\u3001.gpx\u3001.zip\u3001.kmz \u548c .kml", "803c9c47ba362f3f93017023b54c568c": "<a href=\"{{0}}\">\u5728\u6b64\u5904</a>\u8fdb\u4e00\u6b65\u4e86\u89e3\u5982\u4f55\u4fdd\u5b58\u548c\u8ba2\u9605\u533a\u57df\u3002", "ba0482f680bc0bb3dae57d2184d19fb8": "\u5355\u51fb\u201c\u524d\u5f80\u5168\u7403\u4eea\u8868\u677f\u201d\u53ef\u5bfc\u822a\u5230\u5168\u7403\u4eea\u8868\u677f\u3002", "a4c614697a2f64fdba5f7fbf5d03d08f": "\u9009\u62e9\u4e86\u6240\u9700\u7684\u6587\u4ef6\u540e\uff0c\u201c\u5171\u4eab\u201d\u56fe\u6807\u4f1a\u53d8\u7eff\uff0c\u8868\u793a\u6587\u4ef6\u73b0\u5728\u5df2\u51c6\u5907\u597d\u5171\u4eab\u3002", "17aba63b1c865b6f18ca4779eb5c421e": "\u5bfc\u822a\u5230\u5730\u56fe\u7684\u53f3\u4e0b\u65b9\uff0c\u5355\u51fb\u5730\u56fe\u8bbe\u7f6e\u201c\u9ed8\u8ba4\u201d\u56fe\u6807\uff0c\u53ef\u8bbf\u95ee\u4e0d\u540c\u7684\u5e95\u56fe\u3002\u5728\u9996\u6b21\u8bbf\u95ee\u5730\u56fe\u65f6\uff0c\u5e95\u56fe\u4f1a\u8bbe\u7f6e\u6210\u201c\u9ed8\u8ba4\u5e95\u56fe\u201d\u3002", "f83f99d4c73544792efadf26c2cb50f4": "\u65f6\u95f4\u6ed1\u5757\u5df2\u7ecf\u8fc7\u4fee\u6539\uff0c\u53ef\u663e\u793a\u4ece 2007 \u5e74\u5230 2015 \u5e74\u7684\u6811\u6728\u8986\u76d6\u8303\u56f4\u51cf\u5c11\u60c5\u51b5\u3002.", "bb0f274bccb6f95c464752359d87074c": "\u4ece\u4e0b\u62c9\u83dc\u5355\u4e2d\u9009\u62e9\u4e86\u201c\u5df4\u897f\u201d\uff0c\u5e76\u4e3a\u8be5\u56fd\u5bb6\u751f\u6210\u4e86\u4eea\u8868\u677f\u3002", "0e138654bc2217575ded2cd48042fdba": "\u70b9\u51fb\u201c\u8bbe\u7f6e\u201d\u53ef\u8bbf\u95ee\u53ef\u7528\u7684 app \u8bbe\u7f6e\u3002", "23157f8c13054eb1c2bbebc3d88c7f73": "\u70b9\u51fb\u201c\u5e95\u56fe\u201d\u6216\u201c\u5173\u8054\u56fe\u5c42\u201d\u53ef\u8bbf\u95ee\u5404\u81ea\u7684\u5176\u4ed6\u8bbe\u7f6e\u3002\u5728\u6b64\u5904\uff0c\u901a\u8fc7\u70b9\u51fb\u5e95\u56fe\u6216\u5173\u8054\u56fe\u5c42\u540d\u79f0\u53f3\u8fb9\u7684\u4e0b\u8f7d\u56fe\u6807\uff0c\u53ef\u4ee5\u4e0b\u8f7d\u53ef\u7528\u7684\u5e95\u56fe\u6216\u5173\u8054\u56fe\u5c42\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002\u4e0b\u8f7d\u5e95\u56fe\u6216\u5173\u8054\u56fe\u5c42\u4f9b\u79bb\u7ebf\u4f7f\u7528\u540e\uff0c\u53ef\u4ee5\u5728\u4e0d\u8fde\u63a5\u4e92\u8054\u7f51\u7684\u60c5\u51b5\u4e0b\u67e5\u770b\u5e95\u56fe\u6216\u5173\u8054\u56fe\u5c42\uff0c\u4f46\u4f1a\u589e\u52a0\u5360\u7528\u7684\u8bbe\u5907\u5b58\u50a8\u7a7a\u95f4\u3002\u6b64\u5916\uff0c\u4e5f\u53ef\u4ee5\u4e0a\u4f20\u81ea\u5df1\u7684\u5e95\u56fe\u6216\u5173\u8054\u56fe\u5c42\uff0c\u6216\u5c06\u5b83\u4eec\u4e0e\u5176\u4ed6\u8bbe\u5907\u5171\u4eab\u3002<a href=\"{{0}}\">\u5728\u6b64\u5904</a>\u8fdb\u4e00\u6b65\u4e86\u89e3\u5982\u4f55\u5c06\u5e95\u56fe\u548c\u5173\u8054\u56fe\u5c42\u4e0a\u4f20\u5230 app\uff0c<a href=\"{{1}}\">\u5728\u6b64\u5904</a>\u8fdb\u4e00\u6b65\u4e86\u89e3\u5982\u4f55\u5171\u4eab app \u5185\u5bb9\u3002", "b11751f1d0889919ee5d891daf209ba9": "\u5728\u6bcf\u4e2a\u7c7b\u522b\u4e0b\uff0c\u4f1a\u770b\u5230\u5c55\u793a\u68ee\u6797\u7edf\u8ba1\u6570\u636e\u7684\u4e92\u52a8\u6570\u636e\u56fe\u8868\u3002\u6bcf\u4e2a\u6570\u636e\u56fe\u8868\u5305\u542b\u6240\u9009\u533a\u57df\u4e2d\u53ef\u7528\u6570\u636e\u7684\u56fe\u5f62\u8868\u793a\u5f62\u5f0f\u3002", "4ee799c34c7943d8e545122c9230797a": "\u6d4f\u89c8\u9010\u6b65\u8bf4\u660e\uff0c\u4e86\u89e3\u5982\u4f55\u4f7f\u7528\u5730\u56fe\u548c\u4eea\u8868\u677f\u6765\u76d1\u6d4b\u68ee\u6797\u53d8\u5316\u60c5\u51b5\u3002", "68813f6e1deedbcda57708436ffbf328": "\u901a\u8fc7\u70b9\u51fb + \u56fe\u6807\uff0c\u4e0a\u4f20\u65b0\u7684\u5173\u8054\u56fe\u5c42\u3002", "0739768524af8c63c70482e51e89a95d": "\u5355\u51fb\u53f3\u4e0a\u65b9\u7684\u4e0b\u8f7d\u56fe\u6807\u53ef\u4e0b\u8f7d\u6574\u4e2a\u4eea\u8868\u677f\u7684\u6570\u636e\u3002", "1cc3abda3f3660c46c287d000f71a683": "\u5728\u5730\u56fe\u4e0a\u7ed8\u5236\u4e00\u4e2a\u5f62\u72b6\u6216\u8005\u4e0a\u4f20\u4e00\u4e2a\u5f62\u72b6\u6587\u4ef6\u6765\u521b\u5efa\u5173\u6ce8\u533a\u57df\u3002", "e53e1d9cd132bfac382784c4654fa81e": "\u5728\u533a\u57df\u7f51\u9875\u4e0a\u8bbf\u95ee\u4fdd\u5b58\u7684\u533a\u57df\u3002", "251cec879864825ff7f1d8b47439e87d": "\u5355\u51fb\u5730\u56fe\u53ef\u521b\u5efa\u70b9\uff0c\u8fdb\u800c\u5f62\u6210\u5173\u6ce8\u533a\u57df\u3002", "0f56f59ab15b8e17e98d07d56f9ac216": "\u901a\u8fc7\u5728\u641c\u7d22\u680f\u4e2d\u8f93\u5165\u5730\u70b9\u7684\u540d\u79f0\uff0c\u641c\u7d22\u5730\u70b9\u3002", "55ab79c51e56528f7982ab952c6f3f96": "\u8981\u5f00\u59cb\uff0c\u8bf7\u70b9\u51fb\u8981\u5171\u4eab\u7684\u5185\u5bb9\u3002\u5bf9\u4e8e\u533a\u57df\u3001\u62a5\u544a\u548c\u8def\u7ebf\uff0c\u53ef\u901a\u8fc7\u4e3b\u9875\u8bbf\u95ee\u5b83\u4eec\u7684\u9002\u7528\u9875\u9762\u3002\u901a\u8fc7\u8bbe\u7f6e\u9875\u9762\uff0c\u53ef\u8bbf\u95ee\u5e95\u56fe\u548c\u5173\u8054\u56fe\u5c42\u3002", "5ea02efb4783888344bef80498625c46": "\u5355\u51fb\u201c\u5206\u6790\u201d\u9009\u9879\u5361\uff0c\u7136\u540e\u7ed8\u5236\u6216\u4e0a\u4f20\u4e00\u4e2a\u5f62\u72b6\u6765\u521b\u5efa\u81ea\u5b9a\u4e49\u533a\u57df\u3002", "a919c2dfa296158ef767c76b6584c7c1": "\u521b\u5efa\u5173\u6ce8\u533a\u57df", "4be933bc13e576c7b7fba96d19a6e5b7": "\u89c2\u770b\u82f1\u8bed\u6f14\u793a\u3002", "0cb76cb9ab6f7b3a35122d6a3ef65da5": "\u7ba1\u7406\u56e2\u961f", "2918f2189ae2eb912973fa4b43078519": "\u67e5\u770b\u5df2\u63d0\u4ea4\u7684\u62a5\u544a", "a1694042b336fca11a7dcefb9929fbad": "\u70b9\u51fb\u53f3\u4e0b\u65b9\u7684\u62a5\u544a\u56fe\u6807\u53ef\u542f\u52a8\u62a5\u544a\u6765\u8bb0\u5f55\u6cbf\u9014\u6216\u5728\u9009\u5b9a\u76ee\u7684\u5730\u7684\u53d1\u73b0\u3002", "61a86902608a3f5d0a962d3590eac78c": "\u8be5\u56fe\u50cf\u4ee5 10 x 10 \u7c73\u5206\u8fa8\u7387\u63d0\u4f9b Sentinel-2 \u5168\u7403\u5730\u7406\u8986\u76d6\u8303\u56f4\uff0c\u4ee5 30 x 30 \u7c73\u5206\u8fa8\u7387\u63d0\u4f9b Landsat 8 \u5168\u7403\u5730\u7406\u8986\u76d6\u8303\u56f4\u3002Sentinel-2 \u536b\u661f\u6bcf 10 \u5929\u8bbf\u95ee\u4e00\u6b21\u76f8\u5173\u5730\u70b9\uff0cLandsat 8 \u6bcf 16 \u5929\u8bbf\u95ee\u4e00\u6b21\u3002", "048d868b3599a139feb302961e98165b": "\u5355\u51fb\u201c\u8bbe\u7f6e\u201d\u53ef\u8bbe\u7f6e\u548c\u7ba1\u7406\u56e2\u961f\u3002", "2e5d8aa3dfa8ef34ca5131d20f9dad51": "\u8bbe\u7f6e", "3d9e2667a57d945b71c3447d852976d5": "\u4e0a\u4f20\u81ea\u5b9a\u4e49\u5e95\u56fe", "9d8eb2dbb002e5b977b873d8fad1897d": "\u5728\u4e3b\u9875\u4e0a\u70b9\u51fb\u201c\u8bbe\u7f6e\u201d\u3002", "736479eb6c2d8928612508d16707ecb7": "\u9009\u62e9 app \u5185\u5bb9\u6587\u4ef6\u7684\u4fdd\u5b58\u4f4d\u7f6e\uff0c\u7136\u540e\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u3002", "9a3e7a64d533dc04f67550cc76be549f": "\u5355\u51fb\u201c\u6309\u6807\u8bb0\u7b5b\u9009\u201d\uff0c\u53ef\u901a\u8fc7\u4efb\u4f55\u5206\u914d\u7684\u6807\u8bb0\u641c\u7d22\u533a\u57df\u3002", "cb33b7eaf1ca524eef361bd3f3c591b2": "\u8bbe\u7f6e Forest Watcher Web", "e4359240cbdabe25cc61d4d42b2588e8": "\u901a\u8fc7\u5355\u51fb\u53f3\u4e0b\u65b9\u7684\u4ec5\u663e\u793a\u5730\u56fe\u56fe\u6807\uff0c\u53ef\u9690\u85cf\u5730\u56fe\u8bbe\u7f6e\u5de5\u5177\u3002", "14e2f5aa2813a947aed81d74ea2a56d2": "\u5728 app \u5185\u5bb9\u6587\u4ef6\u4fdd\u5b58\u5728\u8bbe\u5907\u4e0a\u4ee5\u540e\uff0c\u53ef\u5c06\u6b64\u4fe1\u606f\u4e0e\u5176\u4ed6\u7528\u6237\u5171\u4eab\u3002\u867d\u7136\u4e0d\u9700\u8981\u4e92\u8054\u7f51\u5c31\u80fd\u5bfc\u51fa\u548c\u5171\u4eab\u6587\u4ef6\uff0c\u4f46\u5fc5\u987b\u6ce8\u610f\u7684\u662f\uff0c\u9700\u8981\u6709\u4e92\u8054\u7f51\u6216\u8702\u7a9d\u6570\u636e\u670d\u52a1\u624d\u80fd\u5c06\u6587\u4ef6\u4f20\u8f93\u5230\u5176\u4ed6\u8bbe\u5907\u3002\u6b64\u529f\u80fd\u7684\u4f18\u52bf\u5728\u4e8e\uff0c\u5982\u679c\u7528\u6237\u6709\u4e92\u8054\u7f51\u8fde\u63a5\uff0c\u53ef\u4ee5\u8ddf\u79bb\u7ebf\u7528\u6237\u5171\u4eab\u66f4\u65b0\u540e\u7684\u4fe1\u606f\u3002", "154b8867ae7517cd59d67d8cd069e8a8": "\u5355\u51fb\u94c5\u7b14\u56fe\u6807\u53ef\u6fc0\u6d3b\u201c\u7f16\u8f91\u5173\u6ce8\u533a\u57df\u201d\u8868\u5355\u3002\u4f7f\u7528\u8be5\u8868\u5355\u53ef\u66f4\u6539\u5df2\u4fdd\u5b58\u7684\u533a\u57df\u3002", "90ad79d5393f543a89076c25355eed34": "\u5728\u9009\u62e9\u4e86\u5e95\u56fe\u6587\u4ef6\u540e\uff0c\u7cfb\u7edf\u5c06\u63d0\u793a\u4e3a\u5e95\u56fe\u6307\u5b9a\u4e00\u4e2a\u540d\u79f0\u3002\u5728\u51b3\u5b9a\u597d\u540d\u79f0\u540e\uff0c\u70b9\u51fb\u5c4f\u5e55\u5e95\u90e8\u7eff\u8272\u7684\u201c\u5bfc\u5165\u5e95\u56fe\u201d\u56fe\u6807\u3002", "d63d4dab713f8a8ee2fb2ff2938214b2": "\u9009\u62e9\u6570\u636e\u4e0b\u8f7d\u6240\u7528\u683c\u5f0f\u65f6\uff0c\u5c06\u5728\u8ba1\u7b97\u673a\u4e0a\u6fc0\u6d3b\u6570\u636e\u4e0b\u8f7d\u8fdb\u7a0b\u3002", "9ca2092e4be4d3ed151dedff73bf0e37": "\u201c\u9ed8\u8ba4\u201d\u4e16\u754c\u5730\u5f62\u56fe\u9002\u7528\u4e8e\u5728\u5730\u56fe\u4e0a\u5c06\u6570\u636e\u6e05\u695a\u5730\u53ef\u89c6\u5316\u3002", "b86f73e66dda626a1761e15ff739cf5e": "\u901a\u8fc7 Forest Watcher\uff0c\u53ef\u4ee5\u5c06\u81ea\u5b9a\u4e49\u5e95\u56fe\u548c\u5173\u8054\u56fe\u5c42\u76f4\u63a5\u4e0a\u4f20\u5230\u79fb\u52a8\u7aef app\u3002\u8fd9\u662f\u4e00\u9879\u521b\u65b0\u529f\u80fd\uff0c\u9002\u5408\u8981\u7528\u5730\u70b9\u7279\u5b9a\u4fe1\u606f\u8865\u5145 GFW \u6570\u636e\u7684\u7528\u6237\u3002", "05be447500b695560edca09e18e08485": "<strong>\u6570\u636e\u56fe\u5c42\u91cd\u65b0\u6392\u5e8f</strong>\u3002\u5728\u5411\u5730\u56fe\u4e2d\u6dfb\u52a0\u6570\u636e\u56fe\u5c42\u65f6\uff0c\u6dfb\u52a0\u7684\u56fe\u5c42\u5c06\u6309\u6dfb\u52a0\u987a\u5e8f\u51fa\u73b0\u5728\u56fe\u4f8b\u7684\u9876\u90e8\u3002\u6700\u4e0a\u9762\u7684\u6570\u636e\u56fe\u5c42\u5c06\u51fa\u73b0\u5728\u5730\u56fe\u4e0a\u5176\u4ed6\u6570\u636e\u56fe\u5c42\u7684\u4e0a\u65b9\u3002\u8981\u5c06\u6570\u636e\u56fe\u5c42\u91cd\u65b0\u6392\u5e8f\uff0c\u8bf7\u9009\u62e9\u4efb\u4f55\u6570\u636e\u56fe\u5c42\u540d\u79f0\u5de6\u8fb9\u7684\u62d6\u653e\u56fe\u6807\uff0c\u5c06\u8be5\u56fe\u5c42\u6309\u9700\u8981\u62d6\u653e\u5230\u5176\u4ed6\u6570\u636e\u56fe\u5c42\u7684\u4e0a\u65b9\u6216\u4e0b\u65b9\u3002", "78836625a3b51ceb5130ef4d4d2a8421": "\u70b9\u51fb\u8bbe\u7f6e\u9f7f\u8f6e\u56fe\u6807\u53ef\u8bbf\u95ee\u53ef\u7528\u7684\u5730\u56fe\u8bbe\u7f6e\u3002", "72c83193d02325faead34a1596028322": "\u53ef\u81ea\u5b9a\u4e49\u5e95\u56fe\u53ef\u7528\u4e8e\u76d1\u6d4b\u533a\u57df\uff0c\u4f20\u8fbe\u53ef\u80fd\u53d1\u751f\u68ee\u6797\u780d\u4f10\u7684\u5730\u70b9\u4fe1\u606f\uff0c\u662f\u6700\u91cd\u8981\u7684 GFW \u5de5\u5177\u4e4b\u4e00\u3002GFW \u63d0\u4f9b\u4e86\u4e00\u7cfb\u5217\u5e95\u56fe\uff0c\u53ef\u5e2e\u52a9\u5728\u5730\u56fe\u4e0a\u53ef\u89c6\u5316\u548c\u8c03\u67e5\u5173\u6ce8\u533a\u57df\u3002", "9b028a995df7163e8913045d209e3c24": "\u5355\u51fb\u201c\u67ec\u57d4\u5be8\u201d\u53ef\u6fc0\u6d3b\u5206\u6790\u5e76\u751f\u6210\u8be5\u56fd\u7684\u7ed3\u679c\u3002", "09924d109a468d34df8669ca0483ae75": "\u603b\u4e4b\uff0c\u901a\u8fc7\u63d0\u4f9b\u591a\u4e2a\u533a\u57df\u7f16\u8f91\u548c\u7ec4\u7ec7\u9009\u9879\uff0cGFW \u8ba9\u5df2\u4fdd\u5b58\u533a\u57df\u7684\u7ba1\u7406\u53d8\u5f97\u5bb9\u6613\u3002", "120301ce446c4533a4adb3bc6eafe2e2": "\u5728\u641c\u7d22\u4e86\u5173\u6ce8\u7684\u6570\u636e\u56fe\u5c42\u540e\uff0c\u641c\u7d22\u7ed3\u679c\u5e94\u8be5\u4f1a\u51fa\u73b0\u5728\u641c\u7d22\u529f\u80fd\u751f\u6210\u7684\u5217\u8868\u4e2d\u3002\u5355\u51fb\u6570\u636e\u56fe\u5c42\u5c06\u5f97\u5230\u4e00\u4e2a\u7f51\u9875\uff0c\u5176\u4e2d\u5305\u542b\u5143\u6570\u636e\u4fe1\u606f\u3001\u5c5e\u6027\u3001\u5730\u56fe\u53ef\u89c6\u5316\u5185\u5bb9\u3001\u6570\u636e\u6765\u6e90\u3001\u201c\u4e0b\u8f7d\u201d\u4e0b\u62c9\u83dc\u5355\u4ee5\u53ca\u201cAPI\u201d\u4e0b\u62c9\u83dc\u5355\u3002", "17be7b82ebd230121f1adfbd80cbe13f": "\u53ef\u901a\u8fc7\u5e95\u56fe\u7ba1\u7406\u9875\u9762\u8bbf\u95ee\u81ea\u5b9a\u4e49\u5e95\u56fe\u3002", "818f8556f7abcc7b76a94426e92e05f4": "\u4f7f\u7528\u6700\u8fd1\u7684\u536b\u661f\u56fe\u50cf\u5de5\u5177", "5f39403fc3815818cab149cdde84f4b1": "\u5730\u56fe\u548c\u4eea\u8868\u677f", "d89d36968371d62b4fcbe8a7b111a1f3": "\u9700\u8981\u9009\u62e9\u4e00\u4e2a\u4f4d\u7f6e\u5c06\u6587\u4ef6\u4fdd\u5b58\u5728\u8bbe\u5907\u4e0a\u3002", "7867f17ac5ae1c549182b30a60be0d5c": "\u6709\u5173\u5730\u56fe\u548c\u4eea\u8868\u677f\u7684\u5e38\u89c1\u95ee\u9898\uff0c\u8bf7\u8bbf\u95ee<a href=\"{{0}}\">\u8fd9\u91cc</a>\u3002", "6637ce24748ba25f653955aa112c7a48": "\u4e0a\u4f20\u5173\u8054\u56fe\u5c42", "d3ed64529d21ef354fb4a5e45e15a9b6": "<strong>\u8c03\u6574\u67e5\u770b\u6570\u636e\u7684\u65e5\u671f\u8303\u56f4</strong>\u3002\u8981\u67e5\u770b\u663e\u793a\u4e86\u65f6\u95f4\u6ed1\u5757\u7684\u6570\u636e\u56fe\u5c42\u7684\u4e0d\u540c\u65e5\u671f\u8303\u56f4\uff0c\u53ef\u62d6\u653e\u65f6\u95f4\u6ed1\u5757\u7684\u4e24\u7aef\uff0c\u76f4\u5230\u8bbe\u7f6e\u4e3a\u9700\u8981\u67e5\u770b\u7684\u65e5\u671f\u8303\u56f4\u3002\u6b64\u8bbe\u7f6e\u4e5f\u9002\u7528\u4e8e\u4efb\u4f55\u6570\u636e\u56fe\u8868\u4ee5\u53ca\u5728\u8fd0\u884c\u5206\u6790\u65f6\u586b\u5145\u7684\u6570\u503c\u3002\u6709\u4e9b\u6570\u636e\u56fe\u5c42\u63d0\u4f9b\u65e5\u5386\u6765\u9009\u62e9\u65e5\u671f\u8303\u56f4\u2014\u2014\u5bf9\u4e8e\u8fd9\u4e9b\u56fe\u5c42\uff0c\u53ef\u4ece\u65e5\u5386\u4e2d\u9009\u62e9\u5f00\u59cb\u65e5\u671f\u548c\u7ed3\u675f\u65e5\u671f\u3002", "77d4f087b2d35bdfeacc2361f2a343df": "Forest Watcher \u7528\u6237\u53ef\u4ee5\u8ddf\u5176\u4ed6\u7528\u6237\u5171\u4eab\u5b58\u50a8\u5728\u5176 app \u4e0a\u7684\u6240\u6709\u5185\u5bb9\u2014\u2014\u533a\u57df\u3001\u62a5\u544a\u3001\u8def\u7ebf\u3001\u5e95\u56fe\u548c\u5173\u8054\u56fe\u5c42\u3002\u6b64\u9009\u9879\u53ef\u4f9b\u79bb\u7ebf\u548c\u5728\u7ebf\u4f7f\u7528\u3002\u8bf7\u6ce8\u610f\uff0c\u8981\u52a0\u8f7d\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u9884\u8b66\uff0c\u9700\u8981\u6709\u4e92\u8054\u7f51\u6216\u8702\u7a9d\u6570\u636e\u8fde\u63a5\u3002", "f75499178b6e2edf8efff9616bf8c69e": "\u9009\u62e9\u9996\u9009\u5750\u6807\u683c\u5f0f\u3002", "e2411f434182ccf6465fb5d622cfd297": "\u5728\u5730\u56fe\u4e0a\u8bbf\u95ee\u5173\u6ce8\u533a\u57df\u3002", "2359fa95cf1124ec02533d55569077e9": "\u8981\u5f00\u59cb\uff0c\u8bf7\u5bfc\u822a\u81f3\u4e3b\u9875\uff0c\u7136\u540e\u70b9\u51fb\u201c\u8bbe\u7f6e\u201d\u3002\u5728\u8bbe\u7f6e\u9875\u9762\u4e0a\uff0c\u53ef\u901a\u8fc7\u70b9\u51fb\u76f8\u5e94\u7684\u56fe\u6807\u8bbf\u95ee\u5e95\u56fe\u6216\u5173\u8054\u56fe\u5c42\u3002", "f316c0bb0b3c3bfafaa0f8c27a21f2a3": "\u8f93\u5165 UTM \u5750\u6807\u53ef\u5728\u5730\u56fe\u4e0a\u76f4\u63a5\u5bfc\u822a\u5230\u8be5\u5730\u70b9\u3002", "d9eb476c8af3143d3af19115cb9110f9": "Google \u536b\u661f\u5e95\u56fe\u63d0\u4f9b\u5730\u7403\u8868\u9762\u7684\u9ad8\u5206\u8fa8\u7387\u89c6\u56fe\u3002", "66e6c8e9082bd628c9b10f6a78b1271f": "\u6eda\u52a8\u5230\u5f39\u51fa\u7a97\u53e3\u7684\u5e95\u90e8\uff0c\u7136\u540e\u5355\u51fb\u201c\u4e0b\u8f7d\u6570\u636e\u201d\u3002", "5ec84837b5894ef791aa99b15309a1c5": "\u5bf9\u4e8e\u5355\u9009\u548c\u591a\u9009\u683c\u5f0f\uff0c\u5982\u679c\u9009\u62e9\u4e86\u7279\u5b9a\u7b54\u6848\uff0c\u53ef\u4f7f\u7528\u6761\u4ef6\u8bed\u53e5\u8bf7\u6c42\u66f4\u591a\u4fe1\u606f\u3002", "ab4eb3aabc646640f9bf189026003be5": "\u201c\u5730\u7403\u8d44\u6e90\u536b\u661f\u201d(Landsat) \u5e95\u56fe\u63d0\u4f9b 2013 \u5e74\u81f3 2017 \u5e74\u7684\u9ad8\u5206\u8fa8\u7387\u5386\u53f2\u56fe\u50cf\u3002", "771806cbf0e38aa01cb27f055e11ede9": "\u6d4f\u89c8\u5176\u4ed6\u6750\u6599\u2014\u2014\u5305\u62ec\u5408\u4f5c\u4f19\u4f34\u5236\u4f5c\u7684\u57f9\u8bad\u6750\u6599\uff0c\u4ee5\u53ca\u5b58\u6863\u7684 GFW \u6559\u7a0b\u2014\u2014\u4ee5\u4e86\u89e3\u5982\u4f55\u4f7f\u7528\u5730\u56fe\u548c\u4eea\u8868\u677f\u6765\u76d1\u6d4b\u68ee\u6797\u53d8\u5316\u60c5\u51b5\u3002", "408657c1fb17349e2e3d9423a0a48d70": "\u5b8c\u6210\u540e\uff0c\u5355\u51fb\u201c\u6dfb\u52a0\u56fe\u5c42\u201d\uff0c\u5c06\u81ea\u52a8\u4e0b\u8f7d\u5173\u8054\u56fe\u5c42\u3002\u4e0b\u8f7d\u7684\u5173\u8054\u56fe\u5c42\u4f4d\u4e8e\u7ba1\u7406\u5173\u8054\u56fe\u5c42\u9875\u9762\u4e0a\u7684\u201cGFW \u56fe\u5c42\u201d\u4e0b\u3002", "95bf56b2e558de749487f2c88cb98cd1": "\u901a\u8fc7\u5355\u51fb\u4e0b\u62c9\u83dc\u5355\uff0c\u9009\u62e9\u9996\u9009\u95ee\u9898\u683c\u5f0f\u3002\u53ef\u7528\u7684\u683c\u5f0f\u6709\u4e94\u79cd\uff1a\u6587\u672c\u3001\u56fe\u50cf\u3001\u5355\u9009\u3001\u591a\u9009\u548c\u6570\u503c\u3002", "1aab870f30adc2ddefe40dbb07c511e8": "\u5355\u51fb\u201c\u4e0b\u8f7d\u7b54\u6848\u201d\u53ef\u7528 .csv \u6587\u4ef6\u683c\u5f0f\u4e0b\u8f7d\u6240\u6709\u62a5\u544a\u4e2d\u7684\u7b54\u6848\u3002\u8fd9\u6709\u52a9\u4e8e\u4e00\u6b21\u6027\u67e5\u770b\u56e2\u961f\u63d0\u4ea4\u7684\u6240\u6709\u62a5\u544a\u3002", "c74ecfd311191c665036fb6626e5301a": "\u5728\u9876\u90e8\u83dc\u5355\u4e0a\u5355\u51fb\u201c\u6a21\u677f\u201d\u53ef\u5bfc\u822a\u5230\u6a21\u677f\u7f51\u9875\u3002\u5728\u6b64\u5904\uff0c\u53ef\u4ee5\u521b\u5efa\u548c\u7ba1\u7406\u62a5\u544a\u6a21\u677f\u3002\u56e2\u961f\u53ef\u4ee5\u4f7f\u7528\u62a5\u544a\u6a21\u677f\u8bb0\u5f55\u5728\u91ce\u5916\u7684\u4efb\u4f55\u53d1\u73b0\u3002", "64e1c1a8671c6a37ba209fc04057e47f": "\u5355\u51fb\u201c\u521b\u5efa\u6a21\u677f\u201d\u53ef\u521b\u5efa\u65b0\u7684\u62a5\u544a\u6a21\u677f\u3002", "dccefbf1a4fe9711c58a95f6a02fd73f": "\u7ec4\u7ec7\u8d26\u6237\u63d0\u4f9b\u66f4\u9ad8\u7ea7\u7684\u7f51\u7edc\u5730\u56fe\u5236\u4f5c\u529f\u80fd\uff0c\u9002\u7528\u4e8e\u5728\u56e2\u4f53\u3001\u56e2\u961f\u6216\u7ec4\u7ec7\u4e2d\u5de5\u4f5c\u7684\u7528\u6237\u3002\u9664\u4e86\u516c\u5171\u8d26\u6237\u529f\u80fd\u4ee5\u5916\uff0c\u7ec4\u7ec7\u8d26\u6237\u7528\u6237\u8fd8\u53ef\u4f7f\u7528\u79c1\u5bc6\u6570\u636e\u548c\u5730\u56fe\u5171\u4eab\u529f\u80fd\u3002", "dca299ba74b5c9d66124753659a6e7de": "\u4efb\u4f55\u89c4\u6a21\u7684\u516c\u53f8\u6216\u94f6\u884c\u5747\u53ef\u4f7f\u7528 GFW Pro \u6765\u5206\u6790\u548c\u7ba1\u7406\u68ee\u6797\u780d\u4f10\u98ce\u9669\u3002", "69e3bd366e93a41ccd59f1400c58794a": "\u70b9\u51fb\u5de6\u4e0a\u65b9\u7684\u5411\u540e\u7bad\u5934\u6765\u8bbf\u95ee\u4e3b\u9875\u3002\u5728\u6b64\u5904\uff0c\u70b9\u51fb\u201c\u8bbe\u7f6e\u201d\u5e76\u6309\u63a5\u4e0b\u6765\u7684\u56db\u4e2a\u6b65\u9aa4\u64cd\u4f5c\uff0c\u53ef\u4e86\u89e3\u53ef\u7528\u7684 app \u8bbe\u7f6e\u3002", "d7173bce910199605bbf873cfe02ea62": "\u7136\u540e\uff0c\u7cfb\u7edf\u5c06\u63d0\u793a\u9009\u62e9\u5173\u8054\u56fe\u5c42\u7c7b\u578b\uff0c\u6709\u4e24\u4e2a\u9009\u9879\uff1a\u6dfb\u52a0 GFW \u56fe\u5c42\uff0c\u6216\u8005\u6dfb\u52a0\u81ea\u5df1\u7684\u5173\u8054\u56fe\u5c42\u3002", "60442857ba19b73c25d3770cc65c746c": "\u9009\u62e9\u201c\u5750\u6807\u201d\u641c\u7d22\u53ef\u8f93\u5165\u7279\u5b9a\u5173\u6ce8\u533a\u57df\u7684\u5750\u6807\u3002\u5728\u8f93\u5165\u5750\u6807\u4fe1\u606f\u540e\uff0c\u5355\u51fb\u201c\u524d\u5f80\u5730\u70b9\u201d\uff0c\u5730\u56fe\u5c06\u81ea\u52a8\u8c03\u6574\u5230\u8be5\u5730\u70b9\u3002", "748402e146973a3ccb7182e1ee811c95": "\u5c06 GFW \u5e94\u7528\u4e8e\u5de5\u4f5c", "0ddd1f373a4426393528bc31dab780ed": "\u6bcf\u79cd\u5185\u5bb9\u7c7b\u578b\u7684\u5de5\u4f5c\u6d41\u7a0b\u662f\u76f8\u540c\u7684\u3002\u5bfc\u822a\u5230\u9002\u7528\u7684\u9875\u9762\uff0c\u5355\u51fb\u9875\u9762\u5e95\u90e8\u7684\u201c\u5171\u4eab\u201d\u56fe\u6807\u3002\u5bf9\u4e8e\u5e95\u56fe\uff0c\u4ec5\u80fd\u5bfc\u51fa\u548c\u5171\u4eab\u5df2\u4e0a\u4f20\u7684\u81ea\u5b9a\u4e49\u5e95\u56fe\u3002<a href=\"{{0}}\">\u5728\u6b64\u5904</a>\u8fdb\u4e00\u6b65\u4e86\u89e3\u5982\u4f55\u4e0a\u4f20\u5e95\u56fe\u3002", "af51cd8d99c9ccfefe092c71f00dab52": "\u60a8\u5173\u6ce8\u7684\u56fd\u5bb6\u4f1a\u51fa\u73b0\u5728\u5730\u56fe\u4e0a\u3002\u53ef\u4ee5\u6fc0\u6d3b\u5173\u8054\u5c42\uff0c\u5982\u4fdd\u62a4\u533a\u4e0e\u6cb9\u68d5\u79cd\u690d\u56ed\u8fb9\u754c\uff0c\u6216\u5728\u6307\u5b9a\u5e74\u4efd\u54ea\u4e9b\u533a\u57df\u53d1\u751f\u4e86\u6811\u6728\u8986\u76d6\u51cf\u5c11\uff0c\u4ee5\u5e2e\u52a9\u786e\u5b9a\u60a8\u5173\u6ce8\u7684\u533a\u57df\u3002\u6b32\u6fc0\u6d3b\u5173\u8054\u5c42\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u56db\u4e2a\u6b65\u9aa4\u3002", "aa281e8091de187190d54754aa7c0ed0": "\u63a2\u7a76\u8be6\u7ec6\u8bf4\u660e\uff0c\u5b66\u4e60\u5982\u4f55\u4f7f\u7528 Forest Watcher \u79bb\u7ebf\u6216\u73b0\u573a\u76d1\u6d4b\u68ee\u6797\u3002", "e802d3da93755764c3f6e2002f03aeb7": "\u4f7f\u7528\u514d\u8d39\u7684\u516c\u7528\u8d26\u53f7\uff0c\u7528\u6237\u53ef\u4ee5\u521b\u5efa\u5e76\u7ba1\u7406\u5730\u56fe\u3001\u5e94\u7528\u3001\u6587\u4ef6\uff0c\u5e76\u4e0e\u4ed6\u4eba\u5171\u4eab\u3002\u60a8\u4e5f\u80fd\u8bbf\u95ee\u5168\u4e16\u754c\u5176\u4ed6 GIS \u7528\u6237\u5206\u4eab\u7684\u5185\u5bb9\u3002\u516c\u7528\u8d26\u6237\u4ec5\u9650\u4e8e\u975e\u5546\u4e1a\u7528\u9014\u3002", "6c3e8b42c67f310038d9ef878ad7ec2b": "\u6b32\u7ed8\u5236\u5f62\u72b6\uff0c\u5355\u51fb\u201c\u5f00\u59cb\u7ed8\u5236\u201d\uff0c\u7136\u540e\u5355\u51fb\u5730\u56fe\uff0c\u653e\u7f6e\u591a\u4e2a\u70b9\u5b9a\u4e49\u6240\u5173\u6ce8\u7684\u533a\u57df\u3002\u9700\u8981\u8fd4\u56de\u5e76\u5355\u51fb\u6700\u5f00\u59cb\u653e\u7f6e\u7684\u70b9\uff0c\u4ee5\u4f7f\u5f62\u72b6\u95ed\u5408\u3002", "e973b2c1de785628680ae95049af7eb4": "\u4e00\u65e6\u4fdd\u5b58\u4e86\u60a8\u5173\u6ce8\u7684\u533a\u57df\uff0c\u5c31\u80fd\u5728\u533a\u57df\u7f51\u9875\u5bf9\u5176\u8fdb\u884c\u8bbf\u95ee\u3002", "cc9bc5f500f02255b167778b6f76253d": "\u5728 GFW\uff0c\u53ef\u4ee5\u4fdd\u5b58\u5730\u56fe\u4e0a\u60a8\u5173\u6ce8\u7684\u4efb\u4f55\u533a\u57df\uff0c\u8ba2\u9605\u5e76\u63a5\u6536\u5728\u8fd9\u4e9b\u533a\u57df\u63a2\u6d4b\u7684\u51c6\u5b9e\u65f6\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6216\u706b\u60c5\u8b66\u62a5\u901a\u77e5\u3002\u4fdd\u5b58\u533a\u57df\u6709\u52a9\u4e8e\u6709\u6761\u7406\u5730\u7ec4\u7ec7\u6240\u5173\u6ce8\u7684\u533a\u57df\uff0c\u800c\u65e0\u9700\u5728\u8bbf\u95ee\u65f6\u91cd\u5b9a\u4f4d\u3001\u91cd\u65b0\u4e0a\u4f20\u6216\u91cd\u7ed8\u5f62\u72b6\u3002\u63a5\u6536\u6240\u5173\u6ce8\u533a\u57df\u4efb\u4f55\u68ee\u6797\u5a01\u80c1\u7684\u6700\u65b0\u4fe1\u606f\uff0c\u8fd9\u4e5f\u662f\u4e00\u79cd\u4fbf\u5229\u7684\u65b9\u5f0f\u3002", "7bd02895a283b71f5c08648e1863a103": "\u5728\u8be5\u89c6\u56fe\uff0c\u5355\u51fb\u201c\u6309\u6807\u7b7e\u8fc7\u6ee4\u201d\u53ef\u4ee5\u6309\u7167\u4efb\u4f55\u6307\u5b9a\u7684\u6807\u7b7e\u8fc7\u6ee4\u533a\u57df\u3002\u968f\u5373\u51fa\u73b0\u4e00\u4e2a\u4e0b\u62c9\u83dc\u5355\uff0c \u83dc\u5355\u4e2d\u5305\u542b\u60a8\u6240\u521b\u5efa\u7684\u4efb\u4f55\u6807\u7b7e\uff0c\u53ef\u4ee5\u5355\u51fb\u4e00\u4e2a\u6216\u591a\u4e2a\u6807\u7b7e\uff0c\u4ee5\u663e\u793a\u5e26\u6709\u6240\u9009\u6807\u7b7e\u7684\u6240\u6709\u533a\u57df\u3002", "234b08f5a954525960e20cd50edacd40": "\u5355\u51fb\u9876\u90e8\u83dc\u5355\u7684\u201c\u533a\u57df\u201d\uff0c\u6d4f\u89c8\u533a\u57df\u7f51\u9875\u3002\u5728\u60a8\u7684\u8d26\u6237\u4e2d\u4fdd\u5b58\u7684\u533a\u57df\u5c06\u5728\u6b64\u663e\u793a\u3002\u5173\u6ce8\u7684\u533a\u57df\u7531\u60a8\u5b9a\u4e49\uff0c\u8fd8\u53ef\u4ee5\u5206\u914d\u7ed9\u56e2\u961f\uff0c\u4ee5\u76d1\u6d4b\u533a\u57df\u4e2d\u7684\u68ee\u6797\u53d8\u5316\u3002\u6b32\u521b\u5efa\u4e00\u4e2a\u65b0\u7684\u5173\u6ce8\u533a\u57df\uff0c\u5355\u51fb\u201c\u6dfb\u52a0\u533a\u57df\u201d\u3002", "f9d81005562aeb5099db81354a92eae5": "\u4e0a\u4f20\u81ea\u5b9a\u4e49\u7684\u5173\u8054\u5c42", "ed0a577adbccfe375d483140270f29fb": "\u8c01\u4f7f\u7528\u5730\u56fe\u548c\u6570\u636e\u9762\u677f\uff1f", "9f052e25534dfd240436f126fb631441": "\u5355\u51fb\u201c\u5206\u6790\u201d\u6807\u7b7e\u9875\u8bbf\u95ee\u5de5\u5177\u3002", "3cba918045b010c20a60ccdeea903f5e": "\u6570\u636e\u9762\u677f\u4ee5\u4e92\u52a8\u6570\u636e\u8868\u7684\u5f62\u5f0f\uff0c\u63d0\u4f9b\u6613\u4e8e\u8bbf\u95ee\u7684\u68ee\u6797\u53d8\u5316\u8d8b\u52bf\u7edf\u8ba1\u6570\u636e\u3002\u53ef\u4ee5\u5b9a\u5236\u5e76\u5206\u4eab\u5168\u7403\u3001\u67d0\u4e2a\u56fd\u5bb6\u3001\u5730\u65b9\u533a\u57df\u53ca\u81ea\u5b9a\u4e49\u533a\u57df\u7684\u6570\u636e\u3002\u4e0b\u9762\u4ecb\u7ecd\u4e00\u4e9b\u5173\u952e\u529f\u80fd\uff0c\u8ba9\u60a8\u80fd\u5728\u6570\u636e\u9762\u677f\u4e2d\u5b9a\u5236\u5e76\u5171\u4eab\u6570\u636e\u3002", "d46a7feb08174a3e1ee27f86d16ed921": "\u8f7b\u6309\u4e3b\u9875\u7684\u201c\u8def\u7ebf\u201d\uff0c\u8bbf\u95ee\u8def\u7ebf\u9875\u9762\u3002\u8f7b\u6309\u4e0b\u8f7d\u56fe\u6807\u4e0b\u8f7d\u8def\u7ebf\u3002\u4e0b\u8f7d\u5b8c\u6210\u540e\uff0c\u5b83\u4f1a\u53d8\u6210\u4e00\u4e2a\u52fe\u53f7\u6807\u8bb0\u3002", "309db6bf0567525f988f7a9970b73eb3": "\u8f7b\u6309\u53f3\u4e0a\u65b9\u7684\u7684 \u201c+\u201d \u56fe\u6807\uff0c\u6dfb\u52a0\u4e00\u4e2a\u5173\u6ce8\u7684\u533a\u57df\u3002", "30d57776a51484e2752d1b66c3d556c3": "\u767b\u5f55\u540e\uff0c\u9996\u5148\u9009\u62e9\u56fd\u5bb6\u521b\u5efa\u6240\u5173\u6ce8\u7684\u533a\u57df\u3002\u6b32\u67e5\u770b\u56fd\u5bb6\u5217\u8868\uff0c\u8f7b\u6309\u641c\u7d22\u56fe\u6807\u6216\u8f93\u5165\u56fd\u5bb6\u540d\u79f0\u3002 \u9009\u5b9a\u6240\u5173\u6ce8\u7684\u56fd\u5bb6\u4e4b\u540e\uff0c\u8f7b\u6309\u201c\u4e0b\u4e00\u6b65\u201d\u3002", "73bd478497803b6f30e8978a028e0472": "<strong>\u4e86\u89e3\u60a8\u6240\u67e5\u770b\u6570\u636e\u7684\u66f4\u591a\u4fe1\u606f</strong>\u3002\u5355\u51fb\u6570\u636e\u5c42\u53f3\u4fa7\u7684 \u201ci\u201d \u4fe1\u606f\u56fe\u6807\uff0c\u627e\u5230\u6570\u636e\u6e90\u3001\u7814\u7a76\u65b9\u6cd5\u3001\u53ef\u7528\u65f6\u95f4\u6bb5\u53ca\u5176\u5b83\u5173\u4e8e\u6570\u636e\u5c42\u7684\u91cd\u8981\u7ec6\u8282\u3002\u8fd9\u4f1a\u6fc0\u6d3b\u4e00\u4e2a\u5f39\u51fa\u7a97\u53e3\uff0c\u5176\u4e2d\u63d0\u4f9b\u66f4\u591a\u4fe1\u606f\u53ca\u4e0b\u8f7d\u94fe\u63a5\u3002", "a400291cba116ccd1897cbae2cc77e5e": "\u76d1\u6d4b\u68ee\u6797\u53d8\u5316", "d2e9a8df36fc8d1c50ebdeb038e5ec61": "\u4f7f\u7528\u5730\u56fe", "ba479ee99e6920a15efc1db055460206": "\u4e00\u65e6\u53d1\u5e03\u5e76\u4fdd\u5b58\u62a5\u544a\u6a21\u677f\uff0c\u5b83\u5c31\u4f1a\u81ea\u52a8\u66ff\u4ee3\u6240\u9009\u533a\u57df\u7684\u57fa\u7ebf\u62a5\u544a\u6a21\u677f\u3002\u53ef\u4ee5\u5728\u6a21\u677f\u7f51\u9875\u8bbf\u95ee\u62a5\u544a\u6a21\u677f\u3002", "a47f99b91dd6125469989ae18c272344": "\u5355\u51fb\u201d\u6dfb\u52a0\u533a\u57df\u201c\uff0c\u521b\u5efa\u4e00\u4e2a\u65b0\u7684\u5173\u6ce8\u533a\u57df\u3002", "5559a466dc0d2501ddc497f1600b8ccc": "\u5728\u5730\u56fe\u4e0a\u81ea\u5b9a\u4e49\u53ef\u89c1\u7684\u8def\u7ebf\u3002", "e54ea50dda5d70c2ede5f90472832688": "\u6b32\u4f7f\u7528MapBuilder\uff0c\u9700\u8981\u4e00\u4e2a<a href=\"{{0}}\" target=\"_blank\" aria-label=\"undefined (opens in a new tab)\" rel=\"noreferrer noopener\"> ArcGIS Online</a>\u8d26\u6237\uff0c\u8fd9\u53ef\u4ee5\u662f\u514d\u8d39\u7684\u516c\u5171\u8d26\u6237\u6216\u4ed8\u8d39\u7684\u673a\u6784\u8d26\u6237\u3002\u4e24\u79cd\u8d26\u6237\u90fd\u80fd\u8ba9\u60a8\u6709\u8bbf\u95eeMapBuilder \u7684\u6743\u9650\uff0c\u4f46\u662f\u6709\u4e00\u4e9b\u91cd\u8981\u533a\u522b\u9700\u8981\u6ce8\u610f\uff1a", "7423751a34b76781b289274561040247": "Forest Watcher \u5e38\u89c1\u95ee\u9898\u4e0e\u89e3\u7b54\uff0c\u8bf7\u8bbf\u95ee<a href=\"{{0}}\">\u8fd9\u91cc</a>\u3002", "d3fafe8c011234e81fc6d8b1ef3390b4": "\u9009\u62e9\u56fd\u5bb6\u540e\uff0c\u518d\u6b21\u5355\u51fb\u4e0b\u62c9\u83dc\u5355\uff0c\u9009\u62e9\u6216\u641c\u7d22\u8fd9\u4e2a\u56fd\u5bb6\u7684\u67d0\u4e2a\u533a\u57df\u3002", "e38a763989209a1328a6da01eeec5b7d": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Amaz\u00f3nicos por la Amazon\u00eda (AMPA)</a> \u4e8e 2020 \u5e74 9 \u6708\u521b\u5efa\u4e86 Forest Watcher \u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u6559\u7a0b\u89c6\u9891\uff0c\u6f14\u793a\u5982\u4f55\u4f7f\u7528 Forest Watcher \u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u3002\u8be5\u89c6\u9891\u63d0\u4f9b\u897f\u73ed\u7259\u8bed\u7248\u3002", "16b568e47b3108788e6c52f0c9768b7a": "\u201d\u6697\u8272\u80cc\u666f\u201c\u5e95\u56fe\u5e72\u51c0\u7b80\u6d01\uff0c\u4fbf\u4e8e\u67e5\u770b\u5730\u56fe\u4e0a\u7684\u6570\u636e\u3002", "10f4622536f33433ad00773377ec6b67": "\u5bfc\u51fa\u6240\u6709\u5e94\u7528\u5185\u5bb9", "8e2a9388dfa038df029a90f4e8c8986b": "\u4ece\u6211\u4eec\u7684\u8be6\u7ec6\u8bf4\u660e\u3001\u7f51\u7edc\u7814\u8ba8\u4f1a\u3001\u5176\u4ed6\u57f9\u8bad\u6750\u6599\u53ca\u5e38\u89c1\u95ee\u9898\u4e0e\u89e3\u7b54\u5f00\u59cb\u8d77\u6b65\u3002", "c2d287efa879d9d6105ce9302ac0582f": "\u5728\u6587\u672c\u6846\u91cc\u8f93\u5165\u4f60\u4eec\u56e2\u961f\u7684\u540d\u79f0\uff0c\u5c06\u6240\u5173\u6ce8\u7684\u5173\u8054\u533a\u57df\u5206\u914d\u7ed9\u56e2\u961f\u3002\u53ef\u4ee5\u9009\u62e9\u591a\u4e2a\u5173\u6ce8\u7684\u533a\u57df\u3002\u8f93\u5165\u7535\u5b50\u90ae\u4ef6\u5730\u5740\uff0c\u7136\u540e\u5355\u51fb\u201d\u6dfb\u52a0\u201c\uff0c\u5373\u53ef\u6dfb\u52a0\u56e2\u961f\u6210\u5458\u3002\u56e2\u961f\u6210\u5458\u5fc5\u987b\u62e5\u6709 MyGFW \u8d26\u6237\u3002\u5b8c\u6210\u540e\uff0c\u5355\u51fb\u201d\u4fdd\u5b58\u201c\u3002\u5df2\u6dfb\u52a0\u7684\u56e2\u961f\u6210\u5458\u4f1a\u6536\u5230\u4e00\u5c01\u786e\u8ba4\u7535\u5b50\u90ae\u4ef6\u3002", "0ea82e6309f4a718e5422ec32e76ce12": "Forest Watcher \u62a5\u544a\u5bfc\u51fa\u6587\u6863\u4e8e 2019 \u5e74 5 \u6708\u521b\u5efa\uff0c\u5c55\u793a\u5982\u4f55\u4ece\u67d0\u4e2a\u8bbe\u5907\u5bfc\u51fa Forest Watcher \u79fb\u52a8\u5e94\u7528\u4fdd\u5b58\u7684\u62a5\u544a\u3002\u6587\u6863\u4e2d\u8bf4\u660e\u5982\u4f55\u4eceiOS \u6216\u5b89\u5353\u8bbe\u5907\u5bfc\u51fa\u62a5\u544a\uff0c\u6587\u6863\u4e3a\u82f1\u6587\u7248\u3002", "fce8405ff97ae58747f8e316ba04e0f9": "\u5982\u679c\u6709\u5174\u8da3\u67e5\u770b\u6307\u5b9a\u56fd\u5bb6\u6216\u5730\u65b9\u533a\u57df\u7684\u68ee\u6797\u7edf\u8ba1\u6570\u636e\uff0c\u8bf7\u5355\u51fb\u4e0b\u62c9\u83dc\u5355\uff0c\u641c\u7d22\u6216\u9009\u62e9\u4e00\u4e2a\u56fd\u5bb6\u3002\u9009\u5b9a\u56fd\u5bb6\u540e\uff0c\u53ef\u4ee5\u5355\u51fb\u4e0b\u4e00\u4e2a\u4e0b\u62c9\u83dc\u5355\uff0c\u9009\u62e9\u5730\u65b9\u533a\u57df\u3002", "34307a7161dfb745474f8ebef7c20a6f": "\u4ece\u8fd9\u91cc\u8f7b\u6309\u201c\u5171\u4eab\u201d\uff0c\u5e76\u9009\u62e9\u5171\u4eab\u65b9\u5f0f\u3002\u53ef\u4ee5\u901a\u8fc7\u77ed\u4fe1\u3001\u7535\u5b50\u90ae\u4ef6\u3001WhatsApp\u3001\u84dd\u7259\u6216\u8bbe\u5907\u63d0\u4f9b\u7684\u4efb\u610f\u5176\u4ed6\u65b9\u5f0f\u5171\u4eab\u6587\u4ef6\u3002", "2962e6f26cdb06a7940a9924a6a21c90": "\u81ea\u5b9a\u4e49\u5730\u56fe\u89c6\u56fe", "d17bdc2c2c35ba9c13c418d2934641e5": "\u653e\u5927\u5730\u56fe\uff0c\u7136\u540e\u5355\u51fb\u6240\u5173\u6ce8\u7684\u5730\u65b9\u533a\u57df\u3002", "1f867a6d5e0c2a5bae783d6d2d04a73d": "\u8f7b\u6309\u5173\u8054\u5c42\u65c1\u8fb9\u7684\u5706\u5708\uff0c\u6fc0\u6d3b\u5173\u8054\u5c42\u3002", "e14cb78ac1e2672abd2511862a988fc4": "\u6dfb\u52a0\u6761\u4ef6\u9648\u8ff0\uff0c\u8be2\u95ee\u66f4\u591a\u4fe1\u606f\u3002", "ff9e54244c81f525b7a96bb737f80386": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5730\u56fe</a>\u6709\u52a9\u4e8e\u53ef\u89c6\u5316\u67d0\u4e2a\u7279\u5b9a\u5730\u65b9\u7684\u68ee\u6797\u72b6\u51b5\u3002\u653e\u5927\u4e16\u754c\u4e0a\u7684\u4efb\u4f55\u4e00\u4e2a\u533a\u57df\uff0c\u63a2\u7d22\u68ee\u6797\u6b63\u5728\u53d1\u751f\u54ea\u4e9b\u53d8\u5316\uff0c\u5982\u4f55\u7ba1\u7406\u68ee\u6797\uff0c\u5b83\u4eec\u63d0\u4f9b\u4ec0\u4e48\u4ef7\u503c\u3002\u56fe\u5c42\u6570\u636e\u2014\u2014\u5982\u6811\u6728\u8986\u76d6\u5e74\u635f\u5931\uff0c\u571f\u200b\u200b\u5730\u5229\u7528\u6570\u636e\u53ca\u536b\u661f\u56fe\u50cf\u2014\u2014\u53ef\u4ee5\u66f4\u597d\u5730\u4e86\u89e3\u68ee\u6797\u53d8\u5316\u7684\u6df1\u5c42\u539f\u56e0\u548c\u9020\u6210\u7684\u5f71\u54cd\u3002\u53ef\u4ee5\u5728\u53e6\u4e00\u4e2a\u7f51\u7ad9\u5d4c\u5165\u5730\u56fe\u89c6\u56fe\uff0c\u901a\u8fc7\u793e\u4ea4\u5a92\u4f53\u6216\u7535\u5b50\u90ae\u4ef6\u5171\u4eab\uff0c\u6216\u5728\u62a5\u544a\u4e2d\u4f7f\u7528\u5c4f\u5e55\u622a\u56fe\u3002", "712814fa99400d4c6e6066421fc87023": "<strong>\u6d4f\u89c8\u5e76\u9009\u62e9\u6570\u636e</strong>\u3002\u53ef\u7528\u6570\u636e\u5c42\u6309\u7c7b\u522b\u7ec4\u7ec7\u3002\u53ef\u4ee5\u5c06\u201d\u68ee\u6797\u53d8\u5316\u201c\u7c7b\u522b\u4e2d\u7684\u6570\u636e\uff08\u5305\u62ec\u6811\u6728\u8986\u76d6\u5e74\u635f\u5931\u3001\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u548c\u706b\u707e\u8b66\u62a5\uff09\u4e0e\u5176\u4ed6\u7c7b\u522b\u4e2d\u7684\u5173\u8054\u5c42\u6570\u636e\u2014\u2014\u5982\u201d\u571f\u5730\u8986\u76d6\u201c\u6216\u201c\u571f\u5730\u4f7f\u7528\u201d\u7ed3\u5408\u8d77\u6765\u2014\u2014\u4ee5\u786e\u5b9a\u68ee\u6797\u53d8\u5316\u7684\u6f5c\u5728\u539f\u56e0\u53ca\u5f71\u54cd\u3002\u4e00\u4e9b\u56fd\u5bb6\u8fd8\u63d0\u4f9b\u5176\u4ed6\u4e0e\u56fd\u5bb6\u76f8\u5173\u7684\u6570\u636e\u3002\u8981\u67e5\u770b\u4e0e\u6307\u5b9a\u56fd\u5bb6\u5173\u8054\u7684\u6570\u636e\uff0c\u5728\u7c7b\u522b\u4e2d\u5355\u51fb\u201c+\u6dfb\u52a0\u56fd\u5bb6\u201d\u4e0b\u62c9\u83dc\u5355\uff0c\u7136\u540e\u9009\u62e9\u4e00\u4e2a\u6216\u591a\u4e2a\u56fd\u5bb6\u3002", "2eb193a482219be40c7f548820a0c487": "\u6b32\u5728\u5730\u56fe\u4e0a\u8fd0\u884c\u4e00\u4e2a\u56fd\u5bb6\u6216\u5730\u65b9\u7ea7\u522b\u7684\u5206\u6790\uff0c\u5148\u5355\u51fb\u4f4d\u4e8e\u56fe\u4f8b/\u5206\u6790\u9762\u677f\u4e0a\u7684\u201c\u5206\u6790\u201d\u6807\u7b7e\u9875\u3002", "d04c9a80984de6e22ce53a00078f3788": "\u6b32\u521b\u5efa\u60a8\u5173\u6ce8\u7684\u533a\u57df\uff0c\u7528\u624b\u6307\u8f7b\u6309\u5c4f\u5e55\u653e\u7f6e\u591a\u4e2a\u70b9\u3002\u8fd9\u4e9b\u70b9\u7528\u6765\u5b9a\u4e49\u533a\u57df\u7684\u8fb9\u754c\u3002\u5b8c\u6210\u5f62\u72b6\u4e4b\u540e\uff0c\u5355\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\u8fdb\u884c\u4fdd\u5b58\u3002", "ee0ecc6dea5d12dd59a0f1a30544f1bc": "\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u6fc0\u6d3b\u201c\u5730\u57df\u8303\u56f4\u201d\uff0c\u8868\u793a\u5176\u8986\u76d6\u8303\u56f4\u3002", "0ef287cbe356f5b1281ce889781c9864": "\u8f7b\u6309\u201d\u5171\u4eab\u6240\u6709\u5e94\u7528\u6570\u636e\u201c\uff0c\u4e0e\u53e6\u4e00\u8bbe\u5907\u5171\u4eab\u5e94\u7528\u5185\u5bb9\u3002", "1778139d355f9e6e314df0f53c251a9d": "\u5b8c\u6210\u533a\u57df\u5f62\u72b6\u540e\uff0c\u5206\u6790\u5c06\u81ea\u52a8\u8fd0\u884c\uff0c\u5e76\u5728\u5206\u6790\u6807\u7b7e\u9875\u751f\u6210\u6570\u636e\u8868\u3002", "2986751faefbbe18187f72a7f199e339": "\u67e5\u770b\u68ee\u6797\u8d8b\u52bf", "54715a50730068a6573fe1318c797c7e": "\u8f7b\u6309\u53f3\u4e0a\u65b9\u7684\u9f7f\u8f6e\u72b6\u8bbe\u7f6e\u56fe\u6807\uff0c\u8bbf\u95ee\u5173\u8054\u5c42\u3002", "bcebba9aa1fa4a706c7845fbde4fd04b": "\u89c6\u9891\u7531 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">AMPA</a> \u521b\u5efa\u3002", "3ef9ed56f6fdaf29c6a2e2e7e894d706": "\u8f7b\u6309\u5173\u8054\u5c42\u53f3\u4fa7\u7684\u5706\u5708\uff0c\u5373\u53ef\u9009\u62e9\u60f3\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u7684\u5173\u8054\u5c42\u3002\u9009\u5b9a\u540e\uff0c\u5c06\u51fa\u73b0\u4e00\u4e2a\u7eff\u8272\u7684\u9009\u4e2d\u6807\u8bb0\u3002", "23a9ee574f877c1e366cdaa2f6c98092": "\u8868\u5355\u5e95\u90e8\u6709\u4e00\u4e2a\u95ee\u9898\uff0c\u201c\u662f\u5426\u613f\u610f\u63a5\u6536\u8b66\u62a5\u901a\u77e5\uff1f\u201d\uff0c\u6709\u4e24\u4e2a\u9009\u9879\uff1a\u201c\u4e00\u65e6\u53d1\u73b0\u706b\u707e\u201d\u548c\u201c\u4e00\u65e6\u53d1\u73b0\u68ee\u6797\u53d8\u5316\u201d\u3002\u5982\u679c\u9009\u62e9\u63a5\u6536\u901a\u77e5\uff0c\u60a8\u6240\u5173\u6ce8\u533a\u57df\u7684\u68ee\u6797\u780d\u4f10\u548c/\u6216\u706b\u707e\u8b66\u62a5\u901a\u77e5\uff0c\u4f1a\u53d1\u9001\u5230\u8868\u683c\u4e2d\u6307\u5b9a\u7684\u7535\u5b50\u90ae\u4ef6\u5730\u5740\u3002\u5355\u51fb\u201c\u4fdd\u5b58\u201d\uff0c\u4ee5\u6210\u529f\u4fdd\u5b58\u5e76\u8ba2\u9605\u60a8\u6240\u5173\u6ce8\u7684\u533a\u57df\u3002", "ef09e985f13e34c6b5dadcb9810ef4b3": "\u60a8\u4e5f\u53ef\u4ee5\u4e0a\u4f20\u81ea\u5df1\u7684\u5f62\u72b6\u6587\u4ef6\u3002\u6b32\u4e0a\u4f20\u5f62\u72b6\u6587\u4ef6\uff0c\u5728\u7535\u8111\u4e0a\u9009\u62e9\u6587\u4ef6\uff0c\u62d6\u653e\u5230\u5206\u6790\u76d2\u3002\u6bcf\u6b21\u53ea\u80fd\u4e0a\u4f20\u5e76\u5206\u6790\u4e00\u4e2a\u5f62\u72b6\u6587\u4ef6\uff1b\u4f46\u662f\uff0c\u4e0a\u4f20\u5230\u5730\u56fe\u7684\u5f62\u72b6\u6587\u4ef6\u603b\u6570\u6ca1\u6709\u9650\u5236\u3002\u5efa\u8bae\u6587\u4ef6\u5927\u5c0f\u6700\u5927\u4e3a 1MB\u2014\u2014 \u4efb\u4f55\u5927\u4e8e 1MB \u7684\u6587\u4ef6\u53ef\u80fd\u65e0\u6cd5\u6b63\u5e38\u5de5\u4f5c\u3002", "205901fce4ae67d62a682b8238da00a3": "\u5341\u5b57\u7ebf\u56fe\u6807\u6307\u5411\u60a8\u5728\u5730\u56fe\u4e0a\u7684\u5f53\u524d\u4f4d\u7f6e\u3002", "c71eb10829c4f263f637c23fab7951ca": "\u4f7f\u7528\u6570\u636e\u9762\u677f", "2fd1f1d455b553ef0cbb13f5a6e35413": "<strong>\u6d4f\u89c8\u6570\u636e\u8868\u548c\u68ee\u6797\u7edf\u8ba1\u6570\u636e</strong>\u3002\u6570\u636e\u8868\u6309\u7c7b\u522b\u7ec4\u7ec7\u3002\u5355\u51fb\u67d0\u4e2a\u7c7b\u522b\u5e76\u5411\u4e0b\u6eda\u52a8\uff0c\u67e5\u770b\u571f\u5730\u8986\u76d6\u3001\u68ee\u6797\u53d8\u5316\u3001\u571f\u5730\u4f7f\u7528\u3001\u706b\u707e\u6216\u6c14\u5019\u7b49\u6570\u636e\u8868\u53ca\u7edf\u8ba1\u6570\u636e\u3002", "a6c760d7bbbc259ec6b41634dbccef1d": "\u4ece\u5730\u56fe\u4e0b\u8f7d\u6570\u636e\u65f6\uff0c\u5355\u51fb\u4f4d\u4e8e\u83dc\u5355\u6216\u56fe\u4f8b/\u5206\u6790\u9762\u677f\u4e0a\u7684\u6570\u636e\u5c42\u65c1\u8fb9\u7684 \u201ci\u201d \u4fe1\u606f\u56fe\u6807\u3002", "b248e3de0eeffb9d9a0ca1cd50bcd5da": "\u7ed9\u4f60\u4eec\u7684\u56e2\u961f\u53d6\u4e2a\u540d\u5b57\uff0c\u9009\u62e9\u5206\u914d\u7ed9\u5b83\u7684\u533a\u57df\uff0c\u5e76\u6dfb\u52a0\u56e2\u961f\u6210\u5458\u3002", "c0a46b24ab6b429e447d350db6cd8783": "\u5355\u51fb\u9053\u8def\u56fe\u6807\uff0c\u81ea\u5b9a\u4e49\u5730\u56fe\u4e0a\u662f\u5426\u663e\u793a\u9053\u8def\u3002\u9ed8\u8ba4\u9009\u62e9\u201c\u9690\u85cf\u9053\u8def\u201d\u3002", "800bba12a611f28bf22bf13417ffdfa1": "\u6253\u5370\u8fd9\u7bc7\u6587\u7ae0", "d4309956ab18fbac703d535c008aa4e2": "\u5728\u4e92\u8054\u7f51\u8fde\u63a5\u6027\u4e0d\u597d\u7684\u60c5\u51b5\u4e0b\uff0cForest Watcher \u4ecd\u80fd\u5bfc\u51fa\u6216\u4e0e\u53e6\u4e00\u8bbe\u5907\u5171\u4eab\u5185\u5bb9\uff0c\u8fd9\u662f Forest Watcher \u79fb\u52a8\u5e94\u7528\u7684\u4e00\u5927\u521b\u65b0\u4eae\u70b9\u3002\u533a\u57df\u3001\u62a5\u544a\u3001\u8def\u7ebf\u3001\u5e95\u56fe\u53ca\u5173\u8054\u5c42\u5747\u53ef\u79bb\u7ebf\u5bfc\u51fa\uff0c\u5e76\u4e0e\u53e6\u4e00\u8bbe\u5907\u5171\u4eab\u3002\u4e0b\u9762\u6709\u4e00\u4e9b\u6b65\u9aa4\uff0c\u8bf4\u660e\u5982\u4f55\u5c06\u6240\u6709\u5e94\u7528\u5185\u5bb9\u5bfc\u51fa\u5230\u8bbe\u5907\uff0c\u5982\u4f55\u628a\u5355\u4e2a\u6587\u4ef6\u5bfc\u51fa\u5230\u8bbe\u5907\uff0c\u5982\u4f55\u4e0e\u53e6\u4e00\u8bbe\u5907\u5171\u4eab\u5e94\u7528\u5185\u5bb9\uff0c\u4ee5\u53ca\u5982\u4f55\u5bfc\u5165\u4e0e\u60a8\u5171\u4eab\u7684\u6587\u4ef6\u3002", "7a3d6730d603ab6467445c2b84e0366d": "<strong>\u62a5\u544a</strong>\uff1a\u5728\u62a5\u544a\u7f51\u9875\u4e0a\u8bbf\u95ee\u6240\u6709\u63d0\u4ea4\u7684\u62a5\u544a\u3002\u62a5\u544a\u7531\u56e2\u961f\u6210\u5458\u586b\u5199\u5e76\u63d0\u4ea4\uff0c\u5176\u4e2d\u5305\u62ec\u4ed6\u4eec\u5728\u73b0\u573a\u53d1\u73b0\u7684\u4fe1\u606f\u3002", "761cb044b1630cffad83674faf4e4974": "\u624b\u56fe\u5f62\u7531 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Rawpixel</a> \u63d0\u4f9b\u3002", "32d93a7fba035bf22d9a33ac8659dca7": "\u6700\u65b0\u536b\u661f\u56fe\u50cf\u529f\u80fd", "68883ec1a322baf3eb743c132776f318": "\u8c01\u4f7f\u7528 Forest Watcher\uff1f", "0a1714cc5478d7af81ea33710baef71e": "\u6bcf\u4e2a\u529f\u80fd\u5c4f\u5e55\u7684\u5e95\u90e8\u6709\u4e00\u4e2a\u201c\u5171\u4eab\u201d\u56fe\u6807\uff0c\u8f7b\u6309\u5b83\u4f1a\u5f00\u542f\u6587\u4ef6\u5171\u4eab\u8fdb\u7a0b\u3002", "f512d56313d0295f7085e3f116488dee": "\u4ee5\u4e0b\u662f\u8bbe\u7f6e\u5e94\u7528\u7684\u4e00\u4e2a\u5178\u578b\u5de5\u4f5c\u6d41\uff0c\u5b9a\u4e49\u6240\u5173\u6ce8\u7684\u533a\u57df\uff0c\u8c03\u6574\u5e94\u7528\u8bbe\u7f6e\uff0c\u79bb\u7ebf\u5bfc\u822a\u81f3\u68ee\u6797\u780d\u4f10\u6216\u706b\u8b66\u533a\u57df\uff0c\u6839\u636e\u6240\u53d1\u73b0\u7684\u5185\u5bb9\u521b\u5efa\u62a5\u544a\u3002", "b432ef66493d4a6692f05327fb5a8b0e": "\u6b32\u4f7f\u7528\u6700\u65b0\u7684\u536b\u661f\u56fe\u50cf\u5de5\u5177\uff0c\u5c06\u5341\u5b57\u7ebf\u7f6e\u4e8e\u5730\u56fe\u4e0a\u5173\u6ce8\u533a\u57df\u7684\u4e2d\u5fc3\uff0c\u7136\u540e\u5355\u51fb\u4f4d\u4e8e\u5e95\u90e8\u7684\u536b\u661f\u56fe\u6807\uff0c\u5c31\u80fd\u5c06\u5176\u6fc0\u6d3b\u3002\u8be5\u5de5\u5177\u4ec5\u5bf9\u7f6e\u4e8e\u9646\u5730\u4e0a\u7684\u5341\u5b57\u7ebf\u6709\u6548\u3002\u4e3a\u5f97\u5230\u6700\u4f73\u6548\u679c\uff0c\u6fc0\u6d3b\u5de5\u5177\u4e4b\u524d\uff0c\u8bf7\u5148\u653e\u5927\u6307\u5b9a\u4f4d\u7f6e\u3002", "7933aa017b538a1efec975fad0d4b8ed": "\u201c\u4f4d\u7f6e\u201d\u641c\u7d22\u662f\u9ed8\u8ba4\u7684\u3002\u5728\u641c\u7d22\u680f\u8f93\u5165\u56fd\u5bb6\u3001\u5730\u533a\u3001\u5730\u5740\u3001\u5730\u6807\uff0c\u6216\u81ea\u7136\u7279\u5f81\u3002\u5b8c\u6210\u8f93\u5165\u540e\uff0c\u76f8\u5173\u533a\u57df\u4f1a\u81ea\u52a8\u5728\u7a97\u53e3\u4e2d\u663e\u793a\u3002\u82e5\u5728\u641c\u7d22\u7ed3\u679c\u4e2d\u672a\u770b\u5230\u6307\u5b9a\u533a\u57df\u6216\u4f4d\u7f6e\uff0c\u8bf7\u68c0\u67e5\u62fc\u5199\uff0c\u6216\u641c\u7d22\u9644\u8fd1\u4f4d\u7f6e\uff0c\u6216\u901a\u8fc7 <a href=\"{{0}}\">gfw@wri.org</a> \u8054\u7cfb\u6211\u4eec\u5bfb\u6c42\u652f\u6301\u3002", "063d2188bf5fb6520db2197cedcd4869": "\u82e5\u4e0a\u4f20\u5f62\u72b6\u6587\u4ef6\u521b\u5efa\u5173\u6ce8\u7684\u533a\u57df\uff0c\u5355\u51fb\u5de6\u4e0b\u65b9\u7684\u201c\u4e0a\u4f20\u5f62\u72b6\u6587\u4ef6\u201d\uff0c\u5e76\u9009\u62e9\u7535\u8111\u4e2d\u5df2\u6709\u7684\u5f62\u72b6\u6587\u4ef6\u3002\u6587\u4ef6\u5927\u5c0f\u6700\u5927\u4e3a 1MB\uff0c\u6700\u5927\u7684\u533a\u57df\u9762\u79ef\u4e3a 1,500 \u5e73\u65b9\u516c\u91cc\uff08150,000 \u516c\u9877\uff09\u3002\u5355\u51fb \u201ci\u201d \u4fe1\u606f\u56fe\u6807\uff0c\u4e86\u89e3\u5173\u4e8e\u5f62\u72b6\u6587\u4ef6\u7684\u8be6\u7ec6\u9650\u5236\u6761\u4ef6\u3002\u4e00\u65e6\u5b8c\u6210\u5f62\u72b6\u6587\u4ef6\u4e0a\u4f20\uff0c\u5b83\u5c31\u4f1a\u51fa\u73b0\u5728\u5730\u56fe\u4e0a\u3002", "7cf779028e81c5c4a019238bbac6887a": "\u4ece GFW \u6dfb\u52a0\u4e00\u4e2a\u5173\u8054\u5c42\uff0c\u6216\u5bfc\u5165\u81ea\u5df1\u7684\u5173\u8054\u5c42\u3002", "90dea8fe700f52f7f5a0838fe9be3b9d": "\u6839\u636e\u60a8\u6240\u4f7f\u7528\u7684\u8bbe\u5907\uff0c\u4ece Google Play \u6216 Apple App Store \u4e0b\u8f7d Forest Watcher \u79fb\u52a8\u5e94\u7528\u3002\u6253\u5f00\u5e94\u7528\u540e\uff0c\u5c4f\u5e55\u4e0a\u4f1a\u51fa\u73b0\u6559\u7a0b\u3002", "394d60a2c481187150668ce164d86d18": "\u5206\u6790\u4f1a\u6fc0\u6d3b\u5e76\u751f\u6210\u8be5\u533a\u57df\u7684\u7ed3\u679c\u3002", "6af6c63d32a8271e6d335bf069db139e": "\u9009\u62e9\u60a8\u5173\u6ce8\u7684\u56fd\u5bb6\uff0c\u7136\u540e\u5355\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\u3002", "9967f783b70168587f1dd1e6caf2b0d3": "\u9009\u62e9\u201c\u9646\u5730\u751f\u6001\u533a\u201d\uff0c\u663e\u793a\u57fa\u4e8e RESOLVE \u751f\u6001\u533a\u6570\u636e\u7684\u9646\u5730\u751f\u6001\u533a\u3002", "0b98ddf78a3c8764a68e882f48c2a5a3": "\u536b\u661f\u56fe\u50cf", "9e9b177bbdd07593080391cc631ead6f": "\u7b2c\u4e00\u6b21\u8bbf\u95ee\u6570\u636e\u9762\u677f\u65f6\uff0c\u9ed8\u8ba4\u4f1a\u770b\u5230\u5168\u7403\u68ee\u6797\u7edf\u8ba1\u4fe1\u606f\u3002", "868135ea2cbf522959956f4add03f26b": "\u6709\u4e00\u4e9b\u9009\u9879\u53ef\u4ee5\u7528\u6765\u67e5\u770b\u6570\u636e\u8868\u4e2d\u7684\u66f4\u591a\u4fe1\u606f\u3002", "2271d138ff7764ecd61f5b930fd06ee7": "\u5355\u51fb\u201c\u641c\u7d22\u201d\u7c7b\u522b\uff0c\u9009\u62e9\u60f3\u641c\u7d22\u7684\u7c7b\u578b\u3002", "0ae2396f172acad53882667a0b53cdaf": "\u4ece Forest Watcher \u5bfc\u51fa\u62a5\u544a", "5aed57eedaccbbe7eb2020b6a8797a30": "\u7528\u5341\u8fdb\u5236\u5ea6\u6570\u8f93\u5165\u7eac\u5ea6\u548c\u7ecf\u5ea6\uff0c\u5373\u53ef\u76f4\u63a5\u5bfc\u822a\u81f3\u5730\u56fe\u4e0a\u7684\u90a3\u4e2a\u4f4d\u7f6e\u3002", "293951dfc72be0ace46f726302d9bd07": "\u6570\u636e\u5c42\u4e0e\u5206\u6790\u5de5\u5177\u517c\u5bb9", "36a8a2e8855b583c328c12f2f877e1d7": "\u6811\u6728\u8986\u76d6\u51cf\u5c11\u81f4\u4f7f\u4e0d\u900f\u660e\u5ea6\u964d\u4f4e\uff0c\u63d0\u4f9b\u4e86\u66f4\u6e05\u6670\u7684\u5e95\u56fe\u663e\u793a\u3002", "dc6e152c89aa2dcd9c34c2e75f284742": "\u8f7b\u6309\u4e0b\u8f7d\u56fe\u6807\uff0c\u4e0b\u8f7d\u533a\u57df\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "42f810958c6541496ba7e2e5e30fd5d5": "\u5b9a\u5236\u7684\u5e95\u56fe\u4f1a\u81ea\u52a8\u4e0b\u8f7d\u5230\u5e94\u7528\uff0c\u5728\u7ba1\u7406\u5e95\u56fe\u9875\u9762\u7684\"\u5b9a\u5236\u5e95\u56fe\"\u4e2d\u5e94\u80fd\u627e\u5230\u3002\u73b0\u5728\u67e5\u770b\u6240\u5173\u6ce8\u7684\u533a\u57df\u65f6\uff0c\u5c31\u80fd\u8bbf\u95ee\u6240\u5b9a\u5236\u7684\u5e95\u56fe\u3002", "4fc13acb016056a2c426040d33abf666": "\u9009\u62e9\u201c\u9690\u85cf\u6807\u8bc6\u201d\u53bb\u9664\u5730\u56fe\u4e0a\u7684\u6240\u6709\u6807\u8bc6\u3002", "6e834ae0a56821be395482a668106613": "\u8f7b\u6309\u8bbe\u7f6e\u9875\u9762\u7684\u201c\u5173\u8054\u5c42\u201d\u3002\u60a8\u53ef\u4ee5\u5728\u8fd9\u91cc\u7ba1\u7406\u5e94\u7528\u4e2d\u5b58\u50a8\u7684\u7684\u6240\u6709\u5173\u8054\u5c42\uff0c\u5305\u62ec GFW \u63d0\u4f9b\u7684\u548c\u60a8\u81ea\u5df1\u7684\u5173\u8054\u5c42\u3002\u8f7b\u6309\u53f3\u4e0a\u65b9\u7684 \u201c+\u201d \u56fe\u6807\uff0c\u6dfb\u52a0\u4e00\u4e2a\u65b0\u7684\u5173\u8054\u5c42\u3002", "439cabf31ac7a31193470c37e1236725": "\u6700\u65b0\u7684\u536b\u661f\u56fe\u50cf\u6709\u52a9\u4e8e\u51c6\u5b9e\u65f6\u5730\u663e\u73b0\u67d0\u4e2a\u533a\u57df\u7684\u6837\u8c8c\uff0c\u4fc3\u8fdb\u68ee\u6797\u53d8\u5316\u6570\u636e\u7684\u786e\u8ba4\uff0c\u5982\u68ee\u6797\u780d\u4f10\u6216\u706b\u707e\u8b66\u62a5\u3002", "cce19889c05ee45655032f09afff10ff": "\u5173\u6ce8\u7684\u533a\u57df<em>\uff08\u53ef\u4ee5\u5355\u51fb\u5b9a\u4e49\u4e86\u8fb9\u754c\u7684\u6570\u636e\u5c42\uff0c\u5c06\u5176\u4f5c\u4e3a\u5206\u6790\u76ee\u6807\uff09</em>", "36bac6449a9467f81e0b181c25836e6e": "\u5355\u51fb\u533a\u57df\u5de6\u4fa7\u7684\u56fe\u50cf\uff0c\u8bbf\u95ee\u5176\u6570\u636e\u9762\u677f\u3002", "6b5fe25c9d9a624749d27631e58ae464": "\u54cd\u5e94\u534f\u8bae", "ee0f17d01d1eac6c1acebe62aa75d64e": "\u964d\u4f4e\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u7684\u4e0d\u900f\u660e\u5ea6\uff0c\u4ee5\u66f4\u6e05\u6670\u5730\u89c2\u770b\u8b66\u62a5\u4e0b\u7684\u536b\u661f\u56fe\u50cf\u3002<a href=\"{{0}}\">\u5728\u8fd9\u91cc</a>\u4e86\u89e3\u5982\u4f55\u964d\u4f4e\u6570\u636e\u5c42\u4e0d\u900f\u660e\u5ea6\u7684\u66f4\u591a\u4fe1\u606f\u3002\u5728\u4e0b\u9762\u7684\u4f8b\u5b50\u4e2d\uff0c\u6839\u636e\u8b66\u62a5\u6240\u5728\u7684\u68d5\u8272\u533a\u57df\uff0c\u6709\u8bc1\u636e\u8868\u660e\uff0c\u6574\u4e2a\u533a\u57df\u90fd\u6709\u7a7a\u5730\u3002", "6732453193210d624d71fdf65f847349": "\u5355\u51fb\u201d\u4e0a\u4f20\u5f62\u72b6\u6587\u4ef6\u201c\uff0c\u4ece\u60a8\u7684\u7535\u8111\u4e0a\u4f20\u4e00\u4e2a\u5f62\u72b6\u6587\u4ef6\u3002", "83ee4cea8578a65c19f0870a12667684": "\u6fc0\u6d3b\u201c\u79bb\u7ebf\u6a21\u5f0f\u201d\uff0c\u5373\u53ef\u79bb\u7ebf\u4f7f\u7528\u5e94\u7528\u3002\u6fc0\u6d3b\u540e\uff0c\u56fe\u6807\u4f1a\u53d8\u6210\u7eff\u8272\u3002", "fc2723eabf1f0fd0f29080921c814507": "\u9009\u62e9\u201c\u81ea\u7136\u5f69\u8272\u201d\u67e5\u770b\u53ef\u89c1\u5149\u56fe\u50cf\uff0c\u663e\u793a\u4eba\u773c\u4e2d\u6240\u5448\u73b0\u7684\u5730\u7403\u8868\u9762\u3002", "f5c4b1c295d19a2c236cf9f555b39c45": "\u5c3d\u7ba1 Forest Watcher \u4e3a\u8fde\u63a5\u6027\u4e0d\u597d\u7684\u73af\u5883\u800c\u8bbe\u8ba1\uff0c\u5e76\u4e14\u53ef\u4ee5\u5b8c\u5168\u79bb\u7ebf\u4f7f\u7528\uff0c\u4f46\u81f3\u5c11\u9700\u8981\u4e00\u4e2a\u7528\u6237\u63a5\u5165\u4e92\u8054\u7f51\uff0c\u624d\u80fd\u66f4\u65b0\u548c\u5237\u65b0\u76f8\u5173\u7684\u68ee\u6797\u76d1\u6d4b\u8b66\u62a5\u548c\u5e95\u56fe\u3002 \u7528\u6237\u4e4b\u95f4\u5171\u4eab\u548c\u63a5\u6536\u6587\u4ef6\uff0c\u4e5f\u9700\u8981\u4e92\u8054\u7f51\u8fde\u63a5\u548c/\u6216\u79fb\u52a8\u670d\u52a1\u3002\u79bb\u7ebf\u7528\u6237\u4ecd\u80fd\u67e5\u770b\u533a\u57df\uff0c\u521b\u5efa\u548c\u7f16\u8f91\u62a5\u544a\uff0c\u4f7f\u7528\u8def\u7ebf\u8ddf\u8e2a\u529f\u80fd\uff0c\u4ee5\u53ca\u5bfc\u51fa\u5e94\u7528\u5185\u5bb9\uff0c\u5f53\u4e92\u8054\u7f51\u6216\u624b\u673a\u670d\u52a1\u6062\u590d\uff0c\u6216\u5f53\u4e00\u4e2a\u7528\u6237\u5237\u65b0\u5176\u5e94\u7528\u7a0b\u5e8f\u5185\u5bb9\u5e76\u4e0e\u53e6\u4e00\u7528\u6237\u5171\u4eab\u65f6\uff0c\u8fd9\u4e9b\u5185\u5bb9\u5373\u53ef\u66f4\u65b0\u3002", "aa307f7f848e7411206c021aa8340464": "\u4ece\u5730\u56fe\u4e0b\u8f7d\u6570\u636e", "943209fd319e1e269688074829d6e094": "<strong>\u8c03\u6574\u6570\u636e\u8bbe\u7f6e\u5e76\u8fdb\u4e00\u6b65\u4e86\u89e3\u6570\u636e</strong>\u3002\u4e00\u65e6\u6fc0\u6d3b\u4e00\u4e2a\u6570\u636e\u5c42\uff0c\u5b83\u5c31\u4f1a\u51fa\u73b0\u5728\u56fe\u4f8b\u4e2d\uff0c\u6240\u6709\u53ef\u7528\u4e8e\u8be5\u6570\u636e\u5c42\u7684\u8bbe\u7f6e\u9009\u9879\u4e5f\u4f1a\u4e00\u540c\u51fa\u73b0\u3002 \u4f8b\u5982\uff0c\u53ef\u4ee5\u4fee\u6539\u67d0\u4e9b\u6570\u636e\u5c42\u7684\u65e5\u671f\u8303\u56f4\u548c\u90c1\u95ed\u5ea6\uff0c\u66f4\u6539\u4e0d\u900f\u660e\u5ea6\uff0c\u4e86\u89e3\u6709\u5173\u6570\u636e\u5c42\u5f15\u7528\u548c\u6ce8\u610f\u4e8b\u9879\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u4ee5\u53ca\u4ece\u56fe\u4f8b\u4e2d\u5220\u9664\u6570\u636e\u5c42\u3002\u8fd8\u53ef\u4ee5\u5c06\u67d0\u4e2a\u6fc0\u6d3b\u7684\u6570\u636e\u5c42\u62d6\u52a8\u5230\u5176\u4ed6\u5df2\u6fc0\u6d3b\u6570\u636e\u5c42\u7684\u56fe\u4f8b\u4e0a\u65b9\u6216\u4e0b\u65b9\uff0c\u800c\u66f4\u6539\u6570\u636e\u5c42\u51fa\u73b0\u7684\u987a\u5e8f\u3002<a href=\"{{0}}\">\u5728\u8fd9\u91cc</a>\u4e86\u89e3\u8c03\u6574\u6570\u636e\u8bbe\u7f6e\u7684\u66f4\u591a\u4fe1\u606f\u3002", "ce443d77879a9e9a314d3f30b4a493d0": "<a aria-label=\"undefined (opens in a new tab)\" href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Small Grants Fund and Tech Fellowship</a>\u652f\u6301\u5168\u4e16\u754c\u7684\u6c11\u95f4\u793e\u56e2\u7ec4\u7ec7\u548c\u4e2a\u4eba\u5728\u4ed6\u4eec\u7684\u5ba3\u4f20\u3001\u7814\u7a76\u548c\u73b0\u573a\u5de5\u4f5c\u4e2d\u4f7f\u7528 GFW\u3002\u6d4f\u89c8\u8fd9\u4e9b\u9879\u76ee\u7684\u5e38\u89c1\u95ee\u9898\u4e0e\u89e3\u7b54\u53ca\u5176\u4ed6\u8d44\u6e90\uff0c\u4ee5\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002", "241d345f733645737ac4ccfb2cef492e": "\u4ece\u53f3\u4e0a\u65b9\u53ef\u4ee5\u8bbf\u95ee\u53ef\u7528\u7684\u6570\u636e\u9762\u677f\u8bbe\u7f6e\u3002", "ae29a821aaf9be06438d5fbd24721129": "\u6570\u636e\u5c42\u8bbe\u7f6e", "e16a0cae54719c0b81229b2366c8720c": "\u8f7b\u6309\u201c\u7ba1\u7406\u5173\u8054\u5c42\u201d\uff0c\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\uff0c\u6216\u4e0e\u5176\u4ed6\u8bbe\u5907\u5171\u4eab\uff0c\u6216\u4e0a\u4f20\u81ea\u5df1\u7684\u5173\u8054\u5c42\u3002\u6b32\u4e0b\u8f7d\u4f9b\u79bb\u7ebf\u4f7f\u7528\u7684\u5173\u8054\u5c42\uff0c\u8f7b\u6309\u5173\u8054\u5c42\u540d\u79f0\u53f3\u4fa7\u7684\u4e0b\u8f7d\u56fe\u6807\u3002\u4e0b\u8f7d\u5b8c\u6210\u540e\uff0c\u5411\u4e0b\u7bad\u5934\u5c06\u53d8\u4e3a\u52fe\u53f7\u6807\u8bb0\u3002\u4e0b\u8f7d\u4f9b\u79bb\u7ebf\u4f7f\u7528\u7684\u5173\u8054\u5c42\uff0c\u80fd\u8ba9\u60a8\u5728\u6ca1\u6709\u4e92\u8054\u7f51\u8fde\u63a5\u7684\u60c5\u51b5\u4e0b\u67e5\u770b\u5b83\u4eec\uff0c\u4f46\u4f1a\u5360\u7528\u8bbe\u5907\u4e0a\u7684\u5b58\u50a8\u7a7a\u95f4\u3002<a href=\"{{0}}\">\u5728\u8fd9\u91cc</a>\u67e5\u9605\u5982\u4f55\u4e0a\u4f20\u81ea\u5df1\u7684\u5173\u8054\u5c42\uff1b\u5982\u4f55\u5206\u4eab\u5305\u542b\u5173\u8054\u5c42\u7684\u5e94\u7528\u5185\u5bb9\uff0c<a href=\"{{1}}\">\u8bf7\u5728\u6b64\u67e5\u9605</a>\u3002", "f941a2c81ea9b2339c3f7e7fd83fa3c7": "\u653e\u5927\u5730\u56fe\u65f6\uff0c\u9009\u62e9\u201d\u663e\u793a\u9053\u8def\u201c\u4ee5\u663e\u793a\u9053\u8def\u3002", "93985d25f2d394fec27b40f3cf68efc7": "\u4e3a\u6570\u636e\u9762\u677f\u4e0a\u7684\u5355\u4e2a\u6570\u636e\u8868\u4e0b\u8f7d .cvs \u6587\u4ef6\u3002\u9996\u5148\uff0c\u9700\u8981\u6309\u7167\u60a8\u7684\u9700\u8981\u914d\u7f6e\u6570\u636e\u8868\u8bbe\u7f6e\uff0c\u7136\u540e\u5728\u6570\u636e\u8868\u4e2d\u5355\u51fb\u4e0b\u8f7d\u56fe\u6807\u3002", "7bc24c1f69dec558b05a70fbc6610612": "\u81ea\u5b9a\u4e49\u5730\u56fe\u6709\u51e0\u4e2a\u9009\u9879\u3002", "2e632445dbc036d59e623f1659c29e4e": "<a href=\"{{0}}\">\u8bf7\u5728\u8fd9\u91cc</a>\u5b66\u4e60\u5982\u4f55\u67e5\u770b\u6570\u636e\u9762\u677f\uff0c\u67e5\u770b\u81ea\u5b9a\u4e49\u5f62\u72b6\u6216\u5df2\u4fdd\u5b58\u533a\u57df\u3002", "db9a57e16e3166e35873339396dfcfda": "<strong>\u8c03\u6574\u6570\u636e\u5c42\u7684\u4e0d\u900f\u660e\u5ea6</strong>\u3002\u5728\u536b\u661f\u56fe\u50cf\u6216\u5e95\u56fe\u4e0a\u8986\u76d6\u6570\u636e\u5c42\u65f6\uff0c\u5f88\u96be\u770b\u5230\u6570\u636e\u5c42\u4e0b\u9762\u663e\u793a\u7684\u5185\u5bb9\u3002\u82e5\u60f3\u8ba9\u6570\u636e\u5c42\u66f4\u900f\u660e\uff0c\u5728\u56fe\u4f8b\u4e0a\u5355\u51fb\u6570\u636e\u5c42\u65c1\u8fb9\u7684\u4e0d\u900f\u660e\u5ea6\u56fe\u6807\uff0c\u7136\u540e\u70b9\u51fb\u5e76\u62d6\u52a8\uff0c\u4f7f\u4e0d\u900f\u660e\u5ea6\u8fbe\u60f3\u8981\u7684\u7a0b\u5ea6\u3002", "db70f9f3806286b7e420a6ad5454508c": "\u9009\u62e9\u4e00\u4e2a\u533a\u57df\uff0c\u4e3a\u5b83\u6307\u5b9a\u62a5\u544a\u6a21\u677f\u53ca\u9ed8\u8ba4\u8bed\u8a00\u3002", "7b0cafe7798ecb1f9885d33fd7c132e9": "\u8bf7\u6309\u60f3\u6dfb\u52a0\u7684\u5173\u8054\u5c42\uff0c\u7136\u540e\u9009\u62e9\u662f\u5426\u4e0b\u8f7d\u6570\u636e\u4f9b\u79bb\u7ebf\u4f7f\u7528\uff0c\u6216\u4ec5\u5728\u7ebf\u65f6\u8bbf\u95ee\u3002", "a01e32a52a383a3e34485a5f249d9069": "\u7f51\u9875\u4f1a\u76f4\u63a5\u5e26\u60a8\u8fdb\u5165\u5f00\u653e\u6570\u636e\u95e8\u6237\u6216\u5916\u90e8\u7f51\u7ad9\u7684\u6570\u636e\u4e0b\u8f7d\u9875\u9762\u2014\u2014\u901a\u5e38\u662f\u6570\u636e\u63d0\u4f9b\u8005\u7684\u673a\u6784\u7f51\u7ad9\u2014\u2014\u60a8\u53ef\u4ee5\u5728\u90a3\u91cc\u4e0b\u8f7d\u5173\u6ce8\u7684\u6570\u636e\u3002", "fcc29ad7e7c301b4ff82750413126472": "\u5728 Forest Watcher \u7f51\u9875\u4e0a\uff0c\u6709\u4e24\u4e2a\u9009\u9879\u7528\u4e8e\u521b\u5efa\u6240\u5173\u6ce8\u7684\u533a\u57df\uff1a\u5728\u5730\u56fe\u4e0a\u7ed8\u5236\u5f62\u72b6\u6216\u4e0a\u4f20\u5f62\u72b6\u6587\u4ef6\u3002", "3c5c274a6e891f5dac9d619e9275753b": "\u5206\u6790\u4e00\u4e2a\u56fd\u5bb6\u6216\u5730\u65b9\u533a\u57df", "492e93c00d432d49ea94d07de14a511a": "\u603b\u7684\u6765\u8bf4\uff0c\u4ece\u5206\u6790\u5de5\u5177\u7684\u89d2\u5ea6\u8bf4\uff0c\u8003\u8651 GFW \u6570\u636e\u5c42\u6709\u4e24\u79cd\u601d\u8def\u3002\u7b2c\u4e00\u79cd\u662f\u6fc0\u6d3b\u6570\u636e\u5c42\uff0c\u4ee5\u5b9a\u4e49\u8fb9\u754c\uff1b\u7b2c\u4e8c\u79cd\u662f\u6fc0\u6d3b\u6570\u636e\u5c42\uff0c\u4f7f\u5176\u5728\u5206\u6790\u672c\u8eab\u53d1\u6325\u4f5c\u7528\u3002\u6211\u4eec\u53ef\u4ee5\u628a\u8fd9\u79cd\u533a\u522b\u7406\u89e3\u6210\uff1a\u201c\u5173\u6ce8\u7684\u533a\u57df\u201d\u6570\u636e\u5c42\u548c\u201d\u7814\u7a76\u201c\u6570\u636e\u5c42\u3002", "03fea1ccb243987bf7257d40dec4c1cd": "\u4e0b\u9762\u662f\u4e0e\u5206\u6790\u5de5\u5177\u517c\u5bb9\u7684\u6570\u636e\u5c42\uff0c\u5b83\u4eec\u6216\u88ab\u5f52\u7c7b\u4e3a\u201c\u5173\u6ce8\u7684\u533a\u57df\u201d\u6570\u636e\u5c42\uff0c\u6216\u201c\u7814\u7a76\u201d\u6570\u636e\u5c42\u3002", "a422786a53b51971ce6439110022e963": "\u767b\u5f55\u540e\uff0c\u4f60\u5c06\u8fdb\u5165\u533a\u57df\u9875\u9762\u3002\u53ef\u4ee5\u7528\u53f3\u4e0a\u65b9\u7684\u8bed\u8a00\u4e0b\u62c9\u83dc\u5355\u66f4\u6539\u7f51\u7ad9\u6240\u4f7f\u7528\u7684\u8bed\u8a00\u3002", "f4e8bdf5b44e6e55c5ce83b3d7971352": "\u5355\u51fb\u201c\u62a5\u544a\u201d\uff0c\u67e5\u770b\u56e2\u961f\u63d0\u4ea4\u7684\u62a5\u544a\u3002", "dd0e861e4d58aaa33571f210c5208b92": "<strong>\u641c\u7d22\u6570\u636e\u6216\u4f4d\u7f6e</strong>\u3002\u641c\u7d22\u6570\u636e\u5c42\uff0c\u4f4d\u7f6e\uff0c\u5750\u6807\uff0c\u5341\u8fdb\u5236\u5ea6\u6570\u6216UTM \u5750\u6807\u3002<a href=\"{{0}}\">\u5728\u8fd9\u91cc</a>\u4e86\u89e3\u5982\u4f55\u641c\u7d22\u533a\u57df\u7684\u66f4\u591a\u4fe1\u606f\u3002", "c3b91d1c7e0df33058e62b0e7ac7837f": "GFW \u6709\u4e00\u4e9b\u5173\u8054\u5c42\u2014\u2014\u6216\u201c\u5173\u6ce8\u7684\u533a\u57df\u201d\u6570\u636e\u5c42\u2014\u2014\u53ef\u4ee5\u7528\u8fd9\u4e9b\u8fdb\u884c\u7279\u5b9a\u4e8e\u6570\u636e\u7684\u5206\u6790\u3002\u4f8b\u5982\uff0c\u5728\u201c\u571f\u5730\u4f7f\u7528\u201d\u7c7b\u522b\u4e0b\uff0c\u53ef\u4ee5\u6fc0\u6d3b\u201c\u4fdd\u62a4\u533a\u201d\u3002", "ba9640dca6d19f8ad6ed185130067077": "\u5355\u51fb\u4e0b\u62c9\u83dc\u5355\uff0c\u8bbf\u95ee\u6570\u636e\u9762\u677f\u4e2d\u5df2\u4fdd\u5b58\u7684\u81ea\u5b9a\u4e49\u533a\u57df\u3002", "67e927ec255efff055313b22ea4208dc": "\u6709\u4e24\u79cd\u56fe\u50cf\u9009\u9879\u53ef\u9009\uff1a\u81ea\u7136\u5f69\u8272\u6216\u690d\u88ab\u5065\u5eb7\u3002\u81ea\u7136\u5f69\u8272\u56fe\u50cf\u4f7f\u7528\u53ef\u89c1\u5149\uff08\u7ea2\u3001\u7eff\u548c\u84dd\uff09\u4e2d\u7684\u4fe1\u606f\uff0c\u663e\u793a\u4eba\u773c\u4e2d\u6240\u5448\u73b0\u7684\u5730\u7403\u8868\u9762\u3002\u690d\u88ab\u5065\u5eb7\u56fe\u50cf\u5229\u7528\u5f52\u4e00\u5316\u690d\u88ab\u6307\u6570 (NDVI) \u8fdb\u884c\u63a2\u6d4b\uff0c\u8be5\u6307\u6570\u4f7f\u7528\u6765\u81ea\u7ea2\u5149\u548c\u8fd1\u7ea2\u5916\u5149\u7684\u53cd\u5c04\u4fe1\u606f\u3002 NDVI \u65b9\u6cd5\u57fa\u4e8e\u4ee5\u4e0b\u4e8b\u5b9e\uff0c\u5065\u5eb7\u7684\u690d\u7269\u5438\u6536\u5927\u90e8\u5206\u53ef\u89c1\u5149\uff0c\u800c\u53cd\u5c04\u7167\u5c04\u5230\u5176\u8868\u9762\u7684\u5927\u90e8\u5206\u8fd1\u7ea2\u5916\u5149\u3002\u89e3\u6790\u7528\u4e8e\u663e\u793a\u690d\u88ab\u5065\u5eb7\u7684\u56fe\u50cf\u65f6\uff0c\u7ea2\u8272\u8868\u793a\u5065\u5eb7\u751f\u957f\u7684\u690d\u88ab\uff0c\u7eff\u8272\u8868\u793a\u88f8\u9732\u7684\u5730\u9762\uff0c\u9ed1\u8272/\u7d2b\u8272\u8868\u793a\u6c34\u4f53\u3002\u5c3d\u7ba1\u81ea\u7136\u5f69\u8272\u56fe\u50cf\u66f4\u52a0\u76f4\u89c2\uff0c\u4f46\u7531\u4e8e\u56fe\u50cf\u6a21\u7cca\u4e0d\u6e05\uff0c\u5e76\u4e14\u96be\u4ee5\u8bc6\u522b\u7ec6\u5fae\u7279\u5f81\uff0c\u56e0\u6b64\u4e00\u4e9b\u7ec6\u8282\u53ef\u80fd\u4f1a\u4e22\u5931\u3002\u76f8\u53cd\uff0c\u690d\u88ab\u5065\u5eb7\u56fe\u50cf\u7a81\u51fa\u663e\u793a\u571f\u5730\u8986\u76d6\u7684\u5dee\u5f02\uff0c\u4f7f\u56fe\u50cf\u66f4\u6613\u4e8e\u89e3\u6790\u3002", "61592831da6434f372799cd925c9e760": " <a href=\"{{0}}\">\u5728\u8fd9\u91cc</a>\u4e86\u89e3\u5982\u4f55\u6d4f\u89c8\u6570\u636e\u9762\u677f\u7684\u66f4\u591a\u4fe1\u606f\u3002\n", "6a80ce4b13fb5e869a67988cfc094bd5": "\u82e5\u60f3\u81ea\u5b9a\u4e49\u5e76\u8fc7\u6ee4\u5728\u6570\u636e\u8868\u4e2d\u663e\u793a\u7684\u6570\u636e\uff0c\u5355\u51fb\u6570\u636e\u8868\u53f3\u4e0a\u65b9\u9f7f\u8f6e\u72b6\u8bbe\u7f6e\u56fe\u6807\uff0c\u7136\u540e\u6839\u636e\u9700\u8981\u66f4\u6539\u8bbe\u7f6e\u3002", "9f4b74bafdbe354a9e09b6c6ddc84a86": "\u6b32\u6253\u5f00\u6570\u636e\u9762\u677f\u7684\u81ea\u5b9a\u4e49\u533a\u57df\uff0c\u5355\u51fb\u533a\u57df\u56fe\u50cf\u3002", "f5a32c8bb4cf42cbf3ad01a96a748323": "\u4ece\u53f3\u4e0a\u65b9\u8fdb\u5165\u53ef\u7528\u7684\u6570\u636e\u8868\u8bbe\u7f6e\u3002", "2f2e4c06f9d81a2f434a924c85e72dec": "GFW \u63d0\u4f9b\u51e0\u79cd\u65b9\u5f0f\u81ea\u5b9a\u4e49\u5730\u56fe\u89c6\u56fe\u53ca\u67e5\u770b\u6570\u636e\u3002\u4ee5\u4e0b\u4e3a\u8c03\u6574\u5730\u56fe\u548c\u6570\u636e\u5c42\u8bbe\u7f6e\u7684\u6b65\u9aa4\u3002", "a920199635883c69a6eb3c9a33111a23": "\u8f7b\u6309\u201c\u5173\u8054\u5c42\u201d\u4e0b\u65b9\u7684\u9f7f\u8f6e\u72b6\u8bbe\u7f6e\u56fe\u6807\u3002", "a9b9db27db46b3eaff09358c6c9543d9": "<strong>\u653e\u5927\u548c\u7f29\u5c0f\u5730\u56fe</strong>\u3002\u653e\u5927\u6216\u7f29\u5c0f\u5730\u56fe\u6709\u51e0\u4e2a\u9009\u9879\u3002\u7b2c\u4e00\u4e2a\u9009\u9879\u662f\u5c06\u5341\u5b57\u7ebf\u7684\u4e2d\u5fc3\u653e\u5230\u5730\u56fe\u4e0a\u6240\u5173\u6ce8\u533a\u57df\u7684\u4e2d\u5fc3\uff0c\u7136\u540e\u5355\u51fb\u5730\u56fe\u53f3\u4e0b\u65b9\u7684 \u201c-\u201d \u56fe\u6807\u7f29\u5c0f\uff0c\u6216 \u201c+\u201d \u56fe\u6807\u653e\u5927\u3002\u7b2c\u4e8c\u4e2a\u9009\u9879\u662f\u5c06\u9f20\u6807\u60ac\u505c\u5728\u60f3\u770b\u7684\u533a\u57df\u4e0a\uff0c\u7136\u540e\u62e8\u52a8\u9f20\u6807\u7684\u6eda\u8f6e\u6eda\u52a8\u3002\u82e5\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u653e\u5927\u6216\u7f29\u5c0f\uff0c\u53ef\u4ee5\u628a\u4e24\u4e2a\u624b\u6307\u653e\u5230\u5730\u56fe\u4e0a\uff0c\u624b\u6307\u9760\u62e2\u6216\u5206\u5f00\u3002", "152da93a00cef3141a28af802bdec5ac": "\u82e5\u60f3\u4e3a\u533a\u57df\u7f16\u8f91\u540d\u79f0\u3001\u5206\u914d\u6807\u7b7e\uff0c\u7535\u90ae\u8ba2\u9605\u9009\u9879\u6216\u66f4\u6539\u8bed\u8a00\uff0c\u5355\u51fb\u9875\u9762\u53f3\u4e0a\u65b9\u7684\u7684\u94c5\u7b14\u56fe\u6807\u3002", "25176feff585c916d9c6f843e1cf418b": "\u7f29\u5c0f\uff0c\u4ee5\u5728\u56fd\u5bb6\u7ea7\u522b\u9009\u62e9\u5c42\u3002", "dc9f930a4dc02391730c8e843e98233f": "\u8be5\u6570\u636e\u96c6\u662f\u5728 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Global Mangrove Watch (GMW)</a> \u7684\u6846\u67b6\u5185\u751f\u6210\u7684\uff0c\u8be5\u8ba1\u5212\u7531 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Aberystwyth University</a>\u3001<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">soloEO</a>\u3001<a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">The Nature Conservancy</a> \u548c <a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">Wetlands International</a> \u8054\u5408\u53d1\u8d77\u3002", "e8fe57a3cbb965adb46f949453aeee6c": "\u6570\u636e\u96c6 (v3.0) \u63cf\u8ff0\u4e86 1996 \u5e74\u30012007-2010 \u5e74\u548c 2015-2020 \u5e74\u7684\u5168\u7403\u7ea2\u6811\u6797\u5206\u5e03\uff0c\u6570\u636e\u6765\u6e90\u4e8e Japan Aerospace Exploration Agency (JAXA) \u63d0\u4f9b\u7684 L-band Synthetic Aperture Radar (SAR) \u5168\u7403\u9576\u5d4c\u6570\u636e\u96c6\uff0c\u4ece\u800c\u53d1\u5c55\u51fa\u5168\u7403\u7ea2\u6811\u6797\u5206\u5e03\u548c\u53d8\u5316\u7684\u957f\u671f\u65f6\u95f4\u5e8f\u5217\u3002\u8be5\u7814\u7a76\u4f7f\u7528\u5730\u56fe\u5230\u56fe\u50cf\u7684\u65b9\u6cd5\u8fdb\u884c\u53d8\u5316\u68c0\u6d4b\uff0c\u5176\u4e2d\u57fa\u7ebf\u56fe (GMW v2.5) \u4f7f\u7528\u9608\u503c\u548c\u57fa\u4e8e\u73af\u5883\u7684\u7ea2\u6811\u6797\u53d8\u5316\u63a9\u6a21\u8fdb\u884c\u66f4\u65b0\u3002", "5d093dd8a477800735794b6d941d15a1": "(Global Mangrove Watch)", "7e4eb948f31743fd4528a020c49b84a3": "Global Fire Weather Index - 2024 \u5e74 10 \u6708 17 \u65e5", "a13554643b092afb6be892cd7a6a4483": "v3.0 \u4e2d\u7ea2\u6811\u6797\u5206\u5e03\u56fe\u7684\u4f30\u8ba1\u51c6\u786e\u7387\u4e3a 87.4% (95th CI\uff1a86.2% - 88.6%)\u3002\u503c\u5f97\u6ce8\u610f\u7684\u662f\uff0c\u7ea2\u6811\u6797\u7684\u96f6\u6563\u5730\u533a\u5b58\u5728\u6df7\u4e71\uff0c\u5305\u62ec\u6c34\u4ea7\u517b\u6b96\u6c60\u5858\u5468\u56f4\u3002\u5982\u679c\u8bbf\u95ee v3.0 \u6570\u636e\u96c6\u4e2d\u7684\u51c0\u53d8\u5316\u6216\u5355\u4e2a\u589e\u51cf\u6570\u636e\u65f6\uff0c\u5e94\u683c\u5916\u8c28\u614e\u3002v3.0 \u4e2d\u7684\u8bef\u5dee\u6765\u6e90\u5305\u62ec SAR \u9576\u5d4c\u6570\u636e\u96c6\u4e2d\u7684\u914d\u51c6\u9519\u8bef\uff0c\u5bfc\u81f4\u5df2\u77e5\u53d8\u5316\u4e8b\u4ef6\u7684\u9057\u6f0f\u548c\u5df2\u77e5\u672a\u53d1\u751f\u53d8\u5316\u7684\u533a\u57df\u88ab\u8bef\u5224\u3002\u901a\u8fc7\u4f7f\u7528 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Bunting \u7b49\u4eba\uff082010 \u5e74\uff09</a>\u7684\u65b9\u6cd5\u800c\u81ea\u52a8\u751f\u6210\u7684\u8fde\u63a5\u70b9\uff0c\u6b64\u95ee\u9898\u5f97\u5230\u4e86\u90e8\u5206\u7ea0\u6b63\u3002\u7531\u4e8e\u8f93\u5165\u6570\u636e\u7684\u968f\u673a\u6027\uff0c\u4e0e\u914d\u51c6\u9519\u8bef\u76f8\u5173\u7684\u53d8\u5316\u5728\u589e\u51cf\u65b9\u9762\u88ab\u8ba4\u4e3a\u662f\u76f8\u4f3c\u7684\uff0c\u56e0\u6b64\u5efa\u8bae\u5728\u5206\u6790\u65f6\u4f7f\u7528\u89c2\u5bdf\u5230\u7684\u51c0\u53d8\u5316\u7edf\u8ba1\u6570\u636e\uff0c\u800c\u4e0d\u662f\u5355\u4e2a\u589e\u51cf\u7edf\u8ba1\u6570\u636e\u3002<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u7edf\u8ba1\u6570\u636e</a>\u5df2\u7531 GMW \u76f4\u63a5\u63d0\u4f9b\uff0c\u5e76\u5305\u62ec\u5bf9\u8bef\u5224\u548c\u9057\u6f0f\u9519\u8bef\u7684\u4fee\u6b63\u3002&nbsp;", "9d03137ab08c4d0d610badeb5a25d5bf": "\u8be5\u5206\u7c7b\u4f7f\u7528\u7ea2\u6811\u6797\u6816\u606f\u5730\u63a9\u6a21\u8fdb\u884c\u9650\u5236\uff0c\u8be5\u63a9\u819c\u5b9a\u4e49\u4e86\u7ea2\u6811\u6797\u751f\u6001\u7cfb\u7edf\u53ef\u80fd\u5b58\u5728\u7684\u5730\u533a\u3002\u7ea2\u6811\u6797\u6816\u606f\u5730\u7684\u5b9a\u4e49\u57fa\u4e8e\u5730\u7406\u53c2\u6570\uff0c\u5982\u7eac\u5ea6\u3001\u6d77\u62d4\u548c\u8ddd\u6d77\u6c34\u8ddd\u79bb\u3002\u8be5\u6816\u606f\u5730\u63a9\u6a21\u6700\u521d\u5728 GMW v2.0 \u4e2d\u5f00\u53d1\uff0c\u5e76\u5728\u540e\u7eed\u7248\u672c\u4e2d\u8fdb\u884c\u4e86\u4fee\u8ba2\u3002", "95af0e75dbba677c686c4eb838ec122c": "2001 \u5e74\u5269\u4f59\u539f\u59cb\u68ee\u6797\u9762\u79ef\u767e\u5206\u6bd4", "97865e80988fccc45fc31fba9b524721": "2001 \u5e74\u539f\u59cb\u68ee\u6797\u8303\u56f4\u5185\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u9762\u79ef", "7a3c221a4093b32f6d16a17430f6ea29": "\u5b8c\u6210\u6570\u636e\u53ef\u89c6\u5316\u7f16\u8f91\u4e4b\u540e\uff0c\u70b9\u51fb\u201d\u5b8c\u6210\u201c\u3002", "071c3bfa8648d0ffa09e6256685577d3": "\u4e3a\u7f51\u7edc\u5e94\u7528\u62df\u5b9a\u6807\u9898\u3001\u6807\u7b7e\u548c\u6458\u8981\uff0c\u7136\u540e\u9009\u62e9\u4fdd\u5b58\u4f4d\u7f6e\uff0c\u70b9\u51fb\u201c\u5b8c\u6210\u201d\u3002", "eee28161b1f5600f1490cb353f27efe3": "\u6280\u672f\u7814\u7a76\u57fa\u91d1", "3da9fa1bf777a798a59a5fcf76aeb159": "MapBuilder \u8ba9\u60a8\u80fd\u5229\u7528 GFW \u7684\u5206\u6790\u5de5\u5177\uff0c\u5e76\u5c06\u60a8\u81ea\u5df1\u7684\u6570\u636e\u4e0e GFW \u7684\u6838\u5fc3\u6570\u636e\u8fdb\u884c\u6574\u5408\uff0c\u4ece\u800c\u521b\u5efa\u5e76\u81ea\u5b9a\u4e49\u68ee\u6797\u68c0\u6d4b\u5e94\u7528\u7a0b\u5e8f\u3002\u4e0b\u9762\u5b66\u4e60\u5982\u4f55\u7528\u514d\u8d39\u7684\u516c\u7528 ArcGIS Online \u8d26\u6237\u6216\u67d0\u4e2a\u673a\u6784\u7684 ArcGIS Online \u8d26\u6237\uff0c\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\u3002", "11d60fb58e86a99562557b14cdeac01f": "\u6b32\u516c\u5f00\u5206\u4eab\u6258\u7ba1\u8981\u7d20\u670d\u52a1\uff0c\u70b9\u51fb\u53f3\u4fa7\u7684\u201c\u5171\u4eab\u201d\uff0c\u786e\u4fdd\u9009\u4e2d\u201c\u6240\u6709\u4eba\uff08\u516c\u5f00\uff09\u201d\u3002\u5b8c\u6210\u540e\uff0c\u70b9\u51fb\u201d\u4fdd\u5b58\u201c\u3002", "740f30d2cea87f62b5b93996756373cb": "\u5173\u4e8e\u5c0f\u989d\u8d44\u52a9\u91d1\u6216\u6280\u672f\u7814\u7a76\u57fa\u91d1\u7684\u95ee\u9898\uff0c\u6216\u5e0c\u671b\u4e0b\u6b21\u8d44\u91d1\u53ec\u96c6\u5f00\u653e\u65f6\u6536\u5230\u901a\u77e5\uff0c\u8bf7\u5199\u90ae\u4ef6\u7ed9\u6211\u4eec &nbsp;<a class=\"text -paragraph -color-4 -bold\" href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">gfwfund@wri.org</a>\u3002", "5d5e04e48c2130d007fddba353565599": "\u5176\u4ed6\u8bbe\u7f6e\u8ba9\u60a8\u80fd\u66f4\u7cbe\u7ec6\u5730\u81ea\u5b9a\u4e49 MapBuilder \u5e94\u7528\u7a0b\u5e8f\uff0c\u5e76\u4e0e\u76f8\u5173\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u5173\u8054\u3002", "20c87fd4f26fcd9bfd9d9c3cf9b3b6ed": "\u5171\u4eab\u6210\u529f\u540e\uff0c\u53f3\u4e0a\u89d2\u4f1a\u51fa\u73b0\u4e00\u4e2a\u7eff\u8272\u7684\u5f39\u51fa\u7a97\u53e3\u3002", "869eb571ff55d629087ff74288f3409f": "\u70b9\u51fb\u641c\u7d22\u56fe\u6807\u641c\u7d22 \u201cGFW MapBuilder\u201d\u3002", "c625a1de640212e17a550474f27cdebb": "<strong>\u521b\u5efa\u516c\u7528 ArcGIS Online \u8d26\u6237</strong>\u3002\u5bfc\u822a\u5230<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">ArcGIS Online</a>\uff0c\u7528\u73b0\u6709\u51ed\u8bc1\u767b\u5f55\u6216\u521b\u5efa\u65b0\u8d26\u6237\u3002", "c1e4ed7e50575e1821ab8d6d31b69b08": "\u8c03\u6574\u901a\u7528\u8bbe\u7f6e", "27118326006d3829667a400ad23d5d98": "\u5b57\u7b26\u4e32", "dc290c5ab3e8f31bc1976b0228b0b692": "\u5c06\u51e0\u4e2a MapBuilder \u5e94\u7528\u7a0b\u5e8f\u5173\u8054\u8d77\u6765\u3002\u590d\u5236\u53e6\u4e00\u4e2a\u5e94\u7528\u7a0b\u5e8f\u7684 ArcGIS Online \u5e94\u7528\u7a0b\u5e8f ID\uff0c\u5e76\u7c98\u8d34\u5230\u8fd9\u4e2a\u5b57\u6bb5\uff0c\u628a\u5e94\u7528\u7a0b\u5e8f\u5173\u8054\u8d77\u6765\u3002\u5982\u679c\u60a8\u60f3\u6dfb\u52a0\u591a\u4e2a ID\uff0c\u7528\u5206\u53f7 (;) \u8fdb\u884c\u5206\u9694\uff0c\u5e76\u5728\u5730\u56fe\u4e3b\u9898\u5b57\u6bb5\u4e2d\uff0c\u4e3a\u6bcf\u4e00\u4e2a\u5e94\u7528\u7a0b\u5e8f\u6dfb\u52a0\u76f8\u5e94\u7684\u5730\u56fe\u4e3b\u9898\u6807\u9898\u3002", "16e85da6f4fd9f59ae391d513d52e632": "\u5728 ArcGIS Online \u4e0a\u521b\u5efa\u7f51\u7edc\u5730\u56fe\u3002", "f44bc9cbae69a51002c35fa900bb55dd": "\u83dc\u5355\u4e0a\u4e00\u7ec4\u6570\u636e\u56fe\u5c42\u7684\u6807\u9898\uff0c\u8fd9\u4e9b\u56fe\u5c42\u662f\u4ece\u7f51\u7edc\u5730\u56fe\u63d0\u53d6\u7684\u3002", "b72ac10807b29c77f5b7e4b80ea40414": "\u8bf4\u660e", "0992489984ac62764d0d073818aa2ce4": "\u82e5\u4e3a\u771f\uff0c\u5219\u5e94\u7528\u7a0b\u5e8f\u4f1a\u8bd1\u4e3a\u53e6\u4e00\u79cd\u8bed\u8a00\u3002", "9b99b7101acf4114f26f86f55bbe8f1e": "\u70b9\u51fb\u201d\u542f\u52a8\u201c\u4ee5\u8fdb\u5165\u5e76\u5f00\u59cb\u4f7f\u7528\u5df2\u5b8c\u6210\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u3002", "23f938efd2fa4a14f3e9afd0d459458a": "\u9996\u5148\u70b9\u51fb\u9876\u90e8\u83dc\u5355\u7684\u201d\u5185\u5bb9\u201c\u6ce8\u518c\u60a8\u7684\u670d\u52a1\u3002\u5185\u5bb9\u7f51\u9875\u53ef\u7528\u4e8e\u8bbf\u95ee\u3001\u7ec4\u7ec7\u3001\u4f7f\u7528 ArcGIS Online \u4e0a\u7684\u5185\u5bb9\u3002\u4ece\u8fd9\u91cc\u70b9\u51fb\u201d\u6dfb\u52a0\u9879\u76ee\u201c\uff0c\u5e76\u9009\u62e9\u201d\u4ece URL\"\u3002", "84df234d1e14c74ca6041f4e9a85b265": "\u670d\u52a1\u6ce8\u518c\u4e4b\u540e\uff0c\u53ef\u4ee5\u7f16\u8f91\u5176\u8bbe\u7f6e\u3002\u5efa\u8bae\u4e3a\u6bcf\u79cd\u670d\u52a1\u6dfb\u52a0\u6458\u8981\u3001\u63cf\u8ff0\u548c\u53c2\u4e0e\u4eba\u5458\u3002\u63cf\u8ff0\u548c\u5f15\u7528\u5c06\u5728 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u4e2d\u4f7f\u7528\uff0c\u5e76\u4ee5\u670d\u52a1\u5143\u6570\u636e\u5448\u73b0\u3002", "16fde6f7d8a3c61921a26b9fae6b825a": "\u9009\u62e9\u201cGFW MapBuilder \u6a21\u677f (v1.latest)\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u5171\u4eab\u201d\u3002", "5aa9476129db2865a9c85a838ab2a218": "<strong>\u54c1\u724c\u6307\u5bfc\u539f\u5219</strong>\uff1a \u4f7f\u7528 GFW \u6807\u5fd7\u3001\u8c03\u8272\u677f\u548c\u7c7b\u578b\u7cfb\u5217\u3002", "854c9d74580521ede6ef7b4973152554": "\u5e94\u7528\u7a0b\u5e8f\u5907\u7528\u8bed\u8a00\u526f\u6807\u9898\u3002", "b57e04f9b6ed510019729d6b181b7b52": "\u53e6\u4e00\u4e2a\u5e2e\u52a9\u9a8c\u8bc1\u51c6\u5b9e\u65f6\u8b66\u62a5\u7684\u8d44\u6e90\u662f 5 \u5206\u949f\u5206\u8fa8\u7387\u7684\u884c\u661f\u56fe\u50cf\u3002\u81ea 2020 \u5e74\u4e5d\u6708\u4ee5\u6765\uff0c\u884c\u661f\u56fe\u50cf\u5e95\u56fe\u6bcf\u6708\u66f4\u65b0\uff0c\u53ef\u7528\u4e8e\u70ed\u5e26\u5730\u533a\u3002\u6700\u8fd1\u51e0\u5e74\u4e5f\u6709\u516d\u4e2a\u6708\u7684\u9a6c\u8d5b\u514b\u3002<a href=\"{{0}}\">\u5728\u8fd9\u91cc</a>\u4e86\u89e3\u884c\u661f\u5e95\u56fe\u548c\u5176\u4ed6\u53ef\u7528\u5e95\u56fe\u7684\u66f4\u591a\u4fe1\u606f\u3002", "2de2f587fb0668c5c0dd04c7283e380d": "\u5982\u679c\u4f7f\u7528\u201c\u7c7b\u578b\u201d\u7ed8\u5236\u98ce\u683c\uff0c\u53ef\u4ee5\u70b9\u51fb\u201c\u9009\u62e9\u8981\u663e\u793a\u7684\u5c5e\u6027\u201d\u4e0b\u62c9\u83dc\u5355\uff0c\u4ee5\u66f4\u6539\u6240\u663e\u793a\u7684\u5c5e\u6027\u3002", "7f2b255a72c22dc1511e847b767d0a0c": "\u70b9\u51fb \u201c\u2026\u201d \u56fe\u6807\uff0c\u7136\u540e\u70b9\u51fb\u201c\u914d\u7f6e\u5f39\u51fa\u201d\u3002", "b5969fecb0f7a0946d3a0ee1ed9c2681": "\u4f7f\u7528\u673a\u6784\u7684 ArcGIS Online \u8d26\u6237\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f", "a1a9bd8023e2aef0e8c847ecfcf4c9ca": "\u70b9\u51fb\u201c+ \u521b\u5efa\u7fa4\u7ec4\u201d\uff0c\u5728\u8d35\u673a\u6784\u7684 ArcGIS Online \u8d26\u6237\u521b\u5efa\u4e00\u4e2a\u7fa4\u7ec4\u3002", "76cdb63b0c5d41f0ed343303a0e1c7fe": "\u6709\u5173\u5982\u4f55\u5728 ArcGIS Online \u7f16\u8f91\u548c\u4fee\u6539\u7f51\u7edc\u5730\u56fe\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u67e5\u9605\u521b\u5efa\u548c\u7f16\u8f91\u7f51\u7edc\u5730\u56fe\u7684 <a href=\"{{0}}\" target=\"_blank\" aria-label=\"undefined (opens in a new tab)\" rel=\"noreferrer noopener\">ArcGIS \u6587\u6863</a>\u3002", "4b5959a20cca21658b9470708ec822a2": "\u70b9\u51fb\u201c\u6dfb\u52a0\u201d\uff0c\u5e76\u9009\u62e9\u201c\u641c\u7d22\u56fe\u5c42\u201d\u3002", "c2c4021ed9751b9e59e794995e7fba4f": "\u9690\u85cf\u5e94\u7528\u7a0b\u5e8f\u9875\u811a\u3002", "e8c252758f94adea271becac7805c7de": "\u70b9\u51fb\u9876\u5c42\u83dc\u5355\u7684\u201c\u5730\u56fe\u201d\u3002", "1ed3bcf1f7a32c2636cb70fc2a7f99a7": "\u5c06\u559c\u6b22\u7684\u6570\u636e\u56fe\u5c42\u6dfb\u52a0\u5230\u7f51\u7edc\u5730\u56fe\u4e4b\u540e\uff0c\u8fd8\u53ef\u4ee5\u70b9\u51fb\u66f4\u6539\u98ce\u683c\u56fe\u6807\u4fee\u6539\u6570\u636e\u53ef\u89c6\u5316\u7684\u65b9\u5f0f\u3002\u60a8\u53ef\u4ee5\u4ece\u8fd9\u91cc\u66f4\u6539\u7f51\u7edc\u5730\u56fe\u7684\u98ce\u683c\u3002", "0d29169827a58443328bc3223ee48951": "\u82e5\u4e3a\u771f\uff0c\u5219\u5168\u7403\u571f\u5730\u8986\u76d6\u6570\u636e\u56fe\u5c42\u4f1a\u5305\u542b\u5728\u5730\u56fe\u4e2d\u3002", "c7441c1c5bafbc2a4aefd07e279bb57f": "\u76d1\u6d4b\u68ee\u6797\u53d8\u5316", "82f2b46a7dfa482797226f6deda5065f": "\u73b0\u5728\u60a8\u5df2\u5728 ArcGIS Online \u521b\u5efa\u4e86\u6258\u7ba1\u8981\u7d20\u670d\u52a1\u3002\u70b9\u51fb\u60f3\u7f16\u8f91\u9879\u76ee\u53f3\u4fa7\u7684\u7f16\u8f91\u56fe\u6807\uff0c\u5c31\u80fd\u5c06\u7b80\u77ed\u6458\u8981\u3001\u63cf\u8ff0\u3001\u4f7f\u7528\u6761\u6b3e\u548c\u53c2\u4e0e\u4eba\u5458\u6dfb\u52a0\u5230\u8981\u7d20\u670d\u52a1\u3002\u8fd9\u4e9b\u4fe1\u606f\u5728 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u4e2d\u5c06\u7528\u4f5c\u5143\u6570\u636e\u3002", "aebdd671121d9da95b742b94672b2297": "\u60a8\u8fd8\u53ef\u4ee5\u4ece\u6700\u559c\u6b22\u7684\u56fe\u5c42\u3001\u8d35\u673a\u6784\u7684\u56fe\u5c42\uff0c\u6216\u516c\u5171 ArcGIS Online \u56fe\u5c42\u4e2d\uff0c\u6d4f\u89c8\u53ef\u7528\u7684\u6570\u636e\u56fe\u5c42\u3002\u4f8b\u5982\uff0c\u82e5\u70b9\u51fb \u201cArcGIS Online\u201d\u5e76\u8f93\u5165\u201cglobalforestwatch\u201d\uff0c\u4f1a\u663e\u793a\u7531 GFW \u5171\u4eab\u7684\u5b98\u65b9\u6570\u636e\u56fe\u5c42\u3002\u5b98\u65b9 GFW \u6570\u636e\u7531 GlobalForestWatch \u5171\u4eab\u3002\u6b32\u5c06\u8fd9\u5176\u4e2d\u7684\u67d0\u4e2a\u56fe\u5c42\u6dfb\u52a0\u81f3\u60a8\u7684\u7f51\u7edc\u5730\u56fe\uff0c\u70b9\u51fb\u56fe\u5c42\u53f3\u4e0b\u89d2\u7684 \u201c+\u201d \u56fe\u6807\u3002", "b185be28fa3b2059e856c1967a85b9c9": "\u9996\u5148\u9700\u8981\u521b\u5efa\u7f51\u7edc\u5730\u56fe\uff0c\u624d\u80fd\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\u3002\u7f51\u7edc\u5730\u56fe\u662f\u6309\u56fe\u5c42\u7ec4\u7ec7\u5730\u7406\u4fe1\u606f\u7684\u4e00\u79cd\u4ea4\u4e92\u5f0f\u663e\u793a\u3002\u4e4b\u540e\uff0c\u53ef\u4ee5\u5c06 MapBuilder \u6a21\u677f\u914d\u7f6e\u5230\u60a8\u6240\u521b\u5efa\u7684\u7f51\u7edc\u5730\u56fe\u4e2d\u3002", "ad0f41564ca2a7f1ffaf679387a7b73e": "\u82e5\u4e3a\u771f\uff0c\u5219\u5b8c\u597d\u65e0\u635f\u7684\u68ee\u6797\u6837\u8c8c\u6570\u636e\u56fe\u5c42\u4f1a\u5305\u542b\u5728\u5730\u56fe\u4e2d\u3002", "4672a5bd8d0e5f0edf9e375fbd339826": "\u9009\u62e9\u60a8\u559c\u6b22\u7684\u7ed8\u5236\u98ce\u683c\u3002\u7528\u201c\u7c7b\u578b\u201d\u7ed8\u5236\u98ce\u683c\u5bf9\u57fa\u4e8e\u5c5e\u6027\u7684\u5f62\u72b6\u8fdb\u884c\u53ef\u89c6\u5316\uff0c\u70b9\u51fb\u201c\u9009\u9879\u201d\u67e5\u770b\u9ad8\u7ea7\u989c\u8272\u7f16\u8f91\u9009\u9879\u3002\u7528\u201c\u4f4d\u7f6e\u201d\u7ed8\u5236\u98ce\u683c\u5bf9\u76f8\u540c\u989c\u8272\u7684\u6240\u6709\u5f62\u72b6\u8fdb\u884c\u53ef\u89c6\u5316\u3002", "c332a0ab5620d776ef532e690e3e134d": "\u70b9\u51fb\u201c\u521b\u5efa\u7f51\u7edc\u5e94\u7528\u201d\u3002", "5fd6595cb7e062e986b03b4aad89d778": "MapBuilder \u63d0\u4f9b\u51e0\u79cd\u4e0d\u540c\u7684\u65b9\u5f0f\u5171\u4eab MapBuilder \u5e94\u7528\u7a0b\u5e8f\uff0c\u5305\u62ec\u5171\u4eab URL\uff0c\u901a\u8fc7\u793e\u4ea4\u5a92\u4f53\u5171\u4eab\uff0c\u4ee5\u53ca\u5728\u5916\u90e8\u7f51\u7ad9\u4e2d\u5d4c\u5165 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u3002", "e8f16e51d6ab66c6c1d65c3c7988979c": "GFW \u6280\u672f\u4f1a\u58eb Abigail Frimpong \u4e8e 2019 \u5e74\u5341\u4e8c\u6708\u7f16\u5199\u4e86 GFW \u57f9\u8bad\u6280\u5de7\u6587\u6863\uff0c\u4e3a\u52a0\u7eb3\u7684\u793e\u533a\u8d44\u6e90\u7ba1\u7406\u533a\u57df\u63d0\u4f9b\u4e86\u68ee\u6797\u76d1\u6d4b\u5efa\u8bae\u3002\u8be5\u6587\u6863\u6709\u82f1\u6587\u7248\u3002", "0a52730597fb4ffa01fc117d9e71e3a9": "\u5b9e\u4f8b", "4ab659cd6efbb3a12a2802e102d9ab8e": "\u5e94\u7528\u7a0b\u5e8f\u526f\u6807\u9898\u3002", "455841222544bf571a0aa9c3ad01cb81": "\u5b8c\u6210\u540e\uff0c\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\u3002", "c6cb3b7fd10ba237fa2c26fb9252b10f": "GFW \u7528\u6237\u6307\u5357\u4e8e 2019 \u5e74\u4e09\u6708\u7f16\u5199\uff0c\u6f14\u793a\u5982\u4f55\u4f7f\u7528\u5730\u56fe\u548c Forest Watcher\u3002\u672c\u7528\u6237\u6307\u5357\u6709\u82f1\u6587\u7248\u548c\u897f\u73ed\u7259\u8bed\u7248\u3002", "68b928011bf52a503d08a571d160fceb": "\u5728\u641c\u7d22\u9875\u9762\uff0c\u5173\u95ed\u8fc7\u6ee4\u5668\uff0c\u4ec5\u5728\u60a8\u6240\u5728\u7684\u673a\u6784\u641c\u7d22\u3002\u60a8\u4f1a\u770b\u5230\u7531 \u201cGlobalForestWatch\u201d \u521b\u5efa\u7684\u51e0\u4e2a\u6a21\u677f\u3002\u6700\u65b0\u7248\u672c\uff0c\u8bf7\u4ece\u5217\u8868\u4e2d\u9009\u62e9 \u201cGFW MapBuilder template (v1.latest)\u201d\u3002", "5ab4f72bc687d024e735b847454a3b4b": "<strong>\u7528\u8d35\u673a\u6784\u7684 ArcGIS Online \u8d26\u6237\u6ce8\u518c MapBuilder \u6a21\u677f</strong>\u3002\u5982\u679c\u8d35\u673a\u6784\u6709 ArcGIS Online \u8d26\u6237\uff0c\u5c31\u53ef\u4ee5\u6ce8\u518c MapBuilder \u6a21\u677f\uff0c\u5e76\u5c06\u5176\u7528\u4f5c\u53ef\u914d\u7f6e\u7684\u5e94\u7528\u7a0b\u5e8f\u6620\u5c04\u3002\u6ce8\u518c\u5fc5\u987b\u7531\u673a\u6784\u8d26\u6237\u7684\u7ba1\u7406\u5458\u5b8c\u6210\u3002\u4e00\u65e6\u5b8c\u6210\u6ce8\u518c\uff0c\u8d35\u673a\u6784\u7684\u6240\u6709\u6210\u5458\u90fd\u53ef\u4ee5\u4f7f\u7528\u3002<a href=\"{{0}}\">\u5728\u8fd9\u91cc</a>\u4e86\u89e3\u7528\u8d35\u673a\u6784\u8d26\u6237\u6ce8\u518c MapBuilder \u6a21\u677f\u6700\u65b0\u7248\u672c\u7684\u66f4\u591a\u4fe1\u606f\u3002", "ddee09cbe1910c5cb298c92b74bc8278": "Forest Watcher \u79fb\u52a8\u5e94\u7528\u6f14\u793a\u7a0b\u5e8f\u4e8e 2020 \u5e74\u5341\u6708\u5236\u4f5c\uff0c\u6f14\u793a\u5982\u4f55\u4f7f\u7528 Forest Watcher \u5728\u73b0\u573a\u79bb\u7ebf\u76d1\u6d4b\u68ee\u6797\u3002\u6f14\u793a\u7a0b\u5e8f\u5f15\u5bfc\u60a8\u4e86\u89e3\u4e3b\u8981\u529f\u80fd\uff0c\u5982\u600e\u6837\u4e0a\u4f20\u672c\u5730\u6570\u636e\u548c\u5e95\u56fe\u4ee5\u81ea\u5b9a\u4e49\u5e94\u7528\uff0c\u8fd8\u6709\u5982\u4f55\u4e0e\u5176\u4ed6\u79bb\u7ebf\u8bbe\u5907\u76f4\u63a5\u5171\u4eab\u5185\u5bb9\u3002\u6f14\u793a\u7a0b\u5e8f\u6709\u82f1\u6587\u7248\u3001\u897f\u73ed\u7259\u8bed\u7248\u3001\u8461\u8404\u7259\u8bed\u7248\u3001\u6cd5\u8bed\u7248\u548c\u5370\u5c3c\u8bed\u7248\u3002", "43acbb14ff81b69a0fa863aee282340f": "\u9009\u62e9\u60a8\u5e0c\u671b\u6ce8\u518c\u7684\u670d\u52a1\u7c7b\u578b\uff0c\u5e76\u590d\u5236 URL\u3002\u5982\u679c\u8be5\u670d\u52a1\u5305\u542b\u591a\u4e2a\u6570\u636e\u56fe\u5c42\uff0c\u5219\u9700\u9009\u62e9\u8981\u6ce8\u518c\u7684\u6570\u636e\u56fe\u5c42\u3002\u5bf9\u4e8e WMS \u670d\u52a1\uff0c\u8bf7\u5206\u522b\u6ce8\u518c\u6bcf\u4e2a\u6570\u636e\u56fe\u5c42\u3002\u5fc5\u987b\u63d0\u4f9b\u6570\u636e\u56fe\u5c42\u540d\u79f0\u548c\u4efb\u4f55\u9002\u7528\u7684\u6807\u7b7e\u3002\u4e0b\u9762\u7684\u622a\u56fe\u663e\u793a\u5982\u4f55\u6ce8\u518c WMS \u670d\u52a1\u548c ArcGIS \u8981\u7d20\u670d\u52a1\u3002", "1caa9c386d7d4cc5b28201965f219e27": "\u8c03\u6574\u5907\u9009\u8bed\u8a00\u8bbe\u7f6e", "2a091ade1c7bbe0582b3b32ebf920ee9": "\u82e5\u4e3a\u771f\uff0c\u5219 SAD \u8b66\u62a5\u6570\u636e\u56fe\u5c42\u4f1a\u5305\u542b\u5728\u5730\u56fe\u4e2d\u3002", "46f745995af259fbc0273fd597811b6c": "\u7531 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">AMPA</a> \u521b\u5efa\u3002", "82f922dca93cc84dedc69d0498a75003": "\u57fa\u4e8e\u7f51\u7edc\u5730\u56fe\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\u3002", "6300f527179902daa841fbd66d1aef14": "\u89c2\u770b\u5370\u5c3c\u8bed\u7248\u6f14\u793a\u3002", "9dc839bc8c48bdc7b88045c9a873ddc7": "\u5229\u6bd4\u91cc\u4e9a\u68ee\u6797\u548c GLAD \u8b66\u62a5\u624b\u518c", "90408276a6ce4a32242723836db9eece": "2020 \u5e74\u516b\u6708\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Amaz\u00f3nicos por la Amazon\u00eda (AMPA)</a> \u7f16\u5199\u4e86\u5229\u7528\u65b0\u6280\u672f\u89e3\u51b3\u73af\u5883\u72af\u7f6a\u95ee\u9898\u7684\u5b9e\u7528\u624b\u518c\uff0c\u5c31\u4f7f\u7528\u65b0\u6280\u672f\u5728\u79d8\u9c81\u68ee\u6797\u7279\u8bb8\u7ecf\u8425\u533a\u67e5\u660e\u73af\u5883\u72af\u7f6a\u63d0\u4f9b\u6307\u5bfc\u3002\u8be5\u624b\u518c\u6709\u897f\u73ed\u7259\u8bed\u7248\u3002", "a18109a1e9e354134fb11a76d9fa9b96": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Women Research Institute</a> \u4e8e 2019 \u5e74\u4e03\u6708\u5236\u4f5c\u4e86\u5f71\u54cd\u68ee\u6797\u548c\u6ce5\u70ad\u5730\u706b\u707e\u7684\u89c6\u9891\uff0c\u6f14\u793a\u68ee\u6797\u548c\u6ce5\u70ad\u5730\u706b\u707e\u5982\u4f55\u5a01\u80c1\u5370\u5ea6\u5c3c\u897f\u4e9a\u5404\u5730\u793e\u533a\uff0c\u9020\u6210\u8d22\u4ea7\u635f\u5931\u548c\u516c\u4f17\u5065\u5eb7\u95ee\u9898\u3002 \u89c6\u9891\u5f3a\u8c03\u4e86\u50cf GFW \u8fd9\u6837\u7684\u65e9\u671f\u9884\u8b66\u7cfb\u7edf\uff0c\u600e\u6837\u5e2e\u52a9\u53d1\u73b0\u706b\u707e\uff0c\u4ece\u800c\u793e\u533a\u80fd\u91c7\u53d6\u63aa\u65bd\u4fdd\u62a4\u81ea\u5df1\u548c\u4ed6\u4eec\u7684\u68ee\u6797\u3002\u89c6\u9891\u6709\u5370\u5c3c\u8bed\u7248\uff0c\u914d\u82f1\u6587\u5b57\u5e55\u3002", "973bbc605a2fa22aea09c8b7caaaabe8": "-\u5728\u534e\u76db\u987f\u7279\u533a\u53c2\u52a0\u79d1\u6280\u8425\u548c GFW \u7528\u6237\u5cf0\u4f1a\u652f\u4ed8\u7684\u6240\u6709\u8d39\u7528\uff08\u673a\u7968\u3001\u7b7e\u8bc1\u8d39\u7528\u3001\u9910\u8d39\u548c\u4f4f\u5bbf\u8d39\uff09\u3002", "50487c2f98362529e3456dbe230976e0": "- \u67e5\u770b &nbsp;<a class=\"text -paragraph -color-4 -bold\" href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5c0f\u989d\u8d44\u52a9\u91d1\u5e38\u89c1\u95ee\u9898</a>", "acc69f49052134c818b58341fb6bed68": "-WRI \u65f6\u4e8b\u901a\u8baf\u3001\u535a\u5ba2\u548c\u793e\u4ea4\u5a92\u4f53\u7684\u901a\u8baf\u62a5\u9053\u3002", "45956d9958bea8f85ae2e65e1363fb64": "\u641c\u7d22\u6ce8\u518c\u5230\u8d35\u673a\u6784 ArcGIS Online \u8d26\u6237\u7684 MapBuilder \u6a21\u677f\uff0c\u5e76\u70b9\u51fb\u3002", "f08bb083ebb215d3bf98598504325013": "\u6b32\u4ece\u60a8\u7684\u684c\u9762\u5c06\u6570\u636e\u6dfb\u52a0\u5230\u7ec4\u7ec7\u7684 ArcGIS Online \u8d26\u6237\uff0c\u70b9\u51fb\u9876\u90e8\u83dc\u5355\u7684\u201c\u5185\u5bb9\u201d\uff0c \u7136\u540e\u70b9\u51fb\u201c\u6dfb\u52a0\u9879\u76ee\u201d\u3002\u4ece\u8fd9\u91cc\uff0c\u9009\u62e9\u201c\u4ece\u6211\u7684\u7535\u8111\u201d\u3002", "73a54d466b54a3f389562f335fe95d23": "MapBuilder \u673a\u6784 ArcGIS Online \u8d26\u6237\u6559\u7a0b\u4e8e 2019 \u5e74\u5341\u4e00\u6708\u5236\u4f5c\uff0c\u6f14\u793a\u600e\u6837\u5229\u7528\u673a\u6784 ArcGIS Online \u8d26\u6237\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\u3002\u8be5\u6559\u7a0b\u6db5\u76d6\u5185\u5bb9\u5982\u4e0b\uff0c\u5982\u4f55\u5c06\u6570\u636e\u6dfb\u52a0\u5230 ArcGIS Online\uff0c\u521b\u5efa\u7f51\u7edc\u5730\u56fe\u3001\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\uff0c\u5e76\u5c06 MapBuilder \u6a21\u677f\u6ce8\u518c\u5230\u60a8\u7684\u8d26\u6237\u3002\u672c\u6559\u7a0b\u6709\u82f1\u6587\u7248\u3002", "4b6ffd93b76e761c82fdeb406ededa1d": "-\u5f62\u6210 GFW \u4f19\u4f34\u5408\u4f5c\u5173\u7cfb\u7684\u4e00\u90e8\u5206\u3002", "ebe3012555b96074fff5d84d5d0b9f7f": "\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\u4e4b\u524d\uff0c\u5fc5\u987b\u5148\u521b\u5efa\u5e26\u6709\u6570\u636e\u56fe\u5c42\u7684\u7f51\u7edc\u5730\u56fe\u3002\u4e0b\u9762\u7684\u6b65\u9aa4\u89e3\u91ca\u5982\u4f55\u5c06 shapefile \u4f5c\u4e3a\u8981\u7d20\u670d\u52a1\u53d1\u5e03\u5230 ArcGIS Online\uff0c\u4f7f\u5176\u4f5c\u4e3a\u6570\u636e\u56fe\u5c42\u6dfb\u52a0\u5230\u7f51\u7edc\u5730\u56fe\u4e0a\u3002", "4d71c5a5f8c770fd45b75c3ea7e985f8": "<strong>\u901a\u7528\u8bbe\u7f6e</strong>\uff1a\u7f16\u8f91\u6807\u9898\u3001\u526f\u6807\u9898\u3001\u7f51\u9875\u5730\u56fe\u7fa4\u7ec4\u6807\u9898\u53ca MapBuilder \u5e94\u7528\u7a0b\u5e8f\u63cf\u8ff0\u3002\u5c06 URL \u6dfb\u52a0\u5230\u5c06\u5728 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u5de6\u4e0a\u89d2\u51fa\u73b0\u7684\u6807\u5fd7\uff0c\u5e76\u5c06\u53ef\u9009\u94fe\u63a5\u6dfb\u52a0\u5230\u5173\u4e8e\u9875\u9762\u6216\u6570\u636e\u4e0b\u8f7d\u9875\u9762\u3002", "3f6d4ac916f5e08487ff065b19a48133": "\u5728\u5de6\u4fa7\u7684\u8868\u683c\u81ea\u5b9a\u4e49 MapBuilder \u8bbe\u7f6e\u3002", "ca6ebf15974f65af0332fdfea7d06024": "\u8bf7\u89c2\u770b\u6211\u4eec\u201c\u68ee\u6797\u76d1\u6d4b\u524d\u6cbf\u201d\u7cfb\u5217\u7684\u7b2c\u4e00\u671f\u201c\u536b\u661f\u76d1\u6d4b\u4ecb\u7ecd\u201d\uff0c\u4e86\u89e3\u9065\u611f\u76d1\u6d4b\u68ee\u6797\u7684\u57fa\u7840\u77e5\u8bc6\u3002\u4ece\u6982\u5ff5\u5316 30-\u7c73\u50cf\u7d20\u5c3a\u5bf8\uff0c\u5230\u5149\u5b66\u548c\u96f7\u8fbe\u56fe\u50cf\u7684\u533a\u522b\uff0c\u60a8\u5c06\u83b7\u5f97\u536b\u661f\u76d1\u6d4b\u7684\u57fa\u7840\u77e5\u8bc6\uff0c\u8ba9\u60a8\u66f4\u597d\u5730\u7406\u89e3 GFW \u4e0a\u7684\u6570\u636e\u3002\u8be5\u7f51\u7edc\u7814\u8ba8\u4f1a\u6709\u82f1\u6587\u7248\u548c\u897f\u73ed\u7259\u8bed\u7248\u3002                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      ", "7db0cbe94d9d724ff402f278644605da": "MapBuilder \u63d0\u4f9b\u51e0\u79cd\u65b9\u5f0f\u81ea\u5b9a\u4e49\u5e94\u7528\u7a0b\u5e8f\u3002\u4e0b\u9762\u7684\u4fe1\u606f\u4ecb\u7ecd\u5982\u4f55\u5728\u60a8\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u4e2d\uff0c\u8c03\u6574\u901a\u7528\u8bbe\u7f6e\u3001\u5907\u9009\u8bed\u8a00\u8bbe\u7f6e\u3001\u6570\u636e\u56fe\u5c42\u548c\u5206\u6790\u8bbe\u7f6e\uff0c\u4ee5\u53ca\u5176\u4ed6\u8bbe\u7f6e\u3002\u6b64\u4fe1\u606f\u5c06\u4f7f\u60a8\u80fd\u591f\u901a\u8fc7\u66f4\u6539\u5e94\u7528\u7a0b\u5e8f\u4ee3\u7801\u4e2d\u7684\u7279\u5b9a\u5c5e\u6027\uff0c\u81ea\u5b9a\u4e49\u5e94\u7528\u7a0b\u5e8f\u6a21\u677f\u3002", "0da6243aabede8a49ac28597e348bd73": "\u4ece\u8fd9\u91cc\uff0c\u70b9\u51fb\u201c\u6dfb\u52a0\u201d\u5e76\u9009\u62e9\u201c\u641c\u7d22\u56fe\u5c42\u201d\uff0c\u5c06\u9879\u76ee\u6dfb\u52a0\u5230\u60a8\u7684\u7f51\u7edc\u5730\u56fe\u3002\u60a8\u5c06\u80fd\u6d4f\u89c8\u53ef\u7528\u7684\u6570\u636e\u56fe\u5c42\uff0c\u5e76\u5c06\u5b83\u4eec\u6dfb\u52a0\u5230\u7f51\u7edc\u5730\u56fe\u3002", "71fe83555de79b660aee47d5be2cb1b3": "-\u4e2a\u522b\u5316\u57f9\u8bad\u4e0e\u652f\u6301\u3002", "501963438a019d80dc6fb7de7f8c3476": "- \u89c2\u770b &nbsp;<a class=\"text -paragraph -color-4 -bold\" href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">2021 \u5e74\u5c0f\u989d\u8d44\u52a9\u91d1\u7f51\u7edc\u7814\u8ba8\u4f1a</a>\u5f55\u50cf", "beec8ade1ff881f11ba1d9387e1ee501": "\u6b32\u516c\u5f00\u5206\u4eab\u7f51\u7edc\u5730\u56fe\uff0c\u70b9\u51fb\u201c\u5171\u4eab\u201d\uff0c\u5e76\u786e\u4fdd\u201c\u6240\u6709\u4eba\uff08\u516c\u5f00\uff09\u201d\u88ab\u6fc0\u6d3b\u3002\u5b8c\u6210\u540e\uff0c\u70b9\u51fb\u201c\u5b8c\u6210\u201d\u3002", "3c5cf32dc392269cc38fc9076f97bdb3": "\u641c\u7d22 MapBuilder \u6a21\u677f\u3002\u6b32\u4f7f\u7528 MapBuilder \u6a21\u677f\u7684\u6700\u65b0\u7248\u672c\uff0c\u8bf7\u9009\u62e9 \u201cGFW MapBuilder (v1.latest)\u201d\u3002\u5982\u679c\u6ca1\u6709\u770b\u5230\u8fd9\u4e2a\u9009\u9879\uff0c\u9700\u8981\u5c06\u5176\u4f5c\u4e3a\u53ef\u914d\u7f6e\u5e94\u7528\u7a0b\u5e8f\u6a21\u677f\u6dfb\u52a0\u5230\u60a8\u6240\u5728\u7684\u673a\u6784\u3002<a href=\"{{0}}\">\u5728\u8fd9\u91cc</a>\u4e86\u89e3\u5982\u4f55\u5c06 MapBuilder \u6a21\u677f\u6ce8\u518c\u5230\u673a\u6784\u7684 ArcGIS Online \u8d26\u6237\u3002", "31109c717b6a7f92a12a05a4f5d1d929": "\u786e\u4fdd\u60a8\u7684\u670d\u52a1\u662f\u516c\u5f00\u5171\u4eab\u7684\u3002", "7d5a6360b06b48639b6b516ea86194e4": "\u5bf9\u4e8e {location} \u7684 {indicator}\uff0c{percentileLength} \u9760\u524d\u7684\u5730\u533a\uff0c\u5728 {startYear} \u548c {endYear} \u671f\u95f4\uff0c\u5360\u6240\u6709\u6811\u6728\u8986\u76d6\u7387\u6d41\u5931\u7684 {topLoss}\u3002\u4e0e\u5e73\u5747\u503c {average} \u76f8\u6bd4\uff0c{region} \u7684\u68ee\u6797\u8986\u76d6\u7387\u6d41\u5931\u6700\u9ad8\uff0c\u4e3a {value}\u3002", "154df05062f48c7b4be872e22d182669": "\u901a\u8fc7\u641c\u7d22 MapBuilder \u6a21\u677f\uff0c\u5c06\u5176\u6dfb\u52a0\u5230\u60a8\u7684\u7fa4\u7ec4\u3002\u70b9\u51fb\u53f3\u4e0a\u89d2\u7684\u641c\u7d22\u56fe\u6807\uff0c\u8f93\u5165 \u201cGFW MapBuilder\u201d\uff0c\u518d\u6309\u56de\u8f66\u3002", "59ccb8ca472f596bee158ce69b1aabf2": "MapBuilder \u514d\u8d39\u516c\u7528 ArcGIS Online \u8d26\u6237\u6559\u7a0b\u4e8e 2019 \u5e74\u5341\u4e00\u6708\u5236\u4f5c\uff0c\u6f14\u793a\u5982\u4f55\u4f7f\u7528\u516c\u7528 ArcGIS Online \u8d26\u6237\uff0c\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\u3002\u8be5\u6559\u7a0b\u6db5\u76d6\u5185\u5bb9\u5982\u4e0b\uff0c\u600e\u6837\u5c06\u670d\u52a1\u6ce8\u518c\u5230\u60a8\u7684\u8d26\u6237\uff0c\u521b\u5efa\u7f51\u7edc\u5730\u56fe\uff0c\u521b\u5efa MapBuilder \u53ef\u914d\u7f6e\u7684\u7f51\u7edc\u5e94\u7528\u7a0b\u5e8f\u3002\u6559\u7a0b\u6709\u82f1\u6587\u7248\u3002", "829b9a33f59bd367bbbd1fe3db748c8a": "\u6ce8\u518c Web Map Service (WMS)\u3002", "a19490cf45a70b6cd8c35c4f788d71ac": "\u70b9\u51fb\u53f3\u4e0a\u89d2\u7684\u5171\u4eab\u56fe\u6807\u3002", "eaef5f5812cb3becaffb8cc3314625d4": "\u6570\u636e\u56fe\u5c42\u548c\u5206\u6790\u8bbe\u7f6e\u80fd\u8ba9\u60a8\u4ece GFW \u5220\u9664\u6216\u6dfb\u52a0 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u7684\u56fe\u5c42\u3002\u6709\u4e9b\u6765\u81ea GFW \u7684\u6570\u636e\u56fe\u5c42\u9ed8\u8ba4\u6dfb\u52a0\u5230 MapBuilder \u7684\u6a21\u677f\u3002", "f283dfbf79a53d579a8d2f7b3a5b2a42": "\u70b9\u51fb\u201c\u673a\u6784\u201d\uff0c\u518d\u70b9\u51fb\u201c\u8bbe\u7f6e\u201d\uff0c\u7136\u540e\u9009\u62e9\u8bbe\u7f6e\u7684\u201c\u5730\u56fe\u201d\u90e8\u5206\u3002", "2bda77e4848927f4b221c523e3cf174c": "\u5730\u56fe\u521b\u5efa\u548c\u7f16\u8f91\u5b8c\u6210\u540e\uff0c\u70b9\u51fb\u5730\u56fe\u9876\u90e8\u7684\u201c\u4fdd\u5b58\u201d\uff0c\u5e76\u9009\u62e9\u201c\u53e6\u5b58\u4e3a\u201d\u3002\u4e3a\u7f51\u7edc\u5730\u56fe\u62df\u5b9a\u540d\u79f0\u3001\u4efb\u4f55\u9002\u7528\u7684\u6807\u7b7e\u53ca\u6458\u8981\uff0c\u7136\u540e\u9009\u62e9\u4fdd\u5b58\u4f4d\u7f6e\uff0c\u70b9\u51fb\u201c\u4fdd\u5b58\u5730\u56fe\u201d\u3002", "e4d4de43e08c60ccde4ec8c0b46f0ef6": "<strong>\u5e94\u7528\u7a0b\u5e8f</strong>\uff1a\u8bbf\u95ee\u5b50\u7ad9\u70b9\u548c\u7b2c\u4e09\u65b9\u5e94\u7528\u7a0b\u5e8f\u7684\u4fe1\u606f\u3002", "828feab36cdd6f2cb72fa7e31ca65185": "\u53d6\u6d88\u52fe\u9009\u4e0d\u5e0c\u671b\u5728\u5f39\u51fa\u7a97\u53e3\u4e2d\u663e\u793a\u7684\u5b57\u6bb5\u3002\u70b9\u51fb\u201c\u5b57\u6bb5\u522b\u540d\u201d\uff0c\u5e76\u8f93\u5165\u65b0\u540d\u79f0\uff0c\u60a8\u8fd8\u80fd\u66f4\u6539\u5b57\u6bb5\u540d\u79f0\u7684\u663e\u793a\u65b9\u5f0f\u3002\u8c03\u6574\u5b57\u6bb5\u522b\u540d\uff0c\u66f4\u6539\u5b57\u6bb5\u540d\u79f0\u7684\u663e\u793a\u65b9\u5f0f\u3002", "e990747c8a3fa18295592f6b74f8ad26": "\u638c\u63e1 GFW \u63d0\u4f9b\u7684\u6700\u65b0\u4fe1\u606f\uff0c\u653f\u5e9c\u3001\u4f01\u4e1a\u548c\u793e\u533a\u5c31\u80fd\u963b\u6b62\u68ee\u6797\u6d41\u5931\u3002", "ce3f879affa9f47d9159013caaa719a3": "<strong>\u521b\u5efa\u7f51\u7edc\u5730\u56fe</strong>\u3002\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\u4e4b\u524d\uff0c\u9700\u8981\u5148\u5728 ArcGIS Online \u521b\u5efa\u7f51\u7edc\u5730\u56fe\u3002\u60a8\u53ef\u4ee5\u81ea\u5b9a\u4e49\u7f51\u7edc\u5730\u56fe\uff0c\u4e3a\u5176\u6dfb\u52a0\u6570\u636e\uff0c\u8ba9\u5b83\u53ef\u5171\u4eab\u3002<a href=\"{{0}}\">\u5728\u8fd9\u91cc</a>\u4e86\u89e3\u521b\u5efa ArcGIS Online \u7f51\u7edc\u5730\u56fe\u7684\u66f4\u591a\u4fe1\u606f\u3002", "eeba1243f6ff4281b61575068522f74b": "\u4ee5\u4e0b\u6b65\u9aa4\u5fc5\u987b\u7531\u8d35\u673a\u6784\u8d26\u6237\u7684\u7ba1\u7406\u5458\u5b8c\u6210\u3002\u5b8c\u6210 MapBuilder \u6a21\u677f\u6ce8\u518c\u4e4b\u540e\uff0c\u8d35\u673a\u6784\u7684\u6240\u6709\u6210\u5458\u90fd\u53ef\u4ee5\u4f7f\u7528\u3002", "5d20dea58bb8c21d7494fc9db3e3a06d": "\u6807\u8bc6\u5e94\u7528\u7a0b\u5e8f\u5907\u9009\u8bed\u8a00\u3002", "b5d800e76c94d0c0ca9c084845830399": "\u9009\u62e9\u60f3\u4e0a\u4f20\u7684 shapefile \u6216\u5176\u4ed6 GIS \u6570\u636e\u56fe\u5c42\u3002\u4e0a\u4f20 shapefile \u65f6\uff0c\u6240\u6709 shapefile \u7ec4\u4ef6\u5fc5\u987b\u538b\u7f29\u5230\u5355\u4e2a\u6587\u4ef6\u5939\u4e2d\u3002", "ffa84508713d076f3ccbc449e208191f": "\u4e0b\u8f7d\u68ee\u6797\u7edf\u8ba1\u6570\u636e", "deeb739344a742f82c86a2e5a8698fa2": "\u8d44\u52a9\u91d1\u5728 $10K - $40K \u4e4b\u95f4\u3002", "70b221a8e6b1d1fa3258524502ed7109": "\u5907\u9009\u5730\u56fe\u4e3b\u9898\u5b57\u6bb5\u7528\u4e8e\u5728\u5e94\u7528\u7a0b\u5e8f\u7684\u7b2c\u4e8c\u8bed\u8a00\u4e2d\uff0c\u6307\u660e\u76f8\u5173\u5e94\u7528\u7a0b\u5e8f\u7684\u6807\u9898\u3002\u8be5\u5b57\u6bb5\u4ec5\u5728\u4ee5\u4e0b\u60c5\u5f62\u624d\u6709\u5fc5\u8981\uff1a\u4f7f\u7528\u5907\u9009\u8bed\u8a00\u8bbe\u7f6e\u5c06\u5e94\u7528\u7a0b\u5e8f\u8bd1\u4e3a\u7b2c\u4e8c\u8bed\u8a00\uff0c\u5e76\u4f7f\u7528\u5730\u56fe\u4e3b\u9898\u9009\u9879\u5173\u8054\u76f8\u5173\u5e94\u7528\u7a0b\u5e8f\u3002", "e8d2aea4151d96b3bf5b5d46c6f2f3c6": "\u6709\u6548\u7684\u68ee\u6797\u76d1\u6d4b\u5bf9\u4e8e\u786e\u4fdd\u68ee\u6797\u7684\u53ef\u6301\u7eed\u6027\u4ee5\u53ca\u6700\u5927\u7a0b\u5ea6\u5730\u51cf\u5c11\u9879\u76ee\u5bf9\u73af\u5883\u7684\u5f71\u54cd\u81f3\u5173\u91cd\u8981\u3002\u793e\u533a\u4ee5\u53ca\u975e\u653f\u5e9c\u7ec4\u7ec7 (NGO) \u53ef\u4ee5\u901a\u8fc7 GFW \u8fd1\u4e4e\u5b9e\u65f6\u5730\u76d1\u6d4b\u68ee\u6797\u8986\u76d6\u7387\u7684\u635f\u5931\uff0c\u5e76\u4e3a\u652f\u6301\u68ee\u6797\u7684\u4fdd\u62a4\u4e0e\u7ba1\u7406\u9879\u76ee\u4ee5\u53ca\u884c\u52a8\u52a8\u5458\u63d0\u4f9b\u53ca\u65f6\u800c\u72ec\u7acb\u7684\u6570\u636e\u3002\u4e86\u89e3\u6709\u5173 NGO \u5982\u4f55\u4f7f\u7528 GFW \u66f4\u597d\u5730\u4fdd\u62a4\u548c\u7ba1\u7406\u68ee\u6797\u7684\u66f4\u591a\u4fe1\u606f\u3002", "db846e1c27c058306fb23744ca74783e": "\u9690\u85cf\u5e94\u7528\u7a0b\u5e8f\u7684\u5934\u90e8\uff08\u5305\u62ec\u5fbd\u6807\u3001\u6807\u9898\u548c\u83dc\u5355\uff09\u3002", "3037dcf7c2bf003f5ca4d960fc55efb6": "<strong>\u5206\u4eab\u60a8\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f</strong>\u3002\u60a8\u53ef\u4ee5\u901a\u8fc7\u591a\u79cd\u65b9\u6cd5\u6765\u5206\u4eab\u60a8\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f\uff1a\u76f4\u63a5\u5206\u4eab URL \u94fe\u63a5\u3001\u901a\u8fc7\u793e\u4ea4\u5a92\u4f53\u5206\u4eab\u4ee5\u53ca\u5c06\u60a8\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u5d4c\u5165\u5230\u7f51\u7ad9\u4e2d\u3002<a href=\"{{0}}\">\u70b9\u51fb\u6b64\u5904</a>\u4e86\u89e3\u6709\u5173\u5982\u4f55\u5206\u4eab MapBuilder \u5e94\u7528\u7a0b\u5e8f\u7684\u66f4\u591a\u4fe1\u606f\u3002", "a38db3b917ef0df529a4e3d3b8f26392": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u70b9\u51fb\u6b64\u5904</a>\u83b7\u53d6\u6709\u5173 GFW \u98ce\u683c\u51c6\u5219\u7684\u4fe1\u606f\u3002", "b8e72224d139dcc3c6c891f8e4121a11": "\u70b9\u51fb\u201c\u521b\u5efa\u7fa4\u7ec4\u201d\u4ee5\u4fbf\u5c06\u7fa4\u7ec4\u4fdd\u5b58\u81f3\u8d35\u7ec4\u7ec7\u7684 ArcGIS Online \u8d26\u6237\u4e2d\u3002", "9522788c2ad4cb8cd710a0db9a18c1b2": "\u70b9\u51fb\u5fbd\u6807\u540e\u5e94\u7528\u7a0b\u5e8f\u5c06\u94fe\u63a5\u81f3\u7684\u7f51\u7ad9 URL\u3002", "7412df2b1db8cd2a5d4aafdb6c2090d3": "\u7814\u7a76", "d9c252ecbe478bcb418de79dbdef5f26": "<strong>\u5206\u4eab\u60a8\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f</strong>\u3002\u60a8\u53ef\u4ee5\u901a\u8fc7\u591a\u79cd\u9014\u5f84\u6765\u5206\u4eab\u60a8\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f\uff1a\u76f4\u63a5\u5206\u4eab URL \u94fe\u63a5\u3001\u901a\u8fc7\u793e\u4ea4\u5a92\u4f53\u5206\u4eab\u4ee5\u53ca\u5c06\u60a8\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u5d4c\u5165\u5230\u7f51\u7ad9\u4e2d\u3002<a href=\"{{0}}\">\u70b9\u51fb\u6b64\u5904</a>\u4e86\u89e3\u6709\u5173\u5982\u4f55\u5206\u4eab MapBuilder \u5e94\u7528\u7a0b\u5e8f\u7684\u66f4\u591a\u4fe1\u606f\u3002", "3bca65558735041bce100c7802308610": "\u4e3a\u7fa4\u7ec4\u8f93\u5165\u540d\u5b57\u5e76\u4e3a\u5176\u586b\u5199\u4efb\u4f55\u9700\u8981\u8865\u5145\u7684\u7fa4\u7ec4\u8be6\u60c5\u3002", "cfac8c3f8bac5434d03718039c9f4a3e": "\u5e94\u7528\u7a0b\u5e8f\u7684\u6807\u9898\u3002", "820de0736af862f1c5b7536d5c8ac0c9": "\u7f16\u8f91\u6570\u636e\u53ef\u89c6\u5316\u5185\u5bb9\uff0c\u7136\u540e\u70b9\u51fb\u201c\u5b8c\u6210\u201d\u4ee5\u4fdd\u5b58\u6240\u6709\u66f4\u6539\u3002", "13e96bd0994d52e01618ef995d1db492": "GFW \u98ce\u683c\u51c6\u5219", "c09830356818ae51d04669db56b52419": "<strong>\u5206\u4eab URL</strong>\uff1a\u5982\u679c\u60a8\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u662f\u516c\u5f00\u5206\u4eab\u7684\uff0c\u90a3\u4e48\u60a8\u53ef\u4ee5\u590d\u5236\u8be5 URL \u5e76\u5c06\u5176\u5206\u4eab\u7ed9\u60a8\u7684\u5408\u4f5c\u4f19\u4f34\u3001\u540c\u4e8b\u4ee5\u53ca\u540c\u884c\u3002", "f3393da742563965e28ebc8d5507951b": "\u7528\u4e8e\u5e94\u7528\u7a0b\u5e8f\u4e2d\u7684\u6765\u81ea ArcGIS Online \u7684 Web \u5730\u56fe ID\u3002", "ae256fd7c2ec9ba9b8b6ee83c68201e3": "\u6570\u636e\u7c7b\u578b", "e267afd2a0c3af4310a5a490833cfd17": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u70b9\u51fb\u6b64\u5904</a>\u524d\u5f80 GitHub \u4ee5\u4e86\u89e3\u6709\u5173\u5982\u4f55\u8fdb\u884c\u66f4\u591a\u9ad8\u7ea7\u81ea\u5b9a\u4e49\u64cd\u4f5c\u7684\u76f8\u5173\u4fe1\u606f\u3002", "ecc4944fb425b8432590c474ec1b4ea1": "\u8fa8\u8bc6\u5e94\u7528\u7a0b\u5e8f\u7684\u8bed\u8a00\u3002", "28494d81d4eb5505df8656124dc78318": "\u4e0a\u4f20 shapefile \u6587\u4ef6\u5e76\u6dfb\u52a0\u6240\u6709\u76f8\u5173\u7684\u4fe1\u606f\uff0c\u7136\u540e\u70b9\u51fb\u201c\u6dfb\u52a0\u9879\u76ee\u201d\u3002", "ef69d443d7cbfa86caaf7d39e81e092f": "2020 \u5e74 11 \u6708\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Rainforest Journalism Fund</a> (RJF) \u8054\u624b<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">World Resources Institute</a> (WRI) \u4e3a\u5728\u521a\u679c\u76c6\u5730\u5de5\u4f5c\u7684\u65b0\u95fb\u5de5\u4f5c\u8005\u7ec4\u7ec7\u4e86\u4e00\u573a\u7f51\u7edc\u7814\u8ba8\u4f1a\u3002\u7f51\u7edc\u7814\u8ba8\u4f1a\u7684\u5185\u5bb9\u5305\u62ec\u5982\u4f55\u4f7f\u7528\u68ee\u6797\u5730\u56fe\u96c6 (Forest Atlas) \u53ca GFW \u5de5\u5177\u3002\u6b64\u6b21\u7f51\u7edc\u7814\u8ba8\u4f1a\u63d0\u4f9b\u6cd5\u8bed\u7248\u672c\u3002", "bf082ed59f4795aaca3a266139f26745": "\u70b9\u51fb\u201c\u542f\u52a8\u201d\u4ee5\u8fdb\u5165\u60a8\u521b\u5efa\u5b8c\u6210\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u3002", "8ce49f23718cb2aa1a983a1b8b00e190": "\u70b9\u51fb\u201c\u5206\u4eab\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u521b\u5efa Web \u5e94\u7528\u201d\u3002", "c9daa8a6d9ce8f94f331bf6634f8eaec": "\u5982\u679c\u8be5\u503c\u8bbe\u4e3a\u201c\u771f\u201d (true)\uff0c\u5219\u5730\u56fe\u5c06\u5305\u542b\u6765\u81ea NASA \u7684 VIIRS \u706b\u707e\u6570\u636e\u5c42\u3002", "e24d719fbf570c700fe1d9a9de3074f3": "\u662f\u5c06\u5728\u5e94\u7528\u7a0b\u5e8f\u7684\u201c\u4fe1\u606f\u201d\u9009\u9879\u5361\u4e2d\u663e\u793a\u7684\u66ff\u4ee3\u8bed\u8a00\u7248\u672c\u7684\u7b80\u77ed\u63cf\u8ff0\u3002\u4f7f\u7528 HTML \u6807\u7b7e\u5bf9\u8fd9\u6bb5\u6587\u672c\u7684\u683c\u5f0f\u8fdb\u884c\u7f16\u8f91\u4e0e\u81ea\u5b9a\u4e49\u3002", "672c0d17471daf719f32fa671539b8c0": "\u60a8\u4e5f\u53ef\u4ee5\u81ea\u5b9a\u4e49\u5728\u60a8 Web \u5730\u56fe\u7684\u5f39\u51fa\u7a97\u53e3\u4e2d\u6240\u663e\u793a\u7684\u5b57\u6bb5\u3002\u201c\u5f39\u51fa\u7a97\u53e3\u201d\u8868\u793a\u5728\u7528\u6237\u70b9\u51fb\u67d0\u4e2a\u5f62\u72b6\u65f6\u5bf9\u7528\u6237\u53ef\u89c1\u7684\u5b57\u6bb5\u3002", "9dffbf69ffba8bc38bc4e01abf4b1675": "\u6587\u672c", "31a9593340d7f0f1bae1af04d89f4849": "\u70b9\u51fb\u201c\u914d\u7f6e\u5c5e\u6027\u201d\u4ee5\u81ea\u5b9a\u4e49\u5728\u5f39\u51fa\u7a97\u53e3\u4e2d\u663e\u793a\u7684\u5c5e\u6027\u3002", "13e5ca9565ade1f20c35505e61118a9f": "\u76f8\u5173\u7684\u5206\u6b65\u8bf4\u660e", "a427f004a91c0bcf184224b15f4e5816": "\u89c2\u770b\u7f51\u7edc\u7814\u8ba8\u4f1a\uff08\u82f1\u8bed\uff09\u3002", "0318d30c62d3eaa55669452e72124613": "\u6d4f\u89c8\u653f\u5e9c\u3001\u516c\u6c11\u793e\u4f1a\u3001\u516c\u53f8\u4ee5\u53ca\u5176\u4ed6\u56e2\u4f53\u4f7f\u7528 GFW \u7684\u4f8b\u5b50\uff0c\u5e76\u4ece\u4e2d\u4e86\u89e3\u5982\u4f55\u5c06\u5176\u5e94\u7528\u5230\u60a8\u7684\u5de5\u4f5c\u4e2d\u3002", "1e11c3e4f34f8e519c960953e11841d0": "\u5411\u4e0b\u6eda\u52a8\u81f3\u201c\u53ef\u914d\u7f6e\u5e94\u7528\u201d\u90e8\u5206\uff0c\u7136\u540e\u4ece\u4e0b\u62c9\u83dc\u5355\u4e2d\u9009\u62e9\u60a8\u521b\u5efa\u7684\u7fa4\u7ec4\u3002\u9009\u4e2d\u7fa4\u7ec4\u540e\uff0c\u70b9\u51fb\u201c\u4e0e\u7fa4\u7ec4\u5206\u4eab Esri \u9ed8\u8ba4\u53ef\u914d\u7f6e\u5e94\u7528\u201d\u3002\u73b0\u5728 MapBuilder \u6a21\u677f\u5c31\u6210\u529f\u6ce8\u518c\u81f3\u8d35\u7ec4\u7ec7\u7684 ArcGIS Online \u8d26\u6237\u4e2d\u4e86\u3002", "821acc2b818f940fd8b2d5913fa39cde": "\u70b9\u51fb\u4f4d\u4e8e\u9876\u90e8\u83dc\u5355\u4e0a\u7684\u201c\u5185\u5bb9\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u6dfb\u52a0\u9879\u76ee\u201d\u5e76\u9009\u62e9\u201c\u4ece URL \u6dfb\u52a0\u201d\u3002", "5fcc3de48d32729e55c683c930394281": "\u5982\u679c\u8be5\u503c\u8bbe\u4e3a\u201c\u771f\u201d (true)\uff0c\u5219\u5730\u56fe\u5c06\u5305\u542b\u6765\u81ea NASA \u7684 MODIS \u706b\u707e\u6570\u636e\u5c42\u3002", "5ad234cb2cde4266195252a23ca7d84e": "\u5c5e\u6027", "a159d840acf78e00d991549849452f35": "\u89c2\u770b\u7f51\u7edc\u7814\u8ba8\u4f1a\uff08\u5370\u5ea6\u5c3c\u897f\u4e9a\u8bed\uff09\u3002", "069ab31b38c8eca4a0c4d2563d6ba65c": "\u53d6\u6d88\u52fe\u9009\u60a8\u4e0d\u5e0c\u671b\u663e\u793a\u7684\u5b57\u6bb5\uff0c\u5e76\u901a\u8fc7\u8c03\u6574\u5b57\u6bb5\u7684\u522b\u540d (alias) \u6765\u66f4\u6539\u5b57\u6bb5\u7684\u663e\u793a\u540d\u79f0\u3002", "3c2277b1e4865b8d781eebab53256112": "<strong>\u4f7f\u7528\u60a8\u7684\u8d26\u6237\u6765\u6ce8\u518c\u670d\u52a1</strong>\u3002\u5982\u679c\u60a8\u62e5\u6709 ArcGIS Server\u3001GeoServer \u6216 MapServer\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u4f7f\u7528\u60a8\u7684\u516c\u5171 ArcGIS Online \u8d26\u6237\u6765\u6ce8\u518c\u670d\u52a1\u3002\u6ce8\u518c\u670d\u52a1\u540e\uff0c\u60a8\u6240\u6ce8\u518c\u7684\u670d\u52a1\u5c06\u4ee5\u9879\u76ee\u7684\u5f62\u5f0f\u6dfb\u52a0\u81f3\u60a8\u7684\u8d26\u6237\u4e2d\u3002\u5982\u679c\u60a8\u6ca1\u6709 GIS \u670d\u52a1\u5668\uff0c\u60a8\u53ef\u4ee5\u8df3\u8fc7\u6b64\u6b65\u9aa4\u3002<a href=\"{{0}}\">\u70b9\u51fb\u6b64\u5904</a>\u4e86\u89e3\u6709\u5173\u6ce8\u518c\u670d\u52a1\u7684\u66f4\u591a\u4fe1\u606f\u3002", "67c4bd2dc34907b34421abff9eaddd7e": "\u70b9\u51fb\u201c\u5206\u4eab\u201d\u5e76\u9009\u62e9\u201c\u6240\u6709\u4eba\uff08\u516c\u5f00\uff09\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u3002", "81f1177827328844d3ef4711f23d5ce3": "2021 \u5e74\u7684\u5c0f\u989d\u8d44\u52a9\u9879\u76ee\u57fa\u91d1 (Small Grants Fund) \u7533\u8bf7\u5df2\u7ed3\u675f\u3002", "e4282a15c069069ba2d55be9d59cdf13": "\u5728\u66ff\u4ee3\u8bed\u8a00\u4e0b\u4f7f\u7528\u7684\u6765\u81ea ArcGIS Online \u7684 Web \u5730\u56fe ID\u3002", "0b4bac3953835fced558fd27ababe77b": "\u5982\u679c\u60a8\u521a\u521a\u521b\u5efa\u8d26\u6237\uff0c\u8bf7\u68c0\u67e5\u60a8\u7684\u7535\u5b50\u90ae\u4ef6\u5e76\u786e\u8ba4\u60a8\u7684\u8d26\u6237\u3002", "b90f39d51d165b1de854aed958b83bce": "\u60a8\u5e94\u7528\u7a0b\u5e8f\u6240\u5173\u6ce8\u7684\u56fd\u5bb6\u6216\u5730\u533a\u7684 ISO \u56fd\u522b\u4ee3\u7801\uff08\u4e09\u4e2a\u5b57\u6bcd\uff09\u3002\u5176\u4ed6\u56fd\u5bb6\u6216\u5730\u533a\u5c06\u88ab\u906e\u76d6\u3002", "91e7188a759ace37b7ae6c7073e0cc79": "\u70b9\u51fb\u4f4d\u4e8e\u9876\u90e8\u83dc\u5355\u4e0a\u7684\u201c\u4fdd\u5b58\u201d\u7136\u540e\u9009\u62e9\u201c\u53e6\u5b58\u4e3a\u201d\u6765\u4fdd\u5b58 Web \u5730\u56fe\u3002", "7046cd4652418f006e255a6a4e4380d7": "\u60a8\u73b0\u5728\u5c31\u53ef\u4ee5\u81ea\u5b9a\u4e49 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u7684\u8bbe\u7f6e\u4e86\u3002\u8bbe\u7f6e\u5305\u62ec\u56db\u4e2a\u9009\u9879\u5361\uff1a\u201c\u5e38\u89c4\u8bbe\u7f6e\u201d\u3001\u201c\u66ff\u4ee3\u8bed\u8a00\u8bbe\u7f6e\u201d\u3001\u201c\u56fe\u5c42\uff0f\u5206\u6790\u8bbe\u7f6e\u201d\u4ee5\u53ca\u201c\u9ad8\u7ea7\u8bbe\u7f6e\u201d\u3002", "73c09e16eb6c70f0a6ff508b7f16fd1a": "\u9009\u4e2d MapBuilder \u6a21\u677f\u540e\uff0c\u70b9\u51fb\u201c\u521b\u5efa Web \u5e94\u7528\u201d\uff0c\u7136\u540e\u7ed9\u60a8\u7684 Web \u5e94\u7528\u8d77\u4e2a\u540d\u5b57\uff0c\u8bbe\u7f6e\u597d\u6240\u6709\u9002\u7528\u7684\u6807\u7b7e\uff0c\u5e76\u64b0\u5199\u4e00\u6bb5\u6982\u8ff0\u3002\u9009\u62e9\u8981\u5c06 Web \u5e94\u7528\u4fdd\u5b58\u5230\u54ea\u91cc\uff0c\u9009\u597d\u540e\u70b9\u51fb\u201c\u5b8c\u6210\u201d\u3002", "9774aa110f6f4c5b73a837a83c38ddd8": "\u5728 ArcGIS Online \u4e0a\u521b\u5efa\u597d Web \u5730\u56fe\u4e4b\u540e\uff0c\u5c31\u53ef\u4ee5\u5c06 MapBuilder \u6a21\u677f\u914d\u7f6e\u5230 Web \u5730\u56fe\u4e0a\u4e86\u3002<a href=\"{{0}}\">\u70b9\u51fb\u6b64\u5904</a>\u4e86\u89e3\u5173\u4e8e\u5728 ArcGIS Online \u4e0a\u521b\u5efa Web \u5730\u56fe\u7684\u66f4\u591a\u4fe1\u606f\u3002", "adc32f6e22c9112886941b42e0dbcbf8": "\u5728\u60a8\u5b8c\u6210\u5bf9\u5f39\u7a97\u7684\u914d\u7f6e\u540e\uff0c\u8bf7\u70b9\u51fb\u201cOK\u201d\u3002", "1af34b9a1e09454502da420c316109f3": "\u8c03\u6574\u5176\u4ed6\u8bbe\u7f6e", "c349d9142ec460f7e6fadca374ce1ab8": "\u9ed8\u8ba4\u60c5\u51b5\u4e0b\uff0c\u60a8\u5c06\u770b\u5230\u60a8\u7684\u56fe\u5c42\uff1b\u800c\u5bf9\u4e8e\u60a8\u6240\u521b\u5efa\u7684\u4efb\u4f55\u6258\u7ba1\u529f\u80fd\u5c42\u5219\u5c06\u5728\u201c\u6211\u7684\u5185\u5bb9\u201d\u4e0b\u53ef\u89c1\u3002\u70b9\u51fb\u6b64\u5904\u4e86\u89e3\u6709\u5173\u5982\u4f55\u5411\u7ec4\u7ec7\u7684 ArcGIS Online \u8d26\u6237\u6dfb\u52a0\u6570\u636e\u7684\u66f4\u591a\u4fe1\u606f\u3002\u8981\u5c06\u5176\u4e2d\u4efb\u610f\u4e00\u5f20\u56fe\u5c42\u6dfb\u52a0\u81f3\u60a8\u7684 Web \u5730\u56fe\u4e2d\uff0c\u8bf7\u70b9\u51fb\u4f4d\u4e8e\u56fe\u5c42\u53f3\u4e0b\u65b9\u7684\u201c+\u201d\u56fe\u6807\u3002\u70b9\u51fb\u201c\u6211\u7684\u5185\u5bb9\u201d\u4ee5\u9009\u62e9\u4e0d\u540c\u7684\u6765\u6e90\u6765\u6d4f\u89c8\u53ef\u7528\u7684\u6570\u636e\u5c42\u3002", "89c6ab2d64bd20d1217e10825b238c0a": "\u5982\u679c\u60a8\u6709\u6743\u5b58\u53d6\u67d0\u4e2a\u7ec4\u7ec7\u7684 ArcGIS Online \u8d26\u6237\uff0c\u5219\u60a8\u53ef\u4ee5\u6ce8\u518c\u8be5 MapBuilder \u6a21\u677f\uff0c\u7136\u540e\u5c06\u5176\u4f5c\u4e3a\u4e00\u4e2a\u53ef\u914d\u7f6e\u5730\u56fe\u5e94\u7528\u7a0b\u5e8f\u6765\u4f7f\u7528\u3002\u4e0b\u65b9\u7684\u6b65\u9aa4\u89e3\u91ca\u4e86\u5982\u4f55\u5c06\u8be5 MapBuilder \u6a21\u677f\u7684\u6700\u65b0\u7248\u672c\u6ce8\u518c\u81f3\u8d35\u7ec4\u7ec7\u7684\u8d26\u6237\u5e76\u5c06\u5176\u6dfb\u52a0\u81f3\u7fa4\u7ec4\u3002", "b76ac61e606cedab636a2f6631994652": "\u5982\u679c\u8be5\u503c\u8bbe\u4e3a\u201c\u771f\u201d (true)\uff0c\u5219\u5730\u56fe\u5c06\u5305\u542b\u5730\u4e0a\u751f\u7269\u91cf\u6570\u636e\u5c42\u3002", "3dd501eca050b3076e4f5d7cf4d357c5": "- \u53c2\u4e0e GFW \u5408\u4f5c\u4f19\u4f34\u4e0e SGF / \u5956\u5b66\u91d1\u6821\u53cb\u4f1a\u3002", "a51d98b6c3bf381687092b954082ba77": "\u5728\u5934\u90e8\u6dfb\u52a0\u201c\u4e0b\u8f7d\u201d\u83dc\u5355\u9879\u3002\u94fe\u63a5\u5c06\u6307\u5411\u7ed9\u5b9a\u7684 URL\u3002\u8fd9\u9879\u529f\u80fd\u5bf9\u4e8e\u9700\u8981\u94fe\u63a5\u5230\u4e00\u5904\u5f00\u653e\u6570\u636e\u95e8\u6237\u7684\u7528\u6237\u6765\u8bf4\u662f\u5341\u5206\u6709\u7528\u7684\u3002", "df4a8e4d889765026e20a288b3752029": "<strong>\u8c03\u6574 MapBuilder \u914d\u7f6e\u8bbe\u7f6e</strong>\u3002\u201c\u5e38\u89c4\u8bbe\u7f6e\u201d\u662f\u7528\u6237\u7528\u6765\u81ea\u5b9a\u4e49\u8bf8\u5982\u5e94\u7528\u7a0b\u5e8f\u6587\u672c\u3001\u5fbd\u6807\u3001\u8d85\u94fe\u63a5\u4ee5\u53ca Web \u5730\u56fe\u7b49\u9879\u76ee\u7684\u5730\u65b9\u3002\u6b64\u5916\u7528\u6237\u8fd8\u53ef\u4ee5\u8c03\u6574\u201c\u66ff\u4ee3\u8bed\u8a00\u8bbe\u7f6e\u201d\u3001\u201c\u56fe\u5c42\uff0f\u5206\u6790\u8bbe\u7f6e\u201d\u4ee5\u53ca\u5176\u4ed6\u8bbe\u7f6e\u3002\u5728\u6b64\u5904\u4e86\u89e3\u6709\u5173 MapBuilder \u914d\u7f6e\u8bbe\u7f6e\u7684\u66f4\u591a\u4fe1\u606f\uff0c<a href=\"{{0}}\">\u70b9\u51fb\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u8fdb\u884c\u66f4\u591a\u9ad8\u7ea7\u81ea\u5b9a\u4e49\u8bbe\u7f6e\u3002", "7b5629c7be15c0b554d788a69d3438b4": "<strong>\u56fe\u5c42\uff0f\u5206\u6790\u8bbe\u7f6e</strong>\uff1a\u6fc0\u6d3b\u6216\u505c\u7528\u7531 GFW \u63d0\u4f9b\u7684\u6570\u636e\u5c42\u3002", "aa44810163431135ab3a65aa5371b196": "<a href=\"{{0}}\">\u70b9\u51fb\u6b64\u5904</a>\u4e86\u89e3\u6709\u5173\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\u7684\u66f4\u591a\u4fe1\u606f\u3002", "b3e9b3e1a873a0e847bf98447e3699e8": "2021 \u5e74\u5c0f\u989d\u8d44\u52a9\u9879\u76ee\u57fa\u91d1 (Small Grants Fund) \u7684\u8d44\u52a9\u8303\u56f4\u4e3b\u8981\u96c6\u4e2d\u5728\u201c\u68ee\u6797\u4fdd\u62a4\u201d\u3001\u201c\u68ee\u6797\u4e0e\u519c\u4e1a\u201d\u4ee5\u53ca\u201c\u68ee\u6797\u653f\u7b56\u201d\u8fd9\u4e09\u5927\u4e3b\u9898\u4e0a\u3002\u6709\u5173\u6bcf\u4e2a\u4e3b\u9898\u7684\u5177\u4f53\u76ee\u6807\u4ee5\u53ca\u5173\u4e8e\u7533\u8bf7\u6d41\u7a0b\u7684\u66f4\u591a\u8be6\u7ec6\u4fe1\u606f\u8bf7\u53c2\u89c1\u300a\u7533\u8bf7\u4eba\u6307\u5357\u300b\u3002\u5728\u7533\u8bf7\u524d\uff0c\u8bf7\u4ed4\u7ec6\u9605\u8bfb\u8fd9\u4e9b\u6307\u5357\u6587\u4ef6\u4ee5\u53ca\u300a\u5c0f\u989d\u8d44\u52a9\u9879\u76ee\u57fa\u91d1\u5e38\u89c1\u95ee\u9898\u4e0e\u89e3\u7b54\u300b(Small Grants Fund Frequently Asked Questions)\u3002\u80dc\u51fa\u63d0\u6848\u987b\u6e05\u695a\u9610\u660e\u8981\u5982\u4f55\u8fd0\u7528 GFW \u7684\u5de5\u5177\u5957\u88c5\u4e0e\u6570\u636e\u5728\u8fd9\u4e09\u4e2a\u5173\u952e\u4e3b\u9898\u4e2d\u7684\u67d0\u4e00\u4e2a\u4e0a\u904f\u5236\u53bb\u68ee\u6797\u5316\u3002", "4fc4323ed33db942af2ee024036e671a": "\u5982\u679c\u8be5\u503c\u8bbe\u4e3a\u201c\u771f\u201d (true)\uff0c\u5219\u5730\u56fe\u5c06\u5305\u542b\u5168\u7403\u7ea2\u6811\u6797\u6570\u636e\u5c42\u3002", "6528c43a0ff8056217b9c8d2ee68f485": "\u81ea\u5b9a\u4e49\u60a8\u5e94\u7528\u7a0b\u5e8f\u7684\u989c\u8272\u4e3b\u9898\u3002", "eb5ac74a92a3550da2b7dc679d10e015": "\u6211\u4eec\u76ee\u524d\u4e0d\u63a5\u53d7 GFW \u6280\u672f\u7814\u7a76\u91d1 (GFW Tech Fellowship) \u7684\u7533\u8bf7\u3002\u5982\u9700\u4e86\u89e3\u6709\u5173\u6280\u672f\u7814\u7a76\u91d1 (Tech Fellowship) \u7684\u66f4\u591a\u4fe1\u606f\uff0c\u656c\u8bf7\u53c2\u9605\u6211\u4eec\u7684\u201c<a class=\"text -paragraph -color-4 -bold\" href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5e38\u89c1\u95ee\u9898\u89e3\u7b54</a>\u201d\u3002", "50f672191a818a605fd23bb59f8e601c": "<strong>\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f</strong>\u3002\u521b\u5efa Web \u5730\u56fe\u540e\uff0c\u60a8\u5c31\u53ef\u4ee5\u57fa\u4e8e\u8fd9\u5f20 Web \u5730\u56fe\u6765\u521b\u5efa\u4e00\u4e2a\u81ea\u5b9a\u4e49 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u3002<a href=\"{{0}}\">\u70b9\u51fb\u6b64\u5904</a>\u4e86\u89e3\u6709\u5173\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\u4ee5\u53ca\u60a8\u53ef\u4ee5\u81ea\u5b9a\u4e49\u7684\u5404\u9879\u529f\u80fd\u7684\u66f4\u591a\u4fe1\u606f\u3002", "f4567ea14c87e6a64a7257724d14c00f": "\u70b9\u51fb\u201c\u7f16\u8f91\u7fa4\u7ec4\u5206\u4eab\u201d\u5e76\u9009\u62e9\u60a8\u521b\u5efa\u7684\u7fa4\u7ec4\uff0c\u7136\u540e\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u3002", "c84089a9ac66f154a832dc26c87115ab": "\u7f16\u8f91\u60a8\u7684\u670d\u52a1\u8bbe\u7f6e\u3002", "68307a75eaf2fc752a666e2ee4b1360c": "\u5728\u60a8\u5b8c\u6210\u5bf9\u60a8\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u7684\u7f16\u8f91\u540e\uff0c\u8bf7\u70b9\u51fb\u201c\u5173\u95ed\u201d\u3002\u5728\u70b9\u51fb\u201c\u5173\u95ed\u201d\u4e4b\u524d\uff0c\u8bf7\u786e\u4fdd\u6240\u6709\u66f4\u6539\u5747\u5df2\u4fdd\u5b58\u3002", "96dc35462654ee9c2f3e3184f426d217": "\u4f7f\u7528\u514d\u8d39\u7684\u516c\u5171 ArcGIS Online \u8d26\u6237\u6765\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f", "e7df8aade50e66638476e68c2ea38f69": "<a href=\"{{0}}\">\u70b9\u51fb\u6b64\u5904</a>\u4e86\u89e3\u6709\u5173\u5982\u4f55\u521b\u5efa Web \u5730\u56fe\u7684\u66f4\u591a\u4fe1\u606f\u3002", "801c3a031db8581993364f96567088ac": "\u8fd9\u573a\u7f51\u7edc\u7814\u8ba8\u4f1a\u91cd\u70b9\u4ecb\u7ecd\u4e86 Reforestamos M\u00e9xico \u662f\u5982\u4f55\u5229\u7528 GFW \u7684\u6570\u636e\u548c\u5de5\u5177\u6765\u76d1\u6d4b\u7c73\u5374\u80af\u5dde\u541b\u4e3b\u6591\u8776\u751f\u7269\u5708\u4fdd\u62a4\u533a (Monarch Butterfly Biosphere Reserve, RBMM) \u5185\u9cc4\u68a8\u79cd\u690d\u56ed\u7684\u6269\u5f20\u60c5\u51b5\u7684\u3002", "6a15a01f8a9ff9dece6c4e34cc896edb": "<strong>\u9875\u9762\u5143\u7d20</strong>\uff1a\u83b7\u53d6\u6709\u5173\u7f51\u683c\u3001\u54cd\u5e94\u5f0f\u9002\u914d\u3001\u7ed3\u6784\u6027\u5143\u7d20\u3001\u901a\u7528\u5143\u7d20\u548c\u4e3b\u6a21\u677f\u7684\u4fe1\u606f\u3002", "650c2be75d4726b3f117f2d24e4b9d3c": "\u5982\u679c\u60a8\u5e0c\u671b\u5728\u516c\u5171 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u4e2d\u4f7f\u7528\u8fd9\u4e9b\u670d\u52a1\uff0c\u5219\u60a8\u9700\u8981\u516c\u5f00\u5206\u4eab\u8fd9\u4e9b\u670d\u52a1\u3002\u5982\u679c\u8981\u8fd9\u6837\u505a\uff0c\u8bf7\u70b9\u51fb\u201c\u5206\u4eab\u201d\uff0c\u786e\u4fdd\u5df2\u9009\u4e2d\u201c\u6240\u6709\u4eba\uff08\u516c\u5f00\uff09\u201d\uff0c\u7136\u540e\u70b9\u201c\u4fdd\u5b58\u201d\u3002\u5982\u679c\u60a8\u5e0c\u671b\u670d\u52a1\u4fdd\u6301\u201c\u79c1\u5bc6\u201d\u72b6\u6001\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u4ec5\u5bf9\u8d35\u7ec4\u7ec7\u5185\u7684\u4eba\u5458\u5206\u4eab\uff0c\u6216\u8005\u7ed9\u5730\u56fe\u8bbe\u7f6e\u5bc6\u7801\u3002", "8df5e515a3d0de1b1789b5b44214e40c": "\u66ff\u4ee3\u8bed\u8a00\u8bbe\u7f6e\u8ba9\u60a8\u53ef\u4ee5\u4e3a\u60a8\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u6307\u5b9a\u7b2c\u4e8c\u8bed\u8a00\u6216\u66ff\u4ee3\u8bed\u8a00\u3002\u60a8\u4e5f\u53ef\u4ee5\u63d0\u4f9b\u4e00\u4efd\u7ffb\u8bd1\u8fc7\u7684\u5730\u56fe\u3001\u6807\u9898\u3001\u5b50\u6807\u9898\u3001\u63cf\u8ff0\u4ee5\u53ca Web \u5730\u56fe\u83dc\u5355\u540d\u79f0\u3002\u53ea\u6709\u5728\u60a8\u5e0c\u671b\u7ffb\u8bd1\u60a8\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u65f6\u624d\u9700\u8981\u7528\u5230\u8fd9\u4e9b\u8bbe\u7f6e\u3002", "04f300db96ecea8c1c655689c366b928": "\u8981\u540c\u60a8\u7684\u7fa4\u7ec4\u5206\u4eab MapBuilder \u6a21\u677f\uff0c\u70b9\u51fb\u201c\u5206\u4eab\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u7f16\u8f91\u7fa4\u7ec4\u5206\u4eab\u201d\u3002\u9009\u62e9\u60a8\u7684\u7fa4\u7ec4\uff0c\u7136\u540e\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u3002", "a116b059c51e3ccf0489557a6a21923e": "- \u6309\u6708\u53d1\u653e\u6d25\u8d34\uff0c\u5e76\u53ef\u83b7\u5f97\u53ef\u81ea\u7531\u652f\u914d\u7684\u989d\u5916\u8d44\u91d1\uff0c\u8fd9\u4e9b\u8d44\u91d1\u53ef\u7528\u4e8e\u5b9e\u5730\u8003\u5bdf\u3001\u8bbe\u5907\u8d2d\u4e70\u3001\u4e13\u4e1a\u53d1\u5c55\u6216\u7528\u6765\u652f\u4ed8\u7814\u8ba8\u4f1a\u7684\u8d39\u7528\u3002", "f9856377a12bfad313d21349dc42931b": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Women Research Institute</a> \u4e8e 2018 \u5e74 4 \u6708\u5236\u4f5c\u4e86\u300a\u706b\u707e\u4e0e\u96fe\u973e\u7684\u5f71\u54cd\u300b\u6f2b\u753b\u518c\u3002\u6f2b\u753b\u518c\u5c55\u793a\u4e86\u7531\u706b\u707e\u9020\u6210\u7684\u96fe\u973e\u7ed9\u5370\u5ea6\u5c3c\u897f\u4e9a\u793e\u533a\u6240\u5e26\u6765\u7684\u5f71\u54cd\uff0c\u4ee5\u53ca\u50cf GFW \u8fd9\u6837\u7684\u65e9\u671f\u9884\u8b66\u7cfb\u7edf\u53ef\u4ee5\u5982\u4f55\u5e2e\u52a9\u5e94\u5bf9\u3002\u8be5\u6f2b\u753b\u518c\u63d0\u4f9b\u5370\u5ea6\u5c3c\u897f\u4e9a\u8bed\u7248\u672c\u3002", "e20af119d6ede038dd44af8060b96388": "\u89c2\u770b\u7f51\u7edc\u7814\u8ba8\u4f1a\uff08\u897f\u73ed\u7259\u8bed\uff09\u3002", "41dcf997183da53a1d88b5ad500244c4": "Forest Watcher \u7684\u79fb\u52a8\u5e94\u7528\u4ece\u8bbe\u8ba1\u4e0a\u5c31\u5177\u6709\u80fd\u8ba9\u5373\u4f7f\u8eab\u5904\u6700\u504f\u8fdc\u7684\u96e8\u6797\u4e2d\u7684\u7528\u6237\u4e5f\u80fd\u83b7\u53d6 GFW \u6570\u636e\u7684\u7279\u6027\uff0c\u4ece\u800c\u53ef\u4ee5\u4e3a\u4e16\u754c\u5404\u5730\u7684\u68ee\u6797\u5b88\u62a4\u8005\u63d0\u4f9b\u652f\u6301\u3002\u89c2\u770b\u540d\u4e3a\u201cForest Watcher\uff1a\u79bb\u7ebf\u4e0e\u5b9e\u5730\u76d1\u6d4b\u68ee\u6797\u201d\u7684\u77ed\u7247\uff0c\u4ee5\u4fbf\u5bf9\u6539\u8fdb\u540e\u7684 Forest Watcher \u79fb\u52a8\u5e94\u7528\u7684\u6982\u51b5\u6709\u6240\u4e86\u89e3\u3002\u6539\u8fdb\u540e\u7684\u5e94\u7528\u65e8\u5728\u51cf\u5c11\u5bf9\u5e26\u5bbd\u7684\u9700\u6c42\uff0c\u540c\u65f6\u6539\u5584\u4e86\u5e94\u7528\u7684\u6574\u4f53\u4f53\u9a8c\u3002\u8fd9\u573a\u7f51\u8def\u7814\u8ba8\u4f1a\u63d0\u4f9b\u82f1\u8bed\u3001\u897f\u73ed\u7259\u8bed\u3001\u8461\u8404\u7259\u8bed\u3001\u6cd5\u8bed\u548c\u5370\u5ea6\u5c3c\u897f\u4e9a\u8bed\u7248\u672c\u3002", "8d7c9187479ce0aa2444a52593c7bebc": "\u70b9\u51fb\u201c\u7f16\u8f91\u201d\u4ee5\u5c06\u4efb\u4f55\u9644\u52a0\u4fe1\u606f\u6dfb\u52a0\u81f3\u8981\u7d20\u670d\u52a1\u4e2d\u3002", "2eda551d8889a62c93e1809b3102b18f": "\u89c6\u9891\u7531 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Women Research Institute</a> \u5236\u4f5c\u3002", "aded57fd5a247a8c9320a2f5548f1b3f": "\u8fd9\u90e8\u5206\u4fe1\u606f\u5206\u4e3a\u4e09\u4e2a\u90e8\u5206\uff0c\u5305\u62ec\u201c\u54c1\u724c\u51c6\u5219\u201d\u3001\u201c\u9875\u9762\u5143\u7d20\u201d\u548c\u201c\u5e94\u7528\u7a0b\u5e8f\u201d\u3002", "ffd265e380b9e7e417abdf5a0ad37f8b": "\u89c2\u770b\u7f51\u7edc\u7814\u8ba8\u4f1a\uff08\u8461\u8404\u7259\u8bed\uff09\u3002", "d530d6cab5ac8e0a53b616a4fb766377": "<strong>\u66ff\u4ee3\u8bed\u8a00\u8bbe\u7f6e</strong>\uff1a\u628a\u60a8\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u7ffb\u8bd1\u6210\u5176\u4ed6\u8bed\u8a00\u3002", "24ac4041d0ed49398cae8b6f43842c3c": "\u89c2\u770b\u6f14\u793a\u77ed\u7247\uff08\u8461\u8404\u7259\u8bed\uff09\u3002", "acb60ab26680fc5af3911b2d476c59d2": "\u70b9\u51fb\u201c\u914d\u7f6e\u5c5e\u6027\u201d\u3002", "4e3f14e63dc2142a4197f4acb31bd799": "\u8981\u5c06\u67d0\u4e2a\u6570\u636e\u5c42\u6dfb\u52a0\u81f3\u5730\u56fe\uff0c\u8bf7\u70b9\u51fb\u4f4d\u4e8e\u6570\u636e\u5c42\u53f3\u4e0b\u65b9\u7684\u201c+\u201d\u56fe\u6807\u3002", "e9bb7316975a23d13f8a54b66c1a89a8": "\u4e3a shapefile \u8bbe\u7f6e\u4e00\u4e2a\u6807\u9898\u5e76\u4e3a\u5176\u6dfb\u52a0\u4efb\u4f55\u9002\u7528\u7684\u6807\u7b7e\uff0c\u7136\u540e\u70b9\u51fb\u201c\u6dfb\u52a0\u9879\u76ee\u201d\u3002", "6ee4a4bcf4dd2f465e2b07a9846c7fdf": "\u81ea\u5b9a\u4e49\u68ee\u6797\u5730\u56fe", "ced73cc5c01cd4472c33b725b1e476a2": "\u6ce8\u518c ArcGIS \u8981\u7d20\u670d\u52a1\u3002", "3325c0cbe5a0ead2795c8be417185454": "\u8bf7\u8f93\u5165\u60a8\u7684\u4e2a\u4eba\u8d44\u6599\u4fe1\u606f\uff0c\u786e\u4fdd\u6240\u6709\u5fc5\u586b\u680f\u4f4d\u90fd\u5df2\u586b\u5199\u5b8c\u6bd5\u3002", "83afb263de5a02fd318d9520b8da7157": "<strong>\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f</strong>\u3002\u521b\u5efa Web \u5730\u56fe\u540e\uff0c\u60a8\u53ef\u4ee5\u5c06\u5176\u96c6\u6210\u5230\u67d0\u4e2a\u81ea\u5b9a\u4e49 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u4e2d\u3002<a href=\"{{0}}\">\u70b9\u51fb\u6b64\u5904</a>\u4e86\u89e3\u6709\u5173\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\u4ee5\u53ca\u60a8\u53ef\u4ee5\u81ea\u5b9a\u4e49\u7684\u5404\u9879\u529f\u80fd\u7684\u66f4\u591a\u4fe1\u606f\u3002", "7d2f34e7e234e105f852ff823dc8f834": "\u7ed9\u7fa4\u7ec4\u547d\u540d\u3001\u6dfb\u52a0\u6240\u6709\u9002\u7528\u7684\u6807\u7b7e\uff0c\u7136\u540e\u6839\u636e\u8d35\u7ec4\u7ec7\u7684\u9700\u8981\u6765\u4fee\u6539\u7fa4\u7ec4\u8bbe\u7f6e\u3002\u7fa4\u7ec4\u7684\u6210\u5458\u8d44\u683c\u5e94\u9650\u5236\u5728\u8d35\u7ec4\u7ec7\u5185\u90e8\uff0c\u4e14\u7fa4\u7ec4\u6210\u5458\u5e94\u8be5\u53ea\u80fd\u7f16\u8f91\u5176\u672c\u4eba\u7684\u9879\u76ee\u3002\u5728\u586b\u597d\u4fe1\u606f\u4e4b\u540e\uff0c\u70b9\u51fb\u201c\u521b\u5efa\u7fa4\u7ec4\u201d\u5373\u53ef\u4fdd\u5b58\u8be5\u7fa4\u7ec4\u3002", "a278267a20d5235650380531e89a4e1a": "\u8981\u521b\u5efa Web \u5730\u56fe\uff0c\u8bf7\u5148\u70b9\u51fb\u4f4d\u4e8e\u9876\u90e8\u83dc\u5355\u4e0a\u7684\u201c\u5730\u56fe\u201d\u3002\u60a8\u5c06\u88ab\u5e26\u5230\u4e00\u5f20\u9ed8\u8ba4\u7684 Web \u5730\u56fe\u4e0a\uff0c\u60a8\u53ef\u4ee5\u5728\u6b64\u8fdb\u884c\u81ea\u5b9a\u4e49\u3002", "48dd7c43da7ef49d8c5de0d1458cb167": "\u5982\u679c\u60a8\u62e5\u6709 ArcGIS Server\u3001GeoServer \u6216 MapServer\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u4f7f\u7528\u60a8\u7684\u514d\u8d39\u516c\u5171 ArcGIS Online \u8d26\u6237\u6765\u6ce8\u518c\u670d\u52a1\u3002\u6ce8\u518c\u670d\u52a1\u540e\uff0c\u60a8\u6240\u6ce8\u518c\u7684\u670d\u52a1\u5c06\u4ee5\u9879\u76ee\u7684\u5f62\u5f0f\u6dfb\u52a0\u81f3\u60a8\u7684 ArcGIS Online \u8d26\u6237\u4e2d\u3002\u5982\u679c\u60a8\u7684\u670d\u52a1\u5305\u542b\u591a\u4e2a\u6570\u636e\u5c42\uff0c\u5219\u5efa\u8bae\u60a8\u5c06\u6bcf\u4e2a\u670d\u52a1\u6ce8\u518c\u4e3a\u4e00\u4e2a\u5355\u72ec\u7684\u6570\u636e\u5c42\u3002", "6ebec14f17cd7ed363f54edf7d227040": "\u70b9\u51fb\u4f4d\u4e8e\u9876\u90e8\u83dc\u5355\u4e0a\u7684\u201c\u5206\u4eab\u201d\u7136\u540e\u9009\u62e9\u201c\u6240\u6709\u4eba\uff08\u516c\u5f00\uff09\u201d\u3002", "f13e1edf6b7609a87fb4ce906b6acd5e": "\u60a8\u7684\u5fbd\u6807\u56fe\u7247\u7684 URL\u3002", "2216848263a8f4e194581e417ea30e92": "\u89c2\u770b\u7f51\u7edc\u7814\u8ba8\u4f1a\uff08\u6cd5\u8bed\uff09\u3002", "e87e06361e3a0778fc24018c06cdc5b4": "\u70b9\u51fb\u4f4d\u4e8e\u9876\u90e8\u83dc\u5355\u4e0a\u7684\u201c\u7ec4\u7ec7\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u8bbe\u7f6e\u201d\uff0c\u53ef\u4ee5\u6307\u5b9a\u53ef\u914d\u7f6e\u5e94\u7528\u7a0b\u5e8f\u7684\u9ed8\u8ba4\u7fa4\u7ec4\u3002\u9009\u62e9\u201c\u8bbe\u7f6e\u201d\u4e2d\u7684\u201c\u5730\u56fe\u201d\u90e8\u5206\u3002", "da9f35192041a4cdb008613d86b05f20": "\u8981\u81ea\u5b9a\u4e49\u5f39\u51fa\u7a97\u53e3\uff0c\u8bf7\u70b9\u51fb\u201c\u2026\u201d\u56fe\u6807\uff0c\u7136\u540e\u70b9\u51fb\u201c\u914d\u7f6e\u5f39\u7a97\u201d\u3002", "637044118f4eea3464667a9cb3b5c331": "\u590d\u5236\u94fe\u63a5\u6765\u5206\u4eab\uff0c\u6216\u662f\u76f4\u63a5\u5206\u4eab\u81f3 Twitter \u6216 Facebook\u3002", "2615698aaa3dd2426b6eeaf58efc3743": "\u5173\u95ed\u4f4d\u4e8e\u5de6\u4e0a\u65b9\u7684\u7b5b\u9009\u5668\u4ee5\u4fbf\u53ea\u5728\u8d35\u7ec4\u7ec7\u5185\u641c\u7d22\u3002", "35bf0eeb1a238406d6435a79f0fdcd20": "\u9996\u5148\uff0c\u60a8\u9700\u8981\u8bbf\u95ee\u60a8\u5728 ArcGIS Online \u4e0a\u521b\u5efa\u7684 Web \u5730\u56fe\u3002\u4ece\u8fd9\u4e00\u6b65\u8d77\uff0c\u60a8\u5c31\u53ef\u4ee5\u5c06 MapBuilder \u6a21\u677f\u914d\u7f6e\u5230\u60a8\u7684 Web \u5730\u56fe\u4e0a\u4e86\u3002\u70b9\u51fb\u4f4d\u4e8e\u9876\u90e8\u83dc\u5355\u4e0a\u7684\u201c\u5206\u4eab\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u521b\u5efa Web \u5e94\u7528\u201d\u3002", "01ccccdfea6b6dc6cf11ec96e4f9e968": "\u8981\u7f16\u8f91\u8fd9\u4e9b\u8bbe\u7f6e\uff0c\u8bf7\u4fee\u6539\u5de6\u4fa7\u8868\u5355\uff0c\u7136\u540e\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u3002\u5728\u4efb\u4f55\u65f6\u5019\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u90fd\u5c06\u66f4\u65b0 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u7684\u9884\u89c8\u3002", "d510caf7f4ba28f4ff3526c8cabe482b": "\u5728\u5e94\u7528\u7a0b\u5e8f\u4e2d\u5305\u542b\u201c\u6587\u6863\u201d\u9009\u9879\u5361\u3002", "8d065bd371e5b82cbfcca82e552f0237": "\u51a0\u72b6\u75c5\u6bd2\u75c5\u7684\u5927\u6d41\u884c\u6539\u53d8\u4e86\u4e16\u754c\u5404\u5730\u4eba\u4eec\u7684\u751f\u6d3b\uff0c\u4e5f\u5f71\u54cd\u5230\u4e86\u6211\u4eec\u5168\u7403\u68ee\u6797\u793e\u533a (Global Forest Community) \u5de5\u4f5c\u7684\u5f00\u5c55\u3002\u89c2\u770b\u8fd9\u6bb5\u7f51\u7edc\u7814\u8ba8\u4f1a\u5f55\u50cf\u4ee5\u4fbf\u5bf9 GFW \u7684\u5de5\u5177\u548c\u529f\u80fd\u7684\u6982\u51b5\u6709\u6240\u4e86\u89e3\uff0c\u8fd9\u4e9b\u5de5\u5177\u4e0e\u529f\u80fd\u53ef\u4ee5\u5e2e\u60a8\u5728\u8fd9\u6bb5\u4e0d\u5f97\u4e0d\u8fdc\u7a0b\u5de5\u4f5c\u3001\u5b9e\u5730\u4f5c\u4e1a\u673a\u4f1a\u6709\u9650\u7684\u65f6\u95f4\u91cc\u6700\u4e3a\u9ad8\u6548\u5730\u5f00\u5c55\u5de5\u4f5c\u3002", "023d6628aa26d4067ae1540bfd4845c7": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">HAkA</a> \u4e8e 2019 \u5e74 11 \u6708\u5236\u4f5c\u4e86\u4e00\u4efd\u300aGFW \u4e0e Forest Watcher \u6307\u5357\u300b\uff0c\u300a\u6307\u5357\u300b\u5c55\u793a\u4e86\u5982\u4f55\u4f7f\u7528\u8be5\u5730\u56fe\u4ee5\u53ca Forest Watcher Web\uff0c\u540c\u65f6\u4e5f\u5305\u62ec\u5982\u4f55\u4e0a\u4f20\u6570\u636e\u5230 Google Maps \u7684\u5185\u5bb9\u3002\u8be5\u6307\u5357\u63d0\u4f9b\u5370\u5ea6\u5c3c\u897f\u4e9a\u8bed\u7248\u672c\u3002", "158ce6e6f2dbcc6c4fcf9aa819edf8ef": "- \u9605\u8bfb 2021 \u5e74\u7248\u7684<a class=\"text -paragraph -color-4 -bold\" href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u300a\u7533\u8bf7\u4eba\u6307\u5357\u300b</a>", "ef2122b1f6167ed82901f16a272972cd": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Sociedad Peruana de Derecho Ambiental (SPDA)</a> \u4e8e 2018 \u5e74 4 \u6708\u5236\u4f5c\u4e86\u4e00\u4efd\u540d\u4e3a\u300a\u79d8\u9c81\u4e9a\u9a6c\u900a\u96e8\u6797\u53bb\u68ee\u6797\u5316\u9884\u9632\u89c4\u7ea6\u300b\u7684\u624b\u518c\uff0c\u4e3a\u79c1\u4eba\u4fdd\u62a4\u533a\u7684\u6301\u6709\u4eba\u63d0\u4f9b\u4e86\u6709\u5173\u5982\u4f55\u9884\u9632\u53ca\u5e94\u5bf9\u53bb\u68ee\u6797\u5316\u5a01\u80c1\u7684\u6307\u5bfc\u610f\u89c1\u3002\u8be5\u624b\u518c\u63d0\u4f9b\u897f\u73ed\u7259\u8bed\u7248\u672c\u3002", "61facdf901b7d95f6d7bf4ceaac2801a": "\u201c\u5e38\u89c4\u8bbe\u7f6e\u201d\u662f\u60a8\u53ef\u4ee5\u81ea\u5b9a\u4e49\u8bf8\u5982\u5e94\u7528\u7a0b\u5e8f\u6587\u672c\u3001\u5fbd\u6807\u3001\u8d85\u94fe\u63a5\u4ee5\u53ca Web \u5730\u56fe\u7b49\u9879\u76ee\u7684\u5730\u65b9\u3002\u8fd9\u4e9b\u9879\u76ee\u662f\u5730\u56fe\u7684\u5e38\u89c4\u5c5e\u6027\uff0c\u60a8\u53ef\u4ee5\u76f4\u63a5\u4f7f\u7528\u4ee3\u7801\u6765\u7f16\u8f91\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u70b9\u51fb\u6b64\u5904</a>\u524d\u5f80 GitHub \u4ee5\u4e86\u89e3\u6709\u5173\u8fd9\u4e9b\u5e38\u89c4\u5c5e\u6027\u7684\u66f4\u591a\u4fe1\u606f\u3002", "065c51c3c44070392ba8da0e903cb25b": "\u70b9\u51fb\u201c\u66f4\u6539\u6837\u5f0f\u201d\u56fe\u6807\uff08\u5c31\u662f\u7531\u4e09\u79cd\u5f62\u72b6\u53e0\u5728\u4e00\u8d77\u7ec4\u6210\u7684\u90a3\u4e2a\u56fe\u6807\uff09\u6765\u7f16\u8f91\u60a8\u7684\u6570\u636e\u53ef\u89c6\u5316\u3002", "0db13e057cd3841894242528aa853ed8": "<strong>\u5411 ArcGIS Online \u6dfb\u52a0\u6570\u636e</strong>\u3002\u4f7f\u7528\u7ec4\u7ec7\u8d26\u53f7\uff0c\u7528\u6237\u53ef\u4ee5\u9009\u62e9\u53d1\u5e03\u6765\u81ea ArcGIS Desktop \u7684\u6570\u636e\uff0c\u6216\u5c06\u73b0\u6709\u7684 GIS Web \u5c42\u6dfb\u52a0\u5230 ArcGIS Online\u3002<a href=\"{{0}}\">\u70b9\u51fb\u6b64\u5904</a>\u4ee5\u4e86\u89e3\u5982\u4f55\u5c06 shapefile \u4f5c\u4e3a\u8981\u7d20\u670d\u52a1\u53d1\u5e03\uff0c\u4ece\u800c\u4ee5\u4fbf\u60a8\u5c06\u5176\u4f5c\u4e3a\u6570\u636e\u5c42\u6dfb\u52a0\u5230\u60a8\u7684 Web \u5730\u56fe\u4e0a\u3002", "80bf407146215ceaa2b4e430c84774ac": "\u4ece\u66ff\u4ee3\u8bed\u8a00\u7684 Web \u5730\u56fe\u4e2d\u63d0\u53d6\u7684\u4e00\u7ec4\u6570\u636e\u5c42\u5728\u83dc\u5355\u4e0a\u7684\u6807\u9898\u3002", "c7e9b884807c249bdb5f06dc48acae10": "<strong>\u5728\u793e\u4ea4\u5a92\u4f53\u4e0a\u5206\u4eab</strong>\uff1aMapBuilder \u6a21\u677f\u542b\u6709\u5185\u5efa\u7684\u793e\u4ea4\u5a92\u4f53\u5206\u4eab\u529f\u80fd\u3002\u5982\u679c\u8981\u5728\u793e\u4ea4\u5a92\u4f53\u4e0a\u5206\u4eab\u60a8\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f\uff0c\u8bf7\u70b9\u51fb\u53f3\u4e0a\u65b9\u7684\u201c\u5206\u4eab\u201d\u56fe\u6807\uff0c\u8fd9\u65f6\u7a0b\u5e8f\u5c06\u6293\u53d6\u60a8\u76ee\u524d\u5728\u5730\u56fe\u4e0a\u6240\u770b\u5230\u7684\u786e\u5207\u89c6\u56fe\uff0c\u5e76\u5c06\u6b64\u751f\u6210\u4e00\u6761\u94fe\u63a5\u3002\u60a8\u53ef\u4ee5\u590d\u5236\u8be5\u94fe\u63a5\u6765\u5206\u4eab\uff0c\u6216\u662f\u70b9\u51fb Facebook \u6216 Twitter \u7684\u5fbd\u6807\uff0c\u4ece\u800c\u5c06\u5176\u76f4\u63a5\u5206\u4eab\u5230\u5176\u4e2d\u4e00\u4e2a\u5e73\u53f0\u4e0a\u3002", "a70bbeb4d7fbfd542d82bb8e4cfb41fc": "\u5728\u5934\u90e8\u6dfb\u52a0\u201c\u5173\u4e8e\u201d\u83dc\u5355\u9879\u3002\u8be5\u94fe\u63a5\u5c06\u6307\u5411\u7ed9\u5b9a\u7684 URL\u3002", "247d4dae6a6d6e197d08d1f24fc0fc50": "\u9009\u62e9\u60a8\u521b\u5efa\u7684\u7fa4\u7ec4\uff0c\u7136\u540e\u4e0e\u8be5\u7fa4\u7ec4\u5206\u4eab Esri \u9ed8\u8ba4\u53ef\u914d\u7f6e\u5e94\u7528\u3002", "65cd9dd8d354fe1bd7b62c98d58fcaa9": "\u53ea\u6709\u5f53\u60a8\u5c06\u591a\u4e2a\u5e94\u7528\u7a0b\u5e8f\u8fde\u63a5\u5728\u4e00\u8d77\u65f6\uff0c\u201c\u5730\u56fe\u4e3b\u9898\u201d\u5b57\u6bb5\u624d\u662f\u5fc5\u987b\u7684\u3002\u201c\u5730\u56fe\u4e3b\u9898\u201d\u8868\u793a\u60a8\u76f8\u5173\u5e94\u7528\u7a0b\u5e8f\u7684\u6807\u9898\u3002\u8bf7\u786e\u4fdd\u4ee5\u4e0e\u5730\u56fe\u4e3b\u9898 ID \u76f8\u540c\u7684\u987a\u5e8f\u6765\u6307\u5b9a\u4e3b\u9898\u3002\u5982\u679c\u60a8\u7684\u5e94\u7528\u7a0b\u5e8f\u662f\u7ffb\u8bd1\u8fc7\u7684\uff0c\u5219\u8bf7\u4f7f\u7528\u7ffb\u8bd1\u540e\u7684\u5730\u56fe\u4e3b\u9898\u6807\u9898\u6765\u586b\u5199\u201calternativeMapThemes\u201d\u5b57\u6bb5\u3002", "092abad42bd662ace9838c72b945625c": "\u9996\u5148\u521b\u5efa\u4e00\u4e2a\u7fa4\u7ec4\uff0c\u7528\u6765\u5b58\u653e\u8d35\u7ec4\u7ec7\u7684 ArcGIS Online \u8d26\u6237\u4e2d\u7684\u53ef\u914d\u7f6e\u5e94\u7528\u7a0b\u5e8f\u3002\u8981\u521b\u5efa\u7fa4\u7ec4\uff0c\u8bf7\u70b9\u51fb\u201c\u7fa4\u7ec4\u201d\uff0c\u7136\u540e\u70b9\u51fb\u5de6\u4e0a\u65b9\u7684\u201c+ \u521b\u5efa\u7fa4\u7ec4\u201d\u3002", "813fd01402564e9a46ded85f4783f210": "\u67e5\u770b\u68ee\u6797\u8d8b\u52bf", "3a471037316cc4195383c764e8e0970e": "- \u5728\u68ee\u6797\u76d1\u6d4b\u3001\u571f\u5730\u5229\u7528\u89c4\u5212\u3001\u6cd5\u5f8b\u5ba3\u4f20\u4e0e\u6267\u884c\u4ee5\u53ca\u9879\u76ee\u8bbe\u8ba1\u4e0e\u5b9e\u65bd\u65b9\u9762\u63a5\u53d7\u4e13\u5bb6\u57f9\u8bad\u3002", "c8db9239c63b1d0bef8d364420437393": "\u6d4f\u89c8\u76ee\u524d MapBuilder \u652f\u6301\u7684\u6240\u6709\u8bed\u8a00\u3002", "d2c4c8898348fe24bab6c05e2c9a9959": "\u66ff\u4ee3\u8bed\u8a00\u4e0b\u7684\u5e94\u7528\u7a0b\u5e8f\u6807\u9898\u3002", "6cd54b85cab7249d0c83128f4960fd9e": "\u6280\u672f\u7814\u7a76\u91d1 (Tech Fellowship)", "d1f2152e3b79382efdc57b6334f320b4": "GFW \u7684\u6280\u672f\u7814\u7a76\u5458 Madeleine Ngeunga \u4e8e 2020 \u5e74 11 \u6708\u5236\u4f5c\u4e86\u4e00\u4efd\u300aGFW \u7528\u6237\u6307\u5357\u300b\uff0c\u5176\u4e2d\u5c55\u793a\u4e86\u521a\u679c\u76c6\u5730\u7684\u65b0\u95fb\u5de5\u4f5c\u8005\u53ef\u4ee5\u5982\u4f55\u4f7f\u7528\u5730\u56fe\u53ca\u4eea\u8868\u76d8\u3002\u8fd9\u4efd\u300a\u7528\u6237\u6307\u5357\u300b\u63d0\u4f9b\u6cd5\u8bed\u7248\u672c\u3002", "078da0969c14a03757d6c51de3648a16": "<strong>\u9ad8\u7ea7\u8bbe\u7f6e</strong>\uff1a\u5728\u7279\u5b9a\u56fd\u5bb6\u6216\u5730\u533a\u6dfb\u52a0\u906e\u7f69\u3001\u663e\u793a\u6216\u9690\u85cf MapBuilder \u6807\u9898\u3001\u6dfb\u52a0\u989d\u5916\u7684\u6587\u6863\u5de5\u5177\u4ee5\u53ca\u542f\u7528\u201c\u767b\u5f55\u6211\u7684 GFW\u201d\u4e0e\u201c\u8bbf\u95ee\u9884\u8b66\u8ba2\u9605\u201d\u529f\u80fd\u3002", "d87be0bb5628b6860afb1fb604514364": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Amaz\u00f3nicos por la Amazon\u00eda (AMPA)</a> \u4e8e 2020 \u5e74 2 \u6708\u5728\u79d8\u9c81\u521b\u5efa\u4e86\u540d\u4e3a\u201c\u5e94\u5bf9\u73af\u5883\u72af\u7f6a\u8def\u7ebf\u56fe\u201d\u7684\u4fe1\u606f\u56fe\u8868\uff0c\u4ee5\u5c55\u793a\u9488\u5bf9\u4fdd\u62a4\u7279\u8bb8\u6743\u4ee5\u53ca\u5176\u4ed6\u68ee\u6797\u7279\u8bb8\u6743\u7684\u73af\u5883\u72af\u7f6a\u7684\u5e94\u5bf9\u6d41\u7a0b\u3002\u8be5\u4fe1\u606f\u56fe\u8868\u63d0\u4f9b\u82f1\u8bed\u7248\u4e0e\u897f\u73ed\u7259\u8bed\u7248\u3002", "b9b0a148e125b97fd74091111c41f47e": "\u8fd4\u56de\u7b2c\u4e00\u6b65\u4ee5\u4e0a\u4f20\u5176\u4ed6 shapefile \u6587\u4ef6\u3002", "a3ffab228928cb16cbf012c25a2a9ef1": "<strong>\u767b\u5f55\u8d35\u7ec4\u7ec7\u7684 ArcGIS Online \u8d26\u6237</strong>\u3002\u5b9a\u4f4d\u81f3 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">ArcGIS Online</a> \u5e76\u4f7f\u7528\u8d35\u7ec4\u7ec7\u7684\u8d26\u6237\u6765\u767b\u5f55\u3002\u5982\u679c\u60a8\u6ca1\u6709\u7528\u6237\u540d\uff0c\u5219\u8bf7\u8054\u7cfb\u60a8\u7684 ArcGIS Online \u7ba1\u7406\u5458\u4e3a\u60a8\u521b\u5efa\u8d26\u6237\u3002", "423508818c5f5eb569d39adbbc27d9e6": "\u5982\u679c\u8be5\u503c\u8bbe\u4e3a\u201c\u771f\u201d (true)\uff0c\u5219\u5730\u56fe\u5c06\u5305\u542b GLAD \u9884\u8b66\u6570\u636e\u5c42\u3002", "a713313162029ba7392918869f2d7072": "\u5982\u679c\u60a8\u6709 GIS \u670d\u52a1\u5668\uff0c\u8bf7\u4f7f\u7528\u60a8\u7684\u8d26\u6237\u6765\u6ce8\u518c\u670d\u52a1\u3002", "d08f03c0098d04ef52615248d635c220": "\u5e03\u5c14\u503c\uff08true \u6216 false\uff09", "8b1e5b3464f680b79fcee83efb3c213c": "\u89c2\u770b\u6f14\u793a\u77ed\u7247\uff08\u6cd5\u8bed\uff09\u3002", "ba978ae658db0e3966fec62d72fb9189": "\u662f\u5c06\u5728\u5e94\u7528\u7a0b\u5e8f\u7684\u201c\u4fe1\u606f\u201d\u9009\u9879\u5361\u4e2d\u663e\u793a\u7684\u7b80\u77ed\u63cf\u8ff0\u3002\u4f7f\u7528 HTML \u6807\u7b7e\u5bf9\u8fd9\u6bb5\u6587\u672c\u7684\u683c\u5f0f\u8fdb\u884c\u7f16\u8f91\u4e0e\u81ea\u5b9a\u4e49\u3002", "9d41658a6a389a93f3ef4bcaec484ebd": "\u70b9\u51fb\u201c\u5185\u5bb9\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u6dfb\u52a0\u9879\u76ee\u201d\u5e76\u9009\u62e9\u201c\u4ece\u6211\u7684\u7535\u8111\u4e2d\u9009\u62e9\u201d\u3002", "4902105299efe8bbab6da59933dd3e3c": "\u8c03\u6574\u6570\u636e\u5c42\u4e0e\u5206\u6790\u8bbe\u7f6e", "31a875ecc746eaca6b0b02e0f6730d57": "\u9009\u62e9\u4e00\u4e2a\u6570\u636e\u6e90\u6765\u6d4f\u89c8\u53ef\u7528\u7684\u6570\u636e\u5c42\u3002", "4174848724828c64a5171d177cb3b101": "\u5982\u679c\u8be5\u503c\u8bbe\u4e3a\u201c\u771f\u201d (true)\uff0c\u5219\u5730\u56fe\u5c06\u5305\u542b Terra-i \u9884\u8b66\u6570\u636e\u5c42\u3002", "b0b5ccb4a195a07fd3eed14affb8695f": "\u7c7b\u522b", "5c5044b7214856d399f746cfaef986da": "Global Forest Watch \u535a\u5ba2", "2f9ecdee37de7c3f5b984f118907edfc": "\u7387\u5148\u4e86\u89e3\u6700\u65b0\u7684\u68ee\u6797\u7814\u7a76\u548c\u65b0\u95fb\uff01Global Forest Watch \u535a\u5ba2\u5229\u7528\u6570\u636e\u63ed\u793a\u5168\u7403\u68ee\u6797\u7684\u72b6\u6001\uff0c\u8bb2\u8ff0\u81f4\u529b\u4e8e\u4fdd\u62a4\u8fd9\u4e9b\u68ee\u6797\u7684\u4eba\u4eec\u7684\u6545\u4e8b\u3002\u9605\u8bfb\u4e86\u89e3\u96e8\u6797\u3001\u68ee\u6797\u780d\u4f10\u3001\u706b\u707e\u3001\u53ef\u6301\u7eed\u53d1\u5c55\u519c\u4e1a\u3001\u68ee\u6797\u7ba1\u7406\u4ee5\u53ca\u5bf9\u68ee\u6797\u7684\u672a\u6765\u81f3\u5173\u91cd\u8981\u7684\u5176\u4ed6\u4e3b\u9898\u3002", "488fcb9cdb77f8eb2e0bfbab0c5efffb": "\u89c2\u5bdf\u5730\u70b9", "23c6932bc0d64d2660884049949becfd": "\u6700\u65b0\u6587\u7ae0", "67519ed56c064a6082f33db868cdaf77": "\u52a0\u8f7d\u66f4\u591a\u6587\u7ae0", "399f0cb25848887b1c86ee60242ae8ed": "GFW \u9996\u5148\u662f\u4e00\u4e2a\u6570\u636e\u9a71\u52a8\u578b\u5e73\u53f0\u3002\u9605\u8bfb\u6700\u65b0\u7684\u68ee\u6797\u7814\u7a76\u548c\u5206\u6790\u3002", "017f2b1e402ca267ec50e8ffe2604813": "\u8046\u542c\u5b9e\u5730\u5de5\u4f5c\u7684\u68ee\u6797\u4fdd\u536b\u8005\u8bb2\u8ff0\u7684\u6545\u4e8b\u3002", "0ef9c69b6007859bca4a1471c3fd7406": "\u8be5\u5730\u533a\u7684\u5927\u90e8\u5206\u6816\u606f\u5730\u7531{eco_0}\u7ec4\u6210\u3002\u5b83\u8fd8\u5305\u62ec{eco_1}\u533a\u57df\u3002\u8be5\u5730\u533a\u4e2d\u6709\u4e00\u4e9b\u672a\u53d7\u4fb5\u6270\u7684\u68ee\u6797\u3002\u8be5\u533a\u57df\u4e3b\u8981\u4e3a{kop_0}\u3002\u5927\u90e8\u5206\u8be5\u5730\u533a\u7531{bio_0}\u7ec4\u6210\uff0c\u4e5f\u5305\u62ec\u4e00\u4e9b{bio_1}\u533a\u57df\u3002\u8be5\u5730\u70b9\u4e3b\u8981\u4e3a{lsf_0}\u3002{area_0}\u5730\u533a\u4f4d\u4e8e{area_1}\u3002", "8ef152bba38d6f48a922b376db17951c": "2010\u5e74\uff0c{location}\u7684\u6811\u6728\u8986\u76d6\u9762\u79ef\u4e3a{extent}\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684{percentage}\u3002\u5728{year}\u5e74\uff0c\u8be5\u5730\u70b9\u635f\u5931\u4e86{loss}\u7684\u6811\u6728\u8986\u76d6\u9762\u79ef\uff0c\u76f8\u5f53\u4e8e{emissionsTreeCover}\u7684\u4e8c\u6c27\u5316\u78b3\u6392\u653e\u91cf\u3002", "593955d3fe278d098ba3ae4378f6969e": "\u8bf7\u52a1\u5fc5\u6ce8\u610f\u201c\u5df2\u5b8c\u6210\u201d\u62a5\u544a\u548c\u201c\u5df2\u4e0a\u4f20\u201d\u62a5\u544a\u4e4b\u95f4\u7684\u533a\u522b\u3002\u201c\u5df2\u5b8c\u6210\u201d\u62a5\u544a\u4ec5\u50a8\u5b58\u5728\u60a8\u7684\u8bbe\u5907\u4e0a\uff0c\u800c \u201c\u5df2\u4e0a\u4f20\u201d\u62a5\u544a\u4e0d\u4ec5\u50a8\u5b58\u5728\u60a8\u7684\u8bbe\u5907\u4e0a\uff0c\u8fd8\u5df2\u540c\u6b65\u81f3 Forest Watcher Web\u3002\u5982\u679c\u60a8\u5728\u201c\u79bb\u7ebf\u6a21 \u5f0f\u201d\u4e0b\u521b\u5efa\u5e76\u5b8c\u6210\u4e86\u4e00\u4efd\u62a5\u544a\uff0c\u6216\u8005\u60a8\u6ca1\u6709\u8fde\u63a5\u7f51\u7edc\uff0c\u62a5\u544a\u5c06\u88ab\u5f52\u7c7b\u4e3a\u201c\u5df2\u5b8c\u6210\u201d\u3002\u7528\u6237\u8054\u7f51\u65f6\uff0c ForestWatcher \u4e0d\u4f1a\u81ea\u52a8\u5c06\u201c\u5df2\u5b8c\u6210\u201d\u62a5\u544a\u540c\u6b65\u81f3 ForestWatcherWeb\u3002\u60a8\u5fc5\u987b\u624b\u52a8\u9009\u62e9\u5e76\u540c \u6b65\u201c\u5df2\u5b8c\u6210\u201d\u62a5\u544a\uff0c\u8fd9\u6837\uff0c\u5b83\u4eec\u624d\u4f1a\u88ab\u91cd\u65b0\u5206\u7c7b\u4e3a\u201c\u5df2\u4e0a\u4f20\u201d\uff0c\u5e76\u5728 Forest Watcher Web \u4e0a\u53ef \u7528\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u4e86\u89e3\u5982\u4f55\u4f7f\u7528 Forest Watcher Web \u7ba1\u7406\u68ee\u6797\u76d1\u6d4b\u56e2\u961f\u3002", "b61fc4df1469b2a1f2b87cf2db560b73": "\u60a8\u53ef\u4ee5<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener nofollow\">\u5728\u6b64\u627e\u5230\u83b7\u53d6\u6388\u6743\u4ee4\u724c\u7684\u5b8c\u6574\u89c4\u8303</a>\u3002", "28e35f50809a749de019633f9dc75f9d": "\u70b9\u51fb\u5de6\u4e0a\u89d2\u7684\u8fd4\u56de\u7bad\u5934\u56fe\u6807\uff0c\u5bfc\u822a\u56de\u5230\u4e3b\u9875\uff0c\u7136\u540e\u70b9\u51fb\u201c\u62a5\u544a\u201d\uff0c\u9884\u89c8\u3001\u5bfc\u51fa\u6216\u4e0a\u4f20\u62a5\u544a\u3002\u60a8 \u53ef\u4ee5\u770b\u5230\u81ea\u5df1\u7684\u8349\u7a3f\u62a5\u544a\u3001\u5df2\u5b8c\u6210\u62a5\u544a\u548c\u5df2\u4e0a\u4f20\u62a5\u544a\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u4e86\u89e3\u5982\u4f55\u5206\u4eab\u62a5\u544a\u7b49\u5e94\u7528 \u5185\u5bb9\u3002", "d96327c48f8c6f51e2259affb723de3b": "\u8981\u67e5\u770b\u6570\u636e\u76ee\u5f55\u4e2d\u7684\u53ef\u7528\u5185\u5bb9\uff0c\u60a8\u9700\u8981\u8bf7\u6c42\u4e00\u4e2a\u5305\u542b\u5168\u90e8\u6570\u636e\u96c6\u7684\u5217\u8868\uff0c\u8bf7\u5411<strong>\u6570\u636e\u96c6</strong> \u7aef\u70b9\u53d1\u9001 GET \u8bf7\u6c42\u3002", "546b21394afd3c0b8dae91f8eb02e06a": "\u8981\u81ea\u5b9a\u4e49\u5e95\u56fe\uff0c\u8bf7\u70b9\u51fb\u5730\u56fe\u5e95\u90e8\u7684\u8bbe\u7f6e\u9f7f\u8f6e\u56fe\u6807\uff0c\u7136\u540e\u9009\u62e9\u60a8\u60f3\u67e5\u770b\u7684\u5e95\u56fe\u3002\u5e95\u56fe\u53ef\u8ba9\u60a8\u4ee5 \u4e0d\u540c\u80cc\u666f\u67e5\u770b\u5730\u56fe\uff0c\u6709\u52a9\u4e8e\u6570\u636e\u53ef\u89c6\u5316\u3002\u6bd4\u5982\uff0c\u201c\u536b\u661f\u201d\u663e\u793a\u4e86\u536b\u661f\u56fe\u50cf\uff0c\u4e14\u542b\u6709\u6765\u81ea Google \u7684\u5730\u7406\u540d\u79f0\u548c\u6807\u8bb0\uff0c\u6709\u52a9\u4e8e\u60a8\u5728\u67d0\u4e00\u533a\u57df\u8fdb\u884c\u5b9a\u4f4d\u3002\u70b9\u51fb\u201c\u7ba1\u7406\u5e95\u56fe\u201d\uff0c\u4e0b\u8f7d\u5730\u56fe\u4ee5\u4f9b\u79bb\u7ebf\u4f7f \u7528\uff0c\u5c06\u5730\u56fe\u5206\u4eab\u81f3\u5176\u4ed6\u8bbe\u5907\u6216\u4e0a\u4f20\u60a8\u81ea\u5df1\u7684\u5e95\u56fe\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u4e86\u89e3\u5982\u4f55\u4e0a\u4f20\u60a8\u81ea\u5df1\u7684\u5e95\u56fe; <a href=\"{{1}}\">\u5728\u6b64</a>\u4e86\u89e3\u6709\u5173\u5206\u4eab\u5e95\u56fe\u7b49\u5e94\u7528\u5185\u5bb9\u7684\u66f4\u591a\u4fe1\u606f\u3002", "26143ac96913fe759a0212f81d96b52e": "\u8981\u81ea\u5b9a\u4e49\u4e0a\u4e0b\u6587\u56fe\u5c42\uff0c\u8bf7\u70b9\u51fb\u201c\u4e0a\u4e0b\u6587\u56fe\u5c42\u201d\u4e0b\u65b9\u7684\u8bbe\u7f6e\u9f7f\u8f6e\u56fe\u6807\uff0c\u7136\u540e\u9009\u62e9\u60a8\u60f3\u5728\u5730\u56fe\u4e0a\u67e5 \u770b\u7684\u4e0a\u4e0b\u6587\u56fe\u5c42\u3002\u70b9\u51fb\u201c\u7ba1\u7406\u4e0a\u4e0b\u6587\u56fe\u5c42\u201d\uff0c\u4e0b\u8f7d\u56fe\u5c42\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\uff0c\u5c06\u56fe\u5c42\u5206\u4eab\u81f3\u5176\u4ed6\u8bbe\u5907 \u6216\u4e0a\u4f20\u60a8\u81ea\u5df1\u7684\u56fe\u5c42\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u4e86\u89e3\u5982\u4f55\u4e0a\u4f20\u60a8\u81ea\u5df1\u7684\u4e0a\u4e0b\u6587\u56fe\u5c42;<a href=\"{{1}}\">\u5728\u6b64</a>\u4e86\u89e3\u6709\u5173 \u5206\u4eab\u4e0a\u4e0b\u6587\u56fe\u5c42\u7b49\u5e94\u7528\u5185\u5bb9\u7684\u66f4\u591a\u4fe1\u606f\u3002", "013cbee7b47a2b3845803a8f5453566d": "\u60a8\u5c06\u6536\u5230\u4e00\u6761\u5e26\u6709 {{0}} \u548c\u6570\u636e\u5c5e\u6027\u7684 JSON \u54cd\u5e94\u3002\u5728 {{1}} \u5c5e\u6027\u4e2d\uff0c\u60a8\u5c06\u770b\u5230\u6b64\u7279\u5b9a\u6570\u636e \u96c6\u7684\u8be6\u7ec6\u4fe1\u606f\u3002", "1cd8b6023494b2ac6200dc86981db92d": "\u8981\u81ea\u5b9a\u4e49\u62a5\u544a\uff0c\u8bf7\u70b9\u51fb\u201c\u62a5\u544a\u201d\u4e0b\u65b9\u7684\u8bbe\u7f6e\u9f7f\u8f6e\u56fe\u6807\u3002\u51fa\u5916\u4e1a\u65f6\u53ef\u521b\u5efa\u62a5\u544a\uff0c\u4ee5\u8bb0\u5f55\u6240\u6709\u53d1\u73b0\u3002 \u62a5\u544a\u80fd\u5e2e\u52a9\u60a8\u5173\u4e8e\u67d0\u4e00\u533a\u57df\u6240\u53d1\u73b0\u7684\u5185\u5bb9\u63d0\u4f9b\u989d\u5916\u4fe1\u606f\u3002\u60a8\u53ef\u4ee5\u4ece\u4e4b\u524d\u4fdd\u5b58\u7684\u62a5\u544a\u5217\u8868\u4e2d\u9009 \u62e9\u4e00\u9879\uff0c\u5728\u5730\u56fe\u4e2d\u67e5\u770b\u3002\u70b9\u51fb\u201c\u7ba1\u7406\u62a5\u544a\u201d\uff0c\u7f16\u8f91\u6216\u5206\u4eab\u5df2\u4fdd\u5b58\u7684\u62a5\u544a\u3002<a href=\"{{0}}\">\u5728\u8fd9\u91cc</a>\uff0c\u4e86\u89e3\u6709 \u5173\u5206\u4eab\u62a5\u544a\u7b49\u5e94\u7528\u5185\u5bb9\u7684\u66f4\u591a\u4fe1\u606f\u3002", "17e0561450736ad62eb04c170d80ab15": "\u60a8\u53ef\u4ee5\u4f7f\u7528 <strong>/query</strong> \u7aef\u70b9\u8bf7\u6c42\u67d0\u4e2a\u7279\u5b9a\u6570\u636e\u96c6\u7684\u6d41\u5f0f\u6570\u636e\u3002\u8fd9\u662f\u8bf7\u6c42\u53ef\u4e0b\u8f7d\u6587\u4ef6\u7684\u66ff \u4ee3\u65b9\u6cd5\u3002\u4ee5\u4e0b URL \u5c55\u793a\u4e86\u8bf7\u6c42\u6d41\u5f0f\u6570\u636e\u7684\u6b63\u786e\u8bf7\u6c42\u683c\u5f0f\u3002\u5f69\u8272\u6587\u672c\u7a81\u51fa\u663e\u793a\u4e86\u8981\u66ff\u6362\u7684\u7247 \u6bb5:: {DATASET_NAME} \u548c {VERSION}", "7787f85a9c8c5cd04994978805b933d7": "\u8981\u81ea\u5b9a\u4e49\u8def\u7ebf\uff0c\u8bf7\u70b9\u51fb\u201c\u8def\u7ebf\u201d\u4e0b\u65b9\u7684\u8bbe\u7f6e\u9f7f\u8f6e\u56fe\u6807\u3002\u8def\u7ebf\u8ddf\u8e2a\u4e86\u62b5\u8fbe\u67d0\u4e00\u533a\u57df\u7684\u8def\u5f84\uff0c\u53ef\u4fdd \u5b58\u81f3\u5e94\u7528\u3002\u91cd\u8bbf\u5730\u70b9\u65f6\uff0c\u8def\u7ebf\u53ef\u8d77\u5230\u5e2e\u52a9\u3002\u60a8\u53ef\u4ee5\u4ece\u4e4b\u524d\u4fdd\u5b58\u7684\u8def\u7ebf\u5217\u8868\u4e2d\u9009\u62e9\u4e00\u6761\uff0c\u5728\u5730 \u56fe\u4e2d\u67e5\u770b\u3002\u70b9\u51fb\u201c\u7ba1\u7406\u8def\u7ebf\u201d\uff0c\u7f16\u8f91\u6216\u5206\u4eab\u5df2\u4fdd\u5b58\u7684\u8def\u7ebf\u3002<a href=\"{{0}}\">\u5728\u8fd9\u91cc</a>\uff0c\u4e86\u89e3\u6709\u5173\u5206\u4eab\u8def\u7ebf\u7b49 \u5e94\u7528\u5185\u5bb9\u7684\u66f4\u591a\u4fe1\u606f\u3002", "116d96c64106f789b6f1ff0650801b6e": "\u8981\u81ea\u5b9a\u4e49\u8b66\u62a5\uff0c\u8bf7\u70b9\u51fb\u201c\u8b66\u62a5\u201d\u4e0b\u65b9\u7684\u8bbe\u7f6e\u9f7f\u8f6e\u56fe\u6807\u3002\u5728\u8fd9\u91cc\uff0c\u60a8\u53ef\u4ee5\u6307\u5b9a\u8981\u53ef\u89c6\u5316\u7684\u6bc1\u6797\u8b66 \u62a5\uff0c\u4fee\u6539\u6240\u9009\u6bc1\u6797\u8b66\u62a5\u7684\u65e5\u671f\u8303\u56f4\uff0c\u5f00\u542f\u706b\u707e\u8b66\u62a5\u5e76\u4fee\u6539\u8b66\u62a5\u7684\u65e5\u671f\u8303\u56f4\u3002\u6bc1\u6797\u8b66\u62a5\u548c\u706b\u707e \u8b66\u62a5\u6307\u51fa\u4e86\u53ef\u80fd\u53d1\u751f\u68ee\u6797\u53d8\u5316\u7684\u533a\u57df\uff0c\u6709\u52a9\u4e8e\u786e\u5b9a\u8c03\u67e5\u533a\u4f18\u5148\u7ea7\u3002\u53ef\u5728\u5730\u56fe\u4e0a\u540c\u65f6\u67e5\u770b\u6bc1\u6797 \u8b66\u62a5\u548c\u706b\u707e\u8b66\u62a5\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u4e86\u89e3\u6709\u5173\u6bc1\u6797\u8b66\u62a5\u7c7b\u578b\u7684\u66f4\u591a\u5185\u5bb9\u3002", "36d906a0f460c92096d774a965ae109d": "\u9ed8\u8ba4\u60c5\u51b5\u4e0b\uff0c\u6807\u51c6\u67e5\u8be2\u8bf7\u6c42\u5c06\u4ee5 JSON \u683c\u5f0f\u8fd4\u56de\u6d41\u5f0f\u6570\u636e\u3002\u8981\u8bf7\u6c42\u5176\u4ed6\u683c\u5f0f\uff0c\u60a8\u9700\u8981\u6307\u5411 \u6b64\u7279\u5b9a\u7aef\u70b9\u3002\u4f8b\u5982\uff0c\u8981\u8bf7\u6c42 CSV \u683c\u5f0f\u7684\u6570\u636e\uff0c\u60a8\u53ef\u4ee5\u5728\u67e5\u8be2\u7aef\u70b9\u672b\u5c3e\u6dfb\u52a0 <strong>/csv/</strong>:", "7fa17e1a5117268a0df1466f35db56fc": "\u4e86\u89e3\u8bf7\u6c42\u7684\u57fa\u672c\u7247\u6bb5/\u4e0b\u8868\u63cf\u8ff0\u4e86\u67e5\u8be2 GFW Data API \u65f6 POST \u8bf7\u6c42\u7684\u57fa\u672c\u7247\u6bb5/\u8bf7\u6c42\u7247\u6bb5/ \u63cf\u8ff0/\u6570\u636e\u96c6\u540d\u79f0/GFWDataAPI \u4e2d\u6570\u636e\u96c6\u7684\u552f\u4e00\u540d\u79f0\u3002/\u7248\u672c/\u6570\u636e\u96c6\u53ef\u6709\u591a\u4e2a\u7248\u672c\u3002\u65e7\u7248\u672c \u4e5f\u4fdd\u7559\u5728 API \u4e2d\uff0c\u56e0\u6b64 [...]", "082633ae4d6b8b862333ffe002583465": "GFW Data API \u63d0\u4f9b\u8bb8\u591a\u4e0d\u540c\u6570\u636e\u96c6\u7684\u8bbf\u95ee\u6743\u9650\uff0c\u7528\u6237\u53ef\u5bf9\u8fd9\u4e9b\u6570\u636e\u96c6\u8fdb\u884c\u53ef\u89c6\u5316\u3001\u5206\u6790\u548c \u4e0b\u8f7d\u3002\u672c\u6559\u7a0b\u5c06\u4ecb\u7ecd\u6570\u636e\u76ee\u5f55\u7684\u7ed3\u6784\uff0c\u4ee5\u53ca\u5982\u4f55\u53d1\u73b0\u8981\u4f7f\u7528\u7684\u7279\u5b9a\u6570\u636e\u96c6\u3002/\u6570\u636e\u76ee\u5f55/GFW Data API \u76ee\u5f55\u4ee5\u4e09\u7ea7\u5c42\u6b21\u7ed3\u6784\u7ec4\u7ec7\u4e86\u6570\u636e\u96c6\uff0c\u8be5\u5c42\u6b21\u7ed3\u6784\u53ef\u901a\u8fc7 [...] \u8fdb\u884c\u53ef\u89c6\u5316:", "9b412669450766995f37a5ae1c104b34": "\u60a8\u53ef\u4ee5\u4f7f\u7528 <strong>/download</strong> \u7aef\u70b9\u8bf7\u6c42\u67d0\u4e2a\u7279\u5b9a\u6570\u636e\u96c6\u7684\u53ef\u4e0b\u8f7d\u6587\u4ef6\u3002\u8fd9\u662f\u67e5\u8be2\u6d41\u5f0f\u6570\u636e \u7684\u66ff\u4ee3\u65b9\u6cd5\u3002\u4ee5\u4e0b URL \u5c55\u793a\u4e86\u8bf7\u6c42\u4e0b\u8f7d\u6587\u4ef6\u7684\u6b63\u786e\u8bf7\u6c42\u683c\u5f0f\u3002\u5f69\u8272\u6587\u672c\u7a81\u51fa\u663e\u793a\u4e86\u8981\u66ff\u6362 \u7684\u7247\u6bb5:: {DATASET_NAME} \u548c {VERSION}", "155e3a589e88da888bfb878c2e9fec10": "\u8981\u4f7f\u7528\u7b2c\u4e09\u65b9\u5e94\u7528\u7a0b\u5e8f(\u5982\uff0c\u811a\u672c\u6216\u7f51\u7ad9)\u5411 GFW \u6570\u636e API \u53d1\u8d77\u5927\u591a\u6570\u8bf7\u6c42\uff0c\u60a8\u9700\u8981\u4f7f \u7528 API \u5bc6\u94a5\u3002API \u5bc6\u94a5\u80fd\u8ba9 GFW \u786e\u8ba4\u6b63\u5728\u4f7f\u7528 API \u7684\u5e94\u7528\u7a0b\u5e8f\uff0c\u4ee5\u4fbf\u5728\u6709\u7a81\u53d1\u53d8\u5316\u65f6\u901a \u77e5\u5b83\u4eec;\u4e5f\u80fd\u51cf\u5c11\u4f1a\u5e72\u6270 [...] \u670d\u52a1\u7684\u4e0d\u5f53\u4f7f\u7528\u7684\u51e0\u7387", "710a27c801c1d331043481c59d416a5e": "\u9ed8\u8ba4\u60c5\u51b5\u4e0b\uff0c\u6807\u51c6\u67e5\u8be2\u8bf7\u6c42\u5c06\u4ee5 JSON \u683c\u5f0f\u8fd4\u56de\u6570\u636e\u3002\u8981\u8bf7\u6c42 CSV\uff0c\u60a8\u53ef\u4ee5\u5728\u67e5\u8be2\u7aef\u70b9\u672b \u5c3e\u6dfb\u52a0 <strong>/csv/</strong>:", "f8e13e9a4f7ae1718a44497d203b774f": "Amazo\u0301nicos por la Amazoni\u0301a (AMPA) \u521b\u5efa\u4e86\u4e3e\u62a5\u79d8\u9c81\u73af\u5883\u72af\u7f6a\u7684\u624b\u518c\uff0c\u5c31\u975e\u6728\u6750\u7279\u8bb8\u6743\u548c \u4fdd\u62a4\u7279\u8bb8\u6743\u6240\u6709\u8005\u4e3e\u62a5\u73af\u5883\u72af\u7f6a\u6240\u5fc5\u987b\u9075\u5b88\u7684\u6b65\u9aa4\u548c\u8981\u6c42\u63d0\u4f9b\u6307\u5bfc\u3002", "403b848f472e0dbe81c81b3f25319f23": "\u56de\u987e<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener nofollow\">\u5728\u6570\u636e\u76ee\u5f55\u4e2d\u53d1\u73b0\u6570\u636e\u96c6</a>\uff0c\u4e86\u89e3 GFWDataAPI \u6709\u54ea\u4e9b\u53ef\u7528\u6570\u636e\u96c6\u3002\u5728\u672c\u793a\u4f8b\u4e2d\uff0c \u6211\u4eec\u5c06\u67e5\u8be2 {{0}}\uff0c\u603b\u7ed3\u6211\u4eec\u81ea\u5b9a\u4e49\u7684\u611f\u5174\u8da3\u533a\u4e2d\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u9762\u79ef\u3002", "a07d079c7da9a593a7321e8481c0af80": "Amazo\u0301nicos por la Amazoni\u0301a (AMPA) \u521b\u5efa\u4e86 Forest Watcher Web \u6559\u7a0b\u89c6\u9891\uff0c\u6f14\u793a\u5982\u4f55\u4f7f \u7528 Forest Watcher Web\u3002", "b4ae5767b7979b2d5f830778ff438e40": "Amazo\u0301nicos por la Amazoni\u0301a (AMPA) \u521b\u5efa\u4e86 Forest Watcher \u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u6559\u7a0b\u89c6\u9891\uff0c\u6f14 \u793a\u5982\u4f55\u4f7f\u7528 Forest Watcher \u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u3002", "baefcb8c39d0086d2e167aa5cdddfc8e": "\u60a8\u7684\u81ea\u5b9a\u4e49\u51e0\u4f55\u9700\u8981\u4e3a GeoJSON \u683c\u5f0f\u3002\u8bbf\u95ee <a href=\"{{0}}\">https://geojson.io</a>\uff0c\u4f7f\u7528\u4ea4\u4e92\u5f0f\u5730\u56fe\u8f7b \u677e\u751f\u6210\u6b64\u683c\u5f0f\u3002\u5728\u672c\u793a\u4f8b\u4e2d\uff0c\u6211\u4eec\u5c06\u4f7f\u7528\u5370\u5ea6\u5c3c\u897f\u4e9a\u5883\u5185\u7684\u4e00\u4e2a\u5c0f\u4e09\u89d2\u51e0\u4f55:", "5e6cff05be63f30ff6fba29f9ce37f3f": "Amazo\u0301nicos por la Amazoni\u0301a (AMPA) \u521b\u5efa\u4e86\u4f7f\u7528\u65b0\u6280\u672f\u89e3\u51b3\u73af\u5883\u72af\u7f6a\u7684\u624b\u518c\uff0c\u4e3a\u8fd0\u7528\u65b0\u6280 \u672f\u8bc6\u522b\u79d8\u9c81\u68ee\u6797\u7279\u8bb8\u6743\u73af\u5883\u72af\u7f6a\u63d0\u4f9b\u6307\u5bfc\u3002", "85b4f1ca1dd11360237910487b99786c": "Amazo\u0301nicos por la Amazoni\u0301a (AMPA) \u5728\u79d8\u9c81\u4fe1\u606f\u56fe\u4e2d\u521b\u5efa\u4e86\u5e94\u5bf9\u73af\u5883\u72af\u7f6a\u7684\u8def\u7ebf\u56fe\uff0c\u6f14\u793a \u4e86\u5e94\u5bf9\u6d89\u53ca\u4fdd\u62a4\u7279\u8bb8\u6743\u548c\u5176\u4ed6\u68ee\u6797\u7279\u8bb8\u6743\u7684\u73af\u5883\u72af\u7f6a\u7684\u6d41\u7a0b\u3002", "3f480b4eb05ca5ac2c3467b139fe46c3": "\u76ee\u524d\uff0c\u90e8\u5206\u6570\u636e\u96c6\u5177\u6709\u672a\u5728 <strong>/fields/</strong> \u7aef\u70b9\u516c\u5f00\u7684\u7279\u6b8a\u5b57\u6bb5\uff0c\u5c31 {{0}} \u6765\u8bf4\uff0c{{1}} \u5c31\u662f \u6b64\u7c7b\u5b57\u6bb5\u3002\u672a\u6765\uff0c\u8fd9\u7c7b\u5b57\u6bb5\u5c06\u5305\u62ec\u5728 <strong>/fields</strong> \u7aef\u70b9\u8fd4\u56de\u7684\u5b57\u6bb5\u5217\u8868\u4e2d\u3002", "2ee8d231cb2446312b7d098f22cae2ec": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240 (WRI)</a> \u7684 GFW \u56e2\u961f\u5206\u6790\u4e86\u6bcf\u5e74\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\uff0c\u5c55\u793a\u4e86\u5168\u7403\u68ee \u6797\u635f\u5931\u53d1\u751f\u7684\u65f6\u95f4\u548c\u5730\u70b9\u3002\u8fd9\u4e00\u5e74\uff0c\u7ed3\u5408\u6df1\u5ea6\u5206\u6790\u4e0e\u4e13\u5bb6\u4eec\u5bf9\u5f53\u524d\u4e16\u754c\u68ee\u6797\u73b0\u72b6\u7684\u89c1\u89e3\uff0c\u7814 \u7a76\u6240\u901a\u8fc7 <a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">Global Forest Review</a> \u53d1\u5e03\u4e86\u6797\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u3002", "4722c570192aee29477a13ecdd2e73ee": "\u5411 <strong>/query</strong> \u7aef\u70b9\u53d1\u9001\u4e00\u4e2a\u6807\u5934\u542b\u6709 API \u5bc6\u94a5\u7684 POST \u8bf7\u6c42\u3002\u6b64 URL \u5e94\u542b\u6709\u6570\u636e\u96c6\u540d \u79f0\u548c\u7248\u672c\uff0c\u540c\u65f6 body \u6570\u636e\u5e94\u4e3a\u542b\u6709\u51e0\u4f55\u548c sql \u5c5e\u6027\u7684 JSON \u5bf9\u8c61:", "10ddbe5119a83f924a6792366e5de701": "\u89c2\u770b\u6765\u81ea GFW\u3001<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u9a6c\u91cc\u5170\u5927\u5b66\u5168\u7403\u5730\u8868\u5206\u6790\u4e0e\u53d1\u73b0 (GLAD) \u5b9e\u9a8c\u5ba4</a>\u548c<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u74e6\u683c\u5b81\u6839\u5927\u5b66 </a> \u7684\u4e13\u5bb6\u6982\u8ff0 GFW \u4e0a\u63d0\u4f9b\u7684\u5173\u952e\u68ee\u6797\u76d1\u6d4b\u8b66\u62a5\u7cfb\u7edf\u3002\u672c\u6b21\u7f51\u7edc\u7814\u8ba8\u4f1a\u4e2d\uff0c\u6211\u4eec\u4ece\u6d4b\u91cf\u5185 \u5bb9\u548c\u4f7f\u7528\u65b9\u5f0f\u65b9\u9762\u63a2\u8ba8\u4e86 RADD \u8b66\u62a5\u3001GLAD \u6bc1\u6797\u8b66\u62a5\u548c VIIRS \u706b\u707e\u8b66\u62a5\u3002", "24411895617c3162566840028dc1ff51": "\u5982\u679c\u6211\u4eec\u4e0d\u77e5\u9053\u6bc1\u6797\u53d1\u751f\u7684\u65f6\u95f4\u548c\u5730\u70b9\uff0c\u5c31\u5f88\u96be\u4f5c\u51fa\u5e94\u5bf9\u3002\u8fd1\u5b9e\u65f6\u7684\u6bc1\u6797\u8b66\u62a5\u53ef\u4ee5\u5e2e\u52a9\u6211\u4eec \u586b\u8865\u8fd9\u4e00\u7a7a\u767d\uff0c\u5e76\u4e3a\u8fdb\u4e00\u6b65\u7684\u8c03\u67e5\u548c\u884c\u52a8\u63d0\u4f9b\u5173\u952e\u4fe1\u606f\u3002GFW \u6700\u8fd1\u6dfb\u52a0\u4e86\u4e24\u79cd\u65b0\u7684\u6bc1\u6797\u8b66 \u62a5\u7cfb\u7edf\u2014\u2014\u63a2\u6d4b\u6bc1\u6797\u96f7\u8fbe (RADD) \u8b66\u62a5\u548c\u65b0 GLAD-S2 \u6bc1\u6797\u8b66\u62a5\u2014\u2014\u4e8c\u8005\u90fd\u80fd\u8ba9\u6211\u4eec\u66f4\u8be6 \u5c3d\u5730\u4e86\u89e3\u5730\u9762\u5b9e\u51b5\u3002", "549d2ef348e5c7c39eab3c132ff6db89": "\u56de\u987e<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener nofollow\"><a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5728\u6570\u636e\u76ee\u5f55\u4e2d\u53d1\u73b0\u6570\u636e\u96c6</a></a>\uff0c\u4e86\u89e3 GFW Data API \u6709\u54ea\u4e9b\u53ef\u7528\u6570\u636e\u96c6\u3002\u8bf7\u6ce8 \u610f\uff0cAPI \u63d0\u4f9b\u4e86\u4e09\u79cd\u4e0d\u540c\u6bc1\u6797\u8b66\u62a5\u7cfb\u7edf\u7684\u8bbf\u95ee\u6743\u9650:", "699b7fe2d310dd08e6c821afd9f57619": "\u6b63\u5982\u7f51\u7edc\u7814\u8ba8\u4f1a\u6240\u63a2\u8ba8\u7684\uff0cPlanet \u7684\u9ad8\u5206\u8fa8\u7387\u536b\u661f\u56fe\u50cf\u73b0\u5df2\u5411\u81f4\u529b\u4e8e\u963b\u6b62\u6bc1\u6797\u3001\u5e94\u5bf9\u6c14\u5019\u53d8 \u5316\u7684\u4eba\u7fa4\u5f00\u653e\u3002\u60a8\u53ef\u4ee5\u8bbf\u95ee <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">NICFI \u8ba1\u5212\u7f51\u9875</a>\uff0c\u4e86\u89e3\u6709\u5173\u6b64\u8ba1\u5212\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u6ce8\u518c\u514d\u8d39 \u7684 Planet Explorer \u8d26\u6237\uff0c\u5e76\u8bbf\u95ee <a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">Planet Explorer \u7528\u6237\u6307\u5357</a>\uff0c\u4e86\u89e3\u5982\u4f55\u4f7f\u7528\u8fd9\u6b3e\u5728\u7ebf \u5de5\u5177\u3002", "c1d26feb8d2dfbf845ff96fe043fc2e0": "\u6b64\u8bf7\u6c42\u7684\u54cd\u5e94\u5c06\u63d0\u4f9b\u4e00\u4e2a\u5217\u8868\uff0c\u5305\u542b\u6570\u636e\u96c6\u4e2d\u6240\u6709\u53ef\u7528\u5b57\u6bb5\u3002\u6839\u636e\u67e5\u8be2\u76ee\u7684\uff0c\u6700\u91cd\u8981\u7684\u5b57\u6bb5 \u662f {{0}} \u548c {{1}}\uff0c\u8fd9\u4e9b\u5b57\u6bb5\u80fd\u8ba9\u6211\u4eec\u6307\u5b9a\u65e5\u671f\u548c\u7f6e\u4fe1\u5ea6\u3002", "7cb993e00c57b5cefd670bf80c83445b": "\u60a8\u77e5\u9053\u5417?\u9664\u4e86 GFW \u63d0\u4f9b\u7684\u591a\u79cd\u6bc1\u6797\u8b66\u62a5\u7cfb\u7edf\uff0c\u60a8\u8fd8\u53ef\u4ee5\u8bbf\u95ee\u536b\u661f\u56fe\u50cf\u6765\u9a8c\u8bc1\u548c\u8c03\u67e5\u68ee \u6797\u53d8\u5316\u3002\u89c2\u770b\u6765\u81ea GFW\u3001<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">KSAT</a> \u548c <a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">Planet</a> \u7684\u4e13\u5bb6\u4eec\u8be6\u8ff0\u5982\u4f55\u4f7f\u7528\u536b\u661f\u56fe\u50cf\u786e\u5b9a \u5168\u7403\u68ee\u6797\u7684\u73b0\u51b5\u3002", "e8d2c354222b88dc2183d74e230609b4": "\u76ee\u524d\uff0c\u90e8\u5206\u6570\u636e\u96c6\u5177\u6709\u672a\u5728 <strong>/fields/</strong> \u7aef\u70b9\u516c\u5f00\u7684\u7279\u6b8a\u5b57\u6bb5\uff0c\u5c31 {{0}}(\u548c\u6240\u6709\u6bc1\u6797\u8b66\u62a5 \u6570\u636e\u96c6)\u6765\u8bf4\uff0c{{1}} \u548c {{2}} \u5c31\u662f\u6b64\u7c7b\u5b57\u6bb5\u3002\u672a\u6765\uff0c\u8fd9\u7c7b\u5b57\u6bb5\u5c06\u5305\u62ec\u5728 <strong>/fields</strong> \u7aef\u70b9\u8fd4 \u56de\u7684\u5b57\u6bb5\u5217\u8868\u4e2d\u3002", "36e4118298be788b5570d83e4c322700": "\u5411 <strong>/query</strong> \u7aef\u70b9\u53d1\u9001\u4e00\u4e2a\u6807\u5934\u542b\u6709 API \u5bc6\u94a5\u7684 POST \u8bf7\u6c42\u3002\u6b64 URL \u5e94\u542b\u6709\u6570\u636e\u96c6\u540d \u79f0\u548c\u7248\u672c\uff0c\u540c\u65f6 body \u6570\u636e\u5e94\u4e3a\u542b\u6709\u51e0\u4f55\u548c sql \u5c5e\u6027\u7684 JSON \u5bf9\u8c61:", "d505e6f76b8c34be57f7f87cc20eb6fb": "\u4e0b\u65b9\u7b80\u8ff0\u4e86\u7528\u6237\u5728\u51c6\u5907\u5c06 KML/KMZ \u6587\u4ef6\u4e0a\u4f20\u5230 GFW Pro (Pro) \u65f6\u53ef\u4ee5\u9075\u5faa\u7684\u5de5\u4f5c\u6d41\u7a0b\u3002KML\uff08Keyhole \u6807\u8bb0\u8bed\u8a00\uff09\u6587\u4ef6\u662f\u4e00\u79cd\u4e3a\u7528\u4e8e Google \u5730\u7403\u800c\u5f00\u53d1\u7684\u5730\u7406\u7a7a\u95f4\u6587\u4ef6\u683c\u5f0f\u3002KMZ \u662f KML \u6587\u4ef6\u7684\u538b\u7f29\u7248\u672c\uff0c\u4e24\u8005\u90fd\u88ab Pro \u63a5\u53d7\u3002GIS \u65b0\u7528\u6237\u548c\u6709\u7ecf\u9a8c\u7684 GIS \u5206\u6790\u5e08\u90fd\u5e94\u8be5\u67e5\u770b\u8fd9\u4e9b\u6b65\u9aa4\uff0c\u6709\u52a9\u4e8e\u5c3d\u91cf\u51cf\u5c11\u53ef\u80fd\u51fa\u73b0\u7684 Pro \u6570\u636e\u4e0a\u4f20\u9519\u8bef\u3002", "29106a30579c5f6d83bce9134c4e59a2": "\u8981\u505c\u7528\u8d26\u53f7\uff0c\u7ba1\u7406\u5458\u5fc5\u987b\u901a\u8fc7\u7535\u5b50\u90ae\u4ef6\u5411<a href=\"{{0}}\">gfwprosupport@wri.org</a>\u53d1\u9001\u6b63\u5f0f\u505c\u7528\u8bf7\u6c42\u3002Pro \u8d85\u7ea7\u7ba1\u7406\u5458\u5c06\u5728\u4e24\u4e2a\u5de5\u4f5c\u65e5\u5185\u56de\u590d\u7535\u5b50\u90ae\u4ef6\u6a21\u677f\u3002\u7136\u540e\u7ba1\u7406\u5458\u5fc5\u987b\u586b\u5199\u7535\u5b50\u90ae\u4ef6\u6a21\u677f\uff0c\u5e76\u56de\u590d Pro \u8d85\u7ea7\u7ba1\u7406\u5458\u4ee5\u786e\u8ba4\u8bf7\u6c42\u3002\u6240\u6709\u7528\u6237\u548c\u6570\u636e\u90fd\u5c06\u5b89\u5168\u5730\u4fdd\u5b58\u5728 Pro \u7684\u8d26\u6237\u6570\u636e\u5e93\u4e2d\uff0c\u4f46\u4efb\u4f55\u7ec4\u7ec7\u5747\u65e0\u6cd5\u8bbf\u95ee\u3002", "3407280307940a6cea99c3119b05ebaf": "\u53cc\u51fb KML/KMZ \u6587\u4ef6\u6216\u6253\u5f00 Google \u5730\u7403\u5e76\u5c06\u6587\u4ef6\u6dfb\u52a0\u5230\u60a8\u7684\u4f4d\u7f6e\u3002", "73d13183ba3e273aa861e646ed8da78c": "\u7f16\u8f91\u60a8\u7ec4\u7ec7\u7684\u4fe1\u606f\u5e76\u4e0a\u4f20\u6216\u7ba1\u7406\u653f\u7b56\u6587\u4ef6\u3002", "7af3340b44437041340df06cfcda925c": "\u67e5\u770b GFW \u5217\u8868\u4e0a\u548c\u60a8\u7ec4\u7ec7\u8d26\u6237\u5185\u7684\u6240\u6709\u5217\u8868\u4e0a\u7684\u8bca\u65ad\u548c\u663e\u793a\u677f\u7ed3\u679c\u3002", "c939b73c45b503f4555d5d29cb0e5faf": "\u7f16\u8f91\u548c\u89c2\u770b\u8005\u4e5f\u53ef\u4ee5\u7ba1\u7406\u4ed6\u4eec\u7684\u6863\u6848\uff0c\u7f16\u8f91\u82e5\u5e72\u6863\u6848\u4fe1\u606f\u3002", "b244d4886a223adcd1080ad9c037a14e": "GFW Pro\u7528\u6237\u5185\u5bb9", "435c94297547fbcd33634c56834abe79": "\u5728\u5b50\u72b6\u6001\u5c42\uff0c\u53ef\u89c6\u5316\u6a21\u5f0f\u4f1a\u53d1\u751f\u53d8\u5316\u3002Pro\u4f1a\u901a\u8fc7\u786e\u5b9a\u6700\u63a5\u8fd1\u591a\u8fb9\u5f62\u4e2d\u5fc3\uff08\u4e2d\u5fc3\u70b9\uff09\u7684\u5b50\u72b6\u6001\uff0c\u4e3a\u4e0a\u4f20\u7684shapefile\u5206\u914d\u4e00\u4e2a\u5b50\u72b6\u6001\u3002shapefile\u4e2d\u7684\u6240\u6709\u8b66\u62a5\u4ecd\u5c06\u5728\u591a\u8fb9\u5f62\u7684\u4e2d\u5fc3\u88ab\u8ba1\u7b97\u548c\u53ef\u89c6\u5316\u3002", "246c800cf3252ec8d6a88b73f07991f1": "\u6253\u5f00\u201c\u6570\u636e\u7ba1\u7406\u201d\u5de5\u5177\u7bb1\u3002\u4f7f\u7528\u201c\u914d\u7f6e\u201d\u5de5\u5177\u7bb1\u4e2d\u7684\u201c\u68c0\u67e5\u51e0\u4f55\u5f62\u72b6\u201d\u5de5\u5177\uff0cArcGIS\u5c06\u751f\u6210\u4e00\u4e2a\u8868\u683c\u6765\u8bc6\u522b\u6570\u636e\u4e2d\u7684\u9519\u8bef\u3002", "73445edd8e55aa3ff5ba422e572443e7": "\u70b9\u51fb\u7f51\u9875\u53f3\u4e0a\u65b9\u7684\u201c\u5206\u4eab\u201d\u3002\u4ece\u4e0b\u62c9\u83dc\u5355\u4e2d\u9009\u62e9\u60a8\u60f3\u5206\u4eab\u5217\u8868\u7684\u7ec4\u7ec7\u6210\u5458\u3002\u9009\u5b9a\u540e\uff0c\u70b9\u51fb\u201c\u6dfb\u52a0\u7528\u6237\u201d\u3002", "3c1bc880d4dbde5c00c18f3a02af1ac2": "\u63a5\u53d7\u6765\u81ea\u60a8\u8d26\u6237\u5185\u7684\u7ba1\u7406\u5458\u7684\u5171\u4eab\u5217\u8868\u3002", "23cb72816784fe000206f16728cc90b5": "\u5c06\u6bcf\u4e2aKML/KMZ\u6587\u4ef6\u9650\u5236\u57281,500\u4e2a\u591a\u8fb9\u5f62\u6216\u70b9\u3002\u6587\u4ef6\u5927\u5c0f\u4e5f\u5e94\u9650\u5236\u57285 MB/5,000 KB\u3002\u82e5\u60f3\u521b\u5efa\u66f4\u5c0f\u7684KML/KMZ\u6587\u4ef6\uff0c\u8bf7\u521b\u5efaKML/KMZ\u6587\u4ef6\u7684\u526f\u672c\uff0c\u7136\u540e\u5c06\u5176\u7c98\u8d34\u5230Google Earth\u3002\u5220\u9664\u914d\u7f6e\uff0c\u76f4\u5230KML/KMZ\u6587\u4ef6\u4e0d\u8d85\u8fc71,500\u884c\uff0c\u5e76\u4e14\u4e0d\u8d85\u8fc75 MB/5,000 KB\uff0c\u7136\u540e\u5c06\u5176\u4fdd\u5b58\u4e3a\u65b0\u6587\u4ef6\u3002", "cbf88177755f6bbff5d6cd868b95c8ef": "<strong>\u5927\u8c46\u901a\u7528</strong>\uff1a\u5efa\u8bae\u7528\u4e8e\u7cae\u4ed3\u548c\u519c\u573a\u4ee5\u5916\u7684\u5927\u8c46\u4f9b\u5e94\u94fe\u5730\u70b9\u3002", "deb2206295cb6c01903305ed2069a234": "\u5728GFW\u5217\u8868\u3001\u60a8\u7684\u5217\u8868\u548c\u4e0e\u60a8\u5171\u4eab\u7684\u5217\u8868\u4e0a\u67e5\u770b\u8bca\u65ad\u548c\u5de5\u4f5c\u9762\u677f\u7ed3\u679c\u3002", "e28a7c5ee680ff023eca2ceecdf1d32b": "\u4f5c\u4e3a\u7f16\u8f91\uff0c\u60a8\u53ef\u4ee5\u5728Pro\u7248\u8fdb\u884c\u4ee5\u4e0b\u64cd\u4f5c\u3002", "cde782500a496ce78f02804e4c21d49c": "\u8f93\u5165\u65b0\u7528\u6237\u4fe1\u606f\uff0c\u7136\u540e\u70b9\u51fb\u7f51\u9875\u5e95\u90e8\u7684\u201c\u4fdd\u5b58\u201d\u3002", "53ec1b8a6c0636bacba6472a02717361": "\u6dfb\u52a0\u548c\u7ba1\u7406\u6765\u81ea\u60a8\u7684\u7ec4\u7ec7\u7684\u7528\u6237\u3002", "03e1233d53160a08131eaf78d5314fc5": "<strong>\u4e0a\u4f20\u6587\u4ef6</strong>\uff1a\u6587\u4ef6\u6700\u5927\u4e3a5 MB\u3002\u63a5\u53d7\u7684\u6587\u4ef6\u7c7b\u578b\u5305\u62ec\uff1aCSV\u6216Excel\uff0c\u5305\u542bshapefile\uff08.shp\u3001.dbf\u3001.prj\uff09\u7684.Zip\u6587\u4ef6\uff0cKML\u6216KMZ\u3002", "f0570c67e2aa79effdf2322f2feb01f5": "\u4ee5\u7f16\u8f91\u6216\u89c2\u770b\u8005\u7684\u8eab\u4efd\u7ba1\u7406\u6863\u6848", "92a19e15985570623642face97cb78ed": "<strong>\u725b\u8089\u5c60\u5bb0\u573a</strong>\uff1a\u5efa\u8bae\u7528\u4e8e\u4f9b\u5e94\u94fe\u4e2d\u7684\u725b\u8089\u5c60\u5bb0\u573a\u3002", "ed06d3348cb366a494917dd341200f8b": "\u5728\u4e0b\u8f7d\u7684Excel\u6a21\u677f\u4e2d\uff0c\u60a8\u4f1a\u770b\u5230\u4e00\u7cfb\u5217\u7684\u5206\u680f\uff0c\u60a8\u53ef\u4ee5\u5c06\u5730\u70b9\u7684\u8be6\u7ec6\u4fe1\u606f\u586b\u5145\u8fdb\u53bb\u3002", "68aa2a6e3a5f870c1ca0d413a39107dd": "\u6bcf\u4e2a\u7ec4\u7ec7\u53ea\u80fd\u6709\u4e00\u4e2a\u8d26\u6237\u3002\u5e10\u6237\u7ba1\u7406\u5458\u53ef\u4ee5\u5728\u5176\u7ec4\u7ec7\u7684\u5e10\u6237\u5185\u6dfb\u52a0\u65e0\u7a77\u7684\u7528\u6237\u6863\u6848\u3002\u53ea\u6709\u8d26\u6237\u7ba1\u7406\u5458\u80fd\u6309\u7167\u8fd9\u4e9b\u6b65\u9aa4\u6765\u8bbe\u7f6e\u548c\u7ba1\u7406\u8d26\u6237\u3002\u5176\u4ed6\u7528\u6237\u9700\u8981\u7531\u8d26\u6237\u7ba1\u7406\u5458\u5c06\u4ed6\u4eec\u6dfb\u52a0\u5230\u7ec4\u7ec7\u8d26\u6237\u4e2d\u3002\u5982\u679c\u60a8\u5bf9\u8d26\u6237\u7ed3\u6784\u6709\u7591\u95ee\uff0c\u8bf7\u8054\u7cfb<a href=\"{{0}}\">gfwprosupport@wri.org</a>\u3002", "f03f5b1f3b168b63b7755b9b0e86b6e6": "\u68d5\u6988\u6cb9\u79cd\u690d\u56ed", "ab1ba834ccf22743847c3093bac29cd3": "\u70b9\u51fb\u201c\u6863\u6848\u201d\u6807\u7b7e\u3002\u4f5c\u4e3a\u7ba1\u7406\u5458\uff0c\u60a8\u4f1a\u5728\u7f51\u9875\u5e95\u90e8\u770b\u5230\u6240\u6709\u7528\u6237\u7684\u5217\u8868\uff0c\u5305\u62ec\u4ed6\u4eec\u7684\u8bbf\u95ee\u7ea7\u522b\u548c\u72b6\u6001\uff08\u5df2\u6fc0\u6d3b\u6216\u5f85\u5b9a\uff09\u3002", "52d1cad145598ab4fcfa9387e2e53208": "\u4f7f\u7528\u70b9\u6216\u591a\u8fb9\u5f62shapefile\u51e0\u4f55\u5f62\u72b6", "878530871f0db73f004f5bd6591eeb76": "\u8bb0\u4f4f\u6211", "f1373c9795c7ed7b8a6618b7ee5c8fbd": "\u60a8\u5df2\u7528<a href=\"{{0}}\" target=\"__BLANK\">GFW Pro</a>\u8d26\u6237\u767b\u5f55", "412be6f0ee8168e0beff3d25ac2f48e9": "\u4e0a\u4f20\u548c\u8f93\u5165\u5730\u70b9\u3002", "fb85966b84daa982fa3b185bc412569e": "\u70b9\u51fbKML\u6587\u4ef6\u4e2d\u7684\u67d0\u4e2a\u914d\u7f6e\uff0c\u5373\u53ef\u663e\u793a\u5b57\u6bb5\u548c\u5b83\u4eec\u76f8\u5e94\u7684\u503c\u3002KML/KMZ\u6587\u4ef6\u5148\u663e\u793a\u7ecf\u5ea6\uff0c\u518d\u663e\u793a\u7eac\u5ea6\u3002", "118f5a5ac0a499ca13da5b6e885b12fd": "\u4e0b\u4e00\u4e2a\u5c42\u6b21\u662f\u56fd\u5bb6\u89c6\u56fe\u3002\u4e00\u4e2a\u5706\u5708\u4ee3\u8868\u4e00\u4e2a\u56fd\u5bb6\u3002", "d214f704eba58df5f075df24184d0abd": "\u68d5\u6988\u5c0f\u519c\u519c\u573a", "a0065082a8b50b1918dbce5422e4f276": "\u521b\u5efa\u3001\u7f16\u8f91\u548c\u5220\u9664\u7531\u7ec4\u7ec7\u8d26\u6237\u4e2d\u7684\u6240\u6709\u7528\u6237\u521b\u5efa\u7684\u5217\u8868\u3002", "de7196f6b479096d021eee0f8d4bcf03": "\u5206\u6790\u81ea2000\u5e74\u4ee5\u6765\u6811\u6728\u8986\u76d6\u635f\u5931\u548c\u589e\u52a0\u7684\u5386\u53f2\u8d8b\u52bf", "8001ed7ebdd436c92764c392de4ce999": "<strong>\u5730\u4ea7</strong>\uff1a\u519c\u573a\u6216\u79cd\u690d\u56ed\u3002", "3e95899d59c690009113f57870b2e0ec": "\u70b9\u51fb\u201c\u6863\u6848\u201d\u6807\u7b7e\u3002\u4f5c\u4e3a\u7ba1\u7406\u5458\uff0c\u60a8\u5c06\u5728\u7f51\u9875\u5e95\u90e8\u770b\u5230\u6240\u6709\u7528\u6237\u7684\u5217\u8868\u3002\u82e5\u60f3\u505c\u7528\u67d0\u4e2a\u7528\u6237\uff0c\u8bf7\u70b9\u51fb\u8be5\u7528\u6237\u7684\u540d\u5b57\uff0c\u52a0\u8f7d\u5176\u6863\u6848\u3002\u6eda\u52a8\u5230\u6863\u6848\u7f51\u9875\u7684\u5e95\u90e8\uff0c\u70b9\u51fb\u201c\u505c\u7528\u201d\u3002\u8be5\u7528\u6237\u5c06\u4e0d\u518d\u80fd\u767b\u5f55\u5230Pro\u7248\u3002\u8be5\u7528\u6237\u4e0a\u4f20\u7684\u6240\u6709\u5217\u8868\u5bf9\u6240\u6709\u8d26\u6237\u7ba1\u7406\u5458\u4ecd\u7136\u53ef\u7528\u3002", "11de0f34115a3a1bb0bed2ec4f45b70b": "\u6a21\u677f\u5305\u62ec\u4e00\u7cfb\u5217\u7684\u5546\u54c1\u7c7b\u578b\uff0c\u5305\u62ec\u4ee5\u4e0b\u5185\u5bb9\u3002", "429ea5c0fa5643863637509abdf28904": "<strong>\u68d5\u6988\u5c0f\u519c\u519c\u573a</strong>\uff1a\u5efa\u8bae\u7528\u4e8e\u68d5\u6988\u6cb9\u5c0f\u519c\u519c\u573a\u3002", "e1762e33ed968eb718fc0c5f0576c502": "\u70b9\u51fb\u201c+\u6dfb\u52a0\u5730\u70b9\u201d\uff0c\u9009\u62e9\u201c\u6dfb\u52a0\u5355\u4e00\u5730\u70b9\u201d\u3002", "95fb21b9bbe04f22f3ff6f875a66c7a3": "\u786e\u4fdd\u6570\u636e\u4f4d\u4e8e\u9646\u5730\u4e0a\u3002", "2593d5ebccf0e15f50d9bded7b7a5ede": "\u70b9\u51fb\u7528\u6237\u540d\uff0c\u8fdb\u5165\u5176\u6863\u6848\uff0c\u7136\u540e\u70b9\u51fb\u201c\u505c\u7528\u201d\u3002", "14d4bcab557255fa0409f4d54fbd8f7e": "\u70b9\u51fb\u201c\u786e\u8ba4\u201d\u3002", "7da9d250dae0475780fc0488d42e929b": "<strong>\u725b\u7fa4\u901a\u7528</strong>\uff1a\u5efa\u8bae\u7528\u4e8e\u7267\u573a\u4ee5\u5916\u7684\u725b\u7fa4\u4f9b\u5e94\u94fe\u5730\u70b9\u3002", "2b39d17d067f31881497250e467f1445": "\u4e0b\u4e00\u4e2a\u5c42\u6b21\u662f\u5dde\u89c6\u56fe\u3002\u4e00\u4e2a\u5706\u5708\u4ee3\u8868\u4e00\u4e2a\u6b21\u5dde\u3002", "7a88c812da004370aeb4caca2b515e59": "<strong>\u5e74</strong>\uff1a\u663e\u793a\u8fc7\u53bb12\u4e2a\u6708\u7684\u8b66\u62a5\u3002\u5e74\u5ea6\u8b66\u62a5\u6bcf\u4e2a\u6708\u90fd\u4f1a\u66f4\u65b0\u3002", "3126e0bd00a1ef754ccb5f875383b692": "\u63a2\u7d22\u6c47\u603b\u4e86{location}\u5730\u533a\u68ee\u6797\u5173\u952e\u7edf\u8ba1\u6570\u636e\u7684\u4e92\u52a8\u56fe\u8868\u548c\u5730\u56fe\u3002\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u68ee\u6797\u53d8\u5316\u7387\u3001\u68ee\u6797\u8303\u56f4\u3001\u68ee\u6797\u780d\u4f10\u7684\u9a71\u52a8\u56e0\u7d20\uff0c\u4ee5\u53ca\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u8b66\u62a5\u2014\u2014\u53ef\u4ee5\u5b9a\u5236\u3001\u8f7b\u677e\u5206\u4eab\u548c\u4e0b\u8f7d\u79bb\u7ebf\u4f7f\u7528\u3002", "26c158927a4e2d3f10d966edd7bddc6c": "\u5b8c\u6210shapefile\u6a21\u677f\u3002\u60a8\u5fc5\u987b\u5728\u6a21\u677f\u6587\u4ef6\u4e2d\u6dfb\u52a0\u6240\u6709\u5fc5\u586b\u548c\u53ef\u9009\u7684\u5c5e\u6027\u5b57\u6bb5\u540d\u79f0\uff0c\u5373\u4fbf\u60a8\u4e0d\u5bf9\u8fd9\u4e9b\u5b57\u6bb5\u8fdb\u884c\u586b\u5145\u3002\u8bf7\u5728<a href=\"{{0}}\">\u6b64\u5904</a>\u6d4f\u89c8\u51c6\u5907\u548c\u4e0a\u4f20shapefile\u7684\u65b9\u6cd5\u3002", "154682ac4f39e840bec0e7e9b2a8f10e": "Shapefile\u5c06\u5bfc\u51fa\u60a8\u7684\u539f\u59cb\u8f93\u5165\u6587\u4ef6\u7684shapefile\u7248\u672c\uff0c\u53ef\u4ee5\u4e0a\u4f20\u5230Pro\u3002", "9defe6c2a2ff16407cd4739df689e5a1": "\u4ee5\u4e0b\u6b65\u9aa4\u5c06\u6307\u5bfc\u60a8\u5728Pro\u4e0a\u5206\u6790\u60a8\u6240\u5728\u5730\u7684\u68ee\u6797\u53d8\u5316\u548c\u5546\u54c1\u98ce\u9669\u3002", "8fc510b8cdc655c19699b0e038dbc4bb": "\u70b9\u51fb\u5730\u70b9\u9875\u9762\u4e0a\u201c\u6211\u7684\u5217\u8868\u201d\u4e2d\u7684\u4e00\u4e2a\u5217\u8868\u3002\u70b9\u51fb\u60a8\u60f3\u5220\u9664\u7684\u884c\u65c1\u8fb9\u7684\u590d\u9009\u6846\uff0c\u5373\u53ef\u9009\u5b9a\u60a8\u60f3\u5220\u9664\u7684\u884c\u3002", "712083c070484fd818d5194a998f9db7": "\u4f5c\u4e3a\u89c2\u770b\u8005\uff0c\u60a8\u53ef\u4ee5\u5728Pro\u7248\u4e0a\u8fdb\u884c\u4ee5\u4e0b\u64cd\u4f5c\u3002", "00212a4291fccf68a2aabe7f999146d1": "\u70b9\u51fb\u201c\u6863\u6848\u201d\u6807\u7b7e\u3002\u4f5c\u4e3a\u7ba1\u7406\u5458\uff0c\u60a8\u53ef\u4ee5\u70b9\u51fb\u201c\u6b21\u8981\u201d\u590d\u9009\u6846\u3002", "b5ca39077f3b34df657d01b0e4e66348": "\u4f7f\u7528\u5de5\u4f5c\u9762\u677f", "d06d34d00650a2a4f93262e83bd13c90": "\u82e5\u60f3\u7528\u60a8\u7684\u6570\u636e\u586b\u5165\u5c5e\u6027\u6570\u636e\uff0c\u60a8\u5fc5\u987b\u91cd\u542f\u7f16\u8f91\u5668\u3002\u82e5\u60f3\u7f16\u8f91\u8868\u683c\u4e2d\u7684\u67d0\u4e2a\u5355\u5143\u683c\uff0c\u53ea\u9700\u70b9\u51fb\u5b83\uff0c\u7136\u540e\u5f00\u59cb\u8f93\u5165\u3002\u5982\u679c\u60a8\u60f3\u4e00\u6b21\u6027\u7f16\u8f91\u6574\u4e2a\u5206\u680f\uff0c\u53ef\u4ee5\u4f7f\u7528\u5b57\u6bb5\u8ba1\u7b97\u5668\u3002", "30ba0d90f10124af03be0667fb2e3e85": "\u767b\u5f55Pro\u7248\u65f6\u9700\u7ecf\u8fc7\u4e24\u6b65\u9a8c\u8bc1\u3002\u6bcf\u5f53\u60a8\u8f93\u5165\u7528\u6237\u540d\u548c\u5bc6\u7801\u767b\u5f55Pro\u7248\u65f6\uff0c\u4f1a\u51fa\u73b0\u9a8c\u8bc1\u5c4f\u5e55\uff0c\u63d0\u793a\u60a8\u8f93\u5165\u4ee4\u724c\u4ee3\u7801\u3002", "abeb88521be7ed2c03ce8a48bd03ef88": "\u82e5\u60f3\u5728QGIS\u4e0a\u5c06Pro\u7248\u6a21\u677f\u7684shapefile\u4e0e\u611f\u5174\u8da3\u533a\u57df\u7684shapefile\u5408\u5e76\u4ee5\u6dfb\u52a0\u6240\u9700\u5b57\u6bb5\uff0c\u8bf7\u9075\u5faa\u4ee5\u4e0b\u6b65\u9aa4\u3002", "b0efdf2b7f53a85c2dbe644d70e9932b": "\u7f16\u8f91\u548c\u5220\u9664\u60a8\u521b\u5efa\u7684\u5730\u70b9\u3002", "f20e69549fc23f9df431f9511f177e5e": "\u7ba1\u7406\u8d26\u6237", "312961863e6751d4baddeff7cf1ef94b": "\u9009\u62e9\u4e00\u4e2a\u5217\u8868\uff0c\u70b9\u51fb\u201c\u66f4\u65b0\u201d\uff0c\u5373\u53ef\u91cd\u65b0\u5206\u6790\u51fa\u9519\u5217\u8868\u6216\u7528\u6700\u65b0\u6570\u636e\u66f4\u65b0\u5217\u8868\u3002", "a3ecfc68afd5ec9b91c43f160dc8a596": "\u70b9\u51fb\u5217\u8868\u65c1\u8fb9\u7684\u201c...\u201d\u83dc\u5355\uff0c\u7ba1\u7406\u8be5\u5217\u8868\u3002", "1644b63bd195d9e98956de25a789de3f": "\u82e5\u60f3\u5728\u67d0\u4e2a\u7279\u5b9a\u7684\u5217\u8868\u5185\u8fdb\u884c\u641c\u7d22\uff0c\u8bf7\u9009\u62e9\u60a8\u60f3\u641c\u7d22\u7684\u5217\u8868\u3002", "f1d623d4f9d20f343ba4a3f4270514a7": "\u82e5\u60f3\u8c03\u6574\u6240\u9009\u8b66\u62a5\u7684\u65f6\u95f4\u8303\u56f4\uff0c\u8bf7\u5728\u7f51\u9875\u53f3\u4e0a\u65b9\u9009\u62e9\u60a8\u60f3\u8981\u7684\u65f6\u95f4\u8303\u56f4\u3002", "95be71b854dc88b80d8026c8eeca5f79": "\u70b9\u51fb\u201c+\u6dfb\u52a0\u5730\u70b9\u201d\uff0c\u9009\u62e9\u201c\u6dfb\u52a0\u591a\u4e2a\u5730\u70b9\u201d\u3002", "64e4b535ec1f542725e47318c8cb069d": "\u5728\u5730\u70b9\u9875\u9762\u4e0a\uff0c\u70b9\u51fb\u201c+\u6dfb\u52a0\u5730\u70b9\u201d\uff0c\u9009\u62e9\u201c\u6dfb\u52a0\u591a\u4e2a\u5730\u70b9\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u7ee7\u7eed\u201d\u3002", "b9217a9f39011e6c7ab473409aeb1279": "\u4f7f\u7528\u201c\u4fee\u590d\u51e0\u4f55\u56fe\u5f62\u201d\u5de5\u5177\uff0c\u521b\u5efa\u56fa\u5b9a\u7684\u6570\u636e\u526f\u672c\u3002\u518d\u6b21\u4f7f\u7528\u201c\u68c0\u67e5\u6709\u6548\u6027\u201d\u5de5\u5177\uff0c\u4ed4\u7ec6\u68c0\u67e5\u662f\u5426\u6240\u6709\u9519\u8bef\u90fd\u5df2\u88ab\u7ea0\u6b63\uff0c\u5e76\u4e14\u5bf9\u9519\u8bef\u8fdb\u884c\u5ba1\u9605\uff0c\u770b\u591a\u8fb9\u5f62\u662f\u5426\u5df2\u4e25\u91cd\u626d\u66f2\u3002", "339ab1bd53ff6da61aa0e5435338674f": "\u5728GFW Pro\u5de5\u4f5c\u9762\u677f\u4e0a\uff0c\u60a8\u53ef\u4ee5\u89c4\u5b9a\u533a\u57df\u7684\u4f18\u5148\u6b21\u5e8f\uff0c\u5feb\u901f\u8bc6\u522b\u95ee\u9898\u533a\u57df\uff0c\u5e76\u4e14\u76f4\u89c2\u5730\u770b\u5230\u4e0e\u60a8\u7684\u6570\u636e\u76f8\u5bf9\u5e94\u7684\u8b66\u62a5\u3002\u8bf7\u9075\u5faa\u4ee5\u4e0b\u6b65\u9aa4\uff0c\u4e86\u89e3\u5982\u4f55\u8bbf\u95ee\u5de5\u4f5c\u9762\u677f\uff0c\u5982\u4f55\u9009\u62e9\u5728\u5de5\u4f5c\u9762\u677f\u4e0a\u663e\u793a\u7684\u8b66\u62a5\u7c7b\u578b\uff0c\u5982\u4f55\u8bc6\u522b\u8fd9\u4e9b\u8b66\u62a5\u53d1\u751f\u7684\u4f4d\u7f6e\uff0c\u5e76\u7740\u624b\u5bf9\u8fd9\u4e9b\u8b66\u62a5\u8fdb\u884c\u8c03\u67e5\u3002", "85d70078c8daa599400ad9a6c05367e7": "\u70b9\u51fb\u5730\u70b9\u9875\u9762\u4e0a\u7684\u201c\u6211\u7684\u5217\u8868\u201d\u4e2d\u7684\u5217\u8868\u3002\u70b9\u51fb\u60a8\u60f3\u590d\u5236\u7684\u884c\u65c1\u8fb9\u7684\u590d\u9009\u6846\uff0c\u5373\u53ef\u9009\u5b9a\u60a8\u60f3\u590d\u5236\u7684\u884c\u3002", "60fe67d97e182c6c496f824606497fc4": "\u82e5\u60f3\u5728QGIS\u4e0a\u68c0\u67e5shapefile\u7684\u51e0\u4f55\u5f62\u72b6\uff0c\u8bf7\u9075\u5faa\u4ee5\u4e0b\u6b65\u9aa4\u3002", "209d4d150bd827c674eed62bddc606b1": "\u82e5\u60f3\u4fee\u590dQGIS\u4e0a\u7684\u51e0\u4f55\u56fe\u5f62\u9519\u8bef\uff0c\u8bf7\u91c7\u53d6\u4ee5\u4e0b\u4e09\u4e2a\u6b65\u9aa4\u3002", "3a0abe9d9ee1958ae13c3042b9425a90": "\u82e5\u60f3\u5728\u5730\u56fe\u4e0a\u6dfb\u52a0\u6570\u636e\u5c42\uff0c\u8bf7\u5c06\u9f20\u6807\u60ac\u505c\u5728\u67d0\u4e00\u7c7b\u522b\u4e0a\uff0c\u7136\u540e\u70b9\u51fb\u8be5\u6570\u636e\u5c42\u5de6\u4fa7\u7684\u56fe\u6807\u6765\u6fc0\u6d3b\u60a8\u60f3\u67e5\u770b\u7684\u6570\u636e\u5c42\u3002\u540c\u6837\u7684\u65b9\u6cd5\u4e5f\u53ef\u4ee5\u7528\u6765\u5220\u9664\u6570\u636e\u5c42\uff0c\u6216\u8005\u70b9\u51fb\u56fe\u4f8b\u4e0a\u6570\u636e\u5c42\u65c1\u8fb9\u7684\u5220\u9664\u5c42\u201cx\u201d\u56fe\u6807\u3002\u60a8\u53ef\u4ee5\u5c06 \u201c\u68ee\u6797\u53d8\u5316\u201d\u7c7b\u522b\u4e2d\u7684\u6570\u636e\uff08\u5305\u62ec\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u635f\u5931\u3001\u6bc1\u6797\u8b66\u62a5\u548c\u706b\u707e\u8b66\u62a5\uff09\u4e0e\u5176\u4ed6\u7c7b\u522b\u4e2d\u7684\u80cc\u666f\u5c42\u2014\u2014\u5982\u201c\u571f\u5730\u8986\u76d6\u201d\u6216\u201c\u571f\u5730\u5229\u7528\u201d\u2014\u2014\u7ed3\u5408\u8d77\u6765\uff0c\u8bc6\u522b\u68ee\u6797\u53d8\u5316\u7684\u6f5c\u5728\u539f\u56e0\u548c\u5f71\u54cd\u3002", "ee31116cefeb6d7ff6b68903d19b3157": "\u82e5\u60f3\u586b\u5199\u5c5e\u6027\u8868\uff0c\u8bf7\u6253\u5f00\u7f16\u8f91\u5668\u3002\u5982\u679c\u60a8\u60f3\u586b\u5199\u8868\u4e2d\u7684\u67d0\u4e2a\u5355\u5143\u683c\uff0c\u53ef\u4ee5\u70b9\u51fb\u5b83\uff0c\u7136\u540e\u5f00\u59cb\u8f93\u5165\u3002\u60a8\u53ef\u4ee5\u7528\u5b57\u6bb5\u8ba1\u7b97\u5668\u4e3a\u4e00\u6574\u5217\u6dfb\u52a0\u6570\u503c\u3002\u70b9\u51fb\u4f4d\u4e8e\u5c5e\u6027\u8868\u7a97\u53e3\u9876\u90e8\u3001\u5f62\u4f3c\u7b97\u76d8\u7684\u6309\u94ae\uff0c\u5373\u53ef\u6253\u5f00\u5b57\u6bb5\u8ba1\u7b97\u5668\u3002", "2ba0fa973f78365b54b571998411517b": "\u4ece\u4e0b\u62c9\u83dc\u5355\u4e2d\u9009\u62e9\u201c\u5546\u54c1\u98ce\u9669\u201d\uff0c\u5373\u53ef\u52a0\u8f7d\u5546\u54c1\u98ce\u9669\u5217\u8868\u89c6\u56fe\u3002", "0f1641e956813d782f11c6c24b53886d": "\u8c03\u6574\u5730\u56fe\u548c\u6570\u636e\u8bbe\u7f6e", "c6393755b6203f896be3991e665aa2e1": "\u641c\u7d22\u67d0\u4e2a\u56fd\u5bb6\u6216\u5730\u533a\u7684\u7279\u5b9a\u6570\u636e\u3002", "86e68661c4dfe99798dada6953dda4b6": "\u70b9\u51fb\u201c\u66f4\u65b0\u201d\u56fe\u6807\uff0c\u786e\u8ba4\u5217\u8868\u66f4\u65b0\u3002", "11f4b4ba23dc72ee5e86ff5a90bdde60": "\u8d26\u6237\u767b\u5f55", "fafe5ae24aff6b4d620c84edf624e49e": "\u60a8\u53ef\u4ee5\u5728Pro\u7248\u4e0a\u67e5\u770b\u68d5\u6988\u6cb9\u5382\u7684\u68ee\u6797\u780d\u4f10\u98ce\u9669\u3002\u5546\u54c1\u98ce\u9669\u5206\u6790\u53ef\u7528\u4e8e\u68d5\u6988\u6cb9\u5382\u548c\u68d5\u6988\u6cb9\u901a\u7528\u5546\u54c1\u6a21\u677f\u3002\u9996\u5148\uff0c\u60a8\u9700\u8981\u5411Pro\u4e0a\u4f20\u68d5\u6988\u6cb9\u5382\u6216\u68d5\u6988\u6cb9\u901a\u7528\u5217\u8868\u2014\u2014\u5728<a href=\"{{0}}\">\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u4e0a\u4f20\u5730\u70b9\uff0c\u5728<a href=\"{{1}}\">\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u9009\u62e9\u6b63\u786e\u7684\u6a21\u677f\uff0c\u5728<a href=\"{{2}}\">\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u5b8c\u6210\u60a8\u6240\u9009\u7684\u6a21\u677f\u3002", "e42e8260f649c839777bd1f564c28c04": "\u70b9\u51fb\u201c\u5730\u70b9\u201d\u6807\u7b7e\uff0c\u7136\u540e\u70b9\u51fb\u201c\u5730\u70b9\u6a21\u677f\u201d\u4e0b\u7684\u7c7b\u578b\u4e0b\u62c9\u83dc\u5355\u3002\u9009\u62e9\u5e76\u4e0b\u8f7d\u7b26\u5408\u60a8\u7684\u6570\u636e\u7684Excel\u5730\u70b9\u6a21\u677f\u3002\u5728<a href=\"{{0}}\">\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u9009\u62e9\u6b63\u786e\u7684\u6a21\u677f\u3002", "1895208276ecc4c012e166de52db3896": "\u53ef\u53ef\u519c\u573a", "0c7fcdc56afd95d7337047591d8a4fac": "\u7f16\u8f91\u548c\u89c2\u770b\u8005\u53ef\u4ee5\u70b9\u51fb\u201c\u6863\u6848\u201d\u9875\u9762\u5e95\u90e8\u7684\u201c\u66f4\u6539\u5bc6\u7801\u201d\u56fe\u6807\uff0c\u6309\u7167\u5c4f\u5e55\u4e0a\u7684\u6307\u793a\u66f4\u6539\u5bc6\u7801\u3002", "2c92fdd1e54a9fd2859366499ca1d7dd": "\u67e5\u770b\u7ec4\u7ec7\u8d26\u6237\u7684\u6240\u6709\u6d3b\u52a8\u3002", "dcbe0718110e523d7960ccad75119909": "\u5728\u5b57\u6bb5\u8ba1\u7b97\u5668\u7a97\u53e3\uff0c\u9009\u4e2d\u201c\u66f4\u65b0\u73b0\u6709\u5b57\u6bb5\u201d\uff0c\u5e76\u5728\u4e0b\u62c9\u83dc\u5355\u4e2d\u9009\u62e9\u60a8\u60f3\u7f16\u8f91\u7684\u5b57\u6bb5\u3002\u60a8\u60f3\u6dfb\u52a0\u5230\u5b57\u6bb5\u4e2d\u7684\u503c\u5c06\u88ab\u8f93\u5165\u5230\u201c\u8868\u8fbe\u5f0f\u201d\u6807\u7b7e\u4e0b\u9762\u7684\u65b9\u6846\u4e2d\u3002\u60a8\u5c06\u6709\u4e09\u4e2a\u8f93\u5165\u6570\u503c\u7684\u9009\u9879\u3002", "2a7c39e952d6c03da9efb24118f52b64": "\u5982\u679c\u60a8\u7684\u6570\u636e\u4e2d\u7684\u67d0\u4e2a\u914d\u7f6e\u4e0eGADM\u6570\u636e\u4e2d\u6240\u6709\u7684\u56fd\u5bb6\u90fd\u4e0d\u91cd\u53e0\uff0c\u60a8\u9700\u8981\u5220\u9664\u5b83\u6216\u7f16\u8f91\u5176\u5730\u70b9\u3002\u5173\u4e8eArcGIS\u7f16\u8f91\u5de5\u5177\u7684\u5176\u4ed6\u4fe1\u606f\u53ef\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8fd9\u91cc</a>\u627e\u5230\u3002", "e399621b61826365a3b7491fd029515f": "\u201c\u6240\u6709\u5730\u70b9\u7684\u767e\u5206\u6bd4\u201d\u663e\u793a\u60a8\u7684\u5217\u8868\u4e2d\u53d1\u751f\u8fc7\u9009\u5b9a\u7c7b\u578b\u8b66\u62a5\u7684\u5730\u70b9\u603b\u6570\u7684\u767e\u5206\u6bd4\u3002", "e6e19f0ebd00ab9dca09a03993f6b446": "\u5927\u8c46\u4ed3", "5237fa5aff60fc9df7aec3dfa9fdfb71": "\u5728Google Earth\u4e0a\u6253\u5f00KML/KMZ\u6587\u4ef6", "30efad5026ea8d2fc6b77fe47d19ede1": "\u67e5\u770b\u5728\u60a8\u5217\u8868\u4e2d\u7684\u5730\u70b9\u53d1\u751f\u7684\u8b66\u62a5\u7684\u6c47\u603b\u3002", "135bfe47f866bd081b096e8ddba92f83": "\u7f16\u8f91\u7279\u5b9a\u7684\u8d26\u6237\u5b57\u6bb5\u548c\u7528\u6237\u5b57\u6bb5\u3002", "26848811736fa1a20dbd1d7db2819182": "GFW Pro\u7684\u7528\u6237\u7c7b\u578b\u2014\u2014\u7ba1\u7406\u5458\u3001\u7f16\u8f91\u548c\u89c2\u770b\u8005\u2014\u2014\u5728Pro\u7248\u4e2d\u62e5\u6709\u4e0d\u540c\u7684\u6743\u9650\u7ea7\u522b\u3002\u8fd9\u4e09\u79cd\u7528\u6237\u7c7b\u578b\u7684\u6743\u9650\u7ea7\u522b\u6982\u8ff0\u5982\u4e0b\u3002", "23ac662a8e02a6685b1815a8ceec1c50": "\u68c0\u67e5\u786e\u8ba4\u6295\u5f71\u8bbe\u7f6e\u4e3aWGS 84\u3002\u5982\u679c\u6295\u5f71\u672a\u4f7f\u7528WGS 84\uff0c\u53ef\u4ee5\u5728QGIS\u7684\u201c\u5904\u7406\u5de5\u5177\u7bb1\u201d\u4e2d\u7684\u201c\u77e2\u91cf\u901a\u7528\u201d\u6807\u7b7e\u4e0b\u627e\u5230\u201c\u91cd\u65b0\u6295\u5f71\u5c42\u201d\u5de5\u5177\u3002\u5728ArcGIS\u4e0a\uff0c\u201c\u6295\u5f71\u201d\u5de5\u5177\u53ef\u4ee5\u5728\u201c\u6570\u636e\u7ba1\u7406\u5de5\u5177\u7bb1\u201d\u7684\u201c\u6295\u5f71\u548c\u8f6c\u6362\u201d\u4e0b\u627e\u5230\u3002", "1891675758f84102de4288871a152149": "<strong>\u5220\u9664</strong>: \u4ecePro\u8d26\u6237\u4e2d\u6c38\u4e45\u5220\u9664\u51fa\u9519\u548c\u5df2\u6fc0\u6d3b\u7684\u5217\u8868\u3002", "e482329cbb1e5c13f12bd229b196d785": "<strong>\u661f\u671f</strong>\uff1a\u663e\u793a\u8fc7\u53bb\u4e00\u661f\u671f\u7684\u8b66\u62a5\u3002\u661f\u671f\u8b66\u62a5\u6bcf\u5929\u90fd\u4f1a\u66f4\u65b0\u3002", "3b472b73772a7280eb10b48ad5eda25a": "<strong>\u5b89\u5168</strong>\uff1aPro\u7248\u8d26\u6237\u91c7\u7528\u4e00\u6d41\u7684\u5b89\u5168\u534f\u8bae\uff0c\u5305\u62ec\u4e25\u683c\u7684\u5bc6\u7801\u8981\u6c42\u548c\u4e24\u6b65\u9a8c\u8bc1\u767b\u5f55\u3002Pro\u7248\u5728\u56db\u5c0f\u65f6\u65e0\u6d3b\u52a8\u540e\u8d85\u65f6\u3002\u60a8\u5c06\u767b\u51fa\u6863\u6848\uff0c\u5fc5\u987b\u91cd\u65b0\u767b\u5f55\u3002", "48f536a560a5855dfb1eae0ad55f1792": "\u8f93\u5165\u60a8\u7684\u8d26\u6237\u4fe1\u606f\uff0c\u63a5\u53d7\u670d\u52a1\u6761\u6b3e\u548c\u9690\u79c1\u653f\u7b56\u3002\u60a8\u5fc5\u987b\u4ee3\u8868\u67d0\u4e2a\u7ec4\u7ec7\uff0c\u5e76\u7528\u8be5\u7ec4\u7ec7\u7684\u90ae\u7bb1\u5730\u5740\u8fdb\u884c\u7533\u8bf7\u3002Gmail\u548cYahoo\u7b49\u79c1\u4eba\u90ae\u7bb1\u57df\u540d\u5c06\u4e0d\u88ab\u63a5\u53d7\u3002", "6f860c57a8358aa7caf6b75967ad3a58": "\u5927\u8c46\u901a\u7528", "786e037dec933eaa0485b97eb2320a9d": "\u70b9\u51fb\u201c\u4e0b\u8f7d\u201d\uff0c\u9009\u62e9\u60a8\u60f3\u8981\u7684\u683c\u5f0f\u3002", "8ae7ff4f24c3ea4e176da0d2b22b6a4b": "\u82e5\u60f3\u9009\u62e9\u5bfc\u51fa\u7684\u884c\uff0c\u8bf7\u70b9\u51fb\u60f3\u5bfc\u51fa\u7684\u884c\u65c1\u8fb9\u7684\u590d\u9009\u6846\u3002\u5982\u679c\u60a8\u60f3\u5bfc\u51fa\u6240\u6709\u5730\u70b9\uff0c\u70b9\u51fb\u8868\u683c\u5de6\u4e0a\u65b9\u201c\u5730\u70b9\u540d\u79f0\u201d\u65c1\u8fb9\u7684\u590d\u9009\u6846\u3002", "c062a7d5b587062f32abcdbccc55b2e5": "\u6570\u636e\u548c\u7814\u7a76\u7c7b\u522b\u4e0b\u7684{totalPosts}\u6587\u7ae0", "067a77c7ab2b59c3becad1eea6af6fb3": "\u5728ArcMap\u7f51\u9875\u7684\u9876\u90e8\u83dc\u5355\u4e0a\u70b9\u51fb\u201c\u5730\u7406\u5904\u7406\u201d\uff0c\u7136\u540e\u9009\u62e9\u201c\u5408\u5e76\u201d\u3002\u9009\u62e9\u60a8\u7684\u6570\u636e\u548c\u6a21\u677fshapefile\u4f5c\u4e3a\u8f93\u5165\u91cf\uff0c\u7136\u540e\u8fd0\u884c\u8be5\u5de5\u5177\u3002", "841eb92036cc44cf2287044da29af998": "\u5982\u679c\u60a8\u5728\u8be5\u8fc7\u7a0b\u4e2d\u4e0d\u5c0f\u5fc3\u5220\u9664\u4e86\u4e00\u4e2a\u5b57\u6bb5\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u5c5e\u6027\u8868\u5de6\u4e0a\u65b9\u7684\u8868\u9009\u9879\u56fe\u6807\uff0c\u9009\u62e9\u201c\u6dfb\u52a0\u5b57\u6bb5\u201d\u6765\u6dfb\u52a0\u5b57\u6bb5\u3002\u6dfb\u52a0\u65b0\u5b57\u6bb5\u65f6\uff0c\u60a8\u4f1a\u88ab\u63d0\u793a\u8f93\u5165\u5b57\u6bb5\u540d\u548c\u6570\u636e\u7c7b\u578b\u3002\u5b57\u6bb5\u540d\u662f\u6a21\u677f\u4e2d\u5b57\u6bb5\u7684\u524d10\u4e2a\u5b57\u7b26\uff0c\u6240\u6709\u7a7a\u683c\u4f1a\u88ab\u4e0b\u5212\u7ebf\u66ff\u4ee3\u3002\u5982\u679c\u60a8\u60f3\u521b\u5efa\u4e00\u4e2a\u5305\u542b\u6587\u672c\u7684\u5b57\u6bb5\uff0c\u8bf7\u9009\u62e9\u201c\u5b57\u7b26\u4e32\u201d\u4f5c\u4e3a\u6570\u636e\u7c7b\u578b\uff0c\u6570\u5b57\u503c\u8bf7\u9009\u62e9\u201c\u53cc\u500d\u201d\u3002", "b244b8bf1e0b6853e6094c922154063c": "\u67e5\u770b\u548c\u4e0b\u8f7d\u60a8\u7684\u7ec4\u7ec7\u8d26\u6237\u4e2d\u6240\u6709\u7528\u6237\u7684\u6d3b\u52a8\u65e5\u5fd7\u3002", "5b72c99d0b1cd2fa2062b190a05fd333": "\u8bf7\u52ff\u4eceExcel\u6a21\u677f\u4e2d\u5220\u9664\u5206\u680f\u3002\u5982\u679c\u60a8\u4e0d\u9700\u8981\u67d0\u4e00\u680f\uff0c\u8bf7\u5c06\u5b83\u7559\u7a7a\u3002", "312b37c8bd3c4b8490889991ebc97447": "\u63a2\u7d22\u6c47\u603b\u4e86\u5168\u7403\u68ee\u6797\u8303\u56f4\u7684\u4e92\u52a8\u56fe\u8868\u548c\u5730\u56fe\u3002\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u68ee\u6797\u6570\u91cf\u6700\u591a\u7684\u56fd\u5bb6\u7684\u6392\u540d\u2014\u2014\u53ef\u4ee5\u5b9a\u5236\uff0c\u6613\u4e8e\u5206\u4eab\u548c\u4e0b\u8f7d\u79bb\u7ebf\u4f7f\u7528\u3002", "3d334354021ca3a1b0c82dd395c0ef21": "\u63a2\u7d22\u6c47\u603b\u4e86\u68ee\u6797\u5728{adm1}\uff0c{location}\u6c14\u5019\u53d8\u5316\u4e2d\u7684\u4f5c\u7528\u7684\u4e92\u52a8\u56fe\u8868\u548c\u5730\u56fe\u3002\u68ee\u6797\u78b3\u7edf\u8ba1\u2014\u2014\u5305\u62ec\u68ee\u6797\u5982\u4f55\u50a8\u5b58\u3001\u6392\u653e\u548c\u5c01\u5b58\uff08\u6e05\u9664\uff09\u78b3\u2014\u2014\u53ef\u4ee5\u5b9a\u5236\uff0c\u6613\u4e8e\u5206\u4eab\u548c\u4e0b\u8f7d\u79bb\u7ebf\u4f7f\u7528\u3002", "fff9afc3cf357640be91e201d75f444a": "\u68d5\u6988\u6cb9\u901a\u7528", "39688df82de9554a523271d0d8c58426": "<strong>\u68d5\u6988\u6cb9\u5382</strong>\uff1a\u53ea\u5efa\u8bae\u7528\u4e8e\u901a\u7528\u5de5\u5382\u5217\u8868\uff08UML\uff09\u4e2d\u7684\u68d5\u6988\u6cb9\u5382\uff0c\u56e0\u4e3a\u8be5\u6a21\u677f\u8981\u6c42\u6bcf\u4e2a\u5de5\u5382\u90fd\u6709UML ID\u3002", "a20cc74639855aae26370ab26008a2ca": "\u5728\u5730\u56fe\u4e0a\u52a0\u8f7d\u5e76\u8c03\u67e5\u9009\u5b9a\u7c7b\u578b\u7684\u8b66\u62a5\u3002", "222d704c0f5b488e7882ac44aeb1a433": "\u70b9\u51fb\u201c\u786e\u5b9a\u201d\uff0c\u786e\u8ba4\u60a8\u8981\u5206\u4eab\u8be5\u5217\u8868\u3002\u4e00\u65e6\u786e\u8ba4\uff0c\u4e0e\u60a8\u5171\u4eab\u5217\u8868\u7684\u7528\u6237\u5c06\u51fa\u73b0\u5728\u5171\u4eab\u7528\u6237\u5217\u8868\u4e2d\uff0c\u8fd8\u4f1a\u51fa\u73b0\u4e00\u4e2a\u8868\u660e\u5217\u8868\u5171\u4eab\u4f55\u65f6\u53d1\u751f\u7684\u65f6\u95f4\u6233\u3002", "8ace5e365b9b0a164b2d86f9794e01db": "\u6dfb\u52a0\u548c\u7ba1\u7406\u6765\u81ea\u60a8\u7ec4\u7ec7\u7684\u7528\u6237", "a5f61298da21626d0f490ebd06ecd811": "\u6ca1\u6709\u8d26\u6237\uff1f", "3ef335143ba55c5975b54ac542a704b1": "\u70b9\u51fb\u9876\u90e8\u83dc\u5355\u4e0a\u7684\u201c\u5730\u70b9\u201d\u6807\u7b7e\u3002\u5411\u4e0b\u6eda\u52a8\u5230\u201c\u6211\u7684\u5217\u8868\u201d\uff0c\u9009\u62e9\u60a8\u60f3\u5bfc\u51fa\u7684\u5217\u8868\u3002", "f58a17c93ee804855708a38e7a8bf0fd": "\u7528\u4ee5\u4e0b\u65b9\u6cd5\u4e4b\u4e00\u8f93\u5165\u5730\u70b9\u4fe1\u606f\u3002", "d2a00e581f70ab3a437d6a49656e6274": "\u521b\u5efa\u5217\u8868\u3002", "bc8b3c683de91aa7f2250b1e20aca5a7": "\u300a\u5982\u4f55\u5728GFW Pro\u4e0a\u4f7f\u7528PALM\u98ce\u9669\u5de5\u5177\u300b\u89c6\u9891\u6307\u5357\u4e8e2020\u5e747\u6708\u5236\u4f5c\uff0c\u7528\u4e8e\u5c55\u793aPALM\u98ce\u9669\u5de5\u5177\u7684\u76ee\u7684\u548c\u65b9\u6cd5\uff0c\u4ee5\u53ca\u5982\u4f55\u7528\u8be5\u5de5\u5177\u6765\u4f18\u5148\u5904\u7406\u68d5\u6988\u6cb9\u4f9b\u5e94\u94fe\u7684\u60c5\u51b5\u3002\u8be5\u89c6\u9891\u6709\u82f1\u8bed\u3001\u897f\u73ed\u7259\u8bed\u548c\u5370\u5c3c\u8bed\u7248\u672c\u3002", "0efaa0232a7d5de8814263cd357633e5": "\u7f16\u8f91\u6743\u9650\u7ea7\u522b", "1d61f64241a094035e786ce2727f4506": "\u5982\u679c\u60a8\u7684\u7ec4\u7ec7\u6709\u5174\u8da3\u5229\u7528GFW Pro\u6765\u964d\u4f4e\u68ee\u6797\u780d\u4f10\u7684\u98ce\u9669\uff0c\u8bf7\u5148\u63d0\u4ea4<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8d26\u6237\u7533\u8bf7\u8868</a>\u3002", "7981af289c9d7924b98d951504984949": "\u5f53\u60a8\u6536\u5230\u4e00\u4e2a\u5171\u4eab\u5217\u8868\u65f6\uff0c\u5730\u70b9\u9875\u9762\u4e0a\u7684\u5217\u8868\u540d\u79f0\u65c1\u4f1a\u51fa\u73b0\u4e00\u4e2a\u5171\u4eab\u56fe\u6807\u3002\u5217\u8868\u63a5\u6536\u8005\u53ef\u4ee5\u770b\u5230\u5b8c\u6574\u7684\u5730\u70b9\u4fe1\u606f\uff0c\u4f46\u4e0d\u80fd\u66f4\u65b0\u3001\u7f16\u8f91\u6216\u5728\u5185\u90e8\u91cd\u65b0\u5171\u4eab\u5217\u8868\u3002\u4e0d\u8fc7\uff0c\u63a5\u6536\u8005\u53ef\u4ee5\u4e0b\u8f7d\u5217\u8868\u7ed3\u679c\uff0c\u5bfc\u51faCSV\u6216Shapefile\u5217\u8868\u6a21\u677f\u3002", "b91d916c2135f1af69c610c9574d6a73": "\u82e5\u60f3\u7ba1\u7406\u5730\u70b9\u548c\u5217\u8868\uff0c\u8bf7\u70b9\u51fb\u9876\u90e8\u83dc\u5355\u4e2d\u7684\u201c\u5730\u70b9\u201d\u6807\u7b7e\u3002\u201c\u5730\u70b9\u201d\u89c6\u56fe\u663e\u793aGFW\u7ba1\u7406\u7684\u5730\u70b9\u5217\u8868\u548c\u60a8\u4e0a\u4f20\u7684\u6240\u6709\u5217\u8868\u3002\u5728\u5de6\u4fa7\uff0c\u60a8\u53ef\u4ee5\u4e0a\u4f20\u65b0\u5730\u70b9\u5e76\u521b\u5efa\u5217\u8868\u3002\u5982\u679c\u60a8\u8ba1\u5212\u6dfb\u52a0\u3001\u5220\u9664\u6216\u79fb\u52a8\u4e00\u4e2a\u6216\u591a\u4e2a\u5730\u70b9\uff0c\u8bf7\u4fdd\u5b58\u4e00\u4efd\u539f\u59cb\u5217\u8868\u7684\u526f\u672c\u4f5c\u4e3a\u5907\u4efd\u3002", "b9082d074a310144a899b23986505bb1": "GFW Pro\u7528\u6237\u6559\u7a0b\u6700\u8fd1\u4e00\u6b21\u66f4\u65b0\u57282020\u5e749\u6708\uff0c\u6f14\u793a\u4e86\u5982\u4f55\u7528GFW Pro\u8fdb\u884c\u4f9b\u5e94\u94fe\u76d1\u6d4b\u3002\u6559\u7a0b\u4ecb\u7ecd\u4e86\u5982\u4f55\u521b\u5efa\u548c\u7ba1\u7406\u8d26\u6237\uff1b\u4e0a\u4f20\u3001\u7ba1\u7406\u3001\u5206\u6790\u548c\u5206\u4eab\u5730\u70b9\u548c\u5217\u8868\uff1b\u4f7f\u7528\u5de5\u4f5c\u9762\u677f\uff1b\u4f7f\u7528\u5730\u56fe\uff1b\u4ee5\u53ca\u5982\u4f55\u51c6\u5907\u548c\u4e0a\u4f20shapefile\u6587\u4ef6\u3002\u8be5\u6559\u7a0b\u6709\u82f1\u6587\u7248\u3002", "f1a66666bbae0c38965cbab340d72ac4": "\u53ea\u6709GFW Pro\u7528\u6237\u53ef\u4ee5\u8bbf\u95eeGFW Pro\u8d44\u6599\u3002\u7528GFW Pro\u8d26\u6237\u51ed\u8bc1\u767b\u5f55\uff0c\u5373\u53ef\u67e5\u770bGFW Pro\u6559\u7a0b\u8d44\u6e90\uff0c\u5982\u5206\u6b65\u8bf4\u660e\u3001\u89c6\u9891\u7b49\u3002", "7cf3e87178aefaa852c32041b817f6d1": "\u9009\u62e9\u6a21\u677f\u65f6\uff0c\u60a8\u9996\u5148\u8981\u9009\u62e9\u60a8\u5904\u7406\u7684\u5bf9\u8c61\u662f\u6295\u8d44\u8fd8\u662f\u5546\u54c1\u3002", "80c9be8aed4d9981e795476866b45a21": "<strong>\u6570\u5b57\u7b26\u53f7</strong>\uff1aPro\u4f1a\u81ea\u52a8\u5c06\u60a8\u7684\u6570\u636e\u7684\u6570\u5b57\u7b26\u53f7\u683c\u5f0f\u4e0e\u60a8\u7684\u6d4f\u89c8\u5668\u8bed\u8a00\u76f8\u5339\u914d\u3002\u8bf7\u6ce8\u610f\uff0c\u60a8\u7684\u7535\u8111\u64cd\u4f5c\u7cfb\u7edf\u5fc5\u987b\u8bbe\u7f6e\u4e3a\u4e0e\u6d4f\u89c8\u5668\u8bed\u8a00\u76f8\u540c\u7684\u8bed\u8a00\u3002", "56cf63aaa9f07c6e5cd24703cae9748f": "<strong>\u5546\u54c1</strong>\uff1a\u9009\u62e9\u201c\u5546\u54c1\u201d\u5373\u53ef\u83b7\u53d6\u60a8\u6240\u9009\u5546\u54c1\u7684\u5177\u4f53\u63cf\u8ff0\u6027\u6570\u636e\u3002\u67d0\u4e9b\u5206\u6790\u4ec5\u9002\u7528\u4e8e\u7279\u5b9a\u5546\u54c1\u3002Pro\u5c06\u6839\u636e\u60a8\u4e0a\u4f20\u7684\u6a21\u677f\u6765\u8bc6\u522b\u5546\u54c1\u3002", "183a20cf4ca6974922a60ba383d7ad81": "GFW Pro\u662f\u4e00\u6b3e\u5728\u7ebf\u7ba1\u7406\u5e94\u7528\u7a0b\u5e8f\uff0c\u65e8\u5728\u5e2e\u52a9\u516c\u53f8\u5229\u7528\u5730\u7406\u7a7a\u95f4\u4f9b\u5e94\u94fe\u6570\u636e\uff0c\u7ba1\u7406\u8fdb\u5c55\uff0c\u4ece\u800c\u5b9e\u73b0\u68ee\u6797\u780d\u4f10\u65b9\u9762\u7684\u627f\u8bfa\u3002\u8be5\u7cfb\u7edf\u63d0\u4f9b\u5730\u4ea7\u3001\u4f9b\u5e94\u68da\u548c\u7ec4\u5408\u5c42\u9762\u7684\u5206\u6790\u548c\u5de5\u4f5c\u9762\u677f\uff0c\u5e76\u901a\u8fc7\u4e00\u6d41\u7684\u5b89\u5168\u534f\u8bae\uff0c\u786e\u4fdd\u7cfb\u7edf\u548c\u7528\u6237\u6570\u636e\u5404\u65b9\u9762\u7684\u5b8c\u6574\u6027\u548c\u5b89\u5168\u6027\u3002", "d445dc146e6174f1161c370201d2f794": "\u4ece\u5730\u70b9\u9875\u9762\u4e0a\u70b9\u51fb\u60a8\u60f3\u5206\u6790\u7684\u5217\u8868\u3002\u9ed8\u8ba4\u5206\u6790\u89c6\u56fe\u4e3a\u201c\u68ee\u6797\u53d8\u5316\u201d\u3002", "4e18b40d99e2a239dab223866f59f7a5": "\u8bbf\u95ee\u68ee\u6797\u53d8\u5316\u5217\u8868\u89c6\u56fe", "4b4436a47bf406a744c76b1970c353a3": "\u5206\u6790\u7ed3\u679c\u4f1a\u51fa\u73b0\u5728\u5206\u6790/\u57fa\u56fe\u9762\u677f\u7684\u5206\u6790\u6807\u7b7e\u4e0a\u3002\u60a8\u53ef\u4ee5\u70b9\u51fb\u201c\u6dfb\u52a0\u65b0\u5730\u70b9\u201d\uff0c\u5c06\u7ecf\u8fc7\u5206\u6790\u7684\u5730\u70b9\u6dfb\u52a0\u5230Pro\u8d26\u6237\u4e2d\u7684\u65b0\u5217\u8868\u6216\u73b0\u6709\u5217\u8868\u4e2d\u3002", "f3bba394339a177df631b57710b7b389": "\u70b9\u51fbQGIS\u7f51\u9875\u9876\u90e8\u7684\u201c\u77e2\u91cf\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u7814\u7a76\u5de5\u5177\u201d\u548c\u201c\u6309\u5730\u70b9\u9009\u62e9\u201d\u3002\u9009\u62e9\u60a8\u7684\u6570\u636e\u4f5c\u4e3a\u8f93\u5165\u91cf\uff0cGADM\u8fb9\u754c\u4f5c\u4e3a\u6bd4\u8f83\u5c42\u3002\u4ece\u53ef\u7528\u9009\u9879\u4e2d\u9009\u62e9\u201c\u76f8\u4ea4\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u8fd0\u884c\u201d\u3002", "0a8d3854c31bc82ea8d1900af47144bb": "\u82e5\u60f3\u4e0a\u4f20\u5546\u54c1\uff0c\u8bf7\u9009\u62e9\u4e00\u4e2a\u5730\u70b9\u5206\u7c7b\u3002\u5bf9\u4e8e\u67d0\u4e9b\u5546\u54c1\u6a21\u677f\u6765\u8bf4\uff0c\u5730\u70b9\u5206\u7c7b\u662f\u9884\u5148\u5b9a\u4e49\u7684\uff0c\u4e0d\u53ef\u7f16\u8f91\u3002\u5730\u70b9\u5206\u7c7b\u5305\u62ec\u4ee5\u4e0b\u9009\u9879\u3002", "2d2e3246e79ea0c185a7a321d2a54d39": "\u63a2\u7d22\u6c47\u603b\u4e86{location}\u5730\u533a\u4eba\u7c7b\u571f\u5730\u4f7f\u7528\u60c5\u51b5\u7684\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u5730\u56fe\u3002\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u519c\u4ea7\u54c1\u7684\u51fa\u53e3\u6d41\u91cf\u3001\u68ee\u6797\u7684\u7ecf\u6d4e\u5f71\u54cd\u548c\u6797\u4e1a\u5c31\u4e1a\u2014\u2014\u53ef\u4ee5\u5b9a\u5236\uff0c\u6613\u4e8e\u5206\u4eab\u548c\u4e0b\u8f7d\u79bb\u7ebf\u4f7f\u7528\u3002", "b7f5a15654b646610825f10732853123": "\u4e00\u65e6\u6709\u65b0\u7528\u6237\u88ab\u6dfb\u52a0\u5230\u60a8\u7684\u7ec4\u7ec7\u4e2d\uff0c\u4ed6\u4eec\u7684\u8d26\u6237\u9700\u6fc0\u6d3b\u624d\u80fd\u767b\u5f55\u3002\u82e5\u60f3\u6fc0\u6d3b\u65b0\u7528\u6237\uff0c\u8bf7\u5411\u4e0b\u6eda\u52a8\u5230\u201c\u6863\u6848\u201d\u9875\u9762\u7684\u201c\u7528\u6237\u201d\u90e8\u5206\u3002\u60a8\u4f1a\u770b\u5230\u72b6\u6001\u4e3a\u201c\u5f85\u5b9a\u201d\u7684\u65b0\u7528\u6237\u3002\u70b9\u51fb\u8be5\u7528\u6237\u7684\u540d\u5b57\uff0c\u52a0\u8f7d\u5176\u6863\u6848\u3002\u5728\u53f3\u4e0b\u65b9\u70b9\u51fb\u201c\u6fc0\u6d3b\u201d\u6765\u6fc0\u6d3b\u4ed6\u4eec\u7684\u8d26\u6237\u3002\u7136\u540e\uff0cPro\u5c06\u81ea\u52a8\u751f\u6210\u4e00\u5c01\u90ae\u4ef6\u5e76\u53d1\u9001\u7ed9\u65b0\u7528\u6237\uff0c\u5e76\u63d0\u4f9b\u767b\u5f55\u8bf4\u660e\u3002", "1e36d5e167470143faae4a9953e47a34": "\u82e5\u60f3\u628a\u5217\u8868\u4ece\u4e00\u4e2a\u6587\u4ef6\u5939\u79fb\u5230\u53e6\u4e00\u4e2a\u6587\u4ef6\u5939\uff0c\u6216\u4ece\u4e00\u4e2a\u6587\u4ef6\u5939\u4e2d\u5220\u9664\u5217\u8868\uff0c\u8bf7\u70b9\u51fb\u6587\u4ef6\u5939\uff0c\u7136\u540e\u70b9\u51fb\u6587\u4ef6\u5939\u5185\u8be5\u540d\u5355\u65c1\u8fb9\u7684\u201c...\u201d\u83dc\u5355\uff0c\u9009\u62e9\u201c\u7ba1\u7406\u201d\u3002", "63d8ba440644874f796c53247f30af85": "\u5728\u5730\u56fe\u4e0a\u56f4\u7ed5\u60a8\u8981\u5206\u6790\u7684\u533a\u57df\u7ed8\u5236\u4e00\u4e2a\u5f62\u72b6\u3002\u5728\u5206\u6790/\u57fa\u56fe\u9762\u677f\u7684\u5206\u6790\u9009\u9879\u5361\u4e0a\u70b9\u51fb\u201c\u5f00\u59cb\u7ed8\u56fe\u201d\uff0c\u7136\u540e\u901a\u8fc7\u70b9\u51fb\u5730\u56fe\u6765\u5b9a\u4e49\u60a8\u611f\u5174\u8da3\u7684\u533a\u57df\u3002\u60a8\u5fc5\u987b\u8fd4\u56de\u60a8\u653e\u7f6e\u7684\u7b2c\u4e00\u4e2a\u70b9\uff0c\u70b9\u51fb\u5b83\u6765\u95ed\u5408\u5f62\u72b6\u3002\u5f62\u72b6\u4e00\u65e6\u5b8c\u5168\u8fde\u63a5\uff0c\u5206\u6790\u5c31\u4f1a\u8fd0\u884c\u3002", "f174640a5600ed162a8ead10dc4f2180": "\u70b9\u51fb\u201c\u66f4\u6539\u5bc6\u7801\u201d\uff0c\u6309\u7167\u6307\u793a\u66f4\u6539\u5bc6\u7801\u3002", "bcfff3636642170d18f9de215b12f1e3": "\u82e5\u60f3\u505c\u7528\u8d26\u6237\u7ba1\u7406\u5458\uff0c\u7ba1\u7406\u5458\u5fc5\u987b\u5c06\u6b63\u5f0f\u7684\u505c\u7528\u8bf7\u6c42\u53d1\u5230<a href=\"{{0}}\">gfwprosupport@wri.org</a>\u3002Pro\u8d85\u7ea7\u7ba1\u7406\u5458\u5c06\u5728\u4e24\u4e2a\u5de5\u4f5c\u65e5\u5185\u56de\u590d\uff0c\u5e76\u63d0\u4f9b\u4e00\u4e2a\u90ae\u4ef6\u6a21\u677f\u3002\u7ba1\u7406\u5458\u5fc5\u987b\u5b8c\u6210\u90ae\u4ef6\u6a21\u677f\uff0c\u5e76\u56de\u590dPro\u7248\u8d85\u7ea7\u7ba1\u7406\u5458\uff0c\u786e\u8ba4\u8be5\u8bf7\u6c42\u3002\u7ba1\u7406\u5458\u521b\u5efa\u6216\u4e0a\u4f20\u7684\u6240\u6709\u6863\u6848\u3001\u5217\u8868\u548c\u5730\u70b9\u4ecd\u5c06\u5bf9\u6240\u6709\u8d26\u6237\u7528\u6237\u5f00\u653e\u3002\u4e0e\u7ec4\u7ec7\u4e2d\u5176\u4ed6\u4eba\u5171\u4eab\u7684\u6240\u6709\u5217\u8868\u4ecd\u5c06\u88ab\u5171\u4eab\u3002", "34feddd8a29da86b6c2e32d709090b0a": "\u4e00\u4e9b\u4e0a\u4f20\u7684\u5927\u578b\u5730\u70b9\uff0c\u5982\u534a\u5f8450 KM\u7684\u68d5\u6988\u6cb9\u5382\uff0c\u53ef\u80fd\u8de8\u8d8a\u4e00\u4e2a\u56fd\u5bb6\u5185\u7684\u591a\u4e2a\u6b21\u5dde\u6216\u5dde\u3002\u5730\u70b9\u8fb9\u754c\u5185\u7684\u6bcf\u4e2a\u6b21\u5dde\u6216\u5dde\u90fd\u7528\u4e00\u4e2a\u5706\u5708\u8868\u793a\u3002\u7136\u800c\uff0c\u53ea\u6709\u6700\u63a5\u8fd1\u5730\u70b9\u4e2d\u5fc3\u7684\u4e00\u4e2a\u6b21\u5dde\u6216\u5dde\u4f1a\u5728\u201c\u5730\u70b9\u6570\u201d\u65c1\u8fb9\u663e\u793a\u4e00\u4e2a\u6570\u5b57\u3002\u5176\u4ed6\u6b21\u5dde\u6216\u5dde\u5c06\u4ee5\u5706\u5708\u7684\u5f62\u5f0f\u51fa\u73b0\uff0c\u5176\u5730\u70b9\u6570\u4e3a0\uff0c\u8fd9\u6837\u80fd\u907f\u514d\u91cd\u590d\u8ba1\u7b97\u5730\u70b9\uff0c\u540c\u65f6\u4ecd\u663e\u793a\u8be5\u5730\u70b9\u8fb9\u754c\u5185\u7684\u4efb\u4f55\u6f5c\u5728\u8b66\u62a5\u3002 ", "de07ea95507b96ed019ae2e711229724": "\u5bf9\u5730\u70b9\u8fdb\u884c\u547d\u540d\uff0c\u7136\u540e\u521b\u5efa\u65b0\u5217\u8868\u6216\u5c06\u5176\u6dfb\u52a0\u5230\u73b0\u6709\u5217\u8868\u4e2d\u3002\u60a8\u53ea\u80fd\u5c06\u5730\u70b9\u6dfb\u52a0\u5230\u6a21\u677f\u7c7b\u578b\u5b8c\u5168\u76f8\u540c\u7684\u5217\u8868\u4e2d\uff0c\u5982\u679c\u60a8\u4f7f\u7528\u901a\u7528\u6a21\u677f\uff0c\u5219\u4e3a\u5177\u6709\u76f8\u540c\u5730\u70b9\u5206\u7c7b\u7684\u76f8\u540c\u5546\u54c1\u7c7b\u578b\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u5927\u8c46\u4f9b\u5e94\u68da\u53ea\u80fd\u88ab\u6dfb\u52a0\u5230\u73b0\u6709\u7684\u5927\u8c46\u4f9b\u5e94\u68da\u5730\u70b9\u5217\u8868\u4e2d\u3002", "5c54b5642346ab124f9004e56ae005c8": "\u82e5\u60f3\u6dfb\u52a0\u65b0\u7528\u6237\uff0c\u8bf7\u70b9\u51fb\u201c\u521b\u5efa\u65b0\u7528\u6237\u201d\u3002\u8f93\u5165\u60a8\u60f3\u6dfb\u52a0\u7684\u7528\u6237\u7684\u8be6\u7ec6\u4fe1\u606f\uff0c\u7136\u540e\u786e\u5b9a\u5e76\u9009\u62e9\u65b0\u7528\u6237\u7684\u6743\u9650\u7ea7\u522b\u3002\u5728<a href=\"{{0}}\">\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u5728Pro\u7248\u4e0a\u6d4f\u89c8\u7528\u6237\u6743\u9650\u7ea7\u522b\u3002\u5b8c\u6210\u6240\u6709\u5fc5\u586b\u9879\u548c\u60a8\u60f3\u586b\u5199\u7684\u53ef\u9009\u9879\uff0c\u7136\u540e\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u3002\u4e4b\u540e\u60a8\u5c06\u88ab\u5f15\u5bfc\u8fd4\u56de\u6863\u6848\u9875\u9762\u3002", "8456d29d73464662c2571c90bdbabe35": "\u60a8\u4f1a\u88ab\u5f15\u5bfc\u81f3\u4e00\u4e2a\u65b0\u9875\u9762\uff0c\u5e76\u5728\u8be5\u9875\u9762\u4e0a\u6dfb\u52a0\u5730\u70b9\u3002\u9009\u62e9\u60a8\u8981\u4e0a\u4f20\u7684\u5730\u70b9\u7c7b\u578b\uff08\u5bf9\u4efb\u4f55\u7c7b\u578b\u7684\u5546\u54c1\u7684\u6295\u8d44\u6216\u4efb\u4f55\u5546\u54c1\u4f9b\u5e94\u94fe\u5730\u70b9\uff09\uff0c\u4ee5\u53ca\u76f8\u5173\u7684\u5546\u54c1\u7c7b\u578b\u3002", "5179d3cf4a93be737d84e041e15dc804": "\u9875\u9762\u4f59\u4e0b\u7684\u90e8\u5206\u5c06\u663e\u793a\u4e0e\u60a8\u7684\u5730\u70b9\u7684\u68ee\u6797\u53d8\u5316\u6709\u5173\u7684\u56fe\u8868\u548c\u5206\u6790\uff0c\u5305\u62ec\u654f\u611f\u5730\u533a\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u548c\u6811\u6728\u8986\u76d6\u7387\u968f\u65f6\u95f4\u53d1\u751f\u7684\u53d8\u5316\u3002\u60a8\u53ef\u4ee5\u5b9a\u5236\u6570\u636e\u56fe\u8868\uff0c\u6bd4\u5982\u9009\u62e9\u6811\u6728\u8986\u76d6\u635f\u5931\u548c/\u6216\u5176\u4ed6\u6570\u636e\u5c42\uff0c\u8fd8\u53ef\u4ee5\u62d6\u653e\u65f6\u95f4\u6ed1\u5757\u7684\u4e24\u7aef\uff0c\u8bbe\u7f6e\u60a8\u60f3\u67e5\u770b\u7684\u65e5\u671f\u8303\u56f4\u3002", "eba5d1fe6bbe0fff2492b413037388a4": "\u67095\u4e2a\u6765\u81eaGFW\u7684\u5217\u8868\u53ef\u5728Pro\u4e0a\u4f7f\u7528\u3002\u8fd9\u4e9b\u5217\u8868\u4ee3\u8868\u4e86\u7531GFW\u56e2\u961f\u9009\u62e9\u6216\u521b\u5efa\u7684\u6570\u636e\u3002\u60a8\u53ef\u4ee5\u7528\u8fd9\u4e9b\u5217\u8868\u6765\u521b\u5efa\u81ea\u5df1\u7684\u5b50\u5217\u8868\u3002", "4d93388cc216bef2e482b9c723458aa7": "<strong>\u8f93\u5165\u5750\u6807</strong>\uff1a\u8f93\u5165\u7eac\u5ea6\uff0c\u5c0f\u6570\u70b9\u540e\u503c\u5728-90.00\u548c90.00\u4e4b\u95f4\uff0c\u4ee5\u53ca\u7ecf\u5ea6\uff0c\u5c0f\u6570\u70b9\u540e\u503c\u5728-180.00\u548c180.00\u4e4b\u95f4\u3002", "3082fa7d221d82dc65924119f36243d2": "\u4e0b\u8f7d\u6a21\u677fshapefile\u540e\uff0c\u5c06\u5176\u52a0\u8f7d\u5230GIS\u8f6f\u4ef6\u4e2d\uff0c\u6253\u5f00\u5c5e\u6027\u8868\u3002shapefile\u7684\u5b57\u6bb5\u540d\u6700\u591a\u542b\u670910\u4e2a\u5b57\u7b26\uff0c\u6240\u6709\u7a7a\u683c\u90fd\u4f1a\u88ab\u4e0b\u5212\u7ebf\u66ff\u4ee3\u3002\u4f8b\u5982\uff0c\u5728\u5c5e\u6027\u8868\u4e2d\uff0c\u201cLocation Name\u201d\u5206\u680f\u5c06\u88ab\u91cd\u65b0\u547d\u540d\u4e3a\u201cLocation_N\u201d\u3002GFW Pro\u4f1a\u8bc6\u522b\u5e76\u63a5\u53d7\u8fd9\u4e9b\u5b57\u6bb5\u540d\u3002", "aa0e0c85809cd4caf9e0aa99c2f7ea4c": "\u60a8\u53ef\u4ee5\u4f7f\u7528\u6a21\u677f\u4e2d\u7684\u6700\u540e3\u4e2a\u5206\u680fAttribute1, Attribute2 \u548c Attribute3\u6765\u6dfb\u52a0\u53ef\u9009\u81ea\u5b9a\u4e49\u5b57\u6bb5\uff0c\u6700\u591a\u53ef\u6dfb\u52a0\u4e09\u4e2a\u3002\u60a8\u5fc5\u987b\u5148\u5c06\u5206\u680f\u6807\u9898\u6539\u4e3a\u60a8\u60f3\u8981\u7684\u6587\u672c\u540d\u79f0\uff0c\u7136\u540e\u7528\u6587\u672c\u586b\u5145\u6307\u5bfc\u884c\u4e0b\u9762\u7684\u5b57\u6bb5\u3002\u5c06\u6a21\u677f\u4e0a\u4f20\u5230Pro\u7248\u65f6\uff0c\u60a8\u5fc5\u987b\u4e00\u5b57\u4e0d\u5dee\u5730\u91cd\u65b0\u8f93\u5165\u8fd9\u4e9b\u5c5e\u6027\u5b57\u6bb5\u540d\u79f0\u3002\u5728<a href=\"{{0}}\">\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u5f80Pro\u7248\u4e0a\u4f20\u5730\u70b9\u548c\u5217\u8868\u3002", "4920061891a7f38ca7c0e3885d828bf9": "\u5c06\u9f20\u6807\u60ac\u505c\u5728\u952e\u503c\u4e0a\uff0c\u5373\u53ef\u4e86\u89e3\u5706\u5708\u5927\u5c0f\u4e0e\u5730\u70b9\u6570\u91cf\u7684\u5bf9\u5e94\u5173\u7cfb\u7684\u8be6\u60c5\u3002", "496322b0dc510205fdb9371062e38ec0": "<strong>\u4fdd\u62a4\u533a</strong>\uff1a\u60a8\u4f1a\u6536\u5230\u6309\u56fd\u5bb6\u6765\u7b5b\u9009\u7ed3\u679c\u7684\u63d0\u793a\u3002\u60a8\u8fd8\u53ef\u4ee5\u9009\u62e9\u5dde\u3001\u6b21\u5dde\u3001\u6307\u5b9a\u7c7b\u578b\uff08\u4fdd\u62a4\u533a\u7c7b\u578b\uff09\u548c\u6307\u5b9a\uff08\u7279\u5b9a\u4fdd\u62a4\u533a\uff09\u6765\u8fdb\u4e00\u6b65\u7b5b\u9009\u5217\u8868\u3002\u9009\u5b9a\u60a8\u60f3\u8981\u7684\u5730\u533a\u540e\uff0c\u70b9\u51fb\u201c\u66f4\u65b0\u503c\u201d\u3002\u5982\u679c\u60a8\u60f3\u7f16\u8f91\u60a8\u7684\u9009\u62e9\uff0c\u70b9\u51fb\u53f3\u4e0a\u65b9\u7684\u201c\u7b5b\u9009\u201d\u3002", "8bfe39672408c08c361378578208a66f": "\u7b2c\u4e00\u6b21\u521b\u5efa\u6587\u4ef6\u5939\u65f6\uff0c\u60a8\u4f1a\u88ab\u63d0\u793a\u521b\u5efa\u65b0\u6587\u4ef6\u5939\u3002\u4e4b\u540e\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u521b\u5efa\u65b0\u6587\u4ef6\u5939\uff0c\u6216\u5c06\u6587\u4ef6\u5939\u6dfb\u52a0\u5230\u73b0\u6709\u6587\u4ef6\u5939\u3002", "3670b71e0852b715094d1adb6270519a": "\u6240\u6709\u5730\u70b9\u5fc5\u987b\u5728\u9646\u5730\u4e0a\uff0c\u5426\u5219Pro\u5c06\u63d0\u793a\u9519\u8bef\u3002\u82e5\u60f3\u68c0\u67e5\u5730\u70b9\uff0c\u60a8\u53ef\u4ee5\u5c06\u5b83\u4eec\u4e0e<a rel=\"noreferrer noopener\" href=\"{{0}}\" target=\"_blank\">GADM\u884c\u653f\u8fb9\u754c</a>\u8fdb\u884c\u6bd4\u8f83\uff08\u4ee5\u56fd\u5bb6\u4e3a\u5355\u4f4d\u4e0b\u8f7d\uff09\u3002\u786e\u8ba4\u60a8\u7684\u7248\u672c\u662f2.8\uff0c\u800c\u975e3.6\u3002\u5982\u679c\u6240\u6709\u5730\u70b9\u90fd\u5728\u9646\u5730\u4e0a\uff0c\u5374\u4ecd\u7136\u6536\u5230\u51fa\u9519\u4fe1\u606f\uff0c\u8bf7\u53c2\u8003<a href=\"{{1}}\">\u5ba2\u670d\u95ee\u9898</a>\u4e86\u89e3\u8be6\u60c5\u3002", "50af42d4b185b45261f26d25180bbf13": "\u60a8\u5f80GFW Pro\u4e0a\u4f20\u5217\u8868\u540e\uff0c\u5373\u53ef\u5728\u5730\u70b9\u9875\u9762\u4e0a\u8fdb\u4e00\u6b65\u7ba1\u7406\u548c\u7f16\u8f91\u8be5\u5217\u8868\u3002\u4ee5\u4e0b\u6b65\u9aa4\u5c06\u6307\u5bfc\u60a8\u5982\u4f55\u7ba1\u7406\u5217\u8868\u3001\u5229\u7528\u6587\u4ef6\u5939\u7ec4\u7ec7\u5217\u8868\u3001\u7f16\u8f91\u5217\u8868\u3001\u79fb\u52a8\u6216\u590d\u5236\u5217\u8868\u4e2d\u7684\u5730\u70b9\u3001\u5220\u9664\u5217\u8868\u4e2d\u7684\u5730\u70b9\uff0c\u4ee5\u53ca\u4eceGFW\u7ba1\u7406\u5217\u8868\u3002", "9e4ddcf14dd6587212be1fb2d7c240c7": "\u5f80Pro\u8d26\u6237\u4e0a\u4f20\u4e24\u4e2a\u5217\u8868\u540e\uff0c\u5373\u53ef\u5728\u5730\u70b9\u9875\u9762\u4e0a\u7528\u6587\u4ef6\u5939\u6765\u8fdb\u4e00\u6b65\u7ba1\u7406\u5217\u8868\u3002", "d8264e7286f65e819b2b4138ff2cf45c": "\u63a2\u7d22\u6c47\u603b\u4e86\u5168\u7403\u68ee\u6797\u53d8\u5316\u7387\u7684\u4e92\u52a8\u56fe\u8868\u548c\u5730\u56fe\u3002\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u68ee\u6797\u635f\u5931\u548c\u589e\u52a0\u6700\u591a\u7684\u56fd\u5bb6\u7684\u6392\u540d\uff0c\u4ee5\u53ca\u68ee\u6797\u780d\u4f10\u7684\u9a71\u52a8\u56e0\u7d20\u2014\u2014\u53ef\u4ee5\u5b9a\u5236\uff0c\u6613\u4e8e\u5206\u4eab\u548c\u4e0b\u8f7d\u79bb\u7ebf\u4f7f\u7528\u3002", "113c62e3e7c7600b3473b64006e46fd8": "\u89c2\u770b\u5370\u5c3c\u8bed\u89c6\u9891\u3002", "210de0a2a3b434d940ad5f5f6bcdd3a3": "<strong>\u884c\u653f\u533a\u57df</strong>\uff1a\u5168\u4e16\u754c\u6240\u6709\u56fd\u5bb6\u3001\u5dde\u7701\u548c\u5e02\u53bf\u3002", "f9c9d5572d8a5ad492cb0537f0aa94fa": "\u7ed3\u679c\u5c06\u5bfc\u51fa\u4e00\u4e2a\u5305\u542b\u5206\u6790\u7ed3\u679c\u7684 CSV \u6587\u4ef6\u3002", "766d8d3750472c6e29ff05048166d598": "\u5728 Google Earth \u4e0a\u6253\u5f00 KML\uff0c\u786e\u4fdd\u6240\u6709\u7684\u7279\u5f81\u90fd\u4f4d\u4e8e\u9646\u5730\u4e0a\u3002\u5982\u679c\u5b83\u4eec\u4e0d\u5728\u9646\u5730\u4e0a\uff0c\u8bf7\u5220\u9664\u4f4d\u4e8e\u6d77\u6d0b\u4e2d\u7684\u591a\u8fb9\u5f62\u6216\u70b9\u3002\u8981\u5220\u9664\u591a\u8fb9\u5f62\u6216\u70b9\uff0c\u5728\u76ee\u5f55\u4e2d\u53f3\u51fb\u8be5\u7279\u5f81\uff0c\u5e76\u70b9\u51fb\u201c\u5220\u9664\u201d\u3002", "cb1877a4afbb8504fce5199067e2dc20": "\u70b9\u51fb\u201c\u5b50\u516c\u53f8\u201d\u590d\u9009\u6846\u5e76\u8f93\u5165\u6bcd\u516c\u53f8\u540d\u79f0\u3002", "d26e4aa45fbfdb6abd2b2f9293c0afdc": "\u4ee5\u4e0b\u8fc7\u7a0b\u9700\u8981\u624b\u52a8\u7f16\u8f91\u60a8\u7684\u6570\u636e\u3002\u5173\u4e8e QGIS \u4e2d\u7684\u7f16\u8f91\u5de5\u5177\u7684\u8be6\u7ec6\u4fe1\u606f\u53ef\u4ee5<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5728\u6b64</a>\u627e\u5230\u2014\u2014\u638c\u63e1\u8fd9\u4e9b\u4fe1\u606f\u5bf9\u65b0\u7684 GIS \u7528\u6237\u6765\u8bf4\u662f\u975e\u5e38\u6709\u7528\u7684\u3002\u5728\u7f16\u8f91\u6570\u636e\u7684\u8fc7\u7a0b\u4e2d\uff0c\u8bb0\u5f97\u8981\u7ecf\u5e38\u4fdd\u5b58\u60a8\u7684\u5de5\u4f5c\u3002", "4cc0abaedbcbda3a0d5abdfddec216b4": "\u63a2\u7d22\u5176\u4ed6\u8d44\u6599\u2014\u2014\u5305\u62ec\u89c6\u9891\u6307\u5357\u548c\u5b58\u6863\u7684 GFW \u6559\u7a0b\u2014\u2014\u4ee5\u4e86\u89e3\u5982\u4f55\u4f7f\u7528 GFW Pro \u6765\u5e2e\u52a9\u7ba1\u7406\u5927\u5b97\u5546\u54c1\u4f9b\u5e94\u94fe\u4e2d\u7684\u68ee\u6797\u780d\u4f10\u98ce\u9669\u3002", "c4773cdb00210e3a4f22ee78cf89b63f": "\u5f53\u6dfb\u52a0\u4e00\u4e2a\u65b0\u7684\u5b57\u6bb5\u65f6\uff0c\u60a8\u4f1a\u88ab\u63d0\u793a\u8f93\u5165\u5b57\u6bb5\u540d\u548c\u6570\u636e\u7c7b\u578b\u3002\u5b57\u6bb5\u540d\u5c06\u662f\u6a21\u677f\u4e2d\u5b57\u6bb5\u7684\u524d\u5341\u4e2a\u5b57\u7b26\uff0c\u5e76\u4e14\u7a7a\u683c\u90fd\u5e94\u8be5\u7528\u4e0b\u5212\u7ebf\u4ee3\u66ff\u3002\u5982\u679c\u60a8\u60f3\u521b\u5efa\u4e00\u4e2a\u5305\u542b\u6587\u672c\u7684\u5b57\u6bb5\uff0c\u8bf7\u9009\u62e9\u201c\u5b57\u7b26\u4e32\u201d\u4f5c\u4e3a\u6570\u636e\u7c7b\u578b\uff1b\u5982\u679c\u662f\u6570\u503c\uff0c\u8bf7\u9009\u62e9\u201c\u5341\u8fdb\u5236\u503c\u201d\uff08\u4e5f\u79f0\u4e3a\u201c\u53cc\u7cbe\u5ea6\u201d\uff09\u3002", "4626afb9c0c583685ee508545187f9c7": "\u63a2\u7d22\u603b\u7ed3\u68ee\u6797\u5728 {location} \u6c14\u5019\u53d8\u5316\u4e2d\u6240\u8d77\u4f5c\u7528\u7684\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u5730\u56fe\u3002\u68ee\u6797\u78b3\u7edf\u8ba1\u2014\u2014\u5305\u62ec\u68ee\u6797\u5982\u4f55\u50a8\u5b58\u3001\u6392\u653e\u548c\u5c01\u5b58\uff08\u6e05\u9664\uff09\u78b3\u2014\u2014\u53ef\u5b9a\u5236\u4e14\u6613\u4e8e\u5206\u4eab\u548c\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "4ce6729bf4f20b2953600d6a7c52418c": "\u4e00\u65e6\u521b\u5efa\u4e86\u4e00\u4e2a\u6587\u4ef6\u5939\uff0c\u5e76\u5c06\u5217\u8868\u52a0\u5165\u5176\u4e2d\uff0c\u8be5\u6587\u4ef6\u5939\u5c31\u4f1a\u51fa\u73b0\u5728\u5730\u70b9\u7f51\u9875\u4e0a\u4f60\u7684\u5217\u8868\u4e0a\u65b9\u3002\u6b64\u65f6\u4f1a\u51fa\u73b0\u4e00\u6761\u6a2a\u5e45\uff0c\u8868\u660e\u60a8\u5df2\u5c06\u5217\u8868\u6dfb\u52a0\u5230\u6587\u4ef6\u5939\u4e2d\u3002\u5373\u4f7f\u60a8\u7684\u5217\u8868\u88ab\u6dfb\u52a0\u5230\u6587\u4ef6\u5939\u4e2d\uff0c\u4f60\u7684\u5217\u8868\u4ecd\u7136\u4f1a\u51fa\u73b0\u5728\u201c\u6211\u7684\u5217\u8868\u201d\u4e0b\u65b9\u3002", "24ec299abfa7750333d9d415f9536edc": "\u7ba1\u7406\u73b0\u6709\u8d26\u6237", "5ed81b5e6b382506da8cf15d0962e0c7": "\u8981\u5c06\u7ebf\u6bb5\u8f6c\u6362\u4e3a\u591a\u8fb9\u5f62\uff0c\u8bf7\u6253\u5f00\u5de5\u5177\u7bb1\u9762\u677f\uff0c\u9009\u62e9\u77e2\u91cf\u51e0\u4f55\u6807\u7b7e\u4e0b\u7684 Polygonize \u5de5\u5177\u3002\u5728 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">StackExchange</a> \u4e0a\u4e86\u89e3\u5982\u4f55\u5728 QGIS \u4e0a\u4ee5\u7ebf\u6bb5\u521b\u5efa\u591a\u8fb9\u5f62\u3002", "90b96fd4045d7f07403fab16df54ebf8": "\u70b9\u51fb\u5f85\u5904\u7406\u7528\u6237\u7684\u540d\u79f0\u4ee5\u8bbf\u95ee\u4ed6\u4eec\u7684\u4e2a\u4eba\u8d44\u6599\u3002", "b57b76cdb1194de2d561c171ebf5f313": "\u60a8\u4e0a\u4f20\u7684\u6bcf\u4e2a\u6a21\u677f\u4ec5\u9650\u4e8e\u4e00\u79cd\u5927\u5b97\u5546\u54c1\u7c7b\u578b\u548c\u5730\u70b9\u5206\u7c7b\u3002\u5730\u70b9\u5206\u7c7b\u6982\u8ff0\u5982\u4e0b\u3002", "0c0b2d5dfd4a0327f06b889145d994b6": "\u5728\u68ee\u6797\u53d8\u5316\u5217\u8868\u89c6\u56fe\u4e2d\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u8868\u683c\u5de6\u4e0a\u65b9\u7684\u590d\u9009\u6846\u5bf9\u5217\u8868\u4e2d\u7684\u6240\u6709\u5730\u70b9\u8fdb\u884c\u8bca\u65ad\uff0c\u6216\u8005\u901a\u8fc7\u70b9\u51fb\u5355\u4e2a\u5730\u70b9\u65c1\u8fb9\u7684\u590d\u9009\u6846\u5bf9\u5217\u8868\u4e2d\u7684\u5355\u4e2a\u5730\u70b9\u8fdb\u884c\u8bca\u65ad\u3002", "65bb627c2ef9c2d7b99b1f016578933d": "\u70b9\u51fb\u53f3\u4e0a\u65b9\u7684\u201c\u5206\u4eab\u201d\u3002", "f37d6c539307a93f6e207d39d6d50556": "\u67e5\u770b GFW \u5217\u8868\u548c\u4e0e\u60a8\u5171\u4eab\u7684\u5217\u8868\u4e0a\u7684\u8bca\u65ad\u548c\u4eea\u8868\u677f\u7ed3\u679c\u3002", "91ed136e357e423dc2d9405e18b6fdf7": "\u89c2\u770b\u8005\u8bb8\u53ef\u6743\u9650\u7ea7\u522b", "0fc983cf2364b8e40c588a4789eb0df3": "<strong>\u5206\u4eab</strong>\uff1a\u5728\u5185\u90e8\u5206\u4eab\u60a8\u7684\u5217\u8868\u3002\u53ea\u6709\u7ba1\u7406\u5458\u53ef\u4ee5\u542f\u52a8\u5217\u8868\u5206\u4eab \u2014\u2014\u7f16\u8f91\u548c\u89c2\u770b\u8005\u53ef\u4ee5\u63a5\u6536\u5206\u4eab\u7684\u5217\u8868\u3002", "b008c251846fe0d414f4a6efb44ae1aa": "\u5982\u679c\u8d1f\u8d23\u8be5\u5217\u8868\u7684\u7528\u6237\u5bf9\u5217\u8868\u52a0\u4ee5\u66f4\u65b0\u6216\u7f16\u8f91\uff0c\u5219\u4f1a\u4e3a\u6240\u6709\u6536\u53d6\u4eba\u81ea\u52a8\u66f4\u65b0\u8be5\u5217\u8868\u3002", "401dc7b671d2a2e9ac4b17cae07df32c": "\u653e\u5927\u540e\u53ef\u4ee5\u66f4\u8be6\u7ec6\u5730\u67e5\u770b\u60a8\u7684\u5730\u70b9\u548c\u5176\u4e2d\u53d1\u751f\u8b66\u62a5\u7684\u5730\u70b9\u3002", "908fd35ad6a214697148db147a7b0697": "\u5982\u679c\u60a8\u4e0d\u4fee\u590d\u9519\u8bef\u5c31\u7ee7\u7eed\u64cd\u4f5c\uff0c\u6b64\u65f6\u4f1a\u5f39\u51fa\u4e00\u4e2a\u7a97\u53e3\uff0c\u8be2\u95ee\u60a8\u662f\u5426\u786e\u5b9a\u8981\u7ee7\u7eed\u3002\u60a8\u53ef\u4ee5\u5728\u5217\u8868\u4e2d\u6709\u9519\u8bef\u7684\u60c5\u51b5\u4e0b\u7ee7\u7eed\u4e0a\u4f20\u6d41\u7a0b\u3002\u5728\u70b9\u51fb\u201c\u63d0\u4ea4\u201d\u4ee5\u4e0a\u4f20\u5217\u8868\u65f6\uff0c\u6709\u9519\u8bef\u7684\u5730\u70b9\u90fd\u4f1a\u88ab\u4e22\u5f03\u3002\u4e00\u65e6\u9a8c\u8bc1\u6b65\u9aa4\u5b8c\u6210\uff0c\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\u3002", "3e1f44af1f015f4f0da6cb2977c701d2": "\u524d\u5f80 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Pro \u7f51\u7ad9</a>\uff0c\u70b9\u51fb\u9876\u90e8\u83dc\u5355\u7684\u201c\u6211\u7684 GFW Pro\u201d\uff0c\u7136\u540e\u8f93\u5165\u60a8\u7684\u4fe1\u606f\uff0c\u5373\u53ef\u767b\u5f55\u60a8\u7684\u8d26\u6237\u3002\u60a8\u9700\u8981\u8f93\u5165\u53d1\u9001\u5230\u60a8\u7684\u7535\u5b50\u90ae\u4ef6\u6216 Google \u8eab\u4efd\u9a8c\u8bc1\u5668\u5e94\u7528\u7684\u9a8c\u8bc1\u7801\u3002", "dea53dbaad64397a1092e59fc5d8afa0": "\u8981\u4ece\u6a21\u677f\u5f62\u72b6\u6587\u4ef6\u4e2d\u5220\u9664\u9644\u52a0\u7279\u5f81\uff0c\u8bf7\u53cc\u51fb\u5c5e\u6027\u8868\u4e2d\u7684\u4efb\u4f55\u4e00\u5217\u3002\u6a21\u677f\u5c5e\u6027\u8868\u4e2d\u7684\u6bcf\u4e00\u5217\u90fd\u88ab\u586b\u5199\uff0c\u8fd9\u5c06\u628a\u5b83\u79fb\u5230\u9876\u884c\u3002", "4e3ef69dc7f13de948f8b5cfa4aedf93": "\u5728\u5168\u7403\u7f29\u653e\u7ea7\u522b\u4e0a\uff0c\u6bcf\u4e2a\u89e6\u53d1\u8b66\u62a5\u7684\u56fd\u5bb6\u90fd\u4f1a\u51fa\u73b0\u4e00\u4e2a\u5706\u5708\u3002\u5728\u56fd\u5bb6\u7f29\u653e\u7ea7\u522b\u4e0a\uff0c\u6bcf\u4e2a\u89e6\u53d1\u8b66\u62a5\u7684\u5dde\u7701\u90fd\u4f1a\u51fa\u73b0\u4e00\u4e2a\u5706\u5708\u3002", "9fa99d415603b12c6ce75b30ce9d2ed9": "\u5728 GFW Pro (Pro) \u4e0a\u9009\u62e9\u6b63\u786e\u7684\u6a21\u677f\u7c7b\u578b\u662f\u975e\u5e38\u91cd\u8981\u7684\uff0c\u5b83\u53ef\u4ee5\u786e\u4fdd\u60a8\u7684\u6570\u636e\u4ee5\u53ef\u88ab Pro \u5206\u6790\u7684\u65b9\u5f0f\u8fdb\u884c\u683c\u5f0f\u5316\uff0c\u4ece\u800c\u786e\u4fdd\u6240\u6709\u7684\u5c5e\u6027\u4fe1\u606f\u90fd\u53ef\u4ee5\u5728 Pro \u4e0a\u4f9b\u60a8\u8c03\u9605\u67e5\u770b\u3002\u4ee5\u4e0b\u662f\u5173\u4e8e\u5982\u4f55\u9009\u62e9\u6b63\u786e\u6a21\u677f\u7c7b\u578b\u7684\u4fe1\u606f\uff0c\u5305\u62ec\u53ef\u7528\u7684\u6a21\u677f\u7c7b\u578b\u548c\u76f8\u5173\u7684\u5730\u70b9\u5206\u7c7b\u3002", "0ef522eec62ef6aef46131162fea1447": "\u901a\u8fc7\u53cc\u51fb\u56fe\u5c42\u653e\u5927\u5230\u6587\u4ef6\u4e2d\u7684\u5730\u70b9\u8303\u56f4\u3002\u5982\u679c\u60a8\u60f3\u653e\u5927\u5230\u4e00\u4e2a\u7279\u5b9a\u5730\u70b9\uff0c\u70b9\u51fb\u60a8\u7684\u56fe\u5c42\u65c1\u8fb9\u7684\u5c0f\u4e09\u89d2\u5f62\uff0c\u67e5\u770b KML/KMZ \u6587\u4ef6\u4e2d\u6240\u6709\u4fdd\u5b58\u7684\u5730\u70b9\u3002", "bf394e0c795a8f5975af3673bbe2f092": "\u4ee3\u8868\u7ec4\u7ec7\u7533\u8bf7\u4e00\u4e2a\u8d26\u6237\u3002", "6edaa77e90d383bea57d5f6caef3ed3c": "\u6bcf\u4e2a\u5730\u70b9\u6216\u5730\u70b9\u5217\u8868\u5fc5\u987b\u9996\u5148\u4e0a\u4f20\u548c\u5206\u6790\u3002\u4e0a\u4f20\u5904\u7406\u65f6\u95f4\u53ef\u80fd\u9700\u8981 24 \u5c0f\u65f6\u4e4b\u4e45\u3002\u5728\u5904\u7406\u5b8c\u6210\u4e4b\u524d\uff0c\u5217\u8868\u5c06\u4ee5\u201c\u6b63\u5728\u5206\u6790\u201d\u7684\u6807\u7b7e\u51fa\u73b0\u5728\u5730\u70b9\u7f51\u9875\u4e0a\uff0c\u5e76\u4e14\u4e0d\u80fd\u70b9\u51fb\u3002\u4e00\u65e6\u5904\u7406\u5f00\u59cb\u548c\u5b8c\u6210\uff0c\u60a8\u5c06\u6536\u5230\u4e00\u5c01\u786e\u8ba4\u7535\u5b50\u90ae\u4ef6\u3002", "d534c69fe4606d863d9ce2d50e4bffb1": "\u4e00\u822c\u755c\u7267\u573a\u5730", "dd2484bd901dde628881f9a4a5590ef1": "\u5173\u8054\u6bcd\u516c\u53f8\u548c\u5b50\u516c\u53f8", "bb0db6f48876c4c1741b7574168d81d6": "\u70b9\u51fb\u7f51\u9875\u9876\u90e8\u7684\u201c\u9009\u62e9\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u6309\u5730\u70b9\u9009\u62e9\u201d\u3002\u5bf9\u4e8e\u9009\u62e9\u65b9\u6cd5\uff0c\u9009\u62e9\u201c\u9009\u62e9\u7279\u5f81\u6765\u6e90\u201d\u3002\u9009\u62e9\u60a8\u7684\u6570\u636e\u4e3a \"\u76ee\u6807\u5c42\"\uff0cGADM\u8fb9\u754c\u4e3a\u201c\u6e90\u5c42\u201d\u3002\u5bf9\u4e8e\u201c\u7a7a\u95f4\u9009\u62e9\u65b9\u6cd5\u201d\uff0c\u9009\u62e9\u201c\u4e0e\u6e90\u5c42\u7279\u5f81\u76f8\u4ea4\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u786e\u5b9a\u201d\u3002", "28e41904927582a942df820b6faf9c52": "\u8fd0\u884c\u68ee\u6797\u53d8\u5316\u8bca\u65ad\u7a0b\u5e8f", "4416015bded3b0526872af9adbc52f9e": "\u63a2\u7d22\u603b\u7ed3 {location} \u7684\u68ee\u6797\u53d8\u5316\u7387\u7684\u4e92\u52a8\u56fe\u8868\u548c\u5730\u56fe\u3002\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u68ee\u6797\u635f\u5931\u548c\u589e\u52a0\u6700\u591a\u7684\u5730\u533a\u7684\u6392\u540d\u2014\u2014\u53ef\u4ee5\u5b9a\u5236\u4e14\u6613\u4e8e\u5206\u4eab\u548c\u4e0b\u8f7d\uff0c\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "4be72bce15d6ae903b6b12bef1834b40": "\u7136\u540e Pro \u5c06\u5bf9\u5217\u8868\u91cd\u65b0\u6267\u884c\u5206\u6790\u3002\u60a8\u5c06\u88ab\u5bfc\u822a\u56de\u5730\u70b9\u7f51\u9875\uff0c\u90a3\u91cc\u4f1a\u51fa\u73b0\u4e00\u4e2a\u6a2a\u5e45\uff0c\u8868\u660e\u6b63\u5728\u5bf9\u60a8\u7684\u5217\u8868\u8fdb\u884c\u5206\u6790\u3002\u5f53\u5206\u6790\u5f00\u59cb\u548c\u5206\u6790\u7ed3\u675f\u65f6\uff0c\u60a8\u4f1a\u6536\u5230\u4e00\u5c01\u7535\u5b50\u90ae\u4ef6\u3002\u60a8\u53ef\u4ee5\u5728\u5730\u70b9\u7f51\u9875\u4e0a\u201c\u6211\u7684\u5217\u8868\u201d\u4e0b\u67e5\u770b\u5206\u6790\u7ed3\u679c\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u4e86\u89e3\u5173\u4e8e\u5730\u70b9\u548c\u5217\u8868\u5206\u6790\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u4ee5\u53ca<a href=\"{{1}}\">\u5728\u6b64</a>\u4e86\u89e3\u5173\u4e8e\u8fd1\u5b9e\u65f6\u76d1\u63a7\u5730\u70b9\u7684\u4fe1\u606f\u3002", "0fc3d67f9043a3de6f9f42970dd5363e": "\u70b9\u51fb\u201c\u5730\u70b9\u201d\u6807\u7b7e\uff0c\u7136\u540e\u70b9\u51fb\u5de6\u4fa7\u7684\u201c+ \u6dfb\u52a0\u5730\u70b9\u201d\u3002\u6b64\u65f6\u4f1a\u51fa\u73b0\u4e00\u4e2a\u5f39\u7a97\uff0c\u5176\u4e2d\u6709\u4e00\u4e2a\u9009\u9879\u53ef\u4f9b\u9009\u62e9\u4e0a\u4f20\u5355\u4e2a\u5730\u70b9\u6216\u591a\u4e2a\u5730\u70b9\u3002\u5728\u6b64\u60c5\u51b5\u4e0b\uff0c\u9009\u62e9\u201c\u6dfb\u52a0\u5355\u4e2a\u5730\u70b9\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u7ee7\u7eed\u201d\u3002\u5982\u679c\u60a8\u8fd8\u6ca1\u6709\u5c06\u6587\u4ef6\u4e0a\u4f20\u5230 Pro\uff0c\u60a8\u53ef\u4ee5\u70b9\u51fb\u5c4f\u5e55\u4e2d\u95f4\u7684\u201c\u6dfb\u52a0\u5730\u70b9\u201d\u56fe\u6807\uff0c\u5f00\u59cb\u60a8\u7684\u7b2c\u4e00\u6b21\u4e0a\u4f20\u3002", "c2f15e0d589c99edbe4e9c220b8b56d0": "\u8981\u67e5\u770b\u68ee\u6797\u53d8\u5316\u5206\u6790\uff0c\u9996\u5148\u70b9\u51fb\u9876\u90e8\u83dc\u5355\u4e0a\u7684\u201c\u5730\u70b9\u201d\u6807\u7b7e\u3002\u5411\u4e0b\u6eda\u52a8\u5230\u201c\u6211\u7684\u5217\u8868\u201d\uff0c\u9009\u62e9\u4e00\u4e2a\u60a8\u4e0a\u4f20\u81f3 Pro \u4e14\u7ecf\u5b8c\u5168\u5904\u7406\u7684\u5217\u8868\u3002\u4e00\u4e2a\u5305\u542b\u8be5\u5217\u8868\u4e2d\u6240\u6709\u5730\u70b9\u7684\u8868\u683c\u5c06\u88ab\u52a0\u8f7d\u3002", "de9fdbf114b034d2f84cf7c83ddc7ef6": "<strong>\u5730\u56fe</strong>\uff1a\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u60a8\u7684\u5730\u70b9\u6e05\u5355\u3002\u60a8\u53ef\u4ee5\u5728\u5730\u56fe\u4e0a\u6fc0\u6d3b\u4e0d\u540c\u7684\u68ee\u6797\u53d8\u5316\u548c\u80cc\u666f\u6570\u636e\u56fe\u5c42\uff0c\u5982\u6797\u6728\u8986\u76d6\u635f\u5931\u548c\u4fdd\u62a4\u533a\u56fe\u5c42\uff0c\u5e76\u5206\u6790\u7279\u5b9a\u533a\u57df\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u4e86\u89e3\u5982\u4f55\u5728\u5730\u56fe\u4e0a\u5bf9\u6570\u636e\u8fdb\u884c\u53ef\u89c6\u5316\u5904\u7406\u548c\u5206\u6790\u3002", "77599d9f4dd29ef45b496c8473846ae6": "\u5f53\u60a8\u70b9\u51fb\u201c\u6cb9\u68d5\u6988\u7279\u8bb8\u6797\u533a\u201d\u3001\u201c\u68d5\u6988\u6cb9\u5382\u201d\u6216\u201cRSPO\u68d5\u6988\u7279\u8bb8\u6797\u533a \u201d\u5217\u8868\u65f6\uff0c\u6240\u6709\u5730\u70b9\u5c06\u51fa\u73b0\u5728\u5217\u8868\u89c6\u56fe\u4e2d\u3002\u7136\u540e\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u4e00\u4e2a\u6216\u6240\u6709\u5730\u70b9\u6765\u67e5\u770b\u9884\u5148\u8ba1\u7b97\u7684\u5206\u6790\u7ed3\u679c\uff0c\u6216\u67e5\u770b\u5730\u56fe\u89c6\u56fe\u3002", "2005c85272bb994ecffe4477ace2b2a1": "\u5728\u201c\u6709\u9519\u8bef\u7684\u5730\u70b9\u201d\u548c\u201c\u6240\u6709\u5730\u70b9\u201d\u4e4b\u95f4\u5207\u6362\uff0c\u4ee5\u67e5\u770b\u60a8\u7684\u54ea\u4e9b\u5730\u70b9\u6709\u9519\u8bef\uff0c\u9519\u8bef\u5728\u5730\u70b9\u7684\u4ec0\u4e48\u5730\u65b9\uff0c\u5e76\u786e\u8ba4\u9519\u8bef\u5df2\u88ab\u7ea0\u6b63\u548c\u4fdd\u5b58\u3002\u5730\u70b9\u5c06\u4ece\u201c\u6709\u9519\u8bef\u7684\u5730\u70b9\u201d\u5b9e\u65f6\u79fb\u52a8\u5230\u201c\u6240\u6709\u5730\u70b9\u201d\u3002", "545f7869013e2c962d23ef8433b4c38a": "<strong>\u4e92\u8054\u7f51\u8fde\u63a5</strong>\uff1a\u5efa\u8bae\u4f7f\u7528\u4e0a\u4f20\u548c\u4e0b\u8f7d\u901f\u5ea6\u81f3\u5c11\u4e3a 10MBPS \u7684\u6709\u7ebf\u7f51\u7edc\u8fde\u63a5\u3002\u5728\u8fd9\u91cc\u6d4b\u8bd5\u60a8\u7684\u901f\u5ea6\u3002\u5982\u679c\u53ef\u80fd\u7684\u8bdd\uff0c\u907f\u514d\u4f7f\u7528 VPN\u3002", "7b7b23471af72ba7e60b673f4f9bd1c4": "\u5c06\u5730\u70b9\u548c\u5217\u8868\u4e0a\u4f20\u81f3\u60a8\u7684\u8d26\u6237", "8a90f20586501c2daf3efe166e68c011": "GFW Pro \u7528\u6237\u6559\u7a0b", "c303526c64f25aecb8ecef60ab0ed12b": "\u89c2\u770b\u897f\u73ed\u7259\u8bed\u7248\u89c6\u9891\u3002", "423724154ec352d6bbe37fe577c42dc1": "\u8981\u6539\u53d8\u6d3b\u52a8\u7528\u6237\u7684\u8bbf\u95ee\u6743\u9650\u7ea7\u522b\uff0c\u8bf7\u70b9\u51fb\u8be5\u7528\u6237\u7684\u540d\u5b57\u4ee5\u52a0\u8f7d\u5176\u4e2a\u4eba\u8d44\u6599\u3002\u70b9\u51fb\u201c\u8bbf\u95ee\u6743\u9650\u7ea7\u522b\u201d\u4e0b\u62c9\u83dc\u5355\uff0c\u9009\u62e9\u9700\u8981\u7684\u8bbf\u95ee\u6743\u9650\u7ea7\u522b\u3002\u60a8\u5fc5\u987b\u6709\u7ba1\u7406\u5458\u8bbf\u95ee\u6743\u9650\u624d\u80fd\u5bf9\u5176\u4ed6\u7528\u6237\u7684\u8bbf\u95ee\u6743\u9650\u7ea7\u522b\u8fdb\u884c\u66f4\u6539\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u4e86\u89e3\u5982\u4f55\u5728 Pro \u4e0a\u67e5\u9605\u7528\u6237\u8bb8\u53ef\u6743\u9650\u7ea7\u522b\u3002", "cdef70ff9053eb76775f42886922f523": "CSV \u5c06\u5bfc\u51fa\u60a8\u7684\u539f\u59cb\u8f93\u5165\u6587\u4ef6\u7684 CSV \u7248\u672c\uff0c\u4e14\u8be5\u6587\u4ef6\u53ef\u4ee5\u88ab\u91cd\u65b0\u4e0a\u4f20\u5230 Pro\u3002", "b5b5563174b45b387326fa127b997b2e": "\u7528\u6237\u652f\u6301\u95ee\u9898\u5305\u62ec\u767b\u5f55\u60a8\u7684\u8d26\u6237\u3001\u5c06\u5730\u70b9\u548c\u5217\u8868\u4e0a\u4f20\u5230\u60a8\u7684\u8d26\u6237\u3001\u7ba1\u7406\u60a8\u7684\u8d26\u6237\u3001\u4f7f\u7528\u4eea\u8868\u677f\u548c\u7406\u89e3\u6570\u636e\u3002", "03d31e2502d7a9900c4c3e24064bd923": "<strong>\u8f93\u5165\u5730\u5740</strong>\uff1a\u8f93\u5165\u8857\u9053\u5730\u5740\u3002", "3f6c0b28c8af5f67de1c6471916696e9": "\u53ef\u53ef\u4e00\u822c\u5730\u70b9", "d9cb397c34ad99d2bdc1a00ce00164a7": "\u53c2\u8003\u672c<a href=\"{{0}}\">\u6559\u7a0b</a>\u4e2d\u5bf9\u4e0d\u540c\u6a21\u677f\u7c7b\u578b\u7684\u63cf\u8ff0\uff0c\u4ee5\u786e\u5b9a\u9002\u5408\u60a8\u7684\u6a21\u677f\u7684\u5927\u5b97\u5546\u54c1\u7c7b\u578b\u548c\u5730\u70b9\u5206\u7c7b\u3002", "d6a7ea138cb96008a46aefb1c5f40610": "\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u4e0b\u8f7d\u201d\uff0c\u4f1a\u63d0\u4f9b\u7ed9\u60a8\u201c\u7ed3\u679c\u201d\u3001\u201cCSV\u201d\u548c\u201c\u5f62\u72b6\u6587\u4ef6\u201d\u683c\u5f0f\u3002\u9009\u62e9\u60a8\u559c\u6b22\u7684\u683c\u5f0f\u542f\u52a8\u4e0b\u8f7d\u3002\u5982\u679c\u5217\u8868\u6700\u521d\u662f\u4ee5\u5f62\u72b6\u6587\u4ef6\u683c\u5f0f\u4e0a\u4f20\u7684\uff0c\u5efa\u8bae\u5c06\u8be5\u5217\u8868\u5bfc\u51fa\u4e3a\u5f62\u72b6\u6587\u4ef6\u683c\u5f0f\u3002\u5982\u679c\u4e0a\u4f20\u7684\u662f\u5f62\u72b6\u6587\u4ef6\uff0c\u4e4b\u540e\u5374\u4ee5 CSV \u683c\u5f0f\u5bfc\u51fa\uff0c\u5219\u5206\u6790\u7ed3\u679c\u53ef\u80fd\u6709\u6240\u4e0d\u540c\u3002", "cdb5aba659a4a96b9f657a83040ecb6b": "GFW Pro (Pro) \u63d0\u4f9b\u4e24\u7c7b\u5206\u6790\uff1a\u68ee\u6797\u53d8\u5316\u548c\u5927\u5b97\u5546\u54c1\u98ce\u9669\u3002", "41b7b6f3687eecf93fb840f5384a632d": "\u70b9\u51fb\u201c\u653e\u5f03\u6570\u636e\u201d\u4ee5\u6e05\u9664\u5206\u6790\u5e76\u91cd\u65b0\u5f00\u59cb\u3002", "2a900bd408651220c267fb49d0a63d40": "\u7531\u4e8e\u4f7f\u7528\u9650\u5236\uff0cGFW\u7684\u201c\u4fdd\u62a4\u533a\"\u548c\"RSPO \u68d5\u6988\u7279\u8bb8\u6797\u533a\u201d\u5217\u8868\u548c\u5b50\u5217\u8868\u65e0\u6cd5\u4e0b\u8f7d\u3002\u201c\u884c\u653f\u533a\u57df\u201d\u5217\u8868\u5fc5\u987b\u7ecf\u7b5b\u9009\u5e76\u7f16\u8f91\u6210\u4e00\u4e2a\u65b0\u5217\u8868\u540e\u624d\u80fd\u4e0b\u8f7d\u3002", "a4a0e6734ca04e3556ae930ce23b09cd": "\u4f5c\u4e3a\u7ba1\u7406\u5458\uff0c\u60a8\u53ef\u4ee5\u5728 Pro \u4e0a\u8fdb\u884c\u4e0b\u5217\u64cd\u4f5c\u3002", "6f024cafa5c3bd69bd00116c7bcf70cc": "\u5f62\u72b6\u6587\u4ef6\u6a21\u677f\u53ef\u4ece\u5730\u70b9\u7f51\u9875\u4e0a\u4e0b\u8f7d\u3002\u70b9\u51fb\u201c\u5730\u70b9\u6a21\u677f\u201d\u4e0b\u9762\u7684\u7c7b\u578b\u4e0b\u62c9\u83dc\u5355\u3002\u9009\u62e9\u5e76\u4e0b\u8f7d\u4e0e\u60a8\u7684\u6570\u636e\u76f8\u5339\u914d\u7684\u6a21\u677f\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u4e86\u89e3\u5982\u4f55\u9009\u62e9\u6b63\u786e\u7684\u6a21\u677f\u3002", "6313fccc19ccd8cb4716bc22c27a93db": "\u5982\u679c\u60a8\u9700\u8981\u7f16\u8f91 KML/KMZ \u6587\u4ef6\u7684\u5c5e\u6027\uff0c\u4e00\u4e2a\u9009\u62e9\u662f\u5728 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Notepad ++</a> \u4e2d\u7f16\u8f91\u4ee3\u7801\u3002KML/KMZ\u6587\u4ef6\u662f\u57fa\u4e8e XML \u6807\u51c6\u7684\u3002\u5173\u4e8e\u7f16\u8f91\u8fd9\u4e9b\u6587\u4ef6\u7684\u66f4\u591a\u4fe1\u606f\u53ef\u4ee5<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5728\u6b64</a>\u627e\u5230\u3002", "787d190d1eb565d94fffedbad303d3f3": "\u82e5\u8981\u51c6\u5907 KML/KMZ \u6587\u4ef6\uff0c\u8bf7\u9075\u5faa\u4ee5\u4e0b\u56db\u6b65\u3002", "09806742ff719f9e86830dba60d2b6ec": "\u9009\u5b9a\u7684\u8b66\u62a5\u5c06\u5728\u5730\u70b9\u8b66\u62a5\u5730\u56fe\u4e0a\u53ef\u89c1\u3002\u5706\u5708\u5927\u5c0f\u8868\u793a\u6bcf\u4e2a\u533a\u57df\u76f8\u5bf9\u4e8e\u5217\u8868\u5176\u4ed6\u533a\u57df\u6709\u591a\u5c11\u4e2a\u5730\u70b9\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5728\u5217\u8868\u7684 100 \u4e2a\u5730\u70b9\u4e2d\uff0c\u6709 30 \u4e2a\u5730\u70b9\u4f4d\u4e8e\u5df4\u897f\uff0c\u90a3\u4e48\u5df4\u897f\u7684\u5706\u5708\u5c06\u662f\u56db\u4e2a\u5706\u5708\u4e2d\u7b2c\u4e8c\u5927\u7684\u90a3\u4e2a\u3002\u5c06\u9f20\u6807\u60ac\u505c\u5728\u5730\u56fe\u4e0b\u65b9\u7684\u952e\u4e0a\uff0c\u53ef\u4ee5\u67e5\u770b\u4e0e\u5706\u5708\u5927\u5c0f\u76f8\u5bf9\u5e94\u7684\u5217\u8868\u5730\u70b9\u6240\u5360\u767e\u5206\u6bd4\u3002", "14e4b6eaac2c319638cefd577d7a5fe8": "\u9009\u62e9\u4e00\u4e2a\u8981\u5206\u6790\u7684\u56fd\u5bb6\u3002", "34a7e18b984017ca0667cb1d9f100a39": "Pro \u5c06\u5bf9\u60a8\u4e0a\u4f20\u6a21\u677f\u7684\u6bcf\u4e00\u5217\u8fdb\u884c\u521d\u6b65\u68c0\u67e5\uff0c\u4ee5\u786e\u4fdd\u5b83\u7b26\u5408\u7cfb\u7edf\u8981\u6c42\u3002\u5982\u679c\u51fa\u73b0\u9519\u8bef\uff0cPro \u5c06\u663e\u793a\u4e00\u6761\u4fe1\u606f\u3002\u4e00\u4e9b\u9519\u8bef\u9700\u8981\u60a8\u4fee\u590d\u539f\u59cb\u6a21\u677f\u6587\u4ef6\uff0c\u5e76\u6309\u7167\u524d\u9762\u7684\u6b65\u9aa4\u91cd\u65b0\u4e0a\u4f20\uff0c\u5176\u4ed6\u9519\u8bef\u5219\u53ef\u4ee5\u76f4\u63a5\u5728 Pro \u4e0a\u4fee\u590d\u3002", "648072e71434ce9cf6de6fc0ebd1664d": "\u60a8\u53ef\u4ee5<a href=\"{{0}}\">\u5728\u6b64</a>\u83b7\u53d6\u5173\u4e8e\u5982\u4f55\u586b\u5199\u60a8\u6240\u9009\u6a21\u677f\u7684\u8be6\u7ec6\u8bf4\u660e\u3002", "43ff3c392c296e921bdd1495a3972823": "\u70b9\u51fb\u201c\u663e\u793a\u5217\u8868\u201d\uff0c\u9009\u62e9\u60a8\u8981\u67e5\u770b\u7684\u5217\u8868\u3002", "2fef24a2bf12b06a8841b025a9fb3335": "\u68c0\u67e5\u5f62\u72b6\u6587\u4ef6\u7684\u4f4d\u7f6e", "9c0bba75db2c8e8bb43a666f3e285417": "\u70b9\u51fb\u60a8\u8981\u67e5\u770b\u7684\u57fa\u56fe\u4ee5\u6fc0\u6d3b\u5b83\u3002", "f4ad062390f59828b27be6b84faec0c0": "\u4fee\u590d\u51e0\u4f55\u9519\u8bef", "9926d53594c08bd92a29826080897137": "\u5f62\u72b6\u6587\u4ef6\u4f1a\u628a\u6240\u6709\u5c5e\u6027\u5b57\u6bb5\u540d\u622a\u65ad\u4e3a 10 \u4e2a\u5b57\u7b26\uff0c\u5e76\u4ee5\u4e0b\u5212\u7ebf\u66ff\u6362\u7a7a\u683c\u3002<a rel=\"noreferrer noopener\" href=\"{{0}}\" target=\"_blank\">\u5728\u6b64</a>\u67e5\u9605\u6240\u6709\u5c5e\u6027\u5b57\u6bb5\u540d\u7684\u9650\u5236\u3002", "373d961c8c09a2559e5023f60fe8482e": "<strong>\u5b63\u5ea6</strong>\uff1a\u663e\u793a\u8fc7\u53bb\u4e09\u4e2a\u6708\u7684\u8b66\u62a5\u3002\u5b63\u5ea6\u8b66\u62a5\u6bcf\u4e2a\u6708\u66f4\u65b0\u3002", "45d6d2347e695da0e349c74acadcbb1d": "\u5982\u679c\u60a8\u8981\u4e0a\u4f20\u5355\u4e2a\u5730\u70b9\uff0c\u53ef\u4ee5\u5728\u5730\u70b9\u4fa7\u8fb9\u680f\u7684\u591a\u8fb9\u5f62\u6216\u5706\u70b9\u4e0a\u70b9\u51fb\u53f3\u952e\uff0c\u9009\u62e9\u201c\u53e6\u5b58\u4e3a\u2026\u2026\u201d\u6765\u521b\u5efa\u4e00\u4e2a\u65b0\u7684 KML/KMZ \u6587\u4ef6\u3002", "43549b7802e24932f870135d175b00fe": "\u5927\u8c46\u519c\u573a", "dbb38f34b1c2ce4ded417208487c9f40": "\u5ba1\u6838 KML/KMZ \u6587\u4ef6\u683c\u5f0f", "775c568b4f6f3d794946f90658bb0b74": "\u505c\u7528\u7528\u6237\u548c\u60a8\u7684\u8d26\u6237", "8bf42e16c424795c303b609bce29ee12": "\u8bca\u65ad\u7f51\u9875\u5c06\u52a0\u8f7d\u3002", "dea852b1d5e7aaf641f7abd15a403d7d": "\u5de6\u4e0b\u89d2\u7684\u641c\u7d22\u56fe\u6807\u5141\u8bb8\u60a8\u6309\u5730\u5740\u3001\u5730\u70b9\u3001\u5750\u6807\u6216\u5341\u8fdb\u5236\u5ea6\u6570\u8fdb\u884c\u641c\u7d22\u3002\u60a8\u8fd8\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u641c\u7d22\u680f\u5de6\u8fb9\u7684\u7bad\u5934\u56fe\u6807\uff0c\u5728\u7279\u5b9a\u7684\u5217\u8868\u4e2d\u8fdb\u884c\u641c\u7d22\uff08\u4f8b\u5982\uff0c\u901a\u7528\u78e8\u574a\u5217\u8868\uff09\u3002", "01b1192c85dcb1322796e93c1070f512": "\u5173\u8054\u6bcd\u516c\u53f8\u548c\u5b50\u516c\u53f8\u3002", "efb3fa279900a055a2bae32a25275556": "\u901a\u8fc7\u4f7f\u7528\u201c\u8bca\u65ad\u201d\u65c1\u8fb9\u7684\u4e0b\u62c9\u83dc\u5355\uff0c\u8c03\u7528\u68ee\u6797\u53d8\u5316\u8bca\u65ad\u529f\u80fd\u3002", "8dc2af4edff1184362c163df2b26faac": "\u9075\u5faa GFW Pro \u6a21\u677f", "a5efb9994c0df958b7cab429301a0f00": "\u201c\u8b66\u62a5\u201d\u7edf\u8ba1\u60a8\u5217\u8868\u4e2d\u7684\u5730\u70b9\u6240\u51fa\u73b0\u7684\u8b66\u62a5\u6570\u91cf\u3002", "c25dc1ca6f9ec9299675093f7cac183a": "\u5728\u60a8\u60f3\u7f16\u8f91\u7684\u5b57\u6bb5\u4e0a\u70b9\u51fb\u53f3\u952e\uff0c\u4ece\u9009\u9879\u4e2d\u9009\u62e9\u201c\u5b57\u6bb5\u8ba1\u7b97\u5668\u201d\uff0c\u6253\u5f00\u5b57\u6bb5\u8ba1\u7b97\u5668\u3002\u60a8\u60f3\u8f93\u5165\u7684\u4efb\u4f55\u6570\u503c\u90fd\u53ef\u4ee5\u6dfb\u52a0\u5230\u65b0\u7f51\u9875\u5e95\u90e8\u7684\u6587\u672c\u6846\u4e2d\u3002\u4f60\u5c06\u6709\u4e09\u4e2a\u9009\u9879\u4f9b\u8f93\u5165\u6570\u503c\u3002", "98f2fe9aab7cbe6d5e28bd4c1b777598": "<strong>\u7ed8\u5236\u5f62\u72b6</strong>\uff1a\u5728\u5730\u56fe\u4e0a\u7ed8\u5236\u533a\u57df\u7684\u8f6e\u5ed3\u3002\u70b9\u51fb\u201c\u5f00\u59cb\u7ed8\u5236\u201d\u4ee5\u5f00\u59cb\uff0c\u901a\u8fc7\u70b9\u51fb\u5730\u56fe\u5e03\u7f6e\u5706\u70b9\u6765\u5b9a\u4e49\u60a8\u611f\u5174\u8da3\u7684\u533a\u57df\u3002\u60a8\u9700\u8981\u8fd4\u56de\u5230\u60a8\u653e\u7f6e\u7684\u7b2c\u4e00\u4e2a\u5706\u70b9\u5e76\u70b9\u51fb\u5b83\u6765\u5c01\u95ed\u8be5\u5f62\u72b6\u3002", "3f1ea5bd137fe087bb93d3b3809a630f": "\u5206\u6790\u5927\u5b97\u5546\u54c1\u98ce\u9669", "0a771e6fad72df398d7238361443a27d": "<strong>RSPO \u68d5\u6988\u6cb9\u7279\u8bb8\u6797\u533a</strong>\uff1a\u7531<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u53ef\u6301\u7eed\u68d5\u6988\u6cb9\u5706\u684c\u4f1a\u8bae</a> (RSPO) \u8ba4\u8bc1\u7684\u68d5\u6988\u6cb9\u7279\u8bb8\u6797\u5730\u3002\u7531\u4e8e\u4f7f\u7528\u9650\u5236\uff0cRSPO \u7279\u8bb8\u6797\u5730\u4e0d\u80fd\u5728 Pro \u4e4b\u5916\u4e0b\u8f7d\u3002", "f964c78f8720ef74064afb6953cd85dc": "\u63a5\u4e0b\u6765\uff0c\u5728\u6587\u4ef6\u8d44\u6e90\u7ba1\u7406\u5668\u4e2d\u5bfc\u822a\u5230\u60a8\u7684\u6570\u636e\uff0c\u5e76\u6267\u884c\u4ee5\u4e0b\u4e24\u4e2a\u6b65\u9aa4\u3002", "86fc7ee20f53b4afd05fb7dbd5a6d2f0": "\u201c\u533a\u57df\u548c\u56fd\u5bb6\u6570\u636e\u201d\u7c7b\u522b\u63d0\u4f9b\u4e86\u7279\u5b9a\u56fd\u5bb6\u548c\u533a\u57df\u5bf9\u5e94\u7684\u6570\u636e\u5c42\u3002\u60a8\u53ef\u4ee5\u4f7f\u7528\u8be5\u7c7b\u522b\u4e2d\u7684\u641c\u7d22\u5de5\u5177\u6765\u641c\u7d22\u60a8\u611f\u5174\u8da3\u7684\u56fd\u5bb6\u3002", "3f14a51951ff45eb0e2f2b9c9182de55": "\u70b9\u51fb\u9876\u90e8\u83dc\u5355\u4e0a\u7684\u201c\u5730\u70b9\u201d\u6807\u7b7e\u3002\u5411\u4e0b\u6eda\u52a8\u81f3\u201c\u6211\u7684\u5217\u8868\u201d\uff0c\u9009\u62e9\u60a8\u60f3\u5206\u4eab\u7684\u5217\u8868\u3002", "ebbdaba4c22a4768130501cc81a14f2c": "\u5728\u5dde\u7701\u4e00\u7ea7\uff0c\u6bcf\u4e2a\u89e6\u53d1\u8b66\u62a5\u7684\u5e02\u53bf\u90fd\u4f1a\u51fa\u73b0\u4e00\u4e2a\u5706\u5708\u3002", "57f2673f8b5f5c301994240a96da4561": "GFW Pro (Pro) \u5730\u56fe\u5141\u8bb8\u60a8\u5bf9\u4e0a\u4f20\u6570\u636e\u4e0e GFW \u6570\u636e\u4e00\u8d77\u8fdb\u884c\u53ef\u89c6\u5316\u548c\u5206\u6790\u5904\u7406\u3002\u4ee5\u4e0b\u6b65\u9aa4\u5c06\u6307\u5bfc\u60a8\u5982\u4f55\u67e5\u770b\u4e0a\u4f20\u7684\u5217\u8868\u3001\u6dfb\u52a0\u548c\u79fb\u9664\u6570\u636e\u5c42\u3001\u67e5\u770b\u4e0d\u540c\u7684\u57fa\u56fe\u3001\u5206\u6790\u67d0\u4e2a\u533a\u57df\u5185\u7684\u6570\u636e\uff0c\u4ee5\u53ca\u8c03\u6574\u5730\u56fe\u548c\u6570\u636e\u8bbe\u7f6e\u3002", "bab3955819249249448ba5f2617ddf5b": "\u8be5\u8868\u683c\u9ed8\u8ba4\u663e\u793a\u6709\u5173\u5730\u70b9\u5927\u5c0f\u3001\u5927\u5b97\u5546\u54c1\u7c7b\u578b\u3001\u5730\u7406\u4f4d\u7f6e\u548c\u60a8\u7684\u5730\u70b9\u5185\u7684\u6811\u6728\u8986\u76d6\u7387\u7684\u4fe1\u606f\u3002\u5728\u6700\u53f3\u8fb9\uff0c\u8be5\u8868\u683c\u8fd8\u5c06\u663e\u793a\u6709\u5173\u6811\u6728\u8986\u76d6\u7387\u635f\u5931\u7684\u4fe1\u606f\u2014\u2014\u60a8\u5c06\u770b\u52302000\u5e74\u540e\u6811\u6728\u8986\u76d6\u7387\u635f\u5931\u7684\u603b\u91cf\uff0c\u7136\u540e\u662f\u53d1\u751f\u5728\u4fdd\u62a4\u533a\u548c\u539f\u59cb\u6797\u7684\u6811\u6728\u8986\u76d6\u7387\u635f\u5931\u7684\u6570\u91cf\u3002", "7973fe2864fef58bad0449a857afc34d": "\u5982\u679c\u60a8\u8981\u4e0a\u4f20\u591a\u4e2a\u5730\u70b9\uff0c\u901a\u8fc7\u70b9\u51fb\u6570\u636e\u4e2d\u7684\u4efb\u4f55\u4e00\u4e2a\u5730\u70b9\uff0c\u68c0\u67e5\u60a8\u7684\u6570\u636e\u662f\u5426\u9075\u5faa\u5fc5\u8981\u6a21\u677f\u3002\u6b64\u65f6\u4f1a\u51fa\u73b0\u4e00\u4e2a\u4fe1\u606f\u6c14\u6ce1\uff0c\u5217\u51fa\u6570\u636e\u7684\u5c5e\u6027\u3002KML/KMZ\u6587\u4ef6\u4e0a\u4f20\u51c6\u5907\u5de5\u4f5c\u6307\u5357\u8bf7\u53c2\u89c1<a href=\"{{0}}\">\u6b64\u5904</a>\u3002", "faa3c1048669e1046d2a066c542fa97a": "\u8981\u4f7f\u7528 GFW Pro (Pro)\uff0c\u60a8\u9996\u5148\u9700\u8981\u521b\u5efa\u4e00\u4e2a\u8d26\u6237\u3002\u4ee5\u4e0b\u6b65\u9aa4\u5c06\u6307\u5bfc\u60a8\u5982\u4f55\u521b\u5efa\u4e00\u4e2a\u65b0\u8d26\u6237\uff0c\u4ee5\u53ca\u5982\u4f55\u7ba1\u7406\u4e00\u4e2a\u73b0\u6709\u8d26\u6237\u3002", "1eb985d1875304218cc6da9f1235f557": "\u4f7f\u7528\u7528\u6237\u4e2a\u4eba\u8d44\u6599\u4e0a\u7684\u8bbf\u95ee\u6743\u9650\u7ea7\u522b\u4e0b\u62c9\u83dc\u5355\uff0c\u66f4\u6539\u7528\u6237\u7684\u8bbf\u95ee\u6743\u9650\u7ea7\u522b\u3002", "316f5b6291649dc769a8ea15ffa9b96a": "\u8981\u4fee\u590d ArcGIS \u4e0a\u7684\u51e0\u4f55\u9519\u8bef\uff0c\u8bf7\u91c7\u53d6\u4ee5\u4e0b\u4e24\u4e2a\u6b65\u9aa4\u3002", "8fb6cbb8eb742981f2feb65584a5f625": "\u7ba1\u7406 GFW \u5217\u8868", "a00043485e8972a24d2ff48f4f185b57": "\u60a8\u5c06\u53ef\u4ee5\u9009\u62e9\u4e3a\u5730\u70b9\u6dfb\u52a0\u989d\u5916\u7684\u5c5e\u6027\u3002\u4ec5\u5f53\u60a8\u7684\u6a21\u677f\u6709\u8fd9\u4e9b\u4fe1\u606f\u65f6\uff0c\u624d\u586b\u5199\u8fd9\u4e9b\u5b57\u6bb5\u2014\u2014\u6240\u6709\u4fe1\u606f\u5fc5\u987b\u4e0e\u6a21\u677f\u5b8c\u5168\u5339\u914d\u3002\u4e00\u65e6\u586b\u5199\u5b8c\u6210\uff0c\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\u3002", "e933e6900b0eb997a7c5d66013b919ad": "\u4e0a\u4f20\u5230 Pro \u7684\u5f62\u72b6\u6587\u4ef6\u5fc5\u987b\u5177\u6709\u70b9\u51e0\u4f55\u4f53\u6216\u591a\u8fb9\u5f62\u51e0\u4f55\u4f53\u3002\u4e00\u4e2a\u70b9\u5f62\u72b6\u6587\u4ef6\u4ee3\u8868\u4e00\u4e2a\u6709\u7ecf\u7eac\u5ea6\u503c\u7684\u786e\u5207\u5730\u70b9\u3002\u591a\u8fb9\u5f62\u5f62\u72b6\u6587\u4ef6\u4ee3\u8868\u4e00\u4e2a\u6709\u9762\u79ef\u6216\u5f62\u72b6\u7684\u5730\u70b9\u3002\u5305\u542b\u7ebf\u51e0\u4f55\u4f53\u7684\u5f62\u72b6\u6587\u4ef6\u5fc5\u987b\u5148\u8f6c\u6362\u4e3a\u591a\u8fb9\u5f62\uff0c\u7136\u540e\u518d\u4e0a\u4f20\u5230 Pro\u3002", "df9b3e5710cb46540a21edece6e46099": "\u5728\u5185\u90e8\u4e0e\u60a8\u8d26\u6237\u4e2d\u7684\u5176\u4ed6\u7528\u6237\u5206\u4eab\u5217\u8868\u3002", "0686ce790fa24c7862a108dd9d9dfe43": "\u63a2\u7d22\u8fd1\u671f\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u8b66\u62a5", "f329d579bb16759f358387ee7d79a6fe": "<strong>\u884c\u653f\u533a\u57df</strong>\uff1a\u4e0d\u52a8\u4ea7\u6216\u4f9b\u5e94\u533a\u57df\u4ee5\u5916\u7684\u533a\u57df\uff08\u4f8b\u5982\u56fd\u5bb6\u3001\u5dde\u7701\u6216\u5e02\u53bf\uff09\u3002", "5f7077bc90ca0ee1c4809ee342672ee3": "\u6d4f\u89c8\u4e0d\u540c\u7684\u5927\u5b97\u5546\u54c1\u6a21\u677f\u7c7b\u578b", "e06fe5280d9af927cdd7da93588345b2": "\u5982\u679c\u60a8\u8981\u4e0a\u4f20\u542b\u6709\u591a\u4e2a\u5730\u70b9\u7684 KML/KMZ \u6587\u4ef6\uff0c\u786e\u4fdd\u5b83\u9075\u5faa\u9002\u5f53\u7684\u6a21\u677f\u3002\u5982\u82e5\u4e0d\u7136\uff0c\u60a8\u9700\u8981\u7f16\u8f91 KML/KMZ \u5c5e\u6027\u8868\u3002Google Earth \u5e76\u975e\u771f\u6b63\u7684\u5730\u7406\u4fe1\u606f\u7cfb\u7edf (GIS)\uff0c\u5b83\u68d2\u521b\u5efa\u548c\u7f16\u8f91\u8868\u683c\u3002\u8981\u505a\u5230\u8fd9\u4e00\u70b9\uff0c\u60a8\u53ef\u4ee5\u5728 <a rel=\"noreferrer noopener\" href=\"{{0}}\" target=\"_blank\">Notepad++</a> \u8fd9\u6837\u7684\u6587\u672c\u7f16\u8f91\u5668\u4e2d\u6253\u5f00 KML/KMZ\uff0c\u624b\u52a8\u7f16\u8f91\u4ee3\u7801\uff0c\u6216\u8005\u4f7f\u7528 GIS \u8f6f\u4ef6\u3002KML/KMZ \u6587\u4ef6\u53ef\u4ee5\u76f4\u63a5\u5728 QGIS \u4e2d\u6253\u5f00\uff0c\u5e76\u5bfc\u51fa\u5230\u5f62\u72b6\u6587\u4ef6\u4e2d\u8fdb\u884c\u7f16\u8f91\u3002\u60a8\u53ef\u4ee5<a href=\"{{1}}\">\u5728\u6b64</a>\u627e\u5230\u66f4\u591a\u5173\u4e8e\u5f62\u72b6\u6587\u4ef6\u4e0a\u4f20\u51c6\u5907\u5de5\u4f5c\u7684\u4fe1\u606f\u3002", "ef6d0df97150c189bdfcb9db0f6dc6c7": "\u9875\u9762\u5176\u4f59\u90e8\u5206\u5c06\u663e\u793a\u4e0e\u60a8\u7684\u5730\u70b9\u7684\u5927\u5b97\u5546\u54c1\u98ce\u9669\u6709\u5173\u7684\u6570\u636e\u56fe\u8868\u548c\u5206\u6790\u3002\u60a8\u662f\u5bf9\u6240\u6709\u5730\u70b9\u8fd8\u662f\u5bf9\u5355\u4e00\u5730\u70b9\u8fdb\u884c\u8bca\u65ad\uff0c\u76f8\u5e94\u5730\u63d0\u4f9b\u4e0d\u540c\u7684\u4fe1\u606f\u3002", "fa07ad634222872552ea6e5d1c43e996": "\u5220\u9664\u5217\u8868\u4e2d\u7684\u5730\u70b9", "b7e7ae09869f3fe15b0f73ae8f90458e": "\u5728\u5730\u70b9\u7f51\u9875\u4e0a\u67e5\u770b\u4e0e\u60a8\u5171\u4eab\u7684\u5217\u8868\u3002\u5217\u8868\u540d\u79f0\u53f3\u8fb9\u4f1a\u6709\u4e00\u4e2a\u5171\u4eab\u56fe\u6807\u3002", "e1c85e4cb5ae1eaa393433c410a7881b": "\u60a8\u4f4d\u7f6e\u4e2d\u7684\u9519\u8bef\u5c06\u4ee5\u7ea2\u8272\u611f\u53f9\u53f7\u6807\u793a\u3002", "de4ba34f16a72a4236685cd30d6cf7d7": " \u201cGFW Pro \u4e0a\u7684\u8fd1\u5b9e\u65f6\u76d1\u6d4b\u529f\u80fd\u201d\u89c6\u9891\u6307\u5357\u5236\u4f5c\u4e8e 2020 \u5e74 7 \u6708\uff0c\u76ee\u7684\u662f\u6f14\u793a\u5982\u4f55\u5728 GFW Pro \u4e0a\u4f7f\u7528\u8b66\u62a5\u6570\u636e\u5b9e\u73b0\u8fd1\u5b9e\u65f6\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u76d1\u6d4b\u3002\u8be5\u89c6\u9891\u6709\u82f1\u8bed\u3001\u897f\u73ed\u7259\u8bed\u548c\u5370\u5c3c\u8bed\u7248\u672c\u3002", "cfeeca83a8eb083efe793a7a2da5e035": "\u60a8\u5c06\u6536\u5230\u4e00\u5c01\u7535\u5b50\u90ae\u4ef6\uff0c\u901a\u77e5\u60a8\u5df2\u6839\u636e\u60a8\u5730\u70b9\u548c\u5217\u8868\u4e0a\u7684\u6700\u65b0\u53ef\u7528\u6570\u636e\u5f00\u59cb\u6267\u884c\u5206\u6790\u3002\u5728\u5206\u6790\u8fc7\u7a0b\u4e2d\uff0c\u60a8\u7684\u5217\u8868\u5c06\u4e0d\u53ef\u7528\u3002", "ea6380b1cc337a4104593ab8b86e8313": "\u60a8\u6240\u9009\u5217\u8868\u4e2d\u7684\u5730\u70b9\u5c06\u51fa\u73b0\u5728\u5730\u70b9\u8b66\u62a5\u5730\u56fe\u4e0a\u3002", "d298cd0fe9094bda3860042773736b85": "\u70b9\u51fb\u201c\u5730\u70b9\u201d\u4ee5\u67e5\u770b\u548c\u7ba1\u7406\u5730\u70b9\u5217\u8868\u3002", "a9c59788acd4bafef500c533b79e3f44": "<strong>\u6cb9\u68d5\u79cd\u690d\u56ed</strong>\uff1a\u5efa\u8bae\u7528\u4e8e\u6cb9\u68d5\u7279\u8bb8\u6797\u533a\u548c\u79cd\u690d\u56ed\u3002", "f8339e32e3b0702f84259b4f51e318c7": "\u70b9\u51fb\u201c\u4e2a\u4eba\u8d44\u6599\u201d\u6807\u7b7e\u3002\u4f5c\u4e3a\u7ba1\u7406\u5458\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u7528\u6237\u5217\u8868\u4e0a\u65b9\u7684\u201c\u67e5\u770b\u6d3b\u52a8\u65e5\u5fd7\u201d\u6765\u67e5\u770b\u60a8\u8d26\u6237\u4e2d\u6240\u6709\u6d3b\u52a8\u7684\u8bb0\u5f55\u3002", "9f86a1cd6adf70f8d3defc2611d207eb": "\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u7f16\u8f91\u201d\u56fe\u6807\u3002", "1655116870568a692abee9973f347670": "\u8c03\u6574\u65f6\u95f4\u6ed1\u5757\u4ee5\u7f29\u7a84\u5730\u56fe\u4e0a\u53ef\u89c6\u5316\u7684\u6570\u636e\uff0c\u4ee5\u53ca\u60a8\u7684\u5206\u6790\u6240\u6db5\u76d6\u7684\u5e74\u4efd\u3002\u62d6\u653e\u65f6\u95f4\u6ed1\u5757\u7684\u4e24\u7aef\uff0c\u76f4\u5230\u5b83\u4eec\u88ab\u8bbe\u7f6e\u4e3a\u60a8\u60f3\u67e5\u770b\u7684\u65e5\u671f\u8303\u56f4\u3002", "8c2e146475d1d606d0ad2649fc197254": "\u63a2\u7d22\u603b\u7ed3 {adm2}\u3001{adm1}\u3001{location} \u7684\u68ee\u6797\u8986\u76d6\u7a0b\u5ea6\u7684\u4e92\u52a8\u56fe\u8868\u548c\u5730\u56fe\u3002\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u68ee\u6797\u8986\u76d6\u7684\u7c7b\u578b\u2014\u2014\u53ef\u4ee5\u5b9a\u5236\u4e14\u6613\u4e8e\u5206\u4eab\u548c\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "e06eeef1498c64bc9f54b561f7505f3d": "\u7533\u8bf7\u8d26\u6237", "4527b58014a304629fd32fa4c9c64d5c": "\u5411\u4e0b\u6eda\u52a8\u4ee5\u6d4f\u89c8\u5176\u4ed6\u6570\u636e\u56fe\u8868\u3002", "943af9aec10da006249465197d5fdc1d": "\u60a8\u53ef\u4ee5\u901a\u8fc7\u8f93\u5165\u6570\u5b57\u6765\u8f93\u5165\u6570\u503c\u3002", "e859a826702d2792a4c54946d38fc882": "<strong>\u8bca\u65ad</strong>\uff1a\u67e5\u770b\u5bf9\u60a8\u6240\u5217\u5730\u70b9\u7684\u68ee\u6797\u53d8\u5316\u8bca\u65ad\u3002\u68ee\u6797\u53d8\u5316\u5206\u6790\u663e\u793a\u60a8\u7684\u5730\u70b9\u4e2d\u53d1\u751f\u4e86\u6811\u6728\u8986\u76d6\u635f\u5931\u4e4b\u5904\uff0c\u5e76\u7a81\u51fa\u5f3a\u8c03\u5728\u68ee\u6797\u780d\u4f10\u653f\u7b56\u4e2d\u6700\u5e38\u63d0\u5230\u7684\u4e00\u4e9b\u654f\u611f\u68ee\u6797\u5730\u533a\u53d1\u751f\u7684\u635f\u5931\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u4e86\u89e3\u5982\u4f55\u67e5\u9605\u68ee\u6797\u53d8\u5316\u8bca\u65ad\u3002", "27a6300c6214e234000d435231e584af": "\u70b9\u51fb\u60a8\u5217\u8868\u4e2d\u7684\u4e00\u4e2a\u5f62\u72b6\uff0c\u7136\u540e\u70b9\u51fb\u201c\u5206\u6790\u201d\u4ee5\u6267\u884c\u5206\u6790\u3002", "2442eaaf02c8d7e7fb4c02412b3801e3": "\u6eda\u52a8\u5230\u201c\u4e2a\u4eba\u8d44\u6599\u201d\u7f51\u9875\u7684\u5e95\u90e8\uff0c\u70b9\u51fb\u201c\u65b0\u5efa\u201d\u3002", "4c7c3b50a1e413c707d2e485e390c2f2": "\u4e24\u4e2a\u5206\u6790\u89c6\u56fe\u2014\u2014\u68ee\u6797\u53d8\u5316\u548c\u5927\u5b97\u5546\u54c1\u98ce\u9669\u2014\u2014\u53ef\u4ee5\u901a\u8fc7\u4f7f\u7528\u8868\u683c\u4e0a\u65b9\u201c\u89c6\u56fe\u201d\u65c1\u8fb9\u7684\u4e0b\u62c9\u83dc\u5355\u6765\u9009\u62e9\u3002\u9009\u62e9\u201c\u5927\u5b97\u5546\u54c1\u98ce\u9669\u201d\u3002", "cd40cef42635202bc52ba57f60e111c1": "\u67e5\u770b\u3001\u6fc0\u6d3b\u548c\u505c\u7528\u60a8\u7684\u7ec4\u7ec7\u8d26\u6237\u4e2d\u7684\u7528\u6237\u3002", "33cc89bf65901bf5156bb1ac5834c75d": "\u70b9\u51fb\u201c\u6fc0\u6d3b\u201d\u3002", "d4dfd99a97f8c285017b99b9f7b0bd64": "\u755c\u7267\u573a", "01a569ddc6cf67ddec2a683f0a5f5956": "\u5fd8\u8bb0\u5bc6\u7801\uff1f", "93876de157f60d51c661db9505a21729": "\u67e5\u770b\u5e76\u7f16\u8f91\u60a8\u81ea\u5df1\u7684\u7528\u6237\u4fe1\u606f\u3002", "f3bd9d592cd7f8f3949726a11bdc4e88": "\u9605\u8bfb\u5173\u4e8e\u70ed\u5e26\u68ee\u6797\u635f\u5931\u7684\u6700\u65b0\u62a5\u544a", "d2db79313d175ecce5969408df24b9f9": "\u70b9\u51fb\u201c\u4e2a\u4eba\u8d44\u6599\u201d\u4ee5\u67e5\u770b\u548c\u7f16\u8f91\u60a8\u7684\u4e2a\u4eba\u8d44\u6599\u4fe1\u606f\u3002", "8cc347fd7ff611341949f56bfee69304": "\u4e00\u65e6\u60a8\u7684\u8d26\u6237\u88ab\u6279\u51c6\u5e76\u6fc0\u6d3b\uff0c\u60a8\u5c06\u6536\u5230\u4e00\u5c01\u5e26\u6709\u4e34\u65f6\u5bc6\u7801\u7684\u7535\u5b50\u90ae\u4ef6\u3002\u8bf7\u6309\u7167\u6307\u793a\u4ece\u4e3b\u9875\u767b\u5f55 Pro \u5e76\u91cd\u7f6e\u5bc6\u7801\u3002<strong>\u60a8\u5fc5\u987b\u5728\u4e34\u65f6\u5bc6\u7801\u5931\u6548\u524d\u4e09\u5929\u5185\u91cd\u7f6e\u5bc6\u7801\u3002</strong>\u5982\u679c\u60a8\u5df2\u7ecf\u5728 Pro \u4e0a\u521b\u5efa\u4e86\u4e00\u4e2a\u8d26\u6237\uff0c\u5e76\u4ee5\u76f8\u540c\u7684\u7535\u5b50\u90ae\u4ef6\u5730\u5740\u521b\u5efa\u53e6\u4e00\u4e2a\u65b0\u8d26\u6237\uff0c\u60a8\u5c06\u80fd\u591f\u5728\u767b\u5f55\u8fc7\u7a0b\u4e2d\u9009\u62e9\u4e00\u4e2a\u8d26\u6237\u8fdb\u884c\u8bbf\u95ee\u3002", "0983075e015fc4af603f7b5e6629701a": "\u7406\u89e3\u6570\u636e", "c4d24cfe75d7240a29cd7775dac1f6b8": "\u201cGFW Pro \u7b80\u4ecb\uff1a\u805a\u7126\u6cb9\u68d5\u201d\u89c6\u9891\u6307\u5357\u521b\u5efa\u4e8e 2020 \u5e74 7 \u6708\uff0c\u65e8\u5728\u6f14\u793a\u5982\u4f55\u4f7f\u7528 GFW Pro \u8fdb\u884c\u68d5\u6988\u6cb9\u4f9b\u5e94\u94fe\u76d1\u6d4b\u3002\u8be5\u89c6\u9891\u6709\u82f1\u8bed\u3001\u897f\u73ed\u7259\u8bed\u548c\u5370\u5c3c\u8bed\u7248\u672c\u3002", "ce2c73acdd00b63544d50c188af76c87": "\u70b9\u51fb\u5730\u56fe\u4e0b\u65b9\u53f3\u4e0a\u89d2\u7684\u201c\u62a5\u544a\u201d\u6765\u751f\u6210\u7f51\u9875\u7684\u53ef\u6253\u5370 PDF \u6587\u4ef6\u3002\u60a8\u4e5f\u53ef\u4ee5\u70b9\u51fb\u201c\u4e0b\u8f7d\u201d\u5c06\u7f51\u9875\u4e0a\u7684\u6240\u6709\u6570\u636e\u4e0b\u8f7d\u4e3a CSV \u6587\u4ef6\u3002", "9912d04b39188b1a8bbc13d3cc7a4f2b": "\u4f5c\u4e3a\u7ba1\u7406\u5458\uff0c\u60a8\u5c06\u5728\u4e2a\u4eba\u8d44\u6599\u9875\u9762\u9876\u90e8\u770b\u5230\u201c\u4e2a\u4eba\u8d44\u6599\u7ba1\u7406\u5668\u201d\u3002\u5728\u7b2c\u4e00\u90e8\u5206\uff0c\u60a8\u53ef\u4ee5\u67e5\u770b\u5173\u4e8e\u60a8\u7ec4\u7ec7\u7684\u8be6\u7ec6\u4fe1\u606f\u3002\u60a8\u53ef\u4ee5\u7f16\u8f91\u4efb\u4f55\u5b57\u6bb5\uff0c\u4f46\u7ec4\u7ec7\u540d\u79f0\u9664\u5916\uff0c\u56e0\u4e3a\u8be5\u5b57\u6bb5\u5df2\u88ab\u9501\u5b9a\u3002\u60a8\u8fd8\u53ef\u4ee5\u4ece\u60a8\u7684\u7ec4\u7ec7\u4e0a\u4f20\u4e00\u4efd\u653f\u7b56\u6587\u6863\u4ee5\u4fbf\u5728 Pro \u4e2d\u53c2\u8003\u3002", "01966c1f41c1b54e693920d5b824f7c8": "<strong>\u53ef\u53ef\u519c\u573a</strong>\uff1a\u5efa\u8bae\u7528\u4e8e\u4f9b\u5e94\u94fe\u5185\u7684\u53ef\u53ef\u519c\u573a\u5730\u70b9\u3002", "2a0e9d0b9803a1c8a2a383482cdcc400": "\u725b\u8089\u5c60\u5bb0\u573a", "1f664e87e0234451614d2d6e2aae998f": "\u5bf9\u4e8e\u4ee5\u4e0b\u6a21\u677f\uff0cPro \u4f1a\u81ea\u52a8\u5c06\u5730\u70b9\u5206\u7c7b\u586b\u4e9b\u4e3a\u201c\u4e0d\u52a8\u4ea7\u533a\u57df\u201d\u3002", "881be124086590dbfcd5efc98e465858": "\u70b9\u51fb\u201c\u4e2a\u4eba\u8d44\u6599\u201d\u6807\u7b7e\u3002\u4f5c\u4e3a\u7f16\u8f91\u6216\u89c2\u770b\u8005\uff0c\u60a8\u5c06\u80fd\u591f\u66f4\u6539\u4e2a\u4eba\u8d44\u6599\u7684\u7535\u8bdd\u53f7\u7801\u3001\u6807\u9898\u3001\u5173\u6ce8\u7684\u5730\u7406\u533a\u57df\u3001\u5173\u6ce8\u7684\u5927\u5b97\u5546\u54c1\u548c\u7b2c\u4e8c\u7ea7\u9a8c\u8bc1\u504f\u597d\u3002\u6240\u6709\u5176\u4ed6\u5b57\u6bb5\u90fd\u88ab\u9501\u5b9a\u3002", "e5b8bb177ff88f92875175bf397dc018": "\u786e\u4fdd <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Geometry Checker \u63d2\u4ef6</a>\u5df2\u7ecf\u5b89\u88c5\u5e76\u6fc0\u6d3b\u3002\u4ece\u83dc\u5355\u680f\u4e2d\u9009\u62e9\u201c\u63d2\u4ef6\u201d\uff0c\u7136\u540e\u9009\u62e9\u201c\u7ba1\u7406\u548c\u5b89\u88c5\u63d2\u4ef6\u201d\uff0c\u5e76\u5bfc\u822a\u5230\u201c\u5df2\u5b89\u88c5\u201d\u6807\u7b7e\u3002Geometry Checker \u662f\u4e00\u4e2a\u968f QGIS \u4e00\u8d77\u5b89\u88c5\u7684\u6838\u5fc3\u63d2\u4ef6\uff0c\u9ed8\u8ba4\u5904\u4e8e\u6253\u5f00\u72b6\u6001\u3002", "907dd6275540635540977f1aef03cbb8": "\u70b9\u51fb\u201c\u786e\u5b9a\u201d\u4ee5\u786e\u8ba4\u60a8\u5e0c\u671b\u5206\u4eab\u5217\u8868\u3002", "79b82b8232ac201abceef75ed9772903": "<strong>\u6d4f\u89c8\u5668\u517c\u5bb9\u6027</strong>\uff1aPro \u4e0e\u6700\u65b0\u4e24\u4e2a\u7248\u672c\u7684 Google Chrome\u3001Mozilla Firefox \u548c Microsoft Edge \u517c\u5bb9\u3002\u60a8\u5fc5\u987b\u4f7f\u7528\u8fd9\u4e9b\u6d4f\u89c8\u5668\u4e4b\u4e00\u6765\u8bbf\u95ee Pro\u3002", "27fbd5937107b6afa12dec09f02cd763": "\u7528\u6237\u652f\u6301\u95ee\u9898", "43fb9b7383a83a2110f8653214631226": "\u5728\u9009\u62e9\u5e76\u4e0b\u8f7d\u6a21\u677f\u540e\uff0c\u60a8\u9700\u8981\u5728 Excel \u4e0a\u5b8c\u6210\u6a21\u677f\uff0c\u7136\u540e\u518d\u4e0a\u4f20\u5230 GFW Pro (Pro)\u3002\u4ee5\u4e0b\u6b65\u9aa4\u6982\u8ff0\u4e86\u5982\u4f55\u6210\u529f\u5b8c\u6210\u4e00\u4e2a\u6a21\u677f\u3002", "face75f48de13f53bf006323ff35ac32": "<strong>\u884c\u653f\u533a\u57df</strong>\uff1a\u5168\u7403\u6240\u6709\u56fd\u5bb6\u3001\u5dde\u7701\u548c\u5e02\u53bf\u3002", "58701f55035acfdc18fdd6ecb1f0e051": "<strong>\u755c\u7267\u573a</strong>\uff1a\u5efa\u8bae\u7528\u4e8e\u4f9b\u5e94\u94fe\u5185\u7684\u755c\u7267\u573a\u5730\u3002", "b95c50c454dd967a29c6d0d6a2b04e2b": "\u5728\u4e0b\u62c9\u83dc\u5355\u4e2d\u9009\u62e9\u60a8\u60f3\u6dfb\u52a0\u5730\u70b9\u7684\u5217\u8868\uff0c\u6216\u65b0\u5efa\u4e00\u4e2a\u5217\u8868\u3002", "b43cc5cb7ae94d85adbe6a009bcd5dbc": "\u901a\u8fc7\u70b9\u51fb\u53ef\u7f16\u8f91\u7684\u5b57\u6bb5\u6765\u7f16\u8f91\u60a8\u9009\u62e9\u7684\u5730\u70b9\u3002", "43a8298cceaa286408671d8505cb31d3": "\u5728\u5730\u56fe\u4e0a\u8c03\u67e5\u60a8\u6240\u5728\u5730\u70b9\u7684\u8b66\u62a5\u60c5\u51b5", "1f008b966ce5e1dc43df315ddaea95fc": "\u8981\u68c0\u67e5 ArcGIS \u4e0a\u5f62\u72b6\u6587\u4ef6\u7684\u4f4d\u7f6e\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u8fdb\u884c\u3002", "bbdf8a09c891125ad50ef2248ae43f4d": "\u63a2\u7d22\u6309\u56fd\u5bb6\u7ed8\u5236\u7684\u4e92\u52a8\u5f0f\u5168\u7403\u6797\u6728\u8986\u76d6\u7387\u635f\u5931\u56fe\u8868\u3002\u5206\u6790\u5168\u7403\u68ee\u6797\u6570\u636e\u548c\u8d8b\u52bf\uff0c\u5305\u62ec\u571f\u5730\u5229\u7528\u53d8\u5316\u3001\u68ee\u6797\u780d\u4f10\u7387\u548c\u68ee\u6797\u706b\u707e\u3002", "e2d79e9f2d1e1e0827aea6bb6ddded6a": "\u8981\u901a\u8fc7\u5728 ArcGIS \u4e0a\u5c06 Pro \u6a21\u677f shapefile \u6587\u4ef6\u5408\u5e76\u5230\u611f\u5174\u8da3\u533a\u57df\u7684 shapefile \u6587\u4ef6\u6765\u6dfb\u52a0\u6240\u9700\u5b57\u6bb5\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\u3002", "7229052a9bb0f8f66e77ab5edc0dfdff": "\u4ed4\u7ec6\u68c0\u67e5 KML \u6587\u4ef6\u662f\u5426\u5305\u542b\u6240\u6709\u5fc5\u8981\u7684\u5c5e\u6027\u3002\u5c5e\u6027\u5b57\u6bb5\u5fc5\u987b\u5728 KML \u6587\u4ef6\u7684\u5f00\u5934\u5b9a\u4e49\u5e76\u4e14\u9488\u5bf9\u6587\u4ef6\u4e2d\u7684\u6bcf\u4e2a\u7279\u5f81\u8fdb\u884c\u5b9a\u4e49\u3002\u5728<a href=\"{{0}}\">\u8fd9\u91cc</a>\u8bbf\u95ee\u5173\u4e8e\u9009\u62e9\u54ea\u79cd Pro \u6a21\u677f\u7684\u8bf4\u660e\uff0c\u7136\u540e\u4ece Pro \u4e0a\u4f4d\u7f6e\u7f51\u9875\u6216\u5728<a rel=\"noreferrer noopener\" href=\"{{1}}\" target=\"_blank\">\u8fd9\u91cc</a>\u4e0b\u8f7d\u8be5\u6a21\u677f\u7684\u6837\u672c .zip  shapefile \u6587\u4ef6\u3002", "696c8de16f2ef182c26bfbe614051f74": "\u201c\u6709\u8b66\u62a5\u7684\u4f4d\u7f6e\u201d\u7edf\u8ba1\u60a8\u7684\u5217\u8868\u4e2d\u7ecf\u5386\u8fc7\u9009\u5b9a\u7c7b\u578b\u8b66\u62a5\u7684\u4f4d\u7f6e\u7684\u6570\u91cf\u3002", "8cee7e7dc11cf6be9d7ae1d3fcc7991d": "\u63a2\u7d22\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u5730\u56fe\uff0c\u5b83\u4eec\u603b\u7ed3\u4e86 {area} \u5185\u68ee\u6797\u7684\u5173\u952e\u7edf\u8ba1\u6570\u636e\u3002\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u68ee\u6797\u53d8\u5316\u7387\u548c\u68ee\u6797\u8303\u56f4\u2014\u2014\u53ef\u4ee5\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u4ee5\u53ca\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "062dd94b6afd64f8eb96bee721f29491": "\u4f7f\u7528\u201c\u4fee\u590d\u51e0\u4f55\u5f62\u72b6\u201d\u5de5\u5177\u6765\u4fee\u590d\u60a8\u6570\u636e\u4e2d\u7684\u9519\u8bef\u3002\u518d\u6b21\u4f7f\u7528\u201c\u68c0\u67e5\u51e0\u4f55\u5f62\u72b6\u201d\u5de5\u5177\u5e76\u68c0\u67e5\u9519\u8bef\u6765\u53cd\u590d\u6838\u67e5\u6240\u6709\u9519\u8bef\u662f\u5426\u5df2\u88ab\u66f4\u6b63\uff0c\u4ee5\u4fbf\u786e\u4fdd\u591a\u8fb9\u5f62\u6ca1\u6709\u4e25\u91cd\u626d\u66f2\u3002", "3286969e8e4b6b5570b38167005fbf4b": "\u70b9\u51fb\u201c\u663e\u793a\u5217\u8868\u201d\uff0c\u9009\u62e9\u60a8\u60f3\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u7684\u5217\u8868\u3002", "4c740a1e1e2796fbadb57594b6f7d7d1": "\u5230\u8fbe\u60a8\u60f3\u8981\u7684\u5217\u8868\u89c6\u56fe\u540e\uff0c\u6309\u7167\u4e0a\u9762\u7684\u590d\u5236\u4f4d\u7f6e\u5de5\u4f5c\u6d41\u7a0b\uff0c\u4ece GFW \u5217\u8868\u4e2d\u521b\u5efa\u4e00\u4e2a\u4f4d\u7f6e\u7684\u5b50\u5217\u8868\u5230\u60a8\u81ea\u5df1\u7684\u7b80\u4ecb\u4e2d\uff0c\u4ee5\u4fbf\u7a0d\u540e\u8fdb\u884c\u5206\u6790\u548c\u8fd4\u56de\u3002", "a0f5b75d7e4c1de7be302c8f3a15e1fe": "<strong>\u884c\u653f\u533a\u57df</strong>\uff1a\u7cfb\u7edf\u5c06\u63d0\u793a\u60a8\u9009\u62e9\u4e00\u4e2a\u56fd\u5bb6\u3002\u60a8\u4e5f\u53ef\u4ee5\u9009\u62e9\u5dde\u548c\u6b21\u5dde\uff0c\u4ee5\u4fbf\u8fdb\u4e00\u6b65\u7b5b\u9009\u8be5\u5217\u8868\u3002\u9009\u62e9\u6240\u9700\u533a\u57df\u540e\uff0c\u70b9\u51fb\u201c\u66f4\u65b0\u503c\u201d\u3002\u5982\u679c\u60a8\u60f3\u7f16\u8f91\u60a8\u7684\u9009\u62e9\uff0c\u5219\u70b9\u51fb\u53f3\u4e0a\u65b9\u7684\u201c\u7b5b\u9009\u201d\u3002", "ff463b15ca3887660a5d2d65c72cf307": "\u8981\u5c06\u7ebf\u6761\u8f6c\u6362\u4e3a\u591a\u8fb9\u5f62\uff0c\u8bf7\u4f7f\u7528\u4f4d\u4e8e\u201c\u6570\u636e\u7ba1\u7406\u201d\u5de5\u5177\u7bb1\u4e2d\u201c\u7279\u5f81\u201d\u5de5\u5177\u96c6\u4e2d\u7684\u201c\u7279\u5f81\u5230\u591a\u8fb9\u5f62\u201d\u5de5\u5177\u3002", "d702721e16d12e3a9107c396b5214031": "\u60a8\u53ef\u4ee5\u5c06\u4e00\u4e2a\u5b57\u6bb5\u7684\u6570\u503c\u590d\u5236\u5230\u53e6\u4e00\u4e2a\u5b57\u6bb5\uff0c\u65b9\u6cd5\u662f\u8f93\u5165\u60a8\u60f3\u590d\u5236\u7684\u5b57\u6bb5\u540d\u79f0\uff0c\u5e76\u5c06\u5b83\u7f6e\u4e8e\u53cc\u5f15\u53f7\uff08\u201c\u201d\uff09\u5185\u3002\u6709\u4e9b\u5b57\u6bb5\u53ea\u63a5\u53d7\u6570\u503c\uff0c\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u60a8\u5fc5\u987b\u5c1d\u8bd5\u5c06\u8fd9\u4e9b\u503c\u590d\u5236\u5230\u4e00\u4e2a\u4e0d\u540c\u7684\u5b57\u6bb5\u3002", "74e0136ea013db3b9b9e09bcf755a621": "\u53ef\u4ee5\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8fd9\u91cc</a>\u4e0b\u8f7d\u6837\u672c shapefile \u6587\u4ef6\u4ee5\u4f9b\u53c2\u8003\u3002", "1a7be1d2a2a60f787179c3353f73fb1c": "\u70b9\u51fb\u201c\u9009\u62e9\u7b5b\u9009\u5668\u201d\uff0c\u7136\u540e\u9009\u62e9\u60a8\u60f3\u5c06\u54ea\u4e2a\u7b5b\u9009\u5668\u5e94\u7528\u4e8e\u8be5\u8868\u683c\u3002", "49805ba41652bc46ce400081548998b3": "\u5728\u5904\u7406\u5de5\u5177\u7bb1\u4e2d\uff0c\u6253\u5f00\u201c\u5411\u91cf\u51e0\u4f55\u201d\u5de5\u5177\u96c6\u5e76\u4f7f\u7528 \u201c\u68c0\u67e5\u6709\u6548\u6027\u201d\u5de5\u5177\u3002\u6b64\u5de5\u5177\u5c06\u521b\u5efa\u4e09\u4e2a\u56fe\u5c42\uff0c\u663e\u793a\u54ea\u4e9b\u591a\u8fb9\u5f62\u662f\u6b63\u786e\u7684\uff08\u201c\u6709\u6548\u201d\uff09\uff0c\u54ea\u4e9b\u591a\u8fb9\u5f62\u6709\u9519\u8bef\uff08\u201c\u65e0\u6548\u201d\uff09\uff0c\u8fd8\u6709\u4e00\u4e2a\u70b9\u5c42\u6765\u6307\u793a\u9519\u8bef\u4f4d\u7f6e\u3002", "802e969b031f9ac5f265063bb1c6f45b": "\u8981\u4ece\u60a8\u7684\u6a21\u677f\u4e2d\u67e5\u770b\u989d\u5916\u7684\u6570\u636e\u5217\uff0c\u8bf7\u70b9\u51fb\u201c\u6dfb\u52a0\u5217\u201d\uff0c\u7136\u540e\u70b9\u51fb\u8981\u67e5\u770b\u7684\u4efb\u4f55\u989d\u5916\u5b57\u6bb5\u65c1\u8fb9\u7684\u590d\u9009\u6846\u3002\u6dfb\u52a0\u7684\u5217\u5c06\u51fa\u73b0\u5728\u8868\u683c\u7684\u6700\u53f3\u4fa7\u3002\u8981\u9690\u85cf\u5217\uff0c\u8bf7\u70b9\u51fb\u201c\u6dfb\u52a0\u5217\u201d\uff0c\u7136\u540e\u53d6\u6d88\u52fe\u9009\u8981\u9690\u85cf\u7684\u5b57\u6bb5\u3002\u60a8\u4e5f\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u201c\u5168\u9009\u201d\u6216\u201c\u53d6\u6d88\u5168\u9009\u201d\u6765\u4e00\u6b21\u9009\u62e9\u6216\u53d6\u6d88\u9009\u62e9\u6240\u6709\u5b57\u6bb5\u3002", "1542e4e6cdde049cdf6d0b855c9c998a": "\u63a2\u7d22\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u5730\u56fe\uff0c\u5b83\u4eec\u603b\u7ed3\u4e86 {location} \u5185\u7684\u68ee\u6797\u8303\u56f4\u3002\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u62e5\u6709\u6700\u591a\u68ee\u6797\u7684\u5730\u533a\u7684\u6392\u540d\u2014\u2014\u53ef\u4ee5\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u4ee5\u53ca\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "95c9fcdc1d0aac27d5755fa103d885b2": "\u8981\u663e\u793a KML \u6216 KMZ \u6587\u4ef6\uff0c\u8bf7\u4f7f\u7528 Google Earth\u3002\u60a8\u53ef\u4ee5\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8fd9\u91cc</a>\u514d\u8d39\u4e0b\u8f7d Google Earth Pro (Windows)\u3002", "c646f93ad256763ee152e415912e4177": "\u63a2\u7d22\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u5730\u56fe\uff0c\u5b83\u4eec\u603b\u7ed3\u4e86{adm2}, {adm1}, {location} \u4e2d\u7684\u68ee\u6797\u7684\u4e3b\u8981\u7edf\u8ba1\u6570\u636e\u3002\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u68ee\u6797\u53d8\u5316\u7387\u548c\u68ee\u6797\u8303\u56f4\u2014\u2014\u53ef\u4ee5\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u4ee5\u53ca\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002\n", "9e39b6746e155cfecd93f872f8df5a66": "\u63a2\u7d22\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u5730\u56fe\uff0c\u5b83\u4eec\u603b\u7ed3\u4e86 {adm1}, {location} \u7684\u68ee\u6797\u8303\u56f4\u3002\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u62e5\u6709\u6700\u591a\u68ee\u6797\u7684\u5730\u533a\u7684\u6392\u540d\u2014\u2014\u53ef\u4ee5\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u4ee5\u53ca\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "e271b4fe37378f0dcb935fa8c45a6aff": "\u9009\u62e9\u4e0e\u60a8\u7684\u6570\u636e\u76f8\u5339\u914d\u7684\u4f4d\u7f6e\u6a21\u677f\u3002", "3d86ee620580fb4111e27d3f02027345": "\u6ca1\u6709\u627e\u5230\u60a8\u60f3\u8981\u7684\u5185\u5bb9\uff1f<button class=\"c-button theme-button-inline\"><div class=\"button-wrapper\">\u8bf7\u6d4f\u89c8\u5730\u56fe</div></button>\u6216<a href=\"{{0}}\">\u8bbf\u95ee\u5e2e\u52a9\u4e2d\u5fc3</a>\u67e5\u770b\u6559\u7a0b\u3002", "b1c6547766a678ed527b232808217406": "\u8981\u67e5\u770b\u5546\u54c1\u98ce\u9669\u5206\u6790\uff0c\u9996\u5148\u70b9\u51fb\u9876\u90e8\u83dc\u5355\u4e0a\u7684\u201c\u4f4d\u7f6e\u201d\u6807\u7b7e\u3002\u5411\u4e0b\u6eda\u52a8\u5230\u201c\u6211\u7684\u5217\u8868\u201d\uff0c\u9009\u62e9\u4e00\u4e2a\u5b8c\u5168\u5904\u7406\u7684\u68d5\u6988\u6cb9\u5de5\u5382\u6216\u60a8\u4e0a\u4f20\u5230 Pro \u7684\u68d5\u6988\u6cb9\u901a\u7528\u5217\u8868\u3002\u7cfb\u7edf\u5c06\u52a0\u8f7d\u4e00\u4e2a\u5305\u542b\u8be5\u5217\u8868\u4e2d\u6240\u6709\u4f4d\u7f6e\u7684\u8868\u683c\u3002", "bc2e1c48c4380575d4b5ff28d8a0b72a": "\u7528\u60a8\u7684 GFW Pro \u8d26\u6237\u51ed\u8bc1\u767b\u5f55\u4ee5\u7ee7\u7eed", "b1c3922e1105895fb68aed2d914c537d": "\u8fdb\u5165<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Pro \u7f51\u7ad9</a>\uff0c\u70b9\u51fb\u201c\u7533\u8bf7\u8d26\u6237\u201d\uff0c\u5f00\u59cb\u65b0\u8d26\u6237\u7684\u521b\u5efa\u6d41\u7a0b\u3002", "142bed862568e163e255b6844f449353": "\u63a2\u7d22\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u5730\u56fe\uff0c\u5b83\u4eec\u603b\u7ed3\u4e86\u5168\u7403\u68ee\u6797\u7684\u5173\u952e\u7edf\u8ba1\u6570\u636e\u3002\u7edf\u8ba1\u6570\u636e\u548c\u5168\u7403\u6392\u540d\u2014\u2014\u5305\u62ec\u68ee\u6797\u53d8\u5316\u7387\u3001\u68ee\u6797\u8303\u56f4\u548c\u68ee\u6797\u780d\u4f10\u7684\u9a71\u52a8\u56e0\u7d20\u2014\u2014\u53ef\u4ee5\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u4ee5\u53ca\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "fb1199e7ce126916c339b4801871cdf1": "\u5728 Google Earth Pro \u4e2d\u6253\u5f00 KML/KMZ \u6587\u4ef6\u3002", "e4776a1e1b5eab16089a8dc698acb87e": "\u4e0b\u9762\u7684\u6b65\u9aa4\u5c06\u5411\u60a8\u4ecb\u7ecd\u5982\u4f55\u5728\u5185\u90e8\u5171\u4eab\u5217\u8868\u3001\u63a5\u6536\u5171\u4eab\u7684\u5217\u8868\u548c\u5bfc\u51fa\u5217\u8868\u3002\u8981\u5c06\u5217\u8868\u5171\u4eab\u7ed9\u60a8\u7ec4\u7ec7\u4e2d\u7684\u5176\u4ed6\u7528\u6237\uff0c\u8bf7\u6309\u7167\u5728\u5185\u90e8\u5171\u4eab\u5217\u8868\u7684\u6b65\u9aa4\u8fdb\u884c\u64cd\u4f5c\u3002\u53ea\u6709\u62e5\u6709\u7ba1\u7406\u5458\u7ea7\u522b\u6743\u9650\u7684\u7528\u6237\u624d\u80fd\u5728\u5185\u90e8\u5171\u4eab\u5217\u8868\u2014\u2014\u7f16\u8f91\u4eba\u5458\u548c\u67e5\u770b\u4eba\u5458\u53ef\u4ee5\u63a5\u6536\u5171\u4eab\u5217\u8868\u3002\u8981\u5c06\u5217\u8868\u5171\u4eab\u5230\u7ec4\u7ec7\u5916\u90e8\uff0c\u8bf7\u6309\u7167\u5bfc\u51fa\u5217\u8868\u7684\u6b65\u9aa4\u8fdb\u884c\u64cd\u4f5c\u3002", "bc584b1551fde01b88f755e16c4403e9": "\u89c2\u770b\u82f1\u8bed\u7248\u7684\u89c6\u9891\u3002", "0529fe39c741cb7e37512f89da6455eb": "\u5728\u63a7\u5236\u9762\u677f\u7f51\u9875\u7684\u5e95\u90e8\uff0c\u60a8\u4f1a\u770b\u5230\u201c\u8b66\u62a5\u6458\u8981\u201d\u548c\u201c\u8b66\u62a5\u5386\u53f2\u201d\u3002\u8b66\u62a5\u5386\u53f2\u6839\u636e\u9009\u5b9a\u7684\u8b66\u62a5\u6570\u636e\u5c42\u548c\u65f6\u95f4\u6bb5\u6765\u663e\u793a\u8fc7\u53bb\u7684\u8b66\u62a5\u3002", "16c6facb959751535f9a37747512afad": "\u60a8\u5fc5\u987b\u4e3a\u4ee5\u4e0b\u6a21\u677f\u9009\u62e9\u4e00\u4e2a\u4f4d\u7f6e\u5206\u7c7b\uff08\u5373\u5c5e\u6027\u3001\u4f9b\u5e94\u5546\u6c60\u6216\u884c\u653f\u533a\u57df\uff09\u3002", "39b87442293fc7be8df2bf5658488a05": "\u8981\u8bbf\u95ee<a aria-label=\"undefined (opens in a new tab)\" rel=\"noreferrer noopener\" href=\"{{0}}\" target=\"_blank\">GFW Pro</a>\uff0c\u60a8\u9700\u8981\u7533\u8bf7\u4e00\u4e2a\u7ec4\u7ec7\u8d26\u6237\u3002\u60a8\u7684\u8d26\u6237\u88ab\u6fc0\u6d3b\u540e\uff0c\u60a8\u5c31\u53ef\u4ee5\u6dfb\u52a0\u7528\u6237\u548c\u7ba1\u7406\u6743\u9650\uff0c\u4e0a\u4f20\u548c\u5206\u6790\u60a8\u7684\u4f9b\u5e94\u94fe\u6216\u6295\u8d44\u4e2d\u7684\u4f4d\u7f6e\uff0c\u67e5\u770b\u5177\u4f53\u4f4d\u7f6e\u6216\u4e00\u7cfb\u5217\u4f4d\u7f6e\u7684\u8be6\u7ec6\u8bca\u65ad\u4fe1\u606f\uff0c\u67e5\u770b\u8fd1\u4e4e\u5b9e\u65f6\u7684\u8b66\u62a5\uff0c\u5e76\u4e0e\u60a8\u7684\u540c\u4e8b\u5171\u4eab\u62a5\u544a\u3002", "ed60cfcab102b21a2d38b65340c1e48d": "\u5728<a href=\"{{0}}\">\u8fd9\u91cc</a>\u4e86\u89e3\u5982\u4f55\u9009\u62e9\u6b63\u786e\u7684\u6a21\u677f\uff0c\u5728<a href=\"{{1}}\">\u8fd9\u91cc</a>\u4e86\u89e3\u5982\u4f55\u4e0a\u4f20\u4f4d\u7f6e\u548c\u5217\u8868\u5230 Pro\u3002", "ae43fd01886a5f791c4357ddeadb004b": "\u5982\u679c\u60a8\u4f7f\u7528\u7684\u662f\u4e00\u4e2a KMZ \u6587\u4ef6\uff0c\u5219\u9996\u5148\u9700\u8981\u5728 Google Earth \u4e0a\u53f3\u952e\u5355\u51fb\u8be5\u6587\u4ef6\uff0c\u5e76\u9009\u62e9\u201c\u53e6\u5b58\u4e3a\u201d\u5c06\u5176\u4fdd\u5b58\u4e3a KML \u6587\u4ef6\u3002", "44d848495ecacae7ac91ea03077bdf99": "\u9009\u62e9\u4f4d\u7f6e\u5206\u7c7b", "701a49e92bb1334d0308b10098d0589e": "\u63a2\u7d22\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u5730\u56fe\uff0c\u5b83\u4eec\u603b\u7ed3\u4e86 {adm1}, {location} \u68ee\u6797\u7684\u5173\u952e\u7edf\u8ba1\u6570\u636e\u3002\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u68ee\u6797\u53d8\u5316\u7387\u548c\u68ee\u6797\u8303\u56f4\u2014\u2014\u53ef\u4ee5\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u4ee5\u53ca\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "1b8375812277f61716bb9ba9646b9334": "\u5728 {location}\uff0c\u5728 {start_date} \u548c {end_date} \u4e4b\u95f4\u6709 {count} {dataset} \u706b\u707e\u8b66\u62a5\u62a5\u544a\uff0c\u4ec5\u8003\u8651<b>\u9ad8\u53ef\u4fe1\u5ea6\u7684\u8b66\u62a5</b>\u3002\u4e0e\u8ffd\u6eaf\u5230 {dataset_start_year} \u7684\u4e4b\u524d\u5e74\u4efd\u76f8\u6bd4\uff0c\u8fd9\u662f {status}\u3002", "1d26c8030cf3b7bf88acd6512f355986": "\u5c06\u51fa\u73b0\u4e00\u4e2a\u6a2a\u5e45\uff0c\u8868\u793a\u6b63\u5728\u5bf9\u60a8\u7684\u5217\u8868\u8fdb\u884c\u5206\u6790\u3002", "21ef44fdd521495c914181260034b2fb": "\u5bf9\u4e8e GLAD \u68ee\u6797\u780d\u4f10\u8b66\u62a5\uff0c\u60a8\u53ef\u4ee5\u67e5\u770b\u4e0a\u5468\u3001\u4e0a\u6708\u3001\u4e0a\u5b63\u5ea6\u6216\u4e0a\u4e00\u5e74\u7684\u8b66\u62a5\u3002", "3d46310df1a00bdb9862eff81d73cd92": "\u70b9\u51fb\u4f4d\u7f6e\u5217\u8868\u4e0a\u65b9\u7684\u4e0b\u8f7d\u56fe\u6807\uff0c\u5c06\u6b63\u786e\u7684\u6570\u636e\u4e0b\u8f7d\u4e3a CSV \u6587\u4ef6\u3002", "36bdbb4119b77af41a96d2e0e6652534": "2000 \u5e74\uff0c{location} \u7684\u5730\u4e0a\u6d3b\u6728\u8d28\u751f\u7269\u91cf\u5bc6\u5ea6\u4e3a {biomassDensity}\uff0c\u5730\u4e0a\u603b\u751f\u7269\u91cf\u4e3a {totalBiomass}\u3002", "56e2ecd7e62c448c45cdd7e2a1676b56": "\u67e5\u770b\u4e0e\u60a8\u6240\u5728\u4f4d\u7f6e\u76f8\u5173\u7684\u5386\u53f2\u7279\u70b9\u3002", "74196ef59cdcd25c6d7b2c6e46220e87": "\u5728\u5546\u54c1\u98ce\u9669\u5217\u8868\u89c6\u56fe\u4e2d\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u8868\u683c\u5de6\u4e0a\u65b9\u7684\u590d\u9009\u6846\u6765\u5bf9\u5217\u8868\u4e2d\u7684\u6240\u6709\u4f4d\u7f6e\u8fdb\u884c\u8bca\u65ad\uff0c\u6216\u8005\u901a\u8fc7\u70b9\u51fb\u5355\u4e2a\u4f4d\u7f6e\u65c1\u7684\u590d\u9009\u6846\u5bf9\u5217\u8868\u4e2d\u7684\u5355\u4e2a\u4f4d\u7f6e\u8fdb\u884c\u8bca\u65ad\u3002", "f2f38d128f46cd5abfcfefaedbb333ba": "\u4eba\u5458\u7c7b\u522b\u4e0b\u7684 {totalPosts} \u6587\u7ae0", "40419d5fb9bcd955ffab4beaf6461623": "\u5982\u679c\u4e00\u4e2a\u5217\u8868\u65e0\u6cd5\u66f4\u65b0\uff0c\u5219\u70b9\u51fb\u4f4d\u7f6e\u7f51\u9875\u4e0a\u7684\u201c\u66f4\u65b0\u201d\uff0c\u7136\u540e\u70b9\u51fb \u201cOK\u201d\u3002\u5217\u8868\u5c06\u91cd\u65b0\u5904\u7406\u3002", "0fa8f088bcd026c9fb8ecdfa445eb795": "Pro \u8ba9\u60a8\u80fd\u591f\u67e5\u770b\u60a8\u7684\u5546\u54c1\u548c\u6295\u8d44\u5217\u8868\u4e2d\u4f4d\u7f6e\u7684\u68ee\u6797\u53d8\u5316\u4fe1\u606f\u3002\u5728\u67e5\u770b\u68ee\u6797\u53d8\u5316\u6570\u636e\u4e4b\u524d\uff0c\u60a8\u9700\u8981\u4e0a\u4f20\u4f4d\u7f6e\u5230 Pro\u2014\u2014\u5728<a href=\"{{0}}\">\u8fd9\u91cc</a>\u4e86\u89e3\u5982\u4f55\u4e0a\u4f20\u4f4d\u7f6e\uff0c\u5728<a href=\"{{1}}\">\u8fd9\u91cc</a>\u4e86\u89e3\u5982\u4f55\u9009\u62e9\u6b63\u786e\u7684\u6a21\u677f\uff0c\u5728<a href=\"{{2}}\">\u8fd9\u91cc</a>\u4e86\u89e3\u5982\u4f55\u5b8c\u6210\u60a8\u9009\u62e9\u7684\u6a21\u677f\u3002", "151574dabd29d93d0bcb3170caf9fe8a": "\u5206\u6790\u7ed3\u679c\u5c06\u51fa\u73b0\u5728\u5206\u6790/\u57fa\u7840\u5730\u56fe\u9762\u677f\u4e0a\u3002", "ee782b1e43a1cf161f9edbf2889e452f": "\u6574\u7406\u4e00\u4e2a\u6587\u4ef6\u5939\u4e2d\u7684\u5217\u8868", "6675af6b4d3743cedf87cc0420be021a": "\u5bf9\u4e8e\u4ee5\u4e0b\u6a21\u677f\uff0cPro \u4f1a\u5c06\u4f4d\u7f6e\u5206\u7c7b\u81ea\u52a8\u586b\u5145\u4e3a\u201c\u4f9b\u5e94\u5546\u6c60\u201d\u3002", "61547cd5124e12c272c8407d245e1548": "<strong>\u6dfb\u52a0\u5230\u6587\u4ef6\u5939</strong>\u3002\u901a\u8fc7\u6dfb\u52a0\u5230\u6587\u4ef6\u5939\u6765\u7ba1\u7406\u60a8\u7684\u5217\u8868\u3002\u5982\u679c\u5217\u8868\u5df2\u7ecf\u5728\u4e00\u4e2a\u6587\u4ef6\u5939\u4e2d\uff0c\u201c\u6dfb\u52a0\u5230\u6587\u4ef6\u5939 \u201d\u9009\u9879\u5c06\u6539\u4e3a\u201c\u7ba1\u7406\u201d\u3002\u4e00\u4e2a\u5217\u8868\u4e00\u6b21\u53ea\u80fd\u5728\u4e00\u4e2a\u6587\u4ef6\u5939\u4e2d\u3002", "e962f7ead211eb6831f0e65216b32520": "\u70b9\u51fb\u5206\u6790/\u57fa\u7840\u5730\u56fe\u9762\u677f\u4e0a\u7684\u57fa\u7840\u5730\u56fe\u6807\u7b7e\u6765\u63a2\u7d22\u53ef\u7528\u7684\u57fa\u7840\u5730\u56fe\u3002", "ae0b6bd7cfba51fd8bab1eaf00f929e4": "\u7f16\u8f91\u548c\u5220\u9664\u60a8\u521b\u5efa\u7684\u5217\u8868\u3002", "c0710c095e88e8d60bb40abb8830a0c1": "\u5728\u6d3b\u52a8\u65e5\u5fd7\u4e2d\u67e5\u770b\u60a8\u8d26\u6237\u4e0a\u7684\u6240\u6709\u6d3b\u52a8\u3002", "ac243afa6ea094f23111fc095fa62191": "\u67e5\u770b\u73b0\u6709\u7684 GFW \u5217\u8868\uff08\u5373\u884c\u653f\u533a\u57df\u3001\u6cb9\u68d5\u6988\u7279\u8bb8\u6743\u3001\u68d5\u6988\u6cb9\u5382\u3001\u4fdd\u62a4\u533a\u3001RSPO \u6cb9\u68d5\u6988\u7279\u8bb8\u6743\uff09\u3002", "642ca66a96b4adcd063060347d4a526d": "\u672a\u5206\u7c7b (28)", "7234a2cdd9a2216b9e50cb4f523e0cff": "\u5728\u4f4d\u7f6e\u7f51\u9875\u4e0a\u70b9\u51fb\u201c\u6211\u7684\u5217\u8868\u201d\u4e0b\u7684\u4e00\u4e2a\u5217\u8868\u3002\u901a\u8fc7\u70b9\u51fb\u60a8\u60f3\u79fb\u52a8\u7684\u884c\u65c1\u8fb9\u7684\u590d\u9009\u6846\uff0c\u6765\u9009\u62e9\u60a8\u60f3\u79fb\u52a8\u7684\u884c\u3002", "fad1a003b19c834909a5034023431b78": "\u6839\u636e\u6a21\u677f\u7684\u4e0d\u540c\uff0c\u53ef\u80fd\u9700\u8981\u586b\u5145\u989d\u5916\u7684\u5fc5\u586b\u5b57\u6bb5\uff0c\u5982 ID \u6216\u516c\u53f8 ID\u3002", "3e7c2fa2a04bbfe49aee014c1b04d587": "\u8981\u5728 ArcGIS \u4e0a\u68c0\u67e5 shapefile \u51e0\u4f55\u5f62\u72b6\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\u3002", "676b197865b341a86b7e5f03ff4b66aa": "<strong>\u5927\u8c46\u7b52\u4ed3</strong>\uff1a\u63a8\u8350\u7528\u4e8e\u4f9b\u5e94\u94fe\u4e2d\u7684\u5927\u8c46\u7b52\u4ed3\u4f4d\u7f6e\u3002", "c844018f4b9fa71ac9ec4f354e3f435e": "\u68c0\u67e5\u6587\u4ef6\u5927\u5c0f\u662f\u5426\u4e0d\u8d85\u8fc7 5MB/5000 KB\u3002\u5982\u679c\u6587\u4ef6\u786e\u5b9e\u8d85\u8fc7\u4e86\u8fd9\u4e2a\u5927\u5c0f\uff0c\u8bf7\u53c2\u8003\u4e0a\u9762\u7684\u8bf4\u660e\u5c06\u60a8\u7684 shapefile \u6587\u4ef6\u62c6\u5206\u4e3a\u66f4\u5c0f\u7684\u90e8\u5206\u3002", "b88a2ad37332abd05e500cf961955bc1": "\u79fb\u52a8\u6216\u590d\u5236\u60a8\u7684\u5217\u8868\u4e2d\u7684\u4f4d\u7f6e", "3dcd246695a3d14dfb78f423538b5010": "\u70b9\u51fb\u5de6\u4e0b\u89d2\u7684\u641c\u7d22\u56fe\u6807\u6765\u641c\u7d22\u4e00\u4e2a\u7279\u5b9a\u7684\u533a\u57df\u3002", "aaedfd87011440e19ac251ca3fe0b3a4": "\u4eba (133)", "f8869ab703d1a13d58cf6e0cf2b3f3fc": "\u4f7f\u7528\u7f51\u9875\u5de6\u4e0a\u89d2\u7684\u201c\u8b66\u62a5\u663e\u793a\u201d\u4e0b\u62c9\u83dc\u5355\u6765\u9009\u62e9\u5728\u5730\u56fe\u4e0a\u663e\u793a GLAD \u68ee\u6797\u780d\u4f10\u8b66\u62a5\u6216 VIIRS \u706b\u707e\u8b66\u62a5\u3002GLAD \u68ee\u6797\u780d\u4f10\u8b66\u62a5\u662f\u9ed8\u8ba4\u9009\u5b9a\u7684\u3002", "9415dc924341dd95b0840dbd557caf50": "\u53ef\u5728\u5728<a rel=\"noreferrer noopener\" href=\"{{0}}\" target=\"_blank\">\u8fd9\u91cc</a>\u4e0b\u8f7d KML/KMZ \u6587\u4ef6\u6837\u672c\u4ee5\u4f9b\u53c2\u8003\u3002\u60a8\u4e5f\u53ef\u4ee5\u5728<a rel=\"noreferrer noopener\" href=\"{{1}}\" target=\"_blank\">\u8fd9\u91cc</a>\u8bbf\u95ee KML \u6587\u4ef6\u7684\u6307\u5357\u3002", "32d16b28626c83f215a401bf89fbeb57": "\u70b9\u51fb\u9876\u90e8\u83dc\u5355\u4e0a\u7684\u201c\u4f4d\u7f6e\u201d\uff0c\u4f7f\u7528\u641c\u7d22\u680f\u8f7b\u677e\u5730\u5728\u201c\u6211\u7684\u5217\u8868\u201d\u4e0b\u627e\u5230\u4e00\u4e2a\u5217\u8868\u3002", "6633a869cf5e9642b4b943fbadd337ee": "\u6253\u5f00\u4e0b\u8f7d\u7684 Excel \u6a21\u677f\u3002", "e4595611611e05e09c28fe0486499bed": "\u901a\u8fc7\u70b9\u51fb\u60a8\u60f3\u7f16\u8f91\u7684\u884c\u65c1\u8fb9\u7684\u590d\u9009\u6846\u6765\u9009\u62e9\u8981\u7f16\u8f91\u7684\u884c\u3002\u5982\u679c\u60a8\u60f3\u7f16\u8f91\u6240\u6709\u4f4d\u7f6e\uff0c\u8bf7\u70b9\u51fb\u8868\u683c\u5de6\u4e0a\u65b9\u201c\u4f4d\u7f6e\u540d\u79f0\u201d\u65c1\u7684\u590d\u9009\u6846\u3002", "7d89f1acff47214d24eae154fbe875b3": "\u5546\u54c1 (92)", "98d8eb493d8b20bdfc1980dff4b62173": "\u5982\u679c\u60a8\u60f3\u4ece\u5305\u542b\u591a\u4e2a\u4f4d\u7f6e\u7684 KML/KMZ \u6587\u4ef6\u4e2d\u53ea\u4e0a\u4f20\u4e00\u4e2a\u4f4d\u7f6e\uff0c\u8bf7\u53f3\u952e\u5355\u51fb\u5177\u4f53\u7684\u7279\u5f81\uff0c\u5c06\u5176\u53e6\u5b58\u4e3a\u4e00\u4e2a\u5355\u72ec\u7684\u6587\u4ef6\u3002", "cc1319ccb94df8a0e37a2dc24576e9c5": "\u5728 GFW Pro (Pro) \u4e0a\uff0c\u60a8\u53ef\u4ee5\u6dfb\u52a0\u548c\u521b\u5efa\u4f4d\u7f6e\u5217\u8868\uff0c\u8fd9\u4e9b\u4f4d\u7f6e\u6765\u81ea\u60a8\u7684\u4f9b\u5e94\u94fe\u6216\u6295\u8d44\uff0c\u662f\u60a8\u60f3\u8981\u957f\u671f\u76d1\u6d4b\u6216\u5206\u6790\u7684\u3002\u60a8\u53ef\u4ee5\u901a\u8fc7\u5404\u79cd\u65b9\u5f0f\u6dfb\u52a0\u4f4d\u7f6e\u3002\u6309\u7167\u4e0b\u9762\u7684\u6b65\u9aa4\uff0c\u4e86\u89e3\u5982\u4f55\u4e00\u6b21\u6dfb\u52a0\u4e00\u4e2a\u4f4d\u7f6e\u548c\u4e00\u6b21\u6dfb\u52a0\u591a\u4e2a\u4f4d\u7f6e\u3002", "fa55b690a40b612af02ba2958cd6cb71": "\u5bc6\u7801 *", "f02a0a773ca342970059d387b350ffed": "\u5728<a rel=\"noreferrer noopener\" href=\"{{0}}\" target=\"_blank\">\u8fd9\u91cc</a>\u83b7\u53d6\u66f4\u591a\u5173\u4e8e KML \u6587\u4ef6\u7684\u4fe1\u606f\uff0c\u5728<a rel=\"noreferrer noopener\" href=\"{{1}}\" target=\"_blank\">\u8fd9\u91cc</a>\u83b7\u53d6\u66f4\u591a\u5173\u4e8e Google Earth \u7684\u4fe1\u606f\u3002", "2c610b29e88c55626f66827e57fceeb4": "\u4ed4\u7ec6\u9605\u8bfb\u7b2c 2-4 \u884c\u4e2d\u6bcf\u4e2a\u5b57\u6bb5\u7684\u8bf4\u660e\u3002\u5728\u4e0a\u4f20\u8fc7\u7a0b\u4e2d\uff0cPro \u5c06\u6839\u636e Excel \u6a21\u677f\u4e2d\u7684\u89c4\u8303\u6765\u9a8c\u8bc1\u6240\u6709\u4e0a\u4f20\u7684\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u8f93\u5165\u7684\u5f00\u59cb\u548c\u7ed3\u675f\u65e5\u671f\u4e3a\u201c\u65e5-\u6708-\u5e74\u201d\u683c\u5f0f\uff0c\u5219\u5c06\u53d1\u751f\u9a8c\u8bc1\u9519\u8bef\uff1b\u6309\u7167\u89c4\u5b9a\uff0c\u8f93\u5165\u7684\u5f00\u59cb\u548c\u7ed3\u675f\u65e5\u671f\u5fc5\u987b\u4e3a\u201c\u6708/\u65e5/\u5e74\u201d\u683c\u5f0f\u3002", "b55477a121bc6c9aad4fe5d89ef6bbf4": "\u60a8\u53ea\u9700\u7b80\u5355\u5730\u952e\u5165\u6570\u5b57\u5373\u53ef\u8f93\u5165\u6570\u5b57\u503c\u3002", "c4e21c18b5e46391bddd657a8bfcd22c": "\u4ece GFW \u4e2d\u7b5b\u9009\u5217\u8868\uff0c\u521b\u5efa\u60a8\u60f3\u8981\u7684\u5217\u8868\u89c6\u56fe\u3002", "a2ce6c98b172be3c9e07a1589fc33e1e": "\u4e3a\u68ee\u6797\u53d8\u5316\u5206\u6790\u4f4d\u7f6e", "3370f604e1462ad1c373bbcfc315cad1": "\u73b0\u5728\u8be5\u8868\u683c\u5c06\u663e\u793a\u60a8\u6240\u5728\u4f4d\u7f6e 50 \u5343\u7c73\u8303\u56f4\u5185\u5bf9\u68ee\u6797\u666f\u89c2\u7684\u5a01\u80c1\u7684\u98ce\u9669\u7b49\u7ea7\u548c\u68ee\u6797\u666f\u89c2\u7684\u4ef7\u503c\u3002\u7b2c\u4e00\u680f\uff0c\u201cT+V\u201d\uff0c\u663e\u793a\u5a01\u80c1\u548c\u4ef7\u503c\u7684\u7efc\u5408\u98ce\u9669\u6307\u6807\uff0c\u79f0\u4e3a\u603b\u4f53\u5de5\u5382\u4f18\u5148\u7b49\u7ea7\u3002\u603b\u4f53\u5de5\u5382\u4f18\u5148\u7b49\u7ea7\u662f\u901a\u8fc7 PALM \u98ce\u9669\u5de5\u5177\u8fd0\u884c\u68d5\u6988\u6cb9\u5de5\u5382\u540e\u5f97\u5230\u7684\u7ed3\u679c\uff0c\u60a8\u53ef\u4ee5\u5728<a href=\"{{0}}\">\u8fd9\u91cc</a>\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002\u6709\u4e09\u4e2a\u98ce\u9669\u7b49\u7ea7\uff1a\u4f4e\u3001\u4e2d\u3001\u9ad8\u3002\u60a8\u53ef\u4ee5\u70b9\u51fb\u5206\u6790\u65c1\u8fb9\u7684\u4fe1\u606f \u201ci\u201d \u56fe\u6807\u6765\u4e86\u89e3\u66f4\u591a\u5173\u4e8e\u5a01\u80c1\u548c\u4ef7\u503c\u7684\u4fe1\u606f\u3002", "6fd50c520f4f6d55c31aaa0ccee416f2": "\u201c\u8b66\u62a5\u6458\u8981\u201d\u4e2d\u663e\u793a\u7684\u8b66\u62a5\u603b\u6570\u53ef\u80fd\u4e0e\u8b66\u62a5\u4f4d\u7f6e\u7b49\u7ea7 CSV \u6587\u4ef6\u4e2d\u7684\u8b66\u62a5\u603b\u6570\u4e0d\u540c\u3002\u201c\u8b66\u62a5\u6458\u8981\u201d\u6d88\u9664\u4e86\u6240\u6709\u4f4d\u7f6e\uff0c\u4ee5\u79fb\u9664\u4efb\u4f55\u90e8\u5206\u91cd\u53e0\u7684\u4f4d\u7f6e\u6216\u91cd\u590d\u7684\u8b66\u62a5\uff0c\u800c\u8b66\u62a5\u4f4d\u7f6e\u7b49\u7ea7 CSV \u6587\u4ef6\u5219\u7edf\u8ba1\u4e86\u6240\u6709\u5b58\u5728\u7684\u8b66\u62a5\u3002", "30b6b296363856cdc2dd3761e6bd25db": "\u5982\u679c\u60a8\u7684\u6a21\u677f\u6587\u4ef6\u5728\u4e0a\u4f20\u65f6\u6709\u4efb\u4f55\u9519\u8bef\uff0c\u6709\u9519\u8bef\u7684\u884c\u5de6\u8fb9\u5c06\u51fa\u73b0\u4e00\u4e2a\u7ea2\u8272\u611f\u53f9\u53f7\u3002\u5bfb\u627e\u6709\u7ea2\u8272\u8fb9\u6846\u7684\u5355\u5143\u683c\u2014\u2014\u5e26\u8fb9\u6846\u7684\u5355\u5143\u683c\u8868\u793a\u6709\u9519\u8bef\u3002\u60a8\u53ef\u4ee5\u5c06\u9f20\u6807\u60ac\u505c\u5728\u65e0\u6548\u7684\u5355\u5143\u683c\u4e0a\uff0c\u4e86\u89e3\u8be5\u5355\u5143\u683c\u7684\u9884\u671f\u683c\u5f0f\u3002\u60a8\u53ef\u4ee5\u76f4\u63a5\u5728 Pro \u4e0a\u66f4\u65b0\u9519\u8bef\uff0c\u70b9\u51fb\u6709\u9519\u8bef\u7684\u5355\u5143\u683c\u5e76\u4fee\u6b63\u5176\u4fe1\u606f\u5373\u53ef\u3002", "5ad76573b1667122e66067c0d0cd51c3": "\u8f93\u5165\u4e0a\u7ea7\u7ec4\u7ec7\u7684\u540d\u79f0\u3002", "1ac73e5475a0d28ce6bc63aafc548e9d": "\u5bf9\u5217\u8868\u8fdb\u884c\u7684\u4efb\u4f55\u66f4\u65b0\u6216\u7f16\u8f91\u90fd\u4f1a\u81ea\u52a8\u66f4\u65b0\u7ed9\u5171\u4eab\u8be5\u5217\u8868\u7684\u6240\u6709\u7528\u6237\u3002", "1840eb543e7ef20803858aa16ac30732": "\u5bf9\u4e8e\u901a\u7528\u5546\u54c1\u6a21\u677f\uff0c\u60a8\u5fc5\u987b\u4e3a\u6574\u4e2a\u5217\u8868\u9009\u62e9\u4e00\u79cd\u5546\u54c1\u3002\u5bf9\u4e8e\u5176\u4ed6\u5546\u54c1\u6a21\u677f\uff0cPro \u4f1a\u81ea\u52a8\u5c06\u5546\u54c1\u586b\u5145\u4e3a\u7b26\u5408\u8be5\u6a21\u677f\u7684\u5546\u54c1\u7c7b\u578b\u3002", "9ce02a377941b617fcebf27150327942": "\u5c06\u4f4d\u7f6e\u590d\u5236\u5230\u73b0\u6709\u6216\u65b0\u7684\u5217\u8868\u4e2d\u3002", "2510bd3b3eab72ae3021bdfaa31b731e": "A\u3001B\u3001C \u548c D \u6216 E \u5217\u662f\u5fc5\u586b\u7684\u3002\u5728\u6700\u540e\u4e09\u5217\u4e2d\uff0c\u60a8\u53ef\u4ee5\u6dfb\u52a0\u81ea\u5b9a\u4e49\u5b57\u6bb5\u3002", "51550d7b65ea595679b3740f04a65787": "\u60a8\u53ef\u4ee5\u901a\u8fc7\u952e\u5165\u8868\u8fbe\u5f0f\u5e76\u5c06\u5176\u7f6e\u4e8e\u53cc\u5f15\u53f7\uff08\u201c\u201d\uff09\u5185\u6765\u8f93\u5165\u6587\u672c\u503c\u3002", "2d7b1fe23b9a56ebdfcbb05488755600": "\u76f8\u5173\u7684\u5206\u6b65\u6307\u5357", "e5ba75ebb7285a805c1ed1c9f4c48172": "\u5728\u60a8\u7684\u5217\u8868\u4e2d\u9009\u62e9\u4e00\u4e2a\u4f4d\u7f6e\u6216\u6240\u6709\u4f4d\u7f6e\uff0c\u7136\u540e\u70b9\u51fb\u8868\u683c\u9876\u90e8\u7684\u201c\u8bca\u65ad\u201d\u3002", "3fe06cf5ee6da4e7be0283f81d7e85b6": "\u201c\u8b66\u62a5\u6458\u8981\u201d\u6d88\u9664\u4e86\u6240\u6709\u4f4d\u7f6e\uff0c\u4ee5\u79fb\u9664\u4efb\u4f55\u90e8\u5206\u91cd\u53e0\u7684\u4f4d\u7f6e\u6216\u91cd\u590d\u7684\u8b66\u62a5\u3002", "ba203d589337605a03617dcf278d8705": "\u68c0\u67e5\u60a8\u7684 shapefile \u6587\u4ef6\u4e2d\u7684\u7279\u5f81\u662f\u5426\u5c11\u4e8e 1500 \u4e2a\u2014\u2014\u8fd9\u662f GFW Pro \u4e2d\u6700\u5927\u7684\u5217\u8868\u5927\u5c0f\u3002\u8981\u5728 QGIS \u6216 ArcGIS \u4e0a\u5c06\u5217\u8868\u62c6\u5206\u4e3a\u66f4\u5c0f\u7684\u5217\u8868\uff0c\u8bf7\u6253\u5f00\u5c5e\u6027\u8868\u5e76\u9009\u62e9\u60a8\u5e0c\u671b\u4ece\u539f\u59cb\u6570\u636e\u4e2d\u5206\u79bb\u51fa\u6765\u7684\u4efb\u4f55\u884c\u3002\u5728 QGIS \u4e0a\uff0c\u53f3\u952e\u5355\u51fb\u60a8\u7684\u6570\u636e\u5e76\u4ece\u53ef\u7528\u9009\u9879\u4e2d\u9009\u62e9\u201c\u5c06\u9009\u5b9a\u7684\u7279\u5f81\u53e6\u5b58\u4e3a\u201d\u3002\u5728 ArcGIS \u4e0a\uff0c\u53f3\u952e\u5355\u51fb\u76ee\u5f55\u4e2d\u7684\u6570\u636e\u5e76\u4ece\u53ef\u7528\u9009\u9879\u4e2d\u9009\u62e9\u201c\u5bfc\u51fa\u201d\u3002", "acfaf819974375595cf73c77a30103cd": "\u60a8\u5c06\u5728\u9876\u90e8\u83dc\u5355\u4e2d\u770b\u5230\u4e0d\u540c\u7684\u9009\u9879\u3002\u201c\u4f4d\u7f6e\u201d\u3001\u201c\u5730\u56fe\u201d\u3001\u201c\u63a7\u5236\u9762\u677f\u201d\u548c\u201c\u7b80\u4ecb\u201d\u3002\u70b9\u51fb\u201c\u7b80\u4ecb\u201d\u6807\u7b7e\u6765\u8bbf\u95ee\u60a8\u6240\u5728\u7ec4\u7ec7\u7684\u4fe1\u606f\u3002", "287485e79024cfa5c5bf17abe0b55852": "\u67e5\u770b\u6d3b\u52a8\u65e5\u5fd7", "6b7873b385a4e1eaf379ac9f4fe6bb41": "\u81ea\u5b9a\u4e49\u57fa\u7840\u5730\u56fe", "7249fc3b420d135634861029276c8b70": "\u9009\u62e9\u60a8\u60f3\u4e0e\u7ec4\u7ec7\u4e2d\u7684\u54ea\u4e9b\u4eba\u5171\u4eab\u8be5\u5217\u8868\u3002", "9bce268f6cb7cb716ad911e777b94a4f": "\u5c06\u60a8\u7684\u6a21\u677f\u6587\u4ef6\u4e0a\u4f20\u5230 Pro\u3002", "bb743f82d57b05ebb0a468a7612e75b7": "\u8981\u5728 QGIS \u4e0a\u68c0\u67e5\u4e00\u4e2a shapefile \u6587\u4ef6\u7684\u4f4d\u7f6e\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\u3002", "1b8e52b37ad7e38dc8728e8f95c7b344": "\u706b\u707e (63)", "7ec133abef6e9a58d17d6b85da9ac699": "\u6b22\u8fce\u6765\u5230 Global Forest Watch \u5730\u56fe\uff01", "4024dc8125873a6cb7515655b1f2b34b": "\u70b9\u51fb\u60a8\u60f3\u67e5\u770b\u7684\u57fa\u7840\u5730\u56fe\u3002\u8be5\u57fa\u7840\u5730\u56fe\u5c06\u81ea\u52a8\u52a0\u8f7d\u5230\u5730\u56fe\u4e0a\u3002\u5bf9\u4e8e Landsat \u57fa\u7840\u5730\u56fe\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u8981\u67e5\u770b\u54ea\u4e2a\u5e74\u4efd\u7684 Landsat \u56fe\u50cf\u3002\u70b9\u51fb \u201cLandsat\u201d \u65c1\u7684\u4e0b\u62c9\u83dc\u5355\u6765\u9009\u62e9\u5e74\u4efd\u3002", "c3fd77a142b1a05a82a7020536ab8607": "\u8bf7\u8bb0\u5f97\u4fdd\u5b58\u60a8\u7684\u5de5\u4f5c\uff0c\u5e76\u4ed4\u7ec6\u68c0\u67e5\u5404\u5b57\u6bb5\u662f\u5426\u5df2\u586b\u5165\u60a8\u7684\u9996\u9009\u503c\u3002", "a917063fa4862140e75e6b600d9b6ea7": "\u60a8\u7684\u6570\u636e\u548c\u6a21\u677f shapefile \u7684\u51e0\u4f55\u5f62\u72b6\u5fc5\u987b\u76f8\u540c\u3002\u6362\u53e5\u8bdd\u8bf4\uff0c\u4e00\u4e2a\u5177\u6709\u591a\u8fb9\u5f62\u51e0\u4f55\u7ed3\u6784\u7684 shapefile \u4e0d\u80fd\u4e0e\u53e6\u4e00\u4e2a\u5177\u6709\u70b9\u51e0\u4f55\u7ed3\u6784\u7684 shapefile \u5408\u5e76\u3002\u518d\u6b21\u68c0\u67e5\u51e0\u4f55\u5f62\u72b6\uff0c\u5982\u679c\u9700\u8981\u7684\u8bdd\uff0c\u8bf7\u4e0b\u8f7d\u6070\u5f53\u7684\u6a21\u677f shapefile \u6587\u4ef6\u3002", "6a6681360dbb741fcfdb1e93047a0c47": "<strong>\u6295\u8d44</strong>\uff1a\u4e3a\u4efb\u4f55\u5546\u54c1\u7c7b\u578b\u7684\u4efb\u4f55\u6295\u8d44\u9009\u62e9\u201c\u6295\u8d44\u201d\u3002\u4e00\u4e2a\u6295\u8d44\u5217\u8868\u53ef\u4ee5\u5305\u542b\u591a\u79cd\u5546\u54c1\u7c7b\u578b\u3002", "83f07f11c8706360d94f4267278d9953": "\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u79fb\u52a8\u201d\u56fe\u6807\u3002", "9c801db70e3aaad7d910b5f06dc57aba": "\u9488\u5bf9\u5404\u79cd\u5546\u54c1\u63d0\u4f9b\u4e0d\u540c\u7684\u6570\u636e\u4e0a\u4f20\u6a21\u677f\uff0c\u6bcf\u4e2a\u6a21\u677f\u90fd\u5305\u542b\u4e0e\u7528\u6237\u9009\u62e9\u7684\u5546\u54c1\u76f8\u5173\u7684\u72ec\u7279\u7684\u5c5e\u6027\u5b57\u6bb5\u3002\u5728<a href=\"{{0}}\">\u8fd9\u91cc</a>\u67e5\u770b\u9009\u62e9\u54ea\u79cd Pro \u6a21\u677f\u7684\u8bf4\u660e\uff0c\u7136\u540e\u4ece\u4f4d\u7f6e\u7f51\u9875\u4e0a\u7684\u201c\u5e2e\u52a9\u201d\u9762\u677f\u4e0b\u8f7d\u8be5\u6a21\u677f\u3002\u6a21\u677f shapefile \u7684\u51e0\u4f55\u5f62\u72b6\u5fc5\u987b\u4e0e\u60a8\u7684\u6570\u636e\u4e2d\u7684\u51e0\u4f55\u5f62\u72b6\u76f8\u5339\u914d\uff0c\u5426\u5219\u60a8\u5c06\u65e0\u6cd5\u5408\u5e76\u8fd9\u4e24\u4e2a\u6587\u4ef6\u3002\u53ef\u4f9b\u4e0b\u8f7d\u7684\u7535\u5b50\u8868\u683c\u5305\u542b\u8865\u5145\u4fe1\u606f\uff0c\u89e3\u91ca\u4e86\u5982\u4f55\u586b\u5199\u5b57\u6bb5\u3002", "4ab094db9834c3b12af5732992af9503": "\u586b\u5199\u76f8\u5173\u4fe1\u606f\uff0c\u7136\u540e\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u3002", "6d002dab0f8c4634eb278d495b261e7d": "\u8bbf\u95ee\u63a7\u5236\u9762\u677f", "9ac1ed56a769097b233d894ff80756e5": "\u60a8\u53ef\u4ee5\u9009\u62e9\u5f00\u59cb\u548c\u7ed3\u675f\u65e5\u671f\u6216\u4f4d\u7f6e\u89c2\u5bdf\u671f\u7684\u65f6\u95f4\u8303\u56f4\uff1b\u60a8\u8fd8\u53ef\u4ee5\u9009\u62e9\u4e3a\u4f4d\u7f6e\u6dfb\u52a0\u989d\u5916\u7684\u5143\u6570\u636e\uff0c\u5982\u516c\u53f8\u653f\u7b56\u6392\u540d\u3001\u98ce\u9669\u7b49\u7ea7\u3001\u8ba4\u8bc1\u7b49\u3002\u6839\u636e\u5546\u54c1\u7c7b\u578b\uff0c\u5c06\u8fd9\u4e9b\u4fe1\u606f\u4e0e\u4f4d\u7f6e\u76f8\u5173\u8054\u53ef\u80fd\u5f88\u6709\u7528\u3002", "433ff8a52fa5db71f8488f456bf0c41a": "\u5c06\u51fa\u73b0\u4e1c\u5357\u4e9a\u548c\u5357\u7f8e\u6d32\u4f4d\u7f6e\u7684\u533a\u57df\u6570\u636e\u9762\u677f\uff0c\u5e76\u663e\u793a\u4e0e\u8fd9\u4e9b\u533a\u57df\u76f8\u5173\u7684\u6570\u636e\u5c42\u3002", "e135459141ed068f9a0dc0048a1cb97e": "<strong>\u65e5</strong>\uff1a\u663e\u793a\u524d\u4e00\u5929\u7684\u706b\u707e\u8b66\u62a5\u3002\u6bcf\u65e5\u8b66\u62a5\u6bcf\u5929\u66f4\u65b0\u4e00\u6b21\u3002", "8b5f3bed2a2736c60a0e391b77bec4f4": "\u5fc5\u987b\u9996\u5148\u4e0a\u4f20\u6bcf\u4e2a\u4f4d\u7f6e\u6216\u4f4d\u7f6e\u5217\u8868\u7136\u540e\u8fdb\u884c\u5206\u6790\u3002\u4e0a\u4f20\u5904\u7406\u65f6\u95f4\u6700\u591a\u53ef\u80fd\u9700\u8981 24 \u5c0f\u65f6\u3002\u5728\u5904\u7406\u5b8c\u6210\u4e4b\u524d\uff0c\u8be5\u5217\u8868\u5c06\u5728\u4f4d\u7f6e\u9875\u9762\u4e0a\u663e\u793a\u5e76\u5e26\u6709\u201c\u6b63\u5728\u5206\u6790\u201d\u7684\u6807\u7b7e\uff0c\u800c\u4e14\u4e0d\u80fd\u70b9\u51fb\u3002\u5904\u7406\u5f00\u59cb\u65f6\u548c\u5b8c\u6210\u540e\uff0c\u60a8\u5c06\u6536\u5230\u786e\u8ba4\u7535\u5b50\u90ae\u4ef6\u3002\u6216\u8005\uff0c\u60a8\u53ef\u4ee5\u4ece\u4f4d\u7f6e\u7f51\u9875\u4e0a \u201cGlobal Forest Watch \u5217\u8868\u201d\u7684\u201c\u901a\u7528\u5de5\u5382\u5217\u8868\u201d\u4e2d\u9009\u62e9\u4e00\u4e2a\u68d5\u6988\u6cb9\u5de5\u5382\u7684\u5b50\u96c6\u3002\u5546\u54c1\u98ce\u9669\u5206\u6790\u5c06\u81ea\u52a8\u63d0\u4f9b\u7ed9\u901a\u7528\u5de5\u5382\u5217\u8868\u3002", "75adf2c65547662f3fa625e85a3d1c60": "\u68d5\u6988\u6cb9\u5de5\u5382", "9776fcc197d43a2160f91148d300b0d6": "\u89c6\u9891\u6307\u5357", "2888475b1af2449334cfd7fb7dae12e0": "\u8fd0\u884c\u8be5\u5de5\u5177\u540e\uff0c\u6253\u5f00\u5c5e\u6027\u8868\u3002\u4efb\u4f55\u7528\u84dd\u8272\u9ad8\u4eae\u7684\u884c\u90fd\u4ee3\u8868\u4e00\u4e2a\u4e0e GADM \u6570\u636e\u91cd\u53e0\u4e14\u4f4d\u4e8e\u9646\u5730\u4e0a\u7684\u7279\u5f81\u3002\u5982\u679c\u4e00\u4e2a\u7279\u5f81\u6ca1\u6709\u88ab\u9009\u5b9a\uff0c\u8bf7\u5c1d\u8bd5\u5c06\u5176\u4e0e\u4e34\u8fd1\u56fd\u5bb6\u7684\u8fb9\u754c\u8fdb\u884c\u6bd4\u8f83\u3002", "33f43ca3515416077487a12852cbeb26": "\u5728\u4e0a\u4f20\u60a8\u7684 shapefile \u6587\u4ef6\u4e4b\u524d\uff0c\u60a8\u5e94\u8be5\u5728 GIS \u8f6f\u4ef6\u4e2d\u7559\u610f\u4ee5\u4e0b\u51e0\u70b9\u3002", "54f38198b69ed57e66ab8ad6ba398a8d": "\u4e0b\u9762\u7b80\u8981\u4ecb\u7ecd\u7684\u662f\u4e00\u4e2a\u63a8\u8350\u7684\u5de5\u4f5c\u6d41\uff0c\u7528\u6237\u5728\u51c6\u5907\u4e0a\u4f20 shapefile \u6587\u4ef6\u5230 GFW Pro\uff08Pro\uff09\u65f6\u53ef\u4ee5\u9075\u5faa\u8be5\u5de5\u4f5c\u6d41\u3002\u65e0\u8bba\u662f GIS \u65b0\u7528\u6237\u8fd8\u662f\u6709\u7ecf\u9a8c\u7684 GIS \u5206\u6790\u5e08\u90fd\u5e94\u8be5\u67e5\u770b\u8fd9\u4e9b\u6b65\u9aa4\uff0c\u4ee5\u5e2e\u52a9\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u6f5c\u5728\u7684 Pro \u6570\u636e\u4e0a\u4f20\u9519\u8bef\u3002", "078b7c73dbb4239e384996c756be1115": "\u5206\u6790\u5de5\u5177\u662f\u8bc4\u4f30\u5730\u56fe\u4e0a\u67d0\u4e00\u533a\u57df\u5185\u68ee\u6797\u53d8\u5316\u7684\u4e00\u79cd\u7b80\u5355\u65b9\u6cd5\u3002\u5728\u5730\u56fe\u4e0a\u8fdb\u884c\u5206\u6790\u6709\u4e09\u79cd\u65b9\u5f0f\uff0c\u5982\u4e0b\u6240\u793a\u3002\u4e3a\u4e86\u8fdb\u884c\u5206\u6790\uff0c\u60a8\u5fc5\u987b\u5f00\u542f\u201c\u68ee\u6797\u53d8\u5316\u201d\u6570\u636e\u5c42\u3002", "5d1d59adc595ee1c5d0da36162b96d13": "\u5c06\u9f20\u6807\u60ac\u505c\u5728\u4e00\u4e2a\u7c7b\u522b\u4e0a\u6765\u63a2\u7d22\u53ef\u7528\u7684\u6570\u636e\u3002", "92edb7196769c68c7da3591ef5565219": "<strong>\u53ef\u53ef\u901a\u7528</strong>\uff1a\u63a8\u8350\u7528\u4e8e\u519c\u573a\u4ee5\u5916\u7684\u53ef\u53ef\u4f9b\u5e94\u94fe\u4f4d\u7f6e\u3002\n", "97feeba20dc9b7fce9be254f057d4cc6": "\u63a2\u7d22\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u5730\u56fe\uff0c\u5b83\u4eec\u603b\u7ed3\u4e86 {adm2}, {adm1}, {location} \u7684\u68ee\u6797\u5728\u6c14\u5019\u53d8\u5316\u4e2d\u7684\u4f5c\u7528\u3002\u68ee\u6797\u78b3\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u68ee\u6797\u5982\u4f55\u50a8\u5b58\u3001\u6392\u653e\u548c\u56fa\u5b9a\uff08\u53bb\u9664\uff09\u78b3\u2014\u2014\u53ef\u4ee5\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u4ee5\u53ca\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "c62b6cdf369d46fd2758011544991574": "\u5728\u4f4d\u7f6e\u7f51\u9875\u4e0a\uff0c\u5728\u201c\u6211\u7684\u5217\u8868\u201d\u4e0b\u9009\u62e9\u4e00\u4e2a\u5217\u8868\u3002\u70b9\u51fb\u8be5\u5217\u8868\u65c1\u7684 \u201c\u2026\u201d \u83dc\u5355\uff0c\u7136\u540e\u9009\u62e9\u201c\u6dfb\u52a0\u5230\u6587\u4ef6\u5939\u201d\u3002", "9628e9d25870d4970b23ec54e6888f93": "<strong>\u68ee\u6797\u53d8\u5316\u5206\u6790</strong>\u663e\u793a\u60a8\u7684\u4f4d\u7f6e\u53d1\u751f\u4e86\u6811\u6728\u8986\u76d6\u7387\u635f\u5931\u7684\u533a\u57df\uff0c\u5e76\u7a81\u51fa\u663e\u793a\u5728\u68ee\u6797\u780d\u4f10\u653f\u7b56\u4e2d\u6700\u5e38\u63d0\u53ca\u7684\u4e00\u4e9b\u654f\u611f\u6797\u533a\u53d1\u751f\u7684\u635f\u5931\u3002", "d5f46502722db66ff933348151e737a4": "\u5728\u4f4d\u7f6e\u7f51\u9875\u4e0a\u70b9\u51fb\u201c\u6211\u7684\u5217\u8868\u201d\u4e0b\u65b9\u7684\u4e00\u4e2a\u5217\u8868\u3002", "8344961805f774038311429a6b59fb58": "\u9009\u62e9\u60f3\u8981\u7684\u4f4d\u7f6e\uff0c\u7136\u540e\u70b9\u51fb\u201c\u7f16\u8f91\u201d\u3002", "871f1d8a1c66d04045e86a275fc06622": "\u5728\u60a8\u586b\u5199\u5c5e\u6027\u8868\u65f6\uff0c\u6ce8\u610f\u4e0d\u8981\u70b9\u51fb\u4f4d\u4e8e\u201c\u5b57\u6bb5\u8ba1\u7b97\u5668\u201d\u56fe\u6807\u65c1\u7684\u7ea2\u8272\u201c\u5220\u9664\u5b57\u6bb5\u201d\u56fe\u6807\u3002\u5982\u679c\u60a8\u4e0d\u5c0f\u5fc3\u70b9\u51fb\u4e86 \u201c\u5220\u9664\u5b57\u6bb5\u201d\uff0c\u5219\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u4f4d\u4e8e\u201c\u5220\u9664\u5b57\u6bb5\u201d\u56fe\u6807\u53e6\u4e00\u4fa7\u7684\u9ec4\u8272\u201c\u65b0\u5efa\u5b57\u6bb5\u201d\u56fe\u6807\u6765\u6dfb\u52a0\u4e00\u4e2a\u65b0\u5b57\u6bb5\u3002", "9cd0124ced83697eb99719846c04daf4": "\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u4e0a\u4f20\u7684\u5217\u8868", "319eba8e67e0124bdf9b16266c2493cf": "\u5206\u6790\u5730\u56fe\u4e0a\u67d0\u4e2a\u533a\u57df\u5185\u7684\u6570\u636e", "0727c9d000fb308b13d24d6dd84e9242": "\u63a2\u7d22\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u5730\u56fe\uff0c\u5b83\u4eec\u603b\u7ed3\u4e86 {adm1}, {location} \u7684\u68ee\u6797\u706b\u707e\u3002\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u706b\u707e\u8b66\u62a5\u6700\u591a\u7684\u5730\u533a\u4ee5\u53ca\u5f53\u524d\u706b\u707e\u4e0e\u5386\u53f2\u8d8b\u52bf\u7684\u6bd4\u8f83\u2014\u2014\u53ef\u4ee5\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u4ee5\u53ca\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "78655c001fded53e87072c65992f1a68": "\u5f53\u60a8\u5b8c\u6210 Excel \u6a21\u677f\u540e\uff0c\u8bf7\u5c06\u5b83\u4fdd\u5b58\u5230\u60a8\u7684\u7535\u8111\u4e0a\u3002", "7a31921b731ad07f1f69a3451e5ea582": "\u7ba1\u7406\u5458\u6743\u9650\u7ea7\u522b", "892ba58ab379231fea7ae63b84254167": "\u7136\u540e Pro \u5c06\u5bf9\u60a8\u6dfb\u52a0\u7684\u4f4d\u7f6e\u8fdb\u884c\u5206\u6790\u3002\u5982\u679c\u60a8\u70b9\u51fb\u4e86\u201c\u4fdd\u5b58\u201d\uff0c\u5219\u60a8\u5c06\u88ab\u5bfc\u822a\u56de\u5230\u4f4d\u7f6e\u7f51\u9875\uff0c\u90a3\u91cc\u5c06\u51fa\u73b0\u4e00\u4e2a\u6a2a\u5e45\uff0c\u8868\u793a\u6b63\u5728\u5bf9\u60a8\u7684\u5217\u8868\u8fdb\u884c\u5206\u6790\u3002\u5206\u6790\u5f00\u59cb\u65f6\u548c\u5206\u6790\u5b8c\u6210\u540e\uff0c\u60a8\u5c06\u6536\u5230\u4e00\u5c01\u7535\u5b50\u90ae\u4ef6\u3002\u5f53\u7ed3\u679c\u51c6\u5907\u597d\u540e\uff0c\u60a8\u53ef\u4ee5\u5728\u4f4d\u7f6e\u7f51\u9875\u4e0a\u7684\u201c\u6211\u7684\u5217\u8868\u201d\u4e0b\u67e5\u770b\u5206\u6790\u7ed3\u679c\u3002", "1281abf5262aebccf5e5c78681f94801": "\u5728\u5206\u6790/\u57fa\u7840\u5730\u56fe\u9762\u677f\u7684\u5206\u6790\u6807\u7b7e\u4e0a\u70b9\u51fb\u201c\u53bf\u6216\u5730\u533a\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u9009\u62e9\u4e00\u4e2a\u53bf\u201d\u4e0b\u62c9\u83dc\u5355\u5e76\u9009\u62e9\u60a8\u8981\u5206\u6790\u7684\u56fd\u5bb6\u3002\u9009\u5b9a\u540e\uff0c\u5c06\u4f1a\u8fdb\u884c\u5206\u6790\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u8fd9\u4e2a\u56fd\u5bb6\u5185\u7684\u4e00\u4e2a\u5dde\u6216\u7701\u6765\u8fdb\u884c\u5206\u6790\u3002", "eacd344847568b86434ea74de13048a6": "\u60a8\u5fc5\u987b\u586b\u5199 A \u5217\uff08\u4f4d\u7f6e\u540d\u79f0\uff09\u3001B \u5217\uff08\u7eac\u5ea6\uff09\u3001C \u5217\uff08\u7ecf\u5ea6\uff09\u548c D \u5217\uff08\u5206\u6790\u534a\u5f84\uff09\u6216 E \u5217\uff08\u5206\u6790\u533a\u57df\uff09\u3002\u60a8\u4e0d\u9700\u8981\u540c\u65f6\u586b\u5199\u5206\u6790\u534a\u5f84\u548c\u5206\u6790\u533a\u57df\u3002\u5206\u6790\u533a\u57df\u5fc5\u987b\u8f93\u5165\u516c\u9877\u6570\uff0c\u5206\u6790\u534a\u5f84\u5fc5\u987b\u8f93\u5165\u5343\u7c73\u6570\u2014\u2014\u53ea\u9700\u5728\u76f8\u5173\u5b57\u6bb5\u4e2d\u8f93\u5165\u6570\u5b57\u3002\u5176\u4ed6\u5217\u662f\u53ef\u9009\u7684\uff0c\u4f46\u53ef\u80fd\u6709\u52a9\u4e8e\u5728 Pro \u4e2d\u53c2\u8003\u3002", "bf183b784e98529272c373f57ff4e7be": "\u63a2\u7d22\u603b\u7ed3\u4e86 {location} \u68ee\u6797\u706b\u707e\u7684\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u5730\u56fe\u3002\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u706b\u707e\u8b66\u62a5\u6700\u591a\u7684\u5730\u533a\u4ee5\u53ca\u5f53\u524d\u706b\u707e\u4e0e\u5386\u53f2\u8d8b\u52bf\u7684\u6bd4\u8f83\u2014\u2014\u53ef\u4ee5\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u548c\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "92f6f4d0a706d277b95a23a56b61d014": "\u201c\u603b\u4f4d\u7f6e\u6570\u201d\u663e\u793a\u60a8\u6240\u9009\u62e9\u7684\u8b66\u62a5\u6570\u636e\u5c42\u6240\u8986\u76d6\u7684\u5217\u8868\u4e2d\u7684\u4f4d\u7f6e\u6570\u91cf\u3002\u4f8b\u5982\uff0cGLAD \u68ee\u6797\u780d\u4f10\u8b66\u62a5\u4ec5\u8986\u76d6\u5168\u7403\u5404\u5730\u6709\u9650\u7684\u51e0\u4e2a\u56fd\u5bb6\uff0c\u6240\u4ee5\u53ea\u6709\u8fd9\u4e9b\u56fd\u5bb6\u7684\u4f4d\u7f6e\u4f1a\u51fa\u73b0\u5728\u201c\u603b\u4f4d\u7f6e\u6570\u201d\u5b57\u6bb5\u4e2d\u3002\u5176\u4ed6\u56fd\u5bb6\u7684\u4f4d\u7f6e\u5c06\u663e\u793a\u4e3a\u7070\u8272\u5706\u5708\uff0c\u8868\u793a\u6ca1\u6709\u53ef\u7528\u7684\u8b66\u62a5\u6570\u636e\u3002", "fae08372c117f8f445933848155cb780": "\u4e0b\u9762\u7684\u8fc7\u7a0b\u9700\u8981\u624b\u52a8\u7f16\u8f91\u60a8\u7684\u6570\u636e\u3002\u60a8\u53ef\u4ee5\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8fd9\u91cc</a>\u627e\u5230\u5173\u4e8e ArcGIS \u4e2d\u7f16\u8f91\u5de5\u5177\u7684\u8be6\u7ec6\u4fe1\u606f\u2014\u2014\u628a\u8fd9\u4e9b\u4fe1\u606f\u653e\u5728\u624b\u8fb9\u5bf9\u4e8e GIS \u65b0\u7528\u6237\u6765\u8bf4\u975e\u5e38\u6709\u7528\u3002\u5728\u7f16\u8f91\u6570\u636e\u65f6\uff0c\u8bf7\u8bb0\u5f97\u7ecf\u5e38\u4fdd\u5b58\u60a8\u7684\u5de5\u4f5c\u3002", "1fbe8f5bd8a452728ece073bb855cfbc": "\u4e24\u4e2a\u5206\u6790\u89c6\u56fe\u2014\u2014\u68ee\u6797\u53d8\u5316\u548c\u5546\u54c1\u98ce\u9669\u2014\u2014\u53ef\u4ee5\u901a\u8fc7\u8868\u683c\u4e0a\u65b9\u201c\u89c6\u56fe\u201d\u65c1\u7684\u4e0b\u62c9\u83dc\u5355\u6765\u9009\u62e9\u3002\u68ee\u6797\u53d8\u5316\u662f\u9ed8\u8ba4\u89c6\u56fe\u3002\u5546\u54c1\u98ce\u9669\u5206\u6790\u4ec5\u63d0\u4f9b\u7ed9\u68d5\u6988\u6cb9\u4f4d\u7f6e\u3002", "3f083ee7301e3e5342b4981b00ed2340": "\u5728 {startYear} \u548c {endYear} \u4e4b\u95f4\uff0c{location} \u7684\u68ee\u6797\u6392\u653e\u4e86 {totalEmissions}<strong>/\u5e74</strong>\uff0c\u53bb\u9664\u4e86 {totalRemovals}<strong>/\u5e74</strong>\u3002\u8fd9\u8868\u660e\u51c0\u78b3\u901a\u91cf\u4e3a {totalFlux}<strong>/\u5e74</strong>\u3002\n", "f2fdb56dad00b3c67bce18135df10767": "\u5b8c\u6210 Excel \u6a21\u677f\u3002\u5728<a href=\"{{0}}\">\u8fd9\u91cc</a>\u4e86\u89e3\u5982\u4f55\u5b8c\u6210\u60a8\u9009\u62e9\u7684\u6a21\u677f\u3002", "c52975eb6787c7a8320a0382c2a0c7cf": "\u8981\u5220\u9664\u989d\u5916\u7279\u5f81\uff0c\u8bf7\u5728\u8be5\u5c42\u4e0a\u53f3\u952e\u5355\u51fb\u5e76\u9009\u62e9\u201c\u5207\u6362\u7f16\u8f91\u201d\u3002\u9009\u62e9\u5c5e\u6027\u8868\u4e2d\u7684\u989d\u5916\u7279\u5f81/\u884c\uff0c\u7136\u540e\u6309\u201c\u5220\u9664\u201d\u952e\u5c06\u5176\u5220\u9664\u3002\u5220\u9664\u989d\u5916\u7279\u5f81\u540e\uff0c\u5728\u8be5\u5c42\u4e0a\u53f3\u952e\u5355\u51fb\u5e76\u518d\u6b21\u9009\u62e9\u201c\u5207\u6362\u7f16\u8f91\u201d\u3002\u7cfb\u7edf\u5c06\u63d0\u793a\u60a8\u4fdd\u5b58\u60a8\u7684\u5de5\u4f5c\u2014\u2014\u8fd9\u5c06\u4e0d\u4f1a\u4ece\u60a8\u7684 shapefile \u6587\u4ef6\u4e2d\u5220\u9664\u5fc5\u586b\u5b57\u6bb5\u3002", "a57eb553e044581dac40727e26701ff5": "\u6bcf\u5b63\u5ea6\u63d0\u4f9b\u4e00\u6b21\u66f4\u65b0\u7684\u6570\u636e\u5c42\u3002\u5f53\u65b0\u7684\u6570\u636e\u5c42\u53ef\u7528\u65f6\uff0c\u60a8\u5c06\u6536\u5230 Pro \u652f\u6301\u56e2\u961f\u7684\u7535\u5b50\u90ae\u4ef6\u3002\u8981\u4f7f\u7528\u6700\u65b0\u6570\u636e\u6765\u66f4\u65b0\u5217\u8868\u4e2d\u7684\u4f4d\u7f6e\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u56db\u4e2a\u6b65\u9aa4\u8fdb\u884c\u64cd\u4f5c\u3002", "5f5dc82372636c0d6d24392f15c45b89": "<strong>\u6cb9\u68d5\u6988\u7279\u8bb8\u6743</strong>\uff1a\u6587\u83b1\u3001\u5580\u9ea6\u9686\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u3001\u5229\u6bd4\u91cc\u4e9a\u3001\u9a6c\u6765\u897f\u4e9a\u3001\u5df4\u5e03\u4e9a\u65b0\u51e0\u5185\u4e9a\u3001\u521a\u679c\u5171\u548c\u56fd\u548c\u6240\u7f57\u95e8\u7fa4\u5c9b\u7684\u6cb9\u68d5\u6988\u7279\u8bb8\u6743\u3002", "1393f4b0eca40ae899c3353e03641cae": "\u68c0\u67e5\u60a8\u7684\u6570\u636e\u662f\u5426\u6ca1\u6709\u4efb\u4f55 M \u6216 Z \u503c\u3002\u5728\u6d4f\u89c8\u5668\u7a97\u53e3 (QGIS) \u6216\u76ee\u5f55 (ArcGIS) \u4e2d\u53f3\u952e\u5355\u51fb\u60a8\u7684 shapefile\uff0c\u7136\u540e\u6253\u5f00\u5c42\u5c5e\u6027\u3002\u5982\u679c\u60a8\u4f7f\u7528\u7684\u662f QGIS\uff0c\u5219\u5e94\u8be5\u4f7f\u7528\u201c\u5220\u9664 M/Z \u503c\u201d\u5de5\u5177\u3002\u5982\u679c\u60a8\u4f7f\u7528\u7684\u662f ArcGIS\uff0c\u5219\u8bf7\u4f7f\u7528\u201c\u590d\u5236\u201d\u5de5\u5177\uff0c\u6253\u5f00\u5de5\u5177\u73af\u5883\u5e76\u7981\u7528 M \u503c\u548c Z \u503c\u3002", "04eb22d805cffe02d06db39b2d9ceafa": "\u70b9\u51fb\u773c\u775b\u56fe\u6807\u5373\u53ef\u4ece\u5730\u56fe\u89c6\u56fe\u4e2d\u79fb\u9664\u5730\u56fe\u8bbe\u7f6e\u5de5\u5177\u3002", "453d3387c64308dc562e177a672bf8f0": "\u63a2\u7d22\u603b\u7ed3\u4e86 {adm2}, {adm1}, {location} \u68ee\u6797\u53d8\u5316\u7387\u7684\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u5730\u56fe\u3002\u68ee\u6797\u8986\u76d6\u7387\u53d8\u5316\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u68ee\u6797\u51cf\u5c11\u548c\u589e\u52a0\u6700\u591a\u7684\u5730\u533a\u7684\u6392\u540d\u2014\u2014\u53ef\u4ee5\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u548c\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "59cb7e74ecc51eb8680b1303d2499ec7": "\u7ed8\u5236\u4e00\u4e2a\u5f62\u72b6\u6765\u8fdb\u884c\u5206\u6790\u3002", "79920fb387648e1bf6bd1004cac44e8d": "\u5728\u6d4f\u89c8\u5668\u9762\u677f\u4e0a\u53f3\u952e\u5355\u51fb\u65b0\u5c42\uff0c\u6253\u5f00\u5c5e\u6027\u8868\u3002\u8981\u5feb\u901f\u8bc6\u522b\u989d\u5916\u7684\u7279\u5f81\uff0c\u8bf7\u53cc\u51fb\u5c5e\u6027\u8868\u4e2d\u7684\u4efb\u4f55\u4e00\u5217\uff0c\u5bf9\u5176\u8fdb\u884c\u6392\u5e8f\u3002\u6a21\u677f\u7684\u5c5e\u6027\u8868\u4e2d\u7684\u6bcf\u4e00\u5217\u90fd\u5df2\u88ab\u586b\u5145\uff0c\u56e0\u6b64\u5b83\u5c06\u88ab\u79fb\u52a8\u5230\u7b2c\u4e00\u884c\u3002", "1e7088f11b5dbfadb91a64d2c864b593": "\u586b\u5199\u5b8c\u76f8\u5173\u4fe1\u606f\u540e\uff0c\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u6765\u4fdd\u5b58\u4f4d\u7f6e\uff0c\u6216\u70b9\u51fb\u201c\u4fdd\u5b58\u5e76\u6dfb\u52a0\u53e6\u4e00\u4e2a\u4f4d\u7f6e\u201d\u6765\u4fdd\u5b58\u4f4d\u7f6e\u5e76\u5f00\u59cb\u6dfb\u52a0\u53e6\u4e00\u4e2a\u4f4d\u7f6e\u3002\u5982\u679c\u67d0\u4e9b\u5185\u5bb9\u586b\u5199\u4e0d\u5145\u5206\uff0c\u5c06\u51fa\u73b0\u4e00\u6761\u9519\u8bef\u6d88\u606f\uff0c\u6307\u51fa\u9700\u8981\u4fee\u6539\u7684\u5b57\u6bb5\u3002\n", "f5dd611d70b57510e03794ad07895d7d": "\u6709\u5173\u7f51\u9875\u4e0a\u4efb\u4f55\u7ec4\u4ef6\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u70b9\u51fb\u4fe1\u606f \u201ci\u201d \u56fe\u6807\u3002", "ab2106b28599ca9e18d6c2756ad3e6bc": "\u5982\u679c\u5217\u8868\u4e2d\u7684\u4f4d\u7f6e\u662f\u5168\u7403\u7684\uff0cPro \u5c06\u628a\u5730\u56fe\u8bbe\u7f6e\u4e3a\u5168\u7403\u89c6\u56fe\u3002\u60a8\u53ef\u4ee5\u4ece\u5168\u7403\u89c6\u56fe\u4e2d\u653e\u5927\u5177\u4f53\u7684\u4f4d\u7f6e\u3002\u5982\u679c\u4f4d\u7f6e\u7279\u5b9a\u4e8e\u67d0\u4e2a\u56fd\u5bb6\u6216\u5730\u533a\uff0c\u5219 Pro \u4f1a\u5c06\u5730\u56fe\u8bbe\u7f6e\u4e3a\u8be5\u5730\u533a\u7684\u89c6\u56fe\u3002", "3ec958c4d341a6fd928e61b8b9652157": "\u7ba1\u7406\u60a8\u7684\u5217\u8868", "1e0576e5cba91e609fda437ce0c2a910": "Pro \u5efa\u8bae\u7528\u6237\u4e0b\u8f7d QGIS \u6216 ArcGIS \u6765\u7f16\u8f91\u4ed6\u4eec\u7684 shapefile\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">QGIS</a> \u662f\u4e00\u4e2a\u514d\u8d39\u7684\u8f6f\u4ef6\u5305\uff0c\u63d0\u4f9b Windows \u64cd\u4f5c\u7cfb\u7edf\u548c Mac \u64cd\u4f5c\u7cfb\u7edf\u7248\u672c\u3002QGIS \u901a\u8fc7\u5176<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u7f51\u7ad9</a>\u63d0\u4f9b\u57f9\u8bad\u6750\u6599\uff0c\u53ef\u4ee5\u5728<a href=\"{{2}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8fd9\u91cc</a>\u627e\u5230\u5404\u79cd\u8bed\u8a00\u7684\u8865\u5145\u6559\u7a0b\u3002<a href=\"{{3}}\" target=\"_blank\" rel=\"noreferrer noopener\">ArcGIS</a> \u662f\u4e00\u6b3e\u53ef\u7528\u4e8e Windows \u64cd\u4f5c\u7cfb\u7edf\u7684\u4e13\u6709\u8f6f\u4ef6\uff0c\u662f\u76ee\u524d\u6700\u5f3a\u5927\u7684 GIS \u8f6f\u4ef6\u5305\u4e4b\u4e00\u3002<a href=\"{{4}}\" target=\"_blank\" rel=\"noreferrer noopener\">ArcGIS \u5e2e\u52a9\u7f51\u7ad9</a>\u662f\u4e00\u4e2a\u5f88\u597d\u7684\u8d44\u6e90\uff0c\u5bf9\u4e8e\u8be5\u8f6f\u4ef6\u4f7f\u7528\u63d0\u4f9b\u8fdb\u4e00\u6b65\u7684\u6307\u5357\uff0c\u8fd8\u63d0\u4f9b\u4e86\u53ef\u4f9b\u7528\u6237\u53c2\u8003\u7684 GIS \u57fa\u672c\u4fe1\u606f\u3002", "9241980bedbbd42a6adae25346b90301": "\u63a2\u7d22\u603b\u7ed3\u4e86 {adm2}, {adm1}, {location} \u68ee\u6797\u706b\u707e\u7684\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u5730\u56fe\u3002\u706b\u707e\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u5f53\u524d\u706b\u707e\u4e0e\u5386\u53f2\u8d8b\u52bf\u7684\u6bd4\u8f83\u2014\u2014\u53ef\u4ee5\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u548c\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "7b2437c04940ee823ef0e0b45ee14623": "\u70b9\u51fb\u5176\u4e2d\u4e00\u4e2a\u5706\u5708\u6765\u5728\u4f4d\u7f6e\u8b66\u62a5\u5730\u56fe\u4e0a\u8fdb\u884c\u653e\u5927\u3002\u5f53\u60a8\u653e\u5927\u4e00\u4e2a\u5706\u5708\u65f6\uff0c\u8be5\u5706\u5708\u4f1a\u5206\u6563\u6210\u66f4\u5c0f\u7684\u5706\u5708\u3002\u5706\u5708\u5927\u5c0f\u7684\u8be6\u7ec6\u8bf4\u660e\u5982\u4e0b\u3002", "b2ef8331c43d10b4c369f33c4cdfb5cd": "<strong>\u5c06\u4f4d\u7f6e\u79fb\u52a8\u5230\u4e00\u4e2a\u5217\u8868</strong>\uff1a\u5c06\u4f4d\u7f6e\u4ece\u539f\u6765\u7684\u5217\u8868\u79fb\u5230\u53e6\u4e00\u4e2a\u5217\u8868\u4e2d\u3002\u8fd9\u4e9b\u4f4d\u7f6e\u5c06\u4e0d\u518d\u51fa\u73b0\u5728\u539f\u6765\u7684\u5217\u8868\u4e2d\u3002\u60a8\u53ea\u80fd\u5c06\u4f4d\u7f6e\u79fb\u52a8\u5230\u5177\u6709\u76f8\u540c\u6a21\u677f\u7c7b\u578b\u7684\u5176\u4ed6\u5217\u8868\u4e2d\u3002\u5728<a href=\"{{0}}\">\u8fd9\u91cc</a>\u4e86\u89e3\u5982\u4f55\u9009\u62e9\u6b63\u786e\u7684\u6a21\u677f\u7c7b\u578b\u3002", "68a93a26a879412a8c6928bd792d69a4": "\u63a2\u7d22\u5b9e\u65f6\u706b\u707e\u8b66\u62a5\uff0c\u5e76\u6839\u636e\u5386\u53f2\u8d8b\u52bf\u786e\u5b9a\u706b\u707e\u6570\u91cf\u6700\u591a\u7684\u56fd\u5bb6\u3002\u4ea4\u4e92\u5f0f\u56fe\u8868\u53ef\u4ee5\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u548c\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "aea8c77611051b77b9f89fb9629ed859": "\u5bf9\u4e8e shapefile\u3001KML \u548c KMZ \u6587\u4ef6\uff0c\u60a8\u5fc5\u987b\u5df2\u7ecf\u4ee5\u9002\u5f53\u7684\u683c\u5f0f\u548c\u6a21\u677f\u4fdd\u5b58\u4e86\u6570\u636e\u3002\u5c5e\u6027\u5b57\u6bb5\u540d\u79f0\u5fc5\u987b\u4e0e\u4f4d\u7f6e\u7f51\u9875\u4e0a\u5217\u51fa\u7684\u6a21\u677f\u4e2d\u7684\u5217\u6807\u9898\u76f8\u5339\u914d\uff0c\u5e76\u4e14\u5bf9\u4e8e shapefile\uff0c\u5c5e\u6027\u5b57\u6bb5\u540d\u79f0\u5fc5\u987b\u5305\u62ec GIS \u8f6f\u4ef6\u4e2d\u7684\u9002\u5f53\u5b57\u6bb5\uff0c\u5bf9\u4e8e KML \u548c KMZ \u6587\u4ef6\uff0c\u5219\u5fc5\u987b\u5305\u62ec Google Earth Engine \u4e2d\u7684\u9002\u5f53\u5b57\u6bb5\u3002\u4e0a\u4f20\u7684 Shapefile\u3001KML \u548c KMZ \u6587\u4ef6\u5927\u5c0f\u4e0d\u5f97\u8d85\u8fc7 5 MB\uff0c\u5e76\u4e14\u5305\u542b\u7684\u4f4d\u7f6e\u4e0d\u8d85\u8fc7 1500 \u4e2a\u3002Shapefile\u3001KML \u548c KMZ \u6587\u4ef6\u5fc5\u987b\u662f\u70b9\u6216\u591a\u8fb9\u5f62\uff0c\u4e0d\u80fd\u662f\u7ebf\u3002", "a84b240a58877ac470c2461c262cdae1": "\u70b9\u51fb\u201c\u67e5\u770b\u6d3b\u52a8\u65e5\u5fd7\u201d\u3002", "4bbbeb78dbc4f46637ebc2051f056bd8": "\u70b9\u51fb\u5de6\u4e0a\u89d2\u7684\u201c\u663e\u793a\u5217\u8868\u201d\u7136\u540e\u9009\u62e9\u60a8\u8981\u67e5\u770b\u7684\u5217\u8868\u3002\u5217\u8868\u5c06\u52a0\u8f7d\u5230\u5730\u56fe\u4e0a\uff0c\u5e76\u7a81\u51fa\u663e\u793a\u60a8\u7684\u4f4d\u7f6e\u3002", "91213acf4dfa39ecf42783c2566547cd": "\u9009\u62e9\u4f4d\u7f6e\u7c7b\u578b\u548c\u76f8\u5173\u7684\u5546\u54c1\u7c7b\u578b\u3002", "da5ca3f7f4cd406506d23af73a708ae2": "\u70b9\u51fb\u9876\u90e8\u83dc\u5355\u4e0a\u7684\u201c\u5730\u56fe\u201d\u6807\u7b7e\u3002\u5730\u56fe\u5c31\u4f1a\u51fa\u73b0\u3002", "9410c7ce758a84b8eaad766a219fb673": "\u4ece\u60a8\u7684\u5217\u8868\u4e2d\u70b9\u51fb\u4e00\u4e2a\u5f62\u72b6\u6765\u8fdb\u884c\u5206\u6790\u3002", "ce7de7e6a88ce31943e8ff1db97daa7d": "\u63a5\u6536\u5171\u4eab\u5217\u8868", "62d9c932344b8b3bb948f6776692739a": "<strong>\u4f9b\u5e94\u5e93</strong>\uff1a\u52a0\u5de5\u5382\u3001\u50a8\u5b58\u8bbe\u65bd\u6216\u6536\u96c6\u70b9\u5468\u56f4\u7684\u91c7\u8d2d\u533a\u57df\u3002\n", "e845291e8792af3348e82c4c586543d8": "\u60a8\u53ef\u4ee5\u53cc\u51fb\u5b57\u6bb5\u8ba1\u7b97\u5668\u6587\u672c\u6846\u4e0a\u65b9\u5217\u8868\u4e2d\u7684\u5b57\u6bb5\u6765\u5c06\u503c\u4ece\u4e00\u4e2a\u5b57\u6bb5\u590d\u5236\u5230\u53e6\u4e00\u4e2a\u5b57\u6bb5\u3002", "dd9969c3c6353c0574feca1c3a4a564a": "\u8981\u7f16\u8f91 shapefile\uff0c\u8bf7\u4ece\u7f16\u8f91\u5de5\u5177\u680f\u4e2d\u9009\u62e9\u201c\u7f16\u8f91\u5668\u201d\uff0c\u7136\u540e\u9009\u62e9\u201c\u5f00\u59cb\u7f16\u8f91\u201d\u5e76\u9009\u62e9\u6b63\u786e\u7684\u5c42\u3002\u70b9\u51fb\u201c\u5220\u9664\u201d\u952e\uff0c\u7136\u540e\u8fd4\u56de\u7f16\u8f91\u5de5\u5177\u680f\u4e0a\u7684\u83dc\u5355\u6765\u5173\u95ed\u7f16\u8f91\u5668\u3002\u7cfb\u7edf\u5c06\u63d0\u793a\u60a8\u4fdd\u5b58\u60a8\u7684\u5de5\u4f5c\u2014\u2014\u8fd9\u5c06\u4e0d\u4f1a\u4ece\u65b0\u7684 shapefile \u4e2d\u5220\u9664\u5fc5\u9700\u7684\u5217\u3002", "dd8c64a93809c148d6c27302da5f49c8": "\u5706\u5708\u989c\u8272\u8868\u793a\u5728\u4e00\u4e2a\u4f4d\u7f6e\u5185\u6216\u5468\u56f4\u7684\u8b66\u62a5\u5bc6\u5ea6\u3002\u7070\u8272\u8868\u793a\u6ca1\u6709\u8986\u76d6\u6216\u9519\u8bef\uff0c\u7eff\u8272\u8868\u793a\u6ca1\u6709\u8b66\u62a5\u6216\u4f4e\u8b66\u62a5\u5bc6\u5ea6\uff0c\u9ec4\u8272\u8868\u793a\u4e2d\u7b49\u8b66\u62a5\u5bc6\u5ea6\uff0c\u6a59\u8272\u8868\u793a\u9ad8\u8b66\u62a5\u5bc6\u5ea6\u3002", "9b786af7f1c4df99c0430f2f7b3cb398": "\u5bf9\u4e8e VIIRS \u706b\u707e\u8b66\u62a5\uff0c\u60a8\u53ef\u4ee5\u67e5\u770b\u4e0a\u4e00\u5929\u6216\u4e0a\u4e00\u5468\u7684\u8b66\u62a5\u3002", "70bf9d0b7cb7c4c3b1cc926b4dfd5462": "\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u5220\u9664\u201d\u56fe\u6807\u5e76\u786e\u8ba4\u5220\u9664\u3002", "808d1a7653e0161efdf63b1f3bbf4eae": "\u60a8\u5c06\u88ab\u5e26\u5230\u8868\u683c\u89c6\u56fe\u6765\u7f16\u8f91\u60a8\u9009\u62e9\u7684\u4f4d\u7f6e\u3002\u7f16\u8f91\u4f4d\u7f6e\u65f6\uff0c\u8bf7\u70b9\u51fb\u94c5\u7b14\u56fe\u6807\u6240\u6307\u793a\u7684\u53ef\u7f16\u8f91\u5b57\u6bb5\uff0c\u66f4\u6539\u4fe1\u606f\uff0c\u7136\u540e\u70b9\u51fb\u201c\u66f4\u65b0\u201d\u3002\u5982\u679c\u6709\u9a8c\u8bc1\u9519\u8bef\uff0c\u5b83\u4eec\u5c06\u663e\u793a\u4e3a\u7ea2\u8272\uff0c\u5e76\u51fa\u73b0\u5728\u201c\u6709\u9519\u8bef\u7684\u4f4d\u7f6e\u201d\u6807\u7b7e\u4e2d\u2014\u2014\u60a8\u53ef\u4ee5\u5c06\u9f20\u6807\u60ac\u505c\u5728\u8fd9\u4e9b\u9519\u8bef\u4e0a\u4ee5\u83b7\u53d6\u66f4\u591a\u4fe1\u606f\u3002\u5982\u679c\u60a8\u7684\u5217\u8868\u4e2d\u5b58\u5728\u9a8c\u8bc1\u9519\u8bef\uff0c\u201c\u66f4\u65b0\u201d\u56fe\u6807\u5c06\u663e\u793a\u4e3a\u7981\u7528\u72b6\u6001\u3002", "32b5826a5feb964859b943a6c3f22930": "\u5982\u679c\u60a8\u5728\u5c1d\u8bd5\u4e0a\u4f20\u591a\u8fb9\u5f62\u6570\u636e\u65f6\u9047\u5230\u95ee\u9898\uff0c\u6216\u8005\u5982\u679c\u60a8\u65e0\u6cd5\u8fd0\u884c\u8f6f\u4ef6\u4e2d\u7684\u4efb\u4f55\u5de5\u5177\uff0c\u5219\u60a8\u7684\u6570\u636e\u4e2d\u53ef\u80fd\u5b58\u5728\u51e0\u4f55\u5f62\u72b6\u9519\u8bef\u3002\u5728\u8f6f\u4ef6\u4e2d\u7ed8\u5236\u591a\u8fb9\u5f62\u65f6\u5fc5\u987b\u9075\u5faa\u67d0\u4e9b\u89c4\u5219\uff0c\u8fd9\u4e9b\u95ee\u9898\u5f88\u5e38\u89c1\u3002QGIS \u548c ArcGIS \u90fd\u6709\u5de5\u5177\u53ef\u4ee5\u5bf9\u60a8\u7684\u6570\u636e\u8fdb\u884c\u4fee\u590d\uff0c\u4f46\u60a8\u5e94\u8be5\u68c0\u67e5\u8fd9\u4e9b\u9519\u8bef\u662f\u5426\u626d\u66f2\u4e86\u591a\u8fb9\u5f62\u7684\u8fb9\u754c\u3002\u901a\u5e38\u60c5\u51b5\u4e0b\uff0c\u8fd9\u4e9b\u626d\u66f2\u975e\u5e38\u5c0f\uff0c\u4e0d\u4f1a\u5f71\u54cd\u5728 Pro \u4e0a\u7684\u5206\u6790\u3002", "a8b1cdb6069de3943e0cb0c767bd9d8c": "\u70b9\u51fb \u201c\u2026\u201d \u83dc\u5355\u7136\u540e\u9009\u62e9\u201c\u7ba1\u7406\u201d\u6765\u5c06\u4e00\u4e2a\u5217\u8868\u79fb\u52a8\u5230\u53e6\u4e00\u4e2a\u6587\u4ef6\u5939\u3002\n", "079dbf60196e58d6a05df324bdc4e252": "Pro \u53ef\u4ee5\u4e3a\u4efb\u4f55\u5904\u7406\u8fc7\u7684\u5217\u8868\u5206\u6790\u68ee\u6797\u53d8\u5316\u3002\n", "12fca0bab71eeb0a0817842836d477cc": "\u5982\u679c\u60a8\u6b63\u5728\u5904\u7406\u7684\u662f\u591a\u8fb9\u5f62\u6570\u636e\uff0c\u5219\u8fd9\u4e2a\u95ee\u9898\u53ef\u80fd\u662f\u7531\u51e0\u4f55\u5f62\u72b6\u9519\u8bef\u5f15\u8d77\u7684\u3002\u8bf7\u53c2\u9605\u672c\u6559\u7a0b\u672b\u5c3e\u7684\u201c\u4fee\u590d\u51e0\u4f55\u5f62\u72b6\u9519\u8bef\u201d\u90e8\u5206\u6765\u83b7\u5f97\u66f4\u591a\u4fe1\u606f\u3002", "2d0c05431669ce9341b450132cc379f1": "\u5ba1\u67e5 shapefile", "85129cacc7ce87f19a1b1a5b475cba0a": "\u67d0\u4e9b\u4f4d\u7f6e\u5c06\u663e\u793a\u201c0\u201d\u6216\u201cNA\u201d\u8b66\u62a5\u7ed3\u679c\u3002\u5982\u679c\u60a8\u7684\u4f4d\u7f6e\u5728 GLAD \u548c/\u6216 VIIRS \u672a\u8986\u76d6\u7684\u533a\u57df\uff0c\u5219 Pro \u5c06\u663e\u793a\u201cNA\u201d\u8b66\u62a5\u7ed3\u679c\u3002\u5982\u679c\u60a8\u7684\u4f4d\u7f6e\u88ab GLAD \u548c/\u6216 VIIRS \u8986\u76d6\uff0c\u4f46\u6240\u9009\u65f6\u95f4\u6bb5\u5185\u7684\u8b66\u62a5\u6570\u636e\u4e0d\u53ef\u7528\u548c/\u6216\u6240\u9009\u65f6\u95f4\u6bb5\u5185\u672a\u53d1\u751f\u8b66\u62a5\uff0c\u5219 Pro \u5c06\u663e\u793a\u201c0\u201d\u8b66\u62a5\u7ed3\u679c\u3002\n", "72775f3ce6db93e49913a4e411b22b20": "\u5c06\u4f4d\u7f6e\u79fb\u52a8\u5230\u4e00\u4e2a\u73b0\u6709\u5217\u8868\u4e2d\u3002", "e7cfadbb803f59ac849a319deb9832f7": "\u4e00\u6b21\u6dfb\u52a0\u4e00\u4e2a\u4f4d\u7f6e", "abc1fd8c4d6530b96404685b9722432e": "\u4e0a\u4f20\u7b2c\u4e8c\u4e2a\u5217\u8868\u540e\uff0c\u60a8\u5c06\u770b\u5230\u4e00\u4e2a\u6a2a\u5e45\uff0c\u63d0\u793a\u60a8\u5c06\u5217\u8868\u6574\u7406\u5230\u6587\u4ef6\u5939\u4e2d\u3002", "990280580c46e1ef672b4fa18aaad4db": "\u9009\u62e9\u60a8\u60f3\u628a\u60a8\u9009\u5b9a\u7684\u5217\u8868\u6dfb\u52a0\u5230\u54ea\u4e2a\u6587\u4ef6\u5939\u3002", "2001e03e4471a7cb007d1e462a0d0200": "\u5728\u7f51\u9875\u9876\u90e8\uff0c\u60a8\u5c06\u770b\u5230\u4e0e\u60a8\u7684\u4f4d\u7f6e\u76f8\u5173\u7684\u5386\u53f2\u7279\u5f81\u4ee5\u53ca\u60a8\u7684\u4f4d\u7f6e\u7684\u5730\u56fe\u3002\u70b9\u51fb\u5730\u56fe\uff0c\u5728\u5730\u56fe\u89c6\u56fe\u4e0a\u67e5\u770b\u60a8\u7684\u4f4d\u7f6e\u3002\n", "8045a0a6c688b0635e3caccc408a1446": "\u901a\u7528", "2c51e2a26eb5a45068ed018619161776": "\u63a2\u7d22\u9010\u6b65\u6307\u5357\uff0c\u4e86\u89e3\u5982\u4f55\u4f7f\u7528 GFW Pro (Pro) \u6765\u5b89\u5168\u5730\u7ba1\u7406\u5546\u54c1\u4f9b\u5e94\u94fe\u548c\u6295\u8d44\u4e2d\u7684\u68ee\u6797\u780d\u4f10\u98ce\u9669\u3002", "1c1491f9430dddf6b3082b835826a4c8": "GFW \u7684\u4e94\u4e2a\u5217\u8868\u5728 Pro \u4e0a\u7684\u8fd0\u4f5c\u65b9\u5f0f\u7565\u6709\u4e0d\u540c\u3002\n", "73c83064dcf68a50ae1164059e2d9632": "\u5728\u5185\u90e8\u5171\u4eab\u5217\u8868", "5e922f11b6b6f73440abec3571f50db7": "\u9ed8\u8ba4\u60c5\u51b5\u4e0b\uff0c\u5168\u7403\u89c6\u56fe\u5904\u4e8e\u5f00\u542f\u72b6\u6001\u3002\u6bcf\u4e2a\u56fd\u5bb6\u663e\u793a\u4e00\u4e2a\u5706\u5708\u3002", "54491e615eeb4e5dadae3a6bc5ef7ce4": "\u4e00\u6b21\u6dfb\u52a0\u591a\u4e2a\u4f4d\u7f6e", "9a24057c911fe08ff4bbbba723f9861c": "\u8981\u505c\u6b62\u4e0e\u67d0\u4e2a\u7528\u6237\u5171\u4eab\u5217\u8868\uff0c\u8bf7\u70b9\u51fb\u201c\u5171\u4eab\u201d\u5e76\u70b9\u51fb\u7528\u6237\u540d\u79f0\u65c1\u8fb9\u7684\u201cX\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201cOK\u201d\u4e88\u4ee5\u786e\u8ba4\u3002", "9fb9fea1ab9b8899b0eb15409bea033c": "\u7528\u6237\u540d *", "9f4fc9f0cec0ab57a84ad78c1d366e90": "\u7136\u540e\uff0cPro \u5c06\u5bf9\u60a8\u6dfb\u52a0\u7684\u4f4d\u7f6e\u8fdb\u884c\u5206\u6790\u3002\u60a8\u5c06\u88ab\u5bfc\u822a\u56de\u5230\u4f4d\u7f6e\u7f51\u9875\uff0c\u90a3\u91cc\u4f1a\u51fa\u73b0\u4e00\u4e2a\u6a2a\u5e45\uff0c\u8868\u660e\u6b63\u5728\u5bf9\u60a8\u7684\u5217\u8868\u8fdb\u884c\u5206\u6790\u3002\u5206\u6790\u5f00\u59cb\u65f6\u548c\u5206\u6790\u5b8c\u6210\u540e\uff0c\u60a8\u5c06\u6536\u5230\u4e00\u5c01\u7535\u5b50\u90ae\u4ef6\u3002\u60a8\u53ef\u4ee5\u5728\u4f4d\u7f6e\u7f51\u9875\u4e0a\u7684\u201c\u6211\u7684\u5217\u8868\u201d\u4e0b\u67e5\u770b\u5206\u6790\u7ed3\u679c\u3002\u5728<a href=\"{{0}}\">\u8fd9\u91cc</a>\u4e86\u89e3\u5173\u4e8e\u5206\u6790\u4f4d\u7f6e\u548c\u5217\u8868\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u5728<a href=\"{{1}}\">\u8fd9\u91cc</a>\u4e86\u89e3\u5173\u4e8e\u8fd1\u5b9e\u65f6\u76d1\u63a7\u4f4d\u7f6e\u7684\u66f4\u591a\u4fe1\u606f\u3002", "590dd6d978c15825604bab0f5c9f0b4b": "\u8981\u5728\u5217\u8868\u89c6\u56fe\u4e2d\u5bf9\u6bcf\u4e00\u5217\u8fdb\u884c\u6392\u5e8f\uff0c\u8bf7\u70b9\u51fb\u5217\u6807\u9898\u3002\u518d\u6b21\u70b9\u51fb\u5217\u6807\u9898\uff0c\u53ef\u4ee5\u5728\u591a\u79cd\u6392\u5e8f\u4e4b\u95f4\u5207\u6362\uff0c\u5305\u62ec\u6570\u5b57\u4ece\u6700\u5c0f\u5230\u6700\u5927\u3001\u5b57\u6bcd\u4ece A-Z \u4ee5\u53ca\u65e5\u671f\u4ece\u6700\u65e9\u5230\u6700\u665a\u3002\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u5730\u56fe\u201d\uff0c\u5728\u5730\u56fe\u89c6\u56fe\u4e0a\u67e5\u770b\u60a8\u7684\u5217\u8868\u4f4d\u7f6e\u3002", "0ad59ee924381f6e23393fc10cb1c300": "\u767b\u5f55 Pro\u3002", "505fc142f878233aa25dc0f4a3b2a2b1": "\u5728\u4f4d\u7f6e\u7f51\u9875\u7684\u201c\u6211\u7684\u6587\u4ef6\u5939\u201d\u4e0b\u8bbf\u95ee\u6587\u4ef6\u5939\u3002", "141c4232855434944903ab4139e6ee69": "\u9009\u62e9\u60a8\u60f3\u8981\u7684\u4f4d\u7f6e\uff0c\u70b9\u51fb\u201c\u5220\u9664\u201d\uff0c\u7136\u540e\u786e\u8ba4\u5220\u9664\u3002", "0a7799875d4c6e9a49e1c28476892e5e": "\u70b9\u51fb\u201c\u6863\u6848\u201d\u6765\u67e5\u770b\u548c\u7f16\u8f91\u7ec4\u7ec7\u4fe1\u606f\u3002", "97805927fa83fcfbd278f85f50c4940c": "\u521b\u5efa\u4e00\u4e2a\u538b\u7f29\u6587\u4ef6\u5939\u6765\u5b58\u50a8\u60a8\u7684 shapefile\uff0c\u5e76\u786e\u4fdd\u5b83\u5305\u542b\u6240\u6709\u5fc5\u8981\u7684\u7ec4\u4ef6\u3002shapefile \u4e0d\u662f\u4e00\u4e2a\u5355\u4e2a\u7684\u6587\u4ef6\u2014\u2014\u5b83\u7531\u591a\u4e2a\u6587\u4ef6\u7ec4\u6210\uff0c\u8fd9\u4e9b\u6587\u4ef6\u5b9a\u4e49\u4e86\u5b83\u7684\u51e0\u4f55\u5f62\u72b6\u3001\u4f4d\u7f6e\u3001\u6295\u5f71\u548c\u5c5e\u6027\u3002\u538b\u7f29\u6587\u4ef6\u5939\u5fc5\u987b\u5305\u62ec .shp\u3001.shx\u3001.prj \u548c .dbf \u6587\u4ef6\uff0c\u800c\u4e14\u6240\u6709\u6587\u4ef6\u5fc5\u987b\u5171\u4eab\u540c\u4e00\u4e2a\u540d\u79f0\u3002", "5fc527c4b574e51f39333b6afd648a9a": "\u7f16\u8f91\u7ec4\u7ec7\u4fe1\u606f", "658d4678f31b1bb91cd8bb68305865f8": "\u5728\u7535\u5b50\u8868\u683c\u4e2d\u586b\u5165\u7b2c 5 \u884c\u4ee5\u4e0b\u7684\u6570\u636e\uff0c\u7136\u540e\u5220\u9664\u8bf4\u660e\u884c\uff08\u7b2c 2-5 \u884c\uff09\u3002\u5982\u679c\u672a\u5220\u9664\u8bf4\u660e\u884c\uff0cPro \u5c06\u65e0\u6cd5\u6210\u529f\u4e0a\u4f20\u6a21\u677f\u3002", "c89984a0ac6a3dd8ba74d58605186b50": "\u70b9\u51fb\u201c\u6dfb\u52a0\u5217\u201d\u7136\u540e\u9009\u62e9\u60a8\u60f3\u67e5\u770b\u7684\u989d\u5916\u5b57\u6bb5\u3002", "64abd34def2886d133fe3f925805c084": "<strong>\u4fdd\u62a4\u533a</strong>\uff1a\u6765\u81ea<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u4e16\u754c\u4fdd\u62a4\u533a\u6570\u636e\u5e93</a>\u7684\u53d7\u6cd5\u5f8b\u4fdd\u62a4\u6216\u7ba1\u7406\u7684\u533a\u57df\uff0c\u5305\u62ec\u56fd\u5bb6\u516c\u56ed\u548c\u91ce\u751f\u52a8\u7269\u4fdd\u62a4\u533a\u3002\u7531\u4e8e\u4f7f\u7528\u9650\u5236\uff0c\u4fdd\u62a4\u533a\u4e0d\u80fd\u5728 Pro \u4ee5\u5916\u4e0b\u8f7d\u3002", "fd3048c893be39868ee42f549eee1dcb": "\u4f5c\u4e3a\u60a8\u6240\u5728\u7ec4\u7ec7\u7684 Pro \u8d26\u6237\u7ba1\u7406\u5458\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u65b9\u5f0f\u81ea\u5b9a\u4e49\u7ec4\u7ec7\u8d26\u6237\uff0c\u4f7f\u5176\u6700\u7b26\u5408\u60a8\u7684\u9700\u6c42\u3002", "b852c8b7fbba06f81becd7b59999f125": "\u4ece\u73b0\u6709\u7684 GFW \u5217\u8868\u4e2d\uff08\u5373\u884c\u653f\u533a\u57df\u3001\u6cb9\u68d5\u6988\u7279\u8bb8\u6743\u3001\u68d5\u6988\u6cb9\u5382\u3001\u4fdd\u62a4\u533a\u3001RSPO \u6cb9\u68d5\u6988\u7279\u8bb8\u6743\uff09\u521b\u5efa\u81ea\u5b9a\u4e49\u5217\u8868\u3002", "a2601974c1f830400d220d5e0caf0c9c": "<strong>\u5546\u54c1\u98ce\u9669\u5206\u6790</strong>\u9610\u660e\u4e86\u68d5\u6988\u6cb9\u5de5\u5382\u4e0e\u68ee\u6797\u780d\u4f10\u76f8\u5173\u7684\u98ce\u9669\u3002", "208d7fecf97e29a4b0257ecb069b37d8": "\u8981\u51c6\u5907\u4e00\u4e2a shapefile\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u4e94\u4e2a\u6b65\u9aa4\u8fdb\u884c\u64cd\u4f5c\u3002", "fe1f636b83baeffd7a2ec09518a81ab8": "\u521b\u5efa\u4e00\u4e2a\u65b0\u8d26\u6237", "585be3868ada2d570b4d7773fc12d5c5": "Pro \u56e2\u961f\u5c06\u5728\u6240\u6709\u65b0\u8d26\u6237\u7533\u8bf7\u63d0\u4ea4\u540e\u7684\u4e24\u4e2a\u5de5\u4f5c\u65e5\u5185\u8fdb\u884c\u5ba1\u6838\u3002\u60a8\u53ef\u80fd\u4f1a\u6536\u5230\u6211\u4eec\u56e2\u961f\u7684\u7535\u5b50\u90ae\u4ef6\uff0c\u8981\u6c42\u60a8\u63d0\u4f9b\u8865\u5145\u4fe1\u606f\u8ba9\u6211\u4eec\u4e86\u89e3\u60a8\u5bf9 Pro \u7684\u5174\u8da3\u3002", "f39c1005efcc9a6e4b58a8760e05e5eb": "\u5bfc\u51fa\u5217\u8868", "e886006027dfc03552d9d74ae423840b": "KML/KMZ \u6587\u4ef6\u7684\u6295\u5f71\u9700\u8981\u5728 World Geodetic System 1984 (WGS84) \u4e2d\u3002\u5e78\u8fd0\u7684\u662f\uff0cKML/KMZ \u6587\u4ef6\u5728\u521b\u5efa\u65f6\u5df2\u7ecf\u9ed8\u8ba4\u4f7f\u7528\u8fd9\u4e2a\u6295\u5f71\u3002", "26b85f5c8251f94e6192823390e266cb": "\u6709\u51e0\u4e2a\u5de5\u5177\u53ef\u4ee5\u7528\u6765\u5728\u60a8\u7684\u6570\u636e\u4e2d\u6dfb\u52a0\u6240\u9700\u5b57\u6bb5\u3002\u6700\u5feb\u7684\u65b9\u6cd5\u662f\u5c06\u60a8\u7684\u6570\u636e\u4e0e\u6a21\u677f shapefile \u6587\u4ef6\u5408\u5e76\u3002\u8fd9\u5c06\u521b\u5efa\u4e00\u4e2a\u65b0\u7684 shapefile \u6587\u4ef6\uff0c\u5176\u4e2d\u5305\u542b\u6570\u636e\u5c5e\u6027\u548c\u7279\u5f81\u4ee5\u53ca\u6240\u9700\u5b57\u6bb5\u3002\u4f46\u662f\uff0c\u8fd9\u6837\u505a\u5c06\u4ece\u6a21\u677f\u4e2d\u589e\u52a0\u4e00\u4e2a\u9700\u8981\u5220\u9664\u7684\u989d\u5916\u7279\u5f81\u3002\u4e0b\u9762\u7684\u6b65\u9aa4\u5c06\u6307\u5bfc\u60a8\u5b8c\u6210\u6574\u4e2a\u8fc7\u7a0b\u3002\u5982\u679c\u4e0d\u5c0f\u5fc3\u5220\u9664\u4e86\u5176\u4e2d\u4e00\u4e2a\u5b57\u6bb5\uff0c\u60a8\u53ef\u4ee5\u624b\u52a8\u5c06\u5176\u6dfb\u52a0\u5230\u5c5e\u6027\u8868\u4e2d\u3002\u5982\u679c\u4f7f\u7528\u5408\u5e76\u5de5\u5177\u65f6\uff0c\u60a8\u7684\u8f6f\u4ef6\u6807\u8bb0\u4e86\u9519\u8bef\uff0c\u8bf7\u68c0\u67e5\u4ee5\u4e0b\u51e0\u4e2a\u65b9\u9762\u3002", "c353030336c37e688264a8c0f87ce89d": "\u6d4f\u89c8\u5173\u4e8e GFW Pro (Pro) \u7684\u7528\u6237\u652f\u6301\u95ee\u9898\uff0c\u8fdb\u4e00\u6b65\u4e86\u89e3\u8be5\u5de5\u5177\u53ca\u5176\u7279\u5f81\u6570\u636e\u5982\u4f55\u5e2e\u52a9\u7ba1\u7406\u5546\u54c1\u4f9b\u5e94\u94fe\u4e2d\u7684\u68ee\u6797\u780d\u4f10\u98ce\u9669\u3002", "10ffe339d4ea00d1359c18609665156b": "\u641c\u7d22 GFW \u535a\u5ba2", "a0d10dc72454e9704234bd05bebc4fde": "\u8981\u7b5b\u9009\u8be5\u8868\u683c\uff0c\u8bf7\u70b9\u51fb\u201c\u9009\u62e9\u7b5b\u9009\u5668\u201d\uff0c\u7136\u540e\u9009\u62e9\u60a8\u504f\u597d\u7684\u7b5b\u9009\u5668\u3002\u5b8c\u6210\u540e\uff0c\u8bf7\u70b9\u51fb\u201c\u5e94\u7528\u7b5b\u9009\u8fc7\u6ee4\u5668\u201d\u3002\u8981\u67e5\u770b\u5df2\u5e94\u7528\u7684\u7b5b\u9009\u5668\uff0c\u8bf7\u5c06\u9f20\u6807\u60ac\u505c\u5728\u7b5b\u9009\u5668\u56fe\u6807\u4e0a\uff1a\u8981\u6e05\u9664\u7b5b\u9009\u5668\uff0c\u8bf7\u70b9\u51fb\u7b5b\u9009\u5668\u56fe\u6807\u65c1\u7684\u201cX\u201d\u3002", "fd3765edd7b0c10ce2457c32420ade53": "\u7ea2\u8272\u8f6e\u5ed3\u7ebf\u8868\u793a\u6709\u9519\u8bef\u7684\u5355\u5143\u683c\u3002", "bbcca3ec08b260bafe16fd201b79d2de": "<strong>\u68d5\u6988\u6cb9\u901a\u7528</strong>\uff1a\u63a8\u8350\u7528\u4e8e UML \u4e2d\u672a\u5217\u51fa\u7684\u68d5\u6988\u6cb9\u5de5\u5382\u3002", "cd90ee93a7678228017e22f32fff9e21": "\u5728 {startYear} \u548c {endYear} \u4e4b\u95f4\uff0c<strong>\u5168\u7403</strong>\u68ee\u6797\u6392\u653e\u4e86 {totalEmissions}<b>/\u5e74</b>\uff0c\u53bb\u9664\u4e86 {totalRemovals}<b>/\u5e74</b>\u3002\u8fd9\u8868\u660e\u51c0\u78b3\u901a\u91cf\u4e3a {totalFlux}<b>/\u5e74</b>\u3002", "9e07b15534d4a089b9ab60c9e6f5cd66": "\u7f16\u8f91\u548c\u5220\u9664\u4e0e\u7ec4\u7ec7\u8d26\u6237\u4e2d\u6240\u6709\u7528\u6237\u76f8\u5173\u8054\u7684\u4f4d\u7f6e\u3002", "6fe9067db832904dbf38e7491fb31ad3": "\u70b9\u51fb\u4f4d\u7f6e\u8b66\u62a5\u5730\u56fe\u53f3\u4e0a\u65b9\u7684\u201c\u67e5\u770b\u5730\u56fe\u201d\u6765\u5728\u5730\u56fe\u89c6\u56fe\u4e0a\u52a0\u8f7d\u60a8\u9009\u62e9\u7684\u8b66\u62a5\u3002\u5728<a href=\"{{0}}\">\u8fd9\u91cc</a>\u4e86\u89e3\u66f4\u591a\u5173\u4e8e\u5982\u4f55\u5728 Pro \u4e0a\u4f7f\u7528\u5730\u56fe\u7684\u4fe1\u606f\u3002\u52a0\u8f7d\u5730\u56fe\u89c6\u56fe\u540e\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u7f51\u9875\u9876\u90e8\u7684\u5217\u8868\u540d\u79f0\u5bfc\u822a\u56de\u5230\u4eea\u8868\u677f\u3002", "f9bdf10f3c5bdb366ea00849c7a792e5": "\u8fd0\u884c\u5546\u54c1\u98ce\u9669\u8bca\u65ad", "9ba4df65bc6743e768f37287fbacc016": "\u70b9\u51fb QGIS \u7a97\u53e3\u9876\u90e8\u83dc\u5355\u4e2d\u7684\u201c\u77e2\u91cf\u201d\uff0c\u7136\u540e\u9009\u62e9\u201c\u6570\u636e\u7ba1\u7406\u5de5\u5177\u201d\u548c\u201c\u5408\u5e76\u77e2\u91cf\u5c42\u201d\u3002\u9009\u62e9\u60a8\u7684\u6570\u636e\u548c\u6a21\u677f shapefile \u6587\u4ef6\u4f5c\u4e3a\u8f93\u5165\u4fe1\u606f\uff0c\u7136\u540e\u8fd0\u884c\u8be5\u5de5\u5177\u3002", "74a2732377ef7f6c5dcc92d5c08b94e9": "\u6570\u636e\u548c\u7814\u7a76 (197)", "a5c781fb5fe7c56e115a7c223fb39c80": "\u9009\u62e9\u60a8\u60f3\u67e5\u770b\u7684\u8b66\u62a5\u6570\u636e\u5c42\u7684\u7c7b\u578b\u3002", "57bab2f23c83f84d7055d22bafb4426f": "<strong>\u666e\u901a\u5546\u54c1</strong>\uff1a\u63a8\u8350\u7528\u4e8e\u6a21\u677f\u4e0b\u62c9\u83dc\u5355\u4e2d\u672a\u5217\u51fa\u7684\u4efb\u4f55\u5546\u54c1\u3002", "2285689d31386b2f547a670103a5a073": "\u70b9\u51fb\u9876\u90e8\u83dc\u5355\u4e0a\u7684\u201c\u4eea\u8868\u677f\u201d\u6807\u7b7e\u3002\u70b9\u51fb\u5de6\u4e0a\u65b9\u7684\u201c\u663e\u793a\u5217\u8868\u201d\u7136\u540e\u9009\u62e9\u60a8\u60f3\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u7684\u5217\u8868\u3002\u60a8\u7684\u4f4d\u7f6e\u53ef\u80fd\u9700\u8981\u51e0\u5206\u949f\u7684\u65f6\u95f4\u624d\u80fd\u52a0\u8f7d\u5230\u4f4d\u7f6e\u8b66\u62a5\u5730\u56fe\u4e0a\u3002", "e428449cc3a76389290d6b24edef801a": "\u5728\u60a8\u7684\u8d26\u6237\u5185\u63a5\u6536\u6765\u81ea\u7ba1\u7406\u5458\u7684\u5171\u4eab\u5217\u8868\u3002", "554f3a3cd8541678f917fa377ca4e5db": "\u5f53\u60a8\u7684\u4f4d\u7f6e\u52a0\u8f7d\u5b8c\u6bd5\u540e\uff0c\u6709\u51e0\u79cd\u65b9\u6cd5\u53ef\u4ee5\u4f7f\u7528\u4eea\u8868\u677f\u5730\u56fe\uff0c\u5177\u4f53\u5185\u5bb9\u89c1\u4ee5\u4e0b\u5404\u8282\u3002\n", "d4d84f3372e90ae20fa78c5132be157e": "\u53f3\u952e\u5355\u51fb\u76ee\u5f55\u4e2d\u7684 shapefile \u4ee5\u6253\u5f00\u5c5e\u6027\u8868\u3002\u201c\u5f62\u72b6\u201d\u5b57\u6bb5\u5e94\u8be5\u663e\u793a\u201c\u70b9\u201d\u6216\u201c\u591a\u8fb9\u5f62\u201d\u3002", "88427cf6d11347320f439d8330f26094": "\u5728 ArcGIS \u4e0a\u5c06\u60a8\u7684\u6570\u636e\u4e0e\u6a21\u677f shapefile \u6587\u4ef6\u5408\u5e76", "fa633754acda102982a4dde86529504a": "<strong>\u5927\u8c46\u519c\u573a</strong>\uff1a\u63a8\u8350\u7528\u4e8e\u4f9b\u5e94\u94fe\u4e2d\u7684\u5927\u8c46\u519c\u573a\u4f4d\u7f6e\u3002", "60d803a96c41cc2d0ecd1da30f35382b": "\u7f16\u8f91\u60a8\u7684\u5217\u8868", "451cb71baf50c6b19b85e903dfe7bb00": "\u8981\u4fdd\u5b58\u60a8\u7684\u4f4d\u7f6e\uff0c\u60a8\u53ef\u4ee5\u521b\u5efa\u4e00\u4e2a\u65b0\u7684\u5217\u8868\u6216\u5c06\u4f4d\u7f6e\u6dfb\u52a0\u5230\u4e00\u4e2a\u73b0\u6709\u5217\u8868\u4e2d\u3002\u60a8\u53ea\u80fd\u5c06\u4f4d\u7f6e\u6dfb\u52a0\u5230\u5177\u6709\u76f8\u540c\u5546\u54c1\u6a21\u677f\u683c\u5f0f\u6216\u901a\u7528\u5546\u54c1\u6a21\u677f\u4e2d\u5177\u6709\u76f8\u540c\u5546\u54c1\u7c7b\u578b\u548c\u4f4d\u7f6e\u5206\u7c7b\u7684\u73b0\u6709\u5217\u8868\u4e2d\u3002\u5982\u679c\u60a8\u60f3\u8fd4\u56de\u5230\u4e0a\u4f20\u8fc7\u7a0b\u4e2d\u7684\u4e4b\u524d\u7684\u6b65\u9aa4\uff0c\u8bf7\u70b9\u51fb\u5c4f\u5e55\u5de6\u4fa7\u60a8\u60f3\u8fd4\u56de\u7684\u6b65\u9aa4\u3002\u5b8c\u6210\u540e\uff0c\u8bf7\u70b9\u51fb\u201c\u63d0\u4ea4\u201d\u3002", "38eb6309c6ce13b7e0fd16c8eb340066": "\u6253\u5f00 KML/KMZ \u6587\u4ef6\u6765\u68c0\u67e5\u5176\u51e0\u4f55\u5f62\u72b6\u3002KML/KMZ \u6587\u4ef6\u5e94\u8be5\u53ea\u4f7f\u7528\u591a\u8fb9\u5f62\u6216\u70b9\u51e0\u4f55\u5f62\u72b6\u3002\u5982\u679c\u5b83\u5305\u542b\u7ebf\u6761\u51e0\u4f55\u5f62\u72b6\u6216\u4efb\u4f55\u989d\u5916\u7684\u7279\u5f81\uff0c\u5982\u56fe\u50cf\u6216 HTML\uff0c\u5219\u53ef\u80fd\u9700\u8981\u91cd\u65b0\u521b\u5efa KML/KMZ \u6587\u4ef6\u4ee5\u5220\u9664\u4e0d\u88ab\u63a5\u53d7\u7684\u7279\u5f81\u3002", "59ab304437cf499dc13c2108f46c950d": "\u70b9\u51fb\u201c\u4e0b\u8f7d\u6570\u636e\u201d\u6765\u8bbf\u95ee\u6570\u636e\u6e90\u548c\u5916\u90e8\u7f51\u7ad9\u4ee5\u4fbf\u83b7\u53d6\u60a8\u5206\u6790\u7684\u201c\u68ee\u6797\u53d8\u5316\u201d\u6570\u636e\u3002\u4f8b\u5982\uff0c\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u7387\u635f\u5931\u3001\u6811\u6728\u8986\u76d6\u7387\u589e\u52a0\u548c GLAD \u68ee\u6797\u780d\u4f10\u8b66\u62a5\u5c06\u94fe\u63a5\u5230\u9a6c\u91cc\u5170\u5927\u5b66\u7684\u7f51\u9875\uff0c\u60a8\u53ef\u4ee5\u4ece\u90a3\u91cc\u4e0b\u8f7d\u6570\u636e\u3002", "a02f0a08f0a88435fbf0ab3e19235607": "<strong>\u68d5\u6988\u6cb9\u5de5\u5382</strong>\uff1a\u5168\u7403\u68d5\u6988\u6cb9\u5de5\u5382\u7684\u884c\u4e1a\u6807\u51c6\u3002", "ed5b8d2dc30ff6f19baad6f33169df82": "\u70b9\u51fb\u201c\u7533\u8bf7\u8d26\u6237\u201d\u3002", "a0ecbe20fe6c2a59a482cc9200b2f523": "\u60a8\u53ef\u4ee5\u901a\u8fc7\u952e\u5165\u8868\u8fbe\u5f0f\u5e76\u5c06\u5176\u7f6e\u4e8e\u5355\u5f15\u53f7 (\u2018 \u2019) \u5185\u6765\u8f93\u5165\u6587\u672c\u503c\u3002\u60a8\u4e0d\u80fd\u7528\u6587\u672c\u586b\u5199\u6570\u5b57\u5b57\u6bb5\u3002", "238866dcf201409c246e5d64ed9ce70d": "\u201c\u884c\u653f\u533a\u57df\u201d\u548c\u201c\u4fdd\u62a4\u533a\u57df\u201d\u5217\u8868\u5c06\u63d0\u793a\u60a8\u5728\u5230\u8fbe\u5217\u8868\u89c6\u56fe\u4e4b\u524d\u7b5b\u9009\u8fd9\u4e9b\u4f4d\u7f6e\u3002\u8fd9\u4e9b\u5217\u8868\u76ee\u524d\u6ca1\u6709\u5728 Pro \u4e0a\u8fdb\u884c\u9884\u5148\u8ba1\u7b97\u3002", "6e1e9ecbecfa44402e5dabd13044439c": "\u8981\u89c2\u5bdf\u7684\u5730\u65b9 (6)", "ca29cd19327325cadcece55035bf83c2": "\u63a2\u7d22\u603b\u7ed3\u4e86 {adm1}, {location} \u68ee\u6797\u53d8\u5316\u7387\u7684\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u5730\u56fe\u3002\u7edf\u8ba1\u6570\u636e\u2014\u2014\u5305\u62ec\u68ee\u6797\u51cf\u5c11\u548c\u589e\u52a0\u6700\u591a\u7684\u5730\u533a\u7684\u6392\u540d\u2014\u2014\u53ef\u4ee5\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u548c\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002\t", "9c9eee7e23f95b06ebb7378fbc5f371c": "<strong>\u4e0b\u8f7d</strong>\uff1a\u5c06\u60a8\u7684\u539f\u59cb\u6587\u4ef6\u4e0b\u8f7d\u4e3a CSV \u6216 shapefile \u6587\u4ef6\u3002", "ffce78076ac3ad565be7c904ca75d09c": "{location} \u4e0e\u68ee\u6797\u76f8\u5173\u7684\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf", "3c33931318c4e3ea79adb22329229537": "\u8981\u51c6\u5907\u4e00\u4e2a Excel \u6216 CSV \u6a21\u677f\u6587\u4ef6\u4ee5\u4f9b\u4e0a\u4f20\uff0c\u8bf7\u6309\u7167\u4e0b\u9762\u4e24\u4e2a\u6b65\u9aa4\u64cd\u4f5c\u3002\t", "e2c2a8251876627e0d1a40bfe8507084": "<strong>\u5c06\u4f4d\u7f6e\u590d\u5236\u5230\u5217\u8868\u4e2d</strong>\u3002\u5c06\u4f4d\u7f6e\u590d\u5236\u5230\u4e00\u4e2a\u73b0\u6709\u6216\u65b0\u5217\u8868\u4e2d\u3002\u8fd9\u4e9b\u4f4d\u7f6e\u5c06\u4fdd\u7559\u5728\u539f\u5217\u8868\u4e2d\u3002\u60a8\u53ea\u80fd\u5c06\u4f4d\u7f6e\u590d\u5236\u5230\u5177\u6709\u76f8\u540c\u6a21\u677f\u7c7b\u578b\u7684\u5176\u4ed6\u5217\u8868\u4e2d\u3002\u5728<a href=\"{{0}}\">\u8fd9\u91cc</a>\u4e86\u89e3\u5982\u4f55\u9009\u62e9\u6b63\u786e\u7684\u6a21\u677f\u7c7b\u578b\u3002", "dd38b513f36a559c53eb24d4fedff5d5": "\u5982\u679c\u60a8\u60f3\u4ece\u5730\u56fe\u89c6\u56fe\u4e2d\u79fb\u9664\u5730\u56fe\u8bbe\u7f6e\u5de5\u5177\uff0c\u8bf7\u70b9\u51fb\u5730\u56fe\u53f3\u4e0b\u65b9\u7684\u773c\u775b\u56fe\u6807\u3002\u518d\u6b21\u70b9\u51fb\u773c\u775b\u56fe\u6807\u5373\u53ef\u8ba9\u8fd9\u4e9b\u9009\u9879\u50cf\u4e4b\u524d\u4e00\u6837\u663e\u793a\u3002", "416c43fcced79b85aacae9ec1394affb": "\u70b9\u51fb\u201c\u63d0\u4ea4\u201d\u4e0a\u4f20\u5217\u8868\u65f6\uff0c\u6709\u9519\u8bef\u7684\u4f4d\u7f6e\u5c06\u88ab\u5220\u9664\u3002", "36cfa8870e42d4f02ca98889638fbd23": "\u70b9\u51fb \u201c\u2026\u201d \u83dc\u5355\u8fdb\u5165\u4ee5\u4e0b\u9009\u9879\u3002\n", "2b1f0b3e7174969340f5bfdb442d0cca": "\u5728 QGIS \u4e0a\u5c06\u60a8\u7684\u6570\u636e\u4e0e\u6a21\u677f shapefile \u5408\u5e76", "239f64eff5be7ee0f2b7b13b745c5e12": "<strong>\u5468</strong>\uff1a\u663e\u793a\u4e00\u5468\u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u3002\u6bcf\u5468\u8b66\u62a5\u6bcf\u4e2a\u661f\u671f\u4e09\u66f4\u65b0\u4e00\u6b21\u3002", "ff744bd2e8e3cc848b130b309f841055": "\u9009\u62e9\u8981\u663e\u793a\u7684\u8b66\u62a5\u7c7b\u578b", "c24546c1656a167f209f5d423c9a1689": "\u5728\u6d4f\u89c8\u5668\u9762\u677f\u4e0a\u53f3\u952e\u5355\u51fb\u8f93\u5165 shapefile \u6587\u4ef6\u5e76\u9009\u62e9\u5c42\u5c5e\u6027\u3002\u5728\u5c42\u5c5e\u6027\u7a97\u53e3\u4e2d\uff0c\u53ef\u4ee5\u5728\u5143\u6570\u636e\u6807\u7b7e\u4e0b\u7684\u201c\u6765\u81ea\u63d0\u4f9b\u8005\u7684\u4fe1\u606f\u201d\u4e2d\u627e\u5230\u51e0\u4f55\u5f62\u72b6\u4fe1\u606f\u3002", "265bb11baa3570283ed5b3888773fbeb": "\u5728<a href=\"{{0}}\">\u8fd9\u91cc</a>\u4e86\u89e3\u66f4\u591a\u5173\u4e8e Pro \u8fd1\u5b9e\u65f6\u76d1\u63a7\u7684\u4fe1\u606f\u3002\n", "2be3148847a5107465e47fd1747e7408": "\u9009\u62e9\u8be5\u4f4d\u7f6e\u662f\u6295\u8d44\u8fd8\u662f\u5546\u54c1\u6765\u5f00\u59cb\u4e0a\u4f20\u5df2\u5b8c\u6210\u7684\u6a21\u677f\u6587\u4ef6\uff0c\u7136\u540e\u9009\u62e9\u4e0e\u6a21\u677f\u5339\u914d\u7684\u5546\u54c1\u7c7b\u578b\u3002\u4f4d\u7f6e\u7c7b\u578b\u548c\u5546\u54c1\u7c7b\u578b\u5fc5\u987b\u4e0e\u60a8\u6b63\u5728\u4e0a\u4f20\u7684\u6a21\u677f\u5b8c\u5168\u5339\u914d\uff0c\u5426\u5219 Pro \u5c06\u7ed9\u51fa\u201c\u6a21\u677f\u7c7b\u578b\u4e0d\u6b63\u786e\u201d\u7684\u9519\u8bef\u6d88\u606f\u3002\u5bf9\u4e8e\u5546\u54c1\u4f4d\u7f6e\uff0c\u6bcf\u4e2a\u6a21\u677f\u80fd\u4e0a\u4f20\u4e00\u79cd\u5546\u54c1\u7c7b\u578b\u3002\u4f46\u662f\uff0c\u5bf9\u4e8e\u6295\u8d44\u4f4d\u7f6e\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u201c\u591a\u79cd\u201d\u4f5c\u4e3a\u5546\u54c1\u7c7b\u578b\uff0c\u5e76\u5728\u6a21\u677f\u6587\u4ef6\u4e2d\u5305\u542b\u5404\u79cd\u5546\u54c1\u7c7b\u578b\u3002\u9009\u62e9\u540e\uff0c\u8bf7\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\u3002", "18590e4c416804fa4ab89375e0ef106a": "\u8bbf\u95ee\u5546\u54c1\u98ce\u9669\u5217\u8868\u89c6\u56fe", "af69c3fbdfeda7291cf2f09085cbee21": "\u5728\u5730\u56fe\u4e0a\u6dfb\u52a0\u548c\u5220\u9664\u6570\u636e\u5c42", "e90114d04761329d667ef631d41206cb": "\u66f4\u6539\u57fa\u7840\u5730\u56fe\u53ef\u4ee5\u8ba9\u60a8\u5728\u4e0d\u540c\u7684\u5730\u56fe\u80cc\u666f\u4e0b\u67e5\u770b\u6570\u636e\u3002\u8981\u81ea\u5b9a\u4e49\u57fa\u7840\u5730\u56fe\uff0c\u8bf7\u70b9\u51fb\u5206\u6790/\u57fa\u7840\u5730\u56fe\u9762\u677f\u4e0a\u7684\u57fa\u7840\u5730\u56fe\u6807\u7b7e\u3002", "88c204da0dd2a41f153c387e43b05d81": "\u6c14\u5019 (37)", "5c780b80899fe2ee32041a225b877023": "\u6700\u540e\u4e00\u5c42\u662f\u6b21\u56fd\u5bb6\u89c6\u56fe\u3002\u5b83\u5c06\u6bcf\u4e2a\u5355\u72ec\u7684\u8b66\u62a5\u663e\u793a\u4e3a\u81ea\u5df1\u7684\u5706\u5708\u3002", "7070395981d37c5492878a61de4c65d2": "<strong>\u6708</strong>\uff1a\u663e\u793a\u8fc7\u53bb\u56db\u5468\u7684\u8b66\u62a5\u3002\u6708\u5ea6\u8b66\u62a5\u6bcf\u5468\u4e09\u66f4\u65b0\u4e00\u6b21\u3002", "2187112bfd0770f36189ea6a93d5de03": "\u4f7f\u7528\u201c\u8bca\u65ad\u201d\u65c1\u8fb9\u7684\u4e0b\u62c9\u83dc\u5355\u8bbf\u95ee\u68d5\u6988\u6cb9\u5de5\u5382\u548c\u68d5\u6988\u6cb9\u901a\u7528\u5217\u8868\u7684\u5546\u54c1\u98ce\u9669\u8bca\u65ad\u3002", "868481187bcec94d4d66e9b7eb9e303b": "\u8981\u4e0a\u4f20\u60a8\u7684\u6a21\u677f\u6587\u4ef6\uff0c\u8bf7\u4ece\u60a8\u7684\u7535\u8111\u62d6\u653e\uff0c\u6216\u8005\u70b9\u51fb\u201c\u6d4f\u89c8\u201d\u7136\u540e\u4ece\u60a8\u7684\u7535\u8111\u4e0a\u9009\u62e9\u3002\u5982\u679c\u60a8\u8bd5\u56fe\u4e0a\u4f20\u7684\u6587\u4ef6\u4e0d\u88ab\u63a5\u53d7\uff0c\u7cfb\u7edf\u5c06\u63d0\u793a\u60a8\u91cd\u65b0\u4e0a\u4f20\u8be5\u6587\u4ef6\u3002\u6587\u4ef6\u5185\u7684\u4f4d\u7f6e\u5fc5\u987b\u5c11\u4e8e 1500 \u4e2a\uff0c\u5e76\u4e14\u6587\u4ef6\u9700\u5c0f\u4e8e 5 MB\u3002\u53ef\u63a5\u53d7\u7684\u6587\u4ef6\u7c7b\u578b\u5305\u62ec\uff1aCSV \u6216 Excel\u3001\u5305\u542b shapefile (.shp, .dbf, .prj) \u7684 .Zip \u6587\u4ef6\u4ee5\u53ca KML/KMZ\u3002\u4e0a\u4f20\u540e\uff0c\u8bf7\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\u3002", "66b7b6e21297eddad1006e56d5ffa520": "\u5982\u679c\u60a8\u7684\u6570\u636e\u4e2d\u7684\u67d0\u4e2a\u7279\u5f81\u4e0e GADM \u6570\u636e\u4e2d\u7684\u4efb\u4f55\u56fd\u5bb6\u90fd\u4e0d\u91cd\u53e0\uff0c\u5219\u60a8\u9700\u8981\u5220\u9664\u5b83\u6216\u7f16\u8f91\u5b83\u7684\u4f4d\u7f6e\u3002\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8fd9\u91cc</a>\u67e5\u770b\u5173\u4e8e\u5728 QGIS \u4e2d\u7f16\u8f91\u6570\u636e\u7684\u8865\u5145\u4fe1\u606f\u3002", "5261f57b78ebc64948663668c15789b3": "\u5bf9\u4e8e\u5728 ArcGIS \u4e2d\u521b\u5efa\u7684 shapefile\uff0c\u60a8\u5fc5\u987b\u6ee1\u8db3\u6240\u6709<a rel=\"noreferrer noopener\" href=\"{{0}}\" target=\"_blank\">\u6807\u51c6\u8981\u6c42</a>\u3002\n", "f1f4f64efec1fd781582669966c43217": "\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u79fb\u52a8\u201d\u56fe\u6807\u7136\u540e\u9009\u62e9\u201c\u590d\u5236\u201d\u3002\u5bf9\u4e8e\u6765\u81ea GFW \u7684\u5217\u8868\uff0c\u53ea\u6709\u201c\u590d\u5236\u201d\u53ef\u7528\u3002", "0a0295507fdd5450bb9169cacc806538": "\u5206\u6790\u5b8c\u6210\u540e\u4e14\u60a8\u7684\u5217\u8868\u53ef\u7528\u65f6\uff0c\u60a8\u5c06\u6536\u5230\u7b2c\u4e8c\u5c01\u7535\u5b50\u90ae\u4ef6\u3002", "6b160822cfea4fbf628358ca201e008b": "\u8bc6\u522b\u6b63\u5728\u53d1\u751f\u8b66\u62a5\u7684\u5730\u65b9", "792719c209d7d4786c79fb4670e1b438": "\u5728\u672c\u793a\u4f8b\u4e2d\uff0c\u6211\u4eec\u5bf9 RADD \u8b66\u62a5\u611f\u5174\u8da3\uff0c\u56e0\u6b64\uff0c\u6211\u4eec\u5c06\u4f7f\u7528 {{0}} \u6570\u636e\u96c6\u540d\u79f0\u3002", "750cf470171ff66e205c70a0e24fe666": "Forest Watcher \u6587\u6863\u7684\u5bfc\u51fa\u62a5\u544a\u4e8e 2019 \u5e74 5 \u6708\u521b\u5efa\uff0c\u6f14\u793a\u4e86\u5982\u4f55\u5728\u8bbe\u5907\u4e0a\u5bfc\u51fa\u4fdd\u5b58\u5728 Forest Watcher \u79fb\u52a8\u5e94\u7528\u7684\u62a5\u544a\u3002", "8f95dcfc6449ab2ba5c936f9d0581faa": "\u653e\u5927\u5230\u6709\u6bc1\u6797\u8b66\u62a5\u7684\u533a\u57df\uff0c\u8be5\u533a\u57df\u4f1a\u4ee5\u7c89\u8272\u900f\u660e\u6b63\u65b9\u5f62\u663e\u793a\u3002\u6b63\u65b9\u5f62\u5927\u5c0f\u53ef\u80fd\u4f1a\u56e0\u8b66\u62a5\u7cfb\u7edf \u800c\u5f02\u3002\u91cd\u53e0\u7684\u6b63\u65b9\u5f62\u4ee3\u8868\u8be5\u533a\u57df\u88ab\u591a\u4e2a\u8b66\u62a5\u7cfb\u7edf\u8bc6\u522b\u51fa\u6709\u68ee\u6797\u53d8\u5316\u7684\u53ef\u80fd\u3002", "eaf3754cc096ed35e18d18d4dae5fabf": "\u5982\u679c\u60a8\u60f3\u6267\u884c\u9700\u8981\u8eab\u4efd\u9a8c\u8bc1\u7684\u64cd\u4f5c\uff0c\u4f46\u5f53\u524d\u7684\u7528\u6237\u6ca1\u6709\u5fc5\u9700\u6743\u9650\uff0c\u8bf7\u901a\u8fc7 gfw@wri.org \u8054 \u7cfb\u6211\u4eec\u3002", "1b90bfcb0e4a4854a576c5c9952539ee": "\u6211\u4eec\u5c06\u4f7f\u7528 {{0}} \u5173\u952e\u8bcd\u67e5\u8be2\u6b64\u6570\u636e\u96c6\u7684\u6700\u65b0\u7248\u672c\u3002", "281bcfbcef97f5e7616d8337c74957b6": "\u9009\u9879 1:\u5728 GFW \u7f51\u7ad9\u4e0a\u6ce8\u518c MyGFW \u8d26\u6237", "8acef2d10e6bbdfdce37930722466b0d": "\u70b9\u51fb\u7eff\u8272\u7684\u5f00\u59cb\u56fe\u6807\uff0c\u8ddf\u8e2a\u60a8\u7684\u8def\u7ebf\u3002", "b27040fdb75dce0235e6e31326eaddcb": "HAkA \u521b\u5efa\u4e86\u4e00\u4efd GFW \u548c Forest Watcher \u6307\u5357\uff0c\u6f14\u793a\u5982\u4f55\u4f7f\u7528\u5730\u56fe\u548c Forest Watcher Web\uff0c\u4ee5\u53ca\u5982\u4f55\u5c06\u6570\u636e\u4e0a\u4f20\u81f3 Google Maps\u3002", "70d2db00a389eab83f49413ae4e25b97": "\u5728\u4ee5\u4e0b\u793a\u4f8b\u4e2d\uff0c\u6211\u4eec\u5c06\u53d1\u9001\u4e00\u4e2a\u8bf7\u6c42\uff0c\u603b\u7ed3\u4e00\u4e2a\u81ea\u5b9a\u4e49\u51e0\u4f55\u5728 2019 \u5e74\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u3002", "25cbaf2175a07e78f8931d2d82df8e0d": "\u793a\u4f8b:\u83b7\u53d6\u67d0\u4e00\u65e5\u671f\u8303\u56f4\u5185 RADD \u6bc1\u6797\u8b66\u62a5\u7684\u5750\u6807", "352239e8a2d902379035497badf3004e": "MapBuilder \u514d\u8d39 ArcGIS Online \u516c\u5171\u8d26\u6237\u6559\u7a0b\u4e8e 2019 \u5e74 11 \u6708\u521b\u5efa\uff0c\u6f14\u793a\u5982\u4f55\u4f7f\u7528 ArcGIS Online \u516c\u5171\u8d26\u6237\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\u3002", "e8c4becd4979ae838b0a0e4987efbaad": "\u4e86\u89e3\u6b64\u8bf7\u6c42\u7684\u57fa\u672c\u7247\u6bb5", "d6db8e70806bd64f1ec24b74567bb461": "The Rainforest Journalism Fund (RJF) \u4e0e\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240 (WRI) \u5408\u4f5c\uff0c\u4e3a\u5728\u521a\u679c\u76c6\u5730\u5de5\u4f5c\u7684 \u65b0\u95fb\u5de5\u4f5c\u8005\u4eec\u7ec4\u7ec7\u4e86\u4e00\u573a\u7f51\u7edc\u7814\u8ba8\u4f1a\u3002", "de709f5aaae617f2b88e5a741bfefd42": "\u9009\u9879 2:\u4f7f\u7528 GFW Data API \u6ce8\u518c MyGFW \u8d26\u6237", "94b6da4a29e6c7f9dd28c2a20116a700": "\u67e5\u8be2\u6570\u636e\u96c6\u65f6\uff0c\u60a8\u53ef\u80fd\u9700\u8981\u52a0\u4e0a SQL \u8bed\u53e5\uff0c\u6309\u5730\u7406\u4f4d\u7f6e\u548c/\u6216\u65f6\u95f4\u5bf9\u5176\u8fdb\u884c\u7b5b\u9009\u3002\u4e0d\u8fc7\uff0c\u60a8 \u5f97\u77e5\u9053\u6570\u636e\u96c6\u6709\u54ea\u4e9b\u5b57\u6bb5\uff0c\u624d\u80fd\u6b63\u786e\u8bbe\u7f6e\u6b64\u8bed\u53e5\u7684\u683c\u5f0f\u3002\u4ee5\u4e0b URL \u5c55\u793a\u4e86\u5b9e\u73b0\u6b64\u64cd\u4f5c\u7684\u6b63 \u786e\u8bf7\u6c42\u683c\u5f0f\u3002\u5f69\u8272\u6587\u672c\u7a81\u51fa\u663e\u793a\u4e86\u8981\u66ff\u6362\u7684\u7247\u6bb5\u3002", "cafceaad20f0a992dde8cd840e4fd4a7": "\u8981\u5411 GFW Data API \u53d1\u8d77\u5927\u591a\u6570\u8bf7\u6c42\uff0c\u60a8\u9700\u8981\u5728\u540d\u4e3a x-api-key \u7684\u81ea\u5b9a\u4e49\u6807\u5934\u4e2d\u4f7f\u7528 API \u5bc6\u94a5\u3002\u6bd4\u5982\uff0c\u8fd9\u662f\u4e00\u4e2a\u5217\u51fa GFW Data API \u4e0a\u6240\u6709\u6570\u636e\u96c6\u7684\u8bf7\u6c42:", "89dc462f5960c055e613d1761166f207": "(d) \u5728\u5df2\u9009\u62e9\u81f3\u5c11\u4e00\u4e2a\u8b66\u62a5\u65f6\uff0c\u901a\u8fc7\u70b9\u51fb\u201c\u9009\u62e9\u5168\u90e8\u5df2\u8fde\u63a5\u8b66\u62a5\u201d\u56fe\u6807\u6765\u9009\u62e9\u4e00\u7ec4\u5df2\u8fde\u63a5\u8b66\u62a5\u3002", "6b8449b4da2d2cfd86860b3db188dfc0": "\u8bf7\u6ce8\u610f\uff0c\u6211\u4eec\u5df2\u4f7f\u7528\u201c\u6700\u65b0\u201d\u5173\u952e\u8bcd\u81ea\u52a8\u67e5\u8be2\u6b64\u6570\u636e\u96c6\u7684\u6700\u65b0\u7248\u672c\u3002", "04f5dff8da7ce3b493f6323d86c96502": "\u9996\u5148\uff0c\u9009\u62e9\u4e00\u4e2a\u8b66\u62a5\u6216\u4e00\u7ec4\u90bb\u63a5\u8b66\u62a5\uff0c\u6216\u4f7f\u7528\u53f3\u4e0b\u89d2\u7684\u56fe\u9489\u56fe\u6807\u653e\u7f6e\u56fe\u9489\uff0c\u5373\u53ef\u5f00\u59cb\u4ece\u5730\u56fe \u5bfc\u822a\u81f3\u76ee\u7684\u5730\u3002\u9009\u62e9\u8b66\u62a5\u80fd\u8ba9\u60a8\u76f4\u63a5\u5bfc\u822a\u81f3\u53ef\u80fd\u53d1\u751f\u68ee\u6797\u53d8\u5316\u7684\u533a\u57df\uff0c\u800c\u653e\u7f6e\u56fe\u9489\u5219\u80fd\u8ba9\u60a8 \u5bfc\u822a\u81f3\u4efb\u610f\u533a\u57df\uff0c\u6216\u662f\u4e3a\u6ca1\u6709\u8b66\u62a5\u7684\u533a\u57df\u521b\u5efa\u62a5\u544a\u3002", "239658e016e3d5d06ae719d280a79fec": "\u6570\u636e\u96c6", "cd18a3023452c67f367514cd9937de0f": "\u6211\u4eec\u53ef\u4ee5\u5bf9\u524d\u4e00\u4e2a\u793a\u4f8b\u7a0d\u4f5c\u66f4\u6539\uff0c\u53d8\u4e3a\u8bf7\u6c42\u8b66\u62a5\u6570\u91cf\u800c\u4e0d\u662f\u5355\u4e2a\u5750\u6807\u3002\u8981\u5b9e\u73b0\u6b64\u8bf7\u6c42\uff0c\u60a8\u53ef \u4ee5\u6309\u7167\u4e0a\u8ff0\u76f8\u540c\u7684\u6b65\u9aa4\u64cd\u4f5c\uff0c\u53ea\u4e0d\u8fc7\u8981\u66f4\u6539 body \u6570\u636e SQL \u90e8\u5206\u4e2d\u7684\u5b57\u7b26\u4e32\uff0c\u4ee5\u542b\u6709\u805a\u5408 \u51fd\u6570 {{0}}\uff0c\u5982\u4e0b\u6240\u793a:", "f8d7227ef0930f5ac1e8393b15fde4b6": "\u201c\u6700\u65b0\u201d\u7248\u672c\u5173\u952e\u8bcd", "34b6cd75171affba6957e308dcbd92be": "\u7248\u672c", "8e66a7d2aff09d90ebc97026873c2f8f": "\u793a\u4f8b:\u603b\u7ed3\u5355\u4e00\u5e74\u4efd\u5185\u7684\u6797\u6728\u8986\u76d6\u635f\u5931", "3858080ef7e50619062b7738b1026352": "\u6b64\u6f14\u793a\u4e8e 2020 \u5e74 10 \u6708\u521b\u5efa\uff0c\u6f14\u793a\u4e86\u79bb\u7ebf\u548c\u51fa\u5916\u4e1a\u65f6\u53ef\u5982\u4f55\u4f7f\u7528 ForestWatcher \u76d1\u6d4b\u68ee \u6797\u3002", "dddeb8d9541cd9f9e7b3fbb46fd72a4b": "5.\u53d1\u9001\u8bf7\u6c42", "0aaf9cffd7ab03eb9c6d77e95adeae77": "GFW Data API \u76ee\u5f55\u4ee5\u4e09\u7ea7\u5c42\u6b21\u7ed3\u6784\u7ec4\u7ec7\u4e86\u6570\u636e\u96c6\uff0c\u8be5\u5c42\u6b21\u7ed3\u6784\u7531\u6570\u636e\u96c6\u3001\u7248\u672c\u548c\u8d44\u4ea7\u7ec4\u6210", "b78ffd10f3642e91c3d1ac6487abb159": "\u8981\u9009\u62e9\u5355\u4e2a\u8b66\u62a5\uff0c\u8bf7\u70b9\u51fb\u4e00\u4e2a\u8b66\u62a5\u3002\u88ab\u9009\u4e2d\u65f6\uff0c\u8b66\u62a5\u4f1a\u53d8\u7eff\u3002\u8981\u53d6\u6d88\u9009\u4e2d\u7684\u8b66\u62a5\uff0c\u8bf7\u70b9\u51fb\u5730 \u56fe\u4e0a\u672a\u88ab\u8b66\u62a5\u8986\u76d6\u7684\u5176\u4ed6\u4efb\u610f\u90e8\u5206\u3002", "115bc4e20d899b3c2bd7ef3c44828c59": "GFW \u6280\u672f\u7814\u7a76\u5458 Madeleine Ngeunga \u521b\u5efa\u4e86\u4e00\u4efd GFW \u7528\u6237\u6307\u5357\uff0c\u6f14\u793a\u5728\u521a\u679c\u76c6\u5730\u7684\u65b0 \u95fb\u5de5\u4f5c\u8005\u53ef\u4ee5\u5982\u4f55\u4f7f\u7528\u5730\u56fe\u53ca\u64cd\u4f5c\u9762\u677f\u3002", "d247a08c26d2197d6a73eef48930a1f7": "\u672c\u6b21\u7f51\u7edc\u7814\u8ba8\u4f1a\u4e0a\uff0c\u6211\u4eec\u5c06\u6982\u8ff0 GFW \u4e0a\u7684\u53ef\u7528\u536b\u661f\u56fe\u50cf\u8d44\u6e90\u53ca\u5176\u4f7f\u7528\u8bf4\u660e\uff0c\u6df1\u5165\u4e86\u89e3 Planet \u7684\u9ad8\u5206\u8fa8\u7387\u536b\u661f\u56fe\u50cf\u4ee5\u53ca\u5982\u4f55\u5728 Planet Explorer \u4e2d\u8bbf\u95ee\u8fd9\u4e9b\u56fe\u50cf\uff0c\u4ee5\u53ca\u4e86\u89e3\u8fc7\u53bb\u8b66 \u62a5\u7cfb\u7edf\u662f\u5982\u4f55\u4e0e\u536b\u661f\u56fe\u50cf\u5339\u914d\u7684\u3002", "b8bac8fc9859b095bf3eb345b0725c40": "\u4e86\u89e3\u6570\u636e\u76ee\u5f55\u7684\u7ed3\u6784\u540e\uff0c\u60a8\u5c31\u53ef\u4ee5\u53d1\u73b0 GFW Data API \u4e2d\u7684\u6570\u636e\u96c6\u4e86\u3002", "9fe0dd7b67836b0744f0b0d5b304140d": "\u67e5\u8be2\u6d41\u5f0f\u6570\u636e", "c64c4987e79a6290c4500619acfa0b3d": "\u6210\u529f\u540e\uff0c\u60a8\u5c06\u6536\u5230\u5e26\u6709 {{0}} \u548c {{1}} \u5c5e\u6027\u7684 JSON \u54cd\u5e94\u3002\u60a8\u5c06\u5728 {{2}} \u5b50\u5c5e\u6027\u4e2d\u627e\u5230 API \u5bc6\u94a5\u7684\u503c:", "8935f3b6420b9adadf8e53b7613435f5": "\u8981\u4e86\u89e3\u5982\u4f55\u6b63\u786e\u8bbe\u7f6e\u67e5\u8be2\u7684 SQL \u8bed\u53e5\u683c\u5f0f\uff0c\u6211\u4eec\u9700\u8981\u4e86\u89e3\u6570\u636e\u96c6\u4e2d\u7684\u5b57\u6bb5\u3002\u6211\u4eec\u53ef\u4ee5\u4f7f\u7528 \u4ee5\u4e0b\u8bf7\u6c42\u83b7\u5f97\u7279\u5b9a\u6570\u636e\u96c6\u7684\u5b57\u6bb5:", "7f4a12c07edebdb2b4aaca43922a4bd2": "\u60a8\u5c06\u6536\u5230\u5e26\u6709 {{0}} \u548c {{1}} \u5c5e\u6027\u7684 JSON \u54cd\u5e94\uff0c\u8fd9\u80fd\u8868\u660e\u60a8\u7684\u8bf7\u6c42\u662f\u5426\u6210\u529f\u3002", "47e93caa5fa3391d3c98d5ec385687ad": "\u6240\u9644\u6307\u5357\u4e8e 2019 \u5e74 3 \u6708\u521b\u5efa\uff0c\u6f14\u793a\u5982\u4f55\u4f7f\u7528\u5730\u56fe\u548c Forest Watcher\u3002", "edeb82656e9b34ceed724cda4e792ef6": "\u6b64\u8bf7\u6c42\u7684\u54cd\u5e94\u5c06\u63d0\u4f9b\u4e00\u4e2a\u5217\u8868\uff0c\u5305\u542b\u6570\u636e\u96c6\u4e2d\u6240\u6709\u53ef\u7528\u5b57\u6bb5\u3002\u6839\u636e\u67e5\u8be2\u76ee\u7684\uff0c\u6700\u91cd\u8981\u7684\u5b57\u6bb5 \u662f {{0}}\uff0c\u8be5\u5b57\u6bb5\u80fd\u8ba9\u6211\u4eec\u6307\u5b9a\u611f\u5174\u8da3\u7684\u5e74\u4efd\u3002", "e313cb50ea9530388d22303e58eb4257": "\u60a8\u7684\u6388\u6743\u4ee4\u724c\u5c06\u5728\u4e00\u6bb5\u65f6\u95f4\u540e\u8fc7\u671f\u3002\u5982\u679c\u60a8\u8ba1\u5212\u4ee5\u7f16\u7a0b\u65b9\u5f0f\u5b9a\u671f\u8bbf\u95ee GFW Data API \u5e76\u6267 \u884c\u9700\u8981\u7528\u6237\u8eab\u4efd\u9a8c\u8bc1\u7684\u64cd\u4f5c\uff0c\u5219\u9700\u8981\u5b9e\u73b0\u91cd\u8bd5\u903b\u8f91\uff0c\u4ee5\u4fbf\u5728\u6388\u6743\u4ee4\u724c\u8fc7\u671f\u65f6\u5237\u65b0 Bearer Token\u3002", "ae1bcfb261f967d2a6ad51a11cc8933b": "\u60a8\u5c06\u6536\u5230\u4e00\u6761\u5e26\u6709\u72b6\u6001\u548c\u6570\u636e\u5c5e\u6027\u7684 JSON \u54cd\u5e94\u3002\u5728\u6570\u636e\u5c5e\u6027\u4e2d\uff0c\u60a8\u5c06\u770b\u5230\u4e00\u4e2a\u5217\u8868\uff0c\u5217 \u8868\u4e2d\u7684\u6bcf\u4e2a\u6761\u76ee\u4ee3\u8868\u5355\u4e2a\u6570\u636e\u96c6\uff0c\u6bcf\u4e2a\u6570\u636e\u96c6\u7684\u552f\u4e00\u540d\u79f0\u90fd\u50a8\u5b58\u5728\u5176\u6570\u636e\u96c6\u5c5e\u6027\u4e2d\u3002", "89b1887c8f13aa4bc7a6e63a1cd41656": "\u4e0b\u8868\u63cf\u8ff0\u4e86\u67e5\u8be2 GFW Data API \u65f6 POST \u8bf7\u6c42\u7684\u57fa\u672c\u7247\u6bb5", "e0229aacc1ec249539469fd6ffcb7360": "\u4ee3\u8868\u7531\u7ec4\u7ec7\u6216\u4e2a\u4eba\u751f\u6210\u7684\u67d0\u7c7b\u6570\u636e\u7684\u5bf9\u8c61\u3002\u8fd9\u4e00\u5bf9\u8c61\u5305\u542b\u6570\u636e\u7684\u603b\u4f53\u5143\u6570\u636e\uff0c\u4ee5\u53ca\u6570\u636e\u96c6\u7684 \u4e00\u4e2a\u6216\u591a\u4e2a\u7248\u672c", "2c762305789594aa5dd2dad2a16f280f": "\u6240\u9644\u624b\u518c\u4e8e 2019 \u5e74 11 \u6708\u521b\u5efa\uff0c\u6f14\u793a\u4e86\u79bb\u7ebf\u548c\u51fa\u5916\u4e1a\u65f6\u53ef\u5982\u4f55\u4f7f\u7528 ForestWatcher \u79fb\u52a8 \u5e94\u7528\u76d1\u6d4b\u68ee\u6797\u533a\u57df\u3002", "f427d6f7a9dcbc79251b4803974c88a4": "\u9009\u62e9\u76ee\u7684\u5730(\u6216\u4e00\u4e2a\u8b66\u62a5\u3001\u4e00\u7ec4\u8b66\u62a5\u3001\u6216\u56fe\u9489\u4f4d\u7f6e)\u540e\uff0c\u9875\u9762\u5e95\u90e8\u5c06\u51fa\u73b0\u56db\u4e2a\u56fe\u6807\u3002", "82b37e37f307195833ba0f9bfd070d6b": "\u83b7\u5f97\u5305\u542b\u6240\u6709\u6570\u636e\u96c6\u7684\u5217\u8868", "3f4f6b1301bc4e21b725d0e8b59027a5": "WomenResearchInstitute \u521b\u5efa\u4e86\u706b\u707e\u548c\u96fe\u973e\u7684\u5f71\u54cd\u6f2b\u753b\uff0c\u6f14\u793a\u706b\u707e\u4ea7\u751f\u7684\u96fe\u973e\u5bf9\u5370\u5ea6\u5c3c\u897f \u4e9a\u793e\u533a\u7684\u5f71\u54cd\uff0c\u4ee5\u53ca GFW \u8fd9\u7c7b\u9884\u8b66\u7cfb\u7edf\u53ef\u8d77\u5230\u600e\u6837\u7684\u5e2e\u52a9\u3002", "7f721ee5859435c0c75471f760baa914": "\u6210\u529f\u540e\uff0c\u60a8\u5c06\u6536\u5230\u5e26\u6709 {{0}} \u548c {{1}} \u5c5e\u6027\u7684 JSON \u54cd\u5e94\u3002\u5728\u672c\u793a\u4f8b\u4e2d\uff0c\u67e5\u8be2\u663e\u793a\uff0c2019 \u5e74\uff0c \u6211\u4eec\u7684\u81ea\u5b9a\u4e49\u51e0\u4f55\u7ea6\u6709 8ha \u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u3002", "72672eb9ad4ea69ad126b62f42494c79": "\u5728\u6570\u636e\u76ee\u5f55\u4e2d\u53d1\u73b0\u6570\u636e\u96c6", "5cf4aa97579fd88ed25e8276242452de": "GFW \u7528\u6237\u6307\u5357 - \u82f1\u6587", "5254df405df08ad67070d5b15b6e2f66": "\u8bbf\u95ee\u7279\u5b9a\u6570\u636e\u96c6\u5b57\u6bb5\u8be6\u60c5\u7684\u6807\u51c6\u683c\u5f0f", "345cb3d17b7b3d744b31dced71cc03f2": "2020 \u5e74\u4e5f\u662f\u8bb8\u591a\u7ec8\u6b62\u6bc1\u6797\u627f\u8bfa\u7684\u76ee\u6807\u5e74\u4efd\uff0c\u4f46\u8fd9\u4e9b\u627f\u8bfa\u5982\u4eca\u90fd\u5df2\u843d\u7a7a\u30022020 \u5e74\u5185\uff0c\u662f\u5426\u6709 \u8ff9\u8c61\u8868\u660e\u5404\u56fd/\u5404\u5730\u533a\u548c\u516c\u53f8\u53ef\u80fd\u5f00\u59cb\u8ba4\u771f\u5bf9\u5f85\u8fd9\u4e9b\u627f\u8bfa\u4e86\u5462?", "f2a55275f08e23c72918e3b1682e6c55": "(b) \u70b9\u51fb\u4e00\u4e2a\u6216\u591a\u4e2a\u8b66\u62a5\u3002\u6bc1\u6797\u8b66\u62a5\u88ab\u9009\u4e2d\u65f6\u4f1a\u53d8\u7eff;\u706b\u707e\u8b66\u62a5\u88ab\u9009\u4e2d\u65f6\u4f1a\u53d8\u84dd\u3002", "764479f6f4403175cfe622217be4bf32": "\u83b7\u53d6\u7279\u5b9a\u6570\u636e\u96c6\u7684\u8be6\u7ec6\u4fe1\u606f", "dfcc5a3c94ec7d15d99424af7f56c8f3": "\u5728 Global Forest Watch \u7f51\u7edc\u7814\u8ba8\u4f1a\u4e0a\u4f7f\u7528\u536b\u661f\u56fe\u50cf\u8c03\u67e5\u68ee\u6797\u780d\u4f10", "e3835004d1bfa33d08a7414ebbf49c34": "\u793a\u4f8b:\u83b7\u53d6\u67d0\u4e00\u65e5\u671f\u8303\u56f4\u5185 RADD \u6bc1\u6797\u8b66\u62a5\u7684\u6570\u91cf", "8553105f3d6208af96fdf1db45f12640": "GFWDataAPI \u76ee\u5f55\u4ee5\u4e09\u7ea7\u5c42\u6b21\u7ed3\u6784\u7ec4\u7ec7\u4e86\u6570\u636e\u96c6\uff0c\u8be5\u5c42\u6b21\u7ed3\u6784\u53ef\u901a\u8fc7\u4ee5\u4e0b\u65b9\u5f0f\u8fdb\u884c\u53ef\u89c6\u5316:", "8eae3a00af97875dea386374780bc99f": "MapBuilder ArcGIS Online \u7ec4\u7ec7\u8d26\u6237\u6559\u7a0b\u4e8e 2019 \u5e74 11 \u6708\u521b\u5efa\uff0c\u6f14\u793a\u5982\u4f55\u4f7f\u7528 ArcGIS Online \u7ec4\u7ec7\u8d26\u6237\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\u3002", "b5a7adde1af5c87d7fd797b6245c2a39": "\u63cf\u8ff0", "e072f88df2f4fa075601980982379648": "\u8bbf\u95ee\u7279\u5b9a\u6570\u636e\u96c6\u8be6\u7ec6\u4fe1\u606f\u7684\u6807\u51c6\u683c\u5f0f", "b1c7b04aee53799d190aed24579cf98e": "(a) \u653e\u5927\u5230\u60a8\u60f3\u5bfc\u822a\u524d\u5f80\u7684\u533a\u57df\u3002", "cc9c6a19ec64dd1914166c138444e574": "MapBuilder \u6f14\u793a\u5c06\u5f15\u5bfc\u60a8\u4f7f\u7528 ArcGIS Online \u516c\u5171\u8d26\u6237\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\uff0c\u9002\u7528 \u4e8e\u6240\u6709\u6280\u672f\u6c34\u5e73\u3002", "fb27fb287e001e663d41b1e1ed80d904": "GFW Data API \u63d0\u4f9b\u8bb8\u591a\u4e0d\u540c\u6570\u636e\u96c6\u7684\u8bbf\u95ee\u6743\u9650\uff0c\u7528\u6237\u53ef\u5bf9\u8fd9\u4e9b\u6570\u636e\u96c6\u8fdb\u884c\u53ef\u89c6\u5316\u3001\u5206\u6790\u548c \u4e0b\u8f7d\u3002\u672c\u6559\u7a0b\u5c06\u4ecb\u7ecd\u6570\u636e\u76ee\u5f55\u7684\u7ed3\u6784\uff0c\u4ee5\u53ca\u5982\u4f55\u53d1\u73b0\u8981\u4f7f\u7528\u7684\u7279\u5b9a\u6570\u636e\u96c6\u3002", "6fab147231933f59a796dfebd2d581b3": "\u60a8\u53ef\u4ee5\u4f7f\u7528\u201c\u6700\u65b0\u201d\u5173\u952e\u8bcd\u67e5\u8be2\u6700\u65b0\u7248\u672c\u7684\u6570\u636e\u96c6\uff0c\u800c\u4e0d\u662f\u6307\u660e\u6570\u636e\u96c6\u7684\u7279\u5b9a\u7248\u672c\u3002\u9664\u975e\u60a8\u975e \u5e38\u719f\u6089\u6570\u636e\u96c6\uff0c\u4e14\u5e0c\u671b\u4f7f\u7528\u67d0\u4e00\u7279\u5b9a\u7248\u672c\uff0c\u6211\u4eec\u5efa\u8bae\u60a8\u5728 API \u8bf7\u6c42\u4e2d\u4f7f\u7528\u6570\u636e\u96c6\u65f6\u59cb\u7ec8\u4f7f \u7528\u201c\u6700\u65b0\u201d\u5173\u952e\u8bcd\u3002\u7ee7\u7eed\u9605\u8bfb\uff0c\u67e5\u770b\u6b64\u5173\u952e\u8bcd\u793a\u4f8b\u3002", "ae4460ea849e4baf4893f23b01b44660": "1.\u786e\u5b9a\u60a8\u9700\u8981\u67e5\u8be2\u7684\u6570\u636e\u96c6", "033a669d553be84bfd365fe9b937f40c": "\u6280\u672f\u7814\u7a76\u5458 Abigail Frimpong \u521b\u5efa\u4e86 GFW \u57f9\u8bad\u5c0f\u8d34\u58eb\uff0c\u4e3a\u52a0\u7eb3\u7684\u793e\u533a\u8d44\u6e90\u7ba1\u7406\u9886\u57df\u63d0\u4f9b \u4e86\u68ee\u6797\u76d1\u6d4b\u6280\u5de7\u3002", "cbbde2f55577ce6923b01892d5a85aae": "\u8bf7\u8bb0\u4f4f\uff0c\u5982\u679c\u60a8\u5df2\u4f7f\u7528\u5173\u8054\u57df\u5217\u8868\u6ce8\u518c API \u5bc6\u94a5\uff0cOrigin \u6807\u5934\u7684\u503c\u5fc5\u987b\u4e0e\u5176\u4e2d\u67d0\u4e2a\u57df\u5339\u914d\u3002", "7a1131f7af354eaf6b2d433f590ed2ef": "\u5c5e\u6027\u7248\u672c", "97e9b4f4acffa12a4132f381fd9bff84": "\u5982\u679c\u60a8\u77e5\u9053\u67d0\u4e2a\u6570\u636e\u96c6\u7684\u552f\u4e00\u540d\u79f0\uff0c\u5c31\u53ef\u4ee5\u8f7b\u677e\u9650\u5236\u8bf7\u6c42\u4ee5\u83b7\u53d6\u6b64\u6570\u636e\u96c6\u7684\u8be6\u7ec6\u4fe1\u606f\u3002\u4ee5\u4e0b URL \u5c55\u793a\u4e86\u5b9e\u73b0\u6b64\u64cd\u4f5c\u7684\u6b63\u786e\u8bf7\u6c42\u683c\u5f0f\u3002\u7ea2\u8272\u6587\u672c\u7a81\u51fa\u663e\u793a\u4e86\u8981\u66ff\u6362\u6210\u6570\u636e\u96c6\u552f\u4e00\u540d\u79f0\u7684 \u7247\u6bb5\u3002", "8c3672c9e286eb65e8a17674e21d80a7": "\u4e0b\u8868\u5bf9\u8fd9\u4e9b\u7ec4\u4ef6\u5206\u522b\u4f5c\u51fa\u4e86\u63cf\u8ff0\u3002", "234308348ff4b61f4cdb45d1772bf87e": "\u60a8\u7684 API \u5bc6\u94a5\u5c06\u5728 1 \u5e74\u540e\u5230\u671f\u3002\u5982\u679c\u60a8\u9700\u8981\u66f4\u957f\u7684\u6709\u6548\u671f\uff0c\u6216\u4e0e\u5bc6\u94a5\u5173\u8054\u7684\u670d\u52a1\u914d\u989d\u672a\u80fd \u6ee1\u8db3\u60a8\u7684\u9700\u6c42\uff0c\u8bf7\u901a\u8fc7 gfw@wri.org \u8054\u7cfb\u6211\u4eec\u3002", "8b3924bdf2a604c74a4c7d48d36f5ffe": "4b.\u6784\u5efa SQL \u67e5\u8be2", "45ceeb3eb452a0a1cd635c7bad7c3968": "\u5728\u4ee5\u4e0b\u793a\u4f8b\u4e2d\uff0c\u6211\u4eec\u53d1\u9001\u4e86\u4e00\u4e2a\u8bf7\u6c42\uff0c\u83b7\u53d6 2021 \u5e74 1 \u6708 1 \u65e5\u81f3 2021 \u5e74 3 \u6708 15 \u65e5\u4e0a \u8ff0\u540c\u4e00\u81ea\u5b9a\u4e49\u533a\u57df\u7684\u5168\u90e8 RADD \u6bc1\u6797\u8b66\u62a5\u3002", "a9d4b04af59f065c4c9e4370ac493134": "\u70b9\u51fb\u7ea2\u8272\u7684\u505c\u6b62\u56fe\u6807\uff0c\u7ed3\u675f\u5f53\u524d\u8def\u7ebf\u3002", "a385d07592a42e741a9e717ad8bebaee": "\u4f8b\u5982\uff0c\u8981\u83b7\u5f97 {{0}} \u6570\u636e\u96c6\u6700\u65b0\u7248\u672c\u7684\u5b57\u6bb5\uff0c\u8bf7\u53d1\u9001\u4ee5\u4e0b GET \u8bf7\u6c42:", "ec21788cce1259b436c2220e9103c9df": "2.\u9009\u62e9\u6570\u636e\u96c6\u7248\u672c", "ff7c0fcd6a31e735a61c001f75426961": "\u793a\u4f8b", "265c199b47e18c9545649ffd467eba2e": "Sociedad Peruana de Derecho Ambiental (SPDA) \u521b\u5efa\u4e86\u79d8\u9c81\u4e9a\u9a6c\u5b59\u96e8\u6797\u9632\u6bc1\u6797\u624b\u518c\uff0c\u5c31\u79c1 \u4eba\u4fdd\u62a4\u533a\u6240\u6709\u8005\u5982\u4f55\u9884\u9632\u548c\u5e94\u5bf9\u6bc1\u6797\u5a01\u80c1\u63d0\u4f9b\u6307\u5bfc\u3002", "f6b81bb35b7a1fb21386d11179f6dddc": "\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240\u9a7b\u5580\u9ea6\u9686\u529e\u4e8b\u5904\u521b\u5efa\u4e86\u5229\u6bd4\u91cc\u4e9a\u68ee\u6797\u548c GLAD \u8b66\u62a5\u624b\u518c\uff0c\u4e3a\u5229\u6bd4\u91cc\u4e9a\u68ee\u6797 \u76d1\u6d4b\u65b9\u9762\u7684\u6280\u672f\u57f9\u8bad\u63d0\u4f9b\u652f\u6301\u3002", "96d99d89ed75f77603743fba252fa066": "\u6570\u636e\u96c6\u7684\u7279\u5b9a\u7248\u672c\uff0c\u53ef\u80fd\u4e0e\u6570\u636e\u96c6\u7684\u7279\u5b9a\u5e74\u4efd\u6216\u65b9\u6cd5\u6709\u5173\u3002\u7248\u672c\u62e5\u6709\u4e00\u9879\u6216\u591a\u9879\u8d44\u4ea7\uff0c\u4ee5\u4e0d \u540c\u683c\u5f0f\u5305\u542b\u4e86\u5b9e\u9645\u6570\u636e\u3002\u7248\u672c\u53ef\u4ee5\u6839\u636e\u9700\u8981\u8986\u5199\u6570\u636e\u96c6\u7684\u7279\u5b9a\u5143\u6570\u636e\u3002", "baf388727699e9a45a4bfc415dea0489": "\u8981\u9009\u62e9\u591a\u4e2a\u8b66\u62a5\uff0c\u8bf7\u5148\u70b9\u51fb\u4e00\u4e2a\u8b66\u62a5\uff0c\u7136\u540e\u7ee7\u7eed\u70b9\u51fb\u5176\u4ed6\u8b66\u62a5\u3002", "dbe42e9bdcd0a518f49c6522cb7c6ece": "\u5982\u679c\u60a8\u8ba1\u5212\u5728\u6e90\u81ea\u7279\u5b9a\u57df\u6216\u4e00\u7ec4\u57df\u7684\u8bf7\u6c42\u4e2d\u4f7f\u7528 API \u5bc6\u94a5\uff0c\u53ef\u4ee5\u5728\u201c\u57df\u201d\u5c5e\u6027\u4ee5\u9017\u53f7\u5206\u9694\u7684 \u6570\u7ec4\u4e2d\u6307\u660e\u8fd9\u4e9b\u57df\u3002\u60a8\u53ef\u4ee5\u4f7f\u7528\u661f\u53f7\u4f5c\u4e3a\u5b50\u57df\u7684\u5360\u4f4d\u7b26(\u4e5f\u79f0\u901a\u914d\u7b26\uff0c\u5982\uff0c*.yourdomain.com)\uff0c \u5982\u679c\u60a8\u6253\u7b97\u4f7f\u7528\u6ca1\u6709\u4efb\u4f55\u5b50\u57df\u7684\u6839\u57df\uff0c\u8bf7\u52a1\u5fc5\u6dfb\u52a0 yourdomain.com\u3002\u5c31\u5b89\u5168\u6027\u800c\u8a00\uff0c www.yourdomain.com \u548c yourdomain.com \u662f\u4e24\u79cd\u4e0d\u540c\u7684\u57df\uff0c\u5982\u6709\u9700\u8981\uff0c\u8bf7\u52a0\u4e0a www\u3002\u4e0e\n\u5df2\u6709\u6ce8\u518c\u57df\u7684 API \u5bc6\u94a5\u76f8\u6bd4\uff0c\u6ca1\u6709(\u4e00\u4e2a\u6216\u591a\u4e2a)\u6ce8\u518c\u57df\u7684 API \u5bc6\u94a5\u7684\u4f7f\u7528\u9650\u5236\u66f4\u591a\u3002", "76730cede613f65f6dfb99d0bae47b07": "4a.\u4e86\u89e3\u6570\u636e\u96c6\u6709\u54ea\u4e9b\u53ef\u7528\u5b57\u6bb5", "2674d56ea920d7a2b8096d0ea0ef7bbe": "\u201cGlobal Forest Watch \u7814\u7a76\u89c6\u91ce\u201d\u662f\u6211\u4eec\u201c\u68ee\u6797\u76d1\u6d4b\u524d\u6cbf\u201d\u7cfb\u5217\u7f51\u7edc\u7814\u8ba8\u4f1a\u7684\u7b2c\u4e09\u671f\uff0c\u672c\u6b21\u7f51\u7edc \u7814\u8ba8\u4f1a\u9884\u544a\u4e86 GFW \u6b63\u5728\u8fdb\u884c\u7684\u7814\u7a76\uff0c\u91cd\u70b9\u5173\u6ce8\u4e09\u5927\u6838\u5fc3\u95ee\u9898:\u6211\u4eec\u80fd\u5426\u66f4\u5feb\u3001\u66f4\u8be6\u5c3d\u5730\u63a2 \u6d4b\u68ee\u6797\u53d8\u5316?\u6211\u4eec\u80fd\u5426\u63d0\u9ad8\u5bf9\u68ee\u6797\u635f\u5931\u539f\u56e0\u7684\u7406\u89e3?\u6211\u4eec\u80fd\u5426\u7ed8\u5236\u68ee\u6797\u7684\u78b3\u6392\u653e\u53ca\u78b3\u5c01\u5b58 \u5730\u56fe?\u672c\u6b21\u7f51\u7edc\u7814\u8ba8\u4f1a\u63d0\u4f9b\u82f1\u8bed\u548c\u897f\u73ed\u7259\u8bed\u7248\u672c\u3002", "8493a4f1c2569ed62a59febb2bb2acfc": "\u4f8b\u5982\uff0c\u8981\u83b7\u5f97 {{0}} \u6570\u636e\u96c6\u7684\u8be6\u7ec6\u4fe1\u606f\uff0c\u8bf7\u53d1\u9001\u4ee5\u4e0b GET \u8bf7\u6c42:", "7b577ee34c61adcae52e42e11169ef21": "\u8bbf\u95ee\u4e3a\u5f00\u53d1\u8005\u5b9a\u5236\u7684\u6750\u6599\uff0c\u542b\u6709\u5b8c\u6574\u7684 API \u7d22\u5f15\u3002", "7c6bf37e2fcc622330a2b568e53524f0": "\u67e5\u8be2\u81ea\u5b9a\u4e49\u51e0\u4f55\u7684\u6570\u636e", "a7dec9e52cd6d36f2d21e5eb35ac9747": "\u6210\u529f\u540e\uff0c\u60a8\u5c06\u6536\u5230\u4e00\u6761\u5e26\u6709\u72b6\u6001\u548c\u6570\u636e\u5c5e\u6027\u7684 JSON \u54cd\u5e94\u3002\u5728\u672c\u793a\u4f8b\u4e2d\uff0c\u67e5\u8be2\u5217\u51fa\u4e86\u6307\u5b9a \u65f6\u95f4\u8303\u56f4\u5185 RADD \u8b66\u62a5\u7684\u7279\u5b9a\u5750\u6807\u3001\u65e5\u671f\u548c\u7f6e\u4fe1\u5ea6\u3002", "b4a3af8e044114e31d83dbc9c7be822a": "WomenResearchInstitute \u521b\u5efa\u4e86\u68ee\u6797\u706b\u707e\u548c\u6ce5\u70ad\u5730\u706b\u707e\u7684\u5f71\u54cd\u89c6\u9891\uff0c\u6f14\u793a GFW \u53ef\u5982\u4f55\u5e2e \u52a9\u63a2\u6d4b\u706b\u707e\uff0c\u4ee5\u4fbf\u793e\u533a\u91c7\u53d6\u5e94\u5bf9\u884c\u52a8\u3002", "7a51e13e486cb8ceb0f350126e4132d6": "\u5982\u679c\u60a8\u5df2\u6709 MyGFW \u8d26\u6237\uff0c\u53ef\u4ee5\u8df3\u8fc7\u6b64\u6b65\u9aa4\uff0c\u5e76\u4f7f\u7528\u5df2\u6709\u8d26\u6237\u5411 GFWDataAPI \u53d1\u8d77\u8bf7\u6c42\u3002 \u4e0d\u8fc7\uff0c\u6211\u4eec\u76ee\u524d\u4ec5\u652f\u6301\u4f7f\u7528\u7535\u5b50\u90ae\u7bb1\u548c\u5bc6\u7801\u6ce8\u518c\u7684\u8d26\u6237\u3002\u5982\u679c\u60a8\u7684 MyGFW \u8d26\u6237\u4f7f\u7528\u793e\u4ea4 \u5a92\u4f53\u767b\u5f55\u4fe1\u606f\u521b\u5efa\u2014\u2014\u5982 Google\u3001Facebook \u6216 Twitter\u2014\u2014\u90a3\u4e48\uff0c\u60a8\u9700\u8981\u7528\u7535\u5b50\u90ae\u7bb1\u548c\u5bc6 \u7801\u521b\u5efa\u4e00\u4e2a\u65b0\u8d26\u6237\u3002\u5982\u679c\u60a8\u5df2\u4f7f\u7528 Google \u521b\u5efa\u8d26\u6237\uff0c\u6211\u4eec\u5efa\u8bae\u60a8\u4e0d\u8981\u7528\u8be5 Google \u7535\u5b50 \u90ae\u7bb1\u8fdb\u884c\u6ce8\u518c\u3002", "16401f78aae86e6fd18cefdd2c076eda": "(c) \u8981\u7ec4\u6210\u4e00\u7ec4\u8b66\u62a5\uff0c\u8bf7\u5148\u70b9\u51fb\u4e00\u4e2a\u8b66\u62a5\uff0c\u7136\u540e\u7ee7\u7eed\u70b9\u51fb\u5176\u4ed6\u8b66\u62a5\u3002", "4623e667d6ccf604ddd2079741674a33": "(e) \u6216\u8005\uff0c\u653e\u5927\u81f3\u4e00\u4e2a\u6ca1\u6709\u8b66\u62a5\u7684\u533a\u57df\uff0c\u7136\u540e\u70b9\u51fb\u53f3\u4e0b\u89d2\u7684\u56fe\u9489\u56fe\u6807\u3002", "cab8939668835e7b06db248ef45796b7": "\u672c\u6b21\u7f51\u7edc\u7814\u8ba8\u4f1a\u9080\u8bf7\u4e86\u6765\u81ea WRI \u7684\u5168\u7403\u591a\u4f4d\u4e13\u5bb6\uff0c\u6982\u8ff0 2020 \u5e74\u6797\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u5e76\u8fdb\u884c \u5206\u6790\u3002", "3d0fb769862e65a1e8bce265462fd5ff": "\u7ec4\u5408\u8fd9\u4e9b\u7247\u6bb5\uff0c\u6700\u7ec8\u7684 SQL \u67e5\u8be2\u4e3a:", "2faeca2098c60d0e3ffaf399b567d918": "\u6570\u636e\u76ee\u5f55", "d6c4d09c6a8d7e74c8b46c14c7bee547": "\u60a8\u73b0\u5728\u53ef\u4ee5\u4f7f\u7528\u524d\u8ff0\u786e\u5b9a\u7684\u5b57\u6bb5\u6784\u5efa\u6b63\u786e\u7684 SQL \u8bed\u53e5\u4e86\u3002\u4e0b\u8868\u663e\u793a\u4e86\u6b64\u8bed\u53e5\u7684\u5404\u7247\u6bb5:", "7ff4908bc4f9902b8a896efcfe9e219c": "\u6216\u8005\uff0c\u60a8\u53ef\u4ee5\u653e\u5927\u81f3\u4e00\u4e2a\u6ca1\u6709\u8b66\u62a5\u7684\u533a\u57df\uff0c\u7136\u540e\u70b9\u51fb\u53f3\u4e0b\u89d2\u7684\u56fe\u9489\u56fe\u6807\uff0c\u5c06\u56fe\u9489\u653e\u7f6e\u5230\u60a8\u60f3\n\u8981\u8c03\u67e5\u7684\u533a\u57df\u3002", "0058d169cef28930ebd93b96a392c475": "\u5728\u5df2\u9009\u62e9\u81f3\u5c11\u4e00\u4e2a\u8b66\u62a5\u65f6\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u201c\u9009\u62e9\u5168\u90e8\u5df2\u8fde\u63a5\u8b66\u62a5\u201d\u56fe\u6807\u6765\u9009\u62e9\u4e00\u7ec4\u5df2\u8fde\u63a5\u8b66 \u62a5\u3002", "d7e2f8b245bc1d4965ed5497b763475c": "\u83b7\u53d6\u7279\u5b9a\u6570\u636e\u96c6\u7684\u5b57\u6bb5", "cedc2fa6b784e356b17abdd0f520967d": "REDD \u533a\u57df\u8ba1\u5212\u5df2\u521b\u5efa\u6307\u5357\u5e76\u5f55\u5236\u57f9\u8bad\uff0c\u6f14\u793a\u5982\u4f55\u4f7f\u7528 MapBuilder \u5728\u6240\u9009\u539f\u4f4f\u6c11\u9886\u5730\u5185\u521b \u5efa\u68ee\u6797\u76d1\u6d4b\u5e94\u7528\u7a0b\u5e8f\u3002", "7422026f38a94a26ce336e10aecc8f3a": "\u8bf7\u6c42 csv \u6570\u636e\u683c\u5f0f", "21a0cb3c43a81e5300d1d60a84ba459e": "3.\u6784\u5efa GeoJSON \u51e0\u4f55", "5bd243f8b27c4754a0e320c7833e38bf": "4.\u6784\u5efa SQL \u67e5\u8be2", "bfbadda4f1e1d8557d87df7f82da5c45": "2020 \u5e74\uff0c\u4e16\u754c\u5404\u5730\u5927\u90fd\u9677\u5165\u505c\u6ede\u3002\u5728\u5168\u7403\u5e94\u5bf9\u65b0\u51a0\u5927\u6d41\u884c\u548c\u7ecf\u6d4e\u52a8\u8361\u4e4b\u9645\uff0c\u68ee\u6797\u7684\u72b6\u51b5\u5982 \u4f55\u5462?\u53d7\u706b\u707e\u548c\u6c14\u5019\u53d8\u5316\u7684\u5176\u4ed6\u540e\u679c\u5f71\u54cd\u6700\u4e25\u91cd\u7684\u68ee\u6797\u5728\u54ea?", "6db4775335d92bae9394831bf119b2a3": "{{0}} \u5c5e\u6027\u663e\u793a\u4e86\u6b64\u6570\u636e\u96c6\u7279\u5b9a\u7248\u672c\u7684\u6807\u8bc6\u7b26\u3002\u5728\u672c\u793a\u4f8b\u4e2d\uff0c{{1}} \u6570\u636e\u96c6\u6709\u4e09\u4e2a\u4e0d\u540c\u7248\u672c\u3002 \u8bf7\u6c42\u6570\u636e\u65f6\uff0c\u60a8\u9700\u8981\u6307\u660e\u8981\u67e5\u8be2\u54ea\u4e00\u7248\u672c\u7684\u6570\u636e\u96c6\u3002", "3c5371f8a2577f1a59f43d4078ba640e": "\u6210\u529f\u540e\uff0c\u60a8\u5c06\u6536\u5230\u5e26\u6709 {{0}} \u548c {{1}} \u5c5e\u6027\u7684 JSON \u54cd\u5e94\u3002\u60a8\u5c06\u5728 {{2}} \u5b50\u5c5e\u6027\u4e2d\u627e\u5230\u6388\u6743 \u4ee4\u724c\u7684\u503c:", "76a149d4771df79c300fe59c84f59baf": "\u76ee\u524d\uff0cAPI \u4ec5\u652f\u6301 JSON \u548c CSV \u683c\u5f0f\u3002", "a0db49ba470c1c9ae2128c3470339153": "\u7b49\u7ea7", "73c7b8b67d9a63e9f73aa5dfcacbc4ce": "\u5bfc\u822a\u81f3 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener nofollow\">MyGFW \u767b\u5f55\u9875\u9762</a>\u5e76\u70b9\u51fb\u201c\u6ce8\u518c!\u201d\uff0c\u4ee5\u6ce8\u518c\u8d26\u6237\u3002\u4f7f\u7528\u7535\u5b50\u90ae\u7bb1\u548c\u5bc6\u7801\u6ce8\u518c MyGFW \u8d26\u6237\u2014\u2014\u8bf7\u52ff\u4f7f\u7528 Twitter\u3001Google \u6216 Facebook \u7684\u767b\u5f55\u4fe1\u606f\u521b\u5efa\u8d26\u6237\u3002", "945ea55e7815e69ae6e6b7e840653ee4": "\u5411 <strong>/auth/sign-up</strong> \u7aef\u70b9\u53d1\u9001 POST \u8bf7\u6c42\uff0c\u8be5\u7aef\u70b9 body \u4e2d\u5305\u542b\u4e00\u4e2a\u5e26\u6709\u540d\u79f0\u548c\u7535\u5b50 \u90ae\u7bb1\u5c5e\u6027\u7684 JSON \u5bf9\u8c61:", "791503f5a6b00d5f46841294eb8e32ca": "\u4e0a\u8ff0\u4efb\u4e00\u9009\u9879\u6210\u529f\u5b8c\u6210\u540e\uff0c\u60a8\u5c06\u6536\u5230\u4e00\u5c01\u6765\u81ea <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener nofollow\">Okta</a> \u7684\u7535\u5b50\u90ae\u4ef6\uff0c\u9080\u8bf7\u60a8\u8bbe\u7f6e\u5bc6\u7801\u3002 Okta \u662f GFW \u7528\u4ee5\u50a8\u5b58\u7528\u6237\u6570\u636e\u7684\u670d\u52a1\u63d0\u4f9b\u5546\u3002\u8bbe\u7f6e\u5bc6\u7801\u540e\uff0c\u60a8\u7684 MyGFW \u8d26\u6237\u5df2\u51c6\u5907\u5c31 \u7eea\u3002", "cc8de54ddfc80d0d846b404a1e45c5d6": "\u8981\u5411 GFW Data API \u53d1\u8d77\u7279\u5b9a\u8bf7\u6c42(\u5982\u521b\u5efa API \u5bc6\u94a5)\uff0c\u60a8\u9700\u8981\u62e5\u6709\u6388\u6743\u4ee4\u724c\u3002GFW Data API \u4ee5 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener nofollow\">OAuth 2.0 Bearer Tokens</a> \u4e3a\u6388\u6743\u65b9\u5f0f\u3002", "4dc1be9ba5d3eebabee4019948edee48": "\u5411 body \u5305\u542b {{0}} \u548c {{1}} \u53c2\u6570\u7684 <strong>/auth/token</strong> \u7aef\u70b9\u53d1\u9001 POST \u8bf7\u6c42:", "e3c530eb352270d7388ad2c37521a979": "30m\uff0c\u5168\u7403\uff0c2001-2021, Harris \u7b49\uff0c2021 \u5e74", "c9ba17ccaaada26a3f888a6f135cc31e": "\u60a8\u53ef\u4ee5<a href=\"{{0}}