2d\u521b\u5efa\u81f3\u5c11\u4e00\u4e2a\u533a\u57df\u3001\u62a5\u544a\u6216\u8def\u7ebf\u3002&nbsp; \u5206\u6b65\u6307\u5bfc&nbsp; \u5bfc\u51fa\u533a\u57df&nbsp; 1. \u8f6c\u5230\u201c\u533a\u57df\u201d\u9009\u9879\u5361\u3002&nbsp; 2. \u8981\u5bfc\u51fa\u6240\u6709\u533a\u57df\uff0c\u8bf7\u6309\u201c\u5bfc\u51fa\u533a\u57df\u201d\u6309\u94ae [\u2026]", "c347dcbb8de451c49601df66afa46cd0": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5982\u4f55\u5c06\u81ea\u5b9a\u4e49\u5e95\u56fe\u4e0a\u4f20\u5230 Forest Watcher \u79fb\u52a8\u7248\u4e2d\u3002&nbsp; \u5982\u4f55\u5c06\u81ea\u5b9a\u4e49\u73af\u5883\u56fe\u5c42\u4e0a\u4f20\u5230 Forest Watcher \u79fb\u52a8\u7248\u4e2d\u3002&nbsp; \u8981\u5f00\u59cb\u672c\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a&nbsp; MyGFW \u8d26\u6237\u3002\u5982\u679c\u60a8\u6ca1\u6709\u8d26\u6237\uff0c\u8bf7\u8f6c\u5230\u6b64\u9875\u9762\u8fdb\u884c\u6ce8\u518c\u3002&nbsp; \u7b80\u4ecb&nbsp; Forest Watcher Mobile \u5141\u8bb8\u7528\u6237\u4e0a\u4f20\u81ea\u5b9a\u4e49 [...]", "341ef0868f494d76baf8487477b5f457": "\u5728\u60a8\u7684\u79fb\u52a8\u8bbe\u5907\u4e0a\u521b\u5efa\u4e00\u4e2a\u611f\u5174\u8da3\u7684\u533a\u57df", "36b097274455fe5bfd0ba5183faa9579": "\u65b9\u6cd5 1\uff1a\u7ed8\u5236\u533a\u57df&nbsp;", "b9864447262a529acd7017d368d5b7dd": "\u9884\u8b66\u6570\u636e\u5305\u62ec\u4e09\u79cd\u7c7b\u578b\u7684\u68ee\u6797\u6ee5\u4f10\u9884\u8b66\u548c\u706b\u707e\u9884\u8b66\uff1a&nbsp;", "2ba414afc0e0ff4538f07f927bc1cd7a": "<strong><a href=\"{{0}}\">\u76d1\u63a7\u611f\u5174\u8da3\u7684\u533a\u57df</a>\uff1a</strong>\u5982\u679c\u60a8\u8981\u76d1\u63a7\u68ee\u6797\u53d7\u7834\u574f\u60c5\u51b5\uff08\u4f8b\u5982\u68ee\u6797\u6ee5\u4f10\u6216\u706b\u707e\u9884\u8b66\uff09\uff0c\u8bf7\u4ece\u8fd9\u91cc\u5f00\u59cb\u3002\u8fd9\u5305\u62ec\u6709\u5173\u5982\u4f55\u4f7f\u7528 Forest Watcher \u79fb\u52a8\u7248\u548c\u7f51\u9875\u7248\u4ee5\u53ca\u5982\u4f55\u4f7f\u7528\u6700\u65b0\u529f\u80fd\u7684\u6307\u5357\u3002 &nbsp;", "16590eaae0c3cc70d5c2e31f4dfbfdd4": "1. \u8f6c\u5230<strong>\u4e3b\u5c4f\u5e55</strong>\u3002&nbsp;", "3d6fafb43d74e3c1dc0a58b5a16dd46a": "\u6709\u4e09\u79cd\u65b9\u6cd5\u6765\u786e\u8ba4\u4efb\u52a1\u533a\u57df\u3002&nbsp;", "f48661c1445f989ff60a0485ed485564": "\u5bf9\u4efb\u52a1\u8fdb\u884c\u81ea\u5b9a\u4e49\u7684\u9009\u9879\uff0c\u5305\u62ec\u4efb\u52a1\u7684\u4f18\u5148\u7ea7\u4ee5\u53ca\u8c01\u6536\u5230\u4efb\u52a1\u3002&nbsp;", "a0db914e2e0b80cea50b4fb252894be7": "\u5982\u4f55\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u4efb\u52a1\u3002&nbsp;", "289fb3ce3f742c2fba0f94f3941f0568": "\u5982\u4f55\u4fee\u6539\u548c\u5220\u9664\u4efb\u52a1\u3002&nbsp;", "4284c11795e7c4a9d7bf2f6aff03a2aa": "\u4f60\u7684\u8d26\u6237\u4e2d\u81f3\u5c11\u8981\u6709\u4e00\u4e2a\u611f\u5174\u8da3\u533a\u57df\u3002\u5982\u679c\u4f60\u8fd8\u6ca1\u6709\u521b\u5efa\u611f\u5174\u8da3\u533a\u57df\uff0c<a href=\"{{0}}\">\u8bf7\u9605\u8bfb\u6b64\u6559\u7a0b\u4e86\u89e3\u5982\u4f55\u521b\u5efa\u3002&nbsp;</a>", "93dc4e5407ab42032945e35928dec7c3": "\u5bf9\u76d1\u6d4b\u9875\u9762\u548c\u8c03\u67e5\u5b50\u9875\u9762\u7684\u4e86\u89e3\u3002&nbsp;", "0852a1d0288af86ee59d3a7ef66879a1": "\u7ecf\u7406\u53ef\u4ee5\u901a\u8fc7\u4efb\u52a1\u6765\u544a\u8bc9\u76d1\u6d4b\u5458\u73b0\u573a\u8c03\u67e5\u7684\u51c6\u786e\u4f4d\u7f6e\u3002\u5f53\u7ecf\u7406\u5728 Forest Watcher Web \u4e2d\u521b\u5efa\u4e86\u4e00\u4e2a\u4efb\u52a1\uff0c\u5e76\u5c06\u5b83\u5206\u914d\u7ed9\u4e2a\u4eba\u548c/\u6216\u56e2\u961f\u4e4b\u540e\uff0c\u5982\u679c\u90a3\u4e9b\u7528\u6237\u540c\u6b65\u4e86\u4ed6\u4eec\u7684\u8bbe\u5907\uff0c\u8be5\u4efb\u52a1\u5c06\u81ea\u52a8\u663e\u793a\u5728 Forest Watcher Mobile \u4e2d\u3002\u4f60\u53ef\u4ee5\u521b\u5efa\u6216\u63a5\u53d7\u7684\u4efb\u52a1\u6570\u91cf\u6ca1\u6709\u9650\u5236\u3002&nbsp;", "f63c343d87b1bcd4f6df26cc8e067f31": "\u524d\u5f80\u76d1\u6d4b\u9875\u9762\u548c\u8c03\u67e5\u5b50\u9875\u9762", "b31dcd2a4b6aa2d843b437edb053b644": "4. \u786e\u4fdd\u4f60\u5728\u201c\u8c03\u67e5\u201d\u5b50\u9875\u9762\u4e0a\u3002&nbsp;", "21bd6d62a3f1007cac35a4af934f7836": "\u9009\u62e9\u611f\u5174\u8da3\u533a\u57df\u5e76\u5f00\u59cb\u8c03\u67e5&nbsp;", "000158f4a72ae35dd6a91f8b4d21e9fc": "2. \u4f7f\u7528\u63a7\u5236\u9762\u677f\u6216\u5730\u56fe\uff0c\u9009\u62e9\u5c06\u4e0e\u4f60\u7684\u4efb\u52a1\u76f8\u5173\u8054\u7684\u611f\u5174\u8da3\u533a\u57df\u3002&nbsp;", "9e29d1647644b0af1eecc503f7ed40fa": "\u8fdb\u884c\u4e00\u5207\u5fc5\u8981\u7684\u684c\u9762\u5206\u6790&nbsp;", "3a5849d81b3451ba7faeabfb540881ea": "2. \u4f8b\u5982\uff0c\u4e0b\u9762\u7684\u622a\u56fe\u663e\u793a\uff0c\u5728\u4e00\u4e2a\u7279\u522b\u76d1\u6d4b\u533a\u7684\u8fb9\u754c\u9644\u8fd1\u6709\u4e00\u7ec4 RADD \u8b66\u62a5\u3002\u4f60\u5c06\u7528\u6765\u521b\u5efa\u65b0\u4efb\u52a1\u7684\u6309\u94ae\u4e5f\u4f1a\u88ab\u7a81\u51fa\u663e\u793a\u3002&nbsp;", "d90b7109bc28671a7355273a896e2dac": "\u521b\u5efa\u65b0\u4efb\u52a1&nbsp;", "5bef0e1a8959ba3710a078e080b585d5": "1. \u70b9\u51fb\u201c+ \u521b\u5efa\u65b0\u4efb\u52a1\u201d\u6309\u94ae\u3002&nbsp;", "29ce21fbffdf695040258397637d6953": "\u4f60\u7684\u8d26\u6237\u4e2d\u81f3\u5c11\u8981\u6709\u4e00\u4e2a\u56e2\u961f\u3002\u5982\u679c\u4f60\u8fd8\u6ca1\u6709\u521b\u5efa\u56e2\u961f\uff0c<a href=\"{{0}}\">\u8bf7\u9605\u8bfb\u6b64\u6559\u7a0b\u4e86\u89e3\u5982\u4f55\u521b\u5efa\u3002</a>.&nbsp;", "322e3185d843ecd0bb1d18f1254d62e5": "\u5728\u5730\u56fe\u4e0a\u9009\u62e9\u4f4d\u7f6e\uff1a\u5728\u5730\u56fe\u4e0a\u70b9\u51fb\u4efb\u4e00\u4f4d\u7f6e\uff0c\u4ece\u800c\u5c06\u8be5\u4efb\u52a1\u4e0e\u4e00\u7ec4\u7279\u5b9a\u7684\u5750\u6807\u5173\u8054\u3002&nbsp;", "c04b7af6ba1658d0a0b4502749ab403c": "\u4e0a\u4f20 shapefile \u6587\u4ef6\uff1a\u5728\u63a7\u5236\u9762\u677f\u4e2d\u70b9\u51fb\u201c\u4e0a\u4f20 Shapefile\u201d\u6309\u94ae\uff0c\u5e76\u5728\u4f60\u7684\u7535\u8111\u4e2d\u9009\u62e9\u4e00\u4e2a Shapefile \u6587\u4ef6\uff0c\u4ece\u800c\u5c06\u5b83\u4e0a\u4f20\u5230\u5730\u56fe\u4e0a\uff0c\u5e76\u4f7f\u4efb\u52a1\u4e0e\u5b83\u76f8\u5173\u8054\u3002&nbsp;", "2f4cfc27a2e9c5f86a52e010e0dabe69": "4. \u4e0d\u7ba1\u4f60\u9009\u62e9\u54ea\u79cd\u65b9\u6cd5\uff0c\u521b\u5efa\u4efb\u52a1\u7684\u5269\u4f59\u6b65\u9aa4\u90fd\u662f\u76f8\u540c\u7684\u3002&nbsp;", "8f76603b821b06bd4d3501c0bf8d2910": "2. \u5728 Forest Watcher Web \u4e2d\uff0c\u4f60\u53ef\u4ee5\u5229\u7528\u4efb\u52a1\u5b50\u9875\u9762\u4e2d\u7684\u4efb\u52a1\u8868\u683c\uff0c\u6309\u4f18\u5148\u7ea7\u5bf9\u4f60\u7684\u4efb\u52a1\u6392\u5e8f\u3002&nbsp;", "2514f71006e379e023fbba99ca6f81be": "3. \u5728 Forest Watcher Mobile \u4e2d\uff0c\u5f53\u76d1\u6d4b\u5458\u67e5\u770b\u4efb\u52a1\u65f6\uff0c\u4efb\u52a1\u5c06\u6309\u7167\u4f18\u5148\u7ea7\u5206\u7ec4\u3002&nbsp;&nbsp;", "e04dbc600d568d7d5b4026d8d7cf7046": "\u9009\u62e9\u54ea\u4e9b\u4e2a\u4eba\u548c/\u6216\u56e2\u961f\u5c06\u6536\u5230\u8be5\u4efb\u52a1&nbsp;", "b78e91526b59ba84844a993cf6a36337": "1. \u70b9\u51fb\u201c+ \u6dfb\u52a0\u76d1\u6d4b\u5458\u201d\u6309\u94ae\uff0c\u63a7\u5236\u9762\u677f\u5c06\u53d1\u751f\u6539\u53d8\uff0c\u5e76\u663e\u793a\u53ef\u4ee5\u6536\u5230\u8be5\u4efb\u52a1\u7684\u6240\u6709\u4e2a\u4eba\u548c\u56e2\u961f\u3002&nbsp;", "90c8fa7007f25d6d26f4b7aee8980397": "\u5982\u4f55\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u68ee\u6797\u7834\u574f\u548c\u706b\u707e\u8b66\u62a5\u3002&nbsp;", "81644842c6403257227cd7cc6fd48455": "2. \u70b9\u51fb\u7279\u5b9a\u4e2a\u4eba\u6216\u56e2\u961f\u65c1\u8fb9\u7684\u5706\u5708\uff0c\u4ece\u800c\u5c06\u5176\u5305\u542b\u5728\u5185\u6216\u6392\u9664\u5728\u5916\u3002\u7a7a\u5706\u5708\u8868\u793a\u4ed6\u4eec\u4e0d\u4f1a\u6536\u5230\u4efb\u52a1\uff0c\u5e26\u6709\u5bf9\u53f7\u7684\u7eff\u5706\u5708\u8868\u793a\u4ed6\u4eec\u5c06\u6536\u5230\u4efb\u52a1\u3002&nbsp;", "e1ea4c9a47683aa772b2f768a664a8d0": "3. \u70b9\u51fb\u201c\u6dfb\u52a0\u76d1\u6d4b\u5458\u201d\u6807\u9898\u65c1\u8fb9\u7684\u8fd4\u56de\u7bad\u5934\uff0c\u4ece\u800c\u8fd4\u56de\u4efb\u52a1\u9009\u9879\u754c\u9762\u3002&nbsp;", "cf4a9a6ee270d414d06009a05cd32ad4": "\u5728\u4efb\u52a1\u4e2d\u6dfb\u52a0\u59