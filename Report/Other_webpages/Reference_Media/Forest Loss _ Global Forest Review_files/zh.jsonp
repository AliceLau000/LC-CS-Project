9\u3002", "a6840aa8104ec4310cce0a8446dcf38e": "\u8bf7\u901a\u8fc7\u586b\u5199\u6b64\u8868\u683c", "955d1dcc13b69406873e3e3af1b5f88c": "\u4e0e\u6211\u4eec\u8054\u7cfb\u3002", "fc3b0ffd966c616f0f4a289a965f8004": "Analysis_R\uff08\u6570\u503c) \u2013 \u6240\u9700\u8981\u7684\u5206\u6790\u534a\u5f84\uff0c\u5355\u4f4d\u4e3a<strong>KM</strong>\uff0c\u5982\u679cAnalysis_A\u5df2\u88ab\u5b9a\u4e49 \uff0c\u5219\u65e0\u9700\u518d\u5b9a\u4e49\u3002&nbsp;", "9b2e12dd2d7083958e9d3c47a2a0313e": "Analysis_A\uff08\u6570\u503c\uff09- \u6240\u9700\u8981\u7684\u5206\u6790\u9762\u79ef\uff0c\u5355\u4f4d\u4e3a<strong>HA</strong>\uff0c\u5982\u679cAnalysis_R\u5df2\u88ab\u5b9a\u4e49 \uff0c\u5219\u65e0\u9700\u518d\u5b9a\u4e49&nbsp;", "a922cdc22663670be308ecdb4963b30d": "\u6700\u9002\u5408\u7528\u4e8e\u6d89\u53ca\u591a\u8fb9\u51e0\u4f55\u5f62\u72b6\u7684\u6570\u636e\uff0c\u5982\u5730\u5757\u548c\u7269\u4e1a\u8fb9\u754c\u3002 \u7531\u4e8eKML/KMZ\u6587\u4ef6\u7684\u7279\u6709\u7ed3\u6784\uff0c\u5f88\u96be\u5bf9\u5176\u8fdb\u884c\u7f16\u8f91\uff0c\u56e0\u6b64\u4e0d\u5efa\u8bae\u4f7f\u7528\u6b64\u6587\u4ef6\u683c\u5f0f\u4e0a\u4f20<span style=\"box-sizing: border-box; margin: 0px; padding: 0px;\">\u5927\u91cf</span>\u5730\u70b9\u3002&nbsp;", "8285737eb7968bf80c99a83a407b2e2a": "\u5730\u70b9\u540d\uff08\u5b57\u7b26\u4e32\uff09- \u5730\u70b9\u540d\u79f0&nbsp;- \u53ea\u80fd\u8f93\u5165\u5b57\u6bcd\u548c\u6570\u5b57\u5b57\u7b26\u53ca\u4ee5\u4e0b\u7279\u6b8a\u5b57\u7b26: []().-_\u3002\u9664\u6b64\u4e4b\u5916\u7684\u7279\u6b8a\u5b57\u7b26\u5728\u5904\u7406\u8fc7\u7a0b\u4e2d\u4f1a\u88ab\u5220\u9664\u3002&nbsp;<br>\u8fd8\u8bf7\u6ce8\u610f\uff0c\u8f93\u5165\u5185\u5bb9\u5fc5\u987b\u5c11\u4e8e63\u4e2a\u5b57\u7b26\u3002 \u8fc7\u957f\u7684\u5b57\u7b26\u4e32\u4f1a\u88ab\u5220\u51cf\uff0c\u4ee5\u7b26\u5408\u957f\u5ea6\u4e0a\u9650\u3002", "6ce4507839f978acaafe6804f6344c3a": "\u51c6\u5907\u597d\u8981\u4e0a\u4f20\u7684KML/KMZ\u6587\u4ef6&nbsp;", "2016cef440b17004b0dc9eeceef1c1e5": "\u6b32\u83b7\u53d6\u5173\u4e8e\u5982\u4f55\u4f7f\u7528GFW Pro\u7684\u5e2e\u52a9\uff0c\u8bf7\u524d\u5f80<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8be6\u7ec6\u4f7f\u7528\u8bf4\u660e</a>\uff0c\u5176\u4f4d\u4e8e<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">GFW Pro\u5e2e\u52a9\u4e2d\u5fc3\u5185\u3002</a>&nbsp; &nbsp;\n\n", "51679f80fc8a77285f08bceb0e19e2bf": "\u8981\u4f7f\u7528GFW Pro\uff0c\u9996\u5148\u60a8\u9700\u8981\u521b\u5efa\u4e00\u4e2a\u8d26\u6237\u3002\u4ee5\u4e0b\u6b65\u9aa4\u5c06\u6307\u5bfc\u60a8\u5982\u4f55\u521b\u5efa\u65b0\u8d26\u6237\u548c\u7ba1\u7406\u73b0\u6709\u8d26\u6237\u3002&nbsp;&nbsp;", "fcf27a8ceb21c1475d6679e81e6d496d": "GFW Pro\u5141\u8bb8\u7528\u6237\u4e0a\u4f20\u591a\u79cd\u683c\u5f0f\uff08shapefile\u3001\u7535\u5b50\u8868\u683c\u3001KML/KMZs\uff09\u7684\u6570\u636e\uff0c\u5e76\u4e3a\u6bcf\u79cd\u652f\u6301\u7684\u6570\u636e\u7c7b\u578b\u63d0\u4f9b\u4e86\u4e00\u4e2a\u6216\u591a\u4e2a\u6a21\u677f:&nbsp;", "f3972f74333f343cabf12672153169e5": "Shapefile\u6570\u636e \u2013 \u7528\u6237\u53ef\u4ee5\u4e0a\u4f20\u5305\u542b\u591a\u8fb9\u5f62\u6216\u70b9\u6570\u636e\u7684Shapefile\u538b\u7f29\u6587\u4ef6\uff0c\u5e76\u6839\u636e\u51e0\u4f55\u7c7b\u578b\u8bbe\u7f6e\u6709\u4e0d\u540c\u7684\u5fc5\u586b\u5217\u3002&nbsp;", "9fd625088bf3008997e9170a6b8074b0": "KML\u6570\u636e \u2013 \u7528\u6237\u53ef\u4ee5\u4e0a\u4f20KML/KMZ\u683c\u5f0f\u7684\u7a7a\u95f4\u6570\u636e\u6587\u4ef6\u3002&nbsp;", "17cf0cf49e7cd0d1bdf0f7388df13ac9": "\u6700\u9002\u5408\u7528\u4e8e\u6d89\u53ca\u591a\u8fb9\u51e0\u4f55\u5f62\u72b6\u7684\u6570\u636e\uff0c\u5982\u5730\u5757\u548c\u7269\u4e1a\u8fb9\u754c\u3002&nbsp;", "dfd4d8758ecc7f48248a7c663bcae40c": "\u6700\u9002\u5408\u7528\u4e8e\u6d89\u53ca\u5750\u6807\u548c\u5206\u6790\u9762\u79ef\u6216\u534a\u5f84\u7684\u6570\u636e\uff0c\u5982\u4f9b\u5e94\u5382\u623f\u548c\u91c7\u8d2d\u533a\u57df\u3002&nbsp;", "d713d05a1da2fbd0f865da2562e7c5bc": "\u70b9\u5f0fShapefile&nbsp;", "2d0b0c7f1b32a2c90c60fca05bb2d0fd": "\u5206\u6790\u534a\u5f84\uff08\u6570\u503c) \u2013 \u6240\u9700\u8981\u7684\u5206\u6790\u534a\u5f84\uff0c\u5355\u4f4d\u4e3a<strong>KM</strong>\uff0c\u5982\u679c\u5206\u6790\u9762\u79ef\u5df2\u88ab\u5b9a\u4e49 \uff0c\u5219\u65e0\u9700\u518d\u5b9a\u4e49\u3002&nbsp;", "e5c084a81ae29cd488d068b76a4dd7f7": "\u4e0b\u8f7d\u793a\u4f8b\u6570\u636e\u6a21\u677f", "6cfa97534bfe05c1b9a7b80c8ddd6162": "\u5206\u6790\u9762\u79ef\uff08\u6570\u503c\uff09- \u6240\u9700\u8981\u7684\u5206\u6790\u9762\u79ef\uff0c\u5355\u4f4d\u4e3a<strong>HA</strong>\uff0c\u5982\u679c\u5206\u6790\u534a\u5f84\u5df2\u88ab\u5b9a\u4e49 \uff0c\u5219\u65e0\u9700\u518d\u5b9a\u4e49&nbsp;", "ef1f10ac25619a533c7d658b48f85860": "\u60a8\u53ef\u4ee5\u5728\"\u6dfb\u52a0\u5730\u70b9 \"\u5de5\u4f5c\u6d41\u7a0b\u4e2d\u6d4f\u89c8\u548c\u4e0b\u8f7dGFW Pro\u6570\u636e\u6a21\u677f\u3002 \u5177\u4f53\u6b65\u9aa4\u5982\u4e0b:&nbsp;", "198b6889683bdc57c4b8c7f39c91bd16": "\u5728\"\u5730\u70b9\"\u9875\u9762\uff0c\u70b9\u51fb\u7eff\u8272\u7684\"+\u6dfb\u52a0\u5730\u70b9 \"\u6309\u94ae&nbsp\uff1b", "99305c17d1485768eb77ae0535c647a9": "GFW Pro\u7684\u5730\u70b9\u9875\u9762\u3002 \u70b9\u51fb\"+\u6dfb\u52a0\u5730\u70b9\"\u6309\u94ae\uff0c\u5373\u53ef\u83b7\u53d6\u4e0a\u4f20\u6587\u4ef6\u6a21\u677f\u3002", "75b95e24e8e03cd10c20f966c24f88c4": "\u5728\u65b0\u7528\u6237\u4e2a\u4eba\u8d44\u6599\u9875\u7684\u53f3\u4e0b\u65b9\uff0c<strong>\u70b9\u51fb \"\u6fc0\u6d3b \"\u4ee5\u6fc0\u6d3b\u8d26\u6237\u3002</strong>Pro\u7248\u968f\u540e\u4f1a\u81ea\u52a8\u751f\u6210\u5e76\u5411\u65b0\u7528\u6237\u53d1\u9001\u5e26\u6709\u767b\u5f55\u8bf4\u660e\u7684\u7535\u5b50\u90ae\u4ef6\u3002", "d3a9440fa9ab4ede3c0155dea30bac55": "\u7535\u5b50\u90ae\u4ef6\u4e3b\u9898\uff1a \u7ba1\u7406\u5458\u8d26\u6237\u505c\u7528\u3002 \u5728\u8868\u5355\u4e2d\u586b\u5199\u8981\u505c\u7528\u8d26\u6237\u7684\u540d\u79f0\u3001\u7535\u5b50\u90ae\u7bb1\u53ca\u6743\u9650\u7ea7\u522b", "173f4cfe5a668023f6634c56782cf1cd": "Pro\u7684\u8d85\u7ea7\u7ba1\u7406\u5458\u5c06\u57285\u4e2a\u5de5\u4f5c\u65e5\u5185\u56de\u590d\u60a8\u3002\u7ba1\u7406\u5458\u521b\u5efa\u6216\u4e0a\u4f20\u7684\u6240\u6709\u4e2a\u4eba\u8d44\u6599\u3001\u5217\u8868\u548c\u5730\u70b9\u4ecd\u53ef\u4f9b\u6240\u6709\u201c\u7ba1\u7406\u5458\u201d\u8d26\u6237\u7684\u7528\u6237\u4f7f\u7528\u3002\u4e0e\u7ec4\u7ec7\u5185\u5176\u4ed6\u4eba\u5171\u4eab\u7684\u5217\u8868\u4ecd\u5c06\u88ab\u5171\u4eab\u3002", "c8e9e0c8c3ccb41f21ad2e60ad850b73": "\u7528\u6237\u53ef\u4ee5", "1a76a96c8783e86047da9f94dfb0cf6a": "\u5982\u679c\u7531\u4e8e\u5730\u70b9\u9519\u8bef\u5bfc\u81f4\u5206\u6790\u5931\u8d25\uff0c\u60a8", "f792acec49bf8bfa46f1c86f88a2b9a4": "\u53ef\u4ee5\u70b9\u51fb\u5931\u8d25\u5217\u8868\u5e76\u524d\u5f80\u8be6\u7ec6\u4fe1\u606f\u9875\u9762\u67e5\u770b\u8be6\u60c5\u3002 \u51fa\u9519\u5730\u70b9\u5c06\u4f1a\u9ad8\u4eae\u663e\u793a\u3002\u5c06\u9f20\u6807\u505c\u7559\u5728", "7861d9bac953e6861e2c94cc90e5cb3a": "\u60a8\u8bd5\u56fe", "3aecf4c90bd6eb3d9915b8a367b460d3": "\u5982\u679c\u95ee\u9898\u4ecd\u7136\u5b58\u5728\uff0c", "6e5085717a9c2b4372a891cc3b8bdead": "\u9009\u62e9\u6b63\u786e\u7684\u6a21\u677f\u7c7b\u578b\uff0c\u5bf9\u4e8e\u786e\u4fdd\u6570\u636e\u683c\u5f0f\u7b26\u5408GFW Pro\u8fdb\u884c\u5206\u6790\u3001\u5b58\u50a8\u53ca\u53ef\u89c6\u5316\u5904\u7406\u7684\u76f8\u5173\u8981\u6c42\u975e\u5e38\u91cd\u8981\u3002 \u4ee5\u4e0b\u662f\u6709\u5173 GFW Pro\u6a21\u677f\u7c7b\u578b\u7684\u4fe1\u606f\uff0c\u4ee5\u53ca\u5982\u4f55\u83b7\u53d6\u53ef\u4f9b\u4e0b\u8f7d\u548c\u53c2\u8003\u7684\u793a\u4f8b\u6a21\u677f\u3002&nbsp;", "8756a8c6e5e09183919b56f9e57ad20b": "\u5fc5\u586b\u5b57\u6bb5\uff1a&nbsp\uff1b", "4cacf4f72ffc5cd7f552eccadd5e5920": "\u7ecf\u5ea6\uff08\u6570\u503c\uff09\u2013 \u5750\u6807\u7684\u7ecf\u5ea6\u503c\uff0c\u4ee5\u5341\u8fdb\u5236\u7684\u5f62\u5f0f\u8868\u793a&nbsp\uff1b", "95708df8835c51f5d6012718829e1d6c": "\u5206\u6790\u534a\u5f84*\uff08\u6570\u503c) \u2013 \u6240\u9700\u8981\u7684\u5206\u6790\u534a\u5f84\uff0c\u5355\u4f4d\u4e3a<strong>KM</strong>\uff0c\u5982\u679c\u5206\u6790\u9762\u79ef\u5df2\u88ab\u5b9a\u4e49 \uff0c\u5219\u65e0\u9700\u518d\u5b9a\u4e49\u3002&nbsp;", "5183bfa429956f164c197bacede6856b": "\u5206\u6790\u9762\u79ef*\uff08\u6570\u503c\uff09- \u6240\u9700\u8981\u7684\u5206\u6790\u9762\u79ef\uff0c\u5355\u4f4d\u4e3a<strong>HA</strong>\uff0c\u5982\u679c\u5206\u6790\u534a\u5f84\u5df2\u88ab\u5b9a\u4e49 \uff0c\u5219\u65e0\u9700\u518d\u5b9a\u4e49&nbsp;", "fecdbe68a7b855230b47a57ab69cdf05": "\u68d5\u6988\u6cb9\u5de5\u5382\u7535\u5b50\u8868\u683c", "258b8310e5ecb9a9cf23066b445a2be8": "\u7528\u6765\u4eceUniversal Mill List[LINK]\u4e0a\u4f20\u68d5\u6988\u6cb9\u5de5\u5382\u7684\u5730\u70b9\u3002&nbsp;", "b32be8b60bbacc9a823acc3b896fdf6c": "ID - \u5728UML\u4e2d\u7684\u68d5\u6988\u5de5\u5382ID[LINK]&nbsp;", "93eff4b27b2cd3491156ce9f8428d2be": "\u6bcf\u4e2a\u7ec4\u7ec7\u4ec5\u9650\u4f7f\u7528\u4e00\u4e2a\u8d26\u6237\u3002 \u8d26\u6237\u7ba1\u7406\u5458\u53ef\u4ee5\u5728\u5176\u7ec4\u7ec7\u7684\u8d26\u6237\u4e2d\u6dfb\u52a0\u4e0d\u9650\u6570\u91cf\u7684\u7528\u6237\u8d44\u6599\u3002 \u53ea\u6709\u8d26\u6237\u7ba1\u7406\u5458\u624d\u80fd\u6309\u7167\u8fd9\u4e9b\u6b65\u9aa4\u8bbe\u7f6e\u548c\u7ba1\u7406\u8d26\u6237\u3002 \u5176\u4ed6\u7528\u6237\u9700\u8981\u7531\u8d26\u6237\u7ba1\u7406\u5458\u6dfb\u52a0\u5230\u5176\u7ec4\u7ec7\u7684\u8d26\u6237\u4e2d\u3002 \u5982\u679c\u60a8\u5bf9\u8d26\u6237\u7ed3\u6784\u6709\u4efb\u4f55\u7591\u95ee\uff0c\u8bf7\u901a\u8fc7<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5e2e\u52a9\u8868\u683c</a>\u8054\u7cfb\u6211\u4eec\u7684\u56e2\u961f\u3002 &nbsp;", "7751f7c01c092b30d41c9931e9cfb73d": "\u65b0\u7528\u6237\u88ab\u6dfb\u52a0\u5230\u7ec4\u7ec7\u4e2d\u540e\uff0c\u9700\u8981\u5148\u5bf9\u5176\u8d26\u6237\u8fdb\u884c\u6fc0\u6d3b\uff0c\u7136\u540e\u624d\u80fd\u767b\u5f55\u3002", "7fd124b6b82a2195eb4e52eeffa69e47": "\u5982\u679c\u60a8\u9047\u5230\u4e86\u6b64\u95ee\u9898\uff0c\u8bf7\u67e5\u770b\u7535\u5b50\u90ae\u4ef6\u662f\u5426\u5728\u5783\u573e\u90ae\u4ef6\u6587\u4ef6\u5939\u4e2d\u3002\u5982\u679c\u60a8\u4f7f\u7528\u7684\u662f\u7ec4\u7ec7\u8d26\u6237\uff0c\u8bf7\u786e\u8ba4\u6211\u4eec\u7684\u90ae\u7bb1\u5730\u5740\u6ca1\u6709\u88ab\u5f53\u4f5c\u5783\u573e\u90ae\u4ef6\u62e6\u622a\u8fc7\u6ee4\uff08", "9efab2399c7c560b34de477b9aa0a465": "\u5e38\u89c1\u7684", "e1a2e4b008ffa7cb1e02dd59ecf154c1": "\u89c4\u5219\u4f1a", "b807023f87e63b8ada92f79f546ff9cc": "\u64cd\u4f5c", "351bda702ae1ed326db5d43510812794": "\u662f\u7684\u3002\u60a8\u53ef\u4ee5\u4f7f\u7528GFW Pro\u5c06\u4f9b\u5e94\u94fe\u6216\u6295\u8d44\u4e2d\u60f3\u8fdb\u884c\u5206\u6790\u7684\u8d27\u6e90\u5730\uff08\u5730\u5757\u3001\u623f\u4ea7\u3001\u78e8\u574a\u3001\u7b52\u4ed3\u3001\u5c60\u5bb0\u573a\u7b49\uff09\u4e0a\u4f20\u3002\u60a8\u53ef\u4ee5\u4e00\u6b21\u6dfb\u52a0\u4e00\u4e2a\u5730\u70b9\uff0c\u4e5f\u53ef\u4ee5\u4e00\u6b21\u4e0a\u4f20\u591a\u4e2a\u5730\u70b9\u3002\u60a8", "a2b2913dd5d83e4c2ccfab8f2f0138d6": "\u6700\u591a\u5305\u542b150000\u4e2a\u5730\u70b9\u7684", "7c7c515a544e85827355bae37454bc74": "\u5927\u578b\u5217\u8868\u3002", "41815fd0e4f3646090704f9f7a13af7f": "\u8bc6\u522b\u5e76\u4f18\u5148\u5904\u7406\u4f9b\u5e94\u94fe\u4e2d\u7684\u98ce\u9669\u533a\u57df\uff0c\u4ee5\u8bc4\u4f30\u8be5\u533a\u57df\u5bf9EUDR\u7684\u9075\u5b88\u60c5\u51b5\u4ee5\u53ca\u5728\u5b9e\u73b0\u96f6\u6bc1\u6797\u627f\u8bfa\u4e0a\u7684\u8fdb\u5c55\u3002", "f09e5c5948cc2e53c1f9176aedaffac4": "\u5c06GFW Pro\u7684\u5206\u6790\u7ed3\u679c\u7eb3\u5165\u76d1\u7ba1\u548c\u81ea\u613f\u62a5\u544a\u4e2d\uff0c\u5e76\u5728\u4ea7\u54c1\u4e2d\u9644\u4e0a\u8be6\u7ec6\u7684\u53ef\u6301\u7eed\u53d1\u5c55\u62a5\u544a\u3002&nbsp;", "80bde84c0443ea125460c93db0865be9": "\u5728GFW Pro\u4e2d\u521b\u5efa\u5355\u72ec\u7684\u6295\u8d44\u5730\u70b9\u6216\u6295\u8d44\u5730\u70b9\u7ec4\u5408\u3002", "01f304ec5bac6c7b7a857f21cb1b5a69": "\u901a\u8fc7GFW Pro\u4e0e\u540c\u4e8b\u5171\u4eab\u5206\u6790\u7ed3\u679c\uff0c\u5e76\u4ece\u540c\u4e8b\u90a3\u91cc\u83b7\u5f97\u4f18\u5148\u4f4d\u7f6e\u4fe1\u606f\u3002", "c1cfbd4e5d7a432d40cfff874e2e36cc": "\u5728\u60a8\u7684\u4f9b\u5e94\u57fa\u5730\u5185\u786e\u5b9a\u4f18\u5148\u533a\u57df\uff0c\u6765\u5e2e\u52a9\u60a8\u63a8\u8fdb\u96f6\u6bc1\u6797\u627f\u8bfa\u65b9\u9762\u7684\u5de5\u4f5c\u3002", "ac90d2fe9ab3704c7516681b4872dbdd": "\u8054\u7cfb", "02ea1b9996d131ce8d47e0225c1022e2": "\u5982\u4f55\u5c06\u4eba\u5458\u6dfb\u52a0\u5230\u6211\u7684\u7ec4\u7ec7\u8d26\u6237\uff1f", "0071c726b2c244b1fe56f8aca8a104c2": "\u8bf7\u9009\u62e9\u901a\u8fc7\u7535\u5b50\u90ae\u4ef6\u9a8c\u8bc1\uff0c\u800c\u975e\u901a\u8fc7Google\uff08\u6b64\u529f\u80fd\u4ecd\u5728\u5f00\u53d1\u4e2d\uff09", "42df97fc0c007324c4814d2883110dc7": "\u518d\u6b21\u8fdb\u5165\u201c\u7528\u6237\u7ba1\u7406\u201d\u9875\u9762", "7ef8422236e1a697400a5ed145a22697": "\u67e5\u627e\u6700\u8fd1\u6dfb\u52a0\u7684\u7528\u6237\u5e76\u70b9\u51fb\u5176\u540d\u79f0", "8a33b2ed1251c6376e8643b5386843dd": "\u4e3a\u4ec0\u4e48\u6211\u6536\u4e0d\u5230\u9a8c\u8bc1\u7801\u90ae\u4ef6\uff1f", "5317cdf7f6fdc1845d7c7098d95fbc67": "\u5408\u4f5c\u4f01\u4e1a/\u751f\u4ea7\u5546", "72fc514aa47dd2c6512f4d74eef010bb": "\u5728GFW Pro\u4e2d\u521b\u5efa\u751f\u4ea7\u533a\u57df\u7ec4\u5408\uff08\u4f8b\u5982\uff0c\u5927\u8c46\u519c\u573a\u3001\u68d5\u6988\u6cb9\u7279\u8bb8\u7ecf\u8425\u6743\u3001\u53ef\u53ef\u79cd\u690d\u5730\u5757\uff09\u3002", "3b6869deb549f5e9eea8fefb27d51420": "\u571f\u5730\u5229\u7528\u53d8\u5316\u3001\u6392\u653e\u3001\u8f6c\u6362", "c63e6cb8d03117de2537bbfdaf7f487e": "\u4e0e\u76d1\u7ba1\u673a\u6784\u3001\u975e\u8425\u5229\u6027\u81ea\u613f\u627f\u8bfa\u7ba1\u7406\u8005\u548cGFW Pro\u4f1a\u5458\u7f51\u7edc\u5206\u4eab\u5206\u6790\u7ed3\u679c\uff0c\u4ee5\u5c55\u793a\u96f6\u6bc1\u6797\u548c\u53ef\u6301\u7eed\u53d1\u5c55\u65b9\u9762\u7684\u6210\u5c31\u3002", "ff7d66d590f97df729f875545a074e8a": "\u5546\u54c1\u4ea4\u6613\u5546", "64d3a5466025db38910db99ce00eeac6": "\u76d1\u6d4b\u751f\u4ea7\u533a\u57df\u7684\u68ee\u6797\u780d\u4f10\u6216\u706b\u707e\u6d3b\u52a8\uff0c\u5bf9\u5176\u4f18\u5148\u5904\u7406\u5e76\u8fdb\u884c\u98ce\u9669\u7f13\u89e3\u5de5\u4f5c\u3002", "576663ef912630a35fbae537b4d6ce6a": "\u5730\u70b9\u6570\u636e", "a2a551a6458a8de22446cc76d639a9e9": "\u76ee\u524d", "88097b51a962d7daf11c98ec0b4dd45a": "\u60a8\u65e0\u6cd5\u4e00\u6b21\u6027", "55752f0edee6b3791151f34d93e94438": "\u5220\u9664\u6240\u6709\u5730\u70b9\u3002", "99a66be1ed9235bf4b5021bf839772a4": "\u4f5c\u4e3a\u7528\u6237\uff0c\u60a8\u53ef\u4ee5", "4fc054d4d9e9fec6723c5d2149b49d90": "\u5c06\u8d26\u6237\u4e2d\u7684\u5730\u70b9\u5168\u90e8\u5220\u9664\uff0c", "f7ca8d0431b4063485ce0f71bccefe80": "\u8bf7\u586b\u5199\u6b64\u8868\u683c\u4e0e\u6211\u4eec\u8054\u7cfb\u3002", "fd5e89852ec2dfebe8322cd093bf9a23": "\u4e3a\u4ec0\u4e48\u6211\u5728\u4e0a\u4f20shapefiles\u6587\u4ef6\u65f6\u9047\u5230\u4e86\u95ee\u9898\uff1f", "955e8651456317a88f2d9b75a73cee2a": "\u5982\u679c\u60a8\u5728\u4e0a\u4f20shapefile\u6587\u4ef6\u65f6\u9047\u5230\u4e86\u95ee\u9898\uff0c\u6700\u5e38\u89c1\u7684\u95ee\u9898\u662f", "21582c6c30be1217322cdb9aebaf4a59": "\u7f3a\u5931\u4e86", "ed6075e84b614954cd215f3f9f9b9a5e": "\u8981\u6c42\u3002\u5982\u6709\u5176\u4ed6\u95ee\u9898\uff0c\u8bf7\u8054\u7cfb\u6211\u4eec\u7684\u56e2\u961f\uff1a", "95a24306633e856114702d3b3bb16073": "\u5f00\u8bbe\u548c", "e665e64d39be8129287ce8731e7e473b": "\u7559\u5b58", "615afcf2355dc390c01d53f6de65f22b": "GFW Pro \u8d26\u6237\u662f\u514d\u8d39\u7684\u3002\u6bcf\u4e2a\u7ec4\u7ec7\u6bcf\u5e74\u53ef\u514d\u8d39\u83b7\u5f97 5,000 \u6b21\u5355\u70b9\u5206\u6790\u548c 1 \u4ebf\u516c\u9877\u5904\u7406\u989d\u5ea6\u3002\u6bcf\u5e74\u914d\u989d\u66f4\u65b0\u65f6\uff0c\u672a\u4f7f\u7528\u7684\u514d\u8d39\u989d\u5ea6\u5c06\u5931\u6548\u3002\u5bf9\u4e8e\u591a\u6570\u7ec4\u7ec7\u800c\u8a00\uff0c\u8fd9\u4e00\u989d\u5ea6\u8db3\u4ee5\u652f\u6301\u5185\u90e8\u8fd0\u8425\u548c\u53ef\u6301\u7eed\u6027\u8bc4\u4f30\uff0c\u4e5f\u8db3\u591f\u5176\u76f4\u63a5\u5411\u653f\u5e9c\u76d1\u7ba1\u673a\u6784\u53ca\u975e\u8425\u5229\u7ba1\u7406\u673a\u6784\u63d0\u4ea4\u81ea\u613f\u627f\u8bfa\u7684\u62a5\u544a\u3002\u8d85\u51fa\u5e74\u5ea6\u514d\u8d39\u989d\u5ea6\u540e\uff0c\u5206\u6790\u548c\u9762\u79ef\u7528\u91cf\u5c06\u6536\u53d6\u8d39\u7528\uff0c\u5411\u7b2c\u4e09\u65b9\u53d1\u5e03\u3001\u5206\u53d1", "cefb51667f72a8b1d37491c954b86e54": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5728\u6b64\u5904</a>\u67e5\u770b\u5173\u4e8e\u5982\u4f55\u9009\u62e9 Pro \u6a21\u677f\u7684\u8bf4\u660e\uff0c\u7136\u540e\u4ece\u201c\u5730\u70b9\u201d\u9875\u9762\u4e0b\u8f7d\u8be5\u6a21\u677f shapefile \u683c\u5f0f\u6587\u4ef6\u7684 .zip \u538b\u7f29\u5305\u793a\u4f8b\uff0c\u4ee5\u4f9b\u53c2\u8003\u3002&nbsp;", "0e915e1eee2b6ddc08d994b3bda3943b": "\u5982\u679c\u60a8\u4f7f\u7528\u7684\u662f KMZ \u6587\u4ef6\uff0c\u8bf7\u5148\u5728 Google Earth \u4e2d\u53f3\u952e\u5355\u51fb\u6b64\u6587\u4ef6\uff0c\u7136\u540e\u9009\u62e9\u201c\u53e6\u5b58\u4e3a\u201d\uff0c\u5c06\u5176\u4fdd\u5b58\u4e3a KML \u683c\u5f0f&nbsp;", "c05dbf3a64be44f372c98ca604b45ce1": "KML/KMZ \u6587\u4ef6\u7684\u6295\u5f71\u5750\u6807\u7cfb\u5e94\u53c2\u8003\u4e16\u754c\u5927\u5730\u6d4b\u91cf\u7cfb\u7edf 1984 (World Geodetic System 1984, WGS84)\u3002KML/KMZ \u6587\u4ef6\u5728\u521b\u5efa\u65f6\u5df2\u9ed8\u8ba4\u91c7\u7528\u8be5\u5750\u6807\u7cfb\u3002\u5c3d\u7ba1\u5982\u6b64\uff0c\u6211\u4eec\u4ecd\u5efa\u8bae\u60a8\u5148\u884c\u786e\u8ba4\u3002&nbsp;&nbsp;", "b45ade75854052e5211f82700271041e": "\u8bf7\u518d\u6b21\u68c0\u67e5 KML \u6587\u4ef6\u662f\u5426\u542b\u6709\u6240\u6709\u5fc5\u9700\u5c5e\u6027\u3002\u60a8\u5fc5\u987b\u5728 KML \u6587\u6863\u5f00\u5934\u4e3a\u6587\u4ef6\u4e2d\u7684\u6bcf\u4e2a\u8981\u7d20\u5b9a\u4e49\u5c5e\u6027\u5b57\u6bb5\u3002&nbsp;&nbsp;", "6891c2dfe2ebabe2f2b0555a3ef4dbe6": "\u5904\u7406\u548c\u5206\u6790\u7a7a\u95f4\u6570\u636e\u662f\u4e00\u4e2a\u590d\u6742\u6d41\u7a0b\uff0c\u6709\u65f6\uff0c\u5728 GFW Pro \u4e0a\u4f20\u548c\u5206\u6790\u6570\u636e\u53ef\u80fd\u4f1a\u51fa\u73b0\u9519\u8bef\uff0c\u5bfc\u81f4\u7528\u6237\u65e0\u6cd5\u63a5\u6536\u5206\u6790\u7ed3\u679c\u3002GFW Pro \u5e73\u53f0\u914d\u7f6e\u4e86\u591a\u79cd\u65b9\u6cd5\uff0c\u5e2e\u52a9\u89e3\u51b3\u5730\u70b9\u51fa\u73b0\u7684\u51e0\u4f55\u548c\u5206\u6790\u9519\u8bef\uff0c\u786e\u4fdd\u60a8\u63a5\u6536\u7684\u6570\u636e\u6e05\u6670\u3001\u51c6\u786e\u3002&nbsp;", "ace64b06c6e3d9d99efb7fa10877238c": "\u672c\u6307\u5357\u5c06\u91cd\u70b9\u4ecb\u7ecd\u5982\u4f55\u7406\u89e3\u4e0a\u4f20\u6570\u636e\u4e2d\u7684\u9519\u8bef\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u51b3\u8fd9\u4e9b\u9519\u8bef\uff0c\u4ece\u800c\u9488\u5bf9\u5730\u70b9\u751f\u6210\u66f4\u7cbe\u786e\u7684\u7ed3\u679c\u3002&nbsp;", "ea3ecaccff8decd15ab1d304e099ae07": "\u51e0\u4f55\u9519\u8bef", "a15e2eaffa0d9be9a0acbaf86bfe7f20": "\u6253\u5f00 KML/KMZ \u6587\u4ef6\uff0c\u68c0\u67e5\u5176\u51e0\u4f55\u3002KML/KMZ \u6587\u4ef6\u5e94\u4ec5\u5305\u542b\u591a\u8fb9\u5f62\u6216\u70b9\u72b6\u51e0\u4f55\u3002\u5982\u679c\u6587\u4ef6\u5305\u542b\u7ebf\u72b6\u51e0\u4f55\u6216\u56fe\u50cf\u3001HTML \u7b49\u989d\u5916\u8981\u7d20\uff0c\u5219\u53ef\u80fd\u9700\u8981\u91cd\u65b0\u521b\u5efa KML/KMZ \u6587\u4ef6\uff0c\u4ee5\u79fb\u9664\u4e0d\u7b26\u5408\u8981\u6c42\u7684\u8981\u7d20\u3002&nbsp;&nbsp;", "2889f67b2befaf7614e8d38a020c1dc4": "\u8bf7\u5728 Google Earth \u4e2d\u6253\u5f00 KML\uff0c\u786e\u4fdd\u6240\u6709\u8981\u7d20\u90fd\u4f4d\u4e8e\u9646\u5730\u4e0a\u3002\u5982\u6709\u4e0d\u5728\u9646\u5730\u4e0a\u7684\u8981\u7d20\uff0c\u8bf7\u79fb\u9664\u4f4d\u4e8e\u6d77\u6d0b\u6216\u5176\u4ed6\u6c34\u4f53\u7684\u591a\u8fb9\u5f62\u6216\u70b9\u72b6\u51e0\u4f55\u3002\u5982\u9700\u5220\u9664\u591a\u8fb9\u5f62\u6216\u70b9\u72b6\u51e0\u4f55\uff0c\u8bf7\u5728\u6587\u4ef6\u5bfc\u51fa\u4e3a shapefile \u683c\u5f0f\u540e\uff0c\u4e8e\u5185\u5bb9\u5217\u8868\u4e2d\u53f3\u952e\u5355\u51fb\u76f8\u5e94\u8981\u7d20\uff0c\u7136\u540e\u70b9\u51fb\u201c\u5220\u9664\u201d\u3002&nbsp;", "2763ec25815a51e55dbdcc7863959d15": "\u51e0\u4f55\u9519\u8bef\u7531\u7a7a\u95f4\u8f93\u5165\u6570\u636e\u95ee\u9898\u5bfc\u81f4\u3002\u4f8b\u5982\uff1a\u4f4d\u4e8e\u6d77\u6d0b\u4e2d\u7684\u5750\u6807\u6570\u636e\uff0c\u6216\u81ea\u76f8\u4ea4\u7684\u591a\u8fb9\u5f62\u3002\u8fd9\u4e9b\u9519\u8bef\u4f1a\u5bfc\u81f4 GFW Pro \u5224\u5b9a\u67d0\u4e2a\u5730\u70b9\u65e0\u6548\uff0c\u56e0\u6b64\u5e73\u53f0\u65e0\u6cd5\u4e3a\u5176\u751f\u6210\u5206\u6790\u6570\u636e\u3002&nbsp;&nbsp;", "8cb63ae9d9f082149eff5f6a376864ba": "\u5730\u70b9\u5fc5\u987b\u4f4d\u4e8e\u9646\u5730\u4e0a&nbsp;", "38d1beb6c3f10058d20d34a71766e639": "\u5982\u679c\u5730\u70b9\u4ee5\u70b9\u548c\u534a\u5f84\u4e3a\u7ed8\u5236\u57fa\u7840\uff0c\u5219\u5750\u6807\u6570\u636e\u5fc5\u987b\u91c7\u7528\u5341\u8fdb\u5236\u5ea6\u8868\u793a\u6cd5\uff08\u81f3\u5c11\u4fdd\u7559 6&nbsp;\u4f4d\u5c0f\u6570\uff09\uff0c\u5e76\u5177\u6709\u6709\u6548\u7684\u5206\u6790\u534a\u5f84\u6216\u5206\u6790\u9762\u79ef\u503c\u3002&nbsp;", "1f660c41a5d91ecf4fa09d7453782d61": "\u5730\u70b9\u540d\u79f0\u4e0d\u5f97\u542b\u6709\u7279\u6b8a\u5b57\u7b26\uff0c\u4e5f\u4e0d\u5e94\u6709\u9996\u5c3e\u7a7a\u683c\u3002&nbsp;", "3f0e780ddb58a07844a9a39ed8b992d5": "\u5982\u679c\u5df2\u4e0a\u4f20\u5217\u8868\u56e0\u51e0\u4f55\u9519\u8bef\u672a\u80fd\u5b8c\u6210\u5206\u6790\uff0cGFW Pro \u5c06\u901a\u8fc7\u7535\u5b50\u90ae\u4ef6\u901a\u77e5\u60a8\u5206\u6790\u672a\u5b8c\u6210\uff0c\u5e76\u5c06\u8be5\u5217\u8868\u8bbe\u4e3a\u8349\u7a3f\u72b6\u6001\u3002\u60a8\u53ef\u4ee5\u5728\u201c\u5730\u70b9\u201d\u9875\u9762\u8bbf\u95ee\u8349\u7a3f\u5217\u8868\u3002&nbsp;", "dea0ac9d766ed9d3c54de756eebdbe5b": "\u5728\u8349\u7a3f\u72b6\u6001\u4e0b\uff0c\u5b58\u5728\u9519\u8bef\u7684\u5730\u70b9\u5c06\u4ee5\u6a59\u8272\u9ad8\u4eae\u663e\u793a\u3002\u60a8\u53ef\u4ee5\u5c06\u9f20\u6807\u60ac\u505c\u5728\u8fd9\u4e9b\u5730\u70b9\u4e0a\uff0c\u5373\u53ef\u67e5\u770b\u5730\u70b9\u672a\u80fd\u5f97\u5230\u5206\u6790\u7684\u8be6\u7ec6\u539f\u56e0\u8bf4\u660e\u3002&nbsp;", "193d69c086dc85efeca88bc5f4577b9a": "\u4e86\u89e3\u5730\u70b9\u4e2d\u5b58\u5728\u9519\u8bef\u7684\u539f\u56e0\u540e\uff0c\u60a8\u53ef\u4ee5\u79bb\u7ebf\u4fee\u6b63\u9519\u8bef\uff0c\u5e76\u51c6\u5907\u91cd\u65b0\u4e0a\u4f20\u3002\u5728\u91cd\u65b0\u4e0a\u4f20\u524d\uff0c\u8bf7\u52a1\u5fc5\u4ece\u8349\u7a3f\u72b6\u6001\u5217\u8868\u4e2d\u5220\u9664\u539f\u6709\u6587\u4ef6\uff0c\u4ee5\u4fbf\u66ff\u6362\u4e3a\u65b0\u4e0a\u4f20\u5185\u5bb9\u3002&nbsp;", "f984a63bcda484247469d6e3a88a493c": "\u5730\u70b9\u5b58\u5728\u65e0\u6548\u5750\u6807\u6570\u636e&nbsp;", "ff5197d95f137cbe5efaa0a80e070db0": "\u4f7f\u7528\u5305\u542b\u70b9\u548c\u534a\u5f84\u6570\u503c\u7684\u7535\u5b50\u8868\u683c\u4e0a\u4f20\u5730\u70b9\u65f6\uff0c\u53ef\u80fd\u4f1a\u51fa\u73b0\u6b64\u9519\u8bef\u3002\u8be5\u9519\u8bef\u8868\u660e\u5e73\u53f0\u65e0\u6cd5\u8bc6\u522b\u60a8\u7684\u5750\u6807\u6570\u636e\u3002\u8bf7\u786e\u4fdd\u60a8\u7684\u5750\u6807\u91c7\u7528\u5341\u8fdb\u5236\u5ea6\u8868\u793a\u6cd5\uff08\u5efa\u8bae\u81f3\u5c11\u4fdd\u7559 6 \u4f4d\u5c0f\u6570\uff09\u4e14\u5904\u4e8e\u6709\u6548\u503c\u8303\u56f4\u5185\u3002\u7ed3\u679c\u683c\u5f0f\u59cb\u7ec8\u4fdd\u6301\u4e3a (\u7ecf\u5ea6, \u7eac\u5ea6)\u3002\u5728\u5341\u8fdb\u5236\u5ea6\u8868\u793a\u6cd5\u4e2d\uff0c\u7eac\u5ea6\u503c\u8303\u56f4\u4e3a \u201390 \u81f3 90\uff0c\u7ecf\u5ea6\u503c\u4e3a \u2013180 \u81f3 180\u3002&nbsp;\u8bf7\u786e\u4fdd\u6587\u4ef6\u7684\u201c\u7eac\u5ea6\u201d\u5217\u548c\u201c\u7ecf\u5ea6\u201d\u5217\u5747\u4e3a\u6570\u503c\u683c\u5f0f\u3002\u6b64\u5916\uff0c\u8bf7\u52a1\u5fc5\u4f7f\u7528\u53e5\u70b9 (.) \u800c\u975e\u9017\u53f7 (,) \u4f5c\u4e3a\u5c0f\u6570\u70b9\u3002&nbsp;", "5b82c1ad123cb9b6e911d4443b6cceae": "\u5206\u6790\u534a\u5f84\u6216\u9762\u79ef\u6570\u503c\u7f3a\u5931\u6216\u65e0\u6548&nbsp;", "5c6854f21ac4d052334c894897651dec": "\u4f7f\u7528\u5305\u542b\u70b9\u548c\u534a\u5f84\u6570\u503c\u7684\u7535\u5b50\u8868\u683c\u6807\u793a\u5730\u70b9\u65f6\uff0c\u53ef\u80fd\u4f1a\u51fa\u73b0\u6b64\u9519\u8bef\u3002\u8be5\u9519\u8bef\u8868\u660e\u5730\u70b9\u7f3a\u5c11\u6709\u6548\u5206\u6790\u534a\u5f84\u6216\u9762\u79ef\u3002\u8bf7\u786e\u4fdd\u6240\u6709\u5730\u70b9\u5747\u5305\u542b\u5206\u6790\u9762\u79ef\u6216\u534a\u5f84\u6570\u503c\uff0c\u4e14\u8be5\u6570\u503c\u4e3a\u5927\u4e8e 0 \u7684\u6570\u5b57\u683c\u5f0f\u3002&nbsp;", "7d2535ddac33362073f1a8d48f1b61c0": "\u5206\u6790\u9519\u8bef", "c17fc0bd754d5249355d6e8a436401f6": "\u5206\u6790\u9519\u8bef\u7684\u53d1\u751f\uff0c\u662f\u7531\u4e8e\u67d0\u5730\u70b9\u867d\u5177\u6709\u6709\u6548\u51e0\u4f55\uff0c\u5374\u672a\u80fd\u901a\u8fc7 GFW Pro \u7684\u5206\u6790\u3002\u9020\u6210\u6b64\u9519\u8bef\u7684\u539f\u56e0\u662f\u5730\u70b9\u592a\u5c0f\uff0c\u5728\u6240\u9009\u5206\u6790\u7684\u7a7a\u95f4\u5206\u8fa8\u7387\u4e0b\u65e0\u6cd5\u6709\u6548\u6355\u6349\u3002&nbsp;", "1b75905a48ba8741e11aaf68b117de7d": "\u4e0b\u8868\u5217\u51fa\u4e86 GFW Pro \u4e0a\u53ef\u80fd\u51fa\u73b0\u7684\u51e0\u4f55\u9519\u8bef\u7c7b\u578b\u53ca\u89e3\u51b3\u65b9\u6cd5\uff1a&nbsp;", "902b0d55fddef6f8d651fe1035b7d4bd": "\u9519\u8bef", "52efbfa80f0e33fad0fbda3372df536e": "\u5730\u70b9\u4e0d\u5728\u9646\u5730\u4e0a\u3002&nbsp;", "f1b02ac5c497dc588ff126cd874cecfa": "\u8bf4\u660e\u4e0e\u6545\u969c\u6392\u9664\u63d0\u793a", "8438f293856e8303341b60c70b688fd3": "\u5730\u70b9\u5b58\u5728\u65e0\u6548\u51e0\u4f55\u3002&nbsp;", "fd5253443f738c31498022cee1f726ef": "GFW Pro \u5206\u6790\u7c7b\u578b&nbsp;", "da6880b0142cbcd5f7272f9183043bb2": "\u7a7a\u95f4\u5206\u8fa8\u7387", "d9611ccaa0545af68e9056d7bac9c13a": "\u5730\u70b9\u6700\u5c0f\u5c3a\u5bf8\u8981\u6c42&nbsp;", "39b2638610039db15304edccdeebe19e": "2020 \u5e74\u540e\u7684\u98ce\u9669\u8bc4\u4f30 (API:&nbsp;DefReport)&nbsp;", "4429ee7e68d737fbdaee0a16e1a9af94": "\u8fd1\u671f\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5 (API:Alerts)&nbsp;", "37cbbfe94b2cb415eeac09c7361fd95f": "\u8868 2\uff1a\u5206\u6790\u7c7b\u578b\u3001\u7a7a\u95f4\u5206\u8fa8\u7387\u53ca GFW Pro \u6240\u9700\u7684\u5730\u70b9\u6700\u5c0f\u5c3a\u5bf8\u3002", "d99095502d8ff57e5c7efb6eeb2c5f9a": "\u8bf7\u6ce8\u610f\uff0c\u5728\u67d0\u4e9b\u60c5\u51b5\u4e0b\uff0c\u5c3d\u7ba1\u67d0\u4e2a\u5730\u70b9\u6ee1\u8db3\u4e86\u6700\u5c0f\u5c3a\u5bf8\u8981\u6c42\uff0c\u5b83\u4ecd\u53ef\u80fd\u56e0\u51e0\u4f55\u5f62\u72b6\uff08\u5982\uff0c\u4e00\u4e2a\u6781\u4e3a\u7ec6\u957f\u7684\u591a\u8fb9\u5f62\uff09\u800c\u65e0\u6cd5\u4e0e\u50cf\u7d20\u4e2d\u5fc3\u70b9\u76f8\u4ea4\u3002\u6b64\u7c7b\u5730\u70b9\u4e5f\u5c06\u65e0\u6cd5\u8fdb\u884c\u5206\u6790\u3002\u5982\u679c\u60a8\u7684\u5217\u8868\u4e2d\u5b58\u5728\u672a\u80fd\u8fdb\u884c\u5206\u6790\u7684\u5730\u70b9\uff0c\u60a8\u5c06\u6536\u5230\u5bf9\u5176\u4ed6\u5730\u70b9\u7684\u51c6\u786e\u5206\u6790\u548c\u5bf9\u6574\u4e2a\u5217\u8868\u7684\u7efc\u5408\u5206\u6790\u3002\u5982\u9700\u83b7\u53d6\u51fa\u9519\u5730\u70b9\u7684\u5206\u6790\u7ed3\u679c\uff0c\u60a8\u9700\u8981\u79bb\u7ebf\u4fee\u6539\u8fd9\u4e9b\u5730\u70b9\uff0c\u7136\u540e\u91cd\u65b0\u63d0\u4ea4\u4ee5\u8fdb\u884c\u5206\u6790\u3002&nbsp;&nbsp;", "e90f812a36341388074cd90b93e959bf": "\u60a8\u5c06\u5728\u5217\u8868\u8be6\u60c5\u9875\u6536\u5230\u6709\u5173\u5730\u70b9\u5206\u6790\u5931\u8d25\u7684\u901a\u77e5\u3002\u5217\u8868\u8be6\u60c5\u9875\u5c06\u663e\u793a\u7ea2\u8272\u6a2a\u5e45\uff0c\u5206\u6790\u5931\u8d25\u7684\u5730\u70b9\u5c06\u4ee5\u7ea2\u8272\u9ad8\u4eae\u663e\u793a\u3002&nbsp;", "85ba4b335d2a2bd391e1765763615277": "\u4e3a\u89e3\u51b3\u5730\u70b9\u5206\u6790\u9519\u8bef\uff0c\u6211\u4eec\u5efa\u8bae\u60a8\u91c7\u53d6\u4ee5\u4e0b\u63aa\u65bd\uff1a&nbsp;", "9a0970c10500bfadddd636c49f75fda5": "\u5bf9\u6240\u6709\u4e0d\u89c4\u5219\u5f62\u72b6\u7684\u591a\u8fb9\u5f62\uff08\u5305\u62ec\u7ec6\u957f\u578b\u591a\u8fb9\u5f62\uff09\u8fdb\u884c\u7f13\u51b2\u533a\u5206\u6790\u3002&nbsp;", "b76cbf5e615183e0820c34093bf39729": "\u8981\u5f97\u5230\u6b63\u786e\u5206\u6790\uff0c\u5730\u70b9\u5fc5\u987b\u81f3\u5c11\u4e0e\u5206\u6790\u4e2d\u4f7f\u7528\u7684\u6570\u636e\u56fe\u5c42\u4e2d\u4e00\u4e2a\u50cf\u7d20\u7684\u4e2d\u5fc3\u70b9\u76f8\u4ea4\u3002\u5206\u6790\u6570\u636e\u56fe\u5c42\u7684\u7a7a\u95f4\u5206\u8fa8\u7387\u53d6\u51b3\u4e8e\u5e95\u5c42\u536b\u661f\u6570\u636e\u96c6\uff0c\u4e0d\u540c\u7684 GFW Pro \u5206\u6790\u7c7b\u578b\uff0c\u8be5\u5206\u8fa8\u7387\u4e5f\u5b58\u5728\u5dee\u5f02\u3002\u56e0\u6b64\uff0c\u67d0\u4e2a\u5730\u70b9\u6216\u8bb8\u80fd\u5b8c\u6210\u67d0\u4e00\u7c7b\u578b\u7684\u5206\u6790\uff0c\u5374\u65e0\u6cd5\u5b8c\u6210\u53e6\u4e00\u7c7b\u578b\u7684\u5206\u6790\u3002&nbsp;", "08cf518ef6f36207fd28fb8b53caec99": "\u8be5\u8868\u8be6\u7ec6\u5217\u51fa\u4e86\u4e0d\u540c\u7684\u5206\u6790\u7c7b\u578b\u3001\u5b83\u4eec\u4f7f\u7528\u7684\u7a7a\u95f4\u5206\u8fa8\u7387\u4ee5\u53ca\u5730\u70b9\u5e94\u6ee1\u8db3\u7684\u6700\u5c0f\u9762\u79ef\u8981\u6c42\u3002&nbsp;", "b6ba89979a5b78b6133ba4bb1fce326a": "\u52a9\u529b\u4f01\u4e1a\u901a\u8fc7\u9a71\u52a8\u5b9e\u6548\u7684\u5206\u6790\u5b9e\u73b0\u4f9b\u5e94\u94fe\u53ef\u6301\u7eed\u6027\u3002", "c46ae4f99d4d23fd127e7119c670a02f": "\u516c\u53f8\u3001\u5408\u4f5c\u793e\u3001\u94f6\u884c\u6216\u4efb\u4f55\u7ba1\u7406\u571f\u5730\u8d44\u4ea7\u7684\u7ec4\u7ec7\u5747\u53ef\u6807\u7ed8\u6570\u5343\u4e2a\u5730\u5757\u3001\u519c\u573a\u3001\u751f\u4ea7\u8bbe\u65bd\u6216\u5e02\u653f\u533a\u57df\u7684\u5730\u70b9\uff0c\u83b7\u53d6\u76f8\u5173\u62a5\u544a\uff0c\u8bbf\u95ee\u5de5\u4f5c\u9762\u677f\uff0c\u4ee5\u6b64\u8ffd\u8e2a\u5386\u53f2\u68ee\u6797\u635f\u5931\u60c5\u51b5\uff0c\u6216\u76d1\u63a7\u8fd1\u671f\u6797\u6728\u8986\u76d6\u635f\u5931\u548c\u706b\u8b66\u7684\u8fd1\u5b9e\u65f6\u8b66\u62a5\uff0c\u4ece\u800c\u8bc6\u522b\u9762\u4e34\u68ee\u6797\u6ee5\u4f10\u98ce\u9669\u7684\u9ad8\u5371\u533a\u57df\u3002\u672a\u6765\uff0c\u6211\u4eec\u5c06\u9010\u6b65\u6dfb\u52a0\u66f4\u591a\u57fa\u4e8e\u5730\u70b9\u7684\u5206\u6790\u4e0e\u6d1e\u5bdf\uff0c\u5305\u62ec\u9488\u5bf9\u975e\u68ee\u6797\u533a\u57df\u7684\u96f6\u8f6c\u6362\u6307\u6807\u53ca\u571f\u5730\u5229\u7528\u53d8\u5316 (LUC) \u6392\u653e\u91cf\u8ba1\u7b97\u3002&nbsp;", "6c70dcb0573ecd90fe41fa044ec14790": "\u81ea 2014 \u5e74\u8d77\uff0c", "16f855f999ba5071b4ab334735720aa6": "GFW \u5927\u5b97\u5546\u54c1\u5e94\u7528\u7a0b\u5e8f\uff08\u5df2\u4e8e 2018 \u5e74\u505c\u7528\uff09\u901a\u8fc7\u5730\u7406\u7a7a\u95f4\u6570\u636e\u5b9e\u73b0\u4e86\u5bf9\u68d5\u6988\u6cb9\u548c\u5927\u8c46\u4f9b\u5e94\u94fe\u4e2d\u68ee\u6797\u6ee5\u4f10\u98ce\u9669\u7684\u76d1\u63a7\u4e0e\u5206\u6790\u30022016 \u5e74\uff0c\u5728\u54a8\u8be2\u4e86 60 \u4f59\u540d\u91d1\u878d\u884c\u4e1a\u4e13\u4e1a\u4eba\u58eb\u540e\uff0cWRI \u53d1\u5e03\u4e86 GFW \u91d1\u878d\u5e94\u7528\u7a0b\u5e8f\u7684\u539f\u578b\u3002\u8bb8\u591a\u5927\u5b97\u5546\u54c1\u516c\u53f8\u4e0e\u91d1\u878d\u673a\u6784\u5bf9\u8fd9\u4e24\u4e2a\u5e94\u7528\u7a0b\u5e8f\u5c55\u73b0\u51fa\u4e86\u6d53\u539a\u5174\u8da3\u548c\u5f3a\u70c8\u9700\u6c42\u3002", "e03de1e87fcc4943b27795abd4d550b8": "150,000 \u4e2a\u5730\u70b9", "8702fba8a7895950502b96f726103d15": "\uff0c\u5b9e\u73b0\u8fd1\u5b9e\u65f6\u591a\u5e74\u5ea6\u52a8\u6001\u5b89\u5168\u76d1\u63a7\u60a8\u7684\u4f9b\u5e94\u94fe\u4e0e\u6295\u8d44\uff0c\u5e76\u6839\u636e\u4e00\u7cfb\u5217\u6307\u6807\u8bc4\u4f30\u68ee\u6797\u6ee5\u4f10\u98ce\u9669", "817b895f1ada63a64d6e75d279a9bc15": "\u80fd\u5206\u6790\u5927\u91cf\u8d44\u4ea7\uff08\u5355\u6b21\u591a\u8fbe 150,000 \u4e2a\u5730\u70b9\uff09\u4ee5\u8fdb\u884c\u98ce\u9669\u8bc4\u4f30\u548c\u5386\u53f2\u8d8b\u52bf\u5206\u6790\u3002", "9d4143c11e8769649de01d77244ee814": "GFW Pro", "f2b32bda85a5a4a613eb47fb01c57ce3": "\u91c7\u7528", "6c2b342757800cd2b85729886bdeeeef": "\u4fdd\u62a4\u533a\uff1a", "e4c19abb1f5bf1ce8907df937fe645c2": "\u6cd5\u5f8b\u4fdd\u62a4\u533a\uff08\u5982\u56fd\u5bb6\u516c\u56ed\u548c\u91ce\u751f\u52a8\u7269\u4fdd\u62a4\u533a\uff09\u6216\u4e16\u754c\u4fdd\u62a4\u533a\u6570\u636e\u5e93 (WDPA) \u5212\u5b9a\u7684\u4fdd\u80b2\u7ba1\u7406\u533a\u57df\u3002\u7531\u4e8e\u4f7f\u7528\u9650\u5236\uff0c\u4fdd\u62a4\u533a\u6570\u636e\u65e0\u6cd5\u5728 GFW Pro \u5e73\u53f0\u4e4b\u5916\u4e0b\u8f7d\u3002", "1775908bcf0511fd010583511775af48": "\u68d5\u6988\u6cb9\u5382\uff1a", "d8d807d5fa8f92159e16f9c00f4af296": "\u7efc\u5408\u8b66\u62a5\u96c6\u6210\u4e86\u4e09\u79cd\u8b66\u62a5\u7cfb\u7edf\uff0c\u6db5\u76d6 30 \u7c73\u548c 10 \u7c73\u5206\u8fa8\u7387\u7684\u53ef\u89c1\u5149\u53ca\u96f7\u8fbe\u5f71\u50cf\uff0c", "fe4324d2e25e858e359f3f61ee0b42f6": "\u6216\u8f6c\u552e GFW Pro \u7684\u5206\u6790\u5185\u5bb9\u8bb8\u53ef\u4e5f\u5c06\u6536\u53d6\u8d39\u7528\u3002\u8bf7\u53c2\u9605", "ee584de41703b07514f9ddfeaf73c990": "\u5b9a\u4ef7\u8868", "f134b74c03197b5177da190caf82704b": "\u4e86\u89e3\u66f4\u591a\u8be6\u7ec6\u4fe1\u606f\u3002&nbsp;", "d5267f4181927320ab611d12441f4587": "\u8be5\u5e94\u7528\u7a0b\u5e8f\u57fa\u4e8e GFW\u3001 Land &amp; Carbon Lab \u548c WRI \u7684\u524d\u6cbf\u65f6\u6548\u6027\u79d1\u5b66\u7814\u7a76\u6570\u636e\u4e3a\u57fa\u7840\u6784\u5efa\u800c\u6210\u3002\u5982\u9700\u4e86\u89e3 GFW \u7684\u5177\u4f53\u6570\u636e\u4fe1\u606f\uff0c\u8bf7\u8bbf\u95ee", "fd98d1ca96ae1d367acf7da0d295c2e4": "\u5728 GFW Pro \u4e2d\uff0c\u4e3a\u4fbf\u4e8e\u63a2\u7d22\u548c\u7528\u6237\u4f7f\u7528\uff0c\u6211\u4eec\u63d0\u4f9b\u4e86\u591a\u4e2a\u9884\u5904\u7406\u7684\u5217\u8868\u4ee5\u4f9b\u4f7f\u7528\u3002\u8fd9\u4e9b\u5217\u8868\u662f\u7531 WRI GFW \u56e2\u961f\u9009\u5b9a\u6216\u521b\u5efa\u7684\u6570\u636e\u56fe\u5c42\u3002\u60a8\u53ef\u4ee5\u4ece\u8fd9\u4e9b\u5217\u8868\u4e2d\u590d\u5236\u5730\u70b9\uff0c\u4ee5\u521b\u5efa\u81ea\u5df1\u7684\u5217\u8868\uff1a", "1016b68242774285c7ed6db8cbf91a16": "\u5168\u7403\u6240\u6709\u56fd\u5bb6/\u5730\u533a\u3001\u5dde\u548c\u6b21\u7ea7\u884c\u653f\u533a\u5212\u3002", "be5d5d37542d75f93a87094459f76678": "\u548c", "d70376e5f01d0769d42053847e9e7698": "\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5", "24668d3a27fc8aeedab54806452615ec": "\u3002\u672c\u6587\u8bba\u8bc1\u4e86\u8b66\u62a5\u96c6\u6210\u673a\u5236\u53ef\u66f4\u5feb\u68c0\u6d4b\u65b0\u5e72\u6270\uff0c\u5c06\u68c0\u6d4b\u901f\u5ea6\u52a0\u5feb\u6570\u5929\u81f3\u6570\u6708\uff0c\u540c\u65f6\u7f29\u77ed\u4e86\u9ad8\u7f6e\u4fe1\u5ea6\u5224\u5b9a\u6240\u9700\u7684\u5ef6\u8fdf\u3002\u5c06\u5149\u5b66\u4f20\u611f\u5668\u548c\u7a7f\u4e91\u96f7\u8fbe\u4f20\u611f\u5668\u76f8\u7ed3\u5408\uff0c\u5e73\u5747\u68c0\u6d4b\u7387\u53ef\u63d0\u9ad8\u81f3 97%\u3002\u8be5\u7ec4\u5408\u80fd\u68c0\u6d4b\u5dee\u5f02\u663e\u8457\u7684\u9a71\u52a8\u56e0\u7d20\u548c\u5404\u7c7b\u73af\u5883\u6761\u4ef6\uff08\u5982\u706b\u707e\u3001\u62e9\u4f10\u548c\u591a\u4e91\u73af\u5883\uff09\u3002", "e951a9ce27efe91d6c94b9dac58021aa": "\u53ca\u54a8\u8be2\u884c\u4e1a\u3002", "93f1fc10c7757b8b8ac05fc5ef940b27": "\u5982\u9700\u4e86\u89e3\u5404\u7ec4\u7ec7\u5982\u4f55\u4f7f\u7528 GFW Pro\uff0c\u8bf7\u89c2\u770b\u5ba2\u6237\u611f\u8a00", "0924677d7fd4e73545cb14a14b859624": "\u60a8\u53ef\u4ee5\u5728\u56e2\u961f\u53ca\u7ec4\u7ec7\u5185\u90e8\u5171\u4eab\u6570\u636e\u548c\u5206\u6790\uff0c", "3abf2ce2c6228066a41aba23614d55e4": "\u5305\u62ec\u63a7\u80a1", "62cc0b4ebb0b57b40778179234246c38": "\u60a8\u7684", "e032e227c8e67cc9488fde3b43dcbef8": "\u53cc\u51fb KML/KMZ \u6587\u4ef6\u6216\u6253\u5f00 Google Earth\uff0c\u5c06\u8be5\u6587\u4ef6\u6dfb\u52a0\u5230\u201c\u6211\u7684\u5730\u70b9\u201d\u3002&nbsp;", "94e2ca8a3462d5c18d0538eb202bf717": "\u4e3a\u786e\u4fdd\u6587\u4ef6\u80fd\u88ab GFW Pro \u5206\u6790\uff0c\u6587\u4ef6\u9700\u7b26\u5408\u5e73\u53f0\u7684 KML \u683c\u5f0f\u89c4\u8303\u3002Google Earth \u65e0\u6cd5\u521b\u5efa\u548c\u7f16\u8f91\u8868\u683c\uff0c\u5e76\u975e\u771f\u6b63\u7684\u5730\u7406\u4fe1\u606f\u7cfb\u7edf\u3002&nbsp;&nbsp;", "b9b3c4530104b28d32322f91e91cb801": "\u53ef\u4f7f\u7528 Notepad++ \u7f16\u8f91\u7684 KML \u6a21\u677f\u6587\u4ef6\u9884\u89c8", "2f2e6d5a31f79487ced9e0562b899fd8": "KML/KMZ \u6587\u4ef6\u683c\u5f0f\u9884\u89c8&nbsp;", "5d0466f4e374a1d451879dc8e6e53b75": "\u6216 API \u8bbf\u95ee\u76f8\u5173\u4e8b\u5b9c\uff09\uff0c\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3", "7352ce0b4e0665659ae6466c18decb2a": "\u8bb8\u53ef", "f9ac4548a2cb18c4d1241e559bce0900": "\u3002\u5982\u9700\u83b7\u53d6 GFW Pro \u7528\u6237\u652f\u6301\uff0c\u8bf7\u53c2\u9605", "507d3e5a5d4721867a95359d6014bd91": "\u6216\u901a\u8fc7\u6b64\u8868\u683c", "4525f6e1d5124cd80f38341d78e8a67d": "\u8054\u7cfb\u6211\u4eec", "290148f54fc82ed914a5b56b0f4b262d": "\u67e5\u770b\u8fd1\u5b9e\u65f6\u8b66\u62a5\uff0c\u76d1\u63a7\u5927\u89c4\u6a21\u8d44\u4ea7\u7ec4\u5408\u53d8\u5316\u52a8\u6001\u3002", "72fc0a0a1f67460413412d5a582d7995": "\u53ef\u5c06\u5206\u6790\u76f4\u63a5\u96c6\u6210\u81f3\u5185\u90e8\u6216\u4e13\u6709\u7cfb\u7edf\u7684 API\u3002&nbsp;", "e78b1fe69b86f8d7f2edf572023e15f3": "\u6211\u4eec\u7684\u5ba2\u6237\u6db5\u76d6\u98df\u54c1\u53ca\u519c\u4e1a\u3001\u91d1\u878d", "071bf96bd67048b79c85643197212579": "\u548c\u63a7\u6743\u6bcd\u5b9e\u4f53\uff08\u7edf\u79f0\u4e3a\u201c\u4f01\u4e1a\u201d\uff09\u3002\u4f01\u4e1a\u53ef\u5c06\u672a\u7ecf\u6539\u52a8\u4e14\u4fdd\u7559\u5c5e\u6027\u7684 GFW Pro \u8f93\u51fa\u6570\u636e\u4f5c\u4e3a\u91c7\u8d2d\u533a\u57df\u58f0\u660e\u7684\u4f50\u8bc1\u6750\u6599\u76f4\u63a5\u4f20\u9001\u7ed9\u653f\u5e9c\u76d1\u7ba1\u673a\u6784\uff0c\u6216\u76f4\u63a5\u4f20\u9001\u7ed9\u7ba1\u7406\u5e7f\u53d7\u8ba4\u53ef\u7684\u81ea\u613f\u6027\u53ef\u6301\u7eed\u6027\u62a5\u544a\u6846\u67b6\u7684\u975e\u8425\u5229\u7ec4\u7ec7\uff0c\u524d\u63d0\u662f\u6570\u636e\u63a5\u6536\u65b9\u4e0d\u5f97\u5bf9 GFW Pro \u539f\u59cb\u8f93\u51fa\u6570\u636e\u8fdb\u884c\u4e8c\u6b21\u4f20\u64ad\u6216\u5546\u4e1a\u5316\u4f7f\u7528\u3002\u5426\u5219\uff0c\u5219\u9700\u6309\u5730\u70b9\u6bcf\u5e74\u8d2d\u4e70", "81c9d26a11875ce112f151c135c0fe38": "\u5206\u8bb8\u53ef\uff0c", "b752390a6cad0e04c969691f4061bdd6": "\u5173\u952e\u5e02\u573a", "48456bb03312b49828966384bfb53afa": "\u70b9\u51fb KML \u6587\u4ef6\u4e2d\u7684\u4efb\u610f\u8981\u7d20\uff0c\u5373\u53ef\u5c55\u793a\u5176\u5b57\u6bb5\u53ca\u5bf9\u5e94\u503c\u3002KML/KMZ \u6587\u4ef6\u663e\u793a\u7684\u7ecf\u5ea6\u5728\u524d\uff0c\u7eac\u5ea6\u5728\u540e\u3002&nbsp;", "c82a3bbd3913d702ad744a1fd660970c": "\u53cc\u51fb\u56fe\u5c42\uff0c\u5373\u53ef\u7f29\u653e\u81f3\u663e\u793a\u6587\u4ef6\u5185\u7684\u6240\u6709\u5730\u70b9\u3002\u5982\u679c\u60a8\u60f3\u7f29\u653e\u81f3\u7279\u5b9a\u5730\u70b9\uff0c\u8bf7\u70b9\u51fb\u56fe\u5c42\u65c1\u8fb9\u7684\u5c0f\u4e09\u89d2\uff0c\u67e5\u770b KML/KMZ \u6587\u4ef6\u4e2d\u6240\u6709\u5df2\u4fdd\u5b58\u7684\u5730\u70b9\u3002&nbsp;", "b3793fd452227bd2e178abc339b4b487": "\u5982\u9700\u7f16\u8f91\u5b57\u6bb5\u8868\u683c\uff0c\u60a8\u53ef\u4ee5\u5728\u6587\u672c\u7f16\u8f91\u5668\uff08\u5982 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Notepad++</a>\uff09\u4e2d\u6253\u5f00 KML/KMZ \u6587\u4ef6\uff0c\u7136\u540e\u624b\u52a8\u7f16\u8f91\u4ee3\u7801\uff0c\u6216\u4f7f\u7528 GIS \u8f6f\u4ef6\u7f16\u8f91\uff08\u5982 QGIS \u6216 <a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">ArcGIS</a>\uff09\u3002KML/KMZ \u6587\u4ef6\u53ef\u5728 QGIS \u4e2d\u76f4\u63a5\u6253\u5f00\uff0c\u5e76\u5bfc\u51fa\u4e3a shapefile \u683c\u5f0f\u6587\u4ef6\u8fdb\u884c\u7f16\u8f91\u3002\u6709\u5173\u7528\u4e8e\u4e0a\u4f20\u7684 shapefile \u683c\u5f0f\u6587\u4ef6\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7<a href=\"{{2}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u70b9\u51fb\u6b64\u5904</a>\u67e5\u770b\u3002&nbsp;", "51fe8b90ad12ffb658e399235b5f9982": "\u5982\u679c\u60a8\u9700\u8981\u7f16\u8f91 KML/KMZ \u6587\u4ef6\u5c5e\u6027\uff0c\u4ee5\u786e\u4fdd\u5176\u7b26\u5408 GFW Pro \u7684\u683c\u5f0f\u89c4\u8303\uff0c\u60a8\u53ef\u4ee5\u5728 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Notepad ++</a> \u4e2d\u7f16\u8f91\u4ee3\u7801\u3002KML/KMZ \u6587\u4ef6\u57fa\u4e8e XML \u6807\u51c6\u8bbe\u8ba1\u3002\u5173\u4e8e\u7f16\u8f91\u6b64\u7c7b\u6587\u4ef6\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u67e5\u9605<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u3002&nbsp;", "5f041a09f94e23bdb7e0353c7f4c51bb": "\u4e86\u89e3\u4e0d\u540c\u7c7b\u578b\u7684\u5730\u70b9\u9519\u8bef", "dbd2fdb1da8039c3c10aeca6e4d81b96": "\u591a\u8fb9\u5f62\u672a\u95ed\u5408\u6216\u81ea\u76f8\u4ea4\u4f1a\u5bfc\u81f4\u51fa\u73b0\u6b64\u9519\u8bef\u3002\u8bf7\u4f7f\u7528\u5730\u7406\u4fe1\u606f\u7cfb\u7edf (GIS) \u8f6f\u4ef6\u68c0\u67e5\u60a8\u7684\u5730\u70b9\u662f\u5426\u5b58\u5728\u81ea\u76f8\u4ea4\u6216\u672a\u95ed\u5408\u591a\u8fb9\u5f62\u3002\u60a8\u53ef\u4ee5\u4f7f\u7528\u5546\u4e1a\u6216\u5f00\u6e90 GIS \u8f6f\u4ef6\u4e2d\u7684\u51e0\u4f55\u9a8c\u8bc1\u5de5\u5177\uff0c\u68c0\u67e5\u5730\u70b9\u4e2d\u662f\u5426\u5b58\u5728\u9519\u8bef\u3002&nbsp;", "f9a62f540439f8da3c28762c6ddad83a": "2000 \u5e74\u540e\u7684\u68ee\u6797\u53d8\u5316 (API:FCD)&nbsp;", "deb546acae2245cd87f1ab791b48a4b6": "\u884c\u653f\u533a\u5212\uff1a", "673a9c790b690754a94fff0ed1e5b545": "\u4e00\u822c\u54a8\u8be2\uff08\u5305\u62ec\u8be2\u4ef7", "8f446c035fc5fc3d2b31bd17f172a19d": "\u5b50\u516c\u53f8", "32fcefe6b82a00711d6efc704a57fb83": "\u624d\u80fd\u5411\u5916\u90e8\u5171\u4eab GFW Pro \u8f93\u51fa\u6570\u636e", "af7ed73c9e66712b0ec9e27ac59f210c": "\u8bf7\u67e5\u770b", "2ab6c16b9f20ae07e6db034cde81ea38": "\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002&nbsp;", "1fd3217bfe9649f0a20edc05db338206": "\u65e0\u8bba\u662f\u9700\u8981\u7ef4\u62a4", "a90d8abb97bd6fcf7f13265e98bb93d7": "\u51c6\u5165\u8d44\u683c\u7684\u751f\u4ea7\u5546\u548c\u5408\u4f5c\u793e\uff0c\u8fd8\u662f\u9700\u8981\u5728\u5b8c\u5584\u53ef\u6301\u7eed\u91c7\u8d2d\u5b9e\u8df5\u7684\u540c\u65f6\u964d\u4f4e\u5408\u89c4\u6027\u98ce\u9669\u7684\u8de8\u56fd\u516c\u53f8\uff0c\u53c8\u6216\u8005\u662f\u4f9b\u5e94\u94fe\u4e2d\u7684\u91d1\u878d\u670d\u52a1\u63d0\u4f9b\u5546\u548c\u54a8\u8be2\u673a\u6784\uff0cGFW Pro \u81f4\u529b\u4e8e\u6210\u4e3a\u5404\u7c7b\u673a\u6784\u8fdb\u884c\u9065\u611f\u76d1\u6d4b\u548c\u98ce\u9669\u8bc4\u4f30\u5206\u6790\u7684\u4e00\u7ad9\u5f0f\u5e73\u53f0\u3002\u6211\u4eec\u5c06\u6301\u7eed\u65b0\u589e\u5173\u952e\u6570\u636e\u56fe\u5c42\uff0c\u7814\u5236\u53ef\u9760\u5206\u6790\u529f\u80fd\uff0c\u4ee5", "21e15eab5e61984d76fe47681c37640b": "\u5168\u7403\u68d5\u6988\u6cb9\u5de5\u5382\u884c\u4e1a\u6807\u51c6\u53ca\u5176\u76f8\u5173\u6807\u8bc6\u7b26\u3002", "b126ad0bd34c3c343811cf13eda93de9": "\u7f6e\u4e8e\u540c\u4e00\u4e2a\u56fe\u5c42\u3002\u591a\u7cfb\u7edf\u53e0\u52a0\u4f1a\u6355\u6349\u4e0d\u540c\u666f\u89c2\u4e0b\u5404\u7c7b\u6811\u6728\u8986\u76d6\u635f\u5931\u7c7b\u578b\uff0c\u63d0\u9ad8\u8b66\u62a5\u7cbe\u5ea6\u4e0e\u4f18\u5148\u7ea7\u5224\u5b9a\u7684\u7f6e\u4fe1\u5ea6\u3002\u6709\u5173\u7efc\u5408\u8b66\u62a5\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605", "e10ab362db322edf9c8d862cea679c97": "\u79d1\u7814\u8bba\u6587", "f5d517b06fc0b1af5d599776e2f6f1d6": "\u6b64\u535a\u5ba2", "296d9cea6f737c9f912a4bd9a4c6014d": "\u7528\u6237\u5e94\u6ce8\u610f\uff0c\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u4f1a\u68c0\u6d4b\u6240\u6709\u7c7b\u578b\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\uff0c\u800c\u4e0d\u8003\u8651\u5176\u6210\u56e0\u662f\u4eba\u7c7b\uff08\u5982\u4f10\u6728\uff09\u8fd8\u662f\u81ea\u7136\uff08\u5982\u5c71\u4f53\u6ed1\u5761\uff09\u3002\u8b66\u62a5\u4e0d\u533a\u5206\u5929\u7136\u6797\u8986\u76d6\u548c\u4eba\u5de5\u6797\u8986\u76d6\u3002\u9274\u4e8e\u8fd9\u4e9b\u8b66\u62a5\u4e3b\u8981\u7528\u4e8e\u5b9e\u5730\u5de1\u6797\uff0c\u5176\u8bbe\u8ba1\u539f\u5219\u504f\u4fdd\u5b88\uff08\u5df2\u786e\u8ba4\u8b66\u62a5\u7684\u8bef\u62a5\u7387\u4e3a 1%\uff0c\u6f0f\u62a5\u7387\u4e3a 33%\uff09\u3002\u6700\u540e\uff0c\u5c3d\u7ba1\u8fd9\u4e9b\u8b66\u62a5\u4f1a\u6bcf\u5468\u66f4\u65b0\uff0c\u4f46\u5728\u7f3a\u4e4f\u7a7f\u4e91\u96f7\u8fbe\u8986\u76d6\u7684\u533a\u57df\uff0c\u6301\u7eed\u4e0d\u6563\u7684\u4e91\u5c42\u4f1a\u5bfc\u81f4\u8b66\u62a5\u4e8b\u4ef6\u5728\u53d1\u751f\u6570\u5468\u4e43\u81f3\u6570\u6708\u540e\u90fd\u65e0\u6cd5\u88ab\u68c0\u6d4b\u5230\u3002&nbsp;", "e5f8f41d2db12d376052279b1b732c46": "\u4e00\u9879\u5bf9\u706b\u8b66\u8fdb\u884c\u7684", "c17fec5d47aff332c14ebea7e0aa1d15": "\u8bc4\u4f30\u53d1\u73b0\uff0c\u5927\u90e8\u5206\u5730\u533a\u7684\u8bef\u62a5\u7387\u90fd\u8d8b\u4e8e\u96f6\u3002\u5728\u6240\u6709\u7ecf\u8bc4\u4f30\u533a\u57df\u4e2d\uff0c\u6700\u9ad8\u8bef\u62a5\u7387\u4ec5\u4e3a 1.2%\uff0c\u4e14\u4e3b\u8981\u4e0e\u9633\u5149\u7167\u5c04\u5728\u53cd\u5149\u5c4b\u9876\u4e0a\u6709\u5173\u3002VIIRS \u706b\u8b66\u65e0\u6cd5\u68c0\u6d4b\u706b\u60c5\u8fc7\u5c0f\u6216\u6e29\u5ea6\u8fc7\u4f4e\u7684\u60c5\u51b5\uff08\u901a\u5e38\u6307\u9762\u79ef\u5c0f\u4e8e 100 \u5e73\u65b9\u7c73\u6216\u6e29\u5ea6\u4f4e\u4e8e 700 \u5f00\u5c14\u6587\u5ea6\u7684\u60c5\u51b5\uff09\u3002", "c73bde94dd28566593aa82fea29b7b0d": "\u76ee\u524d\uff0cGFW Pro \u53ef\u63d0\u4f9b\u82f1\u8bed\u3001\u8461\u8404\u7259\u8bed", "acd4b44edece9a5a2cfa36366891ce30": "\u548c\u897f\u73ed\u7259\u8bed", "5505df1d4611b58d838b22aedaf54a02": "\u7248\u672c", "c5ba44eeb891c7c4dc452f150a70e3bd": "\u591a\u8fbe", "02b8e29b054460cdca4843a156064892": "GFW Pro \u662f\u4e00\u6b3e\u4f9b\u4f01\u4e1a\u548c\u94f6\u884c\u4f7f\u7528\u7684\u7ba1\u7406\u7cfb\u7edf\uff0c\u53ef\u5c06\u5730\u7406\u7a7a\u95f4\u6570\u636e\u89e3\u8bd1\u6210\u5177\u6709\u64cd\u4f5c\u6027\u7684\u51b3\u7b56\u4f9d\u636e\u3002\u5982\u679c\u60a8\u9700\u8981\u4e00\u6b21\u6027\u4e0a\u4f20\u548c\u5206\u6790", "c389216126650240afd18c5b97ed0aec": "\uff0c\u6216\u8fdb\u884c\u5173\u4e8e\u5b9e\u73b0\u6bc1\u6797\u627f\u8bfa\u7684\u8fdb\u5c55\u60c5\u51b5\u62a5\u544a\uff0cGFW Pro \u6216\u5c06\u6210\u4e3a\u60a8\u7684\u7406\u60f3\u5de5\u5177\u3002", "be82929c060cf33cc243c72aa9459cc5": "GFW Pro \u517c\u5bb9\u6700\u8fd1\u4e24\u4e2a\u7248\u672c\u7684&nbsp; Google Chrome \u6d4f\u89c8\u5668\u3001\u706b\u72d0\u6d4f\u89c8\u5668\u548c Microsoft Edge \u6d4f\u89c8\u5668\u3002\u60a8\u5fc5\u987b\u4f7f\u7528\u8fd9\u4e9b\u6d4f\u89c8\u5668\u624d\u80fd\u8bbf\u95ee Pro\u3002", "153e96bb2aeb24fe152bbde821a65d37": "\u6700\u4f73", "21cec257feb15bcc84e0acd5b0773883": "\u9690\u79c1", "487c7fc8b549e9cd955a2b6c7d66f510": "\u505a\u6cd5\uff0c\u786e\u4fdd\u7cfb\u7edf\u5404\u65b9\u9762\u53ca\u7528\u6237\u6570\u636e\u5b8c\u6574\u4e14\u5b89\u5168\u3002", "9d098ff02f6813055b869f6f9acd831c": "\u5728\u6b64", "162e31afc5ade88a04d3f428e97e8f46": "\u4e86\u89e3\u5173\u4e8e\u5b89\u5168\u6027", "5762f13454f9284c5001f40714c11e9d": "\u7684\u66f4\u591a\u4fe1\u606f", "e6a0487a1e0d3401fcb6c34c8ea3f549": "\u60a8\u53ef\u4ee5\u53c2\u9605\u6211\u4eec\u7684", "b074544b9bfbb1c3d80514f1ceacfed5": "\u8d44\u683c\u6761\u4ef6", "77291db8e9772cd9bba6f878c17aac18": "\u6bcf\u4e2a\u6570\u636e\u56fe\u5c42\u5747\u7ecf\u8fc7\u4e86\u4e25\u683c\u7684\u79d1\u5b66\u9a8c\u8bc1\uff0c\u4e14\u5404\u81ea\u5b58\u5728\u7279\u5b9a\u5c40\u9650\u6027\u3002", "161bab85e3ea94c9df41ebecb63a505d": "\u6b64\u5916\uff0c\u60a8\u4e5f\u53ef\u4ee5\u9009\u62e9\u91cd\u65b0\u4e0a\u4f20\u5b8c\u6574\u5217\u8868\uff08\u800c\u4e0d\u662f\u4ec5\u4e0a\u4f20\u6b64\u524d\u5b58\u5728\u9519\u8bef\u7684\u5730\u70b9\uff09\uff0c\u5e76\u4f5c\u4e3a\u65b0\u5217\u8868\u63d0\u4ea4\u3002&nbsp;", "cabdd94635b6f7da11fc34944239ea9d": "GFW Pro \u4e0d\u5206\u6790\u4f4d\u4e8e\u6d77\u6d0b\u4e2d\u7684\u5730\u70b9\u3002\u6240\u6709\u5730\u70b9\u90fd\u5fc5\u987b\u81f3\u5c11\u4e0e\u9646\u5730\u754c\u7ebf\u6709\u90e8\u5206\u91cd\u53e0\u3002\u5982\u679c\u662f\u5750\u6807\u6570\u636e\uff0c\u5750\u6807\u6570\u636e\u5fc5\u987b\u4f4d\u4e8e\u9646\u5730\u4e0a\u3002&nbsp;\u5982\u679c\u60a8\u4e0a\u4f20\u7684\u662f shapefile \u6570\u636e\uff0c\u8bf7\u4f7f\u7528 GIS \u8f6f\u4ef6\u4e2d\u7684\u5236\u56fe\u529f\u80fd\u786e\u4fdd\u5730\u70b9\u4f4d\u4e8e\u9646\u5730\u4e0a\u3002\u6b64\u5916\uff0c\u8bf7\u68c0\u67e5 shapefile \u6587\u4ef6\u662f\u5426\u5df2\u4f7f\u7528 WGS84 \u6295\u5f71\u5750\u6807\u7cfb\u3002\u6295\u5f71\u5750\u6807\u7cfb\u53d8\u66f4\u6709\u65f6\u4f1a\u5bfc\u81f4\u5730\u70b9\u5728\u4e0a\u4f20\u81f3 GFW Pro \u65f6\u53d1\u751f\u4f4d\u7f6e\u504f\u79fb\u3002&nbsp;\u5982\u679c\u60a8\u7684\u6570\u636e\u5b58\u50a8\u5728\u7535\u5b50\u8868\u683c\u4e2d\uff0c\u8bf7\u786e\u4fdd\u5750\u6807\u503c\u91c7\u7528\u5341\u8fdb\u5236\u5ea6\u8868\u793a\u6cd5\uff0c\u5e76\u6b63\u786e\u4f7f\u7528\u8d1f\u53f7\u6807\u793a\u5357\u534a\u7403\u548c\u897f\u534a\u7403\u5730\u533a\u3002\u5317\u534a\u7403 (N) \u548c\u4e1c\u534a\u7403 (E) \u4e3a\u6b63\u503c\uff0c\u5357\u534a\u7403 (S) \u548c\u897f\u534a\u7403 (W) \u4e3a\u8d1f\u503c\u3002\u5982\u4e0d\u614e\u9057\u6f0f\u8fd9\u4e00\u70b9\uff0c\u60a8\u7684\u70b9\u4f4d\u53ef\u80fd\u4f1a\u88ab\u5b9a\u4f4d\u81f3\u5730\u7403\u53e6\u4e00\u7aef\u3002&nbsp;", "d410dad0213e5084b63395e658993baa": "\u8868 1\uff1a\u9519\u8bef\u7c7b\u578b\uff0c\u8bf4\u660e\u53ca\u6392\u969c\u6307\u5357\u3002", "ca484650f8e6ffd1d97c9da37235decc": "\u5206\u6790\u5931\u8d25\u5730\u70b9\u5217\u8868\u7684\u793a\u4f8b\u3002\u7528\u6237\u53ef\u5c06\u9f20\u6807\u60ac\u505c\u5728\u5404\u4e2a\u6761\u76ee\u4e0a\uff0c\u67e5\u770b\u66f4\u8be6\u7ec6\u7684\u9519\u8bef\u6d88\u606f\u3002", "dde0a98e9cb078043c83792bdd4541f3": "\u786e\u4fdd\u5730\u70b9\u6ee1\u8db3\u6240\u6709\u6240\u9700\u5206\u6790\u7684\u6700\u5c0f\u5c3a\u5bf8\u8981\u6c42\uff08\u5982\u4e0a\u6240\u8ff0\uff09\u3002&nbsp;", "4a66f78d8540100835c88fc1a655445c": "\u5982\u9700\u54a8\u8be2\u5173\u4e8e\u4f7f\u7528\u3001\u5b9a\u4ef7\u3001\u8bb8\u53ef\u8bc1\u6216\u57fa\u4e8e API \u8bbf\u95ee\u7684\u4e8b\u5b9c\uff0c\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">gfwprosales@wri.org</a>.&nbsp;", "d1063d1f55ef33cd4edd16dc7a87aea3": "GFW Pro API \u4f7f\u7528\u6307\u5357", "b966be31c91d2dfb1d4e60450d3de4f1": "GFW Pro \u4e5f\u63d0\u4f9b\u5e74\u5ea6\u4f1a\u5458\u670d\u52a1\uff0c\u542b\u5546\u4e1a API \u8bbf\u95ee\u6743\u9650\u548c\u8fd1\u4e4e\u65e0\u9650\u5236\u7684\u4f7f\u7528\u91cf\u3002", "6e57d6c47d23024e41f4a1aac73a3ea9": "\u5b83", "41db1ce387ce81ee426d8006bbc3f29f": "2017 \u5e74\uff0cWRI \u63d0\u8bae\u5c06 GFW \u5927\u5b97\u5546\u54c1\u548c\u91d1\u878d\u529f\u80fd\u6574\u5408\u8fdb GFW Pro\u2014\u2014\u8fd9\u662f\u4e00\u4e2a\u4e13\u4e3a\u519c\u4e1a\u4f9b\u5e94\u94fe\u516c\u53f8\u6253\u9020\u7684\u901a\u7528\u5e73\u53f0\uff0c\u65e8\u5728\u4e3a\u5176\u63d0\u4f9b\u5185\u90e8\u7ba1\u7406\u548c\u51b3\u7b56\u652f\u6301\u7cfb\u7edf\u3002&nbsp;", "b5699ab7c7143dbbada415f4a51f6bb8": "\u5728 2017 \u5e74 1 \u6708\u7684\u4e16\u754c\u7ecf\u6d4e\u8bba\u575b\u5e74\u4f1a\u4e0a\u30022019 \u5e74\uff0cGFW Pro \u5e73\u53f0\u6b63\u5f0f\u53d1\u5e03\u3002\u4f5c\u4e3a\u4e00\u4e2a\u5b89\u5168\u4e14\u79c1\u5bc6\u7684\u5206\u6790\u5e73\u53f0\uff0cGFW Pro \u4e3a\u4f01\u4e1a\u63d0\u4f9b\u4e0e\u571f\u5730\u5229\u7528\u53ef\u6301\u7eed\u6027\u8868\u73b0\u76f8\u5173\u7684\u5546\u4e1a\u7ea7\u6d1e\u5bdf\u3002\u5728\u6700\u521d\u53d1\u5e03\u4e86\u96f6\u6bc1\u6797\u5408\u89c4\u6027\u5206\u6790\u540e\uff0c\u5e73\u53f0\u8fd8\u53d1\u5e03\u4e86\u4e00\u7cfb\u5217\u5176\u4ed6\u7c7b\u578b\u7684\u5206\u6790\u3002", "bc0b25a5a3d5c263e0bf96c519f022f1": "\u5728\u6b64\u9605\u8bfb\u65b0\u95fb\u7a3f", "ab88206dd3e3938d7c5805f2977f1fb9": "\u60a8\u7684\u5730\u70b9\u53ef\u80fd\u51fa\u73b0\u4e24\u79cd\u4e3b\u8981\u7684\u9519\u8bef\uff1a1) \u51e0\u4f55\u9519\u8bef\uff0c\u4ee5\u53ca 2) \u5206\u6790\u9519\u8bef\u3002&nbsp;", "6e8d6d5c87cba043dfca56990989f174": "GFW Pro \u5bf9\u4e8e\u6709\u6548\u5730\u70b9\u7684\u8981\u6c42\u5982\u4e0b\uff1a&nbsp;", "dd5155525188c4a01e150045247a6ad7": "\u5982\u679c\u5730\u70b9\u4ee5\u591a\u8fb9\u5f62\u4e3a\u7ed8\u5236\u57fa\u7840\uff0c\u5219\u8be5\u591a\u8fb9\u5f62\u5fc5\u987b\u95ed\u5408\u4e14\u4e0d\u81ea\u76f8\u4ea4\u3002", "7b03a1923593afa4498d8df97133512e": "\u5982\u679c\u60a8\u4e0a\u4f20\u4e86\u5b58\u5728\u51e0\u4f55\u9519\u8bef\u7684\u5217\u8868\uff0c\u5e73\u53f0\u5c06\u62e6\u622a\u5bf9\u5217\u8868\u7684\u5206\u6790\uff0c\u5e76\u5c06\u60a8\u4e0a\u4f20\u7684\u5185\u5bb9\u8bbe\u4e3a\u8349\u7a3f\u72b6\u6001\uff0c\u8ba9\u60a8\u53ef\u4ee5\u4fee\u6b63\u8f93\u5165\u6570\u636e\u3002\u56e0\u51e0\u4f55\u9519\u8bef\u5bfc\u81f4\u5206\u6790\u672a\u5b8c\u6210\u7684\u5217\u8868\u5c06\u4e0d\u6263\u9664\u5206\u6790\u989d\u5ea6\u3002&nbsp;&nbsp;", "c467efabbb94ffe1c6f6c6af8ae61844": "\u4e3a\u89e3\u51b3\u5df2\u4e0a\u4f20\u5217\u8868\u4e2d\u7684\u51e0\u4f55\u9519\u8bef\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a&nbsp;", "6dd86f36c3c6fac1403ffc9f71f1d4b3": "\u60a8\u53ef\u4ee5\u70b9\u51fb\u201c\u7b5b\u9009\u5b58\u5728\u9519\u8bef\u7684\u5730\u70b9\u201d\u590d\u9009\u6846\uff0c\u4ec5\u663e\u793a\u5b58\u5728\u9519\u8bef\u7684\u5730\u70b9\u5217\u8868\u3002\u8be5\u590d\u9009\u6846\u4f4d\u4e8e\u5217\u8868\u8868\u683c\u7684\u53f3\u4e0a\u65b9\u3002\u5e94\u7528\u7b5b\u9009\u540e\uff0c\u60a8\u53ef\u4f7f\u7528\u201c\u5168\u9009\u201d\u590d\u9009\u6846\uff08\u4f4d\u4e8e\u5217\u8868\u8868\u683c\u7684\u89d2\u843d\uff09\u4e00\u952e\u9009\u4e2d\u6240\u6709\u7b5b\u9009\u6761\u76ee\u3002&nbsp;", "f24bd4787249006ac6f886b66c24456d": "\u9519\u8bef\u72b6\u6001\u5217\u8868\u7684\u793a\u4f8b\u3002\u8be5\u5217\u8868\u5df2\u901a\u8fc7\u201c\u4ec5\u663e\u793a\u5b58\u5728\u9519\u8bef\u7684\u5730\u70b9\u201d\u590d\u9009\u6846\u529f\u80fd\u8fdb\u884c\u7b5b\u9009\uff0c\u4ec5\u5305\u542b\u5b58\u5728\u9519\u8bef\u7684\u5730\u70b9\u3002", "ddcce5f3f21894ed434cad72ff9f3c13": "CSV \u9519\u8bef\u6587\u4ef6\u529f\u80fd\u3002\u60a8\u5fc5\u987b\u9009\u4e2d\u5b58\u5728\u9519\u8bef\u7684\u5730\u70b9\uff0c\u7136\u540e\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u201c\u4e0b\u8f7d\u201d\u83dc\u5355\u4e0b\u8f7d\u9519\u8bef\u6587\u4ef6\u3002", "ce7bd26698b16fae73937fc73a5f0d46": "\u60a8\u53ef\u9009\u4e2d\u5b58\u5728\u9519\u8bef\u7684\u5730\u70b9\uff0c\u7136\u540e\u5728\u201c\u4e0b\u8f7d\u201d\u83dc\u5355\u9009\u62e9\u201c\u9519\u8bef\u6587\u4ef6\u201d\uff0c\u4ece\u800c\u4e0b\u8f7d CSV \u6587\u4ef6\uff0c\u67e5\u770b\u5730\u70b9\u7684\u9519\u8bef\u8be6\u60c5\u3002\u5728\u201c\u5730\u70b9\u201d\u9875\u9762\u4e2d\u5404\u5217\u8868\u6761\u76ee\u4e2d\u7684\u4e09\u7ea7\u83dc\u5355\u4e2d\uff0c\u60a8\u4e5f\u53ef\u4ee5\u8bbf\u95ee\u6b64\u529f\u80fd\u3002&nbsp;", "0331cb778ff4c0aac58b90015b462edd": "\u4e0a\u4f20\u6d41\u7a0b\u4e2d\u7684\u201c\u914d\u7f6e\u5217\u8868\u201d\u90e8\u5206\u3002\u7cfb\u7edf\u5df2\u9884\u9009\u4e2d\u539f\u5217\u8868\uff0c\u4ee5\u4fbf\u60a8\u6dfb\u52a0\u5730\u70b9\u3002\u60a8\u53ef\u4ee5\u9009\u62e9\u5176\u4ed6\u5217\u8868\uff0c\u4e5f\u53ef\u4ee5\u9009\u62e9\u521b\u5efa\u65b0\u5217\u8868\u3002", "f762cdbb6e0a4901e4ca0d358dd04b9d": "\u5982\u9700\u91cd\u65b0\u4e0a\u4f20\u6b64\u524d\u5b58\u5728\u9519\u8bef\u7684\u5730\u70b9\uff0c\u8bf7\u5bfc\u822a\u81f3\u8349\u7a3f\u72b6\u6001\u5217\u8868\uff0c\u7136\u540e\u70b9\u51fb\u201c\u6dfb\u52a0\u5730\u70b9\u201d\u3002\u8fd9\u5c06\u542f\u52a8\u4e0a\u4f20\u6d41\u7a0b\u3002\u4e0a\u4f20\u5305\u542b\u5df2\u4fee\u6b63\u5730\u70b9\u7684\u6587\u4ef6\uff0c\u5b8c\u6210\u4e0a\u4f20\u6d41\u7a0b\u3002\u9ed8\u8ba4\u60c5\u51b5\u4e0b\uff0c\u8fdb\u5165\u4e0a\u4f20\u6d41\u7a0b\u4e2d\u7684\u201c\u914d\u7f6e\u5217\u8868\u201d\u90e8\u5206\u65f6\uff0c\u7cfb\u7edf\u4f1a\u81ea\u52a8\u586b\u5145\u521d\u59cb\u5217\u8868\uff0c\u8fd9\u6837\u60a8\u5c31\u53ef\u4ee5\u5411\u5176\u4e2d\u6dfb\u52a0\u5df2\u4fee\u6b63\u5730\u70b9\u4e86\u3002\u60a8\u53ef\u4ee5\u5728\u6b64\u5904\u63d0\u4ea4\u8fdb\u884c\u5206\u6790\uff0c\u4e5f\u53ef\u4ee5\u4fdd\u5b58\u4e3a\u8349\u7a3f\uff0c\u4ee5\u5907\u7a0d\u540e\u63d0\u4ea4\u3002&nbsp;", "7eb1f1bbaf31ea92b0c7272b2b363ee1": "\u533a\u57df", "aacd8c7ea684a304a97554f8f3d64f5e": "\u60a8\u7684 My GFW \u8d26\u6237\u4e2d\u663e\u793a\u7684\u884c\u653f\u533a\u57df\uff0c\u5982\u56fd\u5bb6\u3001\u5730\u533a\u548c\u81ea\u6cbb\u5e02\u5c06\u4e0d\u4f1a\u540c\u6b65\u81f3\u60a8\u7684 Forest Watcher \u8d26\u6237\u3002&nbsp;&nbsp;", "e2f4112ae05335d91ab57e1cc0bfc817": "\u4e00\u4e2a\u533a\u57df\u7684\u6700\u5927\u9762\u79ef\u4e3a 20,000 km\u00b2\u3002&nbsp;&nbsp;", "d7926f52f4cc066f3d235a15d50d2631": "\u60a8\u53ef\u4ee5\u4e0e\u56e2\u961f\u5173\u8054\u7684\u533a\u57df\u6570\u91cf\u6ca1\u6709\u9650\u5236\uff0c\u4f46\u8bf7\u8bb0\u4f4f\uff0c\u5982\u679c\u60a8\u6b63\u5728\u4f7f\u7528 Forest Watcher \u79fb\u52a8\u7aef\uff0c\u90a3\u4e48\u533a\u57df\u8d8a\u591a\uff0c\u5c31\u610f\u5473\u7740\u9700\u8981\u4f20\u8f93\u81f3\u79fb\u52a8\u8bbe\u5907\u7684\u6570\u636e\u8d8a\u591a\u3002\u901a\u5e38\u6765\u8bf4\uff0c\u6211\u4eec\u5efa\u8bae\u5355\u4e2a\u56e2\u961f\u7684\u611f\u5174\u8da3\u533a\u57df\u4e0d\u8981\u8d85\u8fc7 5-10 \u4e2a\u3002\u56e2\u961f\u4e2d\u7684\u533a\u57df\u8d8a\u5c11\uff0c\u79fb\u52a8\u8bbe\u5907\u540c\u6b65\u6570\u636e\u7684\u901f\u5ea6\u5c31\u8d8a\u5feb\u3002&nbsp;", "cf7be8018334e66b3274d52227fc546a": "Forest Watcher \u4e0d\u652f\u6301\u590d\u6742\u7684\u591a\u9762\u591a\u8fb9\u5f62\u533a\u57df\u6216\u5177\u6709\u6570\u5343\u4e2a\u70b9\u7684\u533a\u57df\u3002\u5c3d\u7ba1 Forest Watcher \u5e38\u5b58\u5728\u591a\u9762\u591a\u8fb9\u5f62\u533a\u57df\uff0c\u4f46\u53ea\u6709\u7b2c\u4e00\u4e2a\u591a\u8fb9\u5f62\u624d\u4f1a\u663e\u793a\u3002\u6211\u4eec\u5f3a\u70c8\u5efa\u8bae\u60a8\u4f7f\u7528 GIS \u5bf9\u8fd9\u4e9b\u7279\u5b9a\u533a\u57df\u7684\u5f62\u72b6\u8fdb\u884c\u7b80\u5316\u3002\u60a8\u53ef\u4ee5\u6309\u7167 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">ArcGIS</a>  <a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">QGIS</a> \u7684\u6307\u5357\u64cd\u4f5c\uff0c\u7136\u540e\u5c1d\u8bd5\u518d\u6b21\u4e0a\u4f20\u8fd9\u4e9b\u533a\u57df\u3002\u6b64\u5916\uff0c\u8bf7\u52a1\u5fc5\u5728 My GFW \u8d26\u6237\u4e2d\u5220\u9664\u6240\u6709\u590d\u6742\u7684\u591a\u9762\u591a\u8fb9\u5f62\u533a\u57df\uff0c\u56e0\u4e3a\u5b83\u4eec\u53ef\u80fd\u4f1a\u5bfc\u81f4\u60a8\u7684 Forest Watcher \u8d26\u6237\u51fa\u73b0\u540c\u6b65\u95ee\u9898\u3002&nbsp;", "ed4e5fec24c5f7689b1fe24e6e5e532b": "\u8bb8\u591a\u79fb\u52a8\u8bbe\u5907\u4e0a\u7684 GPS \u7cbe\u5ea6\u8f83\u5dee\uff0c\u53ef\u80fd\u4f1a\u5f71\u54cd Forest Watcher \u7684\u90e8\u5206\u529f\u80fd\uff0c\u5305\u62ec\u5bfc\u822a\u81f3\u8b66\u62a5\u533a\u57df\u3001\u8ffd\u8e2a\u8def\u7ebf\u4ee5\u53ca\u5728\u73b0\u573a\u586b\u5199\u62a5\u544a\u6216\u5b8c\u6210\u4efb\u52a1\u3002\u5982\uff0c\u6587\u7ae0 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">We Tested Mobile GPS/GNSS Accuracy and Found Some Surprising Results</a> \u8bc4\u4f30\u4e86\u4e0d\u540c\u624b\u673a\u578b\u53f7\u7684\u5168\u7403\u536b\u661f\u5bfc\u822a\u7cfb\u7edf (GNSS) \u5b9a\u4f4d\u80fd\u529b\u7684\u51c6\u786e\u5ea6\uff0c\u7ed3\u679c\u8868\u660e\uff0c\u6839\u636e\u667a\u80fd\u624b\u673a\u7c7b\u578b\u3001\u624b\u673a\u4f4d\u7f6e\u3001\u548c\u624b\u673a\u7ecf\u8fc7\u7684\u8def\u5f84\uff0c\u5176 GNSS \u6027\u80fd\u5b58\u5728\u5dee\u5f02\u3002\u56e0\u6b64\uff0c\u5728\u8d2d\u4e70\u79fb\u52a8\u8bbe\u5907\u8fdb\u884c\u76d1\u6d4b\u524d\uff0c\u8bf7\u5168\u9762\u7814\u7a76\u6709\u5173\u6311\u9009<strong>\u9ad8\u8d28\u91cf GPS \u529f\u80fd</strong>\u7684\u624b\u673a\u7684\u7f51\u7edc\u5efa\u8bae\uff0c\u5305\u62ec\u6700\u65b0\u8bc4\u5206\u3001\u5730\u533a\u5dee\u5f02\u548c\u4e0e\u60a8\u7684\u60c5\u51b5\u76f8\u7b26\u7684\u5176\u4ed6\u53d8\u91cf\u3002&nbsp;", "4e8494a21a9ff6c9a37f26930cd25caf": "\u6309\u7c7b\u522b\u548c\u4e3b\u9898\u7b5b\u9009", "41f30311c0039eda31f33e58da2db8da": "\u6309\u7c7b\u522b\u7b5b\u9009", "8e1e594b8f84dfc20840c17b361f119e": "\u672a\u627e\u5230\u7b26\u5408\u8be5\u7b5b\u9009\u6761\u4ef6\u7684\u6587\u7ae0", "3e69cd44fc74a535c9df6efbed4fc0b8": "\u8fd4\u56de\u6240\u6709\u6587\u7ae0", "32e458e815d4353fdcdbe8da9c6b58ad": "\u706b\u707e&nbsp;<button><svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\"><defs><path id=\"close-white_svg__a\" d=\"M5 3.636L1.364 0 0 1.364 3.636 5 0 8.636 1.364 10 5 6.364 8.636 10 10 8.636 6.364 5 10 1.364 8.636 0z\"></path></defs><use fill=\"#FFF\" xlink:href=\"#close-white_svg__a\" fill-rule=\"evenodd\"></use></svg></button>", "eca0427fa3e03077228a8ced002e0a0d": "\u5982\u9700\u5220\u9664\u8d26\u6237\uff0c\u8bf7\u4f7f\u7528\u4e0e\u60a8\u8981\u5220\u9664\u7684\u8d26\u6237\u76f8\u540c\u7684\u7535\u5b50\u90ae\u7bb1\u8054\u7cfb\u6211\u4eec\uff0c\u8054\u7cfb\u65b9\u5f0f\u4e3a forestwatcher@wri.org\u3002\u60a8\u4e5f\u53ef\u4ee5\u4f7f\u7528 Forest Watcher \u79fb\u52a8\u7aef\u5e94\u7528\u7a0b\u5e8f\uff0c\u5982\u4e0b\u65b9\u5c4f\u5e55\u622a\u56fe\u6240\u793a\u63d0\u51fa\u8d26\u6237\u5220\u9664\u8bf7\u6c42\u3002\u8bf7\u6ce8\u610f\uff0c\u60a8\u7684 Forest Watcher \u8d26\u6237\u5df2\u5171\u4eab [\u2026]", "0db377921f4ce762c62526131097968f": "\u901a\u7528", "3327b6a6f8964b6577835fee0376766b": "Forest Watcher \u9650\u5236", "5cb9a7c7911d831463d4261a4a11aacd": "Forest Watcher \u9650\u5236&nbsp;", "68724db6ae798c80bc8087a1eced51c2": "<a href=\"{{0}}\">\u5e2e\u52a9\u4e2d\u5fc3\u4e3b\u9875</a><span class=\"css-1h3kxp2 e8lo49c0\">/</span><a href=\"{{1}}\">Forest Watcher</a><span class=\"css-1h3kxp2 e8lo49c0\">/</span><a href=\"{{2}}\">\u5176\u4ed6\u6750\u6599</a><span class=\"css-1h3kxp2 e8lo49c0\">/</span>Forest Watcher \u9650\u5236&nbsp;", "73ed2f8c8aa6af3f9cdca2cb50cc97c0": "\u533a\u57df&nbsp; GPS&nbsp;", "f2d68be7637a30eda3df494fc9ae430a": "\u6cb9\u68d5\u7279\u8bb8\u6743&nbsp;", "c55bb9c809426572fadbac6624870a42": "\u4e86\u89e3\u6700\u65b0\u4fe1\u606f\u3002&nbsp;", "b935096712b177aa63289fcef3c456d4": "\u91c7\u77ff\u7279\u8bb8\u6743", "4299c2d7d21b47864d07733d67a63ae8": "\u7ed3\u679c\u663e\u793a\uff0cGNSS \u6027\u80fd\u56e0\u667a\u80fd\u624b\u673a\u7c7b\u578b\u3001\u624b\u673a\u4f4d\u7f6e\u548c\u624b\u673a\u884c\u7ecf\u8def\u5f84\u800c\u5f02\u3002 \u56e0\u6b64\uff0c\u5728\u8d2d\u4e70\u7528\u4e8e\u76d1\u6d4b\u7684\u79fb\u52a8\u8bbe\u5907\u4e4b\u524d\uff0c\u8bf7\u4ed4\u7ec6\u7814\u7a76\u5728\u7ebf\u5efa\u8bae\uff0c\u4e86\u89e3\u5982\u4f55\u9009\u62e9\u5177\u6709<strong>\u9ad8\u8d28\u91cf GPS \u529f\u80fd</strong>\u7684\u624b\u673a\uff0c\u5305\u62ec\u6700\u65b0\u8bc4\u5206\u3001\u5730\u533a\u5dee\u5f02\u4ee5\u53ca\u9488\u5bf9\u60a8\u5177\u4f53\u60c5\u51b5\u7684\u5176\u4ed6\u53d8\u91cf\u3002&nbsp;", "263030983848bd29a5df50c823e53d34": "\u8bb8\u591a\u79fb\u52a8\u8bbe\u5907\u4e0a\u7684 GPS \u7cbe\u5ea6\u8f83\u5dee\uff0c\u8fd9\u53ef\u80fd\u4f1a\u5f71\u54cd Forest Watcher \u7684\u591a\u9879\u529f\u80fd\uff0c\u5305\u62ec\u5bfc\u822a\u5230\u9884\u8b66\u5730\u5757\u3001\u8ddf\u8e2a\u8def\u7ebf\u4ee5\u53ca\u5b8c\u6210\u62a5\u544a\u6216\u73b0\u573a\u4f5c\u4e1a\u3002\u4f8b\u5982\uff0c\u6587\u7ae0\u201c<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6211\u4eec\u6d4b\u8bd5\u4e86\u79fb\u52a8 GPS/GNSS \u7cbe\u5ea6\uff0c\u53d1\u73b0\u4e86\u4e00\u4e9b\u4ee4\u4eba\u60ca\u8bb6\u7684\u7ed3\u679c</a>\u201d\u8bc4\u4f30\u4e86\u4e0d\u540c\u624b\u673a\u578b\u53f7\u7684 GNSS\uff08\u5168\u7403\u5bfc\u822a\u536b\u661f\u7cfb\u7edf\uff09\u5b9a\u4f4d\u529f\u80fd\u7684\u7cbe\u5ea6\u3002"});