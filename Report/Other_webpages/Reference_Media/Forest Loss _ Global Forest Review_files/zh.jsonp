e\uff0c\u5728\u8be5\u5730\u533a\uff0c\u6b64\u5e72\u6270\u9879\u66f4\u4e3a\u5e38\u89c1\u3002\u4f5c\u8005\u6709 75% \u7684\u628a\u63e1\u8ba4\u4e3a\u635f\u5931\u53d1\u751f\u5728\u6240\u8ff0\u5e74\u4efd\u5185\uff0c\u6709 97% \u7684\u628a\u63e1\u8ba4\u4e3a\u635f\u5931\u53d1\u751f\u5728\u6240\u8ff0\u5e74\u4efd\u4e4b\u524d\u6216\u4e4b\u540e\u7684\u4e00\u5e74\u3002\u6570\u636e\u7528\u6237\u53ef\u7814\u7a76\u591a\u5e74\u5e73\u5747\u503c\uff0c\u4ece\u800c\u6d88\u9664\u6b64\u7c7b\u4e0d\u786e\u5b9a\u6027\u3002\u53c2\u9605\u6211\u4eec\u5173\u4e8e\u6b64\u6570\u636e\u51c6\u786e\u5ea6\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u7cfb\u5217\u535a\u5ba2</a>\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002", "7d673d04cf75f5fa761a07819de7f97d": "\u4ece {start_date} \u81f3 {end_date}\uff0c{location} \u5171\u7ecf\u5386\u4e86 {total_alerts} {dataset} \u6b21\u706b\u707e\u8b66\u62a5\uff0c\u4ec5\u8003\u8651<b>\u9ad8\u7f6e\u4fe1\u5ea6</b>\u8b66\u62a5\u3002", "3ab529af9644022d32d7c2fdea9c556e": "\u897f\u975e\u53ef\u53ef\u5730\u5757\u70ed\u529b\u56fe", "5bfc01915015560e0d430149f01b8360": "\u663e\u793a 2021 \u5e74\u79d1\u7279\u8fea\u74e6\u548c\u52a0\u7eb3\u7684\u53ef\u53ef\u5730\u5757\u5206\u5e03\u5bc6\u5ea6", "032d58327ceb047afc5d50317c41a545": "\u6bcf\u5e73\u65b9\u516c\u91cc\u53ef\u53ef\u5730\u5757\u5206\u5e03\u56fe", "07b5864adfb4374942fa661bb6e344de": "GFW \u73b0\u5df2\u63a8\u51fa\u4e24\u4e2a\u65b0\u8d44\u6e90\uff1a<a href=\"{{0}}\" rel=\"noopener\" target=\"_blank\">\u897f\u975e\u53ef\u53ef\u6570\u636e\u96c6</a>\u548c<a href=\"{{1}}\" rel=\"noopener\" target=\"_blank\">\u53ef\u53ef\u68ee\u6797\u780d\u4f10\u98ce\u9669\u8bc4\u4f30</a>\uff0c\u4ee5\u5e2e\u52a9\u89c2\u5bdf\u52a0\u7eb3\u548c\u79d1\u7279\u8fea\u74e6\u7684\u91cd\u70b9\u9886\u57df\uff0c\u4ece\u800c\u534f\u8c03\u52aa\u529b\uff0c\u5b9e\u73b0\u96f6\u68ee\u6797\u780d\u4f10\u7684\u53ef\u53ef\u884c\u4e1a\u3002<a href=\"{{2}}\" rel=\"noopener\" target=\"_blank\">\u9605\u8bfb\u6211\u4eec\u7684\u535a\u5ba2\uff0c\u4e86\u89e3\u66f4\u591a\u4fe1\u606f</a>\u3002", "4f7138dee282dd4516949d747ede085c": "\u6b64\u5730\u56fe\u56fe\u5c42\u6e90\u81ea\u897f\u975e\u53ef\u53ef\u6570\u636e\u96c6\uff0c\u6b64\u6570\u636e\u96c6\u662f\u4e00\u4e2a\u53ef\u53ef\u5730\u5757\u6570\u636e\u5e93\uff0c\u53cd\u6620\u4e86 19 \u5bb6\u53ef\u53ef\u548c\u5de7\u514b\u529b\u516c\u53f8\u76f4\u63a5\u4f9b\u5e94\u94fe\u4e2d\u7684\u53ef\u53ef\u5730\u5757\u5206\u5e03\u3002\u7531\u4e8e\u6570\u636e\u9690\u79c1\u95ee\u9898\uff0c\u539f\u59cb\u591a\u8fb9\u5f62\u6570\u636e\u4e0d\u516c\u5f00\u63d0\u4f9b\u3002", "9e744046b1ce7eff4f2ff61e797cc8fe": "\u897f\u975e\u53ef\u53ef\u6570\u636e\u96c6\u5e76\u672a\u6db5\u76d6\u79d1\u7279\u8fea\u74e6\u548c\u52a0\u7eb3\u7684\u5168\u90e8\u53ef\u53ef\u751f\u4ea7\u8303\u56f4\uff1b\u6b64\u6570\u636e\u96c6\u4ec5\u53cd\u6620\u4e86\u8d21\u732e\u6570\u636e\u7684 19 \u5bb6\u53ef\u53ef\u548c\u5de7\u514b\u529b\u516c\u53f8\u7684\u53ef\u53ef\u5206\u5e03\u8303\u56f4\u56fe\u3002", "ec0baab5ad1ca2311c50ac1dd2973368": "\u897f\u975e\u53ef\u53ef\u6570\u636e\u96c6 (WAC) \u662f\u4e00\u4e2a\u53ef\u53ef\u5730\u5757\u6570\u636e\u5e93\uff0c\u5b83\u53cd\u6620\u4e86 19 \u5bb6\u5728\u79d1\u7279\u8fea\u74e6\u548c\u52a0\u7eb3\u8fd0\u8425\u7684\u53ef\u53ef\u548c\u5de7\u514b\u529b\u516c\u53f8\u76f4\u63a5\u4f9b\u5e94\u94fe\u4e2d\u7684\u53ef\u53ef\u5730\u5757\u5206\u5e03\u3002\u897f\u975e\u53ef\u53ef\u5730\u5757\u5747\u4ee5\u591a\u8fb9\u5f62\u8868\u793a\uff0c\u901a\u8fc7\u5c06\u6cbf\u7740\u5730\u5757\u8fb9\u754c\u4eb2\u8eab\u6536\u96c6\u7684\u5750\u6807\u8fde\u63a5\u8d77\u6765\u7ed8\u5236\u800c\u6210\u3002\u5730\u5757\u4e0e\u53ef\u53ef\u519c\u573a\u7684\u533a\u522b\u5728\u4e8e\uff0c\u5730\u5757\u53ef\u80fd\u662f\u6574\u4e2a\u519c\u573a\u7684\u4e00\u4e2a\u5b50\u96c6\u3002 <br><br>\u4e3a\u4e86\u521b\u5efa WAC\uff0c\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240\u5236\u5b9a\u4e86\u6570\u636e\u5171\u4eab\u548c\u6574\u7406\u534f\u8bae\u3002\u8fd9\u4e9b\u534f\u8bae\u6982\u8ff0\u4e86\u5bf9\u6240\u63d0\u4f9b\u6570\u636e\u7684\u8981\u6c42\u4ee5\u53ca\u6e05\u6d17\u548c\u6c47\u603b\u6240\u6709\u6536\u5230\u6570\u636e\u7684\u7a0b\u5e8f\u3002\u5728\u8fd9\u4e2a\u8fc7\u7a0b\u4e2d\u8fd8\u8fdb\u884c\u4e86\u6cd5\u5f8b\u548c\u9053\u5fb7\u5ba1\u67e5\uff0c\u4ee5\u5c3d\u91cf\u51cf\u5c11\u5bf9\u519c\u6c11\u7684\u610f\u5916\u540e\u679c\uff0c\u5e76\u786e\u4fdd\u7b26\u5408\u897f\u975e\u7684\u6570\u636e\u9690\u79c1\u6cd5\u3002\u4e3a\u4e86\u4f7f WAC \u6210\u4e3a\u516c\u5171\u4ea7\u54c1\uff0cGlobal Forest Watch \u5c06\u8fd9\u4e9b\u591a\u8fb9\u5f62\u5f52\u7eb3\u4e3a\u53ef\u53ef\u5730\u5757\u5bc6\u5ea6\u56fe\uff0c\u6b64\u56fe\u663e\u793a\u4e86\u539f\u59cb\u591a\u8fb9\u5f62\u6570\u636e\u7684\u5206\u5e03\uff0c\u4f46\u6ca1\u6709\u663e\u793a\u6570\u636e\u96c6\u4e2d\u6bcf\u4e2a\u5730\u5757\u7684\u7cbe\u786e\u8fb9\u754c\u3002<br>WAC \u7684\u6570\u636e\u63d0\u4f9b\u8005\u9700\u8981\u63d0\u4ea4\u4ee3\u8868 2021 \u5e74\u6d3b\u52a8\u5730\u5757\u4f4d\u7f6e\u7684\u5355\u90e8\u5206\u591a\u8fb9\u5f62\u7684\u7279\u5f81\u8981\u7d20\u3002WAC \u4f1a\u5148\u5bf9\u5404\u4e2a\u516c\u53f8\u7684\u6570\u636e\u96c6\u8fdb\u884c\u6e05\u6d17\uff0c\u7136\u540e\u518d\u805a\u5408\uff0c\u4ece\u800c\u8bc6\u522b\u72ec\u7acb\u7684\u53ef\u53ef\u5730\u5757\u3002\u603b\u5171\u8bc6\u522b\u51fa 840,000 \u4e2a\u53ef\u53ef\u5730\u5757\uff0c\u8986\u76d6\u571f\u5730\u9762\u79ef\u7ea6 150 \u4e07\u516c\u9877\u3002\u6b64\u6570\u636e\u662f\u5f00\u53d1\u8bc4\u4f30\u68ee\u6797\u780d\u4f10\u98ce\u9669\uff1a<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u53ef\u53ef\u68ee\u6797\u780d\u4f10\u98ce\u9669\u8bc4\u4f30</a>\u7684\u8865\u5145\u65b9\u6cd5\u7684\u5173\u952e\u8d44\u6599\u3002\u8fd9\u4e24\u6b3e\u4ea7\u54c1\u90fd\u662f\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240\u3001\u4e16\u754c\u53ef\u53ef\u57fa\u91d1\u4f1a\u4ee5\u53ca 19 \u5bb6\u53ef\u53ef\u548c\u5de7\u514b\u529b\u516c\u53f8\u4e4b\u95f4\u524d\u6240\u672a\u6709\u7684\u5408\u4f5c\u6210\u679c\u3002", "ed783ab5be9608f493593b392fcedc44": "\u53ef\u53ef\u5730\u5757\u591a\u8fb9\u5f62\u6570\u636e\u5df2\u8f6c\u6362\u