5e55\u4e2d\uff0c\u70b9\u51fb\u201c\u786e\u8ba4\u201d\u6309\u94ae&nbsp;", "ba5ca88d5a4f6d02a82054553d74c9d1": "\u5c06\u60a8\u7684\u56e2\u961f\u4e0e\u5173\u6ce8\u533a\u57df\u76f8\u5173\u8054", "4a6a6b9cf1452b87a98ba3686f72a747": "\u4e3a\u4fbf\u4e8e\u60a8\u7684\u56e2\u961f\u63d0\u4ea4\u7279\u5b9a\u5173\u6ce8\u533a\u57df\u7684\u62a5\u544a\uff0c\u60a8\u9700\u8981\u5728\u8be5\u533a\u57df\u4e0e\u56e2\u961f\u4e4b\u95f4\u5efa\u7acb\u8054\u7cfb\u3002&nbsp;&nbsp;", "682d0b6721440af4a180c035d41d5ef7": "\u5bfc\u822a\u81f3\u201c\u533a\u57df\u201d\u9875\u9762&nbsp;", "4bda230f4ddea9c6a2b7d63550184e8d": "\u8981\u4e48 (a) \u5728\u5730\u56fe\u4e0a\u627e\u5230\u5e76\u70b9\u51fb\u8be5\u533a\u57df\uff0c\u8981\u4e48 (b) \u5728\u9875\u9762\u4e0a\u5411\u4e0b\u6eda\u52a8\u5e76\u4ece\u4e00\u7ec4\u533a\u5757\u4e2d\u9009\u62e9\u8be5\u533a\u57df\u3002&nbsp;", "53e5d4efeec55f2aac384064e2565c0d": "\u5728\u533a\u57df\u8be6\u7ec6\u4fe1\u606f\u9875\u9762\u4e2d\uff0c\u5411\u4e0b\u6eda\u52a8\u5230\u5e95\u90e8\uff0c\u76f4\u5230\u770b\u5230\u201c\u4e0e\u6b64\u533a\u57df\u5173\u8054\u7684\u56e2\u961f\u201d\u8fd9\u4e2a\u6807\u9898&nbsp;", "9b0e216a1d92d1657320a7d5251b75b2": "\u70b9\u51fb\u201c+ \u6dfb\u52a0\u56e2\u961f\u201d\u6309\u94ae&nbsp;", "1ec620658dc7c72f72196e4ebee19b41": "\u5bfc\u822a\u81f3\u7279\u5b9a\u4f4d\u7f6e", "3913a5a3d87ff9248094c4d71d20517a": "\u8981\u521b\u5efa\u65b0\u533a\u57df\uff0c\u8bf7\u70b9\u51fb\u6807\u6709\u201c\u521b\u5efa\u533a\u57df\u201d\u5b57\u6837\u7684\u6309\u94ae&nbsp;", "0162acb1f999b81f9ceda87229c7ab23": "3. \u60a8\u8fd8\u53ef\u4ee5\u76f4\u63a5\u4e0e\u5730\u56fe\u4ea4\u4e92\u4ee5\u5bfc\u822a\u5230\u6b63\u786e\u7684\u4f4d\u7f6e\uff1a&nbsp;", "edfbdfc17cecfc69f6236464b798dd3f": "\u7528\u9f20\u6807\u70b9\u51fb\u5e76\u62d6\u52a8\uff0c\u5373\u53ef\u5c06\u5730\u56fe\u5411\u5317\u3001\u5411\u4e1c\u3001\u5411\u5357\u6216\u5411\u897f\u79fb\u52a8\u3002&nbsp;", "e6a8e9b59e8fefd2c0b6eac4fe6e1b7d": "\u6309\u4f4f Windows \u4e0a\u7684 \u201cCtrl\u201d \u6216 Macintosh \u4e0a\u7684 \u