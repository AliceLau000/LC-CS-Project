uff0c\u4e3a\u4e86\u4f7f\u6570\u636e\u70b9\u5728\u66f4\u5927\u7684\u6bd4\u4f8b\u5c3a\u4e0a\u53ef\u89c1\uff0c\u5fc5\u987b\u5bf9\u5176\u8fdb\u884c\u538b\u7f29\u3002\u8bf7\u653e\u5927\u67e5\u770b\u8be6\u60c5\u3002", "3b878279a04dc47d60932cb294d96259": "\u6982\u89c8", "718779752b851ac0dc6281a8c8d77e7e": "\u8bb8\u53ef\u8bc1", "5879d056ec2cb4819a9e867829981a1a": "\u5f15\u7528", "899297690d4e55037d1fec79b75c60f6": "\u68ee\u6797\u780d\u4f10\u8b66\u62a5", "01b6e20344b68835c5ed1ddedf20d531": "\u81f3", "1c71108dfb8c2b98aa3000d960512dac": "\u5730\u7406\u8986\u76d6", "35ef3dd66c6c4f548f1152b0bb189420": "GLAD-S2 \u9884\u8b66", "73d9908829d891f77762b1e6afbb66b5": "RADD \u8b66\u544a", "18d63cc31e38c5fd7426ef0ce045c854": "\u5730\u7406\u8986\u76d6", "a270bf017d006dd9f247281b7b1c747c": "\u672c\u7f51\u7ad9\u4f7f\u7528cookie\u4e3a\u60a8\u63d0\u4f9b\u66f4\u597d\u7684\u7528\u6237\u4f53\u9a8c\u3002\u7ee7\u7eed\u6d4f\u89c8\u672c\u7f51\u7ad9\uff0c\u5373\u8868\u793a\u60a8\u540c\u610f\u4f7f\u7528cookie\u548c\u7c7b\u4f3c\u7684\u6280\u672f\u3002\u8bf7\u8bbf\u95ee\u6211\u4eec\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u9690\u79c1\u653f\u7b56</a>\u4ee5\u83b7\u53d6\u66f4\u591a\u8be6\u60c5\u3002", "aea50b746ecbc321758f01be3d1b7cab": "\u6240\u663e\u793a\u6570\u636e\u7684\u6797\u6728\u51a0\u5c42\u8986\u76d6\u5bc6\u5ea6\u7531\u4e8e\u9009\u62e9\u7684\u4e0d\u540c\u800c\u53d8\u5316\uff0c\u4f7f\u7528\u5730\u56fe\u4e0a\u7684\u56fe\u4f8b\u6765\u6539\u53d8\u6797\u6728\u51a0\u5c42\u8986\u76d6\u5bc6\u5ea6\u6700\u4f4e\u9608\u503c\u3002", "9ec8bbaacbbaf9cedf0c02a788279df7": "\u5168\u7403\u571f\u5730\uff08\u4e0d\u5305\u62ec\u5357\u6781\u6d32\u548c\u5317\u6781\u7fa4\u5c9b\uff09", "389227098e7f576e948b2269aebd6cf2": "\u7c97\u5206\u8fa8\u7387\u56fe\u50cf\uff08\u5168\u7403\uff09", "d2fa661108b86d61a8f68443d6e60bb4": "Sentinel-2 \u548c Landsat 8 \u536b\u661f\u63d0\u4f9b\u7684\u6700\u65b0\u536b\u661f\u56fe\u50cf", "a50ab4a3908fdf702ebeb1148140cb5a": "\u6811\u6728\u8986\u76d6\u9ad8\u5ea6", "18450de39aceed82b26abe218d377740": "\u653f\u5e9c", "1d78dc8ed51214e518b5114fe24490ae": "\u5730\u56fe", "3b671c883959a8ef434b85a104c293d4": "\u5206\u6790", "2826229133a4d92ce36dfbf07ebf5ee5": "\u4e24\u4e2a\u6708\u5ef6\u8fdf", "94383bae73613772260e63a4d9a254a6": "\u68ee\u6797\u666f\u89c2\u5b8c\u6574\u6027\u6307\u6570 (Forest Landscape Integrity Index)", "4a9e40f4db173f7ac7609884e440ebd9": "\u7535\u5b50\u90ae\u4ef6 *", "1b71c59bdef9f5aea0f65d59630a0f01": "\u4e0b\u8f7d\u68ee\u6797\u7edf\u8ba1\u6570\u636e", "577e25700d2ca14c79689e4020f06844": "\u571f\u5730\u8986\u76d6", "b7f08a9236cf152a8e6a94cdcd75c5f8": "\u5f00\u653e\u5f0f\u6570\u636e\u95e8\u6237\u7f51\u7ad9", "6d2f68dfbf4ebf02be5e5439f1251878": "\u519c\u7530\u4e2d\u71c3\u70e7\u7684\u533a\u57df\u901a\u5e38\u5e94\u88ab\u89c6\u4e3a\u4f4e\u53ef\u4fe1\u5ea6\uff0c\u5e76\u53d7\u9650\u4e8e\u7ed8\u5236\u53ef\u4fe1\u8d56\u7684\u519c\u4e1a\u71c3\u70e7\u56fe\u7684\u56fa\u6709\u56f0\u96be\uff0c\u53ef\u80fd\u65e0\u6cd5\u88ab\u5145\u5206\u8bc6\u522b<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u53c2\u89c1 Hall et al. 2016 \u4e86\u89e3\u66f4\u591a\u4fe1\u606f</a>", "25caee5e23609f8dff31b0f1e89cfcc2": "VIIRS \u6d3b\u8dc3\u706b\u707e", "0769c865709fba66a47608f3f9350e5a": "\u786e\u5b9a\u603b\u6811\u6728\u8986\u76d6\u635f\u5931\u7684\u533a\u57df", "2a1a15c7bd4845d05ed1866e405273a1": "\u5168\u7403\u9646\u5730\u9762\u79ef\uff08\u4e0d\u5305\u62ec\u5357\u6781\u6d32\u548c\u5176\u5b83\u5317\u6781\u5c9b\u5c7f\uff09\u3002", "ac0ef3c675b00929615be7e5b15a9ab6": "\u5728\u8fd9\u7ec4\u6570\u636e\u96c6\u4e2d\uff0c\u201c\u6797\u6728\u8986\u76d6\u201d\u88ab\u5b9a\u4e49\u4e3a\u6240\u6709\u9ad8\u4e8e5\u7c73\u7684\u690d\u88ab\uff0c\u800c\u4e14\u53ef\u80fd\u91c7\u53d6\u4e00\u5217\u6797\u51a0\u90c1\u95ed\u5ea6\u5185\u7684\u81ea\u7136\u68ee\u6797\u6216\u4eba\u5de5\u6797\u7684\u5f62\u5f0f\u3002\u201c\u635f\u5931\u201d\u6307\u7684\u662f\u6797\u6728\u8986\u76d6\u7684\u53bb\u9664\u548c\u6b7b\u4ea1\u7387\uff0c\u8fd9\u53ef\u80fd\u662f\u7531\u4e8e\u5404\u79cd\u56e0\u7d20\u9020\u6210\u7684\uff0c\u5305\u62ec\u673a\u68b0\u780d\u4f10\u3001\u706b\u707e\u3001\u75be\u75c5\u6216\u98ce\u66b4\u9020\u6210\u7684\u635f\u5931\u3002\u56e0\u6b64\uff0c\u201c\u635f\u5931\u201d\u5e76\u4e0d\u7b49\u540c\u4e8e\u68ee\u6797\u780d\u4f10\u3002", "9030e39f00132d583da4122532e509e9": "\u6bcf\u6708", "675db48cd8d5ec259dfd9dfd1b3f1dba": "\u516c\u5171\u9886\u57df", "9eb16ab78831dd40541ca2e4c17b4566": "\u91c7\u7528 VIIRS \u7684\u6570\u636e\u66ff\u4ee3\u4e4b\u524d\u5728 Global Forest Watch \u6240\u4f7f\u7528\u7684\u6765\u81ea MODIS \u7684\u706b\u707e\u6570\u636e\u3002VIIRS \u7684\u6570\u636e\u5177\u6709\u66f4\u9ad8\u7684\u7a7a\u95f4\u89e3\u6790\u5ea6\uff08375 \u7c73\u50cf\u7d20 vs. 1 \u516c\u91cc\u50cf\u7d20\uff09\uff0c\u53ef\u4ee5\u63d0\u9ad8\u5c0f\u578b\u706b\u707e\u7684\u63a2\u6d4b\u80fd\u529b\uff0c\u63d0\u4f9b\u66f4\u53ef\u4fe1\u8d56\u7684\u706b\u52bf\u8fb9\u754c\u9884\u6d4b\u3002VIIRS \u7684\u6570\u636e\u5bf9\u591c\u95f4\u7684\u706b\u707e\u63a2\u6d4b\u4e5f\u66f4\u4e3a\u7cbe\u51c6\u3002", "0050d027db9be54156cec64ffd3fa2d8": "Fire Weather \u662f\u4e00\u4e2a\u8fd1\u4e4e\u5b9e\u65f6\u7684\u5168\u7403\u6570\u636e\u96c6\uff0c\u53ef\u901a\u8fc7 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Global Fire Weather Database (GFWED)</a> \u8bbf\u95ee\u3002GFWED \u6863\u6848\u7531 NASA \u7684<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Goddard Institute for Space Studies</a>\u7ef4\u62a4\uff0c\u53ef\u8ffd\u6eaf\u5230 1980 \u5e74\uff0c\u6e90\u81ea<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Canadian Forest Fire Weather Index (FWI)</a>\u8fd9\u4e00\u5e7f\u6cdb\u4f7f\u7528\u7684\u706b\u707e\u5371\u9669\u7b49\u7ea7\u7cfb\u7edf\u3002\u8be5\u7cfb\u7edf\u7ed3\u5408\u4e86\u53ef\u80fd\u5f71\u54cd\u690d\u88ab\u706b\u707e\u5f00\u59cb\u548c\u8513\u5ef6\u7684\u4e0d\u540c\u5929\u6c14\u56e0\u7d20\uff0c\u7531\u4e09\u4e2a\u6e7f\u5ea6\u4ee3\u7801\u548c\u4e09\u4e2a\u706b\u707e\u884c\u4e3a\u4ee3\u7801\u7ec4\u6210\u3002\u6e7f\u5ea6\u4ee3\u7801\u63cf\u8ff0\u4e86\u4e09\u79cd\u4e00\u822c\u71c3\u6599\u7c7b\u522b\u7684\u6c34\u5206\u542b\u91cf\u3002\u706b\u707e\u884c\u4e3a\u6307\u6570\u63cf\u8ff0\u4e86\u706b\u707e\u7684\u8513\u5ef6\u901f\u5ea6\u3001\u71c3\u6599\u6d88\u8017\u548c\u706b\u707e\u5f3a\u5ea6\u3002\u8f83\u9ad8\u7684 FWI \u503c\u8868\u660e\u65e5\u5e38\u5929\u6c14\u6761\u4ef6\u66f4\u6709\u5229\u4e8e\u706b\u707e\u3002\u5927\u4e8e 50 \u7684\u503c\u88ab\u8ba4\u4e3a\u662f\u6781\u7aef\u503c\u3002", "c960b97289fbe63e41c6ad2d56bfaead": "2011-2020 \u5e74\u6570\u636e\u4f7f\u7528<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u66f4\u65b0\u7684\u65b9\u6cd5</a>\u751f\u6210\u3002\u5728\u5bf9\u6bd4\u539f\u6765\u7684 2001-2010 \u5e74\u6570\u636e\u548c 2011-2020 \u5e74\u66f4\u65b0\u540e\u7684\u6570\u636e\u7684\u65f6\u5019\u5e94\u8be5\u683c\u5916\u5c0f\u5fc3\u3002", "2afc85d3d5f0119618837e644a125d02": "\u4f5c\u8005\u8bc4\u4f30\u4e86\u6b64\u6570\u636e\u4e2d\u7684\u4f2a\u9633\u6027\u53d1\u751f\u7387\uff08\u9519\u5206\u8bef\u5dee\uff09\u4e3a 13%\uff0c\u4f2a\u9634\u6027\u53d1\u751f\u7387\uff08\u6f0f\u5206\u8bef\u5dee\uff09\u4e3a 12%\uff0c\u4e0d\u8fc7\u51c6\u786e\u6027\u56e0\u751f\u7269\u7fa4\u843d\u800c\u5f02\uff0c\u56e0\u6b64\u5728\u4efb\u4f55\u7279\u5b9a\u4f4d\u7f6e\u53ef\u80fd\u66f4\u9ad8\u6216\u66f4\u4f4e\u3002\u8be5\u6a21\u578b\u5f80\u5f80\u5ffd\u7565\u4e86\u5c0f\u519c\u5730\u8c8c\u7684\u5e72\u6270\u56e0\u7d20\uff0c\u5bfc\u81f4\u6492\u54c8\u62c9\u4ee5\u5357\u975e\u6d32\u5730\u533a\u6570\u636e\u51c6\u786e\u6027\u66f4\u4f4e\uff0c\u56e0\u4e3a\u90a3\u91cc\u6b64\u7c7b\u5e72\u6270\u56e0\u7d20\u66f4\u5e38\u89c1\u3002\u4f5c\u8005\u6709 75% \u7684\u4fe1\u5fc3\u8ba4\u4e3a\uff0c\u6d41\u5931\u5728\u6240\u8ff0\u5e74\u4efd\u53d1\u751f\uff0c\u4e14\u6709 97% \u7684\u4fe1\u5fc3\u8ba4\u4e3a\uff0c\u6d41\u5931\u5728\u6240\u8ff0\u5e74\u4efd\u524d\u540e\u4e00\u5e74\u5185\u53d1\u751f\u3002\u6b64\u6570\u636e\u7684\u7528\u6237\u53ef\u4ee5\u901a\u8fc7\u68c0\u67e5\u591a\u4e2a\u5e74\u4efd\u7684\u5747\u503c\uff0c\u6d88\u9664\u8fd9\u79cd\u4e0d\u786e\u5b9a\u6027\u3002\u8bf7\u9605\u8bfb\u6b64\u6570\u636e\u51c6\u786e\u6027\u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u535a\u5ba2\u7cfb\u5217</a>\uff0c\u4ee5\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002", "bd5107ed9a04f1e2db676e4a041e6d09": "\u6211\u4eec\u786e\u8ba4\u4f7f\u7528\u6765\u81ea\u7531 NASA/HQ \u63d0\u4f9b\u8d44\u91d1\u7684 NASA/GSFC/\u5730\u7403\u79d1\u5b66\u6570\u636e\u548c\u4fe1\u606f\u7cfb\u7edf (ESDIS) \u64cd\u4f5c\u7684 LANCE FIRMS \u7684\u6570\u636e\u548c\u56fe\u50cf\u3002", "39452fb207372eabea685afb9793d5f2": "\u7070\u8272\u56fe\u6807\u8868\u793a\u8be5\u4f4d\u7f6e\u6ca1\u6709\u6570\u636e\u3002", "8c24fff28c912940d58d2ef46370f313": "\u5728\u8be5\u6570\u636e\u96c6\u4e2d\uff0c\u201c\u68ee\u6797\u8986\u76d6\u201d\u5b9a\u4e49\u4e3a\u6240\u6709\u9ad8\u5ea6\u8d85\u8fc7 5 \u7c73\u7684\u690d\u88ab\uff0c\u5176\u5f62\u5f0f\u662f\u5404\u79cd\u68ee\u6797\u8986\u76d6\u5bc6\u5ea6\u7684\u5929\u7136\u6797\u6216\u4eba\u5de5\u6797\u3002\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u5b9a\u4e49\u4e3a\u201c\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u201d\uff0c\u6216\u9646\u5730\u536b\u661f\u50cf\u7d20\u6bd4\u4f8b\u5c3a\u4e0a\u68ee\u6797\u8986\u76d6\u5c42\u7684\u5b8c\u5168\u6d88\u5931\u3002\u9020\u6210\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u7684\u539f\u56e0\uff0c\u4e00\u65b9\u9762\u53ef\u80fd\u662f\u4eba\u7c7b\u6d3b\u52a8\uff0c\u5305\u62ec\u50cf\u68ee\u6797\u91c7\u4f10\u3001\u6ee5\u4f10\uff08\u5c06\u5929\u7136\u6797\u53e6\u4f5c\u4ed6\u7528\uff09\u8fd9\u6837\u7684\u6797\u4e1a\u6d3b\u52a8\uff0c\u53e6\u4e00\u65b9\u9762\u4e5f\u53ef\u80fd\u662f\u81ea\u7136\u56e0\u7d20\uff0c\u6bd4\u5982\u75be\u75c5\u6216\u8005\u98ce\u66b4\u707e\u5bb3\u7b49\u3002\u706b\u707e\u662f\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u7684\u53e6\u4e00\u4e2a\u666e\u904d\u6027\u539f\u56e0\uff0c\u5176\u8bf1\u56e0\u6709\u53ef\u80fd\u662f\u81ea\u7136\u707e\u5bb3\uff0c\u4e5f\u53ef\u80fd\u662f\u4eba\u7c7b\u6d3b\u52a8\u3002", "ecb053e8b7135123db4a4198c18e8546": "\u672c\u5c42\u7684\u6570\u636e\u662f\u4f7f\u7528 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Landsat 7</a> \u4e13\u9898\u5236\u56fe\u4eea plus (ETM+) \u4f20\u611f\u5668\u7684\u591a\u5149\u8c31\u536b\u661f\u56fe\u50cf\u751f\u6210\u7684\u3002\u6765\u81ea 600,000 \u591a\u5f20\u56fe\u50cf\u7684\u6e05\u6670\u8868\u9762\u89c2\u6d4b\u7ed3\u679c\u901a\u8fc7 Google Earth Engine\uff08\u4e00\u4e2a\u7528\u4e8e\u5730\u7403\u89c2\u6d4b\u548c\u6570\u636e\u5206\u6790\u7684\u4e91\u5e73\u53f0\uff09\u8fdb\u884c\u4e86\u5206\u6790\uff0c\u4ee5\u4fbf\u4f7f\u7528\u76d1\u7763\u578b\u5b66\u4e60\u7b97\u6cd5\u786e\u5b9a\u6bcf\u4e2a\u50cf\u7d20\u7684\u6811\u6728\u8986\u76d6\u7387\u3002", "f4ec0744c6d26805ad9b2afd975cbf4b": "\u8be5\u6570\u636e\u96c6\u81ea\u521b\u5efa\u4ee5\u6765\u5df2\u7ecf\u66f4\u65b0\u4e86\u4e94\u6b21\uff0c\u73b0\u5728\u5305\u62ec\u4e86\u5230 2020 \u5e74\u7684\u635f\u5931\uff081.8 \u7248\u672c\uff09\u3002\u5206\u6790\u65b9\u6cd5\u5df2\u5728\u8bb8\u591a\u65b9\u9762\u8fdb\u884c\u4e86\u4fee\u6539\uff0c\u5305\u62ec\u76ee\u6807\u5e74\u4efd\u7684\u65b0\u6570\u636e\uff0c\u5bf9\u4e4b\u524d\u5e74\u4efd\u7684\u6570\u636e\u8fdb\u884c\u4e86\u91cd\u65b0\u5904\u7406\u5206\u6790\u65b9\u6cd5\u8fdb\u884c\u4e86\u591a\u65b9\u9762\u7684\u4fee\u6539\uff0c\u5305\u62ec\u76ee\u6807\u5e74\u4efd\u7684\u65b0\u6570\u636e\u3001\u524d\u51e0\u5e74\u7684\u91cd\u65b0\u5904\u7406\u6570\u636e\uff081.1 \u7248\u672c\u66f4\u65b0\u4e3a 2011 \u5e74\u548c 2012 \u5e74\uff0c1.2 \u7248\u672c\u66f4\u65b0\u4e3a 2012 \u5e74\u548c 2013 \u5e74\uff0c1.3 \u7248\u672c\u66f4\u65b0\u4e3a 2014 \u5e74\uff09\u4ee5\u53ca\u6539\u8fdb\u7684\u5efa\u6a21\u548c\u6821\u51c6\u3002\u8fd9\u4e9b\u4fee\u6539\u6539\u8fdb\u4e86 2011-2020 \u5e74\u7684\u53d8\u5316\u68c0\u6d4b\uff0c\u5305\u62ec\u66f4\u597d\u5730\u68c0\u6d4b\u706b\u707e\u9020\u6210\u7684\u5317\u65b9\u635f\u5931\u3001\u70ed\u5e26\u68ee\u6797\u4e2d\u7684\u5c0f\u519c\u8f6e\u4f5c\u519c\u4e1a\u3001\u9009\u62e9\u6027\u91c7\u4f10\u548c\u77ed\u5468\u671f\u4eba\u5de5\u6797\u3002\u6700\u7ec8\uff0c\u672a\u6765\u7684\u201c2.0 \u7248\u201d\u5c06\u5305\u62ec\u5bf9 2000-2010 \u5e74\u6570\u636e\u7684\u518d\u5904\u7406\uff0c\u4f46\u4e0e\u6b64\u540c\u65f6\uff0c\u5bf9\u539f\u59cb\u6570\u636e\u548c 1.8 \u7248\u672c\u7684\u96c6\u6210\u4f7f\u7528\u5e94\u8c28\u614e\u64cd\u4f5c\u3002\u53ef\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u8be6\u7ec6\u4e86\u89e3 1.8 \u7248\u672c\u66f4\u65b0\u3002", "e793fe453c3bdb1e82233fd695965fd1": "\u8bf7\u8bbf\u95ee<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">World Air Quality Index</a>\u8be6\u7ec6\u4e86\u89e3\u8fd9\u4e9b\u6570\u636e\u3002\u8bf7\u8bbf\u95ee EPA <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">AirNow</a> \u7f51\u7ad9\u4e86\u89e3\u6709\u5173\u7f8e\u56fd\u7a7a\u6c14\u8d28\u91cf\u6307\u6570\u7684\u66f4\u591a\u4fe1\u606f\u3002", "bf0c721b2267de1bc7a802196a1ea0e1": "\u6bcf\u4e2a\u706b\u60c5\u9884\u8b66\u90fd\u6709\u4e00\u4e2a\u4f4e\u3001\u4e2d\u3001\u9ad8\u7684\u53ef\u4fe1\u5ea6\u6570\u503c\uff0c\u4ee5\u5e2e\u52a9\u7528\u6237\u4f30\u8ba1\u5355\u4e2a\u70ed\u70b9/\u706b\u707e\u50cf\u7d20\u7684\u8d28\u91cf\u3002", "402567b41e9b769e360b427bc8798585": "\u8fd1\u5b9e\u65f6", "82d0ffc67ff1f9d6f3dd3267d0469ace": "2018 \u5e74 11 \u6708\uff0cGFW \u5bf9\u5176\u5730\u56fe\u8fdb\u884c\u4e86\u66f4\u65b0\uff0c\u4f7f\u5176\u901f\u5ea6\u66f4\u5feb\u3001\u66f4\u65b9\u4fbf\u81ea\u5b9a\u4e49\uff0c\u5e76\u4f7f\u5f97\u63a2\u7d22\u548c\u5206\u6790\u68ee\u6797\u6570\u636e\u66f4\u52a0\u5bb9\u6613\u3002\u65e0\u8bba\u662f GFW \u7684\u65b0\u7528\u6237\u8fd8\u662f\u7ecf\u5e38\u4f7f\u7528\u7684\u8001\u7528\u6237\uff0c\u8bf7\u89c2\u770b\u8fd9\u671f\u7f51\u7edc\u7814\u8ba8\u4f1a\uff0c\u4ee5\u4e86\u89e3\u5982\u4f55\u5145\u5206\u5229\u7528\u8be5\u5730\u56fe\u3002", "8588c961895664f7014064e7567ebae1": "\u628a\u56fe\u50cf\u7f29\u5c0f (< \u7f29\u653e\u6bd4\u4f8b 13)\uff0c\u7531\u4e8e30x 30 \u7c73\u8303\u56f4\u5185\u690d\u88ab\u51cf\u5c11\u5bc6\u5ea6\u7684\u539f\u56e0\uff0c\u51cf\u5c11\u90e8\u5206\u7684\u56fe\u50cf\u5448\u73b0\u9634\u5f71\u3002\u9634\u5f71\u8f83\u6df1\u7684\u90e8\u5206\u8868\u793a\u8be5\u5730\u533a\u690d\u88ab\u635f\u5931\u8f83\u4e3a\u4e25\u91cd\uff0c\u9634\u5f71\u8f83\u6d45\u7684\u90e8\u5206\u8868\u793a\u8be5\u5730\u533a\u690d\u88ab\u635f\u5931\u60c5\u51b5\u4e0d\u90a3\u4e48\u4e25\u91cd\u3002\u5f53\u5206\u8fa8\u7387\u6700\u9ad8\u65f6\u9634\u5f71\u90e8\u5206\u4e0d\u4f1a\u4ea7\u751f\u53d8\u5316 (\u2265 \u7f29\u653e\u6bd4\u4f8b 13)\u3002", "95b84f91e295c66ed36007ac0f3c51b8": "\u66f4\u65b0\u8d44\u6599<svg class=\"c-icon user-btn-icon\" viewBox=\"0 0 35 32\"><use xlink:href=\"#pencil-1ad711d9--sprite\"></use></svg>", "4aebb56623ccf2538663c3d44ec9d04a": "\u6ce8\u9500<svg class=\"c-icon user-btn-icon\" viewBox=\"0 0 32 32\"><use xlink:href=\"#logout-29963891--sprite\"></use></svg>", "2073c7f8650adb74c3d26ff3fa03da59": "\u5c55\u793a\u8fd9\u4e9b\u6570\u636e\u65f6\u4f7f\u7528\u4ee5\u4e0b\u6e90\u4fe1\u606f\uff1a<br>\u6570\u636e\u6e90\uff1aHansen/UMD/Google/USGS/NASA\uff0c\u901a\u8fc7\u5168\u7403\u68ee\u6797\u89c2\u6d4b\u83b7\u53d6", "c47bbd8d5fe4caaf1e6cb5c8182a9568": "\u6309\u6807\u7b7e\u7b5b\u9009", "376ca153492de028eec07a6e69d04082": "\u4eba\u5de5\u6797", "2aac5e17c044312c2c1418115d109f19": "Landsat \u536b\u661f\u56fe\u50cf<button class=\"c-button theme-button-tiny theme-button-grey-filled square info-btn\"><div class=\"button-wrapper\"><svg class=\"c-icon \" viewBox=\"0 0 18 32\"><use xlink:href=\"#info-1622ac34--sprite\"></use></svg></div></button>", "95f7eee5352ada6b5f5637d982d16853": "<svg class=\"c-icon icon-user\" viewBox=\"0 0 32 32\"><use xlink:href=\"#profile-1bf4f99d--sprite\"></use></svg>\u653f\u7b56\u5236\u5b9a\u8005", "e837c745df03711e80d68a9495560ad3": "\u6ce8\u518c\u6bcf\u6708 PTW \u7535\u5b50\u90ae\u4ef6\u66f4\u65b0", "276984224d77dc85809205af51a5777e": "\u8be5\u56fe\u5c42\u663e\u793a\u4e86\u7531 World Air Quality Index \u9879\u76ee (<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">WAQI</a>) \u63d0\u4f9b\u7684\u6765\u81ea\u5168\u7403 15,000 \u591a\u4e2a\u7ad9\u70b9\u7684 2.5 \u5fae\u7c73\u4ee5\u4e0b\u9897\u7c92\u7269 (PM2.5) \u7684\u7a7a\u6c14\u8d28\u91cf\u6d4b\u91cf\u503c\u3002\u6240\u6709 PM2.5 \u6570\u636e\u5747\u7b26\u5408\u7f8e\u56fd\u73af\u5883\u4fdd\u62a4\u7f72 (<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">US EPA</a>) \u7684\u7a7a\u6c14\u8d28\u91cf\u6307\u6570 (<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">AQI</a>) \u6807\u51c6\u3002", "ccd75b971d622888ba494171457624eb": "\uff08Hansen/UMD/Google/USGS/NASA", "66642168920c48ba2e4f74f6b14ddfb9": "<svg class=\"c-icon link-icon\" viewBox=\"0 0 32 32\"><use xlink:href=\"#view-map-1e970972--sprite\"></use></svg>\u5728\u5730\u56fe\u4e0a\u67e5\u770b", "5adae08e98a07e3d849873007ab6624b": "<svg class=\"c-icon link-icon\" viewBox=\"0 0 32 32\"><use xlink:href=\"#edit-97ec94d3--sprite\"></use></svg>\u7f16\u8f91", "4c1926dbf7b4e15dc0eae2d96b291b77": "<svg class=\"c-icon link-icon\" viewBox=\"0 0 32 32\"><use xlink:href=\"#share-bab4d420--sprite\"></use></svg>\u5206\u4eab", "4386a3e65d4a17d5648302de607e3dc3": "\u8ba2\u9605\u672a\u786e\u8ba4", "2ef26bb9c0857f0316eb019b4f486718": "GLAD \u9884\u8b66", "9be0e84d287a86cf649451de9772c3b0": "\u6309\u6807\u7b7e\u7b5b\u9009", "0ea6e0fa61364dc593ff1f5645a3803f": "\u5df2\u521b\u5efa {date}", "44a161b8a92886825b0c24708a5657f6": "<svg class=\"c-icon icon-user\" viewBox=\"0 0 32 32\"><use xlink:href=\"#profile-1bf4f99d--sprite\"></use></svg>\u516c\u53f8", "c7376a5d61648e5c608be927e911c385": "\u5b9e\u65f6\uff08\u6bcf 15 \u5206\u949f\u66f4\u65b0\uff09", "d69ea3264c463ee844a00c6fa05c1803": "Global Forest Watch \u7684\u65b0\u6d88\u606f", "db0c21d66652009726fa4f8b538a496f": "GFWED \u4f7f\u7528 8 \u4e2a\u8f93\u5165\u503c\u8fdb\u884c\u8ba1\u7b97\u5e76\u751f\u6210 FWI \u503c\uff0c\u800c GFW \u4e0a\u663e\u793a\u7684Fire Weather \u7248\u672c\u8ba1\u7b97\u81ea\u6bcf\u65e5\u964d\u6c34\u91cf\u3001\u6e29\u5ea6\u3001\u76f8\u5bf9\u6e7f\u5ea6\u3001\u98ce\u901f\u548c\u96ea\u6df1\u3002\u6bcf\u65e5\u964d\u6c34\u91cf\u6839\u636e NASA \u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">GPM IMERG Final Precipitation \u6570\u636e\u4ea7\u54c1</a>\u6c47\u7f16\uff0c\u6240\u6709\u5176\u4ed6\u8f93\u5165\u503c\u90fd\u662f\u901a\u8fc7 GOES-5 \u536b\u661f\u6bcf\u65e5\u6c47\u7f16\u3002 \u751f\u6210\u7684 Fire Weather \u6570\u636e\u96c6\u4ee5 0.1\u00b0 \u5206\u8fa8\u7387\u63d0\u4f9b\u3002", "d9a83f8090ad8fd6c5ef211c4e82974e": "MODIS \u70e7\u6bc1\u533a\u57df", "61d5a1e6fcf0ad784fb9debfb8f56a36": "\u9009\u62e9\u6700\u591a 3 \u4e2a\u6708\u7684\u6570\u636e\uff1a", "0b72865256aa3577cf28f65d9066b901": "\u7531\u4e8e\u7814\u7a76\u65b9\u6cd5\u548c\u5185\u5bb9\u65e5\u671f\u7684\u53d8\u5316\uff0c\u68ee\u6797\u8986\u76d6\u3001\u51cf\u5c11\u548c\u589e\u52a0\u7684\u6570\u636e\u96c6\u65e0\u6cd5\u51c6\u786e\u5730\u76f8\u4e92\u6bd4\u8f83\u3002\u56e0\u6b64\uff0c\u65e0\u6cd5\u7528\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u51cf\u53bb\u68ee\u6797\u8986\u76d6\u589e\u52a0\u6765\u8ba1\u7b97\u201c\u51c0\u201d\u51cf\u5c11\u503c\uff0c\u4ea6\u4e0d\u80fd\u7528 2000 \u5e74\u68ee\u6797\u8986\u76d6\u51cf\u53bb\u5e74\u5ea6\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u6765\u83b7\u5f97\u5f53\u524d\uff082000\u5e74\u540e\uff09\u7684\u68ee\u6797\u8986\u76d6\u3002", "856c6cecfb07fa61f18a9f790654cd14": "\u57282010\u5e74\uff0c{location} \u5730\u533a\u6709{extent} \u6811\u6728\u8986\u76d6\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684{percentage}\u591a\u3002\u5728{year}\uff0c\u5b83\u635f\u5931\u4e86{loss}\u7684\u6811\u6728\u8986\u76d6\u3002", "d96370f9ed5272c31a38fa8a9b539748": "30 \u00d7 30 \u7c73", "cf72faf8c2bad7f85ec5510f312524b7": "{extentYear} \u68ee\u6797\u8986\u76d6\u8303\u56f4", "9db9675029e72177f1a18cc8b437faa1": "\u4e0d\u662f\u68ee\u6797", "99aa4c482b13fa28cb9521072ff64e5b": ">{threshold}% \u6811\u51a0{carbonGain}", "38d75cc0bcc04c01e317fd284f34997d": "Google \u536b\u661f\u56fe\u50cf<button class=\"c-button theme-button-tiny theme-button-grey-filled square info-btn\"><div class=\"button-wrapper\"><svg class=\"c-icon \" viewBox=\"0 0 18 32\"><use xlink:href=\"#info-1622ac34--sprite\"></use></svg></div></button>", "a32373e9560ef8e95c27eeb590dfc186": "\u8be5\u6570\u636e\u96c6\u7531\u9a6c\u91cc\u5170\u5927\u5b66\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">GLAD</a>\uff08\u5168\u7403\u571f\u5730\u5206\u6790&amp; \u53d1\u73b0\uff09\u5b9e\u9a8c\u5ba4\u3001Google\u3001USGS\u548cNASA\u5408\u4f5c\u5b8c\u6210\uff0c\u4ee530\u00d730\u7c73\u7684\u5206\u8fa8\u7387\u663e\u793a\u4e862000\u5e74\u548c2010\u5e74\u5168\u7403\u6240\u6709\u9646\u5730\uff08\u9664\u5357\u6781\u548c\u4e00\u4e9b\u5317\u6781\u5c9b\u5c7f\uff09\u7684\u6811\u6728\u8986\u76d6\u60c5\u51b5\u3002\u201c\u6811\u6728\u8986\u76d6\u7387\u201d\u7684\u5b9a\u4e49\u662f\u6811\u51a0\u8986\u76d6\u5730\u8868\u7684\u5bc6\u5ea6\uff0c\u5e76\u6309\u5bc6\u5ea6\u7b49\u7ea7\u8fdb\u884c\u989c\u8272\u7f16\u7801\uff08\u89c1\u56fe\u4f8b\uff09\u3002", "8cad8f1a9b8e44a98709e4702cb3c406": "Planet \u536b\u661f\u56fe\u50cf<button class=\"c-button theme-button-tiny theme-button-grey-filled square info-btn\"><div class=\"button-wrapper\"><svg class=\"c-icon \" viewBox=\"0 0 18 32\"><use xlink:href=\"#info-1622ac34--sprite\"></use></svg></div></button>", "18b620abd7633549d8dec88938a174f0": "\u8fd9\u4e9b\u6570\u636e\u80cc\u540e\u7684\u65b9\u6cd5\u5df2\u968f\u7740\u65f6\u95f4\u7684\u63a8\u79fb\u800c\u6539\u53d8\u3002\u6bd4\u8f83\u65b0\u65e7\u6570\u636e\uff0c\u5c24\u5176\u662f 2015 \u5e74\u4e4b\u524d/\u4e4b\u540e\u7684\u6570\u636e\u65f6\uff0c\u8bf7\u4fdd\u6301\u8c28\u614e\u3002<a class=\"caution-link\" rel=\"noopener noreferrer\" href=\"{{0}}\" target=\"_blank\">\u5728\u8fd9\u91cc\u9605\u8bfb\u66f4\u591a\u5185\u5bb9</a>\u3002", "e909c2d7067ea37437cf97fe11d91bd0": "\u56fd\u5bb6", "d8fb130743674625e1b718f7eba8bc74": "\u8fd1 1-3 \u5e74\u7684\u6700\u9ad8\u5206\u8fa8\u7387\u56fe\u50cf\uff08\u5168\u7403\uff09", "7a375ec7506569926f95d9d80cde8b50": "\u4e3a\u4e86\u8fd9\u6b21\u7814\u7a76\u7684\u9700\u8981\uff0c\u201c\u68ee\u6797\u8986\u76d6\u201d\u5b9a\u4e49\u4e3a\u9ad8\u4e8e 5 \u7c73\u7684\u690d\u88ab\u3002\u201c\u68ee\u6797\u8986\u76d6\u201d\u662f\u6811\u6728\u7684\u751f\u7269\u7269\u7406\u5c55\u73b0\u5e76\u4e14\u53ef\u80fd\u5728\u4e00\u5b9a\u8303\u56f4\u7684\u68ee\u6797\u8986\u76d6\u5bc6\u5ea6\u5185\u4ee5\u81ea\u7136\u68ee\u6797\u6216\u8005\u4eba\u5de5\u6797\u7684\u5f62\u5f0f\u5b58\u5728\u3002", "9721771239d29beedafd36f2d93099ca": "\u786e\u5b9a\u68ee\u6797\u8986\u76d6\u589e\u52a0\u7684\u533a\u57df", "c9ad1f30170cdb8d6751429e334bb803": "\uff0812\u5e74\uff0c30\u7c73\uff0c\u5168\u7403\uff0cHansen/UMD/Google/USGS/NASA\uff09", "b92d0ed207c20ab221b3876ec245f312": "\u4ece 2020 \u5e74 8 \u6708 16 \u65e5\u5f00\u59cb\uff0cAqua MODIS \u536b\u661f\u7ecf\u5386\u4e86\u5927\u7ea6\u4e24\u5468\u7684\u6545\u969c\u671f\uff1b\u7531\u4e8e Terra MODIS \u7ee7\u7eed\u6b63\u5e38\u8fd0\u884c\uff0c\u975e\u6d32\u3001\u4e1c\u4e9a\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u548c\u5927\u6d0b\u7684\u6570\u636e\u4e22\u5931\u9884\u8ba1\u4e0d\u4f1a\u663e\u7740\u964d\u4f4e MCD64A1 \u5728\u8fd9\u4e9b\u533a\u57df\u7684\u71c3\u70e7\u6570\u636e\u5206\u6790", "90f6130b2789f73abf770e37749f893e": "\u6807\u8bc6\u68ee\u6797\u8986\u76d6\u533a\u57df", "fdf5ba6ed7e4b3874d2eac631b55f6b1": "\u7531\u4e8e\u7a7a\u95f4\u548c\u65f6\u95f4\u91c7\u6837\u95ee\u9898\uff0c\u4e0d\u5efa\u8bae\u7528\u6b63\u5728\u7740\u706b\u7684\u5730\u70b9\u6765\u4f30\u8ba1\u8fc7\u706b\u9762\u79ef\u3002", "ed203a07b4133720190259e036231016": "\uff08\u6bcf\u65e5\u3001375\u7c73\u3001\u5168\u7403\u3001\u7f8e\u56fd\u822a\u7a7a\u822a\u5929\u5c40\uff09", "1d5840b0796f6fc5d4e167dca1aeefd3": "\u5f53\u7f29\u5c0f\u663e\u793a\u65f6\uff08&lt; \u7f29\u653e\u6c34\u5e73 13\uff09\uff0c\u4ee5 30 x 30 \u7c73\u7684\u6807\u5ea6\uff0c\u589e\u52a0\u7684\u50cf\u7d20\u6839\u636e\u589e\u52a0\u5bc6\u5ea6\u53d8\u6697\u3002\u8f83\u6df1\u8272\u9634\u5f71\u7684\u50cf\u7d20\u8868\u793a\u8be5\u533a\u57df\u68ee\u6797\u8986\u76d6\u589e\u52a0\u6d53\u5ea6\u66f4\u9ad8\uff0c\u800c\u8f83\u6d45\u8272\u9634\u5f71\u7684\u50cf\u7d20\u8868\u793a\u8f83\u4f4e\u6d53\u5ea6\u7684\u68ee\u6797\u8986\u76d6\u589e\u52a0\u7684\u533a\u57df\u3002\u5f53\u6570\u636e\u4e3a\u5168\u5206\u8fa8\u7387\u65f6\uff0c\u50cf\u7d20\u9634\u5f71\u65e0\u53d8\u5316\uff08\u2265 \u7f29\u653e\u6c34\u5e73 13\uff09\u3002", "5e8213f8b134782ca1987eab15a2e1f5": "\u6bcf\u4e09\u5e74", "47ff53b4aaa342f97b93cfa9f8b48fec": "GFW \u548c\u9a6c\u91cc\u5170\u5927\u5b66 (UMD) Global Land Analysis &amp; Discovery (GLAD) \u5b9e\u9a8c\u5ba4\u7684\u4e13\u5bb6\u4eec\u63d0\u4f9b\u4e86 GFW \u6838\u5fc3\u68ee\u6797\u53d8\u5316\u6570\u636e\u96c6\uff08\u5305\u62ec\u201cGLAD \u53bb\u68ee\u6797\u5316\u9884\u8b66\u201d\u548c\u201c\u5e74\u5ea6\u6797\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u201d\uff09\u80cc\u540e\u7684\u65b9\u6cd5\u6982\u8ff0\u3002\u4ece\u536b\u661f\u56fe\u50cf\u7684\u9884\u5904\u7406\u6b65\u9aa4\u5230\u5bf9\u68ee\u6797\u5e72\u6270\u53ef\u80fd\u6027\u7684\u786e\u5b9a\uff0c\u60a8\u5c06\u53ef\u4ee5\u66f4\u6df1\u5165\u5730\u4e86\u89e3\u6211\u4eec\u662f\u5982\u4f55\u5c06\u4ece\u536b\u661f\u56fe\u50cf\u4e0a\u83b7\u53d6\u7684\u4fe1\u606f\u8f6c\u6362\u4e3a GFW \u5730\u56fe\u4e0a\u6240\u663e\u793a\u7684\u7c89\u7ea2\u8272\u50cf\u7d20\u70b9\u7684\u3002\u8fd9\u573a\u7f51\u7edc\u7814\u8ba8\u4f1a\u63d0\u4f9b\u82f1\u8bed\u7248\u4e0e\u897f\u73ed\u7259\u8bed\u7248\u3002", "e9b815067469b4fab386371f6454ae99": "\u7531\u4e8e Terra MODIS \u957f\u65f6\u95f4\u4e2d\u65ad\uff0c2000 \u5e74 8 \u6708\u548c 2001 \u5e74 6 \u6708\u7684\u6708\u5ea6\u6570\u636e\u4e25\u91cd\u4e0d\u8db3", "836c6bb3a3590f77bc21b02eed996276": "\u5bf9\u70e7\u6bc1\u533a\u57df\u7684\u5168\u7403\u51c6\u786e\u5ea6\u8bc4\u4f30\u53d1\u73b0\uff0c\u6574\u4f53\u51c6\u786e\u5ea6\u4e3a 97%\uff0c\u9519\u5206\u8bef\u5dee\uff08\u5373\u5047\u9633\u6027\u8bef\u62a5\uff09\u4e3a 24%\uff0c\u6f0f\u5206\u8bef\u5dee\uff08\u5373\u5047\u9634\u6027\u8bef\u62a5\uff09\u4e3a 37%\uff0c\u751f\u4ea7\u8005\u51c6\u786e\u5ea6\u4e3a 63%\uff0c\u7528\u6237\u51c6\u786e\u5ea6\u4e3a 76%\uff1b\u65f6\u95f4\u7cbe\u5ea6\u4e0a\uff0c\u5f53\u5929\u706b\u707e\u63a2\u6d4b\u7684\u7cbe\u5ea6\u4e3a 44%\uff0c\u4e24\u5929\u5185\u4e3a 68%", "deeace81e0518395b52a5ebd93342081": "\u663e\u793a\u706b\u707e\u5929\u6c14\u6307\u6570\uff1a\u706b\u707e\u5371\u9669\u7b49\u7ea7\u7cfb\u7edf", "52921f7f48bcf989575501aa15a3cd5f": "AQI \u8303\u56f4\u4ece 0 \u5230 500\uff1a<br><strong>0 \u5230 50\uff0c\u4f18</strong>\uff1a\u7a7a\u6c14\u8d28\u91cf\u7b26\u5408\u8981\u6c42\uff0c\u51e0\u4e4e\u6ca1\u6709\u7a7a\u6c14\u6c61\u67d3\u98ce\u9669<br><strong>51 \u5230 100\uff0c\u826f</strong>\uff1a\u7a7a\u6c14\u8d28\u91cf\u53ef\u4ee5\u63a5\u53d7\u3002 \u4e0d\u8fc7\uff0c\u90e8\u5206\u7fa4\u4f53\u53ef\u80fd\u4f1a\u9762\u4e34\u98ce\u9669\uff0c\u5c24\u5176\u662f\u5bf9\u7a7a\u6c14\u6c61\u67d3\u5f02\u5e38\u654f\u611f\u7684\u4eba\u3002<br><strong>101\u5230 150\uff0c\u4e0d\u5229\u4e8e\u654f\u611f\u4f53\u8d28\u7fa4\u4f53</strong>\uff1a\u654f\u611f\u7fa4\u4f53\u7684\u4eba\u5458\u53ef\u80fd\u4f1a\u53d7\u5230\u5065\u5eb7\u5f71\u54cd\u3002\u4e00\u822c\u516c\u4f17\u4e0d\u592a\u53ef\u80fd\u53d7\u5230\u5f71\u54cd\u3002<br><strong>151 \u5230 200\uff0c\u4e0d\u5065\u5eb7</strong>\uff1a\u4e00\u4e9b\u516c\u4f17\u53ef\u80fd\u4f1a\u53d7\u5230\u5065\u5eb7\u5f71\u54cd\uff1b\u654f\u611f\u7fa4\u4f53\u7684\u6210\u5458\u53ef\u80fd\u4f1a\u53d7\u5230\u66f4\u4e25\u91cd\u7684\u5065\u5eb7\u5f71\u54cd\u3002<br><strong>201 \u5230 100\uff0c\u975e\u5e38\u4e0d\u5065\u5eb7</strong>\uff1a\u5065\u5eb7\u8b66\u62a5\uff1a\u6bcf\u4e2a\u4eba\u7684\u5065\u5eb7\u5f71\u54cd\u98ce\u9669\u90fd\u4f1a\u589e\u52a0\u3002<br><strong>301 \u53ca\u4ee5\u4e0a , \u4e25\u91cd\u6c61\u67d3</strong>\uff1a\u7d27\u6025\u60c5\u51b5\u7684\u5065\u5eb7\u8b66\u544a\uff1a\u6bcf\u4e2a\u4eba\u90fd\u66f4\u6709\u53ef\u80fd\u53d7\u5230\u5f71\u54cd\u3002", "126c4c3261a922d852dd22f709c392aa": "\u6570\u636e\u9762\u677f", "405ed319c5692dc43fb978807ba7ac15": "\u6839\u636e\u4ece MODIS \u77ed\u6ce2\u7ea2\u5916\u8868\u9762\u53cd\u5c04\u6ce2\u6bb5\u5f97\u51fa\u7684\u5bf9\u71c3\u70e7\u654f\u611f\u7684\u690d\u88ab\u6307\u6570\u7684\u5dee\u5f02\uff0c\u663e\u793a\u6bcf\u6708\u71c3\u70e7\u9762\u79ef\u8303\u56f4\u548c\u71c3\u70e7\u65e5\u671f", "d26a6691a47cc15a66b23b0ac495044d": "\u81ea\u5b9a\u4e49\u68ee\u6797\u5730\u56fe", "6054cef5a84eef4b73ff248345bfb688": "\u5b8c\u6574\u7684\u68ee\u6797\u666f\u89c2", "9f1fa68f1c8cfb7a438e2383c13e421b": "\u79cd\u690d\u56ed", "1f4b5d390f0134dff3dea010c7eeec80": "\u706b\u707e", "90d41ad9c51c8ca16fba3224ff55f1cf": "\u6811\u6728\u8986\u76d6\u53d8\u5316", "431637d6f79f4adf403e3671d710e31b": "\u672c\u6570\u636e\u96c6\u7531\u9a6c\u91cc\u5170\u5927\u5b66\u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">GLAD</a>\uff08\u5168\u7403\u571f\u5730\u5206\u6790\u4e0e\u53d1\u73b0\uff09\u5b9e\u9a8c\u5ba4\u3001Google\u3001USGS \u548c NASA \u5408\u4f5c\u5f00\u53d1\uff0c\u7528\u4e8e\u6d4b\u91cf\u5168\u7403\u6240\u6709\u571f\u5730\uff08\u9664\u4e86 \u5357\u6781\u6d32\u548c\u5176\u4ed6\u5317\u6781\u5c9b\u5c7f\uff09\uff0c\u5206\u8fa8\u7387\u4e3a 30 \u00d7 30 \u7c73\uff0c\u663e\u793a\u4e3a 12 \u5e74\u6570\u636e\u7d2f\u79ef\u56fe\u5c42\u3002\u8fd9\u4e9b\u6570\u636e\u662f\u4f7f\u7528\u6765\u81ea <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Landsat 7</a> thematic mapper plus (ETM+) \u4f20\u611f\u5668\u7684\u591a\u5149\u8c31\u536b\u661f\u56fe\u50cf\u751f\u6210\u7684\u3002\u4f7f\u7528\u7528\u4e8e\u5730\u7403\u89c2\u6d4b\u548c\u6570\u636e\u5206\u6790\u7684\u4e91\u5e73\u53f0 Google Earth Engine \u7f16\u8bd1\u548c\u5206\u6790\u4e86\u8d85\u8fc7 600,000 \u5f20 Landsat 7 \u56fe\u50cf\u3002\u6536\u96c6\u7684\u536b\u661f\u56fe\u50cf\u53ef\u6e05\u6670\u5730\u663e\u793a\u5730\u8868\u89c2\u6d4b\uff0830 \u00d7 30 \u7c73\u50cf\u7d20\uff09\uff0c\u5e76\u5e94\u7528\u76d1\u7763\u5b66\u4e60\u7b97\u6cd5\u6765\u8bc6\u522b\u6bcf\u4e2a\u50cf\u7d20\u7684\u6811\u6728\u8986\u76d6\u589e\u76ca\u3002", "9e0f43ec3335847b8356d5a5fcfb7152": "\u6211\u4eec\u9700\u8981\u4f7f\u7528\u8fd9\u4e9b\u4fe1\u606f\u4ee5\u4f7f Global Forest Watch \u5bf9\u60a8\u66f4\u4e3a\u6709\u7528\u3002\u60a8\u7684\u9690\u79c1\u5bf9\u6211\u4eec\u6765\u8bf4\u5f88\u91cd\u8981\u3002\u672a\u7ecf\u60a8\u7684\u540c\u610f\uff0c\u6211\u4eec\u7edd\u4e0d\u4f1a\u5206\u4eab\u60a8\u7684\u4fe1\u606f\u3002", "3d8de6fcc09baf73f7175fe59f278ced": "\u60a8\u7684\u8d44\u6599", "9461dfec80b7485cd052414128668fa8": "\u540d\u5b57", "d805ea080e9f2bd040846480a6d50d19": "\u59d3\u6c0f *", "f789f97ec1b1d31c0961657e93ecf167": "\u90e8\u95e8 *", "9aa36f238531b1fe70af17ed83c09022": "\u516c\u53f8/\u7ec4\u7ec7 *", "a161e64c0775db63c30e7774b6040a7e": "\u7a7a\u6c14\u8d28\u91cf\u6570\u636e\u7684\u53d1\u5e03\u672a\u7ecf\u9a8c\u8bc1\uff0c\u56e0\u6b64\u53ef\u80fd\u4f1a\u51fa\u4e8e\u4fdd\u8bc1\u8d28\u91cf\u7684\u76ee\u7684\u8fdb\u884c\u4fee\u6539\u3002\u7136\u800c\uff0c\u6570\u636e\u4e00\u81f4\u6027\u901a\u8fc7\u4e0e\u76f8\u90bb\u7ad9\u70b9\u8fdb\u884c\u5b9e\u65f6\u9a8c\u8bc1\u4ee5\u81ea\u52a8\u68c0\u6d4b\u51fa\u5b58\u5728\u95ee\u9898\u7684\u76d1\u6d4b\u7ad9\u3002", "273b14d7a15510ca053e1db861dc3cec": "Planet \u536b\u661f\u56fe\u50cf<span class=\"caveat\">\uff08\u70ed\u5e26\uff09</span>", "5616f6619fedefe592d853f26047ef9f": "\u8fd1\u5b9e\u65f6", "fce20dde7c3b16a5646a8081d40f14d9": "\u5929\u7136\u6797", "272f474624b4ec256ff5a462e21c233b": "\u5728\u8be5\u6570\u636e\u96c6\u4e2d\uff0c\u201c\u68ee\u6797\u8986\u76d6\u201d\u5b9a\u4e49\u4e3a\u6240\u6709\u9ad8\u4e8e 5 \u7c73\u7684\u690d\u88ab\uff0c\u5176\u5f62\u5f0f\u4e3a\u5404\u79cd\u68ee\u6797\u8986\u76d6\u5bc6\u5ea6\u7684\u81ea\u7136\u6797\u6216\u4eba\u5de5\u6797\u3002\u201c\u589e\u52a0\u201d\u7684\u5b9a\u4e49\u662f\uff0c\u5728\u6b64\u524d\u65e0\u68ee\u6797\u8986\u76d6\u7684\u533a\u57df\u5185\uff0c\u5728\u9646\u5730\u536b\u661f\u50cf\u7d20\u6bd4\u4f8b\u5c3a\u4e0a\u5bf9\u6797\u51a0\u7684\u786e\u8ba4\u3002\u68ee\u6797\u8986\u76d6\u589e\u52a0\u53ef\u80fd\u8868\u660e\u4e00\u7cfb\u5217\u6f5c\u5728\u7684\u6d3b\u52a8\uff0c\u5305\u62ec\u5929\u7136\u6797\u751f\u957f\u6216\u4eba\u5de5\u6797\u7684\u8f6e\u4f5c\u5468\u671f\u3002", "7066e8eeb7c875a3e3aabd173d5c4b65": "\u60a8\u5bf9\u54ea\u4e9b\u4e3b\u9898\u611f\u5174\u8da3\uff1f *", "3d00eff68e198e6f876272d339d2173c": "<svg class=\"c-icon icon-user\" viewBox=\"0 0 32 32\"><use xlink:href=\"#profile-1bf4f99d--sprite\"></use></svg>\u8bb0\u8005", "6796ca4c83b06c4ab0f2d3e7f9c5ae65": "\u4e0d\u662f\u6240\u6709\u7684\u706b\u707e\u90fd\u80fd\u88ab\u63a2\u6d4b\u5230\u3002\u6709\u51e0\u4e2a\u7406\u7531\u4f1a\u5bfc\u81f4 VIIRS \u53ef\u80fd\u6ca1\u6709\u76d1\u6d4b\u5230\u67d0\u573a\u706b\u707e\u3002\u706b\u707e\u6709\u53ef\u80fd\u5728\u536b\u661f\u7ecf\u8fc7\u65f6\u95f4\u7684\u7a7a\u9699\u4e4b\u95f4\u5c31\u5f00\u59cb\u5e76\u7ed3\u675f\u4e86\u3002\u706b\u707e\u6709\u53ef\u80fd\u592a\u5c0f\u6216\u6e29\u5ea6\u592a\u4f4e\uff0c\u4ee5\u81f3\u4e8e\u65e0\u6cd5\u5728375\u7c73\u7684\u50cf\u7d20\u4e2d\u88ab\u63a2\u6d4b\u5230\u3002\u4e91\u5c42\u3001\u6d53\u70df\u6216\u6811\u51a0\u6709\u53ef\u80fd\u5b8c\u5168\u906e\u76d6\u706b\u707e\u3002", "a291c179e20af7e8fba276dff60ee8f8": "\u5168\u7403\u70e7\u6bc1\u533a\u57df", "0c01b75e09e15e252a5e35a451eac9e4": "\u804c\u4f4d", "e3777d8ff8e735a2bac8f729fbacfc92": "\u60a8\u5728\u54ea\u91cc\uff1f", "17b0e9c55e81b22be05e375489c388cb": "\u56fd\u5bb6/\u5730\u533a *", "4ed5d2eaed1a1fadcc41ad1d58ed603e": "\u57ce\u5e02", "501de90050c95decead9c73b9a714af0": "\u60a8\u5bf9\u4ec0\u4e48\u533a\u57df\u6700\u611f\u5174\u8da3\uff1f", "815130a57cd347c8afd79459e788382a": "\u5dde/\u90e8\u95e8/\u7701", "951a7e017cb481f2b5a6f99e8d6198fc": "\u6b64\u6570\u636e\u96c6\u5f97\u76ca\u4e8e\u4f4d\u4e8e\u9a6c\u91cc\u5170\u5927\u5b66\u3001Google\u3001USGS \u548c NASA \u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">GLAD</a>\uff08\u5168\u7403\u571f\u5730\u5206\u6790 &amp; \u63a2\u7d22) \u5b9e\u9a8c\u5ba4\u4e4b\u95f4\u7684\u5408\u4f5c\uff0c\u4ee5\u7ea6 30 \u00d7 30 \u7c73\u5206\u8fa8\u7387\u6d4b\u91cf\u5168\u7403\u571f\u5730\uff08\u9664\u4e86\u5357\u6781\u6d32\u548c\u5176\u4ed6\u5317\u6781\u5c9b\u5c7f\uff09\u7684\u6811\u6728\u8986\u76d6\u6d41\u5931\u9762\u79ef\u3002\u6570\u636e\u5229\u7528\u591a\u8c31\u536b\u661f\u56fe\u50cf\u751f\u6210\uff0c\u591a\u8c31\u536b\u661f\u56fe\u50cf\u6765\u81ea\u9646\u5730\u536b\u661f 5 \u53f7\u4e13\u9898\u5236\u56fe\u4eea (TM)\uff0c\u9646\u5730\u536b\u661f 7 \u53f7\u589e\u5f3a\u578b\u4e13\u9898\u5236\u56fe\u4eea (ETM+)\uff0c\u4ee5\u53ca\u9646\u5730\u536b\u661f 8 \u53f7\u9646\u5730\u6210\u50cf\u4eea (OLI) \u4f20\u611f\u5668\u3002\u8d85\u8fc7 100 \u4e07\u5f20\u536b\u661f\u56fe\u50cf\u88ab\u5904\u7406\u548c\u5206\u6790\uff0c\u5305\u62ec 2000-2012 \u5e74\u671f\u95f4 60 \u591a\u4e07\u5f20\u9646\u5730\u536b\u661f 7 \u53f7\u7684\u56fe\u50cf\uff0c40 \u591a\u4e07\u5f20 2011-2020 \u5e74\u671f\u95f4\u66f4\u65b0\u7684\u9646\u5730\u536b\u661f 5\u30017\u30018 \u53f7\u7684\u56fe\u50cf\u3002\u96c6\u5408\u536b\u661f\u56fe\u50cf\u4e2d\u6e05\u6670\u7684\u5730\u8868\u89c2\u6d4b\u6570\u636e\uff0c\u5e94\u7528\u76d1\u7763\u5b66\u4e60\u7b97\u6cd5\u8bc6\u522b\u6bcf\u50cf\u7d20\u6811\u6728\u8986\u76d6\u635f\u5931\u3002", "cf637bb1df0899b155404561aacf348f": "\u5168\u7403\u9646\u5730\u9762\u79ef\uff08\u4e0d\u5305\u62ec\u5357\u6781\u6d32\u548c\u5176\u5b83\u5317\u6781\u5c9b\u5c7f\uff09", "0f8397d5d290a5c61b155d92a5da3748": "\u6708\u5ea6\u9ad8\u6e05\u5730\u56fe\u5e95\u56fe\uff08\u70ed\u5e26\uff09", "ac3b7b2dd062c3badaa3796ca0acc1b1": "\u6797\u6728\u8986\u76d6\u589e\u91cf\u88ab\u5b9a\u4e49\u4e3a\uff0c\u5728\u9646\u5730\u536b\u661f\u50cf\u7d20\u6807\u51c6\u4e0a\uff0c\u6b64\u524d\u6ca1\u6709\u6811\u6728\u8986\u76d6\u7684\u5730\u533a\u51fa\u73b0\u4e86\u6811\u51a0\u3002\u6797\u6728\u8986\u76d6\u589e\u91cf\u53ef\u8868\u660e\u4e00\u4e9b\u6f5c\u5728\u7684\u6d3b\u52a8\uff0c\u5305\u62ec\u5929\u7136\u6797\u751f\u957f\u6216\u4eba\u5de5\u6797\u7684\u8f6e\u4f5c\u5468\u671f\u3002", "54afcec0e5950a3983992fe0a7cbbce4": "\u70e7\u6bc1\u533a\u57df", "3332a904daef7fe243d959084260fd70": "\u6bcf\u65e5\u4e24\u6b21", "648c7a5b085eaf8e2f07a8108138db6a": "\u519c\u4e1a\u4f9b\u5e94\u94fe", "0aead250fce270f6ca263e070f24fe65": "\u6c14\u5019/\u78b3", "2f7fb028dfddec5c844d57120f400895": "\u6ee5\u4f10\uff08\u6bc1\u6797\uff09\uff0f\u68ee\u6797\u9000\u5316", "5820d152821b62e99284f9310f109c32": "\u6709\u5173\u68ee\u6797\u7684\u4e00\u822c\u4fe1\u606f\uff0f\u6570\u636e", "a2eecf8f3c2302cfb6e45f30d120b68b": "\u68ee\u6797\u76d1\u6d4b\u521b\u65b0", "687a93476ea5b10525abb62feedd13fc": "\u5021\u5bfc/\u5ba3\u4f20", "b7f9383103edc60a0eb7193a27326e5b": "\u5e95\u56fe", "4cc6684df7b4a92b1dec6fce3264fac8": "\u5168\u7403", "7a2a402b8156d07e5dd068d55f5e53bc": "\u663e\u793a\u5168\u7403 PM2.5 \u7a7a\u6c14\u8d28\u91cf", "9c12254af91bb57fce3c11e776be66ff": "\u536b\u661f\u56fe\u50cf", "594223ff342c38dffa2569c0741c993b": "MODIS \u71c3\u70e7\u533a\u57df\u6570\u636e\u4ea7\u54c1\u4f7f\u7528\u591a\u9636\u6bb5\u7b97\u6cd5\u5c06\u5355\u4e2a 500 m \u7f51\u683c\u5355\u5143\u5728\u5355\u4e2a\u81ea\u7136\u6708\u5185\u5206\u7c7b\u4e3a\u71c3\u70e7\u6216\u672a\u71c3\u70e7\u3002\u5bf9\u4e8e\u5355\u4e2a MODIS \u65b9\u5757\uff0c\u53d8\u5316\u68c0\u6d4b\u7b97\u6cd5 1) \u751f\u6210\u5408\u6210\u56fe\u50cf\uff0c\u603b\u7ed3\u71c3\u70e7\u654f\u611f\u690d\u88ab\u6307\u6570\u65f6\u95f4\u5e8f\u5217\u4e2d\u7684\u6301\u7eed\u53d8\u5316\uff0c2) \u4f7f\u7528\u65f6\u95f4\u548c\u7a7a\u95f4\u4e0a\u7684\u706b\u707e\u6d3b\u52a8\u4fe1\u606f\u6765\u6307\u5bfc\u71c3\u70e7\u76f8\u5173\u548c\u975e\u71c3\u70e7\u76f8\u5173\u53d8\u5316\u7684\u7edf\u8ba1\u8868\u5f81\uff0c\u4ee5\u53ca 3) \u4f30\u8ba1\u4e00\u4e2a\u6982\u7387\u9608\u503c\u6765\u8bc6\u522b\u5305\u542b\u70e7\u6bc1\u533a\u57df\u7684\u7f51\u683c\u5355\u5143\u3002\u4e3a\u4e86\u9002\u5e94\u53d8\u5316\u68c0\u6d4b\u8fc7\u7a0b\u4e2d\u4f7f\u7528\u7684\u79fb\u52a8\u7a97\u53e3\uff0c\u9700\u8981\u5728\u6620\u50cf\u5468\u671f\u4e4b\u524d\u548c\u4e4b\u540e\u8fdb\u884c\u4e00\u4e2a\u6708\u7684\u6bcf\u65e5\u89c2\u5bdf\uff0c\u56e0\u6b64\u9700\u8981\u8fde\u7eed\u4e09\u4e2a\u6708\u7684\u89c2\u5bdf\u6765\u6620\u50cf\u4e00\u4e2a\u81ea\u7136\u6708\u7684\u71c3\u70e7\u8fc7\u7a0b\u3002\u9664\u4e86\u68c0\u6d4b\u71c3\u70e7\u533a\u57df\u7684\u8303\u56f4\u5916\uff0c\u6570\u636e\u4ea7\u54c1\u8fd8\u6839\u636e\u4e3b\u52a8\u706b\u707e\u68c0\u6d4b\u4f30\u7b97\u6bcf\u4e2a 500 m\u7f51\u683c\u5355\u5143\u6bcf\u6708\u71c3\u70e7\u7684\u65f6\u957f\u3002", "33f22561e92c76a75b6e4d9f5641d977": "\u6d41\u57df", "2ad2e217a887daa7d009e1dbbea3e384": "\u60a8\u5982\u4f55\u4f7f\u7528 Global Forest Watch\uff1f*", "b266e1f056c41429ed9f65100abe86cb": "\u7528\u4e8e\u535a\u5ba2\u6587\u7ae0\u6216\u5a92\u4f53\u62a5\u9053\u7684\u6570\u636e\u6216\u89c6\u89c9\u6548\u679c\u56fe", "7849b129e91e5ecea19803b726446ef9": "\u7528\u4e8e\u6f14\u793a\u548c\u62a5\u544a\u7684\u6570\u636e\u6216\u89c6\u89c9\u8d44\u6599", "69b22c20abb96e9d10c940ea19b9b9eb": "\u6211\u7684\u56fd\u5bb6\u6216\u5730\u533a", "9e073ff8eafe5fae34cf7d984f4712dc": "\u9020\u6797\u518d\u9020/\u666f\u89c2\u6062\u590d", "24749ee72b73b714fdb87c2047ab1cd0": "\u5c0f\u989d\u8865\u52a9\u57fa\u91d1\u548c\u79d1\u6280\u5956", "45b333e32c7ea68d81fd713028384a9f": "\u663e\u793a\u8fc7\u53bb 24 \u5c0f\u65f6\u300148 \u5c0f\u65f6\u300172 \u5c0f\u65f6\u6216 7 \u5929\u7684\u706b\u707e\u8b66\u62a5\u6570\u636e", "bcd444d8ee2c8cba0088cfab5f17e471": "\u5b9e\u65f6\uff0c\u5168\u7403\uff0cWAQI/EPA", "8493bc9d53fdb13e2aaa8d1a0ee4a5f6": "+ \u6dfb\u52a0\u56fd\u5bb6", "bc3427a1fe05eea389fe013588ae521d": "\u6570\u636e\u53ef\u7528\u6027\u53d7\u5230\u6570\u636e\u63d0\u4f9b\u5546\u7684\u9650\u5236\uff0c\u6570\u636e\u63d0\u4f9b\u5546\u6700\u591a\u53ef\u80fd\u4f1a\u5ef6\u8fdf\u4e24\u4e2a\u6708\u63d0\u4f9b\u6570\u636e\u3002", "61c95250529c7f3a80ba069175c2f1ee": "\u4e00\u822c\u7814\u7a76", "e6f799c4f353f820aae96480df22d225": "\u8bc6\u522b\u975e\u6cd5\u6d3b\u52a8", "8b7d450c9e6c5ae0e46463b8221caf13": "\u544a\u77e5\u8d44\u52a9\u91d1\u62e8\u6b3e\u51b3\u5b9a\uff0f\u57fa\u4e8e\u7ed3\u679c\u7684\u4ed8\u6b3e", "c098c4c33b5f009a6a539b496d833d64": "\u6559\u80b2\u8f85\u52a9\u6750\u6599", "b9c0752ad1856071593781c6d64568ac": "\u901a\u77e5\u8d2d\u4e70\uff0f\u91c7\u8d2d\uff0f\u6295\u8d44\u51b3\u7b56", "faed5b7c4f051c68dee4c17e831e4002": "\u706b\u707e\u8b66\u62a5\uff08VIIRS\uff09", "99ff39ea94430a6683ad41c6b3ed71f8": "\u571f\u5730\u4f7f\u7528\u89c4\u5212\uff0f\u571f\u5730\u7528\u9014\u5206\u914d", "0d0e2ebdec9c57d1e65b4281688585aa": "\u4e86\u89e3\u68ee\u6797/\u6211\u7684\u56fd\u5bb6\u6216\u5730\u533a", "c59f2e064d1266a66aa357213f96df14": "\u9009\u62e9\u6700\u591a3\u4e2a\u6708\u7684\u8b66\u62a5\uff1a", "5d6a00700728256a953ca037ed959844": "\u76d1\u6d4b\u6216\u7ba1\u7406\u67d0\u7247\u533a\u57df", "dc2eb777a6146fd6e094a35748365606": "\u76d1\u6d4b\u7ed3\u679c\uff0f\u5f71\u54cd", "7401d8e5888637dd23345c4dc1af4bf5": "\u4e0d\u786e\u5b9a\uff1bGFW \u65b0\u624b", "498f2cb39f8d2e9b8206796ecf071436": "\u4f5c\u8005\u8bc4\u4f30\u4e86\u8be5\u6570\u636e\u4e2d\u5047\u6b63\uff08\u7c7b\u522b\u6027\u9519\u8bef\uff09\u7684\u603b\u4f53\u53d1\u751f\u7387\u4e3a24%\uff0c\u5047\u8d1f\uff08\u5ffd\u7565\u6027\u9519\u8bef\uff09\u7684\u53d1\u751f\u7387\u4e3a26%\uff0c\u5c3d\u7ba1\u5176\u51c6\u786e\u6027\u56e0\u751f\u7269\u7fa4\u843d\u800c\u5f02\uff0c\u56e0\u6b64\u5728\u4efb\u4f55\u7279\u5b9a\u4f4d\u7f6e\u53ef\u80fd\u66f4\u9ad8\u6216\u66f4\u4f4e\u3002\u8bf7\u9605\u8bfb\u6211\u4eec\u5173\u4e8e\u6b64\u6570\u636e\u51c6\u786e\u6027\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u535a\u5ba2\u7cfb\u5217</a>\uff0c\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002", "f17ca46921c0af3b8cb4df85abaabaf0": "\u663e\u793a\u7684\u6570\u636e\u7684\u6797\u6728\u690d\u88ab\u6811\u51a0\u5bc6\u5ea6\u4e3a&gt;50%\u3002", "c05c6437a7d0531362b79739bcb1aed0": "VIIRS \u6d3b\u8dc3\u706b\u707e\u6570\u636e (<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">VNP14IMGT</a>) \u662f FIRMS \uff08\u8d44\u6e90\u7ba1\u7406\u7cfb\u7edf\u7684\u706b\u707e\u4fe1\u606f\uff09\u7684\u6700\u65b0\u706b\u707e\u76d1\u6d4b\u4ea7\u54c1\uff0c\u53ef\u4ee5\u8fd1\u5b9e\u65f6\u5730\u8bc6\u522b\u5168\u7403\u706b\u707e\u4f4d\u7f6e\u3002\u4fe1\u606f\u901a\u8fc7\u53ef\u89c1\u5149\u7ea2\u5916\u6210\u50cf\u8f90\u5c04\u4eea\u5957\u4ef6 (VIIRS) \u4f20\u611f\u5668\u6536\u96c6\uff0c\u5e76\u901a\u8fc7<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u706b\u707e\u63a2\u6d4b\u7b97\u6cd5</a>\u8fdb\u884c\u5904\u7406\uff0c\u4ee5\u6807\u8bb0\u6d3b\u8dc3\u7684\u706b\u707e\u3002\u5730\u56fe\u4e0a\u7684\u6bcf\u4e2a\u70b9\u4ee3\u8868\u4e86\u88ab\u7b97\u6cd5\u6807\u8bb0\u7684\u4e00\u4e2a 375 \u7c73\u50cf\u7d20\u7684\u4e2d\u5fc3\u3002", "2368df091019ddd0c000364a8842b885": "\u6d3b\u52a8\u706b\u707e\u6570\u636e\u53ef\u4f9b\u67e5\u9605\uff0c\u5e76\u53ef\u4e0b\u8f7d\u8fc7\u53bb 24 \u5c0f\u65f6\u300148 \u5c0f\u65f6\u6216 7 \u5929\u7684\u706b\u707e\u6570\u636e\u3002\u8f83\u65e9\u7684\u706b\u707e\u6570\u636e\uff08\u59cb\u4e8e 2016 \u5e74\u4e2d\uff09\u53ef\u4ee5\u4ece <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">NASA FIRMS</a> \u7f51\u7ad9\u4e0b\u8f7d\u3002", "e1752f3eef72f3572538bbf8e7080751": "\u672c\u6570\u636e\u96c6\u662f\u9a6c\u91cc\u5170\u5927\u5b66 <a target=\"_blank\" href=\"{{0}}\">GLAD</a>\uff08\u5168\u7403\u571f\u5730\u5206\u6790\u4e0e\u53d1\u73b0\u4e2d\u5fc3\uff09\u5b9e\u9a8c\u5ba4\u3001Google\u3001USGS \u548c NASA \u5408\u4f5c\u5b8c\u6210\u7684\uff0c\u4ee5 30\u00d730 \u7c73\u7684\u5206\u8fa8\u7387\u6d4b\u91cf\u5168\u7403\uff08\u9664\u5357\u6781\u6d32\u548c\u5176\u4ed6\u5317\u6781\u7fa4\u5c9b\uff09\u68ee\u6797\u8986\u76d6\u589e\u52a0\u9762\u79ef\uff0c\u663e\u793a\u4e3a\u4e00\u4e2a 12 \u5e74\u7684\u7d2f\u79ef\u5c42\u3002\u6570\u636e\u7684\u751f\u6210\u4f7f\u7528\u4e86\u6765\u81ea <a target=\"_blank\" href=\"{{1}}\"> \u9646\u5730\u536b\u661f 7 \u53f7 </a> \u4e13\u9898\u5236\u56fe\u4eea +(ETM+) \u4f20\u611f\u5668\u7684\u591a\u5149\u8c31\u536b\u661f\u56fe\u50cf\u3002\u6536\u96c6\u5e76\u5206\u6790\u4e86 600,000 \u591a\u5f20\u9646\u5730\u536b\u661f 7 \u53f7\u56fe\u50cf\uff0c\u5e76\u4f7f\u7528 Google \u5730\u7403\u5f15\u64ce\u8fdb\u884c\u5206\u6790\uff0c Google \u5730\u7403\u5f15\u64ce\u662f\u4e00\u4e2a\u7528\u4e8e\u5730\u7403\u89c2\u6d4b\u548c\u6570\u636e\u5206\u6790\u7684\u4e91\u7aef\u5e73\u53f0\u3002\u5bf9\u536b\u661f\u56fe\u50cf\u4e2d\u6e05\u6670\u7684\u5730\u8868\u89c2\u6d4b\u7ed3\u679c\uff0830\u00d730 \u7c73\u50cf\u7d20\uff09\u52a0\u4ee5\u7ec4\u5408\uff0c\u7136\u540e\u8fd0\u7528\u76d1\u7763\u5f0f\u5b66\u4e60\u7b97\u6cd5\u6765\u786e\u5b9a\u6bcf\u50cf\u7d20\u7684\u68ee\u6797\u8986\u76d6\u589e\u52a0\u3002", "596b6314d2ec37a3f8a9dadb71eac1d2": "\u89c4\u5212\u5b9e\u5730\u5de5\u4f5c\uff08\u5de1\u903b\uff0f\u8c03\u67e5\uff09", "6311ae17c1ee52b36e68aaf4ad066387": "\u5176\u4ed6", "91f2557c634131b4e370dcd31a88ea70": "\u5982\u9700\u5220\u9664\u60a8\u7684 MyGFW \u8d26\u6237\uff0c\u8bf7<a href=\"{{0}}\">\u7ed9\u6211\u4eec\u53d1\u7535\u5b50\u90ae\u4ef6\u8054\u7cfb</a>\u3002", "43781db5c40ecc39fd718685594f0956": "\u4fdd\u5b58", "532fc20d1605999f43e6af17fa69ea80": "0-50\uff1a\u4f18", "ba04182d23b47f8d02ed5daae4d8aa57": "\u706b\u707e\u5929\u6c14", "9a8e7b049f2ae45939a17acf434d5713": "<svg class=\"c-icon icon-user\" viewBox=\"0 0 32 32\"><use xlink:href=\"#profile-1bf4f99d--sprite\"></use></svg>\u4fdd\u62a4\u7ec4\u7ec7", "59ef322e613d18920c1931d72a9f2824": "\u91cd\u8981\u6027", "655d20c1ca69519ca647684edbb2db35": "\u9ad8", "28d0edd045e05cf5af64e35ae0c4c6ef": "\u4f4e", "4dcde8f37b9fae6b513ef36c954bd0d3": "51-100\uff1a\u826f", "97260b1eff08a481627c61b3d8ae6949": "101-150\uff1a\u4e0d\u5229\u4e8e\u654f\u611f\u4f53\u8d28\u7fa4\u4f53", "16594a227d4b84f57aa5eb7c91222ca0": "151-200\uff1a\u4e0d\u5065\u5eb7", "e95f5d7bc55ac989622e05da4107f6a5": "201-300\uff1a\u975e\u5e38\u4e0d\u5065\u5eb7", "b55b67265db973f965085bb23a05d8d7": ">300\uff1a\u4e25\u91cd\u6c61\u67d3", "46c570ce4c989efa36d3a2a7f3043455": "2001 \u5e74\uff0c30m\uff0c\u6cdb\u70ed\u5e26\uff0cUMD", "9b8b9f1ff75996c7d5026b7147a55338": "\u6309\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\u5206\u5217\u7684\u68ee\u6797\u8986\u76d6\u51cf\u5c11", "3e6456dedd0d0871fe863af78109ef08": "\u663e\u793a\u6bcf 10 km \u7f51\u683c\u5355\u5143\u5185\u6811\u6728\u8986\u76d6\u51cf\u5c11\u7684\u4e3b\u5bfc\u9a71\u52a8\u56e0\u7d20\uff0c\u4ee5\u53ca 2001 \u5e74\u81f3 2019 \u5e74\u671f\u95f4\u8be5\u9879\u51cf\u5c11\u7684\u5f3a\u5ea6\u3002", "5a8589562cec252a481b29f47f86ded6": "\u6b64\u6570\u636e\u96c6\u5e94\u5728\u5168\u7403\u6216\u5730\u533a\u6bd4\u4f8b\u4e0b\u4f7f\u7528\uff0c\u4e0d\u8981\u5355\u50cf\u7d20\u4f7f\u7528\u3002\u7531\u4e8e\u65f6\u95f4\u548c\u7a7a\u95f4\u4e0d\u540c\uff0c\u5355\u4e2a\u7f51\u683c\u5355\u5143\u53ef\u80fd\u4f1a\u6709\u4e00\u4e2a\u4ee5\u4e0a\u7684\u68ee\u6797\u8986\u76d6\u635f\u5931\u9a71\u52a8\u56e0\u7d20\u3002", "b25563031d987150ab4c12b28bef27a1": "\u5bf9\u4e8e\u7531\u5546\u54c1\u9a71\u52a8\u7684\u53bb\u68ee\u6797\u5316\u53ca\u57ce\u9547\u5316\u7c7b\u578b\uff0c\u4e00\u822c\u8ba4\u4e3a\u53d1\u751f\u4e86\u4ece\u68ee\u6797\u5411\u975e\u68ee\u6797\u72b6\u6001\u7684\u6c38\u4e45\u8f6c\u53d8\u3002\u800c\u5728\u8fd9\u4e24\u7c7b\u4ee5\u5916\uff0c\u8fd9\u7ec4\u6570\u636e\u96c6\u5e76\u672a\u6307\u793a\u5728\u53d1\u751f\u6797\u6728\u8986\u76d6\u635f\u5931\u540e\u6797\u5730\u4f7f\u7528\u7684\u7a33\u5b9a\u6027\u6216\u53d8\u5316\u72b6\u51b5\u3002\u8fd9\u7ec4\u6570\u636e\u96c6\u4ea6\u672a\u80fd\u533a\u5206\u7531\u81ea\u7136\u56e0\u7d20\u9020\u6210\u7684\u548c\u7531\u4eba\u4e3a\u56e0\u7d20\u9020\u6210\u7684\u5c71\u706b\u3002", "27ff35d84ed02176ff06aba092a9800e": "2019, 30m, global, UMD/NASA GEDI", "b9f5c210d697095b932e78044987a257": "\u901a\u8fc7 1,565 \u4e2a\u968f\u673a\u9009\u62e9\u7684\u7f51\u683c\u5355\u5143\u7684\u9a8c\u8bc1\u6837\u672c\u5bf9\u6570\u636e\u7684\u7cbe\u5ea6\u8fdb\u884c\u8bc4\u4f30\u3002\u8be5\u6a21\u578b\u7684\u603b\u4f53\u7cbe\u5ea6\u4e3a 89\uff05\uff0c\u5176\u4e2d\u5404\u7c7b\u522b\u7684\u7cbe\u5ea6\u4ece 55\uff05\uff08\u57ce\u5e02\u5316\uff09\u5230 94\uff05\uff08\u5546\u54c1\u63a8\u52a8\u578b\u68ee\u6797\u780d\u4f10\uff09\u4e0d\u7b49\u3002", "6dc189fba20bd7748a73ccce03c29e1a": "\u8fd9\u7ec4\u6570\u636e\u96c6\u91c7\u7528\u4e86\u4e0b\u8ff0\u4e94\u4e2a\u7c7b\u522b\uff0c\u5c55\u793a\u4e86 2001 \u81f3 2019 \u5e74\u95f4<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6797\u6728\u8986\u76d6\u51cf\u5c11</a>\u7684\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\uff1a", "458a65fec4d4bfe7eceb83c85531a798": "<strong>\u5546\u54c1\u9a71\u52a8\u7684\u68ee\u6797\u780d\u4f10\uff1a</strong>\u4e3b\u8981\u4e0e\u5546\u4e1a\u5316\u519c\u4e1a\u6269\u5f20\u5173\u8054\u7684\u5927\u89c4\u6a21\u68ee\u6797\u780d\u4f10\u3002", "4412b42b8ab6e00e26f450af62e68a82": "\u6bcf\u5e74\uff0c300m\uff0c\u5168\u7403\uff0cWCS", "f4fda6419947aed142d1bd0dce5fbd75": "2020\uff0c\u9009\u62e9\u56fd\u5bb6", "2d73a9511a01a051aff115c6c84bdf4a": "\u9a6c\u8d5b\u514b\u666f\u89c2\u4e2d\u7684\u6811\u6728", "83f7c931c2edbc0d3c07da46d77328b8": "annual, 30m, South America, Song et al. 2021", "d8ceed3ac81fe2b850b8bc94292e1496": "\u5927\u8c46\u79cd\u690d\u533a\u57df", "0e42b4dd84fd7148b800d42349e0c757": "<strong>\u8f6e\u8015\u519c\u4e1a\uff1a</strong>\u7531\u4e2d\u5c0f\u89c4\u6a21\u519c\u4e1a\u6240\u9020\u6210\u7684\u6682\u65f6\u6027\u6d41\u5931\u6216\u6c38\u4e45\u6027\u6bc1\u6797\u3002", "af289d97ad87b663fb65ab51a1189c16": "<strong>\u6797\u4e1a\uff1a</strong>\u79cd\u690d\u56ed\u548c\u5929\u7136\u6797\u91c7\u4f10\u5bfc\u81f4\u7684\u6682\u65f6\u51cf\u5c11\uff0c\u6709\u4e00\u4e9b\u539f\u59cb\u68ee\u6797\u780d\u4f10\u3002", "5b1f110c63c4702d42471ba4338303c0": "<strong>\u91ce\u706b\uff1a</strong>\u6682\u65f6\u51cf\u5c11\uff0c\u4e0d\u5305\u62ec\u519c\u4e1a\u70e7\u8352\u3002", "a4be3ab4e6972f7a6342671dc3fef5ec": "<strong>\u57ce\u5e02\u5316\uff1a</strong>\u4e3a\u4e86\u6269\u5c55\u57ce\u5e02\u4e2d\u5fc3\u800c\u780d\u4f10\u68ee\u6797", "203659fb54b5220eb85464fff94f8fa0": "\u63a2\u7d22\u6240\u6709\u5e94\u7528", "35d85d1caa2a4f161b4227db8021d753": "\u7ea2\u6811\u6797", "3d2db3d81099b27c74414540d4c11827": "\u6811\u6728\u8986\u76d6 - 2000", "ac5fb878e4eb67e51c191814b041b28b": "\u539f\u59cb\u68ee\u6797 - 2011 \u5e74", "8317a318b9c8d336d6af3613c28d3649": "\u539f\u59cb\u68ee\u6797", "ec9f830be1789354eaf7092737e65974": "\u663e\u793a 2019 \u5e74\u5168\u7403\u68ee\u6797\u51a0\u5c42\u9ad8\u5ea6\u3002", "7fea063e34564627246a0fb6f213ec23": "\u5546\u4e1a\u9a71\u52a8\u7684\u6bc1\u6797\u548c\u57ce\u5e02\u5316\u7c7b\u522b\u4ee3\u8868\u7740\u6c38\u4e45\u6027\u6bc1\u6797\uff0c\u800c\u5728\u5176\u4ed6\u7c7b\u522b\u4e2d\uff0c\u6811\u6728\u8986\u76d6\u901a\u5e38\u4f1a\u91cd\u65b0\u6062\u590d\u3002", "8bd71c04c4c9500024791bc06fd29d79": "\u4f7f\u7528\u51b3\u7b56\u6811\u6a21\u578b\u751f\u6210\u6570\u636e\uff0c\u5c06\u6bcf 10 \u516c\u91cc\u7684\u7f51\u683c\u5355\u5143\u5212\u4e3a 5 \u5927\u7c7b\u522b\u4e4b\u4e00\u3002\u51b3\u7b56\u6811\u4f7f\u7528 4,699 \u4e2a\u6837\u672c\u7f51\u683c\u5355\u5143\u521b\u5efa\uff0c\u5e76\u4f7f\u7528\u6765\u81ea\u4e8e<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen \u6811\u6728\u8986\u76d6\u3001\u6811\u6728\u8986\u76d6\u589e\u52a0\u3001\u6811\u6728\u8986\u76d6\u635f\u5931</a>\u3001<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">NASA \u706b\u707e</a>\u3001<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5168\u7403\u571f\u5730\u8986\u76d6</a>\u4ee5\u53ca<a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4eba\u53e3\u7edf\u8ba1</a>\u7684\u5ea6\u91cf\u3002\u4e3a\u6bcf\u4e2a\u56e0\u7d20\u548c\u6bcf\u4e2a\u5730\u533a\uff08\u5317\u7f8e\u3001\u5357\u7f8e\u3001\u6b27\u6d32\u3001\u975e\u6d32\u3001\u6b27\u4e9a\u5927\u9646\u3001\u4e1c\u5357\u4e9a\u3001\u5927\u6d0b\u6d32\uff09\u521b\u5efa\u4e86\u5355\u72ec\u7684\u51b3\u7b56\u6811\uff0c\u5171\u6709 35 \u4e2a\u51b3\u7b56\u6811\u3002\u6700\u540e\u7684\u8f93\u51fa\u88ab\u7ec4\u5408\u6210\u5168\u7403\u5730\u56fe\uff0c\u7136\u540e\u7528\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u8986\u76d6\u8be5\u5730\u56fe\uff0c\u4ee5\u663e\u793a\u4e0e\u4e16\u754c\u5404\u5730\u6bcf\u4e2a\u56e0\u7d20\u76f8\u5173\u7684\u635f\u5931\u5f3a\u5ea6\u3002", "694bbe5f7b714162ba4c7f70f8ab481b": "\u5168\u7403\uff0c\u539f\u578b\u6570\u636e\u9ad8\u4e8e 52\u00b0N", "5e97abd1f731bf640f385ac5cf7f0023": "\u6240\u6709\u6a21\u578b\u4ee3\u7801\u3001\u53c2\u8003\u6837\u672c\u3001\u51b3\u7b56\u6811\u548c\u6700\u7ec8\u6a21\u578b\u90fd\u53ef\u4ee5\u5728\u672c\u6587\u7684\u8865\u5145\u6750\u6599\u4e2d\u627e\u5230\u3002", "af885f477784c15ddfba82395abac491": "\u65b0\u5174\u70ed\u70b9", "9c083db2f72b5b6a8f8350931e8d00a9": "\u4ece\u56fd\u5bb6\u5c42\u9762\u786e\u5b9a\u663e\u8457\u7684\u539f\u751f\u6797\u635f\u5931\u805a\u7c7b", "a4642652d9490757e5e2e667760a6944": "\u70ed\u5e26\u5730\u533a", "c4c696d78d97d24ce69ebe19fd7f8483": "\u6bcf\u5e74", "56a18f7ea20fd39e010ddd3852b15162": "\u6b64\u5206\u6790\u9488\u5bf9\u7684\u662f\u4e2a\u522b\u56fd\u5bb6/\u5730\u533a\uff0c\u56e0\u6b64\u7ed3\u679c\u662f\u76f8\u5bf9\u4e8e\u6bcf\u4e2a\u56fd\u5bb6/\u5730\u533a\u7684\u51cf\u5c11\u6a21\u5f0f\u548c\u6570\u91cf\u3002\u4e0d\u5e94\u8be5\u5728\u56fd\u5bb6/\u5730\u533a\u4e4b\u95f4\u76f4\u63a5\u6bd4\u8f83\u7ed3\u679c\u2014\u2014\u8bf7\u5728\u67e5\u770b\u5168\u7403\u8303\u56f4\u7684\u56fe\u5c42\u65f6\u8c28\u614e\u4ece\u4e8b", "a54e7328535d3d87ce6e3589c19e3855": "\u7531\u4e8e\u5168\u7403\u68ee\u6797\u76d1\u6d4b\u6570\u636e\u6e90\u7684\u89c4\u6a21\u548c\u590d\u6742\u6027\u4e0d\u65ad\u589e\u52a0\uff0c\u5bf9\u6b64\u7c7b\u6570\u636e\u7684\u5206\u6790\u548c\u8bf4\u660e\u5de5\u5177\u4e4b\u4e8e\u5e72\u9884\u5de5\u4f5c\u7684\u91cd\u8981\u6027\u4e5f\u65e5\u76ca\u63d0\u9ad8\uff0c\u56e0\u5176\u53ef\u4ee5\u5feb\u901f\u8bc6\u522b\u548c\u8bf4\u660e\u91cd\u5927\u68ee\u6797\u635f\u5931\u3002\u65b0\u5174\u7684\u70ed\u70b9\u5730\u533a\u6570\u636e\u96c6\u786e\u5b9a\u4e86 2002 \u5e74\u81f3 2020 \u5e74\u95f4\u56fd\u5bb6\u7ea7\u3001\u70ed\u5e26\u8303\u56f4\u5185\u6700\u91cd\u5927\u7684\u539f\u59cb\u68ee\u6797\u6d41\u5931\u96c6\u7fa4\u3002\u672f\u8bed\u201c\u70ed\u70b9\u5730\u533a\u201d\u88ab\u5b9a\u4e49\u4e3a\u5728\u68ee\u6797\u6d41\u5931\u7684\u7a7a\u95f4\u6a21\u5f0f\u4e2d\u8868\u73b0\u51fa\u7edf\u8ba1\u4e0a\u663e\u7740\u805a\u7c7b\u7684\u533a\u57df\u3002\u5728\u8be5\u5206\u6790\u4e2d\uff0c\u89c2\u5bdf\u5230\u7684\u539f\u59cb\u68ee\u6797\u6d41\u5931\u6a21\u5f0f\u53ef\u80fd\u5f52\u56e0\u4e8e\u6f5c\u5728\u7684\u800c\u975e\u968f\u673a\u7684\u7a7a\u95f4\u8fc7\u7a0b\u3002\u4e0d\u540c\u7c7b\u522b\u7684\u591a\u53d1\u5730\u533a\u5982\u4e0b\u6240\u8ff0\uff1a<br>- <strong>\u65b0\u7684</strong>\uff1a\u4ec5\u5728 2020 \u5e74\u5728\u7edf\u8ba1\u4e0a\u53ef\u79f0\u4e3a\u70ed\u70b9\u4e14\u4e4b\u524d\u4ece\u672a\u6210\u4e3a\u70ed\u70b9\u7684\u4f4d\u7f6e\u3002<br>- <strong>\u96f6\u661f</strong>\uff1a\u4e00\u4e2a\u65f6\u65ad\u65f6\u7eed\u7684\u70ed\u70b9\u5730\u533a\u300219 \u5e74\u4e2d\u6709\u5c11\u4e8e 18 \u5e74\u88ab\u79f0\u4e3a\u7edf\u8ba1\u610f\u4e49\u4e0a\u7684\u70ed\u70b9\u5730\u533a\u3002<br>- <strong>\u52a0\u5267</strong>\uff1a\u4e00\u4e2a\u5730\u533a\u5728 19 \u5e74\u4e2d\u6709 17 \u5e74\u4ee5\u4e0a\u6210\u4e3a\u7edf\u8ba1\u610f\u4e49\u91cd\u5927\u7684\u70ed\u70b9\u5730\u533a (&gt;90% )\uff0c\u4e14\u5305\u62ec\u6700\u8fd1\u4e00\u5e74\uff082020 \u5e74\uff09\u3002\u6b64\u5916\uff0c\u6bcf\u5e74\u9ad8\u8ba1\u6570\u7684\u805a\u96c6\u5f3a\u5ea6\u90fd\u5728\u589e\u52a0\u3002<br>- <strong>\u6301\u7eed</strong>\uff1a\u5728 19 \u5e74\u6709\u4e2d\u8d85\u8fc7 17 \u5e74\u4e00\u76f4\u662f\u7edf\u8ba1\u4e0a\u663e\u7740\u70ed\u70b9\u7684\u4f4d\u7f6e\uff08&gt; 90%\uff09\uff0c\u6ca1\u6709\u660e\u663e\u7684\u8d8b\u52bf\u8868\u660e\u805a\u7c7b\u5f3a\u5ea6\u968f\u65f6\u95f4\u589e\u52a0\u6216\u51cf\u5c11\u3002<br>- <strong>\u51cf\u5c11</strong>\uff1a\u5728 19 \u5e74\u6709\u4e2d\u8d85\u8fc7 17 \u5e74\u4e00\u76f4\u662f\u7edf\u8ba1\u4e0a\u663e\u7740\u70ed\u70b9\u7684\u4f4d\u7f6e\uff08&gt;90%\uff09\u3002\u6b64\u5916\uff0c\u6bcf\u5e74\u9ad8\u8ba1\u6570\u7684\u805a\u7c7b\u5f3a\u5ea6\u90fd\u5728\u4e0b\u964d\uff0c\u6216\u8005\u6700\u8fd1\u4e00\u5e74\uff082020 \u5e74\uff09\u4e0d\u518d\u5c5e\u4e8e\u70ed\u70b9\u5730\u533a\u3002<br>\u65b0\u5174\u70ed\u70b9\u5206\u6790\u4f7f\u7528 Hansen et al 2013 \u57282002 \u5e74\u81f3 2020 \u5e74\u8fdb\u884c\u7684\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u96c6\u6c47\u7f16\u3001urubanova et al. 2018 \u8fdb\u884c\u7684 2001 \u5e74\u539f\u59cb\u68ee\u6797\u8303\u56f4\u6570\u636e\u96c6\uff0c\u4ee5\u53ca ESRI ArcGIS \u65b0\u5174\u70ed\u70b9\u5206\u6790\u5730\u7406\u5904\u7406\u5de5\u5177\u3002\u5728\u672c\u5206\u6790\u4e2d\uff0c\u539f\u59cb\u68ee\u6797\u88ab\u5b9a\u4e49\u4e3a\u5728\u8fd1\u4ee3\u5386\u53f2\u4e0a\u672a\u5b8c\u5168\u6e05\u9664\u3001\u672a\u7ecf\u5386\u518d\u751f\u7684\u6210\u719f\u7684\u5929\u7136\u6f6e\u6e7f\u70ed\u5e26\u68ee\u6797\u8986\u76d6\u533a\u3002\u68ee\u6797\u6d41\u5931\u88ab\u5b9a\u4e49\u4e3a\u201c\u6797\u5206\u8fed\u4ee3\u5e72\u6270\u201d\uff0c\u6216\u5728 Landsat \u50cf\u7d20\u5c3a\u5ea6\u4e0a\u5b8c\u5168\u4e27\u5931\u6811\u6728\u8986\u76d6\u51a0\u5c42\u3002\u65b0\u5174\u70ed\u70b9\u5206\u6790\u5de5\u5177\u7ed3\u5408\u4f7f\u7528\u4e86\u4e24\u79cd\u7edf\u8ba1\u91cf\u5ea6\uff1aGetis-Ord Gi* \u7edf\u8ba1\u91cf\u6765\u8bc6\u522b\u68ee\u6797\u6d41\u5931\u7684\u7a7a\u95f4\u805a\u96c6\u4f4d\u7f6e\u548c\u7a0b\u5ea6\uff0c\u4ee5\u53ca Mann-Kendall \u8d8b\u52bf\u68c0\u9a8c\u6765\u8bc4\u4f30\u968f\u65f6\u95f4\u53d8\u5316\u7684\u65f6\u95f4\u8d8b\u52bf\u3002", "bdb39a119ae2fcd0b98c9044e529dfa0": "CCI \u63d0\u4f9b<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5168\u9762\u7cbe\u5ea6\u8bc4\u4f30</a>\u3002\u901a\u5e38\uff0c\u571f\u5730\u8986\u76d6\u7c7b\u522b\uff0c\u5982\u65f1\u4f5c\u519c\u7530\u3001\u704c\u6e89\u519c\u7530\u3001\u9614\u53f6\u5e38\u7eff\u6797\u3001\u57ce\u533a\u3001\u88f8\u5730\u3001\u6c34\u4f53\u548c\u6c38\u4e45\u79ef\u96ea\u7b49\uff0c\u53ef\u4ee5\u51c6\u786e\u7ed8\u5236\u3002\u53e6\u4e00\u65b9\u9762\uff0c\u5730\u8863\u3001\u82d4\u85d3\u3001\u7a00\u758f\u690d\u88ab\u548c\u6de1\u6c34\u6cbc\u6cfd\u68ee\u6797\u7b49\u7c7b\u522b\u53ef\u80fd\u4f1a\u53d7\u5230\u8bef\u5dee\u7684\u5f71\u54cd\u3002\n", "671c6b94f7bcbdcfc595d8175e681699": "\u6b64\u5206\u6790\u4e2d\u4f7f\u7528\u7684\u68ee\u6797\u51cf\u5c11\u6570\u636e\u5728\u6574\u4e2a\u70ed\u5e26\u751f\u7269\u7fa4\u843d\u4e2d\u7684\u4f7f\u7528\u7cbe\u5ea6\u4e3a 87%\uff0c\u5236\u4f5c\u7cbe\u5ea6\u4e3a 83.1%\u3002\u6b64\u5916\uff0c\u7531\u4e8e\u6b64\u5206\u6790\u9488\u5bf9\u7684\u662f\u4e2a\u522b\u56fd\u5bb6/\u5730\u533a\uff0c\u56e0\u6b64\u7ed3\u679c\u662f\u76f8\u5bf9\u4e8e\u6bcf\u4e2a\u56fd\u5bb6/\u5730\u533a\u7684\u51cf\u5c11\u6a21\u5f0f\u548c\u6570\u91cf\u3002\u4e0d\u5e94\u8be5\u5728\u56fd\u5bb6/\u5730\u533a\u4e4b\u95f4\u76f4\u63a5\u6bd4\u8f83\u7ed3\u679c\u2014\u2014\u8bf7\u5728\u67e5\u770b\u5168\u7403\u8303\u56f4\u7684\u56fe\u5c42\u65f6\u8c28\u614e\u4ece\u4e8b\u3002", "9f0b35c6055a75ef21952b0ad79d7656": "\u5927\u7ea6 1:1,000,000", "a20a0ed9d2fe668b2251b9bd1a47af94": "\u672c\u6570\u636e\u53ef\u7528\u4e8e\u8bc4\u4f30\u68ee\u6797\u5b8c\u6574\u5ea6\u3001\u53d8\u66f4\u3001\u4ee5\u53ca\u5168\u7403\u548c\u533a\u57df\u5c3a\u5ea6\u4e0a\u7684\u9000\u5316\u3002", "6b3af8639d01219fdf683456a2a3f348": "\u5168\u7403\u68ee\u6797\u9ad8\u5ea6\u56fe\u662f\u4e00\u4e2a\u539f\u578b\u4ea7\u54c1\uff0c\u5b58\u5728\u4e0e GEDI \u6570\u636e\u8d28\u91cf\u548c Landsat \u6570\u636e\u53ef\u7528\u6027\u76f8\u5173\u7684\u5df2\u77e5\u95ee\u9898\u3002 GEDI \u6570\u636e\u8fc7\u9ad8\u5730\u4f30\u8ba1\u4e86\u6e29\u5e26\u548c\u4e9a\u70ed\u5e26\u5c71\u5730\u8349\u539f\u659c\u5761\u4e0a\u7684\u68ee\u6797\u9ad8\u5ea6\uff0c\u4f8b\u5982\u5728\u65b0\u897f\u5170\u548c\u83b1\u7d22\u6258\u3002\u7531\u4e8e GEDI \u6570\u636e\u5b58\u5728\u533a\u5206\u690d\u88ab\u9ad8\u5ea6\u548c\u4eba\u9020\u7269\u4f53\u9ad8\u5ea6\u7684\u95ee\u9898\uff0c\u57ce\u5e02\u548c\u90ca\u533a\u7684\u6811\u6728\u9ad8\u5ea6\u53ef\u80fd\u4e0e\u5efa\u7b51\u7269\u9ad8\u5ea6\u6df7\u6dc6\u3002 GEDI \u6821\u51c6\u7684\u4e0d\u786e\u5b9a\u6027\uff08\u7279\u522b\u662f\u5730\u7406\u5b9a\u4f4d\u7cbe\u5ea6\u548c\u5730\u8868\u9ad8\u5ea6\u4f30\u8ba1\uff09\u53ef\u80fd\u662f\u9020\u6210\u67d0\u4e9b\u5730\u56fe\u8bef\u5dee\u7684\u539f\u56e0\u3002\u6811\u9ad8\u6a21\u578b\u7684\u6700\u5927\u53d6\u503c\u4e3a 30m\uff0c\u53ef\u80fd\u65e0\u6cd5\u5145\u5206\u6db5\u76d6\u6700\u9ad8\u6811\u6728\u7684\u9ad8\u5ea6\u3002\u5168\u7403\u4ea7\u54c1\u5c06\u5728\u672a\u6765\u8fdb\u884c\u66f4\u65b0\u4ee5\u89e3\u51b3\u5927\u90e8\u5206\u95ee\u9898\u3002", "346e3e0b229773026434bd99eba2aee8": "\u901a\u8fc7\u6574\u5408<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Global Ecosystem Dynamics Investigation</a> (GEDI) \u6fc0\u5149\u96f7\u8fbe\u68ee\u6797\u7ed3\u6784\u6d4b\u91cf\u548c Landsat \u53ef\u76f4\u63a5\u5206\u6790\u7684\u6570\u636e\u65f6\u95f4\u5e8f\u5217\uff0c\u5f00\u53d1\u4e86\u6b64\u5168\u65b0\u7684 30 m\u7a7a\u95f4\u5206\u8fa8\u7387\u5168\u7403\u68ee\u6797\u51a0\u5c42\u9ad8\u5ea6\u56fe\u3002NASA GEDI \u662f\u4e00\u79cd\u661f\u8f7d\u6fc0\u5149\u96f7\u8fbe\u4eea\u5668\uff0c\u81ea 2019 \u5e74 4 \u6708\u8d77\u5728\u56fd\u9645\u7a7a\u95f4\u7ad9\u4e0a\u8fd0\u884c\u3002\u5b83\u63d0\u4f9b\u57fa\u4e8e\u70b9\u7684\u690d\u88ab\u7ed3\u6784\u6d4b\u91cf\uff0c\u6d4b\u91cf\u5305\u62ec\u5168\u7403 52\u00b0N \u81f3 52\u00b0S \u4e4b\u95f4\u7684\u68ee\u6797\u51a0\u5c42\u9ad8\u5ea6\u3002\u9a6c\u91cc\u5170\u5927\u5b66\u7684\u5168\u7403\u571f\u5730\u5206\u6790\u548c\u53d1\u73b0\u56e2\u961f (<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">UMD GLAD</a>) \u5c06\u8fc4\u4eca\u4e3a\u6b62\uff082019 \u5e74 4 \u6708\u81f3 10 \u6708\uff09\u53ef\u7528\u7684 GEDI \u6570\u636e\u4e0e 2019 \u5e74 Landsat \u53ef\u76f4\u63a5\u5206\u6790\u7684\u65f6\u95f4\u5e8f\u5217\u6570\u636e\uff08<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Landsat ARD</a>\uff09\u76f8\u6574\u5408\u3002GEDI RH95\uff0895% \u7684\u76f8\u5bf9\u9ad8\u5ea6\uff09\u5ea6\u91cf\u6807\u51c6\u88ab\u7528\u4e8e\u6821\u51c6\u6a21\u578b\u3002\u4ee3\u8868\u5730\u8868\u7269\u5019\u7684 Landsat \u591a\u65f6\u6001\u6307\u6807\u53ef\u4f5c\u4e3a\u5168\u7403\u68ee\u6797\u9ad8\u5ea6\u5efa\u6a21\u7684\u81ea\u53d8\u91cf\u3002\u5b9e\u65bd\u4e86\u201c\u79fb\u52a8\u7a97\u53e3\u201d\u5c40\u90e8\u6821\u51c6\u548c\u5e94\u7528\u56de\u5f52\u6811\u96c6\u6210\u6a21\u578b\uff0c\u4ee5\u786e\u4fdd\u9ad8\u8d28\u91cf\u7684\u68ee\u6797\u9ad8\u5ea6\u9884\u6d4b\u548c\u5168\u7403\u5730\u56fe\u4e00\u81f4\u6027\u3002\u8be5\u6a21\u578b\u5728\u5317\u65b9\u5730\u533a\uff08\u8d85\u51fa GEDI \u6570\u636e\u8303\u56f4\uff09\u8fdb\u884c\u5916\u63a8\uff0c\u4ee5\u521b\u5efa\u5168\u7403\u68ee\u6797\u9ad8\u5ea6\u539f\u578b\u56fe\u3002\n", "cb514c9845d6bc712980eeaf0faa5125": "2000 - 2016 \u5e74\u539f\u59cb\u68ee\u6797\u666f\u89c2", "1c7cf5320f01f0a1e38031fd806fdcac": "\u8303\u56f4\u4e0a\u7684\u7f29\u5c0f\uff0c2000\u20132013 \u5e74", "40a794c629654eccbda5afc6a877b498": "2013-2016 \u5e74\u7684\u51cf\u5c11\u91cf", "7a8daf1e21a334c9a2cca8f95d780afb": "\u8bc6\u522b\u4e86\u622a\u6b62\u5230 2016 \u5e74\u4e16\u754c\u4e0a\u6700\u540e\u7684\u4fdd\u6301\u5b8c\u6574\u672a\u88ab\u5206\u5272\u7684\u68ee\u6797\u666f\u89c2\uff0c\u9762\u79ef\u5927\u5230\u80fd\u591f\u4fdd\u5b58\u6240\u6709\u4e0e\u751f\u4ff1\u6765\u7684\u751f\u7269\u591a\u6837\u6027\u5e76\u4e14\u6ca1\u6709\u8ff9\u8c61\u8868\u660e\u6709\u4eba\u7c7b\u8fdb\u884c\u7684\u6539\u53d8\u3002\u8fd9\u4e00\u5c42\u4e5f\u5c55\u73b0\u4e86\u4ece 2000 \u5e74\u5230 2016 \u5e74\u5b8c\u6574\u7684\u68ee\u6797\u666f\u89c2\u8303\u56f4\u7684\u51cf\u5c11\u3002", "3ceceed7705c092b010d55e41bd8a45b": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u539f\u751f\u6797\u666f\u89c2</a>(IFL) \u6570\u636e\u96c6\u6807\u8bc6\u68ee\u6797\u5185\u5b8c\u6574\u7684\u81ea\u7136\u751f\u6001\u7cfb\u7edf\u533a\u57df\uff0c\u8fd9\u4e9b\u533a\u57df\u6ca1\u6709\u663e\u8457\u7684\u4eba\u7c7b\u6d3b\u52a8\u8ff9\u8c61\uff0c\u4e14\u8db3\u4ee5\u627f\u8f7d\u6240\u6709\u672c\u5730\u7269\u79cd\u7684\u751f\u7269\u591a\u6837\u6027\uff0c\u5305\u62ec\u5e7f\u57df\u5206\u5e03\u7269\u79cd\u7684\u53ef\u5b58\u6d3b\u65cf\u7fa4\u3002\u4e3a\u7ed8\u5236 IFL \u533a\u57df\u7684\u5730\u56fe\uff0c\u4e00\u7cfb\u5217\u9002\u7528\u5168\u7403\u3001\u53ef\u8f7b\u6613\u590d\u5236\u7684\u6807\u51c6\u5f97\u4ee5\u8bde\u751f\uff0c\u53ef\u590d\u5236\u6027\u4f7f\u5176\u80fd\u591f\u968f\u65f6\u95f4\u63a8\u79fb\u53cd\u590d\u8bc4\u4f30\u548c\u9a8c\u8bc1\u3002IFL \u533a\u57df\u88ab\u5b9a\u4e49\u4e3a\u4e0d\u53ef\u5206\u65ad\u7684\u666f\u89c2\uff0c\u9762\u79ef\u81f3\u5c11 50,000 \u516c\u9877\uff0c\u5bbd\u5ea6\u987b\u5927\u4e8e 10 \u5343\u7c73\u3002\u8fd9\u4e9b\u662f\u6839\u636e 2000 \u5e74\u9646\u5730\u536b\u661f\u5f71\u50cf\u7ed8\u5236\u800c\u6210\u3002", "b6b69cebb7421d22ad77d152db18d993": "\u4e16\u754c IFL \u5730\u56fe\u7531\u4e13\u5bb6\u5bf9\u9646\u5730\u536b\u661f\u56fe\u50cf\u7684\u89c6\u89c9\u8be0\u91ca\u6765\u521b\u5efa\u3002\u7531\u4e8e\u56fe\u50cf\u7684\u5206\u8fa8\u7387\u7684\u9650\u5236\u4ee5\u53ca\u7f3a\u5c11\u4e00\u4e9b\u5730\u533a\u571f\u5730\u4f7f\u7528\u7684\u8f85\u52a9\u4fe1\u606f\u7684\u7f3a\u4e4f\uff0c\u8be5\u5730\u56fe\u53ef\u80fd\u5305\u542b\u4e0d\u51c6\u786e\u7684\u5185\u5bb9\u3002\u6b64\u5916\uff0c\u8be5\u65b9\u6cd5\u5047\u8bbe\u5728\u63a5\u8fd1\u9053\u8def\u6216\u5176\u4ed6\u57fa\u7840\u8bbe\u65bd\u7684\u706b\u707e\u53ef\u80fd\u662f\u7531\u4eba\u7c7b\u9020\u6210\u7684\uff0c\u5e76\u4e14\u56e0\u6b64\u6784\u6210\u4eba\u4e3a\u5e72\u6270\u7684\u4e00\u79cd\u5f62\u5f0f\u3002\u8fd9\u79cd\u5047\u8bbe\u53ef\u80fd\u5bfc\u81f4 IFL \u5bf9\u5bd2\u5e26\u751f\u7269\u7fa4\u843d\u7684\u4f4e\u4f30\u3002", "f58c151291aa5190e79b0f4ff7be0e26": "\u4f7f\u7528\u7ea6 15,000 \u4e2a\u9646\u5730\u536b\u661f\u573a\u666f\u548c 1500 \u4e2a ALOS PALSAR\uff081 x 1 \u5ea6\uff09\u9a6c\u8d5b\u514b\u5408\u6210\u5149\u5b66\u548c\u96f7\u8fbe\u56fe\u50cf\uff0c\u8986\u76d6\u4e86\u7f8e\u6d32\u3001\u975e\u6d32\u3001\u4e9a\u6d32\u548c\u5927\u6d0b\u6d32\u70ed\u5e26\u548c\u4e9a\u70ed\u5e26\u6d77\u5cb8\u7ebf\u533a\u57df\u3002", "cde1349838c1243808f54cc6e9b95bb7": "2000 \u5e74 IFL \u7684\u8fb9\u754c\u5185\u8bc6\u522b\u51fa\u4e86 IFL \u5728\u4e00\u5b9a\u7a0b\u5ea6\u4e0a\u7684\u6539\u53d8\uff0c\u8bc6\u522b\u8fc7\u7a0b\u4e2d\u4f7f\u7528\u4e86\u5168\u7403 Landsat \u56fe\u50cf\u5168\u8986\u76d6\uff0c\u590d\u5408\u4e86 2016 \u5e74\u548c\u5168\u7403\u68ee\u6797\u8986\u76d6\u635f\u5931\u6570\u636e\u96c6\uff08Hansen \u7b49\u4eba\uff0c2016\uff09\u3002\u88ab\u8bc6\u522b\u4e3a\u201c\u4e00\u5b9a\u7a0b\u5ea6\u7684\u51cf\u5c11\u201c\u7684\u5730\u533a\u7b26\u5408 IFL 2000 \u5e74\u7684\u6807\u51c6\uff0c\u4f46\u4e0d\u518d\u7b26\u5408 2013 \u5e74\u7684\u6807\u51c6\u3002\u53d8\u5316\u7684\u4e3b\u8981\u539f\u56e0\u662f\u4e3a\u4e86\u519c\u4e1a\u548c\u4eba\u5de5\u6797\u800c\u8fdb\u884c\u7684\u6e05\u7406\u3001\u5de5\u4e1a\u884c\u4e3a\u6bd4\u5982\u780d\u4f10\u548c\u91c7\u77ff\u3001\u56e0\u4e3a\u57fa\u7840\u8bbe\u65bd\u548c\u65b0\u7684\u9053\u8def\u6240\u9020\u6210\u7684\u5206\u5272\u4ee5\u53ca\u4eba\u4e3a\u9020\u6210\u7684\u706b\u707e\u3002", "2a6d73e17ee0f72647543aafb5f6cd33": "\u4e3a\u4e86\u786e\u4fdd\u9010\u5e74\u7684\u4e00\u81f4\u6027\uff0c\u6bcf\u5e74\u7684\u571f\u5730\u8986\u76d6\u56fe\u90fd\u662f\u4ece\u5355\u4e2a\u57fa\u51c6\u571f\u5730\u8986\u76d6\u56fe\u5f97\u51fa\u7684\u3002\u57fa\u7ebf\u56fe\u662f\u4f7f\u75282003\u5e74\u81f32012\u5e74\u7684MERIS\u56fe\u50cf\u7684\u5b8c\u6574\u8bb0\u5f55\uff0c\u65e0\u76d1\u7763\u5206\u7c7b\uff0c\u4ee5\u53ca\u591a\u5e74\u56fe\u50cf\u7684\u673a\u5668\u5b66\u4e60\u7b97\u6cd5\u521b\u5efa\u7684\u3002\u7136\u540e\uff0c\u4f7f\u75281992\u5e74\u81f31999\u5e74\u7684AVHRR\u6570\u636e\uff0c1999\u5e74\u81f32013\u5e74\u7684SPOT-VGT\u6570\u636e\uff0c2014\u5e74\u548c2015\u5e74\u7684PROVA-V\u6570\u636e\uff0c\u4ee51 km\u7684\u5206\u8fa8\u7387\u68c0\u6d4b\u5404\u4e2a\u5e74\u4efd\u4e4b\u95f4\u7684\u53d8\u5316\u3002\u4e3a\u4e86\u8fde\u7eed\u8ba1\u7b97\u53d8\u5316\uff0c\u5fc5\u987b\u8fde\u7eed\u4e24\u5e74\u4fdd\u6301\u4e00\u81f4\uff0c\u4f462014\u5e74\u548c2015\u5e74\u7684\u68ee\u6797\u53d8\u5316\u9664\u5916\uff0c\u56e0\u4e3a\u6211\u4eec\u8ba4\u4e3a\u8fd9\u4e9b\u53d8\u5316\u80fd\u88ab\u5f88\u597d\u5730\u8bc6\u522b\u3002\u7136\u540e\u5c061km\u7684\u53d8\u5316\u4e0e\u57fa\u7ebf\u571f\u5730\u8986\u76d6\u56fe\u5408\u5e76\uff0c\u5e76\u57282004\u5e74\u4ee5\u540e\u5212\u5b9a\u4e3a300\u7c73\uff08\u5f53MERIS\u548cPROVA-V\u6570\u636e\u53ef\u7528\u65f6\uff09\u3002", "43daeee0d1a4e8325acb6c9d6d486bbe": "\u5c06\u68ee\u6797\u72b6\u51b5\u663e\u793a\u4e3a\u7531\u4eba\u4e3a\u5e72\u9884\u7a0b\u5ea6\u786e\u5b9a\u7684\u8fde\u7eed\u6307\u6570", "1e7f2299cf5bd5effaa1d8dead4853ad": "\u68ee\u6797\u5e95\u56fe\u6cbf\u7528\u4e8e\u5168\u7403\u68ee\u6797\u8986\u76d6\uff08Global Forest Cover\uff09\u7684\u7ed3\u679c <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\uff08Hansen et. al. 2013\uff09</a>\uff0c\u56e0\u6b64\u5305\u62ec\u201c\u5929\u7136\u201d\u68ee\u6797\u548c\u4eba\u5de5\u6797\u3002\u5b83\u4f7f\u7528 20% \u7684\u51a0\u5c42\u8986\u76d6\u9608\u503c\u5e76\u91cd\u65b0\u91c7\u6837\u5230 300 m\u3002\u6b64\u56fe\u6db5\u76d6\u88ab <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Curtis et al. (2018)</a>\u5f52\u7c7b\u4e3a\u4e34\u65f6\u6027\u7684 2000-2019 \u5e74\u68ee\u6797\u6d41\u5931\uff0c\u5373\u8f6e\u4f5c\u6797\u548c\u8f6e\u57a6\u7528\u5730\u7ee7\u7eed\u88ab\u89c6\u4e3a\u68ee\u6797\uff0c\u4f46\u56e0\u5176\u6240\u7ecf\u5386\u7684\u4eba\u4e3a\u5e72\u9884\u800c\u53d7\u5230\u76f8\u5e94\u7684\u635f\u5bb3\u3002\u6620\u50cf\u6240\u6807\u8bb0\u7684\u4eba\u4e3a\u5e72\u9884\u6c34\u5e73\u662f\u4fdd\u5b88\u7684\uff1b\u4f8b\u5982\uff0c\u6ca1\u6709\u5c06\u706b\u707e\u89c6\u4e3a\u4eba\u4e3a\u5f71\u54cd\uff08\u56e0\u4e3a\u5728\u67d0\u4e9b\u7cfb\u7edf\u4e2d\u591a\u53d1\u81ea\u7136\u706b\u707e\uff09\uff0c\u5e76\u4e14\u6ca1\u6709\u6355\u6349\u5230\u6c14\u5019\u53d8\u5316\u7684\u5f71\u54cd\u3002\u5e76\u975e\u6240\u6709\u6cbb\u7406\u6c34\u5e73\u7684\u5730\u7406\u5dee\u5f02\u7684\u5f71\u54cd\u90fd\u5f97\u5230\u4f53\u73b0\u3002\u6b63\u5728\u5f00\u53d1\u5728\u7ebf\u5de5\u5177\uff0c\u4ee5\u4f7f\u7528\u6237\u80fd\u591f\u6839\u636e\u66f4\u591a\u5f53\u5730\u60c5\u51b5\u8c03\u6574\u5168\u7403\u5047\u8bbe\u3001\u6743\u91cd\u548c\u6807\u51c6\uff08\u4f8b\u5982\u68ee\u6797\u7684\u5b9a\u4e49\u3001\u706b\u707e\u5904\u7406\uff09\u3002\u5176\u4ed6\u8b66\u793a\u53ef\u4ee5\u5728\u8bba\u6587\u4e2d\u627e\u5230\u3002\u672c\u6587\u5c06\u8fde\u7eed\u53d8\u91cf\u5206\u7c7b\u4e3a\u9ad8\u3001\u4e2d\u3001\u4f4e\u68ee\u6797\u5b8c\u6574\u6027\u7684\u8bf4\u660e\u6027\u7c7b\u522b\uff0c\u4ee5\u5df2\u77e5\u4f4d\u7f6e\u4e3a\u57fa\u51c6\uff1a\u5f97\u5206 \u22659.6 \u4e3a\u9ad8\u5b8c\u6574\u6027\uff0c\u4e2d\u7b49\u5b8c\u6574\u6027\u5f97\u5206\u4f4d\u4e8e 6.0 \u81f3 9.6\uff0c\u5f97\u5206 \u22646.0 \u4e3a\u4f4e\u5b8c\u6574\u6027\u3002", "76a951b8d0c498047757c2bd1e552fb4": "\u4e3a\u751f\u6210\u68ee\u6797\u666f\u89c2\u5b8c\u6574\u6027\u6307\u6570 (FLII)\uff0c\u6b64\u5904\u5c06\u56db\u4e2a\u6570\u636e\u96c6\u7ec4\u5408\u5728\u4e00\u8d77\uff0c\u5206\u522b\u4ee3\u8868\uff1a(i) \u68ee\u6797\u8303\u56f4\uff1b (ii) \u201c\u53ef\u89c2\u6d4b\u5230\u7684\u201d\u5b58\u5728\u7a7a\u95f4\u6570\u636e\u96c6\u7684\u9ad8\u5ea6\u5f71\u54cd\u3001\u5c40\u90e8\u4eba\u7c7b\u6d3b\u52a8\u7684\u538b\u529b\uff0c\u7279\u522b\u662f\uff1a\u57fa\u7840\u8bbe\u65bd\u3001\u519c\u4e1a\u548c\u8fd1\u671f\u7684\u68ee\u6797\u780d\u4f10\uff1b (iii) \u4e0e\u8fb9\u7f18\u6548\u5e94\u548c\u5176\u4ed6\u6269\u6563\u8fc7\u7a0b\u76f8\u5173\u7684\u201c\u63a8\u5b9a\u201d\u538b\u529b\uff0c\uff08\u4f8b\u5982\u72e9\u730e\u548c\u9009\u62e9\u6027\u4f10\u6728\u7b49\u6d3b\u52a8\uff09\uff0c\u5c06\u5176\u6309\u7167\u4e0e\u53ef\u89c2\u6d4b\u5230\u7684\u538b\u529b\u7684\u8fd1\u4f3c\u6027\u5efa\u6a21\uff1b iv)\u4eba\u4e3a\u9020\u6210\u7684\u68ee\u6797\u6d41\u5931\u6240\u5bfc\u81f4\u7684\u5bf9\u68ee\u6797\u8fde\u901a\u6027\u7684\u5f71\u54cd\u3002\u6574\u5408\u4ee5\u4e0a\u6570\u636e\u96c6\u5e76\u4e3a\u6bcf\u4e2a\u68ee\u6797\u50cf\u7d20\uff08300m\uff09\u751f\u6210\u4e00\u4e2a\u6307\u6570\u5206\u6570\uff0c\u6700\u9ad8\u5206\u6570\u53cd\u6620\u4e86\u6700\u9ad8\u7684\u68ee\u6797\u5b8c\u6574\u6027\uff0c\u5e76\u5e94\u7528\u4e8e 2019 \u5e74\u521d\u7684\u68ee\u6797\u8303\u56f4\u3002\u5168\u7403\u4e00\u81f4\u7684\u53c2\u6570\u88ab\u7528\u4e8e\u6240\u6709\u5143\u7d20\uff08\u4e0d\u56e0\u5730\u57df\u800c\u5f02\u7684\u53c2\u6570\uff09\u3002 \u6240\u6709\u8ba1\u7b97\u5747\u5728 Google Earth Engine \u4e2d\u8fdb\u884c\u3002", "023700e1b1259340ef4f56482df4d173": "2015 \u5e74\u571f\u5730\u8986\u76d6", "8e54e9aa508ea37f7fe734e86ba9da27": "\u519c\u4e1a", "ac12ee4aedb176eb73ce3f6c0d1e9036": "\u68ee\u6797", "d4e3b74fb352a9f0977f9b86258daddb": "\u8349\u539f", "1738a24d91279bf7b4992f9e84fd62f4": "\u7ed3\u679c\u6570\u636e\u5171\u670922\u79cd\u5168\u7403\u571f\u5730\u8986\u76d6\u7c7b\u522b\u3002\u4e3a\u4e86\u5b9e\u73b0\u66f4\u597d\u5730\u53ef\u89c6\u5316\uff0cGlobal Forest Watch\u4ec5\u6839\u636eIPCC\uff08\u519c\u4e1a\uff0c\u68ee\u6797\uff0c\u8349\u539f\uff0c\u6e7f\u5730\uff0c\u5b9a\u5c45\u70b9\uff0c\u704c\u6728\u4e1b\uff0c\u7a00\u758f\u690d\u88ab\uff0c\u88f8\u9732\u533a\u57df\uff0c\u6c34\u548c\u6c38\u4e45\u6027\u51b0\u96ea\uff09\u663e\u793a\u4e00\u7ec4\u7b80\u5316\u7684\u5206\u7c7b\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">ESA/CCI\u67e5\u770b\u5668</a>\u63d0\u4f9b\u4e86\u5b8c\u6574\u7684\u5206\u7c7b\u96c6\uff0c\u4ee5\u53ca\u65e9\u81f31992\u5e74\u7684\u5e74\u5ea6\u571f\u5730\u8986\u76d6\u56fe\u3002", "02e89f9921419a94e1ace6a1d24527ec": "\u704c\u6728\u5730", "1ad88980594bc2dfaafdbb3a2981a25a": "\u7a00\u758f\u7684\u690d\u88ab", "a585e582cd0441f88d3b0aaa10790112": "\u6e7f\u5730", "1610f44571feba48aa8a30a8112a06fe": "\u6c89\u964d", "1a46b4cdebd891663bff56824736236c": "\u88f8\u9732", "27634ff8002b12e75d98e07ccd005d18": "\u6c34", "6b9d737f41511e364b9b6b3f45f9868c": "\u9a6c\u8d5b\u514b\u666f\u89c2\uff08TML\uff09\u6570\u636e\u4e2d\u7684\u6811\u6728\u4ee5 10 \u7c73\u7684\u6bd4\u4f8b\u7ed8\u5236\u4e86\u6811\u6728\u8303\u56f4\uff0c\u5e76\u80fd\u591f\u51c6\u786e\u76d1\u6d4b\u57ce\u5e02\u5730\u533a\u3001\u519c\u7530\u4ee5\u53ca\u5f00\u9614\u7684\u6811\u51a0\u548c\u5e72\u71e5\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u4e2d\u7684\u6811\u6728\u3002\u6570\u636e\u8303\u56f4\u6db5\u76d6\u62c9\u4e01\u7f8e\u6d32\u548c\u975e\u6d32 14 \u4ebf\u516c\u9877\u7684\u9a6c\u8d5b\u514b\u666f\u89c2\u3002\u9a6c\u8d5b\u514b\u666f\u89c2\u88ab\u5b9a\u4e49\u4e3a\u53ef\u4ee5\u652f\u6301\u591a\u79cd\u6811\u6728\u5206\u5e03\u7684\u533a\u57df\uff0c\u5305\u62ec\u7a00\u758f\u7684\u6811\u6728\u8986\u76d6\u3001\u5206\u6563\u6216\u805a\u96c6\u7684\u5f00\u653e\u51a0\u5c42\u68ee\u6797\u4ee5\u53ca\u788e\u6563\u7684\u5c01\u95ed\u51a0\u5c42\u68ee\u6797\u3002", "c9858eb340b6ff6960494ff45da28a8a": "TML \u6839\u636e 2015 \u5e74\u6b27\u6d32\u822a\u5929\u5c40\uff08ESA\uff09\u6c14\u5019\u53d8\u5316\u5021\u8bae\uff08CCI\uff09300 \u7c73\u571f\u5730\u8986\u76d6\u4ea7\u54c1\u4e2d\u5df2\u6709\u7684\u571f\u5730\u8986\u76d6\u7b49\u7ea7\u5206\u5c42\u5b9a\u4e49\u4e86\u9a6c\u8d5b\u514b\u666f\u89c2\u3002\u5904\u7406\u8303\u56f4\u548c\u5206\u6790\u4f7f\u7528\u8fd9\u4e9b\u5206\u7c7b\u6765\u63d0\u53d6\u5173\u6ce8\u7684\u533a\u57df\uff0c\u56e0\u6b64\u4f1a\u53d7\u5230\u5176\u76f8\u5173\u9650\u5236\u548c\u9519\u8bef\u7684\u5f71\u54cd\u3002\u8fd9\u53ef\u80fd\u8868\u73b0\u4e3a\u5bf9\u5355\u4e2a 6 x 6 \u516c\u91cc\u65b9\u683c\u7684\u4e0d\u89c4\u5219/\u4e0d\u4e00\u81f4\u5904\u7406\u3002", "00985c2ae40edbb7444ec064e1292546": "\u5e38\u5e74\u51b0\u96ea", "6f1588c25dcdbb2d4592493840535bf6": "\u663e\u793a 2015 \u5e74\u5168\u7403\u571f\u5730\u690d\u88ab\u8986\u76d6\u5206\u5e03", "0e0fc9220b2e0e9aee29dfc70d417b12": "1 \u516c\u9877", "11475e396a76efaadbd5e03327a765df": "\u8be5\u6570\u636e\u96c6\u53ef\u4ee5\u5728 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">http://data.unep-wcmc.org/datasets/45</a> \u4e0b\u8f7d\u3002", "93ecfe8cb9bcf68c76835cee149057cf": "\u6bcf\u5e74\u5ea6\u7684\u9608\u503c\u662f\u6307\u4e30\u6536\u5e74\u3002\u4f8b\u5982\uff0c2001 \u5e74\u662f\u6307 2000-2001 \u5e74\u7684\u519c\u4e1a\u5b63\u3002", "fb2421ea6a65b4145351bdec0aa21957": "\u5728\u67d0\u4e9b\u60c5\u51b5\u4e0b\uff0cSentinel \u8f68\u9053\u4e4b\u95f4\u7684\u8fb9\u754c\u4f1a\u51fa\u73b0\u6570\u636e\u8d28\u91cf\u95ee\u9898\uff0c\u5176\u7eb5\u5411\u95f4\u9694\u4e3a 290 \u516c\u91cc\u3002\u7531\u4e8e Sentinel \u536b\u661f\u83b7\u53d6\u56fe\u50cf\u7684\u89d2\u5ea6\u4e0d\u540c\uff0c\u51a0\u5c42\u7684\u5f62\u72b6\u548c\u4eae\u5ea6\u53ef\u4ee5\u4e0d\u540c\u5730\u8868\u793a\uff0c\u4ece\u800c\u5bfc\u81f4\u51a0\u5c42\u5149\u8c31\u7279\u5f81\u7684\u9ad8\u5ea6\u53ef\u53d8\u6027\u3002\u8fd9\u4f7f\u5f97\u5229\u7528\u57fa\u4e8e\u5149\u8c31\u7279\u5f81\u7684\u7279\u6b8a\u7279\u5f81\u7684\u9065\u611f\u690d\u88ab\u6307\u6570\u6765\u6765\u533a\u5206\u82b1\u53f6\u690d\u88ab\u53d8\u5f97\u66f4\u52a0\u56f0\u96be\u3002\u6b64\u95ee\u9898\u4e3b\u8981\u5f71\u54cd\u90a3\u4e9b\u7528\u7b97\u6cd5\u6765\u5c1d\u8bd5\u533a\u5206\u5c01\u95ed\u51a0\u5c42\u704c\u6728\u7684\u533a\u57df\u4ee5\u53ca\u5c01\u95ed\u51a0\u5c42\u68ee\u6797\u7684\u533a\u57df\u3002", "c28bdedcd039fb0a7ed0482458f37662": "\u9760\u8fd1\u6bdb\u91cc\u5854\u5c3c\u4e9a\u5357\u90e8\u8fb9\u5883\u7684\u9a6c\u91cc", "faef159746c705ee39aa3c9176fec1ff": "82\u4e2a\u56fd\u5bb6", "7dc3f76f93af88cdfa80df1b5ad146c9": "\u6ce8\u610f\uff1a\u6b64\u6570\u636e\u96c6\u4e3a\u8349\u7a3f\u5f62\u5f0f\uff0c\u53ef\u80fd\u4f1a\u53d1\u751f\u53d8\u5316\u3002", "b4cd59ac7e646fa2344c575c58d3fcce": "TML \u6570\u636e\u4ecd\u4e3a\u8349\u6848\u4ea7\u54c1\uff0c\u672a\u6765\u90e8\u5206\u5730\u533a\u6570\u636e\u53ef\u80fd\u4f1a\u53d1\u751f\u53d8\u5316\u3002\u5728\u5176\u8349\u6848\u5f62\u5f0f\u4e2d\uff0c\u5f53\u4e0e Hansen et al. \uff082013\uff09\u7684\u6570\u636e\u4e00\u8d77\u4f7f\u7528\u65f6\uff0cTML \u4e3a\u9a6c\u8d5b\u514b\u548c\u975e\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u63d0\u4f9b\u514d\u8d39\u76d1\u6d4b\u6570\u636e\u3002\u7ed3\u5408<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. \uff082013\uff09</a>\u6570\u636e\uff0c\u5b9e\u73b0\u4e86\u5b8c\u5168\u8986\u76d6\uff0c\u56e0\u4e3a TML \u76ee\u524d\u4e0d\u8986\u76d6\u8349\u539f\u6216\u8302\u5bc6\u7684\u8fde\u7247\u68ee\u6797\u3002\u867d\u7136\u8be5\u6570\u636e\u96c6\u9002\u5f53\u5730\u6392\u9664\u4e86\u975e\u6811\u6728\u4f5c\u7269\uff0c\u4f8b\u5982\u8336\u3001\u7cd6\u3001\u9999\u8549\u4f5c\u7269\u548c\u4ed9\u4eba\u638c\uff0c\u4f46\u5b83\u76ee\u524d\u65e0\u6cd5\u533a\u5206\u4eba\u5de5\u6797\u6811\u6728\u548c\u975e\u4eba\u5de5\u6797\u6811\u6728\u3002", "9ac5752f5431d86542b701242078c5a1": "\u9760\u8fd1\u4e2d\u975e\u5171\u548c\u56fd\u8fb9\u754c\u7684\u82cf\u4e39\u4ee5\u53ca\u5357\u82cf\u4e39", "e418dbe413aa76acdea68767cbdb769a": "\u6a61\u80f6", "788d30760649ba5dae7f4eba0c30f7b8": "\u6728\u7ea4\u7ef4/\u6728\u6750", "3b26194b13edb91ea719ef5cbee8d5bd": "\u6c34\u679c", "95ea2b61c0e6ca28135853c71d124f0f": "\u66f4\u591a\u8be6\u7ec6\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6280\u672f\u8bf4\u660e</a>\u3002<br>\u9664\u4e2d\u56fd\u548c\u5df4\u5e03\u4e9a\u65b0\u51e0\u5185\u4e9a\u4ee5\u5916\uff0c\u6240\u6709\u56fd\u5bb6/\u5730\u533a\u5747\u53ef\u4e0b\u8f7d\u6570\u636e\u3002", "f1669327be72c352fc607c0e98cbbce7": "\u6309\u56fd\u5bb6\u66f4\u6539\u6bd4\u4f8b", "aab422acb3d2334a6deca0e1495745c2": "\u5357\u7f8e\u6d32", "38d48dd5955050f369a81925376dc1f3": "\u80af\u5c3c\u4e9a\u3001\u5766\u6851\u5c3c\u4e9a\u548c\u7d22\u9a6c\u91cc\u6cbf\u6d77\u7684\u90e8\u5206\u5730\u533a", "5c7d240ff5db5f8fd158cd4ba7b06a85": "\u5728\u9ad8\u7a7a\u95f4\u5206\u8fa8\u7387\u4e0b\u5bf9\u5927\u8c46\u6269\u5f20\u63d0\u4f9b\u4e86\u4e00\u4e2a\u957f\u671f\u7684\u3001\u5927\u9646\u6027\u7684\u89c6\u89d2", "52b71c2cde21c36f472d9890e743209c": "\u5927\u8c46\u79cd\u690d\u533a\u57df", "10000657491d165e6530833e3b4951a7": "1996 \u5e74\u81f3 2016 \u5e74\u7ea2\u6811\u6797\u5168\u7403\u8986\u76d6\u7387\uff08\u90e8\u5206\u5e74\u4efd\uff09", "64088185b149a68dd01af8e5cf2ed83b": "\u8fd1\u671f\u6e05\u7406", "67df8578b1df69e0653141015c29119f": "\u5df2\u79cd\u690d\u6811\u6728", "c91b72f250e07ef0f14584942d5c4f19": "SDPT\u7684\u201c\u79cd\u690d\u6811\u6728\u201d\u7c7b\u522b\u5305\u62ec\u901a\u8fc7\u4eba\u4e3a\u79cd\u690d\u6216\u64ad\u79cd\u5efa\u7acb\u7684\u672c\u5730\u6216\u5916\u6765\u7269\u79cd\u7684\u4eba\u5de5\u6797\uff0c\u6709\u65f6\u4e5f\u88ab\u79f0\u4e3a\u201c\u6797\u573a\u201d\u3002\u8fd9\u4e9b\u68ee\u6797\u4e3a\u5168\u7403\u7ecf\u6d4e\u6ce8\u5165\u4e86\u6e90\u6e90\u4e0d\u65ad\u7684\u5efa\u7b51\u7528\u6728\u6750\u3001\u9020\u7eb8\u7528\u7eb8\u6d46\u548c\u80fd\u6e90\u7528\u85aa\u6750\u3002\u8be5\u6570\u636e\u96c6\u8fd8\u5305\u62ec\u519c\u4f5c\u7269\u3001\u5982\u6cb9\u68d5\u79cd\u690d\u56ed\u3001\u725b\u6cb9\u679c\u519c\u573a\u3001\u82f9\u679c\u56ed\uff0c\u751a\u81f3\u5723\u8bde\u6811\u519c\u573a\u3002SDPT\u4f7f\u5f97\u6709\u53ef\u80fd\u5c06\u4eba\u5de5\u6797\u548c\u6811\u6728\u4f5c\u7269\u4e0e\u5929\u7136\u6797\u5206\u5f00\uff0c\u5e76\u80fd\u591f\u5728\u4e0d\u8003\u8651\u5168\u7403\u5929\u7136\u6797\u8986\u76d6\u53d8\u5316\u7684\u6761\u4ef6\u4e0b\u6765\u76d1\u6d4b\u8fd9\u4e9b\u79cd\u690d\u533a\u7684\u53d8\u5316\u3002", "2c2c3bb5cf4978507928191d215af7ce": "\u786e\u5b9a\u9009\u5b9a\u56fd\u5bb6\u7684\u4eba\u5de5\u6797\u548c\u6797\u6728\u4f5c\u7269\u3002", "64da4b2168492764e111a88846fc4ad1": "\u6b64\u6570\u636e\u96c6\u901a\u8fc7\u6269\u5927\u4ee5\u524d\u7684\u5927\u8c46\u79cd\u690d\u5730\u56fe\u7684\u7a7a\u95f4\u548c\u65f6\u95f4\u8303\u56f4\uff0c\u89e3\u51b3\u4e86\u7f3a\u4e4f\u957f\u671f\u7684\u3001\u4e00\u81f4\u7684\u653f\u5e9c\u7edf\u8ba1\u6570\u636e\u7684\u95ee\u9898\u3002Song \u7b49\u4eba(2021) \u63cf\u8ff0\u7684\u5730\u56fe\u548c\u5de5\u4f5c\u6d41\u4e3a\u8ddf\u8e2a\u5546\u54c1\u9a71\u52a8\u7684\u68ee\u6797\u780d\u4f10\u63d0\u4f9b\u4e86\u5173\u952e\u7684\u5386\u53f2\u57fa\u51c6\u4fe1\u606f\uff0c\u5e76\u7740\u91cd\u5f3a\u8c03\u4e86\u5927\u8c46\u6269\u5f20\u7684\u65b0\u5174\u70ed\u70b9\u3002", "1ae732df73e6bb195a0d3172172eeff5": "\u8be5\u5c42\u4ec5\u9002\u7528\u4e8e<span>\u7279\u5b9a\u56fd\u5bb6/\u5730\u533a\u3002</span>", "4737688c747b5a76b09ddd24dc792f3b": "\u4f7f\u7528\u7ea2\u6811\u6797\u6816\u606f\u5730\u7f69\u5c42\u5bf9\u5206\u7c7b\u8fdb\u884c\u4e86\u9650\u5236\uff0c\u8be5\u7f69\u5c42\u5b9a\u4e49\u4e86\u53ef\u80fd\u5b58\u5728\u7ea2\u6811\u6797\u751f\u6001\u7cfb\u7edf\u7684\u533a\u57df\u3002\u7ea2\u6811\u6797\u6816\u606f\u5730\u7684\u5b9a\u4e49\u57fa\u4e8e\u5730\u7406\u53c2\u6570\uff0c\u4f8b\u5982\u7eac\u5ea6\u3001\u6d77\u62d4\u548c\u8ddd\u6d77\u6c34\u7684\u8ddd\u79bb\u3002\u57fa\u4e8e<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\"> Giri\u7b49\u4eba\uff082011\u5e74\uff09</a>\u548c<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Spalding\u7b49\u4eba\uff082010\u5e74\uff09</a>\u4f7f\u7528\u7ea2\u6811\u6797\u7f69\u5c42\uff082000\u5e74\uff09\u5bf93800\u4e07\u70b9\u8fdb\u884c\u7684\u968f\u673a\u91c7\u6837\uff0c\u4ee5\u53ca<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Pekel\u7b49\u4eba</a>\u5b9a\u4e49\u7684\u6c34\u53d1\u751f\u5c42\uff0c\u5bf9\u6816\u606f\u5730\u7f69\u5c42\u548c2010\u5e74\u7ea2\u6811\u6797\u7f69\u5c42\u7684\u5206\u7c7b\u8fdb\u884c\u4e86\u8bad\u7ec3\u3002", "514989ed374f736825e9dc2dfade3e5c": "\u8be5\u7248\u672c\u6570\u636e\u96c6\uff08v2.0\uff09\u4e2d\u5df2\u77e5\u4e22\u5931\u7684\u533a\u57df\uff1a\u767e\u6155\u5927\uff08\u82f1\u56fd\uff09\uff1b \u6b27\u7f57\u5df4\u5c9b\uff08\u6cd5\u56fd\uff09\uff1b \u6590\u6d4e\uff0c\u4e1c\u7ecf 180\u00b0\u4ee5\u4e1c\uff1b \u5173\u5c9b\u548c\u585e\u73ed\u5c9b\uff08\u7f8e\u56fd\uff09\uff1b\u57fa\u91cc\u5df4\u65af\uff1b \u9a6c\u5c14\u4ee3\u592b\uff1b \u79d8\u9c81\uff0c\u5357\u7eac 4\u00b0\u4ee5\u5357\uff1b \u74e6\u5229\u65af\u7fa4\u5c9b\u548c\u5bcc\u56fe\u7eb3\u7fa4\u5c9b\uff08\u6cd5\u56fd\uff09\u3002", "c8ca4b8ee03140f745c5b70790da6d31": "\u5168\u7403\u7ea2\u6811\u6797\u8303\u56f4", "ec0789ec7232007e9027a5cfef7d1aee": "\u4ee5 10 \u7c73\u7684\u5c3a\u5ea6\u663e\u793a\u6811\u6728\u8303\u56f4\uff0c\u4ee5\u4fbf\u51c6\u786e\u76d1\u6d4b\u57ce\u5e02\u5730\u533a\u3001\u519c\u7530\u3001\u5f00\u9614\u7684\u6811\u51a0\u548c\u5e72\u71e5\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u4e2d\u7684\u6811\u6728", "dbea9d06e663c1482c40999bd95476ea": "\u6570\u636e\u751f\u6210\u8fc7\u7a0b\u4e2d\u4e0d\u4e00\u81f4\u7684\u56fe\u50cf\u9009\u62e9\u53ef\u80fd\u4f1a\u5bfc\u81f4\u6570\u636e\u4e2d\u51fa\u73b0\u4e0d\u51c6\u786e\u7684\u9884\u6d4b\u6216\u89c6\u89c9\u4f2a\u5f71\u3002\u89c6\u89c9\u4f2a\u5f71\u662f\u56fe\u50cf\u4e2d\u7684\u4eba\u4e3a\u5931\u771f\uff0c\u4f1a\u964d\u4f4e\u56fe\u50cf\u5206\u6790\u7684\u6027\u80fd\u3002\u8be5\u95ee\u9898\u53ef\u80fd\u4f1a\u4ee5\u56fe\u50cf\u4e2d\u90e8\u5206\u4e0d\u4e00\u81f4\u50cf\u7d20\u503c\u7684\u884c\u5f62\u5f0f\u51fa\u73b0\uff0c\u8fd9\u6e90\u4e8e\u76f8\u90bb\u56fe\u5757\u4e4b\u95f4\u4e0d\u4e00\u81f4\u7684\u56fe\u50cf\u9009\u62e9\u3002\u6570\u636e\u4ea7\u54c1 1.1 \u7248\u672c\u5c06\u8ffd\u6eaf\u4fee\u6b63\uff0c\u4f46\u4ee5\u4e0b\u533a\u57df\u53ef\u80fd\u4f1a\u53d7\u8349\u7a3f\u6570\u636e\u7684\u5f71\u54cd\uff1a", "387ef52eac34f34490acda6bc7ee62a6": "\u8fd9\u7ec4\u6570\u636e\u6c47\u96c6\u4e86\u6765\u81ea\u4e0d\u540c\u56fd\u5bb6\u548c\u6765\u6e90\u7684\u4eba\u5de5\u6797\u6570\u636e\u3002\u8fd9\u4f7f\u5f97\u6570\u636e\u5e93\u4e2d\u5404\u9879\u6570\u636e\u7684\u5b9a\u4e49\u548c\u65f6\u95f4\u4e0d\u76f8\u4e00\u81f4\uff0c\u4e5f\u6ca1\u6709\u7edf\u4e00\u7684\u51c6\u786e\u5ea6\u8bc4\u4f30\uff0c\u7a7a\u95f4\u8986\u76d6\u4e5f\u4e0d\u5168\u9762\uff0c\u5c24\u5176\u662f\u5728\u52a0\u62ff\u5927\u3001\u4fc4\u7f57\u65af\u548c\u975e\u6d32\u56fd\u5bb6\u66f4\u4e3a\u4e25\u91cd\u3002", "8b9dcbf435e678e164e14f9456cf5b25": "\u76ee\u524d\u7684\u5904\u7406\u8303\u56f4\u8986\u76d6\u4e86\u62c9\u4e01\u7f8e\u6d32\u548c\u975e\u6d32\u7684 14 \u4ebf\u516c\u9877\u571f\u5730\u3002", "032c6ecdbfbd5509f7cd0facb187cc74": "\uff082020\uff0c10m\uff0c\u975e\u6d32\u548c\u62c9\u4e01\u7f8e\u6d32\uff09", "4b483b58096b26d71b20a61694164cf9": "\u6570\u636e\u8d28\u91cf\u56e0\u533a\u57df\u800c\u5f02\uff0c\u7279\u522b\u662f\u4e0e\u7528\u4e8e\u521b\u5efa\u57fa\u7ebf\u5730\u56fe\u7684 MERIS \u56fe\u50cf\u7684\u8986\u76d6\u8303\u56f4\u6709\u5173\u3002\u8986\u76d6\u8f83\u5c11\u7684\u5730\u533a\u5305\u62ec\u4e9a\u9a6c\u900a\u76c6\u5730\u897f\u90e8\u3001\u667a\u5229\u3001\u963f\u6839\u5ef7\u5357\u90e8\u3001\u521a\u679c\u76c6\u5730\u897f\u90e8\u4ee5\u53ca\u51e0\u5185\u4e9a\u6e7e\u3001\u4fc4\u7f57\u65af\u4e1c\u90e8\u3001\u4e2d\u56fd\u4e1c\u6d77\u5cb8\u548c\u5370\u5ea6\u5c3c\u897f\u4e9a\u3002", "715fcdc5fdb5b7770fbb87c8a20d1a27": "\u8fd9\u4e2a\u6570\u636e\u96c6\uff08\u7248\u672c 2.07\uff09\u662f\u4f5c\u4e3a\u6c14\u5019\u53d8\u5316\u5021\u8bae (CCI) \u7684\u4e00\u90e8\u5206\u521b\u5efa\u7684\uff0cCCI \u662f\u6b27\u6d32\u592a\u7a7a\u603b\u7f72\u4e3a\u6c14\u5019\u5efa\u6a21\u76ee\u7684\uff0c\u521b\u5efa\u7684\u957f\u671f\u4e00\u81f4\u5168\u7403\u6570\u636e\u5021\u8bae\u7684\u4e00\u90e8\u5206\u3002\u4ece 1992 \u5e74\u5230 2015 \u5e74\uff0cCCI Land Cover \u9879\u76ee\u6bcf\u5e74\u63d0\u4f9b 300 \u7c73\u7a7a\u95f4\u5206\u8fa8\u7387\u7684\u5168\u7403\u571f\u5730\u8986\u76d6\u5730\u56fe\u3002Global Forest Watch \u5e73\u53f0\u53ea\u663e\u793a 2015 \u5e74\u7684\u571f\u5730\u8986\u76d6\u6570\u636e\u3002", "3a5f1a9f6ceed449689be831a9ee3aba": "2017 \u5e74\u30012018 \u5e74\u548c 2019 \u5e74\u5730\u56fe\u7684\u51c6\u786e\u7387\u5206\u522b\u88ab\u8bc4\u4f30\u4e3a 96%\u300194% \u548c 96%\u3002\u5927\u8c46\u7c7b\u7684\u8bef\u62a5\u7387\u4e3a 8-14%\uff0c\u6f0f\u62a5\u7387\u4e3a 14-17%\u3002\u65e0\u6cd5\u8bc4\u4f30\u4e4b\u524d\u5e74\u4efd\u7684\u5730\u56fe\u51c6\u786e\u6027\uff0c\u4f46\u53d1\u73b0\u8fd9\u4e9b\u5730\u56fe\u7684\u51c6\u786e\u6027\u4e0e\u7f8e\u56fd\u519c\u4e1a\u90e8\u62a5\u544a\u7684\u5e74\u5ea6\u603b\u6536\u83b7\u9762\u79ef\u7edf\u8ba1\u6570\u636e\u57fa\u672c\u543b\u5408\u3002", "db7303397a9368e41ddf07529e2e9ee0": "\u8fd9\u7ec4\u6570\u636e\u96c6\u662f\u7531<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u963f\u4f2f\u91cc\u65af\u7279\u5a01\u65af\u5927\u5b66 (Aberystwyth University)</a> \u4e0e <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">soloEO</a> \u5728<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u201c\u5168\u7403\u7ea2\u6811\u6797\u89c2\u5bdf\u201d(Global Mangrove Watch, GMW) \u9879\u76ee</a>\u7684\u6846\u67b6\u4e0b\u4f5c\u6210\u7684\uff0c\u662f\u7531<a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6e7f\u5730\u56fd\u9645 (Wetlands International)</a>\u8fdb\u884c\u534f\u8c03\u3001\u7531 <a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">DOB Ecology</a> \u63d0\u4f9b\u8d44\u91d1\u7684\u65e5\u672c\u5b87\u5b99\u822a\u7a7a\u7814\u7a76\u5f00\u53d1\u673a\u6784 (JAXA) \u7684\u4eac\u90fd\u5206\u673a\u6784\u4e0e\u201c\u78b3\u5021\u8bae\u4e0e\u7ea2\u6811\u6797\u8d44\u672c\u975e\u6d32\u8ba1\u5212\u201d(Carbon Initiative and the Mangrove Capital Africa Programme) \u7684\u4e00\u90e8\u5206\u3002\u8fd9\u4e00\u5730\u56fe\uff082.0 \u7248\u672c\uff09\u63cf\u7ed8\u4e86\u5168\u7403\u5728 2010 \u5e74\u65f6\u7684\u7ea2\u6811\u6797\u8303\u56f4\uff0c\u8fd9\u4e00\u8303\u56f4\u662f\u7ed3\u5408\u4e86 L \u6ce2\u6bb5\u96f7\u8fbe (ALOS PALSAR) \u4e0e\u5149\u5b66\u536b\u661f (Landsat-5, -7) \u7684\u536b\u661f\u6570\u636e\uff0c\u5e76\u901a\u8fc7\u968f\u673a\u68ee\u6797\u5206\u7c7b (Random Forest Classification) \u6280\u672f\u63a8\u5bfc\u5f97\u51fa\u7684\u3002\u7528\u4e8e\u63a8\u5bfc GMW \u7ea2\u6811\u6797\u5730\u56fe\u7684\u6240\u6709\u536b\u661f\u6570\u636e\u548c\u6240\u7528\u8f6f\u4ef6\u5747\u4e3a\u516c\u5171\u9886\u57df\u4e0b\u7684\u53ef\u7528\u8d44\u6e90\u3002", "bd3390694617b45b8d7b9aff2926e39d": "\u5404\u4e0d\u76f8\u540c\uff0c\u4f46\u4ee5 2015 \u5e74\u4e3a\u4e2d\u5fc3", "d370c367e80a81216e184b558a85ec9c": "\u968f\u7740\u65b0\u6570\u636e\u7684\u51fa\u73b0\uff0c\u5b9a\u671f\u66f4\u65b0", "8cd108d0332be6aa5870ddc5e902d91d": "Landsat-7 \u626b\u63cf\u7ebf\u8bef\u5dee\u4f1a\u5f71\u54cd\u67d0\u4e9b\u533a\u57df\u7684\u5206\u7c7b\uff0c\u8fdb\u800c\u5bfc\u81f4\u6570\u636e\u4e2d\u51fa\u73b0\u6761\u72b6\u4f2a\u5f71\u3002", "8a84846eb429819281f145c598d3511a": "TML \u521d\u671f\u6570\u636e\u5c06\u4e8e 2022 \u5e74\u521d\u5b8c\u6210\u5bf9\u5f53\u524d\u533a\u57df\u7684\u5904\u7406\uff0c\u5e76\u5c06\u5728 2022 \u5e74\u4e0b\u534a\u5e74\u6269\u5c55\u5230\u70ed\u5e26\u548c\u4e9a\u70ed\u5e26\u7684\u975e\u8352\u6f20\u5730\u533a\u3002\u8ba1\u5212\u5728 2023 \u5e74\u53d1\u5e03\u5e74\u5ea6\u6216\u534a\u5e74\u5ea6\u53d8\u5316\u68c0\u6d4b\u56fe\u3002", "ab12820517f99aaf2462ca22eeb37148": "\u6570\u636e\u6765\u81ea\u5e94\u7528\u4e8e Sentinel \u5149\u5b66\u548c\u96f7\u8fbe\u56fe\u50cf\u7684\u591a\u65f6\u6001\u5377\u79ef\u795e\u7ecf\u7f51\u7edc\u6a21\u578b\u3002\u6bcf\u4e2a\u50cf\u7d20\u6807\u5b9a\u4e3a\u5b58\u5728\u4e00\u68f5\u6216\u591a\u68f5\u6811\u51a0\u76f4\u5f84\u5927\u4e8e 3 \u7c73\u4e14\u9ad8\u5ea6\u5927\u4e8e 5 \u7c73\u7684\u6811\u6728\u3002\u6bcf\u4e2a\u50cf\u7d20\u7684\u503c\u8868\u793a\u68c0\u6d4b\u5230\u4e00\u68f5\u6811\u7684 sigmoidal \u51fd\u6570\u6982\u7387\uff0c\u5e76\u4e14\u53ef\u4ee5\u901a\u8fc7\u5bf9\u6240\u9700\u7a97\u53e3\u5927\u5c0f\uff08\u4f8b\u5982 30 x 30 m \u6216\u534a\u516c\u9877\uff09\u5185\u7684\u503c\u8fdb\u884c\u5e73\u5747\u6765\u8f6c\u6362\u4e3a\u6811\u6728\u8986\u76d6\u7387\u3002\u8be5\u6570\u636e\u53d6\u81ea\u4e8e 2020 \u5e74\u7684 3 \u6b21\u65e0\u4e91\u89c2\u6d4b\uff08&lt;97.5% \u7684\u5e73\u5747\u4e91\u91cf\uff09\uff0c1% \u7684\u5904\u7406\u533a\u57df\u7531\u4e8e\u7f3a\u4e4f\u65e0\u4e91\u89c2\u6d4b\u6570\u636e\u800c\u7f3a\u5931\u3002\u8bf7\u8bbf\u95ee <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub \u9875\u9762</a>\u67e5\u770b\u6709\u5173\u65b9\u6cd5\u548c\u5206\u6790\u7684\u66f4\u591a\u8be6\u7ec6\u4fe1\u606f\u3002", "b424caaf6ceabcd89b5fc7c6b1e9f6d1": "\u5982\u679c\u60a8\u77e5\u9053\u5176\u4ed6\u4efb\u4f55\u4eba\u5de5\u6797\u6570\u636e\uff0c\u8bf7\u586b\u5199<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8fd9\u4e2a</a>\u8868\u683c\u544a\u77e5\u6211\u4eec\u3002", "88183b946cc5f0e8c96b2e66e1c74a7e": "\u672a\u77e5", "84d04eaf59fd637e17253ecd4b776a9d": "Global Forest Watch \u4f7f\u7528\u5404\u56fd\u653f\u5e9c\u3001\u975e\u653f\u5e9c\u7ec4\u7ec7\u548c\u72ec\u7acb\u7814\u7a76\u4eba\u5458\u7684\u6570\u636e\uff0c\u7f16\u5236\u4e86\u5df2\u79cd\u690d\u6811\u6728\u7a7a\u95f4\u6570\u636e\u5e93 (SDPT)\u3002\u6570\u636e\u9488\u5bf9\u5168\u4e16\u754c 82 \u4e2a\u56fd\u5bb6\u7f16\u8f91\uff0c\u5176\u4e2d\u5927\u591a\u6570\u56fd\u5bb6\u5730\u56fe\u6765\u81ea\u4e8e\u9646\u5730\u536b\u661f\u3001SPOT \u6216 RapidEye \u536b\u661f\u56fe\u50cf\u7684\u76d1\u7763\u5206\u7c7b\u6216\u624b\u5de5\u591a\u8fb9\u5f62\u52fe\u753b\u3002", "0645f202f2c94273fc8f4ee6b353225f": "SDPT\u67091.73\u4ebf\u516c\u9877\u4eba\u5de5\u6797\u548c5000\u4e07\u516c\u9877\u519c\u4e1a\u6811\u6728\uff0c\u7ea6\u53602015\u5e74\u4e16\u754c\u4eba\u5de5\u6797\u603b\u9762\u79ef\u768482%\uff08\u8054\u5408\u56fd\u7cae\u519c\u7ec4\u7ec72015\u5e74\u6570\u636e\uff09\u3002SDPT\u662f\u901a\u8fc7\u4e00\u4e2a\u7a0b\u5e8f\u7f16\u5236\u7684\uff0c\u8be5\u7a0b\u5e8f\u5728\u521b\u5efa\u7edf\u4e00\u7684\u5c5e\u6027\u8868\u4e4b\u524d\u6e05\u7406\u548c\u5904\u7406\u6bcf\u4e2a\u5355\u72ec\u7684\u6570\u636e\u96c6\u3002", "46f0f67a5c342f56ca06f69341d75ff9": "\u5982 Song \u7b49\u4eba\u6240\u8ff0\uff082021 \u5e74\uff09\uff0c\u8be5\u6570\u636e\u96c6\u63d0\u4f9b\u4e86\u6574\u4e2a\u5357\u7f8e\u6d32\u519c\u4e1a\u8fb9\u5883\u5730\u533a\u5927\u8c46\u5e74\u79cd\u690d\u9762\u79ef\u7684\u7a7a\u95f4\u76f4\u89c2\u6982\u8ff0\u3002\u4ece 2000 \u5e74\u5230 2019 \u5e74\uff0c\u4ee5 30 \u7c73\u7a7a\u95f4\u5206\u8fa8\u7387\uff0c\u6309\u5e74\u63d0\u4f9b\u4ee5\u4e0b\u751f\u7269\u7fa4\u843d\u533a\u57df\u7684\u6570\u636e\uff1a\u4e9a\u9a6c\u900a\u3001\u5927\u897f\u6d0b\u68ee\u6797\u3001\u5361\u5ef7\u52a0\u3001\u585e\u62c9\u591a\u3001\u67e5\u79d1\u3001\u5947\u57fa\u5854\u5c3c\u4e9a\u3001\u6f58\u5e15\u65af\u548c\u6f58\u5854\u7eb3\u5c14\u3002", "80899499e2ad674ea4748a1d520681f7": "2009 \u5e74\u540e\u7684\u6ee5\u4f10\u5730\u533a", "9e4e1b6803388894337e1b88a01057be": "\u6839\u636e<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">RTRS\u6807\u51c6</a>\uff0c\u6307\u5bfc\u8d1f\u8d23\u4efb\u7684\u5927\u8c46\u751f\u4ea7\u7684\u6269\u5c55\uff0c\u5e76\u5bf9\u539f\u4f4dHCVAs\u8fdb\u884c\u8bc4\u4f30", "04f138f46b44ac40acc89e318123dbcc": "\u901a\u8fc720\u4e2a\u968f\u673a\u9009\u62e9\u7684\u533a\u57df\u4e2d\u7684\u8d85\u8fc753,800\u4e2a\u968f\u673a\u91c7\u6837\u70b9\u6765\u8bc4\u4f30\u5206\u7c7b\u51c6\u786e\u6027\u3002\u603b\u4f53\u51c6\u786e\u6027\u4e3a95.25\uff05\uff0c\u800c\u7528\u6237\u548c\u751f\u4ea7\u8005\u5bf9\u7ea2\u6811\u6797\u7c7b\u7684\u51c6\u786e\u6027\u5206\u522b\u4f30\u8ba1\u4e3a97.5\uff05\u548c94.0\uff05\u3002\u7528\u6237\u5e94\u8be5\u6ce8\u610f\uff0c\u8fd9\u662f\u4e00\u4e2a\u5168\u7403\u89c4\u6a21\u7684\u6570\u636e\u96c6\uff0c\u662f\u901a\u8fc7\u5e94\u7528\u5728\u6240\u6709\u533a\u57df\u4e0a\u7684\u4e00\u79cd\u65b9\u6cd5\u751f\u6210\u7684\uff0c\u56e0\u6b64\u5730\u56fe\u5728\u5404\u4e2a\u4f4d\u7f6e\u7684\u51c6\u786e\u6027\u53ef\u80fd\u6709\u6240\u4e0d\u540c\u3002\u8bf8\u5982\u536b\u661f\u6570\u636e\u53ef\u7528\u6027\uff08\u56e0\u4e3a\u4e91\uff0c\u4e91\u9634\u5f71\u548cLandsat-7\u626b\u63cf\u7ebf\u9519\u8bef\uff09\uff0c\u7ea2\u6811\u6797\u7269\u79cd\u7ec4\u6210\u548c\u9000\u5316\u7a0b\u5ea6\u7b49\u56e0\u7d20\u90fd\u4f1a\u5f71\u54cd\u4f4d\u7f6e\u7684\u7cbe\u5ea6\u3002\u7ea2\u6811\u6797\u7684\u6cbf\u6d77\u8fb9\u754c\u901a\u5e38\u6bd4\u9646\u4e0a\u7684\u8fb9\u754c\u66f4\u4e3a\u51c6\u786e\uff0c\u56e0\u4e3a\u7ea2\u6811\u6797\u4e0e\u67d0\u4e9b\u9646\u5730\u690d\u88ab\u4e4b\u95f4\u7684\u533a\u522b\u53ef\u80fd\u4f1a\u4e0d\u6e05\u6670\u3002", "4b783e258c91c55ce9ea60a4cebabfa8": "\u7ecf\u8425\u6797\u7279\u8bb8\u6743", "164aba165c9c4e3c38e977a56afd37fa": "\uff08\u9009\u62e9\u56fd\u5bb6\uff09", "969a1c6b1d320887eaef906cef05d2b3": "\u663e\u793a\u653f\u5e9c\u4e3a\u516c\u53f8\u5212\u5b9a\u7684\u6797\u533a\u8fb9\u754c\uff0c\u8fd9\u4e9b\u6797\u533a\u7528\u4e8e\u91c7\u4f10\u6728\u6750\u548c\u5176\u4ed6\u6728\u8d28\u4ea7\u54c1\u3002", "9f26bc79a7bf85de3cf51baa250e537b": "\u76ee\u524d\u9002\u7528\u4e8e\u5580\u9ea6\u9686\u3001\u52a0\u62ff\u5927\u3001\u4e2d\u975e\u5171\u548c\u56fd\u3001\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd (DRC)\u3001\u8d64\u9053\u51e0\u5185\u4e9a\u3001\u52a0\u84ec\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u3001\u5229\u6bd4\u91cc\u4e9a\u548c\u521a\u679c\u5171\u548c\u56fd\u3002", "1f66584c62ff9ee3c4fba9c6f4d4392e": "<em>\u5580\u9ea6\u9686\uff1a</em> \u6797\u4e1a\u4e0e\u91ce\u751f\u52a8\u7269\u90e8 &amp; \u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240 (WRI)", "34ece2ab52af22c1983bc4040920e98f": "60\u00d760 \u7c73\uff08Open Data Portal \u4e5f\u63d0\u4f9b 3700\u00d73700 \u7c73\u5206\u8fa8\u7387\u7684\u5c42\u5206\u8fa8\u7387\u5730\u56fe\uff09", "8ccc218317150bed0356929a806c30a6": "\u5df4\u897f\u548c\u5df4\u62c9\u572d", "8f3a654773e27647758ad4bfba38aeaf": "RTRS \u53ec\u96c6\u7684\u591a\u65b9\u5229\u76ca\u76f8\u5173\u8005\u7a0b\u5e8f", "1e206205087c8a73eb89aea29d5fabd9": "2015 \u5e74 5 \u6708", "cdb630840937b95db1f4b7dfedd21202": "<em>\u52a0\u62ff\u5927\uff1a</em>\u5168\u7403\u68ee\u6797\u89c2\u6d4b\u4e4b\u52a0\u62ff\u5927", "674ddbe58565e68986b58de430b1f2e7": "<em>\u4e2d\u975e\u5171\u548c\u56fd\uff1a</em>\u6c34\u4e0e\u68ee\u6797\u3001\u6253\u730e\u548c\u6e14\u4e1a\u90e8\u95e8 &amp; WRI", "9ac7054eed4357dda46ca0dc29ea6286": "<em>\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\uff1a</em> \u73af\u5883\u3001\u81ea\u7136\u4fdd\u62a4\u548c\u65c5\u6e38\u90e8 &amp; WRI", "10b60320f51d9e2c09f503ab094aad4a": "<em>\u5370\u5c3c\uff1a</em> \u6797\u4e1a\u90e8", "52b871c775a2c7ed62d332c81643ccab": "\u56e0\u56fd\u5bb6\u800c\u5f02", "47546fd87b30b0dbb8e91fd8e460e0d2": "\u8be5\u56fe\u5c42\u6c47\u96c6\u4e86\u4e0d\u540c\u56fd\u5bb6\u548c\u6765\u6e90\u7684\u7279\u8bb8\u6743\u6570\u636e\u3002\u6570\u636e\u8d28\u91cf\u53ef\u80fd\u53c2\u5dee\u4e0d\u9f50\uff0c\u4e3b\u8981\u53d6\u51b3\u4e8e\u5176\u6765\u6e90\u3002\u5bf9\u67d0\u4e00\u56fd\u5bb6\u7684\u7279\u8bb8\u6743\u6570\u636e\uff0c\u8be5\u56fe\u5c42\u53ef\u80fd\u6ca1\u6709\u5168\u9762\u5730\u5305\u542b\u5176\u73b0\u5b58\u7684\u6240\u6709\u7279\u8bb8\u6743\uff0c\u67d0\u4e9b\u7279\u8bb8\u6743\u5bf9\u5e94\u7684\u4f4d\u7f6e\u53ef\u80fd\u4e0d\u51c6\u786e\u3002", "eeb24beb5d32ef119cd6872e77c1ed1b": "\u201c\u53d7\u7ba1\u7406\u7684\u68ee\u6797\u201d\u662f\u6307\u4e00\u5904\u516c\u5171\u68ee\u6797\u91cc\u7531\u653f\u5e9c\u5206\u914d\u7528\u4ee5\u780d\u4f10\u6728\u6750\u548c\u5176\u5b83\u6728\u5236\u54c1\u7684\u5730\u533a\u3002\u6709\u7ba1\u7406\u7684\u68ee\u6797\u548c\u6728\u7ea4\u7ef4\u7279\u8bb8\u7528\u5730\u6709\u6240\u4e0d\u540c\uff0c\u5728\u90a3\u91cc\u4eba\u5de5\u6797\u4e13\u95e8\u7528\u4e8e\u7eb8\u6d46\u548c\u7eb8\u4ea7\u54c1\u7684\u751f\u4ea7\u3002\u201c\u7279\u8bb8\u7528\u5730\u201d\u4f5c\u4e3a\u8d4b\u4e88\u79c1\u8425\u516c\u53f8\u4ece\u516c\u5171\u68ee\u6797\u7ba1\u7406\u548c\u63d0\u70bc\u6728\u6750\u548c\u5176\u5b83\u6728\u5236\u54c1\u7684\u6743\u5229\u7684\u6388\u6743\u3001\u8bb8\u53ef\u6216\u5176\u5b83\u5408\u540c\u7684\u4e00\u6761\u901a\u7528\u672f\u8bed\u4f7f\u7528\uff1b\u4f46\u5728\u56fd\u5bb6\u5c42\u9762\u4e0a\u672f\u8bed\u6709\u6240\u4e0d\u540c\uff0c\u5305\u62ec\u201c\u68ee\u6797\u8bb8\u53ef\u201d\u3001\u201c\u4f7f\u7528\u6743\u201d\u3001\u201c\u6388\u6743\u201d\u548c\u5176\u5b83\u672f\u8bed\u3002", "f0725ecfdcb6d5e13a7f4b31d0c097b5": "\u672c\u6570\u636e\u96c6\u5c06\u68ee\u6797\u7ba1\u7406\u7279\u8bb8\u6743\u663e\u793a\u4e3a\u6c47\u603b\u591a\u4e2a\u56fd\u5bb6/\u5730\u533a\u7684\u6570\u636e\u6574\u5408\u800c\u6210\u7684\u5355\u4e2a\u56fe\u5c42\u3002\u6570\u636e\u53ef\u80fd\u6765\u81ea\u653f\u5e9c\u673a\u6784\u3001\u975e\u653f\u5e9c\u7ec4\u7ec7\u6216\u5176\u4ed6\u7ec4\u7ec7\uff0c\u5e76\u56e0\u65e5\u671f\u548c\u6570\u636e\u6765\u6e90\u800c\u5f02\u3002\u5982\u9700\u8be6\u7ec6\u4e86\u89e3\u6bcf\u4e2a\u56fd\u5bb6/\u5730\u533a\u7684\u7279\u8bb8\u6743\u6570\u636e\uff0c\u8bf7\u8bbf\u95ee<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u516c\u5f00\u6570\u636e\u95e8\u6237\u7f51\u7ad9</a>\u3002", "e94a9d2af5038a3d58365a0133d09dc2": "\u5982\u679c\u60a8\u77e5\u9053\u5176\u4ed6\u56fd\u5bb6/\u5730\u533a\u7684\u7279\u8bb8\u6743\u6570\u636e\uff0c\u8bf7\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u7ed9\u6211\u4eec\u53d1\u9001\u90ae\u4ef6\u3002", "199593a9487bbe4e35f6416756296ee6": "<em>\u9a6c\u6765\u897f\u4e9a\u6c99\u635e\u8d8a\uff1a</em>Earthsight Investigations &amp; Global Witness", "efdd60c5f1997dc427101df42ff74cf2": "\u91c7\u77ff", "e61d55e9dd49506e7d6381df172cb1f7": "\u663e\u793a\u653f\u5e9c\u5212\u5206\u7684\u4e0e\u91c7\u77ff\u516c\u53f8\u7684\u5730\u533a\u8fb9\u754c", "92aa522e310d3387532269b8fbdf6c7b": "\u76ee\u524d\u9002\u7528\u4e8e\u5580\u9ea6\u9686\u3001\u67ec\u57d4\u5be8\u3001\u52a0\u62ff\u5927\u3001\u54e5\u4f26\u6bd4\u4e9a\u3001\u521a\u679c\u5171\u548c\u56fd\u3001\u52a0\u84ec\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u548c\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd (DRC)\u3001\u79d8\u9c81\u3001\u5df4\u897f\u548c\u58a8\u897f\u54e5", "a5e9947f293ca0711608891e86b19be2": "<em>\u5df4\u897f\uff1a</em>\u56fd\u5bb6\u77ff\u4ea7\u4fdd\u62a4\u90e8", "320e746638f4a7650b040cd90bda5e51": "<em> \u67ec\u57d4\u5be8\uff1a</em> \u5f00\u653e\u5f0f\u5f00\u53d1\u7684\u67ec\u57d4\u5be8", "027d5e26ebfe474ad31cf11f0eb43e69": "<em>\u54e5\u4f26\u6bd4\u4e9a\uff1a</em>\u77ff\u533a\u571f\u5730\uff1b\u54e5\u4f26\u6bd4\u4e9a\u56fd\u5bb6\u77ff\u4e1a\u5c40", "559bdf1af500ee29f4a06b57aa46ad03": "<em>\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\uff1a</em>\u77ff\u4e1a\u90e8\u91c7\u77ff\u767b\u8bb0\u5904", "3f6336e15296639b2c08154cb9c36bc6": "<em>\u52a0\u84ec\uff1a</em> \u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u77ff\u4e1a\u90e8\u77ff\u4e1a\u6ce8\u518c(CAMI)", "889e469c3d97fef5c506d0a8ca2bdd4c": "<em>\u5370\u5ea6\u5c3c\u897f\u4e9a</em>\uff1a\u73af\u5883\u548c\u6797\u4e1a\u90e8", "693ef15f49008c4057d24d3b2786de6b": "<em>\u58a8\u897f\u54e5\uff1a</em>\u79d8\u9c81\u7ecf\u6d4e", "8e0141681b8f82d18f3b761890e2e283": "<em>\u79d8\u9c81\uff1a</em>\u5730\u8d28\u77ff\u4ea7\u51b6\u91d1\u7814\u7a76\u9662 (INGEMMET)", "fde6bd9e3c6e9035dc725f8b6155b076": "<em>\u521a\u679c\u5171\u548c\u56fd\uff1a</em> \u521a\u679c\u5171\u548c\u56fd\u77ff\u5c71\u4e0e\u5730\u8d28\u90e8\u95e8 &amp; WRI", "cc16f447f7552ee2eedeae9e60fb0a5f": "\u8be5\u56fe\u5c42\u6df7\u5408\u4e86\u4e0d\u540c\u56fd\u5bb6\u548c\u6765\u6e90\u7684\u7279\u8bb8\u6743\u6570\u636e\u3002\u6570\u636e\u8d28\u91cf\u53ef\u80fd\u53c2\u5dee\u4e0d\u9f50\uff0c\u53d6\u51b3\u4e8e\u5176\u6765\u6e90\u3002\u8be5\u56fe\u5c42\u53ef\u80fd\u4e0d\u5305\u62ec\u4e00\u4e2a\u56fd\u5bb6\u73b0\u6709\u7684\u5168\u90e8\u7279\u8bb8\u6743\uff0c\u67d0\u4e9b\u7279\u8bb8\u6743\u7684\u5730\u5740\u53ef\u80fd\u4e0d\u51c6\u786e\u3002", "0245f3b3b936877a0cad817e6ba64861": "\u201c\u91c7\u77ff\u6743\u201d\uff0c\u662f\u6307\u7531\u653f\u5e9c\u6216\u5176\u4ed6\u673a\u6784\u7684\u77ff\u7269\u8d28\u5f00\u91c7\u5206\u914d\u7684\u533a\u57df\u3002\u6bcf\u4e2a\u56fd\u5bb6\u5bf9\u4e8e\u8fd9\u79cd\u533a\u57df\u7684\u672f\u8bed\u5404\u4e0d\u76f8\u540c\u3002 \u201c\u7279\u8bb8\u6743\u201d\u4f5c\u4e3a\u901a\u7528\u672f\u8bed\u7528\u4e8e\u6267\u7167\u3001\u8bb8\u53ef\u8bc1\u3001\u6216\u5176\u4ed6\u6388\u4e88\u79c1\u4eba\u516c\u53f8\u7ba1\u7406\u548c\u4ece\u516c\u5171\u571f\u5730\u5f00\u91c7\u77ff\u7269\u7684\u6743\u5229\u7684\u5408\u540c\uff1b\u7136\u800c\u672f\u8bed\u5728\u56fd\u5bb6\u5c42\u9762\u5404\u4e0d\u76f8\u540c\uff0c\u5305\u62ec\u77ff\u4ea7\u5f00\u91c7\u6216\u77ff\u4e1a\u201c\u8bb8\u53ef\u8bc1\u201d\u3001\u201c\u6743\u5c5e\u201d\u3001\u201c\u6267\u7167\u201d\uff0c\u4ee5\u53ca\u5176\u5b83\u672f\u8bed\u3002", "035a92fb65fbdefa1e462efac41b8e6d": "\u6b64\u6570\u636e\u96c6\u901a\u8fc7\u6c47\u603b\u591a\u4e2a\u56fd\u5bb6\u7684\u7279\u8bb8\u6743\u6570\u636e\u5c06\u91c7\u77ff\u7279\u8bb8\u6743\u5355\u5c42\u663e\u793a\u3002\u6b64\u6570\u636e\u53ef\u80fd\u6765\u81ea\u653f\u5e9c\u673a\u6784\u3001NGO \u6216\u5176\u4ed6\u7ec4\u7ec7\uff0c\u5e76\u56e0\u65e5\u671f\u548c\u6570\u636e\u6765\u6e90\u4e0d\u540c\u800c\u6709\u6240\u5dee\u5f02\u3002\u4e86\u89e3\u5404\u56fd\u5bb6/\u5730\u533a\u7279\u8bb8\u6743\u6570\u636e\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u8bbf\u95ee<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Open Data Portal</a>\u3002", "b6bf672eef42cbd526143be7d6493ff7": "<em>\u5580\u9ea6\u9686\uff1a</em>\u77ff\u4ea7\u548c\u6280\u672f\u5f00\u53d1\u90e8", "e34af5da277639deee3f91f92c866df1": "\u663e\u793a\u653f\u5e9c\u5212\u5206\u7684\u4e0e\u6cb9\u68d5\u79cd\u690d\u56ed\u516c\u53f8\u7684\u5730\u533a\u8fb9\u754c", "3154a121aa69b9effb3c190a2c4e6d51": "\u76ee\u524d\u53ef\u7528\u4e8e\u5580\u9ea6\u9686\uff0c\u5370\u5ea6\u5c3c\u897f\u4e9a\uff0c\u5229\u6bd4\u91cc\u4e9a\uff0c\u9a6c\u6765\u897f\u4e9a\uff08\u6c99\u635e\u8d8a\uff09\u548c\u521a\u679c\u5171\u548c\u56fd", "a75f22b83db3b384648bb63866c470fe": "<em>\u5580\u9ea6\u9686\uff1a</em> WRI", "adcc6b34c8bed550bd939d2bd10c9938": "<em>\u9a6c\u6765\u897f\u4e9a\uff1a</em> SADIA, Aidenvironment &amp; Earthsight \u8c03\u67e5", "ff1c712fbc4617cae5478941d76129bf": "<em>\u521a\u679c\u5171\u548c\u56fd\uff1a</em> WRI &amp; \u519c\u4e1a\u90e8", "728378074421ef244a685bf5af041928": "\u201c\u6cb9\u68d5\u7279\u8bb8\u6743\u201d\u6307\u7531\u653f\u5e9c\u6216\u8005\u5176\u5b83\u7ec4\u7ec7\u5206\u914d\u7684\u4e00\u5757\u533a\u57df\uff0c\u7528\u6765\u79cd\u690d\u5de5\u4e1a\u89c4\u6a21\u7684\u6cb9\u68d5\u3002", "2faaa704607aa219093ac15e5d74a6e1": "\u8be5\u6570\u636e\u96c6\u5c06\u6cb9\u68d5\u6988\u6811\u7279\u8bb8\u6743\u663e\u793a\u4e3a\u4e00\u4e2a\u5355\u5c42\uff0c\u7531\u591a\u4e2a\u56fd\u5bb6\u7684\u7279\u8bb8\u6743\u6570\u636e\u805a\u5408\u800c\u6210\u3002\u6570\u636e\u53ef\u80fd\u6765\u81ea\u653f\u5e9c\u673a\u6784\u3001\u975e\u653f\u5e9c\u7ec4\u7ec7\u6216\u5176\u4ed6\u7ec4\u7ec7\uff0c\u5e76\u968f\u65e5\u671f\u548c\u6570\u636e\u6e90\u7684\u4e0d\u540c\u800c\u6709\u6240\u4e0d\u540c\u3002\u5173\u4e8e\u6bcf\u4e2a\u56fd\u5bb6\u7279\u8bb8\u6743\u6570\u636e\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u8bbf\u95ee<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Open Data Portal</a>\u3002", "37bdc021ab2473523e9174359d4f6740": "\u6bcf 6 \u4e2a\u6708", "d90d87e5ada144022396fcc617c2209c": "\u6839\u636e RTRS \u6807\u51c6\uff0c\u8fd9\u4e9b\u5730\u56fe\u8868\u660e\u9002\u5408\u5927\u8c46\u751f\u4ea7\uff1b\u5176\u4ed6\u6807\u51c6\u548c\u6846\u67b6\u7684\u8981\u6c42\u548c\u5730\u5f62\u89e3\u91ca\u53ef\u80fd\u6709\u6240\u4e0d\u540c\u3002", "a41d0a90b780287f7fe5b43a79fd730c": "\u672c\u6570\u636e\u96c6\u65e0\u6cd5\u6db5\u76d6\u4e16\u754c\u4e0a\u6240\u6709\u7684\u68d5\u6988\u6cb9\u5382\u3002\u5168\u7403\u6570\u636e\u76ee\u524d\u5305\u62ec\u5411\u5f00\u53d1\u8005\u63d0\u4ea4\u5de5\u5382\u6570\u636e\u7684\u516c\u53f8\u4f9b\u5e94\u94fe\u4e2d\u7684\u5de5\u5382\u3002\u5728\u5370\u5ea6\u5c3c\u897f\u4e9a\uff0c\u8be5\u5de5\u5382\u5217\u8868\u4f7f\u7528\u653f\u5e9c\u62a5\u544a\u4e2d\u7684\u4fe1\u606f\u8865\u5145\u4e86\u6709\u5173\u5176\u4ed6\u5de5\u5382\u7684\u989d\u5916\u6570\u636e\u3002\u7531\u6b64\u4ea7\u751f\u7684\u7684\u6570\u636e\u63d0\u4f9b\u4e86\u4e3b\u8981\u4f9b\u5e94\u94fe\u4e2d\u53ef\u9760\u4e14\u7ecf\u8fc7\u4e25\u683c\u9a8c\u8bc1\u7684\u5de5\u5382\u6c47\u7f16\u3002 \u5de5\u5382\u540d\u79f0\u3001\u516c\u53f8\u548c\u96c6\u56e2\u540d\u79f0\u4fe1\u606f\u57fa\u4e8e\u6700\u4f73\u7684\u53ef\u7528\u6570\u636e\uff0c\u53ef\u80fd\u5b58\u5728\u6f5c\u5728\u7684\u4e0d\u51c6\u786e\u4e4b\u5904\u3002", "c5b57e6daa9ec656bcd233b40d76b071": "Universal Mill List (UML) \u6c47\u603b\u4e86\u5168\u7403\u68d5\u6988\u6cb9\u5de5\u5382\u7684\u4f4d\u7f6e\uff0c\u5e76\u5305\u542b\u76f8\u5173\u7684\u96c6\u56e2\u3001\u516c\u53f8\u548c\u5de5\u5382\u540d\u79f0\u3001RSPO \u8ba4\u8bc1\u72b6\u6001\u548c\u552f\u4e00\u7684\u201c\u901a\u7528 ID\uff08universal ID\uff09\u201d\u3002 UML \u57fa\u4e8e\u68d5\u6988\u6cb9\u4e70\u5bb6\u516c\u53f8\u3001Roundtable on Sustainable Palm Oil (RSPO) \u548c FoodReg \u4e3a\u5f00\u53d1\u8005\u63d0\u4f9b\u7684\u6570\u636e\uff0c\u4ee5\u53ca\u4ece\u653f\u5e9c\u8bb0\u5f55\u548c\u5e7f\u6cdb\u7684\u4f9b\u5e94\u94fe\u7814\u7a76\u4e2d\u6536\u96c6\u7684\u6570\u636e\u3002UML \u7684\u76ee\u6807\u662f\u4e3a\u68d5\u6988\u6cb9\u884c\u4e1a\u63d0\u4f9b\u4e00\u4e2a\u5168\u9762\u3001\u901a\u7528\u7684\u6570\u636e\u96c6\uff0c\u53ef\u7528\u4e8e\u65b9\u4fbf\u5feb\u6377\u5730\u8bc6\u522b\u5404\u5e73\u53f0\u548c\u62a5\u544a\u5de5\u4f5c\u4e2d\u7684\u5de5\u5382\u3002", "e31a84f3e7a8a6d0c18dcd27e6cbcfc1": "\u6570\u636e\u7684\u534f\u8c03\u548c\u6bcf\u4e2a\u5de5\u5382\u4f4d\u7f6e\u7684\u9a8c\u8bc1\u7531\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240 (WRI)\u3001Rainforest Alliance\u3001Proforest\u3001Daemeter\u3001Trase\u3001Earthworm Foundation\u3001Auriga\u3001CIFOR\u3001Transitions\u3001\u52a0\u5dde\u5927\u5b66\u5723\u5df4\u5df4\u62c9\u5206\u6821\u548c\u590f\u5a01\u5937\u5927\u5b66\u652f\u6301\u3002UML \u662f\u6839\u636e\u6807\u51c6\u5316\u6d41\u7a0b\u521b\u5efa\u548c\u66f4\u65b0\u7684\uff0c\u8be6\u89c1\u201cUniversal Mill List Methodology\u201d\uff08WRI \u548c Rainforest Alliance \u6b63\u5728\u51fa\u7248\uff0c\u66f4\u65b0\u5f85\u5b9a\uff09\u3002\u6839\u636e\u5de5\u5382\u57fa\u7840\u8bbe\u65bd\u7684\u6807\u51c6\uff0c\u5305\u62ec\u5efa\u7b51\u7269\u3001\u6c89\u6dc0\u6c60\u548c\u9644\u8fd1\u68d5\u6988\u6cb9\u79cd\u690d\u56ed\u7684\u5b58\u5728\uff0c\u4f7f\u7528\u9ad8\u5206\u8fa8\u7387\u536b\u661f\u56fe\u50cf\u4eba\u5de5\u9a8c\u8bc1\u6240\u6709\u5de5\u5382\u4f4d\u7f6e\u3002\u8fdb\u884c GPS \u4f4d\u7f6e\u5206\u6790\uff0c\u5c06\u5b8c\u5168\u91cd\u590d\u6216\u4e34\u8fd1\u4f4d\u7f6e\u7684\u91cd\u590d\u8ba1\u91cf\u7684\u5de5\u5382\u8fdb\u884c\u8bc6\u522b\u548c\u5220\u9664\u3002\u7ecf\u8fc7\u9a8c\u8bc1\u7684\u88ab\u552f\u4e00\u8bc6\u522b\u7684\u5de5\u5382\u4f4d\u7f6e\u88ab\u5206\u914d\u201c\u901a\u7528 ID\u201d\u5e76\u6dfb\u52a0\u5230 UML\u3002\u5de5\u5382\u540d\u79f0\u3001\u6bcd\u516c\u53f8\u548c\u96c6\u56e2\u540d\u79f0\u4fe1\u606f\u57fa\u4e8e Trase\uff08\u5370\u5ea6\u5c3c\u897f\u4e9a\u7684\u5de5\u5382\uff09\u548c Earthworm Foundation\uff08\u5176\u4ed6\u56fd\u5bb6\u7684\u5de5\u5382\uff09\u6536\u96c6\u7684\u6700\u4f73\u53ef\u7528\u6570\u636e\uff0c\u4f46\u6570\u636e\u53ef\u80fd\u4ecd\u5b58\u5728\u504f\u5dee\u6216\u6f5c\u5728\u7684\u4e0d\u51c6\u786e\u4e4b\u5904\u3002\u672c\u6570\u636e\u96c6\u81f4\u529b\u4e8e\u786e\u4fdd\u6570\u636e\u5e93\u4e2d\u7684\u5c5e\u6027\u4fe1\u606f\u4e0d\u91cd\u590d\u3002RSPO \u8ba4\u8bc1\u72b6\u6001\u662f\u6bcf\u4e2a\u5de5\u5382\u5728\u7279\u5b9a\u622a\u6b62\u65e5\u671f\u7684\u72b6\u6001\uff0c\u53ef\u5728\u5c5e\u6027\u6570\u636e\u4e2d\u627e\u5230\u3002RSPO \u8ba4\u8bc1\u72b6\u6001\u6bcf\u5929\u90fd\u4f1a\u66f4\u65b0\uff0c\u56e0\u6b64\u5f53\u524d\u72b6\u6001\u53ef\u80fd\u4e0e\u5c5e\u6027\u8868\u4e2d\u5217\u51fa\u7684\u72b6\u6001\u4e0d\u540c\u3002\u8bf7\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u67e5\u770b RSPO Palm Trace \u7684\u6700\u65b0\u5de5\u5382\u8ba4\u8bc1\u72b6\u6001\u3002\n\n\n", "193cb28d9ba85168ff7cf08f40661eb1": "\u968f\u7740\u65b0\u6570\u636e\u7684\u83b7\u5f97\uff0c\u6570\u636e\u96c6\u5927\u7ea6\u6bcf6\u4e2a\u6708\u66f4\u65b0\u4e00\u6b21\u3002", "ade5e44eef290e11b28f7f4611d375e7": "<em>\u8d64\u9053\u51e0\u5185\u4e9a\uff1a</em> \u519c\u4e1a\u548c\u68ee\u6797\u90e8 &amp; WRI", "f0e44e2ed7cae33370722ee9037963e8": "<em>\u52a0\u84ec\uff1a</em>\u6797\u4e1a\u7ecf\u6d4e\u3001\u6c34\u5229\u3001\u6e14\u4e1a\u548c\u6c34\u4ea7\u517b\u6b96\u90e8 &amp; \u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240 (WRI)", "26bb64475b9bae6a1988ebf3d37ce315": "\u4e07\u80fd\u8f67\u673a\u6e05\u5355", "4b2c1282e6fd3b2e88ddfac41dd3b961": "\u4e0d\u5141\u8bb8\u6269\u5c55", "bbb1192df1405da438d05805e506a516": "\u5728 HCVA \u8bc4\u4f30\u540e\uff0c\u6709\u53ef\u80fd\u8fdb\u884c\u6269\u5c55", "3f4e8f262b7d901ce54dfca988ba61cc": "\u4f9d\u7167\u6cd5\u5f8b\u8d1f\u8d23\u4efb\u5730\u6269\u5f20", "4cceab7f455e2a7aed212bc9197888eb": "\u65e0\u53ef\u6269\u5f20\u571f\u5730", "78945de8de090e90045d299651a68a9b": "\u6709\u6548", "0f9f4a65098509622be89da9d4e1e91c": "\u5927\u5b97\u5546\u54c1", "5c726d1d899832b06e5dfa2e93d9d9b7": "Song \u7b49\u4eba (2021) \u5c06\u957f\u671f\u536b\u661f\u56fe\u50cf\u4e0e\u4e09\u5e74\u7684\u5168\u5927\u9646\u5b9e\u5730\u89c2\u5bdf\u76f8\u7ed3\u5408\uff0c\u5236\u4f5c\u51fa\u5927\u8c46\u79cd\u690d\u7684\u5e74\u5ea6\u5730\u56fe\u3002\u7814\u7a76\u4eba\u5458\u91c7\u96c6\u4e86\u6bcf\u4e2a\u751f\u957f\u5b63\u4ece 11 \u6708 1 \u65e5\u81f3 4 \u6708 30 \u65e5\u7684 Landsat \u548c MODIS \u56fe\u50cf\uff0c\u5e76\u521b\u5efa\u4e86\u5e26\u6709\u7269\u5019\u671f\u6307\u6807\u7684 16 \u5929\u65f6\u95f4\u5e8f\u5217\u3002\u5c06\u8fd9\u4e9b\u6307\u6807\u4e0e\u6d77\u62d4\u9ad8\u5ea6\u3001\u5761\u5ea6\u548c\u5761\u5411\u6570\u636e\u4ee5\u53ca\u6765\u81ea 225 \u4e2a\u91c7\u6837\u533a\u7684\u8bad\u7ec3\u6570\u636e\u76f8\u7ed3\u5408\uff0c\u7ed8\u5236\u51fa\u6bcf\u4e00\u5e74\u7684\u5927\u8c46\u6982\u7387\u5730\u56fe\u3002\u7136\u540e\uff0c\u5229\u7528\u5b9e\u5730\u89c2\u5bdf\u6765\u8bc4\u4f30\u6240\u5f97\u5230\u7684\u5730\u56fe\u7684\u51c6\u786e\u6027\uff0c\u8fd9\u4e9b\u5730\u56fe\u88ab\u9650\u5236\u4e3a\u7b26\u5408\u5b9e\u5730\u89c2\u5bdf\u7684\u533a\u57df\u3002", "02d2b7f7b50a8443180836bbe50aa8ee": "\u8fd9\u4e9b\u5b8f\u89c2\u5730\u56fe\u4e0d\u6392\u9664\u751f\u4ea7\u8005\u80fd\u591f\u8bc1\u660e\u7b26\u5408 RTRS \u6807\u51c6\u7684\u519c\u573a\u60c5\u51b5\u3002\u66f4\u591a\u4fe1\u606f\u8bf7\u67e5\u770b <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">RTRS</a>\u3002", "5a6cdefa9e7258d5d5624efdc564a341": "\u8d1f\u8d23\u4efb\u5927\u8c46\u5706\u684c\u4f1a\u8bae (RTRS) \u662f\u4e00\u4e2a\u6c11\u95f4\u793e\u4f1a\u7ec4\u7ec7\uff0c\u65e8\u5728\u4fc3\u8fdb\u5168\u7403\u8d1f\u8d23\u4efb\u5927\u8c46\u7684\u751f\u4ea7\u3001\u52a0\u5de5\u548c\u9500\u552e\u3002\u5e76\u4e14\u4fc3\u8fdb\u53ef\u6301\u7eed\u751f\u4ea7\uff0c\u51cf\u5c11\u5927\u8c46\u5bf9\u793e\u4f1a\u548c\u73af\u5883\u7684\u5f71\u54cd\u3002RTRS \u8d1f\u8d23\u4efb\u5927\u8c46\u751f\u4ea7\u5730\u56fe\u662f\u6839\u636e<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">RTRS \u6807\u51c6</a>\u521b\u5efa\u7684\uff0c\u65e8\u5728\u6307\u5bfc\u5927\u8c46\u751f\u4ea7\u7684\u8d1f\u8d23\u4efb\u6269\u5f20\u7b26\u5408 RTRS \u8ba4\u8bc1\u3002RTRS \u81f4\u529b\u4e8e\u4e3a\u963f\u6839\u5ef7\u3001\u5df4\u897f\u3001\u73bb\u5229\u7ef4\u4e9a\u548c\u5df4\u62c9\u572d\u521b\u5efa\u5b8f\u89c2\u5730\u56fe\uff0c\u4ee5\u8bc6\u522b\u548c\u4fdd\u62a4\u5173\u952e\u751f\u6001\u7cfb\u7edf\u548c\u9ad8\u4fdd\u62a4\u4ef7\u503c\u5730\u533a (HCVA)\uff0c\u5e76\u8bc6\u522b\u4f4e\u73af\u5883\u5f71\u54cd\u4e0b\u5927\u8c46\u8d1f\u8d23\u4efb\u6269\u5927\u7684\u673a\u4f1a\u3002\u8fd9\u4e00\u8fc7\u7a0b\u59cb\u4e8e 2012 \u5e74\u7684\u5df4\u897f\uff0c\u968f\u540e\u662f 2013 \u5e74\u7684\u5df4\u62c9\u572d\u3002\u66f4\u591a\u7684\u56fd\u5bb6\u7ea7\u5730\u56fe\u6b63\u5728\u7f16\u5236\u4e2d\uff08\u4f8b\u5982\u963f\u6839\u5ef7\uff09\u3002<br>\u8fd9\u4e9b\u56fd\u5bb6\u7ea7\u5730\u56fe\u662f\u7531\u6bcf\u4e2a\u56fd\u5bb6\u7684 RTRS \u56fd\u5bb6\u6280\u672f\u5c0f\u7ec4\u521b\u5efa\uff0c\u7531\u4ee3\u8868\u5404\u7ea7\u4f9b\u5e94\u94fe\u7684\u4e13\u5bb6\u5728\u56fd\u5bb6\u7ea7\u89e3\u91ca\u5168\u7403\u65b9\u6cd5\u3002\u6bcf\u4e2a\u5c0f\u7ec4\u7531\u5f53\u5730\u534f\u8c03\u5458\u9886\u5bfc\uff0c\u5e76\u5f97\u5230\u5730\u7406\u4fe1\u606f\u7cfb\u7edf\u516c\u53f8\u3001\u54a8\u8be2\u56e2\u4f53\u3001\u4ee5\u53ca\u672c\u9879\u76ee\u7684\u4e3b\u8981\u8d44\u52a9\u8005<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">BACP (IFC)</a>\u3001<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">IDH</a>\u30013Fi\u3001<a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">WWF</a>\u548c<a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6208\u767b\u548c\u8d1d\u8482\u00b7\u6469\u5c14\u57fa\u91d1\u4f1a</a>\u7684\u652f\u52a9\u3002", "995180f890c642f44bc8e1440cfdeb58": "\u8fd9\u4e00\u6307\u5357\u662f\u6839\u636e<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u300aRTRS \u751f\u4ea7\u6807\u51c6\u300b(RTRS Production Standard)</a>\u4e2d\u7684\u7b2c 20 \u9875\uff0c\u4e5f\u5373\u9644\u5f55\u7684\u7b2c\u56db\u90e8\u5206\uff0c\u300aRTRS \u8d1f\u8d23\u4efb\u8f6c\u6362\u65b9\u6cd5\u300b(RTRS approach to responsible conversion) \u6765\u5236\u5b9a\u7684\u3002\u5b8f\u89c2\u5730\u56fe\u663e\u793a\u51fa\u4e86\u5728\u300a\u6807\u51c6\u300b\u7684\u300a\u6307\u5357 4\u300b\u4e2d\u4ee5\u53ca\u7528\u4e8e\u8ba4\u5b9a\u53ca\u7ba1\u7406\u201c\u9ad8\u5ea6\u4fdd\u62a4\u4ef7\u503c\u533a\u57df\u201d(High Conservation Value Areas, HCVA) \u7684 HCVA \u8bc4\u4f30\u6307\u5357\u4e2d\u6240\u63cf\u8ff0\u7684\u56db\u79cd\u4e0d\u540c\u7684\u7c7b\u578b\u3002", "6c35f6ba2039d8dbf4428e03ba61169d": "\u73b0\u6709\u7acb\u6cd5\u8db3\u4ee5\u63a7\u5236\u8d1f\u8d23\u4efb\u6269\u5f20\u7684\u533a\u57df\uff08\u901a\u5e38\u662f\u5bf9\u519c\u4e1a\u5177\u6709\u91cd\u8981\u610f\u4e49\u548c\u4fdd\u62a4\u8f83\u4f4e\u7684\u533a\u57df\uff09\u3002", "b05564856b2c8f7e6efee9f52bab3e40": "\u7c7b\u522b\u5982\u4e0b\uff1a", "73e34bfb695fcdb34f638134176adf96": "\u5728\u5bf9\u751f\u7269\u591a\u6837\u6027\u81f3\u5173\u91cd\u8981\u7684\u5730\u533a\uff08\u70ed\u70b9\u5730\u533a\uff09\uff0c\u5229\u76ca\u76f8\u5173\u8005\u4e00\u81f4\u8ba4\u4e3a\uff0c\u4e0d\u5e94\u5c06\u539f\u751f\u5927\u8c46\u53d8\u6210\u8d1f\u8d23\u4efb\u5927\u8c46\u751f\u4ea7\u3002", "eda5510b2aed91fe0164e7a78be4c42c": "\u5728\u5bf9\u751f\u7269\u591a\u6837\u6027\u5177\u6709\u9ad8\u5ea6\u91cd\u8981\u6027\u7684\u5730\u533a\uff0c\u53ea\u6709\u5728 HCVA \u8bc4\u4f30\u5b8c\u6210\u540e\u624d\u80fd\u6269\u5927\u5927\u8c46\u7684\u79cd\u690d\uff0c HCVA \u8bc4\u4f30\u5c06\u786e\u5b9a\u9700\u8981\u4fdd\u62a4\u7684\u5730\u533a\u548c\u53ef\u4ee5\u6269\u5927\u79cd\u690d\u7684\u5730\u533a\u3002", "7d524dbbd262fed66a19ab2cb9539314": "\u5728\u5df2\u8fdb\u884c\u519c\u4e1a\u5f00\u53d1\u7684\u5730\u533a\uff0c\u9664\u6cd5\u5b9a\u50a8\u5907\u4e4b\u5916\u5e76\u65e0\u539f\u751f\u690d\u88ab\uff0c\u56e0\u6b64\u5e76\u6ca1\u505a\u8fdb\u4e00\u6b65\u6269\u5c55\u3002", "8410bce3cc0cabbb4c2479d43dc7e745": "2009\u5e74\u4ee5\u540e\u906d\u5230\u68ee\u6797\u780d\u4f10\u7684\u5730\u533a\u3002", "2e768a9e3370f4f3dc13869f71c7c456": "\u5df2\u8ba4\u8bc1\u7684", "fd98f5bef06abba7ccabae270c3f30f8": "\u672a\u8ba4\u8bc1", "8145fe9e7624a8d20ce479b499ee9328": "RSPO \u4f1a\u5458\u7279\u8bb8\u6743", "426661b82f4df4f887e6309808640396": "\u663e\u793a RSPO \u6210\u5458\u516c\u53f8\u7684\u7279\u8bb8\u6743\u8fb9\u754c\uff0c\u5305\u62ec\u8ba4\u8bc1\u548c\u975e\u8ba4\u8bc1\u7279\u8bb8\u6743\u3002", "4b3f7713634e558fb59aacd939e08eac": "\u53ef\u7528\u4e8e\u5168\u7403 RSPO \u6210\u5458\u7279\u8bb8\u6743\u5b58\u5728\u7684\u4efb\u4f55\u5730\u65b9\u3002 \u76ee\u524d\uff0c\u8ba4\u8bc1\u533a\u57df\u5305\u62ec\uff1a\u5df4\u897f\u3001\u79d1\u7279\u8fea\u74e6\u3001\u67ec\u57d4\u5be8\u3001\u54e5\u4f26\u6bd4\u4e9a\u3001\u54e5\u65af\u8fbe\u9ece\u52a0\u3001\u591a\u7c73\u5c3c\u52a0\u5171\u548c\u56fd\u3001\u5384\u74dc\u591a\u5c14\u3001\u52a0\u84ec\u3001\u52a0\u7eb3\u3001\u5371\u5730\u9a6c\u62c9\u3001\u6d2a\u90fd\u62c9\u65af\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u3001\u5229\u6bd4\u91cc\u4e9a\u3001\u9a6c\u6765\u897f\u4e9a\u3001\u58a8\u897f\u54e5\u3001\u5c3c\u52a0\u62c9\u74dc\u3001\u5df4\u5e03\u4e9a\u65b0\u51e0\u5185\u4e9a\u3001\u79d8\u9c81\u3001 \u585e\u62c9\u5229\u6602\u3001\u6240\u7f57\u95e8\u7fa4\u5c9b\u3001\u6cf0\u56fd\u548c\u591a\u54e5\u3002", "5ba15c4e62d6f75a0fe42a88012a1589": "Roundtable on Sustainable Palm Oil (RSPO) \u6210\u5458\u516c\u53f8", "c730486f0230809240cc3f3e0195b9d4": "\u8fd9\u4e9b\u6570\u636e\u662f\u4ece\u591a\u4e2a\u6765\u6e90\u6c47\u7f16\u7684\uff0c\u4ec5\u4f9b\u8bf4\u660e\u76ee\u7684\u4f7f\u7528\u3002\u5730\u56fe\u7684\u8d28\u91cf\u4f18\u826f\u4e0d\u4e00\uff0c\u6240\u63cf\u7ed8\u7684\u8fb9\u754c\u5e76\u6ca1\u6709\u5bf9\u7ec6\u8282\u8fdb\u884c\u9a8c\u8bc1\u3002", "68b69964f190f785d48d4b94eb853af3": "\u8bf7\u6ce8\u610f\uff0c\u6570\u636e\u96c6\u4e2d\u67d0\u4e9b\u591a\u8fb9\u5f62\u4f1a\u53d1\u751f\u91cd\u53e0\u6216\u91cd\u590d\u3002", "914a3184c16c6560b3adb49c13789c7b": "\u8be5\u6570\u636e\u5c42\u663e\u793a\u4e86\u622a\u81f32017\u5e7412\u6708\uff0c\u53ef\u6301\u7eed\u68d5\u6988\u6cb9\u5706\u684c\u4f1a\u8bae\uff08RSPO\uff09\u6210\u5458\u516c\u53f8\u7684\u7279\u8bb8\u6743\u8fb9\u754c\uff0c\u5305\u62ec\u8ba4\u8bc1\u548c\u975e\u8ba4\u8bc1\u7279\u8bb8\u6743\uff0c\u4ee5\u53ca\u8ba4\u8bc1\u72b6\u6001\u672a\u77e5\u7684\u7279\u8bb8\u6743\u3002\u8fd9\u4e9b\u7279\u8bb8\u6743\u7531RSPO\u7684\u6210\u5458\u516c\u53f8\u63d0\u4f9b\u3002", "fa0a7aa1622ad105e9cdf5a706058333": " \u77f3\u6cb9\u548c\u5929\u7136\u6c14", "53a9002c155ae5518864e6b7465f74c2": "\u663e\u793a\u4e86\u653f\u5e9c\u4e3a\u4f01\u4e1a\u5206\u914d\u7684\u7528\u4e8e\u78b3\u6c22\u5316\u5408\u7269\u3001\u77f3\u6cb9\u53ca\u5929\u7136\u6c14\u52d8\u63a2\u7684\u533a\u57df\u8fb9\u754c\u3002", "103a8d0d487cc884f90518ad226a1288": "\u4f9d\u6765\u6e90\u53d8\u5316", "fdf6c101844b062b99e62e4c74e0d94c": "\u963f\u6839\u5ef7\u3001\u5df4\u897f\u3001\u54e5\u4f26\u6bd4\u4e9a\u3001\u5384\u74dc\u591a\u5c14\u3001\u79d8\u9c81", "cfb8d58eeb0cc5e176a60bdb38c46ca1": "\u963f\u6839\u5ef7\uff1a\u80fd\u6e90\u548c\u77ff\u4e1a\u90e8\u3002\u80fd\u6e90\u89c4\u5212\u534f\u8c03\u90e8\u957f\uff08 Secretary of Coordination of Energy Planning\uff09\u3002 \u56fd\u5bb6\u80fd\u6e90\u4fe1\u606f\u5c40\uff08National Directorate of Energy Information\uff09\u3002", "a9b47339ce89f3b00a1dc256eb8f1709": "\u5df4\u897f\uff1a\u5df4\u897f\u56fd\u5bb6\u77f3\u6cb9\u3001\u5929\u7136\u6c14\u548c\u751f\u7269\u71c3\u6599\u7ba1\u7406\u5c40\uff08Brazilian National Agency of Petroleum, Natural Gas, and Biofuels)\u3002", "d1198e1e96663fbfde834c6b9a6b043a": "\u54e5\u4f26\u6bd4\u4e9a\uff1a\u56fd\u5bb6\u78b3\u6c22\u5316\u5408\u7269\u5c40 (ANH) ", "56b18c81797632df940754073898c392": "\u5384\u74dc\u591a\u5c14\uff1a\u4e0d\u53ef\u518d\u751f\u81ea\u7136\u8d44\u6e90\u90e8\uff08Ministry of Non-Renewable Natural Resources\uff09", "cb8fa487938664fd65be791afe5a7db4": "\u79d8\u9c81\uff1aPetr\u00f3leos del Per\u00fa S.A.", "e7b1cbb40c03a6a9114b3648843e5e1d": "\u963f\u6839\u5ef7\uff1a2015\uff1b \u5df4\u897f\uff1a2017\uff1b \u54e5\u4f26\u6bd4\u4e9a\uff1a2017\uff1b \u5384\u74dc\u591a\u5c14\uff1a2013\uff1b \u79d8\u9c81\uff1a2018", "040c3554b728078ea428edf51756ff18": "\u201c\u77f3\u6cb9\u548c\u5929\u7136\u6c14\u7279\u8bb8\u6743\u201d\u662f\u6307\u653f\u5e9c\u5206\u914d\u7ed9\u52d8\u63a2\u548c\u751f\u4ea7\u77f3\u6cb9\u3001\u5929\u7136\u6c14\u548c\u5176\u4ed6\u78b3\u6c22\u5316\u5408\u7269\u7684\u516c\u53f8\u7684\u533a\u57df\u3002\u8fd9\u4e9b\u9886\u57df\u7684\u672f\u8bed\u56e0\u56fd\u5bb6\u800c\u5f02\u3002\u201c\u7279\u8bb8\u6743\u201d\u662f\u6388\u4e88\u79c1\u8425\u516c\u53f8\u7ba1\u7406\u548c\u5f00\u91c7\u516c\u5171\u571f\u5730\u4e0a\u7684\u77f3\u6cb9\u548c\u5929\u7136\u6c14\u7684\u6743\u5229\u7684\u8bb8\u53ef\u8bc1\u3001\u6267\u7167\u6216\u5176\u4ed6\u5408\u540c\u7684\u603b\u79f0\uff1b\u7136\u800c\uff0c\u6b64\u672f\u8bed\u56e0\u56fd\u5bb6\u800c\u5f02\uff0c\u5305\u62ec\u91c7\u77ff\u6216\u91c7\u77ff\u201c\u8bb8\u53ef\u201d\u3001\u201c\u4f7f\u7528\u6743\u201d\u3001\u201c\u6267\u7167\u201d\u548c\u5176\u4ed6\u8868\u8ff0\u3002", "138a4d3dcbb46c0567eaf4fbcd61881b": "\u6b64\u6570\u636e\u96c6\u5c06\u77f3\u6cb9\u548c\u5929\u7136\u6c14\u7279\u8bb8\u6743\u4f5c\u4e3a\u5355\u4e2a\u56fe\u5c42\u663e\u793a\uff0c\u7531\u591a\u4e2a\u56fd\u5bb6\u7684\u7279\u8bb8\u6743\u6570\u636e\u6c47\u7f16\u800c\u6210\u3002\u6570\u636e\u6e90\u81ea\u653f\u5e9c\u673a\u6784\u3001NGO \u6216\u5176\u4ed6\u7ec4\u7ec7\uff0c\u56e0\u65e5\u671f\u548c\u6570\u636e\u6e90\u4e0d\u540c\u800c\u6709\u53d8\u5316\u3002\u8981\u4e86\u89e3\u6bcf\u4e2a\u56fd\u5bb6\u7279\u8bb8\u6743\u6570\u636e\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u8bbf\u95ee<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Open Data Portal</a>\u3002", "2a81068b0333db166ea982f424ecf807": "\u663e\u793a\u7531\u653f\u5e9c\u5212\u62e8\u7ed9\u79c1\u4eba\u690d\u6797\u516c\u53f8\u7684\u533a\u57df\u7684\u8fb9\u754c\uff0c\u8fd9\u4e9b\u516c\u53f8\u690d\u6797\u7528\u4e8e\u751f\u4ea7\u6728\u6750\u4ee5\u53ca\u6728\u6d46\u7eb8\u548c\u7eb8\u5236\u54c1\u6240\u7528\u7684\u6728\u6d46", "8412a093af5ec2bd8d9d3c93fe07a5b6": "\u76ee\u524d\u9002\u7528\u8303\u56f4\u5305\u62ec\u5370\u5c3c\u3001\u521a\u679c\u5171\u548c\u56fd\u548c\u7802\u62c9\u8d8a\uff08\u9a6c\u6765\u897f\u4e9a\uff09", "0796b5457c2dceff0fe3fc0ecd43761f": "<em>\u5370\u5ea6\u5c3c\u897f\u4e9a\uff1a</em>\u6797\u4e1a\u90e8\u3001Asia Pulp and Paper\u3001APRIL", "38dc9b17e7f786fce3650590f2d5d924": "<em>\u6c99\u635e\u8d8a&amp; \u6c99\u5df4\u5dde\uff0c\u9a6c\u6765\u897f\u4e9a\uff1a</em> Earthsight \u8c03\u67e5&amp; Global Witness", "54d2012b0c6f25fcb3ba12ccc7e84e2e": "\u8fd9\u7ec4\u6570\u636e\u663e\u793a\u4f5c\u4e3a\u5355\u56fe\u5c42\u7684\u6728\u8d28\u7ea4\u7ef4\u7279\u8bb8\u6743\uff0c\u901a\u8fc7\u6c47\u603b\u591a\u56fd\u7279\u8bb8\u6743\u6570\u636e\u751f\u6210\u3002\u8be5\u6570\u636e\u53ef\u80fd\u6765\u81ea\u653f\u5e9c\u673a\u6784\u3001\u975e\u653f\u5e9c\u7ec4\u7ec7\u6216\u5176\u4ed6\u7ec4\u7ec7\uff0c\u968f\u7740\u65e5\u671f\u548c\u6570\u636e\u6e90\u7684\u4e0d\u540c\u800c\u6709\u6240\u53d8\u5316\u3002\u6709\u5173\u6bcf\u4e2a\u56fd\u5bb6\u7279\u8bb8\u6743\u6570\u636e\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u8bbf\u95ee<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5f00\u653e\u5f0f\u6570\u636e\u95e8\u6237</a>\u3002", "a5231a1d0ff1c5a5bed8f0398af758ec": "\u201c\u6728\u8d28\u7ea4\u7ef4\u7279\u8bb8\u6743\u201d\u662f\u6307\u7531\u653f\u5e9c\u6216\u5176\u4ed6\u673a\u6784\u5212\u62e8\u7684\uff0c\u7528\u4ee5\u5efa\u7acb\u5feb\u901f\u589e\u957f\u7684\u68ee\u6797\u79cd\u690d\u56ed\u3001\u8fdb\u800c\u751f\u4ea7\u7eb8\u5f20\u4e0e\u7eb8\u5236\u54c1\u7528\u6728\u6750\u548c\u6728\u6d46\u7684\u5730\u533a\u3002", "5d95eead955dccf748f4f0fd0c76ff56": "\u6b64\u6570\u636e\u4e8e 2019 \u5e74 7 \u6708\u66f4\u65b0 APRIL \u7684\u8fb9\u754c\u3002", "9a9ac0f7b47288a39a113cd487f13800": "\u6309\u7167\u4e0d\u540c\u7684\u540d\u79f0\uff08\u4f8b\u5982\uff0c\u56fd\u5bb6\u516c\u56ed\uff0c\u56fd\u5bb6\u50a8\u5907\u548c\u91ce\u751f\u52a8\u7269\u4fdd\u62a4\u533a\uff09\u663e\u793a\u88ab\u4f9d\u6cd5\u4fdd\u62a4\u548c\u7ba1\u7406\u7684\u533a\u57df\uff0c\u4ee5\u5b9e\u73b0\u4fdd\u62a4\u7684\u76ee\u7684\u3002", "d06b84687815109842bedc75977b1a37": "\u4e16\u754c\u4fdd\u62a4\u533a\u6570\u636e\u5e93\uff0c\u6c47\u603b\u4e86\u6765\u81ea\u4e8e\u653f\u5e9c\u3001NGO \u7ec4\u7ec7\u548c\u56fd\u9645\u79d8\u4e66\u5904\u7684\u6570\u636e", "265a45a3cdafc4d0622d923098fb6e23": "\u968f\u4fdd\u62a4\u533a\u53d8\u5316", "be92c62702dcec6751c101b5adb0ce3b": "\u6309\u5b63\u5ea6", "0315895def9c96d90831926b2d7a019c": "\u4fdd\u62a4\u533a\u57df\u540d\u79f0\uff0c\u4f8b\u5982\u201c\u56fd\u5bb6\u516c\u56ed\u201d\uff0c\u53ef\u5728\u4e0d\u540c\u56fd\u5bb6\u6307\u4ee3\u4e0d\u540c\u533a\u57df\uff0c\u5e76\u4e14\u4e0e\u5176\u76f8\u5173\u7684\u56fd\u9645\u81ea\u7136\u4fdd\u62a4\u8054\u76df\u5f52\u7c7b\u4e5f\u6709\u53ef\u80fd\u4ea7\u751f\u4e0d\u540c\u3002WDPA \u4ec5\u5c06\u6536\u96c6\u7b26\u5408\u56fd\u9645\u81ea\u7136\u4fdd\u62a4\u8054\u76df<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4fdd\u62a4\u533a\u57df\u5b9a\u4e49</a>\u7684\u533a\u57df\u7684\u6570\u636e\uff0c\u6240\u4ee5\u8be5\u6570\u636e\u6709\u53ef\u80fd\u4e0e\u56fd\u5bb6\u5c42\u7ea7\u7684\u4fdd\u62a4\u533a\u57df\u6570\u636e\u4ea7\u751f\u5dee\u5f02\u3002", "ff566cb049cff5a10049e100d0be79e7": "\u6ca1\u6709\u8fb9\u754c\u6570\u636e\u7684\u53d7\u4fdd\u62a4\u533a\u57df\u7531\u4e00\u4e2a\u65b9\u6846\u663e\u793a\uff0c\u8fd9\u4e2a\u65b9\u6846\u4ee3\u8868\u4e86\u53d7\u4fdd\u62a4\u533a\u57df\u7684\u4e0a\u62a5\u9762\u79ef\u3002\u8fd9\u4e2a\u65b9\u6846\u4e2d\u5fc3\u662f\u4e00\u4e2a\u5355\u70b9\u4f4d\u7f6e\uff0c\u5b83\u7684\u8fb9\u754c\u5e76\u4e0d\u4ee3\u8868\u4fdd\u62a4\u533a\u7684\u5b9e\u9645\u8fb9\u754c\u3002", "644ecd9c74981208070702603764e6e4": "\u4fdd\u62a4\u533a\u5168\u7403\u6570\u636e\u5e93(WDPA)\u662f\u73b0\u6709\u7684\u5173\u4e8e\u6d77\u6d0b\u548c\u9646\u5730\u4fdd\u62a4\u533a\u7684\u6700\u5168\u9762\u5168\u7403\u6570\u636e\u96c6\u3002\u4fdd\u62a4\u533a\u6570\u636e\u901a\u8fc7 WDPA \u7684\u5728\u7ebf\u754c\u9762 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4fdd\u62a4\u5730\u7403</a>\u63d0\u4f9b\u3002WDPA \u8ba1\u5212\u662f\u7531 IUCN \u548c UNEP-WCMC \u8054\u5408\u53d1\u8d77\u7684\uff0c\u65e8\u5728\u7f16\u64b0\u4fdd\u62a4\u533a\u7684\u7a7a\u95f4\u53c2\u8003\u4fe1\u606f\u3002", "e1a5f32680f3f1a813ca1b274217872c": "\u5f53\u60a8\u70b9\u51fb\u8be5\u56fe\u5c42\u4e0a\u7684\u4fdd\u62a4\u533a\u65f6\uff0c\u6ce8\u610f\u201c\u6cd5\u5f8b\u540d\u79f0\u201d\u548c\u4e0b\u65b9\u89e3\u91ca\uff0c\u4ee5\u4fbf\u66f4\u597d\u5730\u7406\u89e3\u67d0\u4e2a\u5730\u533a\u7684\u53d7\u4fdd\u62a4\u7a0b\u5ea6\u3002", "3426a895052063abe7a61aa2dcf390cf": "<em> \u5229\u6bd4\u91cc\u4e9a\uff1a</em> \u5168\u7403\u89c1\u8bc1", "8c584392a35f96b2c7bbc2be69a19b4c": "\u5e76\u975e\u6240\u6709\u4fdd\u62a4\u533a\u90fd\u53d7\u5230\u540c\u7b49\u7a0b\u5ea6\u7684\u4fdd\u62a4\u3002\u90e8\u5206\u6709\u7740\u4e25\u683c\u7684\u6307\u5bfc\u65b9\u9488\uff0c\u4f7f\u751f\u6001\u7cfb\u7edf\u4fdd\u6301\u5b8c\u597d\uff0c\u53e6\u4e00\u90e8\u5206\u5219\u5141\u8bb8\u53ef\u6301\u7eed\u7684\u571f\u5730\u4f7f\u7528\uff0c\u901a\u5e38\u5305\u542b\u6709\u9650\u7684\u8d44\u6e90\u5f00\u91c7\u3002\u6b64\u5916\uff0c\u5e76\u975e\u6240\u6709\u56fd\u5bb6\u5728\u6307\u5b9a\u4fdd\u62a4\u533a\u65f6\u90fd\u4f7f\u7528\u76f8\u540c\u7684\u672f\u8bed\u3002\u56e0\u6b64\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u9645\u81ea\u7136\u4fdd\u62a4\u8054\u76df</a>\u5b9a\u4e49\u4e86\u901a\u7528\u7684\u7ba1\u7406\u7c7b\u522b\uff0c\u89c4\u5b9a\u4e86\u5927\u90e8\u5206\u4fdd\u62a4\u533a\u7684\u4fdd\u62a4\u7a0b\u5ea6\u3002", "40341b681b4e8999adf9342cf73818e6": "<em>\u521a\u679c\u5171\u548c\u56fd\uff1a</em> \u6797\u4e1a\u7ecf\u6d4e\u90e8 &amp; WRI", "54224c18a9c6958fd8d30e9b958a23cd": "<strong>Ia. \u4e25\u683c\u7684\u81ea\u7136\u4fdd\u62a4\u533a\u3002</strong>\u4fdd\u62a4\u533a\u65e8\u5728\u4fdd\u62a4\u751f\u7269\u591a\u6837\u6027\u548c\u6240\u6709\u5730\u8d28\u7279\u5f81\u3002\u5141\u8bb8\u53d7\u9650\u7684\u4eba\u529b\u4f7f\u7528\uff08\u4f8b\u5982\uff0c\u79d1\u5b66\u7814\u7a76\u3001\u6559\u80b2\uff09\uff0c\u5e76\u53d7\u5230\u4e25\u683c\u76d1\u6d4b\u3002\u7531\u4e8e\u53d7\u5230\u4e86\u9ad8\u5ea6\u4fdd\u62a4\uff0c\u4e25\u683c\u7684\u81ea\u7136\u4fdd\u62a4\u533a\u5f80\u5f80\u7528\u6765\u4e86\u89e3\u95f4\u63a5\u4eba\u4e3a\u5e72\u6270\u9020\u6210\u7684\u5f71\u54cd\uff08\u4f8b\u5982\uff0c\u71c3\u70e7\u5316\u77f3\u71c3\u6599\uff09\u3002\u5176\u5b83\u5e38\u7528\u7684\u547d\u540d\uff1a\u751f\u7269\u4fdd\u62a4\u533a\u3001\u690d\u7269\u4fdd\u62a4\u533a\u3002", "5e5cad9b5ad6d4048c1766349312e48b": "<strong>Ib. \u81ea\u7136\u4fdd\u62a4\u533a\u3002</strong> \u4fdd\u62a4\u533a\u6210\u529f\u4fdd\u62a4\u751f\u6001\u7cfb\u7edf\u8fc7\u7a0b\uff0c\u5e76\u4e14\u53ea\u6709\u6709\u9650\u7684\u4eba\u7c7b\u4f7f\u7528\u3002\u81ea\u7136\u4fdd\u62a4\u533a\u4e0d\u80fd\u5305\u542b\u73b0\u4ee3\u57fa\u7840\u8bbe\u65bd\uff08\u5982\u6e38\u5ba2\u4e2d\u5fc3\uff09\uff0c\u4f46\u662f\u5141\u8bb8\u5f53\u5730\u571f\u8457\u7fa4\u843d\u4fdd\u6301\u8d56\u4ee5\u751f\u5b58\u7684\u751f\u6d3b\u65b9\u5f0f\u3002\u8fd9\u4e9b\u5730\u533a\u7684\u5efa\u7acb\u901a\u5e38\u7528\u6765\u6062\u590d\u53d7\u5e72\u6270\u7684\u73af\u5883\u3002\u5176\u4ed6\u5e38\u89c1\u540d\u79f0\uff1a\u8352\u91ce\u4fdd\u62a4\u533a\u3001\u91ce\u751f\u52a8\u7269\u5730\u533a", "65a0e7d4561efcf8c52caabd6285963f": "<strong>II. \u56fd\u5bb6\u516c\u56ed\u3002</strong> \u65e8\u5728\u4fdd\u62a4\u5927\u89c4\u6a21\u7684\u751f\u6001\u7cfb\u7edf\u5e76\u652f\u6301\u4eba\u7c7b\u53c2\u89c2\u7684\u4fdd\u62a4\u533a\u3002\u8fd9\u4e9b\u533a\u57df\u4ee5\u4fdd\u80b2\u4e3a\u4e3b\uff0c\u5141\u8bb8\u57fa\u7840\u8bbe\u65bd\u7684\u5efa\u8bbe\uff0c\u5e76\u901a\u8fc7\u63d0\u4f9b\u73af\u5883\u6559\u80b2\u548c\u5a31\u4e50\u7684\u673a\u4f1a\u6765\u4fc3\u8fdb\u5f53\u5730\u7ecf\u6d4e\u53d1\u5c55\u3002\u5176\u4ed6\u5e38\u89c1\u7684\u540d\u79f0\uff1a\u5dde\u7acb\u516c\u56ed\u3001A \u7c7b\u516c\u56ed\u3001\u516c\u56ed\u4fdd\u62a4\u533a\u3001\u7701\u7acb\u516c\u56ed", "b927a067fa879b8f62f71eaf62354927": "<strong>III. \u56fd\u5bb6\u53e4\u8ff9\u6216\u5730\u8c8c\u3002</strong>\u5730\u533a\u786e\u7acb\u7528\u4ee5\u4fdd\u62a4\u7279\u5b9a\u7684\u81ea\u7136\u5730\u8c8c\uff08\u5982\u6d1e\u7a74\u3001\u5c0f\u6811\u6797\uff09\u6216\u6709\u7740\u660e\u663e\u7684\u5386\u53f2\u3001\u7cbe\u795e\u6216\u73af\u5883\u91cd\u8981\u6027\u548c\u5468\u56f4\u73af\u5883\u7684\u4eba\u9020\u53e4\u8ff9\u3002\u56e0\u6b64\uff0c\u81ea\u7136\u53e4\u8ff9\u6216\u5730\u8c8c\u5728\u5730\u533a\u5185\u901a\u5e38\u4f1a\u8f83\u5c0f\u4e14\u53d7\u7740\u6765\u81ea\u65c5\u5ba2\u6d41\u91cf\u7684\u9ad8\u5ea6\u4eba\u7c7b\u5f71\u54cd\u3002\u5176\u5b83\u5e38\u89c1\u7684\u547d\u540d\uff1a\u81ea\u7136\u5730\u8c8c\u4fdd\u62a4\u533a\u3001\u81ea\u7136\u53e4\u8ff9\u3001\u690d\u7269\u56ed\u3002", "ef217a6297ca0fc12dc9d8729ee8b92a": "<strong> IV. \u52a8\u690d\u7269\u6816\u606f\u5730\u548c\u7269\u79cd\u7ba1\u7406\u533a\u3002</strong>\u8fd9\u4e00\u533a\u57df\u65e8\u5728\u4fdd\u62a4\u7279\u5b9a\u7684\u91ce\u751f\u52a8\u7269\u79cd\u7fa4\u548c/\u6216\u6816\u606f\u5730\u3002\u52a8\u690d\u7269\u6816\u606f\u5730\u548c\u7269\u79cd\u7ba1\u7406\u533a\u7ecf\u5e38\u5b58\u5728\u4e8e\u8f83\u5927\u7684\u751f\u6001\u7cfb\u7edf\u6216\u4fdd\u62a4\u533a\u4e4b\u5185\uff0c\u5e76\u53d7\u5230\u8ba4\u771f\u7ba1\u7406\uff08\u4f8b\u5982\uff0c\u901a\u8fc7\u72e9\u730e\u51cf\u5c11\u6216\u6816\u606f\u5730\u7684\u6062\u590d\uff09\u6765\u4fdd\u62a4\u76ee\u6807\u7269\u79cd\u6216\u6816\u606f\u5730\u3002\u5176\u4ed6\u5e38\u89c1\u7684\u540d\u79f0\uff1a\u56fd\u5bb6\u91ce\u751f\u52a8\u7269\u4fdd\u62a4\u533a\uff0c\u56fd\u5bb6\u91ce\u751f\u52a8\u7269\u7ba1\u7406\u533a\uff0c\u52a8\u7269\u4fdd\u62a4\u533a\uff0cZakaznik\uff08\u4fc4\u7f57\u65af\uff09\uff0c\u7701\u7ea7\u81ea\u7136\u4fdd\u62a4\u533a\uff0c\u91ce\u751f\u52a8\u7269\u4fdd\u62a4\u533a", "82a4e394f2f327bd23aaab3019fe57a4": "<strong> V. \u4fdd\u62a4\u666f\u89c2\u548c\u6d77\u666f\u3002</strong>\u5728\u751f\u6001\u5b66\u3001\u751f\u7269\u5b66\u3001\u6587\u5316\u65b9\u9762\u5177\u6709\u91cd\u8981\u4ef7\u503c\uff0c\u5e76\u7531\u4eba\u7c7b\u5bf9\u666f\u89c2\u7684\u4f7f\u7528\u800c\u5f62\u6210\u7684\u53d7\u4fdd\u62a4\u533a\u57df\u3002\u4fdd\u62a4\u666f\u89c2\u548c\u6d77\u666f\u901a\u5e38\u5305\u62ec\u6574\u7247\u9646\u5730\u6216\u6d77\u6d0b\uff0c\u5141\u8bb8\u6309\u8be5\u5730\u533a\u7684\u7ba1\u7406\u8ba1\u5212\u8fdb\u884c\u5546\u4e1a\u7ecf\u8425\u6027\u6d3b\u52a8\uff08\u4f8b\u5982\u751f\u6001\u65c5\u6e38\uff09\u3002\u5176\u5b83\u5e38\u89c1\u547d\u540d\uff1a\u56fd\u5bb6\u68ee\u6797\u516c\u56ed\u3001\u56fd\u5bb6\u81ea\u7136\u533a\u57df\u3001\u73af\u5883\u4fdd\u62a4\u533a\u3001\u4fdd\u62a4\u533a\u3001\u51c6\u56fd\u5bb6\u516c\u56ed\uff08\u65e5\u672c\uff09\u3001\u81ea\u7136\u4fdd\u62a4\u533a\u3001\u56fd\u5bb6\u81ea\u7136\u533a\u57df", "1597f537d812d11a153d63e2c3529249": "<strong>VI. \u5177\u6709\u53ef\u6301\u7eed\u5229\u7528\u81ea\u7136\u8d44\u6e90\u7684\u4fdd\u62a4\u533a\u3002</strong>\u76ee\u7684\u4e3a\u7ba1\u7406\u81ea\u7136\u8d44\u6e90\u548c\u7ef4\u6301\u9644\u8fd1\u793e\u533a\u751f\u8ba1\u7684\u533a\u57df\u3002\u8fd9\u4e9b\u5730\u533a\u4eba\u7c7b\u6570\u91cf\u8f83\u5c11\u3001\u53ea\u6709\u5c0f\u89c4\u6a21\u5f00\u53d1\uff08\u5373\uff0c\u975e\u7528\u4e8e\u5de5\u4e1a\u7684\uff09\u4ee5\u53ca\u666f\u89c2\u7684\u4e00\u90e8\u5206\u8fd8\u4fdd\u6301\u81ea\u7136\u72b6\u6001\u3002\u5176\u5b83\u5e38\u89c1\u7684\u76ee\u7684\uff1a\u91ce\u751f\u751f\u7269\u4fdd\u62a4\u533a\u3001\u751f\u7269\u5708\u4fdd\u62a4\u533a\u3001\u68ee\u6797\u4fdd\u62a4\u533a\u3001\u4fdd\u62a4\u533a\u3001\u56fd\u5bb6\u68ee\u6797\u3001\u81ea\u7136\u548c\u56fd\u5bb6\u4fdd\u62a4\u533a\u3001\u4fdd\u7559\u533a\u3001\u591a\u7528\u9014\u4fdd\u62a4\u533a\u3001\u5730\u65b9\u4fdd\u62a4\u533a", "87d453935967c64c96658382310e0651": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">UNESCO-MAP \u751f\u7269\u5708\u4fdd\u62a4\u533a</a>\uff1a\u8054\u5408\u56fd\u6559\u79d1\u6587\u7ec4\u7ec7\u7684\u4eba\u4e0e\u751f\u7269\u5708\u9879\u76ee\u6307\u5b9a\u7684\u5730\u533a\uff0c\u65e8\u5728\u201c\u57fa\u4e8e\u5f53\u5730\u793e\u533a\u7684\u52aa\u529b\u548c\u5408\u7406\u7684\u79d1\u5b66\u6765\u4fc3\u8fdb\u53ef\u6301\u7eed\u53d1\u5c55\u3002\u201d", "f5cd3194214b8cc06783aedd250fae00": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4e16\u754c\u9057\u4ea7</a>\uff1a\u88ab\u8ba4\u4e3a\u5177\u6709\u201c\u7a81\u51fa\u666e\u904d\u4ef7\u503c\u201d\uff0c\u6ee1\u8db3\u5341\u9879\u6807\u51c6\u4e2d\u7684\u81f3\u5c11\u4e00\u4e2a\uff0c\u63cf\u8ff0<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\"> \u5982\u4e0b</a>\u3002", "862d9e92cffecc458073ed79dd8cd2ad": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u62c9\u59c6\u8428\u5c14\u2014\u2014\u5177\u6709\u56fd\u9645\u91cd\u8981\u6027\u7684\u6e7f\u5730</a>\uff1a\u6839\u636e\u300a\u62c9\u59c6\u8428\u5c14\u6e7f\u5730\u516c\u7ea6\u300b\u6307\u5b9a\u7684\u5177\u6709\u91cd\u8981\u4ef7\u503c\u7684\u6e7f\u5730\u3002", "a76abed7056a6d98146c86e423e662b2": "Ia - \u4e25\u683c\u81ea\u7136\u4fdd\u62a4\u533a", "d4a6d6cad14a51b0d1e4a29f345a321e": "Ib - \u8352\u91ce\u4fdd\u62a4\u533a", "0e1c1f6588d3ead2796acca6bb0f1041": "II  -\u56fd\u5bb6\u516c\u56ed", "d5b2cb1b833f77b7461d5cc7c49f376e": "III -\u56fd\u5bb6\u7ea7\u666f\u533a\u6216\u5730\u8c8c\u7279\u5f81", "83703fd694f3100d0fb4e3640274cae9": "IV\u2014\u2014\u751f\u5883\u53ca\u7269\u79cd\u4fdd\u62a4\u7ba1\u7406\u533a", "24547a6bd0ab6cd208f04e3891ad992b": "5\u2014\u2014\u53d7\u4fdd\u62a4\u7684\u9646\u5730\u666f\u89c2\u6216\u6d77\u6d0b\u666f\u89c2", "e008f65387c79ceefab14fa0d4f8de45": "VI\u2014\u2014\u81ea\u7136\u8d44\u6e90\u53ef\u6301\u7eed\u5229\u7528\u4fdd\u62a4\u533a", "e681a3b45989b468533c4b90ee960bf9": "\u4e0d\u9002\u7528", "63d8c71daa2adfb569eb9c363eaa7a89": "\u672a\u5206\u914d", "54812c3b7d884570c817d55fe8a23e9e": "\u672a\u62a5\u544a", "cd4e92069b500a7205186cd75d8f51ad": "\u4e3b\u8981\u6c34\u575d\u2014\u20142014 \u5e74", "431accab7897f05b0424e002ca30391d": "\u8fd0\u4f5c\u7684", "a3039cecfced535754ada64c5baa56e1": "\u5efa\u8bbe\u4e2d", "4dc96e9e1d76b2a716920fa41c1630fa": "\u5df2\u8ba1\u5212", "789c478171d2a31a6a99cb5cfd9a5a39": "\u5217\u5165\u6e05\u5355\u7684", "8bf906833cc7aea8084f552217ed9c1d": "\u6682\u505c", "1a95410cecc881f4d0cdb131adb93920": "\u786e\u5b9a\u4e16\u754c 50 \u4e2a\u4e3b\u8981\u6d41\u57df\u7684\u5927\u575d\u4f4d\u7f6e", "78c4a90831ef71605c6bee23fd91113b": "\u672c\u6570\u636e\u96c6\u5e76\u975e\u5168\u7403\u6027\u6570\u636e\u96c6\u3002\u672c\u6570\u636e\u4ec5\u9650\u4e8e\u4e16\u754c 50 \u5927\u4e3b\u8981\u6d41\u57df\u3002", "baebb09b100091a636e9ff0d375793e1": "\u5927\u575d\u6570\u636e\u7531<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u9645\u6cb3\u6d41\u7ec4\u7ec7 (International Rivers) </a>\u5229\u7528\u591a\u4e2a\u6570\u636e\u6e90\u6c47\u7f16\u800c\u6210\uff0c\u5305\u62ec\uff1a<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5168\u7403\u6c34\u5e93\u5927\u575d (GRanD) \u6570\u636e\u5e93</a>\u3001\u56fd\u9645\u519c\u4e1a\u7814\u7a76\u987e\u95ee\u5c0f\u7ec4 (CGIAR) <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6e44\u516c\u6cb3\u6c34\u4e0e\u98df\u7269\u6311\u6218\u8ba1\u5212</a>\uff08\u4ec5\u9488\u5bf9\u6e44\u516c\u6cb3\u6d41\u57df\u5927\u575d\uff09\u3001<a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u7f8e\u56fd\u56fd\u5bb6\u6c34\u575d\u6570\u636e\u5e93 (NID) </a>\u3001\u5176\u4ed6\u653f\u5e9c\u6c34\u575d\u6570\u636e\u5e93\u4ee5\u53ca\u7531\u56fd\u9645\u6cb3\u6d41\u7ec4\u7ec7\u641c\u96c6\u7684\u539f\u59cb\u6570\u636e\u96c6\u3002", "470e4d772b40b437c8fd0fc2a869cf4d": "\u968f\u7740\u65b0\u6570\u636e\u53d8\u5f97\u53ef\u7528", "8b3b3f0530a124994647ec4f81441733": "\u6570\u636e\u7ed3\u679c\u504f\u5411\u4e8e\u516c\u5f00\u53ef\u5f97\u7684\u6570\u636e\uff0c\u6240\u4ee5\u53ef\u80fd\u4f1a\u5b58\u5728\u4e0d\u4e00\u81f4\u3002", "a44e528dbe7b47c37960a0a48775878a": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4e16\u754c\u6cb3\u6d41\u73b0\u72b6</a>\u662f\u4e00\u4e2a\u4e92\u52a8\u7684\u7f51\u7edc\u6570\u636e\u5e93\uff0c\u5b83\u9610\u660e\u4e86\u4e16\u754c\u4e0a 50 \u6761\u4e3b\u8981\u6cb3\u6d41\u6d41\u57df\u7684\u751f\u6001\u5065\u5eb7\u7684\u6570\u636e\u3002\u751f\u6001\u7cfb\u7edf\u5065\u5eb7\u7684\u6307\u6807\u6309\u7167\u7c7b\u522b\u5f52\u7eb3\u4e3a\u6cb3\u6d41\u65ad\u6d41\u3001\u751f\u6001\u591a\u6837\u6027\u548c\u6c34\u8d28\u3002\u6b64\u6570\u636e\u5e93\u662f 2014 \u5e74\u7531\u56fd\u9645\u6cb3\u6d41\u7ec4\u7ec7\u521b\u5efa\u548c\u53d1\u5e03\u7684\u3002", "d07e8504e23a9fc20ab324ed13973ecc": "\u6c34\u575d\u70ed\u70b9\u6570\u636e\u5305\u542b\u8d85\u8fc7 5,000 \u4e2a\u6c34\u575d\u7684\u4f4d\u7f6e\uff0c\u8fd9\u4e9b\u4f4d\u7f6e\u7531\u7ecf\u7eac\u5ea6\u5750\u6807\u786e\u5b9a\u3002\u8fd9\u4e9b\u4f4d\u7f6e\u9650\u4e8e\u4e16\u754c\u4e0a 50 \u6761\u4e3b\u8981\u6cb3\u6d41\u6d41\u57df\u3002\u6b64\u6570\u636e\u96c6\u6709\u591a\u4e2a\u6765\u6e90\uff0c\u5e76\u4e14\u4fee\u6b63\u4e86\u56fd\u9645\u6cb3\u6d41\u7684\u4f4d\u7f6e\u9519\u8bef\u3002\u201c\u9879\u76ee\u72b6\u6001\u201d\u2014\u2014\u4e00\u4e2a\u53d8\u5316\u7684\u76ee\u6807\u2014\u2014\u6839\u636e\u4e0d\u65ad\u83b7\u5f97\u653f\u5e9c\u5b98\u65b9\u6570\u636e\u548c\u4e3b\u8981\u901a\u8fc7\u4f2f\u514b\u5229\u548c\u4e94\u4e2a\u56fd\u9645\u6cb3\u6d41\u7684\u5730\u533a\u529e\u516c\u5ba4\u7684\u7814\u7a76\u6765\u51b3\u5b9a\u3002<br>* \u6b63\u5728\u8fd0\u8f6c\u7684\uff1a\u5df2\u7ecf\u5b58\u5728\u7684\u6c34\u575d\u3002<br>* \u6b63\u5728\u5efa\u9020\u7684\uff1a\u73b0\u5728\u6b63\u5728\u5efa\u8bbe\u4e2d\u7684\u6c34\u575d\u3002<br>* \u8ba1\u5212\u5b8c\u6210\u7684\uff1a\u6c34\u575d\u7684\u7814\u7a76\u548c\u8bb8\u53ef\u5df2\u7ecf\u5b8c\u6210\uff0c\u4f46\u8fd8\u6ca1\u5f00\u59cb\u5efa\u8bbe\u7684\u3002<br>* \u6b63\u5728\u51c6\u5907\u4e2d\u7684\uff1a\u6c34\u575d\u53ef\u80fd\u7684\u4f4d\u7f6e\u5df2\u7ecf\u9009\u5b9a\uff0c\u4f46\u8fd8\u6ca1\u6709\u8fdb\u884c\u7814\u7a76\uff0c\u8bb8\u53ef\u8fd8\u6ca1\u6709\u529e\u7406\u3002<br>* \u505c\u6b62\u7684\uff1a\u6c34\u575d\u5df2\u7ecf\u6682\u65f6\u6216\u8005\u6c38\u4e45\u7684\u505c\u6b62\u3001\u5931\u6548\u3001\u53d6\u6d88\u6216\u8005\u64a4\u9500\u3002<br>* \u672a\u77e5\uff1a\u76ee\u524d\u6ca1\u6709\u53ef\u7528\u7684\u8d44\u6599\u3002", "2f3e3b2abeb1ac0bf46a246449a5ee9f": "\u521a\u679c\u76c6\u5730\u4f10\u6728\u9053\u8def\u2014\u2014 2014 \u5e74", "444cb1134d9d756cc6c415ab79fff688": "\u663e\u793a\u521a\u679c\u76c6\u5730\u5185\u780d\u4f10\u9053\u8def\u7684\u8303\u56f4", "e2ae27b62e834f1adbb27a095c9244de": "\u521a\u679c\u76c6\u5730", "6c25e6a6da95b3d583c6ec4c3f82ed4d": "\u6bcf\u5468", "fb270f466525a34bd97b12961ad16b31": "\u6570\u636e\u4ecd\u7136\u662f\u4e0d\u5b8c\u6574\u7684\uff0c\u5f53\u524d\u5e76\u4e0d\u662f\u6240\u6709\u7684\u9053\u8def\u90fd\u88ab\u6807\u8bb0\u4e86\u65e5\u671f\u3002", "017692f1c92b5c0f1490098f7dfeea1a": "\u4f10\u6728\u9053\u8def\u901a\u5e38\u662f\u68ee\u6797\u780d\u4f10\u548c\u68ee\u6797\u9000\u5316\u7684\u7b2c\u4e00\u6b65\uff0c\u4f46\u5b83\u4eec\u4e00\u822c\u90fd\u662f\u8fdc\u7a0b\u7684\u4e14\u53ea\u662f\u96f6\u661f\u4f7f\u7528\uff0c\u8fd9\u8ba9\u5b83\u4eec\u5f88\u96be\u88ab\u76d1\u63a7\u3002\u7531 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Moabi</a> \u548c\u5168\u7403\u68ee\u6797\u76d1\u5bdf\u7ec4\u7ec7 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\"> \u53d1\u8d77\u7684\u4f10\u6728\u9053\u8def </a> \u5021\u8bae\uff0c\u4f7f\u7528\u4f17\u5305\u548c\u7531 <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\"> \u5f00\u653e\u5f0f\u8857\u9053\u5730\u56fe </a> \u548c <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\"> \u4eba\u9053\u4e3b\u4e49\u5f00\u653e\u5f0f\u8857\u9053\u5730\u56fe\u56e2\u961f (HOT) </a> \u5f00\u53d1\u7684\u5de5\u5177\u6765\u8bc6\u522b\u548c\u76d1\u63a7\u521a\u679c\u6d41\u57df\u4f10\u6728\u9053\u8def\u7684\u4f20\u64ad\u3002\u5fd7\u613f\u8005\u4f7f\u7528\u536b\u661f\u56fe\u50cf\u8ddf\u8e2a\u9053\u8def\uff0c\u5e76\u786e\u5b9a\u9053\u8def\u51fa\u73b0\u7684\u65e5\u671f\u3002", "9c513537868f599d5dedfadeb97992a9": "\u63cf\u7ed8\u5168\u4e16\u754c\u90e8\u5206\u56fd\u5bb6\u7684\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730\uff0c\u6309\u6cd5\u5f8b\u627f\u8ba4\u5730\u4f4d\u5206\u7c7b\u3002", "7c09b9e24ce23439f0ca6d5e5608c671": "\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730", "89d64c3590e5bfa26682bd646a7c40d5": "\u76ee\u524d\u53ef\u7528\u4e8e\u963f\u5bcc\u6c57\u3001\u5b89\u63d0\u74dc\u548c\u5df4\u5e03\u8fbe\u3001\u963f\u6839\u5ef7\u3001\u6fb3\u5927\u5229\u4e9a\u3001\u4f2f\u5229\u5179\u3001\u54e5\u65af\u8fbe\u9ece\u52a0\u3001\u8428\u5c14\u74e6\u591a\u3001\u5371\u5730\u9a6c\u62c9\u3001\u6d2a\u90fd\u62c9\u65af\u3001\u58a8\u897f\u54e5\u3001\u5c3c\u52a0\u62c9\u74dc\u3001\u5df4\u62ff\u9a6c\u3001\u73bb\u5229\u7ef4\u4e9a\u3001\u535a\u8328\u74e6\u7eb3\u3001\u5df4\u897f\u3001\u67ec\u57d4\u5be8\u3001\u52a0\u62ff\u5927\u3001\u667a\u5229\u3001\u54e5\u4f26\u6bd4\u4e9a\u3001\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u3001 \u5384\u74dc\u591a\u5c14\u3001\u6cd5\u5c5e\u572d\u4e9a\u90a3\u3001\u683c\u9675\u5170\u3001\u572d\u4e9a\u90a3\u3001\u5370\u5ea6\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u3001\u4f0a\u6717\u3001\u7231\u5c14\u5170\u3001\u80af\u5c3c\u4e9a\u3001\u9a6c\u6765\u897f\u4e9a\u3001\u58a8\u897f\u54e5\u3001\u83ab\u6851\u6bd4\u514b\u3001\u7eb3\u7c73\u6bd4\u4e9a\u3001\u5c3c\u6cca\u5c14\u3001\u65b0\u897f\u5170\u3001\u5c3c\u52a0\u62c9\u74dc\u3001\u5df4\u62c9\u572d\u3001\u79d8\u9c81\u3001\u83f2\u5f8b\u5bbe\u3001\u5357\u975e\u3001\u897f\u73ed\u7259\u3001\u82cf\u91cc\u5357\u3001\u53f0\u6e7e\u3001\u5766\u6851\u5c3c\u4e9a \u3001\u82f1\u56fd\u3001\u7f8e\u56fd\u3001\u59d4\u5185\u745e\u62c9\u3001\u8d5e\u6bd4\u4e9a\u548c\u6d25\u5df4\u5e03\u97e6\u3002", "81647acbe59b12afef91268004063c83": "\u8bf7\u5728 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">LandMark</a> \u4e0a\u67e5\u770b\u5b8c\u6574\u7684\u6570\u636e\u63d0\u4f9b\u65b9\u540d\u5355\u3002", "224ab98f0715dcd8497dec20e4a7028e": "\u8fd9\u4e9b\u6570\u636e\u6536\u96c6\u81ea\u5404\u7c7b\u8d21\u732e\u8005\u548c\u6765\u6e90\u3002\u53ea\u6709\u6765\u81ea\u653f\u5e9c\u3001\u4e13\u5bb6\u4e2a\u4eba\u548c\u5728\u571f\u5730\u6743\u754c\u83b7\u5f97\u8ba4\u53ef\u7684\u6210\u719f\u6c11\u95f4\u56e2\u4f53\u7ec4\u7ec7\u7684\u6570\u636e\u624d\u4f1a\u663e\u793a\u5728\u8fd9\u4e2a\u5e73\u53f0\u4e0a\u3002\u5373\u4f7f\u67d0\u4e2a\u56fd\u5bb6\u53ef\u80fd\u6ca1\u6709\u5728\u8fd9\u4e2a\u6570\u636e\u96c6\u4e2d\u7eb3\u5165\u56fd\u5bb6\u6216\u793e\u533a\u7ea7\u6570\u636e\uff0c\u539f\u4f4f\u6c11\u548c\u793e\u533a\u4ecd\u53ef\u80fd\u5728\u8be5\u56fd\u62e5\u6709\u6216\u4f7f\u7528\u571f\u5730\u3002\u6ca1\u6709\u6570\u636e\u5e76\u4e0d\u8868\u793a\u6ca1\u6709\u539f\u4f4f\u6c11\u6216\u793e\u533a\u571f\u5730\u3002", "091ebff83824907a1ec238127a914730": "\u56e0\u6765\u6e90\u800c\u5f02\u3002\u70b9\u51fb<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u4e86\u89e3\u6709\u5173\u8bbf\u95ee LandMark \u6570\u636e\u7684\u8be6\u7ec6\u4fe1\u606f\u3002", "b690b28d29e5c34a440962bac3af3f93": "LandMark \u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730\u6570\u636e\u96c6\u662f\u96c6\u5408\u5730\u65b9\u3001\u56fd\u5bb6\u548c\u533a\u57df\u56e2\u4f53\u4f17\u591a\u52aa\u529b\u7684\u7ed3\u679c\u3002\u539f\u4f4f\u6c11\u571f\u5730\u662f\u6307\u539f\u4f4f\u6c11\uff08\u81ea\u8ba4\u8eab\u4efd\uff09\u96c6\u4f53\u62e5\u6709\u548c\u7ba1\u7406\u7684\u571f\u5730\u3002\u4e00\u4e9b\u539f\u4f4f\u6c11\u571f\u5730\u53ef\u7ecf\u96c6\u4f53\u540c\u610f\u5206\u914d\u7ed9\u4e2a\u4eba\u548c\u5bb6\u5ead\u4f7f\u7528\uff0c\u800c\u53e6\u4e00\u4e9b\u5219\u4f5c\u4e3a\u5171\u540c\u8d22\u4ea7\u52a0\u4ee5\u7ba1\u7406\u3002\u5728\u67d0\u4e9b\u60c5\u51b5\u4e0b\uff0c\u4f8b\u5982\u5728\u65b0\u897f\u5170\uff0c\u539f\u4f4f\u6c11\u571f\u5730\u7531\u4e2a\u4eba\u6216\u5bb6\u5ead\u62e5\u6709\u3002\u793e\u533a\u571f\u5730\u662f\u6307\u5728\u793e\u533a\u4f20\u7edf\u4e60\u60ef\u6cbb\u7406\u4e0b\u7684\u6240\u6709\u571f\u5730\uff0c\u65e0\u8bba\u5176\u662f\u5426\u5728\u56fd\u5bb6\u6cd5\u5f8b\u4e2d\u5f97\u5230\u627f\u8ba4\u3002\u867d\u7136\u539f\u4f4f\u6c11\u571f\u5730\u662f\u793e\u533a\u571f\u5730\u7684\u4e00\u4e2a\u5b50\u96c6\uff0c\u4f46\u5bf9\u4e8e LandMark\uff0c\u793e\u533a\u571f\u5730\u4ec5\u6307\u975e\u539f\u4f4f\u6c11\u62e5\u6709\u7684\u96c6\u4f53\u571f\u5730\u3002", "86bd900c6c9acddfea431fc057ad8f32": "\u9664\u4e86\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730\u4e4b\u5916\uff0c\u8fd9\u4e2a\u6570\u636e\u96c6\u8fd8\u5305\u62ec\u6307\u793a\u6027\u7684\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730\u6743\u5c5e\u533a\u57df\u3002\u8fd9\u4ee3\u8868\u8be5\u533a\u57df\u53ef\u80fd\u5b58\u5728\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730\uff0c\u4f46\u76ee\u524d\u8fd8\u6ca1\u6709\u5bf9\u8fd9\u4e9b\u571f\u5730\u505a\u51fa\u660e\u786e\u5212\u754c\u3001\u627f\u8ba4\u548c/\u6216\u767b\u8bb0\u72b6\u6001\u3002\u8fd9\u4e2a\u6570\u636e\u96c6\u7684\u5b58\u5728\u662f\u4e3a\u4e86\u5e2e\u52a9\u539f\u4f4f\u6c11\u548c\u793e\u533a\u4fdd\u62a4\u4ed6\u4eec\u7684\u571f\u5730\u6743\u548c\u786e\u4fdd\u4ed6\u4eec\u5bf9\u571f\u5730\u7684\u5360\u6709\u6743\u3002\u6b64\u5916\uff0c\u5728\u5176\u4ed6\u73af\u5883\u548c\u571f\u5730\u4f7f\u7528\u6570\u636e\u96c6\u7684\u80cc\u666f\u4e0b\uff0c\u63d0\u4f9b\u8fd9\u4e9b\u6570\u636e\u6709\u52a9\u4e8e\u4e86\u89e3\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730\u6240\u9762\u4e34\u7684\u6f5c\u5728\u538b\u529b\u3001\u571f\u5730\u8986\u76d6\u548c\u571f\u5730\u4f7f\u7528\u968f\u65f6\u95f4\u7684\u53d8\u5316\uff0c\u4ee5\u53ca\u539f\u4f4f\u6c11\u548c\u793e\u533a\u5982\u4f55\u5bf9\u4fdd\u62a4\u73af\u5883\u4f5c\u51fa\u8d21\u732e\u3002\u6700\u540e\uff0c\u6570\u636e\u900f\u660e\u5ea6\u964d\u4f4e\u4e86\u4e0d\u6b63\u5e38\u5f81\u7528\u548c\u5f81\u6536\u73b0\u8c61\u88ab\u5ffd\u89c6\u7684\u53ef\u80fd\u6027\uff0c\u8ba9\u5916\u754c\u80fd\u6ce8\u610f\u5230\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730\u7684\u8106\u5f31\u6027\u3002", "3553d4d18cacff95f4ab0022d795811f": "\u8be5\u6570\u636e\u96c6\u6c47\u603b\u591a\u4e2a\u6765\u6e90\u7684\u6570\u636e\uff0c\u5305\u62ec\u653f\u5e9c\u3001\u4e13\u5bb6\u548c\u5728\u571f\u5730\u6743\u754c\u83b7\u5f97\u516c\u8ba4\u548c\u5c0a\u91cd\u7684\u6210\u719f\u6c11\u95f4\u56e2\u4f53\u7ec4\u7ec7\u3002LandMark \u7684\u8fd0\u8425\u56e2\u961f\u4f1a\u5bf9\u6570\u636e\u8fdb\u884c\u8d28\u91cf\u548c\u4e00\u81f4\u6027\u5ba1\u67e5\uff0c\u5e76\u5bf9\u5c5e\u6027\u8fdb\u884c\u683c\u5f0f\u5316\u5904\u7406\uff0c\u4ee5\u7b26\u5408 LandMark \u7684\u7c7b\u578b\u7ed3\u6784\uff08\u5206\u7c7b\u65b9\u6848\uff09\uff0c\u7136\u540e\u5c06\u6570\u636e\u53d1\u5e03\u5230\u5e73\u53f0\u4e0a\u3002LandMark \u4e0a\u663e\u793a\u7684\u6240\u6709\u6570\u636e\u90fd\u4e0e\u539f\u59cb\u6570\u636e\u6e90\u548c\u8d21\u732e\u8005\u76f8\u5173\u8054\uff0c\u4ee5\u4fbf\u5bf9\u4fe1\u606f\u8fdb\u884c\u8ddf\u8e2a\u548c\u9a8c\u8bc1\u3002\u8fd9\u4e9b\u5c5e\u6027\u5305\u62ec\u6570\u636e\u6536\u96c6\u65b9\u6cd5\uff08\u4f8b\u5982\uff0c\u624b\u6301\u5f0f GPS\u3001\u8f6c\u5f55\u81ea\u571f\u5730\u6240\u6709\u6743\u8bc1\uff09\u548c\u7ed8\u5236\u6570\u636e\u7684\u6bd4\u4f8b\u5c3a\uff0c\u4ee5\u5e2e\u52a9\u4f20\u8fbe\u7a7a\u95f4\u4fe1\u606f\u7684\u51c6\u786e\u6027\u548c\u8d28\u91cf\uff08\u53c2\u89c1<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u793e\u533a\u7ea7\u6570\u636e</a>\u548c<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u65b9\u6cd5\u548c\u6570\u636e\u8d28\u91cf\u6807\u51c6</a>\uff09\u3002\u793e\u533a\u7ea7\u6570\u636e\u4f1a\u5728\u4ece\u6570\u636e\u63d0\u4f9b\u65b9\u6536\u5230\u65b0\u4fe1\u606f\u540e\u968f\u4e4b\u66f4\u65b0\uff0c\u6216\u8005\u5927\u7ea6\u6bcf\u6708\u66f4\u65b0\u4e00\u6b21\u3002\u8fd9\u4e9b\u6570\u636e\u5728 Global Forest Watch \u7f51\u7ad9\u4e0a\u5219\u6309\u5b63\u5ea6\u52a0\u4ee5\u66f4\u65b0\u3002", "ae66e7997a95f78963b2d77fd9649ddd": "LandMark \u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730\u7c7b\u522b\u8be6\u60c5\uff1a", "4fc6783efede065e3eec9c7768c85bd7": "\u5f97\u5230\u653f\u5e9c\u627f\u8ba4\u7684\u539f\u4f4f\u6c11\u571f\u5730\uff1a\u7531\u81ea\u8ba4\u4e3a\u539f\u4f4f\u6c11\u7684\u4eba\u62e5\u6709\u6216\u4f7f\u7528\u4e14\u5f97\u5230\u6cd5\u5f8b\u627f\u8ba4\u7684\u571f\u5730", "f863fdb5760af3d8d15145d9e05ce46c": "\u672a\u5f97\u5230\u653f\u5e9c\u627f\u8ba4\u7684\u539f\u4f4f\u6c11\u571f\u5730\uff1a\u6307\u81ea\u8ba4\u4e3a\u539f\u4f4f\u6c11\u7684\u4eba\u6240\u62e5\u6709\u6216\u4f7f\u7528\u7684\u571f\u5730\uff0c\u4f46\u8fd9\u7c7b\u571f\u5730\u5e76\u672a\u5f97\u5230\u6cd5\u5f8b\u627f\u8ba4\uff1b\u5305\u62ec\u6b63\u5728\u4e89\u53d6\u5f97\u5230\u6cd5\u5f8b\u627f\u8ba4\u7684\u571f\u5730\u6216\u4e0d\u6d89\u53ca\u627f\u8ba4\u8fc7\u7a0b\u7684\u4e60\u60ef\u5360\u6709\u571f\u5730", "0c08a24bd25549a6476c1d4c9ac0666e": "\u5f97\u5230\u653f\u5e9c\u627f\u8ba4\u7684\u793e\u533a\u571f\u5730\uff1a\u7531\u5f53\u5730\u793e\u533a\u62e5\u6709\u6216\u4f7f\u7528\u4e14\u5f97\u5230\u6cd5\u5f8b\u627f\u8ba4\u7684\u571f\u5730", "c705843f385121112d2588466716a642": "\u672a\u5f97\u5230\u653f\u5e9c\u627f\u8ba4\u7684\u793e\u533a\u571f\u5730\uff1a\u6307\u5f53\u5730\u793e\u533a\u6240\u62e5\u6709\u6216\u4f7f\u7528\u7684\u571f\u5730\uff0c\u4f46\u8fd9\u7c7b\u571f\u5730\u5e76\u672a\u5f97\u5230\u6cd5\u5f8b\u627f\u8ba4\uff1b\u5305\u62ec\u6b63\u5728\u4e89\u53d6\u5f97\u5230\u6cd5\u5f8b\u627f\u8ba4\u7684\u571f\u5730\u6216\u4e0d\u6d89\u53ca\u627f\u8ba4\u8fc7\u7a0b\u7684\u4e60\u60ef\u5360\u6709\u571f\u5730", "87f43545bd9b1c24b8e89d33d7650252": "\u6307\u793a\u6027\u7684\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730\u6743\u5c5e\u533a\u57df\uff1a\u6307\u53ef\u80fd\u5b58\u5728\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730\u7684\u533a\u57df\uff0c\u4f46\u76ee\u524d\u8fd8\u6ca1\u6709\u5bf9\u8fd9\u4e9b\u571f\u5730\u505a\u51fa\u660e\u786e\u5212\u754c\u3001\u627f\u8ba4\u548c/\u6216\u767b\u8bb0\u72b6\u6001\u3002", "982fc857229bae4e93904e7e98c8506b": "\u5982\u6b32\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605\uff1awww.landmarkmap.org", "e39704df80e75650990def9f3143942b": "\u663e\u793a\u67d0\u4e9b\u533a\u57df\u7684\u754c\u9650\u8303\u56f4\uff0c\u5728\u8fd9\u4e9b\u8303\u56f4\u5185\uff0c\u539f\u4f4f\u6c11\u6216\u5f53\u5730\u793e\u533a\u53ef\u83b7\u53d6\u67d0\u4e9b\u8d44\u6e90\uff0c\u5e76\u4eab\u53d7\u6709\u9650\u7684\u571f\u5730\u4f7f\u7528\u6743\u3002", "372d509d98298527c46562caf707e27b": "\u76ee\u524d\u9002\u7528\u4e8e\u5580\u9ea6\u9686\u3001\u8d64\u9053\u51e0\u5185\u4e9a\u3001\u5229\u6bd4\u91cc\u4e9a\u548c\u7eb3\u7c73\u6bd4\u4e9a", "f947b784a59c9bbc11844251a326af5e": "<em>\u5580\u9ea6\u9686\uff1a</em> WRI \u521a\u679c\u76c6\u5730\u68ee\u6797\u5730\u56fe\u96c6<br><em>\u8d64\u9053\u51e0\u5185\u4e9a\uff1a</em> WRI \u521a\u679c\u76c6\u5730\u68ee\u6797\u5730\u56fe\u96c6<br><em>\u5229\u6bd4\u91cc\u4e9a\uff1a</em> \u7f8e\u56fd\u56fd\u9645\u5f00\u53d1\u7f72-\u5229\u6bd4\u91cc\u4e9a PROSPER<br><em>\u7eb3\u7c73\u6bd4\u4e9a\uff1a</em> \u7eb3\u7c73\u6bd4\u4e9a\u793e\u533a\u4e3b\u5bfc\u7684\u81ea\u7136\u8d44\u6e90\u7ba1\u7406\u534f\u4f1a\uff08CBNRM\uff09\u652f\u6301\u7ec4\u7ec7\uff08NACSO\uff09", "5312820e7fdf91fd495f2c62579c6045": "\u4e00\u4e9b\u5728\u5168\u7403\u68ee\u6797\u89c2\u6d4b\u663e\u793a\u7684\u6570\u636e\u96c6\u5305\u62ec\u88ab\u4f20\u7edf\u571f\u5730\u4fdd\u6709\u5236\u5ea6\u7ba1\u7406\u7684\u571f\u5730\u548c\u8d44\u6e90\u6743\u5229\uff0c\u4f46\u5e76\u4e0d\u4e3a\u56fd\u5bb6\u6cd5\u5f8b\u627f\u8ba4\u3002", "e91d0d42fa1d9149a3a470047bb6aca8": "\u201c\u8d44\u6e90\u6743\u201d\u6307\u7684\u662f\uff0c\u67d0\u4e9b\u533a\u57df\u5185\u7684\u539f\u4f4f\u6c11\u6216\u8005\u672c\u5730\u793e\u533a\u6709\u6743\u83b7\u53d6\u67d0\u4e9b\u8d44\u6e90\uff0c\u5e76\u4eab\u53d7\u6709\u9650\u7684\u571f\u5730\u4f7f\u7528\u6743\uff0c\u4ee5\u4fbf\u6267\u884c\u5176\u8d44\u6e90\u6743\uff0c\u65e0\u8bba\u6cd5\u5f8b\u627f\u8ba4\u4e0e\u5426\u3002\u8fd9\u4e9b\u8d44\u6e90\u6743\u7684\u786e\u5207\u6027\u8d28\u56e0\u4f7f\u7528\u6743\u7c7b\u578b\u548c\u56fd\u5bb6\u800c\u5f02\u3002", "e812cff2787c61ac3e96994afa9a5623": "GFW\u7684\u8d44\u6e90\u6743\u5229\u6570\u636e\u867d\u7136\u770b\u4e0a\u53bb\u662f\u5355\u72ec\u4e00\u5c42\uff0c\u5b9e\u9645\u4e0a\u662f\u5728\u56fd\u4e0e\u56fd\u7684\u57fa\u7840\u4e0a\u7531\u591a\u4e2a\u6570\u636e\u6e90\u4ea7\u751f\u7684\u3002", "4d27477154e4fc14c6473bb042787602": "GFW \u7f51\u7ad9\u4e0a\u663e\u793a\u7684\u8d44\u6e90\u6743\u6570\u636e\u6309\u7167\u65e5\u671f\u548c\u6570\u636e\u6765\u6e90\u6392\u5217\uff0c\u56e0\u4e0d\u540c\u56fd\u5bb6\u800c\u5f02\u3002\u6570\u636e\u53ef\u80fd\u6765\u81ea\u653f\u5e9c\u673a\u6784\u3001\u975e\u653f\u5e9c\u7ec4\u7ec7\u6216\u8005\u5176\u4ed6\u673a\u6784\u3002\u8fdb\u5165<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5f00\u653e\u6570\u636e\u95e8\u6237</a>\u67e5\u9605\u7279\u5b9a\u6570\u636e\u96c6\u7684\u8be6\u7ec6\u4fe1\u606f\u3002", "9cffee45ee2eda88a4fac430a54661d9": "\u5982\u679c\u60a8\u77e5\u9053\u5176\u4ed6\u56fd\u5bb6\u7684\u8d44\u6e90\u6743\u6570\u636e\uff0c\u8bf7\u70b9\u51fb <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904 </a>\u7ed9\u6211\u4eec\u53d1\u9001\u90ae\u4ef6\u3002", "a82d587f07d2617936915ded695d518e": "\u5168\u7403\u4eba\u53e3", "ad717c3c0a60f3a5b59660be8cc354b4": "\u4eba\u7c7b\u4eba\u53e3\u5bc6\u5ea6\u53ca\u5206\u5e03\u7684\u5168\u7403\u4f30\u8ba1", "f438af1e405c60f47ab2083a8fe1edda": "\u4e0d\u5b9a", "7ec8c0fb315fe2767869473f1c9fd993": "\u8fd9\u4e9b\u6570\u636e\u7684\u5df2\u77e5\u95ee\u9898\u5305\u62ec\u6ca1\u6709\u8db3\u591f\u7684\u5177\u6709\u9002\u5f53\u89c4\u6a21\u3001\u65f6\u95f4\u5c5e\u6027\u548c\u4e3b\u9898\u4fe1\u606f\u53ef\u9760\u6027\u7684\u5168\u7403\u6d4b\u8bd5\u96c6\uff0c\u8fd9\u4e9b\u6d4b\u8bd5\u96c6\u53ef\u4ee5\u9a8c\u8bc1\u7edf\u8ba1\u7684\u6b63\u786e\u6027\u5e76\u652f\u6301\u4ea7\u54c1\u7684\u6539\u8fdb\u3002\u53e6\u4e00\u4e2a\u5df2\u77e5\u7684\u6311\u6218\u662f\u7f3a\u4e4f\u8db3\u591f\u7684\u5168\u7403\u591a\u4f20\u611f\u5668\u6bd4\u8f83\u7814\u7a76\uff0c\u8fd9\u4e9b\u7814\u7a76\u4fa7\u91cd\u4e8e\u4eba\u7c7b\u4f4f\u533a\uff0c\u53ef\u4ee5\u5e2e\u52a9\u4e86\u89e3\u7cfb\u7edf\u4f20\u611f\u5668\u95f4\u504f\u5dee\u4ee5\u53ca\u5c06\u4ece\u4e0d\u540c\u8f93\u5165\u56fe\u50cf\u83b7\u5f97\u7684\u4fe1\u606f\u7ed3\u679c\u8054\u7cfb\u8d77\u6765\u7684\u589e\u76ca\u51fd\u6570\u3002", "21b43eb1ba30fdf9ef4f352c6608ef32": "\u4e3a\u751f\u6210\u8fd9\u4e2a\u4eba\u53e3\u5bc6\u5ea6\u548c\u5206\u5e03\u6570\u636e\u96c6\uff0c\u7814\u7a76\u4eba\u5458\u7ed8\u5236\u4e86\u5168\u7403\u5efa\u6210\u533a\u56fe\uff0c\u8fd9\u4e9b\u5efa\u6210\u533a\u7684\u5b9a\u4e49\u662f\u6240\u6709\u7528\u4e8e\u4eba\u7c7b\u6216\u52a8\u7269\u5e87\u62a4\u6240\u6216\u751f\u4ea7\u7ecf\u6d4e\u4ea7\u54c1\u7684\u5730\u4e0a\u5efa\u7b51\u3002\u901a\u8fc7\u9646\u5730\u536b\u661f\u56fe\u50cf\u5206\u6790\u6765\u786e\u5b9a\u8fd9\u4e9b\u5efa\u7b51\u533a\u57df\u7684\u4f4d\u7f6e\u3002\u53e6\u4e00\u4e2a\u7528\u4e8e\u7f16\u8bd1\u8be5\u6570\u636e\u96c6\u7684\u6765\u6e90\u662f\u7531\u56fd\u9645\u5730\u7403\u79d1\u5b66\u4fe1\u606f\u7f51\u7edc\u4e2d\u5fc3 (CIESIN) \u6c47\u7f16\u7684\u5168\u7403\u4eba\u53e3\u7f51\u683c\u6570\u636e\u96c6 (GPW)\u3002GPW \u6570\u636e\u96c6\u7531\u4eba\u53e3\u666e\u67e5\u6570\u636e\u7ec4\u6210\uff0c\u5e76\u4f7f\u7814\u7a76\u4eba\u5458\u6709\u6743\u4f30\u8ba1\u5c45\u4f4f\u4eba\u53e3\u6765\u652f\u6301\u5efa\u6210\u533a\u6570\u636e\u3002\u4e3a\u4e86\u5c06\u8fd9\u4e9b\u6570\u636e\u663e\u793a\u4e3a\u7f51\u683c\u5355\u5143\uff0cGPW \u6570\u636e\u4ece\u4eba\u53e3\u666e\u67e5\u6216\u884c\u653f\u5355\u4f4d\u4e2d\u5206\u79bb\u51fa\u6765\u3002", "225ea2a2e0f72e27cdeaf38e0ce2504a": "\u5168\u7403\u4eba\u7c7b\u4f4f\u533a\u5c42\uff08GHSL\uff09\u4eba\u53e3\u7f51\u683c\u63cf\u7ed8\u4e862015\u5e74\u7684\u4eba\u53e3\u5206\u5e03\u548c\u5bc6\u5ea6\uff0c\u8868\u73b0\u4e3a\u6bcf\u4e2a\u5355\u5143\u7684\u4eba\u6570\u3002\u867d\u7136GFW\u4ec5\u4f7f\u75282015\u5e74\u6570\u636e\uff0c\u4f46GHSL\u662f\u4e00\u4e2a\u591a\u65f6\u76f8\u4eba\u53e3\u6570\u636e\u96c6\uff0c\u91c7\u7528\u4e86\u65b0\u7684\u7a7a\u95f4\u6570\u636e\u6316\u6398\u6280\u672f\u3002\u8fd9\u4e9b\u65b9\u6cd5\u53ef\u4ee5\u81ea\u52a8\u5904\u7406\u548c\u63d0\u53d6\u6765\u81ea\u4e0d\u540c\u6570\u636e\u96c6\u7684\u5206\u6790\u548c\u77e5\u8bc6\uff1a\u5168\u7403\uff0c\u5c0f\u89c4\u6a21\u536b\u661f\u56fe\u50cf\u6570\u636e\u6d41\uff0c\u4eba\u53e3\u666e\u67e5\u6570\u636e\u4ee5\u53ca\u4eba\u7fa4\u6e90\u6216\u81ea\u613f\u63d0\u4f9b\u7684\u5730\u7406\u4fe1\u606f\u6e90\u3002", "e078d69fccbe47cd5b96780297a026a3": "\u603b\u4f53\u800c\u8a00\uff0cGHSL \u662f\u4e00\u5957\u8f83\u4e3a\u51c6\u786e\u4e14\u5206\u8fa8\u7387\u9ad8\u7684\u5168\u7403\u4eba\u53e3\u4f30\u8ba1\u6570\u636e\u96c6\u3002\u4f46\u8be5\u6570\u636e\u96c6\u4ea6\u5b58\u5728\u4e00\u4e9b\u5df2\u77e5\u95ee\u9898\uff0c\u4e3b\u8981\u5305\u62ec\uff1a\u89c4\u6a21\u5408\u9002\u7684\u5168\u7403\u6d4b\u8bd5\u96c6\u7684\u53ef\u7528\u6027\u4e0d\u8db3\u3001\u4e13\u9898\u4fe1\u606f\u7684\u65f6\u95f4\u5c5e\u6027\u548c\u53ef\u9760\u6027\u4e0d\u591f\u3002\u56e0\u6b64\u8be5\u4ea7\u54c1\u5c1a\u6709\u5f85\u6539\u8fdb\uff0c\u4e14\u4e9f\u5f85\u7edf\u8ba1\u5b66\u610f\u4e49\u4e0a\u7684\u6b63\u786e\u6027\u9a8c\u8bc1\u3002\u53e6\u4e00\u4e2a\u5df2\u77e5\u7684\u95ee\u9898\u662f\uff1a\u9488\u5bf9\u4eba\u7c7b\u4f4f\u533a\u7684\u5168\u7403\u591a\u4f20\u611f\u5668\u6bd4\u8f83\u7814\u7a76\u7684\u53ef\u7528\u6027\u4e0d\u8db3\uff0c\u5e76\u4e14\u5141\u8bb8\u7406\u89e3\u5c06\u6765\u81ea\u4e0d\u540c\u8f93\u5165\u56fe\u50cf\u7684\u4fe1\u606f\u7ed3\u679c\u8054\u7cfb\u8d77\u6765\u7684\u7cfb\u7edf\u6027\u4f20\u611f\u5668\u95f4\u7684\u504f\u5dee\u548c\u589e\u76ca\u51fd\u6570\u3002", "8166caa66e6f2edf001fdb16e0fd39d4": "\u51c0\u901a\u91cf\u53cd\u6620\u4e86 2001-2020 \u5e74\u6a21\u578b\u5206\u6790\u671f\u95f4\u7684\u603b\u91cf\uff0c\u800c\u4e0d\u662f\u53cd\u5e94\u8d8b\u52bf\u7684\u3001\u6309\u65f6\u95f4\u6392\u5217\u7684\u5e74\u5ea6\u503c\u3002\u56e0\u6b64\uff0c\u6b64\u503c\u5fc5\u987b\u9664\u4ee5 20 \u624d\u80fd\u5f97\u51fa\u5e73\u5747\u5e74\u51c0\u901a\u91cf\u3002", "83008fcad86b9cb58ddf5fbe94d8056f": "\u51c0\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf - 2001-2020", "89d5475f6c09142eae84e0a9874d1b91": "\u663e\u793a 2001 \u5e74\u81f3 2020 \u5e74\u95f4\u68ee\u6797\u4e0e\u5927\u6c14\u4e4b\u95f4\u7684\u78b3\u51c0\u4ea4\u6362\uff0c\u8ba1\u7b97\u503c\u4e3a\u7fa4\u4e1b\u66ff\u4ee3\u5e72\u6270\u4ea7\u751f\u7684\u68ee\u6797\u78b3\u6392\u653e\u91cf\u4e0e\u68ee\u6797\u751f\u957f\u4ea7\u751f\u7684\u78b3\u5438\u6536\u91cf\u4e4b\u95f4\u7684\u5dee\u503c", "20511f7203a689ba9ae5ac3c9065dd81": "\u6570\u636e\u7531\u5efa\u6a21\u751f\u6210\uff0c\u56e0\u6b64\u5177\u6709\u5185\u5728\u7684\u8bef\u5dee\u548c\u4e0d\u786e\u5b9a\u6027\u3002\u5f3a\u70c8\u5efa\u8bae\u7528\u6237\u5728\u4f7f\u7528\u6570\u636e\u4e4b\u524d\u9605\u8bfb\u5e76\u5145\u5206\u7406\u89e3\u5143\u6570\u636e\u548c\u5176\u4ed6\u53ef\u7528\u6587\u6863\u3002", "dffe94a4eb8f006dfb336f751c0ea4a2": "\u603b\u5438\u6536\u91cf\u7684\u4e0d\u786e\u5b9a\u6027\u9ad8\u4e8e\u6392\u653e\u91cf\uff0c\u8fd9\u4e3b\u8981\u662f\u7531\u4e8e\u7f8e\u56fd\u548c\u6b27\u6d32\u4ee5\u5916\u5df2\u786e\u5b9a\u7684\u6e29\u5e26\u68ee\u6797\u7684\u5438\u6536\u56e0\u7d20\u7684\u4e0d\u786e\u5b9a\u6027\u6240\u81f4\u3002", "c8d20e5548ccde884ef05d2ec44850ea": "\u6570\u503c\u9002\u7528\u4e8e\u68ee\u6797\u5730\u533a\uff08\u6811\u51a0\u8986\u76d6\u7387  &gt; 30% \u4e14\u9ad8\u5ea6  &gt; 5 m\uff09\u3002\u8bf7\u53c2\u9605 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a>\uff0c\u4e86\u89e3\u6709\u5173\u5206\u6790\u4e2d\u4f7f\u7528\u7684\u68ee\u6797\u5b9a\u4e49\u7684\u66f4\u591a\u4fe1\u606f\u3002", "80dea81508b4ff5fdde09432c2d3b9c0": "\u6392\u653e\u5305\u62ec\u7fa4\u4e1b\u66ff\u4ee3\u5e72\u6270\uff0c\u4f46\u4e0d\u5305\u62ec\u68ee\u6797\u9000\u5316\u9020\u6210\u7684\u6392\u653e\u3002", "bb71b049791a1e3cbc48625a81217481": "\u7528\u4f5c\u4f30\u7b97\u57fa\u7840\u7684\u6d3b\u52a8\u6570\u636e\u5728\u65f6\u95f4\u4e0a\u5177\u6709\u4e0d\u4e00\u81f4\u6027\uff1a<br>o \u6811\u6728\u8986\u76d6\u589e\u52a0\u4e3a 2000-2012 \u5e74\u7684\u7d2f\u8ba1\u603b\u6570\uff0c\u800c\u4e0d\u662f\u5e74\u5ea6\u589e\u503c\u3002<br>o 2001-2010 \u5e74\u548c 2011-2020 \u5e74\u7684\u6811\u6728\u8986\u76d6\u6d41\u5931\u662f\u7531\u4e0d\u540c\u7684\u7b97\u6cd5\u4ea7\u751f\u7684\uff0c\u540e\u8005\u7684\u6811\u6728\u6d41\u5931\u8ba1\u7b97\u53ef\u80fd\u5bf9\u8f83\u5c0f\u89c4\u6a21\u7684\u68ee\u6797\u7834\u574f\u66f4\u654f\u611f\u3002", "cbdc4315c1fd534d2d9781d853533e11": "\u68ee\u6797\u51c0\u78b3\u901a\u91cf\u4ee3\u8868 2001 \u5e74\u81f3 2020 \u5e74\u95f4\u68ee\u6797\u4e0e\u5927\u6c14\u4e4b\u95f4\u7684\u78b3\u51c0\u4ea4\u6362\uff0c\u8ba1\u7b97\u4e3a\u6a21\u578b\u5206\u6790\u671f\u95f4\u68ee\u6797\u6392\u653e\u7684\u78b3\u4e0e\u68ee\u6797\u5438\u6536\uff08\u6216\u5c01\u5b58\uff09\u7684\u78b3\u4e4b\u95f4\u7684\u5e73\u8861\u503c\uff08\u767e\u4e07\u514b CO2e ha-1\uff09\u3002\u51c0\u78b3\u901a\u91cf\u7684\u8ba1\u7b97\u65b9\u6cd5\u662f\u4ece\u6bcf\u4e2a\u5efa\u6a21\u50cf\u7d20\u7684\u5e73\u5747<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5e74\u603b\u6392\u653e\u91cf</a>\u4e2d\u51cf\u53bb\u5e73\u5747<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5e74\u603b\u5438\u6536\u91cf</a>\uff1b\u57fa\u4e8e 2001 \u5e74\u81f3 2020 \u5e74\u4e4b\u95f4\uff0c\u8d1f\u503c\u4ee3\u8868\u68ee\u6797\u51c0\u5438\u6536\u4e86\u66f4\u591a\u7684\u78b3\uff0c\u6b63\u503c\u4ee3\u8868\u6b64\u5904\u7684\u68ee\u6797\u662f\u78b3\u7684\u51c0\u6765\u6e90\u3002\u9488\u5bf9 <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a>\u7684 Global Forest Change \u6811\u6728\u8986\u76d6\u53d8\u5316\u6570\u636e\u4e2d\u6240\u786e\u5b9a\u7684 2000 \u5e74\u7684\u68ee\u6797\u8986\u76d6\u533a\u57df\u4ee5\u53ca 2000 - 2012 \u5e74\u65b0\u751f\u7684\u68ee\u6797\u533a\u57df\uff0c\u6b64\u533a\u57df\u4e2d\u7684\u6bcf\u4e2a\u50cf\u7d20\u51c0\u901a\u91cf\u7684\u8ba1\u7b97\u57fa\u4e8e IPCC \u6307\u5357\u6240\u6307\u5bfc\u7684\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355\u3002\u8be5\u56fe\u5c42\u53cd\u6620\u4e86\u6a21\u578b\u5206\u6790\u671f\u95f4\uff082001-2020\uff09\u7684\u7d2f\u79ef\u51c0\u901a\u91cf\uff0c\u6b64\u503c\u9700\u9664\u4ee5 19 \u624d\u80fd\u83b7\u5f97\u5e74\u5747\u51c0\u901a\u91cf\uff1b\u51c0\u901a\u91cf\u503c\u4e0d\u80fd\u5206\u914d\u7ed9\u6a21\u578b\u7684\u5404\u4e2a\u5e74\u4efd\u3002<br>\u6b64\u51c0\u901a\u91cf\u56fe\u5c42\u662f  <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a>\u63cf\u8ff0\u7684\u68ee\u6797\u78b3\u901a\u91cf\u6a21\u578b\u7684\u4e00\u90e8\u5206\u3002\u672c\u6587\u4ecb\u7ecd\u4e86\u4e00\u79cd\u7528\u4e8e\u4f30\u7b97\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u7684\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u8be5\u6846\u67b6\u53ef\u4ee5\u5e2e\u52a9\u653f\u5e9c\u65b9\u548c\u975e\u653f\u5e9c\u65b9\u8ddf\u8e2a\u6765\u81ea\u68ee\u6797\u7684\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf\u5e76\u51cf\u5c11\u6392\u653e\u6216\u5229\u7528\u68ee\u6797\u589e\u52a0\u78b3\u5438\u6536\u3002\u6240\u6709\u8f93\u5165\u56fe\u5c42\u90fd\u91cd\u65b0\u91c7\u6837\u5230\u76f8\u540c\u7684 0.00025 x 0.00025 \u5ea6\u7684\u5206\u8fa8\u7387\uff0c\u4ee5\u5339\u914d <a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a>\u3002<br>\u51c0\u901a\u91cf\u53ef\u5728\u6a21\u578b\u5206\u6790\u65f6\u95f4\u5185\u4ee5\u4e24\u79cd\u4e0d\u540c\u7684\u9762\u79ef\u5355\u4f4d<a href=\"{{5}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4e0b\u8f7d</a>\uff1a1) \u5146\u514b CO2e ha-1\uff0c\u548c 2) \u5146\u514b CO2e pixel-1\u3002\u524d\u8005\u9002\u7528\u4e8e\u53ef\u89c6\u5316\uff08\u6620\u50cf\uff09\u51c0\u901a\u91cf\uff0c\u56e0\u4e3a\u5b83\u4ee3\u8868\u6bcf\u516c\u9877\u78b3\u901a\u91cf\u7684\u5bc6\u5ea6\u3002\u540e\u8005\u9002\u7528\u4e8e\u8ba1\u7b97\u611f\u5174\u8da3\u533a\u57df (AOI) \u4e2d\u7684\u51c0\u901a\u91cf\uff0c\u56e0\u4e3a\u53ef\u4ee5\u5c06 AOI \u4e2d\u7684\u50cf\u7d20\u503c\u76f8\u52a0\u4ee5\u83b7\u5f97\u8be5\u533a\u57df\u7684\u603b\u78b3\u901a\u91cf\u3002\u540e\u8005\u7684\u503c\u662f\u901a\u8fc7\u6839\u636e\u6bcf\u4e2a\u50cf\u7d20\u7684\u5927\u5c0f\u8c03\u6574\u6bcf\u516c\u9877\u7684\u51c0\u901a\u91cf\u6765\u8ba1\u7b97\u7684\uff0c\u50cf\u7d20\u5927\u5c0f\u56e0\u7eac\u5ea6\u800c\u5f02\u3002\u5728\u4f30\u8ba1 2001 \u5e74\u81f3 2020 \u5e74\u4e4b\u95f4\u67d0\u7279\u5b9a\u5e74\u6570\u5185\u4ea7\u751f\u7684\u51c0\u901a\u91cf\u65f6\uff0c\u53ef\u5c06\u63d0\u4f9b\u7684\u503c\u9664\u4ee5\u6a21\u578b\u6301\u7eed\u65f6\u95f4\uff0c\u7136\u540e\u4e58\u4ee5\u611f\u5174\u8da3\u671f\u95f4\u7684\u5e74\u6570\u3002", "3e297ee9bd2631dd84e0d2659e52c098": "\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u91cf - 2001-2020", "c15cb8e9a5a38445470f0f6f3dbef795": "\u663e\u793a\u7fa4\u4e1b\u66ff\u4ee3\u5e72\u6270\u5bfc\u81f4\u7684\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u6392\u653e", "ec83f2bf0092bf8c830e9e9f2fc9040c": "\u6570\u503c\u4ec5\u9002\u7528\u4e8e\u68ee\u6797\u5730\u533a\uff08\u6811\u51a0\u8986\u76d6\u7387 &gt; 30% \u4e14\u9ad8\u5ea6 &gt; 5 m \uff09\u3002 \u8bf7\u53c2\u9605 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021))</a>\uff0c\u4e86\u89e3\u6709\u5173\u5206\u6790\u4e2d\u4f7f\u7528\u7684\u68ee\u6797\u5b9a\u4e49\u7684\u66f4\u591a\u4fe1\u606f\u3002", "847e461bd163b980e300d93bf2056efa": "\u6392\u653e\u91cf\u53cd\u6620\u4e86\u5728 Landsat \u536b\u661f\u56fe\u50cf\u4e2d\u89c2\u5bdf\u5230\u7684\u7fa4\u4e1b\u66ff\u4ee3\u5e72\u6270\uff0c\u4e0d\u5305\u62ec\u672a\u89c2\u5bdf\u5230\u7684\u68ee\u6797\u9000\u5316\u9020\u6210\u7684\u6392\u653e\u3002", "210cef5e51954575934ba72140d3dfef": "\u6392\u653e\u91cf\u4e3a\u7c97\u7565\u7684\u4f30\u8ba1\u503c\uff0c\u5373\u4e0d\u5305\u62ec\u5e72\u6270\u540e\u53d1\u751f\u7684\u4efb\u4f55\u690d\u88ab\u518d\u751f\u4ea7\u751f\u7684\u78b3\u5438\u6536\u91cf\u3002\u76f8\u53cd\uff0c\u603b\u78b3\u5438\u6536\u91cf\u8ba1\u5165\u4f34\u751f\u68ee\u6797\u78b3\u5438\u6536\u91cf\u56fe\u5c42\u3002", "9bd3f8faa30a845533f7711a7f605355": "\u6392\u653e\u91cf\u6570\u636e\u5b58\u5728\u65f6\u95f4\u4e0a\u7684\u4e0d\u4e00\u81f4\u6027\uff0c\u56e0\u4e3a2001-2010 \u5e74\u548c 2011-2020 \u5e74\u7684\u6811\u6728\u8986\u76d6\u6d41\u5931\u662f\u7531\u4e0d\u540c\u7684\u7b97\u6cd5\u4ea7\u751f\u7684\uff0c\u540e\u8005\u7684\u6811\u6728\u6d41\u5931\u8ba1\u7b97\u53ef\u80fd\u5bf9\u8f83\u5c0f\u89c4\u6a21\u7684\u68ee\u6797\u7834\u574f\u66f4\u654f\u611f\u3002", "bc971c90dcd3fce3b0814bbad8977a4d": "\u68ee\u6797\u78b3\u6392\u653e\u4ee3\u8868\u6bcf\u4e2a\u6a21\u62df\u5e74\u4efd\u53d1\u751f\u7684\u68ee\u6797\u7fa4\u4e1b\u66ff\u4ee3\u5e72\u6270\u6240\u4ea7\u751f\u7684\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\uff08\u5146\u514b CO2e ha-1\uff0c2001 \u5e74\u81f3 2020 \u5e74\u95f4\uff09\u3002\u6392\u653e\u5305\u62ec\u6240\u6709\u76f8\u5173\u7684\u751f\u6001\u7cfb\u7edf\u78b3\u5e93\uff08\u5730\u4e0a\u751f\u7269\u91cf\u3001\u5730\u4e0b\u751f\u7269\u91cf\u3001\u6b7b\u6728\u3001\u67af\u679d\u843d\u53f6\u3001\u571f\u58e4\uff09\u548c\u6e29\u5ba4\u6c14\u4f53\uff08CO2\u3001CH4\u3001N2O\uff09\u3002\u9488\u5bf9 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a> \u5728 Global Forest Change \u5e74\u5ea6\u6811\u6728\u8986\u76d6\u6d41\u5931\u6570\u636e\u4e2d\u6240\u786e\u5b9a\u7684\u533a\u57df\uff0c\u5176\u4e2d\u6bcf\u4e2a\u50cf\u7d20\u7684\u6392\u653e\u91cf\u4f30\u8ba1\u503c\u662f\u6839\u636e IPCC \u6307\u5357\u4e2d\u9488\u5bf9\u53d1\u751f\u7fa4\u4e1b\u66ff\u4ee3\u5e72\u6270\u6240\u4ea7\u751f\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u6240\u8ba1\u7b97\u7684\u3002\u6bcf\u4e2a\u50cf\u7d20\u7684\u78b3\u6392\u653e\u91cf\u57fa\u4e8e 2000 \u5e74\u7684\u78b3\u5bc6\u5ea6\uff0c\u5e76\u6839\u636e 2000 \u5e74\u548c\u5e72\u6270\u5e74\u4efd\u4e4b\u95f4\u7684\u7d2f\u79ef\u78b3\u91cf\u8fdb\u884c\u4e86\u8c03\u6574\u3002\u6392\u653e\u91cf\u4e3a\u7c97\u7565\u4f30\u8ba1\u503c\uff0c\u5373\u4e0d\u5305\u62ec\u5e72\u6270\u540e\u53d1\u751f\u7684\u4efb\u4f55\u690d\u88ab\u518d\u751f\u4ea7\u751f\u7684\u78b3\u5438\u6536\u91cf\u3002\u76f8\u53cd\uff0c\u68ee\u6797\u7834\u574f\u540e\uff0c\u540e\u7eed\u690d\u88ab\u518d\u751f\u4ea7\u751f\u7684\u603b\u78b3\u5438\u6536\u91cf\u8ba1\u5165\u4f34\u751f\u68ee\u6797\u78b3\u5438\u6536\u91cf\u56fe\u5c42\u3002\u5e72\u6270\u53d1\u751f\u65f6\u6bcf\u4e2a\u50cf\u7d20\u78b3\u6392\u653e\u7684\u5404\u4e2a\u7ec4\u6210\u90e8\u5206\uff08\u6392\u653e\u56e0\u5b50\uff09\u53d7\u5230\u591a\u79cd\u56e0\u7d20\u7684\u5f71\u54cd\uff0c\u5305\u62ec\u4ea7\u751f\u5e72\u6270\u7684\u76f4\u63a5\u9a71\u52a8\u56e0\u7d20\u3001\u662f\u5426\u5728\u89c2\u6d4b\u5230\u7684\u5e72\u6270\u4e8b\u4ef6\u53d1\u751f\u5f53\u5e74\u6216\u4e4b\u524d\u89c2\u5bdf\u5230\u706b\u707e\u3001\u5e72\u6270\u662f\u5426\u53d1\u751f\u5728\u6ce5\u70ad\u4e0a\uff0c\u4ee5\u53ca\u5176\u4ed6\u66f4\u591a\u5f71\u54cd\u56e0\u7d20\u3002\u5047\u8bbe\u6240\u6709\u6392\u653e\u90fd\u53d1\u751f\u5728\u5e72\u6270\u5e74\u4efd\u3002\u53ef\u4ee5\u4f7f\u7528 Hansen \u6811\u6728\u8986\u76d6\u6d41\u5931\u6570\u636e\u5c06\u6392\u653e\u5206\u914d\u5230\u7279\u5b9a\u5e74\u4efd\u3002<br>\u6b64\u6392\u653e\u56fe\u5c42\u662f <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a>\u63cf\u8ff0\u7684\u68ee\u6797\u78b3\u901a\u91cf\u6a21\u578b\u7684\u4e00\u90e8\u5206\u3002\u5b83\u5f15\u5165\u4e86\u4e00\u4e2a\u7528\u4e8e\u4f30\u7b97\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u7684\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u8be5\u6846\u67b6\u53ef\u4ee5\u5e2e\u52a9\u653f\u5e9c\u65b9\u548c\u975e\u653f\u5e9c\u65b9\u8ddf\u8e2a\u6765\u81ea\u68ee\u6797\u7684\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf\u5e76\u51cf\u5c11\u6392\u653e\u6216\u5229\u7528\u68ee\u6797\u589e\u52a0\u78b3\u5438\u6536\u3002\u6240\u6709\u8f93\u5165\u56fe\u5c42\u90fd\u91cd\u65b0\u91c7\u6837\u5230\u76f8\u540c\u7684 0.00025 x 0.00025 \u5ea6\u7684\u5206\u8fa8\u7387\uff0c\u4ee5\u5339\u914d <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a>\u3002<br>\u6392\u653e\u91cf\u6570\u636e\u6709\u4e24\u79cd\u4e0d\u540c\u7684\u533a\u57df\u5355\u4f4d\u53ef\u4f9b<a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4e0b\u8f7d</a>\uff1a1) \u767e\u4e07\u514b CO2e \u6392\u653e\u91cf ha-1\uff0c\u548c 2) \u767e\u4e07\u514b CO2e \u6392\u653e\u91cf pixel-1\u3002\u524d\u8005\u9002\u7528\u4e8e\u53ef\u89c6\u5316\uff08\u6620\u50cf\uff09\u6392\u653e\u91cf\uff0c\u56e0\u4e3a\u5b83\u4ee3\u8868\u6bcf\u516c\u9877\u7684\u6392\u653e\u5bc6\u5ea6\u3002\u540e\u8005\u9002\u7528\u4e8e\u8ba1\u7b97\u611f\u5174\u8da3\u533a\u57df (AOI) \u4e2d\u7684\u6392\u653e\u91cf\uff0c\u56e0\u4e3a\u53ef\u4ee5\u5c06 AOI \u4e2d\u7684\u50cf\u7d20\u503c\u76f8\u52a0\u4ee5\u83b7\u5f97\u8be5\u533a\u57df\u7684\u603b\u6392\u653e\u91cf\u3002\u540e\u8005\u7684\u503c\u662f\u901a\u8fc7\u6839\u636e\u6bcf\u4e2a\u50cf\u7d20\u7684\u5927\u5c0f\u8c03\u6574\u6bcf\u516c\u9877\u7684\u6392\u653e\u91cf\u6765\u8ba1\u7b97\u7684\uff0c\u50cf\u7d20\u5927\u5c0f\u56e0\u7eac\u5ea6\u800c\u5f02\u3002", "3fffa2cc4d1b2ed34822acb27b6c7ebd": "\u68ee\u6797\u78b3\u6e05\u9664 - 2001-2020", "5d1bb846a5c0f5f444cbcbb7b18ff180": "\u78b3\u5438\u6536\u91cf\u53cd\u6620\u4e86 2001-2020 \u5e74\u6a21\u578b\u671f\u95f4\u7684\u603b\u5438\u6536\u91cf\uff0c\u800c\u4e0d\u662f\u53cd\u5e94\u8d8b\u52bf\u7684\u3001\u6309\u65f6\u95f4\u6392\u5217\u7684\u5e74\u5ea6\u503c\u3002 \u56e0\u6b64\uff0c\u6b64\u503c\u5fc5\u987b\u9664\u4ee5 20 \u624d\u80fd\u8ba1\u7b97\u5e73\u5747\u5e74\u5438\u6536\u91cf\u3002", "bc2025931def257811dd8e47f35d0e4b": "\u78b3\u5438\u6536\u91cf\u4e3a\u7c97\u7565\u7684\u4f30\u8ba1\u503c\uff0c\u5373\u4e0d\u5305\u62ec\u5148\u524d\u6216\u968f\u540e\u7684\u6811\u6728\u8986\u76d6\u6d41\u5931\u7684\u78b3\u6392\u653e\u91cf\u3002\u76f8\u53cd\uff0c\u603b\u78b3\u6392\u653e\u91cf\u8ba1\u5165\u4f34\u751f\u68ee\u6797\u78b3\u5438\u6536\u56fe\u5c42\u3002", "fb4ae12ad7f8a4d1452e03ce6ce9b894": "\u5438\u6536\u91cf\u6570\u636e\u5b58\u5728\u65f6\u95f4\u4e0a\u7684\u4e0d\u4e00\u81f4\u6027\uff0c\u56e0\u4e3a\u6811\u6728\u8986\u76d6\u589e\u76ca\u4ee3\u8868 2000-2012 \u5e74\u7684\u7d2f\u8ba1\u603b\u6570\uff0c\u800c\u4e0d\u662f\u81f3 2020 \u5e74\u4f30\u8ba1\u7684\u5e74\u5ea6\u589e\u76ca\u3002", "0b5668b64783bf232688722376c3bc3e": "\u68ee\u6797\u78b3\u5438\u6536\u91cf\u53cd\u6620\u4ec5\u53d1\u751f\u5728\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u4e2d\u7684\u78b3\u5438\u6536\u91cf\uff0c\u5e76\u4e0d\u53cd\u6620\u91c7\u4f10\u6728\u6750\u4ea7\u54c1 (HWP) \u6c60\u4e2d\u78b3\u50a8\u91cf\u7684\u589e\u52a0\u3002", "b4da41f67e79a7be0491feb736c9c594": "\u68ee\u6797\u78b3\u6c47\u4ece\u5927\u6c14\u4e2d\u5438\u6536\u7684\u68ee\u6797\u78b3\uff08\u5c01\u5b58\uff09\u4ee3\u8868\u4e86 2001-2020 \u5e74\u6a21\u578b\u5206\u6790\u671f\u95f4\u5df2\u786e\u5b9a\u7684\u548c\u65b0\u518d\u751f\u7684\u68ee\u6797\u751f\u957f\u6240\u6355\u83b7\u7684\u7d2f\u79ef\u78b3\uff08\u767e\u4e07\u514b CO2 ha-1\uff09\u3002\u5438\u6536\u5305\u62ec\u5730\u4e0a\u548c\u5730\u4e0b\u6709\u751f\u547d\u7684\u6811\u751f\u7269\u91cf\u4e2d\u78b3\u7684\u79ef\u7d2f\u3002\u6839\u636e IPCC \u5bf9\u68ee\u6797\u4ecd\u4e3a\u68ee\u6797\u7684\u7b2c 1 \u5c42\u5047\u8bbe\uff0c\u5047\u8bbe\u6b7b\u6728\u3001\u67af\u679d\u843d\u53f6\u548c\u571f\u58e4\u78b3\u5e93\u7684\u5438\u6536\u91cf\u4e3a\u96f6\u3002\u9488\u5bf9 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a>\u7684 Global Forest Change \u6811\u6728\u8986\u76d6\u6d41\u5931\u6570\u636e\u4e2d\u6240\u786e\u5b9a\u7684 2000 \u5e74\u7684\u68ee\u6797\u8986\u76d6\u533a\u57df\u4ee5\u53ca 2000 - 2012 \u5e74\u65b0\u751f\u7684\u68ee\u6797\u533a\u57df\uff0c\u6b64\u533a\u57df\u4e2d\u7684\u6bcf\u4e2a\u50cf\u7d20\u78b3\u5438\u6536\u91cf\u7684\u8ba1\u7b97\u57fa\u4e8e IPCC \u6307\u5357\u6240\u6307\u5bfc\u7684<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u3002\u6bcf\u4e2a\u50cf\u7d20\u5438\u6536\u7684\u78b3\u57fa\u4e8e\u68ee\u6797\u7c7b\u578b\uff08\u4f8b\u5982\uff0c\u7ea2\u6811\u6797\u3001\u4eba\u5de5\u6797\uff09\u3001\u751f\u6001\u533a\uff08\u4f8b\u5982\uff0c\u6f6e\u6e7f\u7684\u65b0\u70ed\u5e26\u5730\u533a\uff09\u3001\u68ee\u6797\u5e74\u9f84\uff08\u4f8b\u5982\uff0c\u521d\u751f\u6797\u3001\u957f\u671f\u6b21\u751f\u6797\uff09\u548c\u78b3\u5438\u6536\u5e74\u6570\u7684\u5730\u56fe\u3002\u8be5\u56fe\u5c42\u53cd\u6620\u4e86\u6a21\u578b\u671f\u95f4\uff082001-2020 \u5e74\uff09\u7684\u7d2f\u79ef\u5438\u6536\u91cf\uff0c\u5fc5\u987b\u9664\u4ee5 20 \u624d\u80fd\u83b7\u5f97\u6a21\u578b\u671f\u95f4\u7684\u5e74\u5e73\u5747\u503c\uff1b\u5438\u6536\u7387\u4e0d\u80fd\u5206\u914d\u7ed9\u6a21\u578b\u7684\u5404\u4e2a\u5e74\u4efd\u3002<br>\u6b64\u78b3\u5438\u6536\u56fe\u5c42\u662f <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a>\u63cf\u8ff0\u7684\u68ee\u6797\u78b3\u901a\u91cf\u6a21\u578b\u7684\u4e00\u90e8\u5206\u3002\u672c\u6587\u4ecb\u7ecd\u4e86\u4e00\u79cd\u7528\u4e8e\u4f30\u7b97\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u7684\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u8be5\u6846\u67b6\u53ef\u4ee5\u5e2e\u52a9\u653f\u5e9c\u65b9\u548c\u975e\u653f\u5e9c\u65b9\u8ddf\u8e2a\u6765\u81ea\u68ee\u6797\u7684\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf\u5e76\u51cf\u5c11\u6392\u653e\u6216\u5229\u7528\u68ee\u6797\u589e\u52a0\u78b3\u5438\u6536\u3002\u6240\u6709\u8f93\u5165\u56fe\u5c42\u90fd\u91cd\u65b0\u91c7\u6837\u5230\u76f8\u540c\u7684 0.00025 x 0.00025 \u5ea6\u7684\u5206\u8fa8\u7387\uff0c\u4ee5\u5339\u914dHansen et al. (2013)\u3002<br>\u6a21\u578b\u7814\u7a76\u671f\u95f4\u5185\u7684\u5438\u6536\u91cf\u6570\u636e\u53ef\u4ee5\u4e24\u4e2a\u4e0d\u540c\u7684\u533a\u57df\u5355\u4f4d<a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4e0b\u8f7d</a>\uff1a1) \u767e\u4e07\u514b CO2 \u5438\u6536\u91cf ha-1\uff0c\u548c 2) \u767e\u4e07\u514b CO2 \u5438\u6536\u91cf pixel-1\u3002\u524d\u8005\u9002\u7528\u4e8e\u53ef\u89c6\u5316\uff08\u6620\u50cf\uff09\u5438\u6536\u91cf\uff0c\u56e0\u4e3a\u5b83\u4ee3\u8868\u6bcf\u516c\u9877\u7684\u5438\u6536\u5bc6\u5ea6\u3002\u540e\u8005\u9002\u7528\u4e8e\u8ba1\u7b97\u611f\u5174\u8da3\u533a\u57df (AOI) \u4e2d\u7684\u5438\u6536\u91cf\uff0c\u56e0\u4e3a\u53ef\u4ee5\u5c06 AOI \u4e2d\u7684\u50cf\u7d20\u503c\u76f8\u52a0\u4ee5\u83b7\u5f97\u8be5\u533a\u57df\u7684\u603b\u5438\u6536\u91cf\u3002\u540e\u8005\u7684\u503c\u662f\u901a\u8fc7\u6839\u636e\u6bcf\u4e2a\u50cf\u7d20\u7684\u5927\u5c0f\u8c03\u6574\u6bcf\u516c\u9877\u7684\u5438\u6536\u91cf\u6765\u8ba1\u7b97\u7684\uff0c\u50cf\u7d20\u5927\u5c0f\u56e0\u7eac\u5ea6\u800c\u5f02\u3002\u5728\u4f30\u7b97 2001 \u5e74\u81f3 2020 \u5e74\u95f4\u7279\u5b9a\u5e74\u4efd\u7684\u5438\u6536\u91cf\u4ee5\u4e0e\u6392\u653e\u91cf\u8fdb\u884c\u6bd4\u8f83\u65f6\uff0c\u53ef\u5c06\u603b\u78b3\u5438\u6536\u91cf\u9664\u4ee5\u6a21\u578b\u6301\u7eed\u65f6\u95f4\uff0c\u7136\u540e\u4e58\u4ee5\u76f8\u5173\u671f\u95f4\u7684\u5e74\u6570\u3002\n\n", "6af3f9635d89f74f5cc49dcfaad71172": "\u4ee5\u6570\u636e\u6765\u6e90\u533a\u5206", "d9ac0f4a5ef1d01f3e03d7cf3de15321": "30m\uff0c\u5168\u7403\uff0cZarin/WHRC", "ae20c570b77f3c2fadb897c5b56e8909": "\u5730\u4e0a\u73b0\u5b58\u6797\u6728\u751f\u7269\u8d28\u5bc6\u5ea6", "b21b4491ea26ca16cc2ab6b9f990f89c": "\u571f\u58e4\u78b3\u5bc6\u5ea6", "b311d270cda0ead77fdb20ddae42d085": "\u786e\u5b9a\u8868\u5c42\u571f\u58e4\uff080-30 cm \u7684\u6df1\u5ea6\uff09\u4e2d\u7684\u6709\u673a\u78b3\u5bc6\u5ea6\u3002", "bbc1df1501f3cd14602cc61a13229fd6": "Sanderman et. al. (2018)- \u5c40\u9650\u6027\u5305\u62ec\u53ef\u80fd\u5f71\u54cd\u571f\u58e4\u78b3\u6d4b\u91cf\u7684\u6a21\u578b\u9519\u8bef\u3001\u5f71\u54cd\u571f\u58e4\u78b3\u6d4b\u91cf\u4f4d\u7f6e\u7684\u5730\u5757\u4f4d\u7f6e\u4fe1\u606f\u4e0d\u5b8c\u5584\uff0c\u4ee5\u53ca\u7814\u7a76\u5982\u4f55\u5b9a\u4e49\u7ea2\u6811\u6797\u8303\u56f4\u7684\u95ee\u9898\u3002", "0b2d7bb38fb25c7f111b34f88eab693e": "ISRIC Soil Grids\u2014\u2014\u571f\u58e4\u6709\u673a\u78b3\u57fa\u4e8e\u91c7\u6837\u4f4d\u7f6e\u548c\u73af\u5883\u534f\u53d8\u91cf\u8fdb\u884c\u5efa\u6a21\u3002\u5982\u9700\u8be6\u7ec6\u4e86\u89e3\u6570\u636e\u4e2d\u7684\u4e0d\u786e\u5b9a\u6027\uff0c\u8bf7\u53c2\u9605 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.isric.org/explore/soilgrids/faq-soilgrids</a>\u3002", "c51d47051da7d89ba1785dd15ba93caa": "\u672c\u56fe\u5c42\u6574\u5408\u4e86\u4e0e\u5168\u7403\u571f\u58e4\u6709\u673a\u78b3 (SOC) \u76f8\u5173\u7684\u4e24\u4e2a\u4e0d\u540c\u6570\u636e\u96c6\u3002\u4e00\u4e2a\u6620\u50cf\u666e\u901a SOC\uff0c\u53e6\u4e00\u4e2a\u6620\u50cf\u7ea2\u6811\u6797\u5185\u7684 SOC\u3002SOC \u662f\u571f\u58e4\u6709\u673a\u8d28\u7684\u4e3b\u8981\u6210\u5206\uff0c\u6765\u6e90\u4e8e\u6b8b\u5b58\u7684\u3001\u8150\u70c2\u7684\u690d\u7269\u548c\u52a8\u7269\u6750\u6599\u3002\u81ea\u7136\u56e0\u7d20\uff08\u5982\u571f\u5730\u8986\u76d6\u3001\u690d\u88ab\u3001\u5730\u5f62\u548c\u6c14\u5019\uff09\u4ee5\u53ca\u4eba\u4e3a\u56e0\u7d20\uff08\u5982\u571f\u5730\u5229\u7528\u548c\u7ba1\u7406\uff09\u53ef\u4ee5\u5f71\u54cd\u571f\u58e4\u4e2d\u5b58\u5728\u7684\u571f\u58e4\u6709\u673a\u8d28\u7684\u91cf\uff0c\u4ece\u800c\u5f71\u54cd\u571f\u58e4\u6709\u673a\u78b3\u3002\u6b64\u5916\uff0c\u6709\u5fc5\u8981\u8003\u8651\u7ea2\u6811\u6797\u4e0b\u571f\u58e4\u78b3\u7684\u5206\u5e03\uff0c\u56e0\u4e3a\u7ea2\u6811\u6797\u88ab\u8ba4\u4e3a\u662f\u4e16\u754c\u4e0a\u78b3\u542b\u91cf\u6700\u9ad8\u7684\u751f\u6001\u7cfb\u7edf\u4e4b\u4e00\uff0c\u5927\u90e8\u5206\u78b3\u50a8\u5b58\u5728\u571f\u58e4\u4e2d\u3002\u6d4b\u91cf\u5168\u7403 SOC \u5bf9\u4e8e\u4e86\u89e3\u78b3\u5c01\u5b58\u3001\u519c\u4e1a\u751f\u4ea7\u529b\u548c\u571f\u58e4\u6c34\u4f4d\u81f3\u5173\u91cd\u8981\uff0c\u5c24\u5176\u662f\u5728\u53d7\u6c14\u5019\u53d8\u5316\u5f71\u54cd\u7684\u5730\u533a\u3002\u6b64\u5904\u663e\u793a\u7684\u56fe\u5c42\u662f\u8986\u76d6\u5728\u666e\u901a\uff08\u5168\u7403\uff09\u571f\u58e4\u78b3\u5c42\u4e0a\u7684\u7ea2\u6811\u6797\u7279\u5b9a\u571f\u58e4\u78b3\u5c42\u3002\u8fd9\u4e24\u4e2a\u6570\u636e\u96c6\u662f\u4f7f\u7528\u4e0d\u540c\u7684\u65b9\u6cd5\u6536\u96c6\u7684\uff0c\u6bcf\u4e2a\u65b9\u6cd5\u90fd\u6709\u4e0d\u540c\u7684\u66f4\u65b0\u9891\u7387\u3001\u5206\u8fa8\u7387\u548c\u8b66\u544a\u3002", "e54153e704e96163fad64717d48b0974": "\u901a\u7528 SOC \u6570\u636e\u96c6\uff08\u79f0\u4e3a SoilGrids\uff09\u7531 International Soil Reference and Information Centre(ISRIC) \u521b\u5efa\uff0c\u5e76\u4f7f\u7528\u673a\u5668\u5b66\u4e60\u5f00\u53d1\uff0c\u4ee5 250 m x 250 m \u7684\u5206\u8fa8\u7387\u7ed8\u5236 SOC \u548c\u5176\u4ed6\u571f\u58e4\u7279\u6027\u3002\u6b64 SOC \u56fe\u5c42\u5b9a\u6027\u7ed8\u5236 0-30 \u5398\u7c73\u6df1\u5ea6\u7684\u571f\u58e4\uff0c\u4e8e 2020 \u5e74\u8fdb\u884c\u6700\u8fd1\u4e00\u6b21\u7684\u66f4\u65b0\u3002\u6709\u5173\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">SoilGrids \u7f51\u7ad9</a>\u3002", "2eef4f84967d77bb06dad81cd3fc72fe": "\u4e0e\u7ea2\u6811\u6797\u6709\u5173\u7684 SOC \u6570\u636e\u6765\u81ea Sanderman et al. 2018\u3002\u8fd9\u662f\u4e00\u5f20\u5206\u8fa8\u7387\u4e3a 30 m x 30 m \u7684\u6cdb\u70ed\u5e26\u5730\u56fe\uff0c\u4f7f\u7528\u673a\u5668\u5b66\u4e60\u6a21\u578b\u6d4b\u91cf\u7ea2\u6811\u6797\u571f\u58e4\u78b3\u3002\u8be5\u6a21\u578b\u53c2\u8003\u4e86\u5168\u7403 SoilGrids \u6a21\u578b\uff0c\u4ee5\u53ca 2000 \u5e74\u7684 Landsat \u56fe\u50cf\u548c\u9065\u611f\u7ea2\u6811\u6797\u8986\u76d6\u6570\u636e\u3002\u6709\u5173\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605[\u539f\u59cb\u51fa\u7248\u7269[\uff08https://iopscience.iop.org/article/10.1088\uff09 /1748-9326/aabe1c)\u3002", "c3f1182b7f68dd862faf6516778c8b62": "\u663e\u793a\u8fd9\u4e9b\u6570\u636e\u65f6\u8bf7\u4f7f\u7528\u4ee5\u4e0b\u6765\u6e90\uff1a<br>\u6765\u6e90\uff1aWorld Resources Institute, ISRIC, Sanderman et al. \u201cSoil Carbon Density.\u201d  Global Forest Watch on (date). www.globalforestwatch.org.", "9b9244514434170b52c32a1a4b7ae43d": "\u5f15\u7528\u6570\u636e\u65f6\u8bf7\u6807\u660e\u4ee5\u4e0b\u8d21\u732e\u8005\uff1a<br>Mangroves: Sanderman J, Hengl T, Fiske G et al. (2018) A global map of mangrove forest soil carbon at 30 m spatial resolution. Environmental Research Letters 13: 055002. doi.org/10.1088/1748-9326/aabe1c<br>ISRIC: de Sousa, L. M., Poggio, L., Batjes, N. H., Heuvelink, G. B. M., Kempen, B., Riberio, E., and Rossiter, D.: SoilGrids 2.0: producing quality-assessed soil information for the globe, SOIL Discuss. [preprint], https://doi.org/10.5194/soil-2020-65, in review, 2020.", "eaef4762c79e13aca30407ea0a286624": "\u751f\u7269\u591a\u6837\u6027\u5b8c\u6574\u6027", "a73c6cdf565c18eb17691e48192aa326": "\u53ef\u91cd\u65b0\u9020\u6797\u5730\u533a\u5929\u7136\u6797\u518d\u751f\u7684\u78b3\u79ef\u7d2f\u6f5c\u529b", "13ea86cb2fe5f98dff015cbed3b7f2b9": "\u5728\u6f5c\u5728\u7684\u53ef\u91cd\u65b0\u9020\u6797\u5730\u533a\uff0c\u5929\u7136\u6797\u518d\u751f\u7684\u524d 30 \u5e74\u4e2d\u78b3\u5728\u5730\u4e0a\u6d3b\u4f53\u751f\u7269\u91cf\u4e2d\u7684\u4f30\u8ba1\u56fa\u5b58\u901f\u7387\uff08Mg \u78b3/\u516c\u9877/\u5e74\uff09\u3002", "aeb2f7693291875919753e76a6920f92": "\u5168\u7403\u91cd\u65b0\u9020\u6797\u8303\u56f4\u5185\uff08\u4e0d\u542b\u5317\u90e8\u5730\u533a\u3001\u8349\u5730\u751f\u7269\u7fa4\u843d\u548c\u8015\u5730\uff09Griscom et al. 2017\u3002", "2f767d34c68f15966f94fe7f811c51cc": "\u9002\u7528\u4e8e\u5929\u7136\u6797\u518d\u751f\u7684\u524d 30 \u5e74\u3002", "1f7198be9bb63551591ca63dc29fb1f8": "\u2022 \u6570\u503c\u4ee3\u8868\u6700\u4f73\u4f30\u8ba1\u503c\uff0c\u4f46\u5305\u542b\u4e0d\u786e\u5b9a\u6027\u3002\u7ed3\u679c\u7684\u51c6\u786e\u6027\u53d6\u51b3\u4e8e\u6a21\u578b\u8bad\u7ec3\u7684\u6570\u636e\u53ef\u7528\u6027\uff0c\u8fd9\u4e9b\u6570\u636e\u4e3b\u8981\u96c6\u4e2d\u5728\u5341\u4e2a\u56fd\u5bb6\u3002\u4e0e\u6b64\u6570\u636e\u5c42\u76f8\u5173\u7684\u4e0d\u786e\u5b9a\u6027\u5730\u56fe\u53ef\u4ece GFW \u7684\u5f00\u653e\u6570\u636e\u95e8\u6237\u7f51\u7ad9\u4e0b\u8f7d\u3002<br>\u2022 \u78b3\u79ef\u7d2f\u901f\u7387\u4ec5\u9002\u7528\u4e8e\u5929\u7136\u6797\u518d\u751f\uff0c\u4e0d\u9002\u7528\u4e8e\u5176\u4ed6\u79ef\u6781\u7684\u6062\u590d\u65b9\u6cd5\uff08\u519c\u6797\u4e1a\u3001\u79cd\u690d\u56ed\u7b49\uff09\u3002<br>\u2022 \u78b3\u79ef\u7d2f\u901f\u7387\u662f\u7ebf\u6027\u7684\uff0c\u5728\u518d\u751f\u7684\u524d 30 \u5e74\u5185\u8fdb\u884c\u4e86\u5e73\u5747\u300230 \u5e74\u4ee5\u5916\u7684\u5ef6\u7533\u5c06\u8fc7\u9ad8\u4f30\u8ba1\u56fa\u5b58\u7684\u78b3\u91cf\u3002<br>\u2022 \u901f\u7387\u4ec5\u53cd\u6620\u5730\u4e0a\u6d3b\u4f53\u751f\u7269\u91cf\u7684\u78b3\u79ef\u7d2f\u3002\u5730\u4e0b\u751f\u7269\u91cf\u3001\u5df2\u6b7b\u4ea1\u7684\u6709\u673a\u7269\u548c\u571f\u58e4\u6709\u673a\u78b3\u7684\u79ef\u7d2f\u4e0d\u5305\u62ec\u5728\u5185\uff0c\u4f46\u53ef\u6839\u636e\u8981\u6c42\u63d0\u4f9b\u5730\u4e0b\u78b3\u79ef\u7d2f\u5730\u56fe\u3002<br>\u2022 \u5728\u7a00\u6811\u8349\u539f\uff0c\u901f\u7387\u4ec5\u9002\u7528\u4e8e\u8fd9\u7c7b\u8349\u539f-\u68ee\u6797\u4ea4\u9519\u533a\u7684\u68ee\u6797\u90e8\u5206\u3002<br>\u2022 \u8fd9\u4e9b\u6570\u636e\u4e0d\u80fd\u66ff\u4ee3\u68ee\u6797\u518d\u751f\u6f5c\u529b\u7684\u8be6\u7ec6\u73b0\u573a\u7ea7\u8bc4\u4f30\u3002", "05552ab26f29f89f0d282d54cfb3755d": "\u8fd9\u5f20\u5730\u56fe\u663e\u793a\u4e86\u5929\u7136\u6797\u518d\u751f\u7684\u524d 30 \u5e74\u91cc\uff0c\u68ee\u6797\u4ece\u5927\u6c14\u4e2d\u6355\u83b7\u78b3\u5e76\u5c06\u5176\u50a8\u5b58\u5728\u5730\u4e0a\u6d3b\u4f53\u751f\u7269\u91cf\u4e2d\u7684\u901f\u7387\u3002\u5b83\u7684\u521b\u5efa\u662f\u901a\u8fc7\u5c06\u4e16\u754c\u5404\u5730\u6570\u5343\u4e2a\u5730\u70b9\u7684\u5730\u9762\u6d4b\u91cf\u6570\u636e\u4e0e\u673a\u5668\u5b66\u4e60\u6a21\u578b\u4e2d\u7684 66 \u4e2a\u5171\u7f6e\u7684\u73af\u5883\u534f\u53d8\u91cf\u5c42\u7ed3\u5408\u8d77\u6765\uff0c\u4ece\u800c\u751f\u6210\u4e00\u5f20\u8fde\u7eed\u7684\u5730\u56fe\u3002\u7528\u4e8e\u8bad\u7ec3\u6a21\u578b\u7684\u68ee\u6797\u5730\u5757\u6570\u636e\u6765\u81ea\u4e8e\u68ee\u6797\u78b3\u6570\u636e\u5e93 (ForC, maintained by the Smithsonian Institute (https://github.com/forc-db)) \u4e2d\u7684\u5df2\u53d1\u8868\u6587\u732e\uff0c\u4ee5\u53ca\u516c\u5f00\u7684\u56fd\u5bb6\u68ee\u6797\u6e05\u5355\u4e2d\u7684\u5730\u7406\u53c2\u8003\u6570\u636e\u3002\u5c3d\u7ba1\u8be5\u901f\u7387\u7684\u4f30\u8ba1\u8003\u8651\u4e86\u5168\u7403\u6240\u6709\u68ee\u6797\u548c\u7a00\u6811\u8349\u539f\u7684\u751f\u7269\u7fa4\u843d\uff0c\u4f46\u8fd9\u91cc\u6309 Griscom et al. 2017 (PNAS) \u4e2d\u5b9a\u4e49\u7684\u201c\u53ef\u91cd\u65b0\u9020\u6797\u201d\u5730\u533a\u5bf9\u5176\u8fdb\u884c\u4e86\u7b5b\u9009\u3002\u53ef\u91cd\u65b0\u9020\u6797\u7684\u5730\u533a\u4e0d\u5305\u62ec\u539f\u751f\u8349\u539f\u548c\u8015\u5730\uff0c\u4ee5\u4fdd\u969c\u7cae\u98df\u548c\u7ea4\u7ef4\u7684\u751f\u4ea7\u4ee5\u53ca\u751f\u7269\u591a\u6837\u6027\u7684\u6816\u606f\u5730\u3002", "f2cc51bcc2c0c99f502828bf0286ecf5": "\u751f\u7269\u591a\u6837\u6027\u5b8c\u6574\u6027\u2014\u2014 2019\u5e74", "bbeca24c21f90479953282f41062605f": "\u663e\u793a\u68ee\u6797\u53d8\u5316\u5bf9\u5f53\u5730\u751f\u7269\u591a\u6837\u6027\u5b8c\u6574\u6027\u7684\u5f71\u54cd", "d200b1f80b375e7aecbb43505ce61927": "\u5168\u7403\u68ee\u6797\u751f\u7269\u7fa4\u843d", "e19147ac00e06fae15589d12e15fff09": "\u672c\u6307\u6807\u5047\u8bbe\u5728\u5b8c\u5168\u65e0\u5e72\u6270\u7684\u5730\u70b9\u53d1\u73b0\u7684\u751f\u7269\u591a\u6837\u6027\u7b49\u540c\u4e8e\u5728\u6ca1\u6709\u4eba\u4e3a\u5e72\u9884\u7684\u60c5\u51b5\u4e0b\u5b58\u5728\u7684\u751f\u7269\u591a\u6837\u6027", "01deca8dedf9bb7e86b8557b855ab829": "\u4eba\u7c7b\u5bf9\u751f\u7269\u591a\u6837\u6027\u5b8c\u6574\u6027\u7684\u5f71\u54cd\u662f\u901a\u8fc7\u6a21\u578b\u6765\u91cf\u5316\u7684\uff0c\u8fd9\u4e9b\u6a21\u578b\u4ece\u5927\u9762\u79ef\u7684\u7279\u5b9a\u5730\u70b9\u7814\u7a76\u4e2d\u63a8\u65ad\u51fa\u7ed3\u679c\uff0c\u6b64\u7c7b\u63a8\u65ad\u4e2d\u603b\u662f\u5b58\u5728\u4e00\u5b9a\u7a0b\u5ea6\u7684\u4e0d\u786e\u5b9a\u6027", "af568d079f80724bd92b5a87135b7756": "\u5728\u8fd9\u4e00\u5206\u6790\u4e2d\uff0c\u4eba\u5de5\u6797\u4e0e\u5929\u7136\u6797\u672a\u4f5c\u533a\u5206\u3002\u56e0\u6b64\uff0c\u4eba\u5de5\u6797\u533a\u57df\u53ef\u7b97\u4f5c\u5b8c\u6574\u7684\uff08\u672a\u53d7\u4fb5\u67d3\u7684\uff09\u751f\u7269\u591a\u6837\u6027\u5730\u533a\u3002", "ad6685bc16feaf660b8a3a0bce6e698d": "\u672c\u56fe\u5c42\u91cf\u5316\u5206\u6790\u4e86\u4eba\u7c7b\u4e4b\u4e8e\u7269\u79cd\u7fa4\u843d\u5b8c\u6574\u6027\u7684\u5f71\u54cd\u3002\u571f\u5730\u5229\u7528\u7684\u8f6c\u6362\u7b49\u4eba\u4e3a\u538b\u529b\u5df2\u5bfc\u81f4\u7269\u79cd\u7fa4\u843d\u7684\u7ec4\u6210\u53d1\u751f\u5de8\u5927\u53d8\u5316\uff0c\u672c\u56fe\u5c42\u901a\u8fc7\u5c55\u793a\u68ee\u6797\u53d8\u5316\u5bf9\u751f\u7269\u591a\u6837\u6027\u5b8c\u6574\u6027\u7684\u5f71\u54cd\u6765\u8bf4\u660e\u8fd9\u4e9b\u53d8\u5316\u3002\u6700\u5927\u503c\u8868\u793a\u6ca1\u6709\u4eba\u4e3a\u5f71\u54cd\uff0c\u800c\u8f83\u4f4e\u7684\u503c\u8868\u793a\u5b8c\u6574\u6027\u5df2\u964d\u4f4e\u3002 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">PREDICTS \u6570\u636e\u5e93</a>\u5305\u542b\u8d85\u8fc7 300 \u4e07\u6761\u5177\u6709\u5730\u7406\u548c\u5206\u7c7b\u4ee3\u8868\u6027\u7684\u571f\u5730\u5229\u7528\u5bf9\u5f53\u5730\u751f\u7269\u591a\u6837\u6027\u5f71\u54cd\u7684\u6570\u636e\u8bb0\u5f55\uff08Hudson et al. 2017\uff09\u3002 PREDICTS \u6570\u636e\u5e93\u7684\u4e00\u4e2a\u4ec5\u5305\u62ec\u4e0e\u68ee\u6797\u751f\u7269\u7fa4\u843d\u6709\u5173\u7684\u6570\u636e\u7684\u5b50\u96c6\uff0c\u88ab\u7528\u4e8e\u6a21\u62df\u571f\u5730\u5229\u7528\u53d8\u5316\u548c\u4eba\u53e3\u5bc6\u5ea6\u5bf9\u5f53\u5730\u7269\u79cd\u7fa4\u843d\u5b8c\u6574\u6027\u7684\u5f71\u54cd\u3002\u571f\u5730\u5229\u7528\u5730\u56fe\u7684\u751f\u6210\u8fc7\u7a0b\u9009\u62e9\u4e86\u6240\u6709\u68ee\u6797\u751f\u7269\u7fa4\u843d\uff0c\u5e76\u6839\u636e\u6765\u81ea GFW \u68ee\u6797\u53d8\u5316\u6570\u636e\u5e93\u7684\u8f93\u5165\u548c\u66f4\u5c0f\u5c3a\u5ea6\u7684\u571f\u5730\u5229\u7528\u5730\u56fe\u4e3a\u751f\u7269\u7fa4\u843d\u5185\u7684\u6bcf\u4e2a 30 x 30 m \u50cf\u7d20\u8d4b\u503c\u4e00\u4e2a\u571f\u5730\u5229\u7528\u7c7b\u522b\uff08Hoskins et al 2016\uff09\u3002\u5c06\u6765\u81ea PREDICTS \u6570\u636e\u5e93\u7684\u751f\u7269\u591a\u6837\u6027\u5b8c\u6574\u6027\u5efa\u6a21\u7ed3\u679c\u6295\u5f71\u5230\u571f\u5730\u5229\u7528\u548c\u4eba\u53e3\u5bc6\u5ea6\u56fe\u4e0a\uff0c\u5e76\u6c47\u603b\u6700\u7ec8\u8f93\u51fa\u7ed3\u679c\u4ee5\u5339\u914d\u66f4\u7cbe\u786e\u7684\u7684\u571f\u5730\u5229\u7528\u56fe\u7684\u5206\u8fa8\u7387\uff08Hoskins et al 2016\uff09\u3002 \u6700\u7ec8\u8f93\u51fa\u7ed3\u679c\u6a21\u62df\u4e86\u68ee\u6797\u53d8\u5316\u5bf9\u68ee\u6797\u751f\u7269\u7fa4\u843d\u5185\u5f53\u5730\u751f\u7269\u591a\u6837\u6027\u5b8c\u6574\u6027\u7684\u5f71\u54cd\u3002", "5f4ab07d04b3d6de13e72ffdc52fb137": "\u975e\u5546\u4e1a\u7528\u9014", "e8153e9722e2aa7b5e1702db04c499a5": "\u751f\u7269\u591a\u6837\u6027\u7684\u91cd\u8981\u6027", "26b8882e2abe075beea1976e41f42bdc": "\u6839\u636e\u6bcf\u4e2a\u50cf\u7d20\u5bf9\u54fa\u4e73\u52a8\u7269\u3001\u9e1f\u7c7b\u3001\u4e24\u6816\u52a8\u7269\u548c\u9488\u53f6\u6811\u7b49\u4f9d\u8d56\u68ee\u6797\u7269\u79cd\u7684\u5206\u5e03\u7684\u603b\u4f53\u8d21\u732e\u6765\u5176\u663e\u793a\u76f8\u5bf9\u91cd\u8981\u6027\u3002", "41c9c14038659d8c3e4e8f8a44e7875a": "\u56fd\u9645\u81ea\u7136\u4fdd\u62a4\u8054\u76df (IUCN)\u3001\u56fd\u9645\u9e1f\u76df\u548c\u8054\u5408\u56fd\u73af\u5883\u89c4\u5212\u7f72\u4e16\u754c\u4fdd\u62a4\u76d1\u6d4b\u4e2d\u5fc3 (UNEP-WCMC)\u3002\u6765\u81ea <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">IUCN \u7ea2\u8272\u540d\u5f55</a>\u548c<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u9645\u9e1f\u76df</a>\u7684\u5e95\u5c42\u7269\u79cd\u5730\u56fe\u3002\u6765\u81ea <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">IUCN \u7ea2\u8272\u540d\u5f55</a>\u3001<a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4e16\u754c\u5173\u952e\u751f\u7269\u591a\u6837\u6027\u5730\u533a\u6570\u636e\u5e93</a>\u548c<a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4e16\u754c\u4fdd\u62a4\u533a\u6570\u636e\u5e93</a>\u7684\u7efc\u5408\u6570\u636e\u53ef\u4ece<a href=\"{{5}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u751f\u7269\u591a\u6837\u6027\u7efc\u5408\u8bc4\u4f30\u5de5\u5177</a>\u4e2d\u83b7\u53d6\u3002", "470535ba5007f01fc03a8169ba994763": "\u5c06\u63d0\u4f9b\u591a\u79cd\u5b9a\u4e49\u751f\u7269\u591a\u6837\u6027\u610f\u4e49\u7684\u65b9\u6cd5\u3002\u8be5\u5c42\u57fa\u4e8e\u67d0\u79cd\u7279\u5b9a\u65b9\u6cd5\u3002", "29e66051219ec1dc529371793c36a189": "\u672c\u6b21\u5206\u6790\u4ec5\u6d89\u53ca\u9e1f\u7c7b\u3001\u54fa\u4e73\u52a8\u7269\u3001\u4e24\u6816\u52a8\u7269\u548c\u9488\u53f6\u6797\u7b49", "cc4888fd6c4a7a644f76f577b8335a28": "\u4ec5\u5305\u62ec\u4f9d\u8d56\u68ee\u6797\u7684\u7269\u79cd\u3002", "07b167008e0098f4d452bb05d95fcbb6": "\u8be5\u5c42\u6240\u57fa\u4e8e\u7684\u5355\u4e2a\u7269\u79cd\u8303\u56f4\u56fe\u663e\u793a\u4e86\u5206\u5e03\u8fb9\u754c\uff0c\u800c\u4e0d\u662f\u5360\u7528\u7387\uff0c\u56e0\u6b64\u5305\u542b\u5206\u7c7b\u8bef\u5dee\u3002\u4f46\u662f\uff0c\u5f53\u5c06&gt;15,000\u4e2a\u7269\u79cd\u8303\u56f4\u5408\u5e76\u5230\u6b64\u5355\u5c42\u4e2d\u65f6\uff0c\u6b64\u7c7b\u9519\u8bef\u5c06\u53d8\u5f97\u65e0\u5173\u7d27\u8981\u3002", "fb0ee162daaa29a27978d3f926c460ea": "\u5386\u53f2\u8303\u56f4\u672a\u5305\u542b\u5728\u5185\u3002\u56e0\u6b64\uff0c\u82e5\u6709\u50cf\u7d20\u53d1\u751f\u53bb\u68ee\u6797\u5316\uff0c\u5219\u6bcf\u4e2a\u50cf\u7d20\u7684\u4ef7\u503c\u4e0e\u603b\u4f53\u7684\u7269\u79cd\u4e30\u5bcc\u5ea6\u7684\u635f\u5931\u6709\u5173\u3002", "b07ca4f0eba7992d54bebcbdeb55b2df": "\u7269\u79cd\u4e30\u5bcc\u7a0b\u5ea6\u8f83\u9ad8\u7684\u4f4d\u7f6e\u4e0d\u4e00\u5b9a\u4f1a\u83b7\u5f97\u9ad8\u5206\uff0c\u5982\u679c\u8be5\u4f4d\u7f6e\u7684\u7269\u79cd\u5e7f\u6cdb\u5206\u5e03\u5728\u5168\u7403\u8303\u56f4", "97873f5a79fb91f0d12bc3915566da5d": "\u5e73\u7b49\u5bf9\u5f85\u6240\u6709\u7269\u79cd\uff0c\u56e0\u6b64\u4e0d\u8003\u8651\u5404\u5206\u7c7b\u7fa4\u7684\u8fdb\u5316\u7279\u6b8a\u6027\u3002", "ca2413957f7fab85538a0cd8f4d6935f": "\u5f53\u4e0e\u68ee\u6797\u635f\u5931\u56fe\u91cd\u53e0\u65f6\uff0c\u5ffd\u7565\u68ee\u6797\u84c4\u79ef\u3002\u8003\u8651\u5230\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u518d\u751f\u7684\u81ea\u7136\u65f6\u6ede\uff0c\u5047\u5b9a\u5206\u6790\u671f\u95f4\u7684\u6811\u6728\u8986\u76d6\u589e\u52a0\u4e0d\u592a\u53ef\u80fd\u8f6c\u5316\u4e3a\u4f9d\u8d56\u68ee\u6797\u7684\u7269\u79cd\u7684\u663e\u8457\u589e\u52a0\u3002", "46129704396110037a6b944317def72f": "\u6b64\u56fe\u5c42\u6982\u62ec\u5c55\u73b0\u4e86\u5168\u7403\u4e0d\u540c\u68ee\u6797\u751f\u7269\u591a\u6837\u6027\u7684\u91cd\u8981\u610f\u4e49\uff0c\u4e0d\u5efa\u8bae\u5728\u5b89\u6392\u4f18\u5148\u7ea7\u6216\u4f5c\u51b3\u7b56\u65f6\u5355\u72ec\u91c7\u7528\uff0c\u56e0\u4e3a\u8fd9\u4e9b\u64cd\u4f5c\u901a\u5e38\u8fd8\u8981\u8003\u8651\u5176\u4ed6\u4fe1\u606f\uff08\u4f8b\u5982\uff0c\u5a01\u80c1\u7a0b\u5ea6\u3001\u6210\u672c\u7b49\uff09\u3002", "e64408f2f128805dd7c46ba001c7d355": "\u8be5\u5c42\u663e\u793a\u4e86\u6bcf\u4e2a\u68ee\u6797\u4f4d\u7f6e\u5bf9\u751f\u7269\u591a\u6837\u6027\u7684\u91cd\u8981\u6027\uff0c\u5373\u6bcf\u4e2a\u50cf\u7d20\u5bf9\u5168\u4e16\u754c\u6240\u6709\u4f9d\u8d56\u68ee\u6797\u7684\u54fa\u4e73\u52a8\u7269\u3001\u9e1f\u7c7b\u3001\u4e24\u6816\u52a8\u7269\u548c\u9488\u53f6\u6811\u7684\u5168\u7403\u5206\u5e03\u7684\u76f8\u5bf9\u8d21\u732e\u3002\u4e3a\u4e86\u8ba1\u7b97\u5b83\uff0c\u6211\u4eec\u9009\u53d6\u4e86\u81ea\u7136\u4fdd\u62a4\u8054\u76df\u7ea2\u8272\u6e05\u5355\u4e2d\u88ab\u7f16\u7801\u4e3a\u4f9d\u8d56\u68ee\u6797\u7684\u7269\u79cd\uff0c\u5b83\u4eec\u7684\u5206\u5e03\u56fe\u88ab\u5b83\u4eec\u5df2\u77e5\u7684\u6d77\u62d4\u8303\u56f4\uff08\u6ce8\u610f\u4e24\u6816\u52a8\u7269\u7684\u6d77\u62d4\u8303\u56f4\u5c1a\u672a\u8bc4\u4f30\uff09\u7528\u6570\u5b57\u9ad8\u7a0b\u6a21\u578b\u6570\u636e\u96c6\u526a\u88c1\uff0c\u5e76\u4e0e\u68ee\u6797\u8986\u76d6\u5c42\u53e0\u52a0\u3002\u5bf9\u4e8e\u6bcf\u4e2a\u7269\u79cd\uff0c\u5176\u8303\u56f4\u5185\u6bcf\u4e2a\u68ee\u6797\u50cf\u7d20\u7684\u76f8\u5bf9\u201c\u663e\u8457\u6027\u201d\u88ab\u8ba1\u7b97\u4e3a\u4e00\u9664\u4ee5\u5176\u8303\u56f4\u5185\u7684\u68ee\u6797\u50cf\u7d20\u603b\u6570\u3002\u5bf9\u50cf\u7d20\u5185\u51fa\u73b0\u7684\u6240\u6709\u79cd\u7c7b\u7684\u8fd9\u4e9b\u503c\u6c42\u548c\uff0c\u4ee5\u7ed9\u51fa\u50cf\u7d20\u7684\u603b\u4f53\u503c\u3002\u8fd9\u4e2a\u6307\u6807\u6709\u65f6\u4e5f\u88ab\u79f0\u4e3a\u201c\u8303\u56f4\u7a00\u6709\u6027\u201d\u3002", "61e43a743d7c315c1179cc5e0b92e661": "\u663e\u793a\u5173\u952e\u6027\u7684\u4fdd\u80b2\u533a\u57df\uff0c\u8fd9\u4e9b\u5730\u65b9\u62e5\u6709\u6570\u91cf\u975e\u5e38\u6709\u9650\u7684\u6fd2\u5371\u7269\u79cd\uff0c\u4e14\u8fd9\u4e9b\u7269\u79cd\u7684\u6d3b\u52a8\u7a7a\u95f4\u4ec5\u9650\u4e8e\u5f53\u5730\u3002", "dad2b86f50fffb2e90efca3a25be423a": "\u6bcf 5 \u5e74", "0d6ea53f18e72958d3285b0c101e622d": "\u7531\u96f6\u706d\u7edd\u8054\u76df\uff08AZE\uff09\u521b\u5efa\uff0c\u6b64\u6570\u636e\u96c6\u663e\u793a\u4e86 587 \u4e2a\u5730\u70b9\u7684 920 \u79cd\u54fa\u4e73\u52a8\u7269\u3001\u9e1f\u7c7b\u3001\u4e24\u6816\u52a8\u7269\u3001\u722c\u884c\u52a8\u7269\u3001\u9488\u53f6\u6797\u548c\u9020\u7901\u73ca\u745a\u3002\u8fd9\u4e9b\u5730\u70b9\u53d1\u73b0\u7684\u7269\u79cd\u62e5\u6709\u6781\u5c0f\u7684\u5168\u7403\u8303\u56f4\u548c\u6570\u91cf\uff1b\u4e00\u4e2a\u5730\u70b9\u7684\u6816\u606f\u5730\u7684\u4efb\u4f55\u6539\u53d8\u90fd\u53ef\u80fd\u5bfc\u81f4\u8be5\u7269\u79cd\u5728\u91ce\u5916\u7684\u706d\u7edd\u3002\u4e3a\u4e86\u6ee1\u8db3 AZE \u706d\u7edd\u5730\u70b9\u7684\u8981\u6c42\uff0c\u8be5\u5730\u70b9\u5fc5\u987b\uff1a<br> - \u81f3\u5c11\u5305\u542b\u4e00\u4e2a\u6fd2\u5371\u6216\u4e25\u91cd\u6fd2\u5371\u7684\u7269\u79cd<br> - \u662f\u6fd2\u5371\u6216\u4e25\u91cd\u6fd2\u5371\u7684\u7269\u79cd\u51fa\u73b0\u7684\u552f\u4e00\u533a\u57df\uff0c<br> - \u542b\u6709\u8be5\u7269\u79cd\u5df2\u77e5\u5e38\u4f4f\u6570\u91cf\u7684 95\uff05\u4ee5\u4e0a\u6216\u8005\u8be5\u7269\u79cd\u5728\u67d0\u4e00\u751f\u547d\u9636\u6bb5\uff08\u5982\u7e41\u6b96\u5730\u548c\u8d8a\u51ac\uff09\u5df2\u77e5\u5e38\u4f4f\u6570\u91cf\u768495\uff05\u4ee5\u4e0a<br> - \u6709\u4e00\u4e2a\u53ef\u754c\u5b9a\u7684\u8fb9\u754c\uff08\u4f8b\u5982\uff0c\u7269\u79cd\u8303\u56f4\u3001\u6816\u606f\u5730\u8fde\u7247\u7a0b\u5ea6\uff0c\u7b49\u7b49\u3002 \uff09", "f29e3f8296b33d90eb587bac0199c705": "\u96f6\u706d\u7edd\u8054\u76df (AZE) \u6210\u7acb\u4e8e 2005 \u5e74\uff0c\u7531 83 \u4e2a\u975e\u653f\u5e9c\u6027\u751f\u7269\u591a\u6837\u6027\u4fdd\u80b2\u7ec4\u7ec7\u7ec4\u6210\uff0c\u65e8\u5728\u9632\u6b62\u7269\u79cd\u706d\u7edd\u3002\u96f6\u706d\u7edd\u8054\u76df\u81f4\u529b\u4e8e\u53d1\u6398\u5e76\u4fdd\u62a4\u90a3\u4e9b\u91cd\u8981\u7684\u81ea\u7136\u533a\u57df\uff0c\u8fd9\u4e9b\u533a\u57df\u662f<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u9645\u81ea\u7136\u4fdd\u62a4\u8054\u5408\u4f1a</a>\u8bc4\u5b9a\u7684\u6fd2\u5371\u6216\u6781\u5ea6\u6fd2\u5371\u7269\u79cd\u7684\u552f\u4e00\u5e78\u5b58\u4e4b\u5730\u3002", "44df18f191071594860da0bd500e1149": "\u5173\u952e\u751f\u7269\u591a\u6837\u6027\u533a\u57df\u4e16\u754c\u6570\u636e\u5e93", "fa18baa641d0fe81831a43f90c385df9": "\u663e\u793a\u5173\u952e\u751f\u7269\u591a\u6837\u6027\u533a\u57df\uff0c\u8fd9\u4e9b\u533a\u57df\u7684\u5b9a\u4e49\u662f\u201c\u5bf9\u5168\u7403\u751f\u7269\u591a\u6837\u6027\u7684\u6301\u7eed\u6709\u91cd\u5927\u8d21\u732e\u7684\u5730\u70b9\u201d\u3002", "958e3842b2870902bd612654d3ad7944": "\u5168\u7403\uff0c\u6240\u6709\u56fd\u5bb6\uff0c\u9646\u5730\uff0c\u6de1\u6c34\u548c\u6d77\u6d0b\u3002", "1338c024c6e897f253dfec525a4da8f8": "\u6bcf\u5e74\u4e24\u6b21", "f011463f6bd8794bc38194003191e341": "\u6ce8\u610f\uff0c\u6bcf\u4e2a\u56fd\u5bb6\u6240\u6709\u7269\u79cd\u7fa4\u548c\u751f\u7269\u591a\u6837\u6027\u7279\u5f81\u7684 KBA \u5c1a\u672a\u5168\u9762\u786e\u5b9a\u3002\u66f4\u591a\u8be6\u60c5\u8bf7\u53c2\u89c1<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">http://www.keybiodiversityareas.org</a>\u3002", "23ca8c07490151e2b682aeab5f9b8d9e": "\u4ec5\u9650\u975e\u5546\u4e1a\u7528\u9014\u3002\u5b8c\u6574\u7684\u4f7f\u7528\u6761\u6b3e\u8bf7\u53c2\u89c1<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">http://www.keybiodiversityareas.org/info/dataterms</a>\u3002", "cf9a73bc78e7e205087d3726774916c9": "\u5546\u4e1a\u8bbf\u95ee\u8bf7\u524d\u5f80 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">https://ibat-alliance.org</a>", "296b2aa8d40abf90d57e1fb47bcdd533": "\u663e\u793a\u4e86\u4fdd\u62a4\u56fd\u9645\u7684\u751f\u7269\u591a\u6837\u6027\u70ed\u70b9\u2014\u2014\u5b9a\u4e49\u4e86\u4e16\u754c\u4e0a\u7684\u4e00\u4e9b\u533a\u57df\uff0c\u90a3\u91cc\u7684\u751f\u7269\u591a\u6837\u6027\u4fdd\u62a4\u5de5\u4f5c\u975e\u5e38\u6025\u8feb\uff0c\u56e0\u4e3a\u90a3\u91cc\u6709\u5f88\u9ad8\u7684\u5730\u533a\u7279\u6b8a\u6027\u5e76\u4e14\u53d7\u5230\u4e86\u4eba\u7c7b\u7684\u5a01\u80c1", "eeb22b041b0c68fcaa4794084763eaad": "\u6bcf\u4e2a KBA \u7684\u5168\u90e8\u8be6\u7ec6\u4fe1\u606f\uff0c\u5305\u62ec\u5173\u4e8e\u5176\u751f\u7269\u591a\u6837\u6027\u91cd\u8981\u6027\u7684\u4fe1\u606f\uff0c\u53ef\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">http://www.keybiodiversityareas.org</a>\u67e5\u770b\u3002\u300a\u5173\u952e\u751f\u7269\u591a\u6837\u6027\u533a\u57df\u8bc6\u522b\u5168\u7403\u6807\u51c6\u300b (IUCN 2016) \u4e2d\u63cf\u8ff0\u4e86\u786e\u5b9a KBA \u7684\u6807\u51c6\u3002\u5982\u679c\u8be5\u5730\u70b9\u7b26\u5408 11 \u9879\u6807\u51c6\u4e2d\u7684\u4e00\u9879\u6216\u591a\u9879\uff0c\u5219\u6709\u8d44\u683c\u6210\u4e3a\u5168\u7403 KBA\uff0c\u8fd9\u4e9b\u6807\u51c6\u5206\u4e3a\u4e94\u7c7b\uff1a\u53d7\u5a01\u80c1\u7684\u751f\u7269\u591a\u6837\u6027\uff1b\u5730\u7406\u4e0a\u53d7\u9650\u5236\u7684\u751f\u7269\u591a\u6837\u6027\uff1b\u751f\u6001\u5b8c\u6574\u6027\uff1b\u751f\u7269\u5b66\u8fc7\u7a0b\uff1b\u4ee5\u53ca\u4e0d\u53ef\u66ff\u4ee3\u6027\u3002KBA \u6807\u51c6\u53ef\u9002\u7528\u4e8e\u9646\u5730\u3001\u5185\u9646\u6c34\u57df\u548c\u6d77\u6d0b\u73af\u5883\u4e2d\u7684\u7269\u79cd\u548c\u751f\u6001\u7cfb\u7edf\u3002\u867d\u7136\u5e76\u975e\u6240\u6709\u7684 KBA \u6807\u51c6\u90fd\u4e0e\u751f\u7269\u591a\u6837\u6027\u7684\u6240\u6709\u8981\u7d20\u76f8\u5173\uff0c\u4f46\u4e0e\u6bcf\u4e2a\u6807\u51c6\u76f8\u5173\u7684\u9608\u503c\u53ef\u9002\u7528\u4e8e\u6240\u6709\u79cd\u7fa4\uff08\u9664\u5fae\u751f\u7269\u5916\uff09\u548c\u751f\u6001\u7cfb\u7edf\u3002KBA \u786e\u5b9a\u8fc7\u7a0b\u662f\u4e00\u9879\u9ad8\u5ea6\u5305\u5bb9\u3001\u534f\u5546\u548c\u81ea\u4e0b\u800c\u4e0a\u7684\u5de5\u4f5c\u3002\u5c3d\u7ba1\u4efb\u4f55\u62e5\u6709\u9002\u5f53\u79d1\u5b66\u6570\u636e\u7684\u4eba\u90fd\u53ef\u4ee5\u63d0\u8bae\u4e00\u4e2a\u7b26\u5408\u8d44\u683c\u7684\u5730\u70b9\u6210\u4e3a KBA\uff0c\u4f46\u5728\u63d0\u8bae\u8fc7\u7a0b\u4e2d\u9700\u8981\u4e0e\u56fd\u5bb6\u5c42\u9762\u7684\u5229\u76ca\u76f8\u5173\u8005\uff08\u5305\u62ec\u975e\u653f\u5e9c\u7ec4\u7ec7\u548c\u653f\u5e9c\u7ec4\u7ec7\uff09\u8fdb\u884c\u534f\u5546\u3002", "04cd8a48230b9a16567c04f18619f228": "KBA Partnership \u6c47\u96c6\u4e86\u5168\u4e16\u754c\u6700\u5927\u7684  13 \u4e2a\u56fd\u9645\u4fdd\u62a4\u7ec4\u7ec7\uff0c\u6765\u7ed8\u5236\u5730\u56fe\u3001\u76d1\u6d4b\u548c\u4fdd\u62a4\u5730\u7403\u4e0a\u6700\u91cd\u8981\u7684\u751f\u547d\u4e4b\u5730\u3002", "79c25e935ef7afd0faa37f4aa28b1a51": "\u5982\u9700\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u8bbf\u95ee www.keybiodiversityareas.org", "6aa7f4edf55c757f83b88810ad917ad7": "\u751f\u7269\u591a\u6837\u6027\u70ed\u70b9", "46e7da9a7cdf00cb1aa9a63bbb0d9e5b": "\u5168\u7403\uff08\u4ec5\u9646\u5730\uff09", "ba46ac86aa04f7d73d1a5b36dd76b08e": "\u672c\u5c42\u53ea\u663e\u793a\u751f\u7269\u591a\u6837\u6027\u70ed\u70b9\u5730\u533a\u7684\u9646\u57fa\u90e8\u5206\uff0c\u5c3d\u7ba1\u4e00\u4e9b\u70ed\u70b9\u5730\u533a\u5411\u6d77\u9762\u5ef6\u4f38", "19ad48c5bd0f81268dd37b5e3823bed4": "\u5728 1988 \u5e74\u9996\u5148\u7531\u79d1\u5b66\u5bb6\u8bfa\u66fc\u00b7\u8fc8\u5c14\u65af\u5b9a\u4e49\uff0c\u751f\u7269\u591a\u6837\u6027\u70ed\u70b9\u5730\u533a\u662f\u4ee5\u9ad8\u6c34\u5e73\u7684\u7279\u6709\u7269\u79cd\u6570\u91cf\u4ee5\u53ca\u6816\u606f\u5730\u663e\u8457\u4e27\u5931\u4e3a\u7279\u5f81\u7684\u533a\u57df\u3002\u5177\u4f53\u800c\u8a00\uff0c\u533a\u57df\u5fc5\u987b\u6ee1\u8db3\u4ee5\u4e0b\u6761\u4ef6\u624d\u80fd\u8fbe\u5230\u56fd\u9645\u4fdd\u62a4\u70ed\u70b9\u7684\u5206\u7c7b\uff1a", "df1b4fa7dfbe9d65aa1afda8409d60ad": "\u81f3\u5c11 1,500 \u79cd\u7ef4\u7ba1\u690d\u7269\uff08\u4e16\u754c\u603b\u6570\u7684 &gt; 0.5%\uff09\u5c5e\u4e8e\u8be5\u5730\u7279\u6709", "349d2e2da8387f5344c9326496a87098": "\u81f3\u5c1170\uff05\u7684\u539f\u59cb\u81ea\u7136\u690d\u88ab\u5df2\u7ecf\u5931\u53bb", "16be2a2d3ccfd82685ebfbebc35d541c": "\u5f53\u8fc8\u5c14\u65af\u9996\u6b21\u5b9a\u4e49\u8fd9\u4e2a\u672f\u8bed\u65f6\uff0c\u4ed6\u786e\u5b9a\u4e86 10 \u4e2a\u70ed\u5e26\u68ee\u6797\u70ed\u70b9\u533a\u57df\u3002\u4e3a\u4e86\u51c6\u786e\u5b9a\u4f4d\u91cd\u70b9\u4fdd\u80b2\u533a\uff0c\u4fdd\u62a4\u56fd\u9645 (CI) \u91c7\u7528\u4e86\u8be5\u672f\u8bed\u5e76\u91cd\u65b0\u8bc4\u4f30\u4e86\u70ed\u70b9\u5730\u533a\u7684\u6982\u5ff5\u3002\u5728\u8fd9\u4e2a\u8fc7\u7a0b\u4e2d\uff0cCI \u5f15\u5165\u4e86\u91cf\u5316\u9608\u503c\uff08\u89c1\u4e0a\u9762\uff09\u5e76\u589e\u52a0\u4e86\u65b0\u7684\u70ed\u70b9\u5730\u533a\u3002\u5f53\u65f6\u670925\u4e2a\u70ed\u70b9\u5730\u533a\u3002\u7531\u4e8e\u6301\u7eed\u7684\u73af\u5883\u5a01\u80c1\u53d8\u5316\u548c\u5bf9\u751f\u7269\u591a\u6837\u6027\u7406\u89e3\u7684\u4e0d\u65ad\u63d0\u5347\uff0cCI \u56e0\u6b64\u91cd\u65b0\u5bf9\u70ed\u70b9\u5730\u533a\u8fdb\u884c\u4e86\u8c03\u67e5\u4ee5\u786e\u5b9a\u8fb9\u754c\uff0c\u66f4\u65b0\u4fe1\u606f\u5e76\u589e\u6dfb\u4e86\u65b0\u7684\u533a\u57df\u3002\u5728\u8fd9\u4e2a\u8fc7\u7a0b\u4e2d\u53c8\u4ea7\u751f\u4e86 10 \u4e2a\u65b0\u7684\u70ed\u70b9\u533a\u57df\uff0c\u4f7f\u603b\u6570\u8fbe\u5230 35 \u4e2a\u3002", "100b923f1183458ee14b692695d80020": "\u751f\u7269\u591a\u6837\u6027\u70ed\u70b9 - 2016\u5e74", "eb304ee7495aaed87b43e93985f5d5fb": "\u70ed\u70b9\u5730\u533a", "a4a9143153b1c7dac999c862c6634172": "BirdLife\u7279\u6709\u9e1f\u7c7b\u533a\u57df - 2014\u5e74", "651840f110bfd5755e442b982f1183e5": "\u5730\u65b9\u6027\u9e1f\u7c7b\u533a", "c08b38eaac455a6c377ebc4247d6909d": "\u663e\u793a\u6709\u4e24\u79cd\u6216\u591a\u79cd\u7279\u6709\u9e1f\u7c7b\u91cd\u53e0\u7684\u5730\u7406\u5206\u5e03\u8303\u56f4\u7684\u533a\u57df", "e1b28b6de914e14de7c5b4a76eeb1311": "\u5c3d\u7ba1\u8bb8\u591a\u9e1f\u7c7b\u662f\u666e\u904d\u5b58\u5728\u7684\u7269\u79cd\uff0c\u4f46\u8d85\u8fc7 2,500 \u79cd\u4e3a\u67d0\u4e9b\u5730\u533a\u6240\u7279\u6709\uff0c\u4ec5\u5b58\u5728\u4e8e\u4e0d\u8db3 500 \u4e07\u516c\u9877\u7684\u533a\u57df\u5185\uff08\u9650\u5236\u533a\u57df\u7269\u79cd\uff09\u3002\u56fd\u9645\u9e1f\u7c7b\u8054\u76df\u4f7f\u7528\u5e26\u5730\u7406\u53c2\u8003\u7684\u5730\u65b9\u8bb0\u5f55\u7ed8\u5236\u4e86\u6bcf\u79cd\u533a\u57df\u9650\u5236\u7269\u79cd\u7684\u5b58\u5728\u8303\u56f4\u5730\u56fe\u3002\u901a\u8fc7\u8fd9\u4e2a\u8fc7\u7a0b\uff0c\u4ed6\u4eec\u786e\u5b9a\u4e86\u4e24\u79cd\u6216\u4e24\u79cd\u4ee5\u4e0a\u9650\u5236\u533a\u57df\u9e1f\u7c7b\u91cd\u53e0\u7684\u533a\u57df\u2014\u2014\u88ab\u79f0\u4f5c\u201c\u7279\u6709\u9e1f\u533a\u201d\uff08EBAs\uff09\u3002", "912436bccb5d4b225c6e0cd969a9d988": "\u5168\u7403\u4e00\u534a\u9650\u5236\u8303\u56f4\u7269\u79cd\u6b63\u53d7\u5230\u6216\u5c06\u53d7\u5230\u5a01\u80c1\uff0c\u53e6\u4e00\u534a\u7684\u6816\u606f\u5730\u4ecd\u53ef\u80fd\u51cf\u5c11\u6216\u9000\u5316\u3002\u5927\u591a\u6570 EBA \u5bf9\u4e8e\u5176\u4ed6\u52a8\u690d\u7269\u7fa4\u4f53\u9650\u5236\u8303\u56f4\u7269\u79cd\u7684\u4fdd\u80b2\u5de5\u4f5c\u4ecd\u6709\u91cd\u8981\u4f5c\u7528\u3002\u5b58\u5728\u8fd9\u4e9b\u9e1f\u79cd\u7684\u72ec\u7279\u666f\u89c2\u4ec5\u5360\u5730\u7403\u8868\u9762\u7684 4.5 %\uff0c\u5728\u6240\u6709\u751f\u6001\u7cfb\u7edf\u4fdd\u80b2\u4e2d\u5904\u4e8e\u4f18\u5148\u7ea7\u3002", "f3c0d3cf22510786d22769db376bf095": "\u4ece\u5730\u7406\u4e0a\u770b\uff0cEBA \u901a\u5e38\u6307\u7684\u662f\u5c9b\u5c7f\u6216\u8005\u5c71\u810a\uff0c\u5b83\u4eec\u5927\u5c0f\u5404\u5f02\uff0c\u4ece\u51e0\u767e\u516c\u9877\u5230\u4e00\u5343\u591a\u4e07\u516c\u9877\u4e0d\u7b49\u3002EBA \u5728\u5176\u6240\u652f\u6301\u7684\u6709\u9650\u8303\u56f4\u7684\u7269\u79cd\u6570\u91cf\u65b9\u9762\u4e5f\u4e0d\u5c3d\u76f8\u540c\uff08\u4ece 2 \u5230 80\uff09\u3002EBA \u5206\u5e03\u5728\u5168\u7403\uff0c\u4f46\u662f\u5927\u591a\u6570 (77%) \u4f4d\u4e8e\u70ed\u5e26\u6216\u4e9a\u70ed\u5e26\u3002", "38619d0d7563d1eb2523e4bacff17dcb": "\u4fdd\u62a4\u8001\u864e\u666f\u89c2", "a6afc9408d5e166c151061e32e33877d": "Tx2 \u8001\u864e\u4fdd\u62a4\u666f\u89c2\u533a", "f891233fb3a6ceb139c11ac1e11c2f25": "\u8fd9\u4e9b\u56fe\u5c42\u663e\u793a\u4e86\u5f53\u524d\u8001\u864e\u6816\u606f\u5730\u7684\u4f4d\u7f6e\u3001\u6816\u606f\u5730\u6269\u5f20\u533a\u57df\u548c\u5173\u952e\u7684\u8001\u864e\u8d70\u5eca\u3002", "a62cad8433f3148d13845b5dffcdc65a": "\u5b5f\u52a0\u62c9\u56fd\u3001\u4e0d\u4e39\u3001\u67ec\u57d4\u5be8\u3001\u4e2d\u56fd\u3001\u5370\u5ea6\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u3001\u8001\u631d\u3001\u9a6c\u6765\u897f\u4e9a\u3001\u7f05\u7538\u3001\u5c3c\u6cca\u5c14\u3001\u4fc4\u7f57\u65af\u3001\u6cf0\u56fd\u548c\u8d8a\u5357", "7f9a8cdf723a615ede24f2c661dd72ba": "\u6bcf\u5e74\u66f4\u65b0", "1aa7a8dd8fd6b41e6dd19bd6d212bf68": "\u8001\u864e\u4fdd\u80b2\u666f\u89c2\u7684\u8bbe\u7acb\u57fa\u4e8e\u4e00\u4e2a\u5047\u8bbe\u524d\u63d0\uff0c\u5373\u5408\u9002\u7684\u6816\u606f\u5730\u53d6\u51b3\u4e8e\u571f\u5730\u8986\u76d6\u548c\u730e\u7269\u7fa4\u4f53\u7684\u8d28\u91cf\u548c\u89c4\u6a21\u3002", "9e7c38d2c24a1a0658313570e0531890": "\u5728\u67d0\u4e9b\u7279\u5b9a\u5730\u52bf\u4e0a\u571f\u5730\u8986\u76d6\u6570\u636e\u662f\u6709\u95ee\u9898\u7684\uff0c\u8fd9\u4e9b\u95ee\u9898\u662f\u7531\u4eba\u5de5\u6797\u7684\u5b58\u5728\u800c\u5f15\u8d77\u7684\u3002\u6709\u65f6\u5019\u68ee\u6797\u8986\u76d6\u88ab\u9ad8\u4f30\u4e86\u6216\u8005\u4f4e\u4f30\u4e86\u3002", "75afc4a6f2f696d28bc1e97c31e01099": "\u8fd9\u4e24\u4e2a\u6570\u636e\u96c6\u7531 WWF \u548c RESOLVE \u5236\u4f5c\uff0c\u663e\u793a\u4e86\u5f53\u524d\u8001\u864e\u6816\u606f\u5730\u7684\u4f4d\u7f6e\u548c\u6816\u606f\u5730\u4fdd\u62a4\u7684\u4f18\u5148\u533a\u57df\u3002", "bd7e2bdf749757baf5cb2acf227fb01e": "*\u8001\u864e\u6816\u606f\u5730\uff1a *<br>\u8001\u864e\u6816\u606f\u5730 (TCLs) \u662f\u5927\u7247\u8fde\u7eed\u6216\u8fde\u901a\u533a\u57df\uff0c\u9002\u4e8e\u8001\u864e\u6816\u606f\uff0c\u53ef\u4ee5\u4f9b\u81f3\u5c11\u4e94\u53ea\u6210\u5e74\u8001\u864e\u751f\u6d3b\uff0c\u800c\u4e14\u5728\u8fc7\u53bb\u5341\u5e74\u5185\u8bc1\u5b9e\u6709\u8001\u864e\u51fa\u6ca1\u3002\u8be5\u6570\u636e\u96c6\u901a\u8fc7\u7ed8\u5236\u8001\u864e\u5206\u90e8\u5730\u56fe\u521b\u5efa\uff0c\u7531\u571f\u5730\u8986\u88ab\u7c7b\u578b\u3001\u68ee\u6797\u8986\u76d6\u7a0b\u5ea6\u4ee5\u53ca\u730e\u7269\u57fa\u7fa4\uff0c\u76f8\u6bd4\u8f83\u4eba\u7c7b\u5f71\u54cd\u6307\u6570\u6d4b\u5b9a\u3002\u7b26\u5408\u6816\u606f\u5730\u6761\u4ef6\uff0c\u4f46\u53d7\u4eba\u7c7b\u5f71\u54cd\u7a0b\u5ea6\u8f83\u9ad8\u7684\u533a\u57df\uff0c\u5c06\u4e0d\u4f1a\u88ab\u8ba4\u4e3a\u662f\u8001\u864e\u6816\u606f\u5730\u3002", "09299587d899ebcf6cd5b625b2e035b8": "*Tx2 \u8001\u864e\u6816\u606f\u5730\u4fdd\u62a4\u533a\uff1a*<br> \u8fd9\u4e2a\u6570\u636e\u96c6\u663e\u793a 29 \u4e2a TX2 \u8001\u864e\u6816\u606f\u5730\u4fdd\u62a4\u533a\uff08TX2 TCLs\uff09\uff0c\u622a\u81f3 2020 \u5e74\u8fd9\u4e9b\u754c\u5b9a\u7684\u533a\u57df\u5c06\u901a\u8fc7\u9002\u5f53\u7684\u517b\u62a4\u548c\u7ba1\u7406\u4f7f\u91ce\u751f\u864e\u7684\u6570\u91cf\u7ffb\u500d\u3002", "79112a8c242132554c55a16d262ecd94": "\u8be5\u6570\u636e\u96c6\u5efa\u7acb\u5728\u8001\u864e\u5b9a\u4f4d\u6570\u636e\u5e93\u4e0a\uff0c\u8fd9\u4e2a\u6570\u636e\u5e93\u4e2d\u67d0\u4e9b\u5730\u533a\u7684\u6570\u636e\u662f\u4e0d\u5b8c\u6574\u7684\uff0c\u6570\u636e\u6765\u6e90\u548c\u7814\u7a76\u65b9\u6cd5\u4e5f\u591a\u79cd\u591a\u6837\u3002", "458aa33ade1228ce4163b0bcb0afd5c1": "\u6570\u636e\u96c6<svg class=\"c-icon arrow-icon\" viewBox=\"0 0 32 32\"><use xlink:href=\"#arrow-down-394c3635--sprite\"></use></svg>", "ddac733f71b7df8ca2828a9f48641b8d": "\u4f4d\u7f6e<svg class=\"c-icon arrow-icon\" viewBox=\"0 0 32 32\"><use xlink:href=\"#arrow-down-394c3635--sprite\"></use></svg>", "2ee37bf88b7ce6895983a4b6bf7837da": "\u5750\u6807<svg class=\"c-icon arrow-icon\" viewBox=\"0 0 32 32\"><use xlink:href=\"#arrow-down-394c3635--sprite\"></use></svg>", "a0fb042348059a8cbfe90e4919009076": "\u5341\u8fdb\u5236\u5ea6<svg class=\"c-icon arrow-icon\" viewBox=\"0 0 32 32\"><use xlink:href=\"#arrow-down-394c3635--sprite\"></use></svg>", "f0c245911592d35ed837400598592d7c": "UTM \u5750\u6807<svg class=\"c-icon arrow-icon\" viewBox=\"0 0 32 32\"><use xlink:href=\"#arrow-down-394c3635--sprite\"></use></svg>", "a38c2761908be5cef4a98ef5b3402ac9": "\u8d64\u9053", "070d077f5ce0b7849927bdf6db954de2": "\u5c3c\u65e5\u5229\u4e9a\u5927\u7329\u7329\u6816\u606f\u5730\u68ee\u6797\u780d\u4f10\u6fc0\u589e\uff1a\u201c\u6211\u4eec\u7684\u65f6\u95f4\u4e0d\u591a\u4e86\u201d", "5a758f4f87c450e199fb67cf8450bd1b": "\u68ee\u6797\u780d\u4f10\u5a01\u80c1\u5df4\u5e03\u4e9a\u65b0\u51e0\u5185\u4e9a\u6811\u888b\u9f20\u6816\u606f\u5730", "b140c0bf6362196db708b0cc2713c4b6": "\u62df\u8bae\u6258\u91cc\u5207\u5229\u5c71\u8109\u4fdd\u62a4\u533a (Torricelli Mountain Range Conservation Area) \u68ee\u6797\u780d\u4f10\u76f8\u5173\u8b66\u62a5\u5927\u5e45\u589e\u52a0\u3002\u2026\u2026", "031cc74dee9e72757ad05eb92f2387f6": "\u963f\u83f2\u6cb3\u68ee\u6797\u4fdd\u62a4\u533a (Afi River Forest Reserve/ARFR) \u68ee\u6797\u780d\u4f10\u589e\u591a\uff0c\u6784\u6210\u4e86\u5c3c\u65e5\u5229\u4e9a\u514b\u91cc\u65af\u6cb3\u5dde\u4e16\u7eaa\u4e4b\u4ea4\u4ee5\u6765\u6700\u5927\u7684\u68ee\u6797\u635f\u5931\u2026\u2026", "9774353ffd2a48b7403b3621b2ff74b3": "<strong>\u8bbf\u95ee\u7ad9\u70b9\u5176\u4ed6\u90e8\u5206</strong>\u3002\u4f7f\u7528\u5c4f\u5e55\u9876\u90e8\u7684\u4e3b\u83dc\u5355\u8bbf\u95ee GFW \u7f51\u7ad9\u7684\u5176\u4ed6\u90e8\u5206\uff0c\u4f8b\u5982\u4eea\u8868\u677f\u3001\u4e3b\u9898\u9875\u3001\u535a\u5ba2\u3001\u5173\u4e8e\u9875\u9762\u548c\u5e2e\u52a9\u4e2d\u5fc3\u3002\u65e0\u8bba\u60a8\u5f53\u524d\u5728\u7f51\u7ad9\u7684\u54ea\u4e2a\u90e8\u5206\uff0c\u6b64\u83dc\u5355\u59cb\u7ec8\u53ef\u89c1\u3002", "a8e3186b61a76035fa46f68e5b22b648": "<strong>\u7ba1\u7406 My GFW \u8d26\u6237</strong>\u3002\u7f16\u8f91\u60a8\u7684\u7528\u6237\u8d44\u6599\uff0c\u67e5\u770b\u60a8\u5df2\u4fdd\u5b58\u7684\u5173\u6ce8\u533a\u57df\u3002<a href=\"{{0}}\">\u70b9\u51fb\u6b64\u5904</a>\u4e86\u89e3\u5173\u4e8e My GFW \u8d26\u6237\u7ba1\u7406\u7684\u66f4\u591a\u4fe1\u606f\u3002", "f3868404faeb30b6e69607a057488cfb": "\u70b9\u51fb\u5730\u56fe\u53f3\u4e0b\u89d2\u7684\u9f7f\u8f6e\u56fe\u6807\u5207\u6362\u5e95\u56fe", "fa7d3ba1d6ed76dbf1a638e21531b6d5": "\u52fe\u9009\u5730\u56fe\u4e0a\u201c\u56fe\u4f8b\u201d\u9762\u677f\u5e95\u90e8\u6df1\u7070\u8272\u680f\u4e2d\u7684\u9009\u62e9\u6846\u4ee5\u8bbf\u95ee Planet \u56fe\u50cf", "2561392b482c8b16bc09df75a4f20b9d": "\u4ee5\u4e0b\u662f\u517c\u5bb9\u5206\u6790\u5de5\u5177\u7684\u6570\u636e\u5c42\uff0c\u5206\u4e3a\u201c\u5173\u6ce8\u533a\u57df\u201d\u6570\u636e\u5c42\u548c\u201c\u7814\u7a76\u201d\u6570\u636e\u5c42\uff1a", "67fdb2cfe6a748044d6df5a9de05894b": "<strong>\u5173\u6ce8\u533a\u57df</strong>\uff1a\u5b9a\u4e49\u8fb9\u754c\u7684\u6570\u636e\u5c42\uff0c\u53ef\u4ee5\u70b9\u51fb\u8fb9\u754c\u5c06\u5176\u4f5c\u4e3a\u5206\u6790\u76ee\u6807", "33c66450962a10418c2787da4116aef1": "<strong>\u7814\u7a76</strong>\uff1a\u8868\u793a\u53ef\u542f\u7528\u6d4b\u91cf\u7684\u6570\u636e\u5c42\uff0c\u53ef\u4ee5\u63d0\u4f9b\u6709\u5173\u533a\u57df\u5185\u53d8\u5316\u60c5\u51b5\u7684\u4fe1\u606f\u2014\u2014\u5c06\u51fa\u73b0\u5728\u5206\u6790\u5c0f\u5de5\u5177\u4e2d", "f027f27d0d548351e4d362e9b90678a9": "\u7814\u7a76", "82bbac104e28d4540c4bf0de1926733c": "\u52fe\u9009\u201c\u56fe\u4f8b\u201d\u9762\u677f\u5e95\u90e8\u6df1\u7070\u8272\u680f\u4e2d\u7684\u9009\u62e9\u6846\uff0c\u7136\u540e\u9009\u62e9\u6807\u8bb0\u4e3a\u201cLandsat 8/Sentinel 2\u201d\u7684\u9009\u9879\uff0c\u4ece\u800c\u542f\u7528\u8be5\u5de5\u5177\u3002", "ba05577265c1bd83dc886c2b6398711b": "\u70b9\u51fb\u60a8\u7684\u5173\u6ce8\u533a\u57df\u5373\u53ef\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u8be5\u533a\u57df\u3002\u9ed8\u8ba4\u60c5\u51b5\u4e0b\uff0c\u60a8\u5c06\u770b\u5230\u5728\u8be5\u533a\u57df\u5185\u7684\u6240\u6709\u6bc1\u6797\u8b66\u62a5\u3002\u5982\u679c\u540c\u4e00\u533a\u57df\u5185\u6709\u591a\u4e2a\u8b66\u62a5\uff0c\u5219\u4f1a\u5f62\u6210\u8b66\u62a5\u201c\u96c6\u7fa4\u201d\uff0c\u7531\u6807\u6709\u96c6\u7fa4\u5185\u8b66\u62a5\u6570\u91cf\u7684\u5706\u5708\u8868\u793a\u3002\u5982\u679c\u5728\u5730\u56fe\u4e0a\u653e\u5927\u8fd9\u4e2a\u96c6\u7fa4\uff0c\u96c6\u7fa4\u4f1a\u5206\u88c2\u5f62\u6210\u591a\u4e2a\u66f4\u5c0f\u7684\u96c6\u7fa4\u3002\u5982\u679c\u653e\u5927\u8f83\u5c0f\u7684\u96c6\u7fa4\uff0c\u8fd9\u4e9b\u96c6\u7fa4\u5c31\u4f1a\u6d88\u5931\uff0c\u5404\u4e2a\u8b66\u62a5\u663e\u793a\u4e3a\u7c89\u8272\u65b9\u5757\u3002", "c254b64709d2c4d349c5b97c086d1875": "\u52fe\u9009\u5730\u56fe\u4e0a\u201c\u56fe\u4f8b\u201d\u9762\u677f\u5e95\u90e8\u6df1\u7070\u8272\u680f\u4e2d\u7684\u9009\u62e9\u6846\uff0c\u5373\u53ef\u8bbf\u95ee\u6765\u81ea Planet \u7684\u9ad8\u5206\u8fa8\u7387\u536b\u661f\u56fe\u50cf\u3002<a href=\"{{0}}\">\u70b9\u51fb\u6b64\u5904</a>\u4e86\u89e3\u6709\u5173\u5982\u4f55\u4f7f\u7528\u536b\u661f\u56fe\u50cf\u8c03\u67e5\u68ee\u6797\u53d8\u5316\u7684\u66f4\u591a\u4fe1\u606f\u3002", "b5255d99990d1c27da198796b5920c13": "\u5c3c\u65e5\u5229\u4e9a\u5965\u5362\u74e6\u68ee\u6797\u4fdd\u62a4\u533a (Oluwa Forest Reserve) \u68ee\u6797\u780d\u4f10\u7387\u4f3c\u4e4e\u5728\u589e\u52a0\uff0c2021 \u5e74\u5927\u7247\u68ee\u6797\u6d88\u5931\uff0c\u5176\u4e2d\u5305\u62ec\u2026\u2026", "e8296321c3538f5fcb8ffa094ca30d33": "2011 \u81f3 2018 \u5e74\u95f4\uff0c\u5723\u80e1\u5b89\u6cb3\u751f\u7269\u5708\u4fdd\u62a4\u533a (R\u00edo San Juan Biosphere Reserve) \u5931\u53bb\u4e86\u7ea6 60 \u4e07\u516c\u9877\u68ee\u6797\u3002", "bbb929713396c2eed0595bc34d0d45d8": "\u6c34\u725b\u517b\u6b96\u70ed\u5e2d\u5377\u4e9a\u9a6c\u900a\uff0c\u571f\u8457\u571f\u5730\u56db\u9762\u695a\u6b4c", "033a0a9205f30597a36a2181933dbda0": "\u5370\u5ea6\u5c3c\u897f\u4e9a\u67d0\u6cb9\u68d5\u7279\u8bb8\u7ecf\u8425\u533a\u7684 Planet \u536b\u661f\u56fe\u50cf\uff0c\u8be5\u533a\u57df\u7ecf\u5386\u4e86\u68ee\u6797\u8986\u76d6\u635f\u5931\u3002\u4e3a\u83b7\u5f97\u66f4\u6e05\u6670\u7684\u89c6\u56fe\uff0c\u68ee\u6797\u8986\u76d6\u635f\u5931\u56fe\u5c42\u7684\u4e0d\u900f\u660e\u5ea6\u6709\u6240\u964d\u4f4e\u3002", "7345bcb422fc0d52ebc0ee57a4e9f0ad": "\u5173\u6ce8\u533a\u57df", "2b55a2205a5dfb2a4a276e6bad7fc0cb": "\u8fd9\u662f\u8bbe\u7f6e\u9875\u9762\u3002\u60a8\u53ef\u5728\u6b64\u542f\u7528\u201c\u79bb\u7ebf\u6a21\u5f0f\u201d\uff0c\u8fd9\u6709\u52a9\u4e8e\u63d0\u9ad8\u5e94\u7528\u7684\u7a33\u5b9a\u6027\uff0c\u5ef6\u957f\u91ce\u5916\u5de5\u4f5c\u671f\u95f4\u7684\u7535\u6c60\u5bff\u547d\u3002\u542f\u7528\u540e\uff0c\u56fe\u6807\u5c06\u53d8\u4e3a\u7eff\u8272\u3002\u6700\u597d\u5728\u51fa\u53d1\u8fdb\u884c\u8c03\u67e5\u4e4b\u524d\u786e\u8ba4\u60a8\u5df2\u6210\u529f\u4e0b\u8f7d\u8be5\u533a\u57df\u53ca\u5176\u5185\u8b66\u62a5\u3002\u5982\u679c\u672a\u5728\u542f\u7528\u201c\u79bb\u7ebf\u6a21\u5f0f\u201d\u4e4b\u524d\u4e0b\u8f7d\uff0c\u60a8\u5c06\u65e0\u6cd5\u8bbf\u95ee\u60a8\u7684\u533a\u57df\u548c\u533a\u57df\u5185\u7684\u8b66\u62a5\u3002\u786e\u8ba4\u5df2\u4e0b\u8f7d\u533a\u57df\u4f9b\u79bb\u7ebf\u4f7f\u7528\uff08\u53c2\u9605\u4e0a\u4e00\u8282\u4e2d\u7684\u6b65\u9aa4 10\uff09\u540e\uff0c\u60a8\u4fbf\u53ef\u542f\u7528\u201c\u79bb\u7ebf\u6a21\u5f0f\u201d\uff0c\u5e76\u8fd4\u56de\u201c\u533a\u57df\u201d\u9875\u9762\u4ee5\u9009\u62e9\u60a8\u7684\u533a\u57df\uff0c\u9a8c\u8bc1\u60a8\u662f\u5426\u53ef\u4ee5\u770b\u5230\u8b66\u62a5\u3002", "7381cc9773bdd115946b4e7ca52007e2": "\u52fe\u9009\u5730\u56fe\u4e0a\u201c\u56fe\u4f8b\u201d\u9762\u677f\u5e95\u90e8\u6df1\u7070\u8272\u680f\u4e2d\u7684\u9009\u62e9\u6846\u4ee5\u8bbf\u95ee Planet \u56fe\u50cf\u3002", "86a71446e00477b8f208b6ac52732f87": "<strong>\u5207\u6362\u8bed\u8a00</strong>\u3002\u53ef\u9009\u82f1\u8bed\u3001\u4e2d\u6587\u3001\u6cd5\u8bed\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u8bed\u3001\u8461\u8404\u7259\u8bed\u548c\u897f\u73ed\u7259\u8bed\u3002", "5642e80fef384ba22dd5e942bdfc7d38": "\u5c3c\u52a0\u62c9\u74dc\u751f\u7269\u5708\u4fdd\u62a4\u533a\u519c\u4e1a\u524d\u6cbf\u8fdb\u5c55", "54b177350bcbff97e7b6d627b1e63b26": "\u6839\u636e\u536b\u661f\u6570\u636e\u548c\u5f53\u5730\u6d88\u606f\u6765\u6e90\uff0c\u5965\u5854\u6d4e\u65af\u68ee\u6797\u780d\u4f10\u6108\u8d8b\u4e25\u91cd\uff0c\u5927\u7247\u68ee\u6797\u88ab\u5937\u4e3a\u5e73\u5730\uff0c\u53d8\u6210\u7267\u573a\u2026\u2026", "96058bc849b81c8754b9ab3c996f1ae3": "<strong>\u8bbf\u95ee\u6700\u65b0\u536b\u661f\u56fe\u50cf</strong>\u3002\u6700\u65b0\u536b\u661f\u56fe\u50cf\u63d0\u4f9b\u4e16\u754c\u5404\u5730\u690d\u88ab\u5065\u5eb7\u4fe1\u606f\uff0c\u901a\u5e38\u6709\u52a9\u4e8e\u8fd1\u5b9e\u65f6\u9a8c\u8bc1\u68ee\u6797\u780d\u4f10\u60c5\u51b5\u548c\u706b\u707e\u8b66\u62a5\u3002\u53ef\u4f7f\u7528\u6765\u81ea Planet\u3001Sentinel-2 \u548c Landsat 8 \u7684\u536b\u661f\u56fe\u50cf\uff0c\u56fe\u50cf\u6bcf\u65e5\u65b0\u589e\u3002<a href=\"{{0}}\">\u70b9\u51fb\u6b64\u5904</a>\u4e86\u89e3\u6709\u5173\u4f7f\u7528\u6700\u65b0\u536b\u661f\u56fe\u50cf\u8c03\u67e5\u68ee\u6797\u53d8\u5316\u7684\u66f4\u591a\u4fe1\u606f\u3002", "4ba817a7bad534dcf5141dd3dfcc9ae4": "<strong>\u8bbf\u95ee\u536b\u661f\u56fe\u50cf</strong>\u3002\u52fe\u9009\u5730\u56fe\u4e0a\u201c\u56fe\u4f8b\u201d\u9762\u677f\u5e95\u90e8\u6df1\u7070\u8272\u680f\u4e2d\u7684\u9009\u62e9\u6846\uff0c\u5373\u53ef\u8bbf\u95ee\u6765\u81ea Planet \u7684\u9ad8\u5206\u8fa8\u7387\u536b\u661f\u56fe\u50cf\u3002<a href=\"{{0}}\">\u70b9\u51fb\u6b64\u5904</a>\u4e86\u89e3\u6709\u5173\u5982\u4f55\u4f7f\u7528\u536b\u661f\u56fe\u50cf\u8c03\u67e5\u68ee\u6797\u53d8\u5316\u7684\u66f4\u591a\u4fe1\u606f\u3002", "689d7642efa14b9ec6b4d36d9565b878": "\u9009\u62e9\u653f\u6cbb\u8fb9\u754c\u5e76\u70b9\u51fb\u201c\u5206\u6790\u201d\u4ee5\u67e5\u770b\u6b64\u56fd\u5bb6/\u5730\u533a\u7684\u5206\u6790\u7ed3\u679c\u3002", "e1d77b6ea36ae07896a490678a80bcff": "\u82e5\u9700\u4f7f\u7528\u6700\u65b0\u536b\u661f\u56fe\u50cf\u5de5\u5177\uff0c\u8bf7\u5c06\u5341\u5b57\u7ebf\u7f6e\u4e8e\u60a8\u5173\u6ce8\u533a\u57df\u7684\u5730\u56fe\u4e2d\u5fc3\u3002\u52fe\u9009\u201c\u56fe\u4f8b\u201d\u9762\u677f\u5e95\u90e8\u6df1\u7070\u8272\u680f\u4e2d\u7684\u9009\u62e9\u6846\uff0c\u7136\u540e\u9009\u62e9\u6807\u8bb0\u4e3a\u201cLandsat 8/Sentinel 2\u201d\u7684\u9009\u9879\u3002\u53ea\u6709\u5341\u5b57\u7ebf\u4f4d\u4e8e\u9646\u5730\u4e0a\u65b9\u65f6\uff0c\u8be5\u5de5\u5177\u624d\u6709\u6548\u3002\u4e3a\u83b7\u5f97\u6700\u4f73\u6548\u679c\uff0c\u8bf7\u5728\u542f\u7528\u8be5\u5de5\u5177\u4e4b\u524d\u653e\u5927\u5230\u7279\u5b9a\u4f4d\u7f6e\u3002", "28f68b25bb234167b2fdf26607419889": "\u8bbf\u95ee <a href=\"{{0}}\">MapBuilder GitHub \u7f51\u9875</a>\uff0c\u67e5\u770b\u6709\u5173\u914d\u7f6e Web \u5730\u56fe\u5e94\u7528\u7a0b\u5e8f\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u5982\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\u65f6<a rel=\"noreferrer noopener\" href=\"{{1}}\" target=\"_blank\">\u9700\u8981\u8f93\u5165\u5230\u201c\u914d\u7f6e\u53c2\u6570\u201d\u7684\u4ee3\u7801</a>\u3002", "d437f298620995a1bf0d8bc97a5f7c9e": "Forest Watcher \u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u80fd\u79bb\u7ebf\u4f7f\u7528 GFW \u7684\u7a7a\u95f4\u6570\u636e\uff0c\u56e0\u6b64\uff0c\u60a8\u51fa\u5916\u4e1a\u65f6\u53ef\u76f4\u63a5\u901a\u8fc7\u667a\u80fd\u624b\u673a\u76d1\u6d4b\u548c\u7ba1\u7406\u68ee\u6797\u3002\u8bbe\u7f6e\u76d1\u6d4b\u533a\u57df\uff0c\u4e0b\u8f7d\u6ee5\u4f10\u548c\u706b\u707e\u8b66\u62a5\uff0c\u65e0\u8bba\u7f51\u7edc\u8fde\u63a5\u72b6\u51b5\u5982\u4f55\uff0c\u60a8\u90fd\u80fd\u968f\u8eab\u638c\u63e1\u8fd9\u4e9b\u4fe1\u606f\uff0c\u6709\u52a9\u4e8e\u60a8\u8c03\u67e5\u548c\u62a5\u544a\u53d1\u73b0\u7684\u5185\u5bb9\u3002\u5728 Forest Watcher \u79fb\u52a8\u7aef\u521b\u5efa\u7684\u533a\u57df\u4e5f\u5c06\u540c\u6b65\u5230 GFW \u4e3b\u5e73\u53f0\u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">MyGFW</a> \u533a\u57df\u8ba2\u9605\u548c\u64cd\u4f5c\u9762\u677f\u4e0a\u3002Forest Watcher \u5728 <a aria-label=\"undefined (opens in a new tab)\" rel=\"noreferrer noopener\" href=\"{{1}}\" target=\"_blank\">Apple App Store</a> \u548c <a rel=\"noreferrer noopener\" href=\"{{2}}\" target=\"_blank\">Google Play Store</a> \u5747\u53ef\u83b7\u53d6\u3002", "1ff84872f4cf08e6b57e19bed3db14e5": "<strong>Planet</strong>\uff1a<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u201cPlanet\u201d\u5e95\u56fe</a>\u63d0\u4f9b\u4e86\u6765\u81ea Planet Labs, Inc. \u7684\u9ad8\u5206\u8fa8\u7387\u536b\u661f\u56fe\u50cf\uff0c\u8fd9\u4e9b\u5206\u8fa8\u7387\u4e3a 5 \u7c73\u7684\u9576\u5d4c\u56fe\u4ece 2020 \u5e74 9 \u6708\u5f00\u59cb\u6bcf\u6708\u66f4\u65b0\uff0c\u70ed\u5e26\u5730\u533a\u53ef\u7528\u3002\u8fc7\u5f80\u5e74\u4efd\u4e5f\u6709 6 \u4e2a\u6708\u7684\u9576\u5d4c\u56fe\u53ef\u7528\u3002\u51ed\u501f\u5176\u9ad8\u9891\u7387\u7684\u66f4\u65b0\u548c\u9ad8\u5206\u8fa8\u7387\u7684\u56fe\u50cf\uff0cPlanet \u5e95\u56fe\u53ef\u7528\u4e8e\u8c03\u67e5\u76f8\u5173\u533a\u57df\u5e76\u5206\u6790\u56fe\u50cf\u4e2d\u7684\u635f\u5931\u6a21\u5f0f\u3002\u60a8\u53ef\u4ee5\u70b9\u51fb Planet \u56fe\u6807\u4e0b\u65b9\u53ef\u7528\u7684\u4e0b\u62c9\u83dc\u5355\uff0c\u9009\u62e9\u7279\u5b9a\u65f6\u6bb5\u7684\u56fe\u50cf\u3002\u6fc0\u6d3b\u6b64\u5e95\u56fe\u65f6\uff0c\u9ed8\u8ba4\u4e3a\u6700\u65b0\u56fe\u50cf\u3002<a href=\"{{1}}\">\u5728\u6b64</a>\u4e86\u89e3\u6709\u5173\u5982\u4f55\u4f7f\u7528\u536b\u661f\u56fe\u50cf\u8c03\u67e5\u68ee\u6797\u53d8\u5316\u7684\u66f4\u591a\u5185\u5bb9\u3002\u611f\u8c22\u632a\u5a01\u56fd\u9645\u6c14\u5019\u4e0e\u68ee\u6797\u5021\u8bae (Norway\u2019s International Climate and Forest Initiative, NICFI)\uff0c\u81f4\u529b\u4e8e\u963b\u6b62\u6ee5\u4f10\u3001\u5e94\u5bf9\u6c14\u5019\u53d8\u5316\u7684\u4eba\u4e5f\u5f97\u4ee5\u4f7f\u7528 Planet \u9576\u5d4c\u56fe\u3002\u8bbf\u95ee\u6b64<a rel=\"noreferrer noopener\" href=\"{{2}}\" target=\"_blank\">\u7f51\u9875</a>\uff0c\u6ce8\u518c\u514d\u8d39\u8d26\u6237\uff0c\u9009\u62e9\u8981\u4e0b\u8f7d\u7684\u9576\u5d4c\u56fe\u3002", "4f9c8124cd0b65a2ecb5c15e64de0332": "\u8981\u8bbf\u95ee\u5df2\u4fdd\u5b58\u81f3 MyGFW \u8d26\u6237\u7684\u533a\u57df\u7684\u64cd\u4f5c\u9762\u677f\uff0c\u8bf7\u5148\u70b9\u51fb GFW \u4e3b\u9875\u53f3\u4e0a\u89d2\u7684\u201cMyGFW\u201d\uff0c\u767b\u5f55 MyGFW\u3002\u5982\u679c\u4f60\u8fd8\u6ca1\u6709\u8d26\u6237\uff0c\u8bf7\u70b9\u51fb\u201c\u6ce8\u518c\u201d\u5e76\u6309\u7167\u8bf4\u660e\u64cd\u4f5c\u3002", "1e36566da2ed4c64cdd320493888f700": "\u7531 CCAD \u548c GIZ \u5408\u4f5c\u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">REDD \u5730\u533a\u8ba1\u5212</a>\u4e8e 2021 \u5e74 3 \u6708\u521b\u5efa\u4e86\u4e00\u4efd\u6307\u5357\uff0c\u5e76\u4e8e 2020 \u5e74 11 \u6708\u5f55\u5236\u4e86\u57f9\u8bad\u8bfe\u7a0b\uff0c\u6f14\u793a\u5982\u4f55\u4f7f\u7528 MapBuilder \u5728\u6240\u9009\u539f\u4f4f\u6c11\u9886\u5730\u5185\u521b\u5efa\u81ea\u5b9a\u4e49\u7684\u68ee\u6797\u76d1\u6d4b\u5e94\u7528\u7a0b\u5e8f\u3002\u8be5\u6307\u5357\u548c\u57f9\u8bad\u8bfe\u7a0b\u6709\u897f\u73ed\u7259\u8bed\u7248\u672c\u53ef\u7528\u3002", "879c7a1abac9479a8d9a895f51effbd2": "2001 \u5e74\uff0c{location} \u6709 {primaryForest} \u7247\u539f\u59cb\u68ee\u6797*\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684 {percentagePrimaryForest}\u3002{year} \u5e74\uff0c\u5b83\u635f\u5931\u4e86 {primaryLoss} \u539f\u59cb\u68ee\u6797*\uff0c\u76f8\u5f53\u4e8e {emissionsPrimary} \u7684 CO\u2082 \u6392\u653e\u91cf\u3002", "fad8a5f537e422a990219ee0ebd50208": "\u4f7f\u7528\u5730\u56fe\u548c\u64cd\u4f5c\u9762\u677f", "d04507a8f0097287263fcefda8803ca2": "\u4f7f\u7528\u8fd1\u671f\u536b\u661f\u56fe\u50cf\u8c03\u67e5\u68ee\u6797\u53d8\u5316", "9cee1a22651696f1ed0bdaf4922c9d88": "\u5728\u64cd\u4f5c\u9762\u677f\u4e0a\u6d4f\u89c8\u5168\u7403\u3001\u5168\u56fd\u53ca\u884c\u653f\u533a\u68ee\u6797\u7684\u7edf\u8ba1\u8d44\u6599", "07b1adcb247ea4e0b33a6a3bacf7d331": "\u5728 GFW \u793e\u533a\u53d1\u5e03\u95ee\u9898\uff0c\u5206\u4eab\u77e5\u8bc6\u3002", "eaef838d71d0bbc88d3b94b43ca48a6b": "\u8fd1\u671f\u536b\u661f\u56fe\u50cf\u5de5\u5177\u63d0\u4f9b\u4e86\u6709\u5173\u5168\u7403\u690d\u88ab\u5065\u5eb7\u7684\u4fe1\u606f\uff0c\u5e76\u53ef\u7528\u4ee5\u9a8c\u8bc1\u8fd1\u4e4e\u5b9e\u65f6\u7684\u8b66\u62a5\u3002", "fd868ac5964b876db9cd68a6307ddf44": "\u4f7f\u7528 Forest Watcher \u4e0b\u8f7d\u611f\u5174\u8da3\u533a\u6ee5\u4f10\u548c\u706b\u707e\u8b66\u62a5\uff0c\u5bfc\u822a\u5230\u8b66\u62a5\u5e76\u5b58\u6863\u8b66\u62a5\u539f\u56e0\u7684\u8bc1\u636e\u3002", "1b881e080cd7153cf52e1001b02c44f3": "\u5206\u4eab MapBuilder \u5e94\u7528\u7a0b\u5e8f", "87d602b6ce3df2ff05aabec8191779c0": "\u4f7f\u7528\u514d\u8d39\u7684 ArcGIS Online \u516c\u5171\u8d26\u6237\u6ce8\u518c\u670d\u52a1", "1f1245085a4abb95651821975cdbd00b": "GFW Data API \u63d0\u4f9b\u4e94\u79cd\u6838\u5fc3\u670d\u52a1\uff1a", "c7083f8b8e42f856d2fb985030af2b5f": "\u67d0\u4e9b\u7aef\u70b9\u9700\u8981\u7528\u6237\u5728\u8bf7\u6c42\u4e2d\u5305\u542b API \u5bc6\u94a5\uff0c\u60a8\u53ef\u5728\u6b64\u4e86\u89e3\u66f4\u591a\u3002", "90845e987feac43d3458b74e4f942766": "\u706b\u707e\u548c\u96fe\u973e\u5f71\u54cd", "6cc188b7247fa7d47293059dda796a41": "Forest Watcher \u53ef\u4ee5\u8ba9\u60a8\u5c06\u81ea\u5b9a\u4e49\u5e95\u56fe\u548c\u4e0a\u4e0b\u6587\u56fe\u5c42\u76f4\u63a5\u4e0a\u4f20\u5230\u79fb\u52a8\u5e94\u7528\u4e2d\u3002", "d96d22c05a820d14b86dcc7e4eeb9dc1": "\u79bb\u7ebf\u5bfc\u51fa\u5e94\u7528\u5185\u5bb9\u5e76\u5206\u4eab\u81f3\u5176\u4ed6\u8bbe\u5907", "fa6ec8428ec2298f19c231edc6c2a54a": "GFW Data API\uff08\u5e94\u7528\u7a0b\u5e8f\u63a5\u53e3\uff09\u662f\u4e00\u4e2a\u6807\u51c6\u5316\u7684\u7f51\u7edc\u7aef\u70b9\u96c6\u5408\uff0c\u63d0\u4f9b GFW \u76f8\u5173\u8d44\u6e90\uff08\u5982\u6570\u636e\u548c\u5206\u6790\uff09\u7684\u7f16\u7a0b\u8bbf\u95ee\u3002GFW Data API \u662f\u5bf9 WRI Resource Watch API \u7684\u8865\u5145\uff0c\u60a8\u53ef\u4ee5<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5728\u6b64\u4e86\u89e3\u66f4\u591a</a>\u3002", "9c01c6b4eb008f07ed7f000afe0d54d4": "\u5728 ArcGIS Online \u4e0a\u521b\u5efa Web \u5730\u56fe", "c8bc9f32234b5d9fc6798538df733c66": "<strong>\u6570\u636e\u76ee\u5f55</strong>\uff1a\u641c\u7d22\u53ef\u7528\u6570\u636e\u96c6\u5e76\u67e5\u770b\u5176\u5173\u8054\u7684\u5143\u6570\u636e", "2d51d3c71a20c8d8aaef936902a87f8c": "<strong>\u67e5\u8be2</strong>\uff1a\u5206\u6790\u6240\u9009\u6570\u636e\u96c6\uff0c\u5e76\u4e3a\u8f93\u5165\u7684\u4efb\u610f\u51e0\u4f55\u751f\u6210\u5206\u533a\u7edf\u8ba1\u8d44\u6599", "87b64d8bd3b91f9902cd6cf7408f60e2": "<strong>\u5206\u6790\u5730\u56fe\u6570\u636e\uff0c\u4fdd\u5b58\u533a\u57df\u5e76\u8ba2\u9605\u8b66\u62a5</strong>\u3002\u6709\u4e09\u79cd\u5206\u6790\u5730\u56fe\u6570\u636e\u7684\u65b9\u5f0f\uff0c\u53ef\u70b9\u51fb\u201c\u5206\u6790\u201d\u9009\u9879\u5361\u83b7\u53d6\uff1a\u5206\u6790\u56fd\u5bb6/\u5730\u533a\u6216\u884c\u653f\u53f8\u6cd5\u7ba1\u8f96\u533a\uff1b\u5206\u6790\u4e0a\u4e0b\u6587\u56fe\u5c42\uff1b\u5206\u6790\u81ea\u5b9a\u4e49\u533a\u57df\u3002\u5206\u6790\u533a\u57df\u540e\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u5c06\u5176\u4fdd\u5b58\u81f3 MyGFW \u8d26\u6237\u3002\u4fdd\u5b58\u533a\u57df\u540e\uff0c\u60a8\u53ef\u4ee5\u8ba2\u9605\u6ee5\u4f10\u6216\u706b\u707e\u8b66\u62a5\uff0c\u5e76\u5728\u64cd\u4f5c\u9762\u677f\u4e0a\u8bbf\u95ee\u8be5\u533a\u57df\u7684\u68ee\u6797\u7edf\u8ba1\u8d44\u6599\u3002\u81ea\u5b9a\u4e49\u64cd\u4f5c\u9762\u677f\u751f\u6210\u5b8c\u6bd5\u540e\uff0c\u60a8\u5c06\u6536\u5230\u4e00\u5c01\u7535\u5b50\u90ae\u4ef6\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u4e86\u89e3\u6709\u5173\u5206\u6790\u5730\u56fe\u6570\u636e\u7684\u66f4\u591a\u5185\u5bb9\uff0c<a href=\"{{1}}\">\u5728\u6b64</a>\u4e86\u89e3\u6709\u5173\u4fdd\u5b58\u548c\u8ba2\u9605\u533a\u57df\u7684\u66f4\u591a\u5185\u5bb9\u3002", "428c246dcc287ed27a5845703ad191ee": "\u65e0\u8bba\u60a8\u4f7f\u7528\u54ea\u79cd\u65b9\u6cd5\uff0c\u5206\u6790\u5b8c\u6210\u540e\uff0c\u60a8\u5c31\u53ef\u4ee5\u9009\u62e9\u8ba2\u9605\u5206\u6790\u533a\u57df\u4e2d\u7684\u6570\u636e\uff0c\u6216\u5728\u64cd\u4f5c\u9762\u677f\u4e0a\u8fdb\u4e00\u6b65\u63a2\u7d22\u8be5\u6570\u636e\u3002\u70b9\u51fb\u201c\u5728 MyGFW \u4e2d\u4fdd\u5b58\u201d\uff0c\u4ee5\u767b\u5f55\u5e76\u4fdd\u5b58\u533a\u57df\uff0c\u8ba2\u9605\u901a\u77e5\uff0c\u5728\u68c0\u6d4b\u5230\u68ee\u6797\u53d8\u5316\u65f6\u63d0\u9192\u60a8\u3002", "fce94ce2f20ae82d14d81fa49c99cc73": "\u60a8\u8fd8\u53ef\u4ee5\u4ece MyGFW \u7ba1\u7406\u5df2\u4fdd\u5b58\u7684\u611f\u5174\u8da3\u533a\u3002\u8981\u8bbf\u95ee MyGFW\uff0c\u8bf7\u5bfc\u822a\u81f3 GFW \u4e3b\u9875\uff0c\u6216\u4ece\u5730\u56fe\u4e0a\u70b9\u51fb\u7f51\u9875\u5de6\u4e0a\u89d2\u7684\u201cGlobal Forest Watch\u201d\u6807\u5fd7\u3002GFW \u4e3b\u9875\u52a0\u8f7d\u5b8c\u6bd5\u540e\uff0c\u8bf7\u70b9\u51fb\u7f51\u9875\u53f3\u4e0a\u89d2\u7684\u201cMyGFW\u201d\u3002", "ba9cfc3ab60a3c04956145f3020df6db": "\u5728 ArcGIS Online \u53d1\u5e03\u6570\u636e\u5e76\u5c06\u5176\u6dfb\u52a0\u5230\u60a8\u7684Web \u5730\u56fe\u3002", "69c558c7576356e99f74c4ff1b5dc955": "Forest Watcher Web \u6559\u7a0b", "2a56e7d422e5cef437a157576c659706": "Forest Watcher \u5916\u4e1a\u624b\u518c\u2014\u2014\u82f1\u6587", "b688b458faf1f0a9f126cc652daebfc3": "\u89c2\u770b\u5f55\u5236\u7684\u897f\u8bed\u7248\u57f9\u8bad\u8bfe\u7a0b\u3002", "9530a2990e2894982f7206808aaba2e4": "\u4f7f\u7528 MapBuilder \u5728\u6240\u9009\u539f\u4f4f\u6c11\u9886\u5730\u5185\u521b\u5efa\u68ee\u6797\u76d1\u6d4b\u5e94\u7528\u7a0b\u5e8f", "d7326e39a74b4926a8b52d64570c0177": "\u767b\u5f55\u6216\u6ce8\u518c <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">ArcGIS Online</a> \u8d26\u6237\u3002", "cd5a024a27ae41f5d08ab7dc69a98145": "\u6d4f\u89c8\u6b64\u6b21\u7f51\u7edc\u7814\u8ba8\u4f1a\u7684<a rel=\"noreferrer noopener\" href=\"{{0}}\" target=\"_blank\">\u6587\u5b57\u7248\u672c</a>\u3002", "f917c68b1e60ba732a004755022be776": "\u83b7\u53d6\u6388\u6743\u4ee4\u724c", "a472f451f5e292dc9ff315f9e5fe9a38": "\u9009\u9879 2\uff1a\u4f7f\u7528 GFW Data API", "e3062b11a090ddc6b00416d2fea20566": "\u4e3e\u62a5\u73af\u5883\u72af\u7f6a\u624b\u518c", "30fb08f061d214df8ef17d92be841bc9": "<strong>\u9ed8\u8ba4</strong>\uff1a<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u201c\u9ed8\u8ba4\u201d\u4e16\u754c\u5730\u5f62\u56fe</a>\u662f Mapbox\u3001OpenStreetMap\u3001USGS\u3001Landsat\u3001Natural Earth \u548c Open Addresses \u56fe\u50cf\u7684\u7ec4\u5408\u3002\u9996\u6b21\u8bbf\u95ee\u5730\u56fe\u65f6\u9ed8\u8ba4\u4e3a\u8be5\u5e95\u56fe\u3002", "511d3cb3a1b4c06f2ce6f369b09141be": "<strong>Landsat</strong>\uff1a<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u201cLandsat\u201d\u5e95\u56fe</a>\u63d0\u4f9b\u4e86\u9ad8\u5206\u8fa8\u7387\u7684\u5386\u53f2\u56fe\u50cf\uff0c\u53ef\u63d0\u4f9b2013\u20132017 \u5e74\u7684\u56fe\u50cf\u3002Landsat \u63d0\u4f9b\u7684\u8fd9\u4e9b\u5386\u53f2\u56fe\u50cf\u6709\u52a9\u4e8e\u68c0\u67e5\u6709\u5173\u533a\u57df\u968f\u65f6\u95f4\u53d8\u5316\u7684\u8be6\u7ec6\u4fe1\u606f\u3002\u60a8\u53ef\u4ee5\u70b9\u51fb Landsat \u56fe\u6807\u4e0b\u65b9\u7684\u4e0b\u62c9\u83dc\u5355\uff0c\u9009\u62e9\u7279\u5b9a\u5e74\u4efd\u7684\u56fe\u50cf\u3002\u6fc0\u6d3b\u6b64\u5e95\u56fe\u65f6\uff0c\u9ed8\u8ba4\u5e74\u4efd\u4e3a 2017 \u5e74\u3002", "d5d0798b25f15eaa263caff78eacf85a": "\u70b9\u51fb\u53f3\u4e0a\u89d2\u7684\u201cMyGFW\u201d\uff0c\u8bbf\u95ee My GFW \u7f51\u9875\u3002", "24d6f51a4d688afa3561060a9c00a5d0": "MyGFW \u63d0\u4f9b\u4e86\u60a8\u7684\u611f\u5174\u8da3\u533a\u66f4\u4e3a\u8be6\u7ec6\u7684\u5217\u8868\u3002", "f18f9e7cecf805fc72f24f7d3d1c5dcb": "\u60a8\u53ef\u4ee5\u5728\u6b64\u67e5\u770b\u81ea\u5b9a\u4e49\u533a\u57df\u7684\u68ee\u6797\u7edf\u8ba1\u6570\u636e\u56fe\u8868\u3002\u767b\u5f55 MyGFW \u8d26\u6237\u5e76\u8bbf\u95ee\u64cd\u4f5c\u9762\u677f\u65f6\uff0c\u9875\u9762\u5de6\u4e0a\u89d2\u5c06\u663e\u793a\u7eff\u8272\u6587\u672c\u3002", "ba071124512f2be72f993eb587805e98": "\u60a8\u5c06\u88ab\u5b9a\u5411\u81f3 MyGFW \u7f51\u9875\uff0c\u60a8\u53ef\u4ee5\u5728\u6b64\u8bbf\u95ee\u6709\u5173\u611f\u5174\u8da3\u533a\u7684\u66f4\u591a\u8be6\u7ec6\u4fe1\u606f\u3002", "efa5da7f0f6136ee563c67dba1902c27": "\u9009\u9879 1\uff1a\u4ece GFW \u7f51\u7ad9\u4e0a", "9e103a4265f62e9934beb405bc8be756": "\u63a2\u7d22 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u683c\u9c81\u5409\u4e9a\u68ee\u6797\u548c\u571f\u5730\u5229\u7528\u5730\u56fe\u96c6</a>\u3002", "8f22f49674ad3b4d412169a72082260a": "\u89c2\u770b<a href=\"{{0}}\">\u672c\u6b21\u7f51\u7edc\u7814\u8ba8\u4f1a</a>\uff0c\u4e86\u89e3\u5982\u4f55\u4f7f\u7528\u514d\u8d39\u516c\u5171 ArcGIS Online \u8d26\u6237\u521b\u5efa MapBuilder\u3002", "6022e34688b9ef0c88acd91f9df5c6ed": "\u8bbf\u95ee\u672c\u6b21\u7f51\u7edc\u7814\u8ba8\u4f1a\u4e0a\u4f7f\u7528\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u521a\u679c\u5171\u548c\u56fd\u6849\u6811\u79cd\u690d\u6570\u636e</a>\u3002", "b60f3a394b46389d6762394ea0aabedc": "\u63a2\u7d22\u5206\u6b65\u64cd\u4f5c\u8bf4\u660e\uff0c\u4e86\u89e3\u5982\u4f55\u4f7f\u7528 GFW Data API \u8bbf\u95ee GFW \u6570\u636e\u96c6\u53ca\u5176\u5143\u6570\u636e\u3001\u5206\u6790\u548c\u67e5\u8be2\u3002", "7ab2f690cac9c004569f21944fe2ccee": "<strong>\u5728\u5916\u90e8\u7f51\u7ad9\u5d4c\u5165 MapBuilder \u5e94\u7528\u7a0b\u5e8f</strong>\uff1a\u4f7f\u7528 iframe\uff0c\u5c06\u60a8\u7684\u5730\u56fe\u89c6\u56fe\u5d4c\u5165\u5916\u90e8\u7f51\u7ad9\u3002\u4e0b\u65b9\u793a\u4f8b\u5c55\u793a\u4e86\u5982\u4f55\u5728\u7f51\u7ad9\u5d4c\u5165 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u3002\u5728\u4e0b\u65b9\u4ee3\u7801\u4e2d\u66f4\u6539\u8d44\u6e90 URL\uff0c\u4f7f\u5176\u5339\u914d\u60a8\u60f3\u8981\u5206\u4eab\u7684 MapBuilder \u5e94\u7528\u7a0b\u5e8f\u7684 URL \u5373\u53ef\u3002", "489186972ca302007bd3a33d9c2f3346": "\u8bbf\u95ee\u672c\u6b21\u7f51\u7edc\u7814\u8ba8\u4f1a\u4e0a\u4f7f\u7528\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u521a\u679c\u5171\u548c\u56fd\u91c7\u77ff\u8bb8\u53ef\u6570\u636e</a>\u3002", "d0a38e37724e67dd817ee9b8891b4c93": "\u4ece MyGFW \u7ba1\u7406\u5df2\u4fdd\u5b58\u533a\u57df", "09eb22ffcfd8b5b66fded7b6fbb8d144": "GFW \u57f9\u8bad\u5c0f\u8d34\u58eb", "d033c6db7505cade942395611f36805d": "MapBuilder \u516c\u5171 ArcGIS Online \u8d26\u6237\u6559\u7a0b", "304f87c757f7ce293083152fc61501a5": "\u9996\u5148\uff0c\u60a8\u9700\u8981\u62e5\u6709 MyGFW \u8d26\u6237\u4ee5\u83b7\u53d6\u6388\u6743\u4ee4\u724c\uff0c\u8fd9\u662f\u521b\u5efa API \u5bc6\u94a5\u6240\u5fc5\u9700\u7684\u3002\u60a8\u53ef\u4ee5\u901a\u8fc7\u4e24\u79cd\u65b9\u5f0f\u6ce8\u518c MyGFW \u8d26\u6237\uff1a", "574cd8ee7bdd73cd5be439c2f71b01e0": "\u767b\u5f55 MyGFW\uff0c\u8bbf\u95ee\u5df2\u4fdd\u5b58\u81f3\u60a8\u8d26\u6237\u7684\u533a\u57df\u3002", "c02c6e7cd7b55c7633e136b9e5e0bd8f": "GFW \u65b0\u95fb\u5de5\u4f5c\u8005\u7528\u6237\u6307\u5357", "4833301e883aea601e834dc579ca00c1": "\u8bf7\u53c2\u9605\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\u7684<a href=\"{{0}}\">\u5206\u6b65\u64cd\u4f5c\u6307\u5357</a>\u3002", "00f7f2c354c4ac860b7e26cc1245156f": "\u6b64\u7f51\u7edc\u7814\u8ba8\u4f1a\u6f14\u793a\u4e86\u5982\u4f55\u4f7f\u7528 ArcGIS Online \u516c\u5171\u8d26\u6237\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\uff0c\u9002\u7528\u4e8e\u6240\u6709\u6280\u672f\u6c34\u5e73\u3002\u7f51\u7edc\u7814\u8ba8\u4f1a\u4e0a\u5f15\u7528\u7684\u94fe\u63a5\u5747\u53ef\u5728\u4e0b\u65b9\u627e\u5230\u3002", "d3148825394b000a481afec19f3c0c86": "\u8bbf\u95ee\u672c\u6b21\u7f51\u7edc\u7814\u8ba8\u4f1a\u4e0a\u4f7f\u7528\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5df4\u897f\u751f\u7269\u7fa4\u843d\u91c7\u6837\u6570\u636e</a>\u3002", "fc57dabcb46813becd4a23f3ee30eabc": "\u514d\u8d39\u7684 ArcGIS Online \u516c\u5171\u8d26\u6237\u53ef\u4e0e MapBuilder \u914d\u5408\u4f7f\u7528\uff0c\u4ee5\u521b\u5efa\u548c\u7ba1\u7406\u975e\u5546\u4e1a\u4f7f\u7528\u7684\u5730\u56fe\u3001\u5e94\u7528\u548c\u6587\u4ef6\u3002\u6b64\u7cfb\u7edf\u8fd8\u63d0\u4f9b\u4e86\u81ea\u5b9a\u4e49\u6570\u636e\u96c6\u6210\u3001\u7edf\u8ba1\u548c\u5730\u7406\u7a7a\u95f4\u5206\u6790\u5de5\u5177\u3001\u4ee5\u53ca\u5206\u4eab\u529f\u80fd\u3002", "0e0677cb55cc816b336bae3fed7baa58": "\u6f14\u793a\u4e2d\u5f15\u7528\u7684\u94fe\u63a5\u5747\u53ef\u5728\u4e0b\u65b9\u627e\u5230\u3002", "a5b88601d2986fe4d425603ae003c1c1": "\u6d4f\u89c8\u8be5\u6f14\u793a\u7684<a rel=\"noreferrer noopener\" href=\"{{0}}\" target=\"_blank\">\u6587\u5b57\u7248\u672c</a>\u3002", "936c8ea40a1c330a3e8ff3af8049c362": "\u8981\u4f7f\u7528\u7b2c\u4e09\u65b9\u5e94\u7528\u7a0b\u5e8f\uff08\u5982\uff0c\u811a\u672c\u6216\u7f51\u7ad9\uff09\u5411  GFW Data API \u53d1\u8d77\u5927\u591a\u6570\u8bf7\u6c42\uff0c\u60a8\u9700\u8981\u4f7f\u7528 API \u5bc6\u94a5\u3002API \u5bc6\u94a5\u5141\u8bb8 GFW \u786e\u8ba4\u54ea\u4e9b\u5e94\u7528\u7a0b\u5e8f\u6b63\u5728\u4f7f\u7528 API\uff0c\u4ee5\u4fbf\u6211\u4eec\u5728\u7a81\u53d1\u53d8\u5316\u65f6\u901a\u77e5\u5b83\u4eec\uff1b\u4e5f\u80fd\u8ba9 GFW \u51cf\u5c11\u4e0d\u5f53\u4f7f\u7528\u7684\u51e0\u7387\uff0c\u9632\u6b62\u4e0d\u5f53\u4f7f\u7528\u5bf9\u4ed6\u4eba\u7684\u670d\u52a1\u9020\u6210\u5e72\u6270\u3002", "98ba6aa0daea680cea96caad37ca8e29": "\u6b64\u6559\u7a0b\u5c06\u901a\u8fc7\u4ee5\u4e0b\u6b65\u9aa4\uff0c\u5e26\u60a8\u4e86\u89e3\u5982\u4f55\u83b7\u53d6\u548c\u4f7f\u7528 API \u5bc6\u94a5\uff1a", "3c0d0d8dd5e691d3da9c5d2fc9eed214": "\u521b\u5efa MyGFW \u8d26\u6237", "a3ceca0e431df5a378338e33f2f5c1bb": "\u521b\u5efa API \u5bc6\u94a5", "e635363e6ee9204894e385174501b4fc": "\u5728\u64cd\u4f5c\u9762\u677f\u4e0a\u6d4f\u89c8\u81ea\u5b9a\u4e49\u533a\u57df\u7684\u68ee\u6797\u7edf\u8ba1\u8d44\u6599", "47b637a3f21ffde161927736331ea729": "<strong>Geostore</strong>\uff1a\u50a8\u5b58\u5355\u4e2a\u51e0\u4f55\uff0c\u4ee5\u4f9b\u540e\u7eed\u4e0e API \u4e2d\u7684\u5176\u4ed6\u670d\u52a1\u4e00\u8d77\u4f7f\u7528", "389c64321284d8ab9d591e21e6128f12": "<strong>\u8bbf\u95ee\u5df2\u4fdd\u5b58\u533a\u57df</strong>\u3002\u8bbf\u95ee\u5df2\u4fdd\u5b58\u81f3 MyGFW \u8d26\u6237\u7684\u533a\u57df\u5e76\u5b9e\u73b0\u53ef\u89c6\u5316\u3002\u5c06\u989d\u5916\u5730\u70b9\u4fdd\u5b58\u81f3\u8d26\u6237\u65f6\uff0c\u5b83\u4eec\u4e5f\u4f1a\u5728 MyGFW \u7c7b\u522b\u4e2d\u663e\u793a\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u4e86\u89e3\u5173\u4e8e\u7ba1\u7406\u5df2\u4fdd\u5b58\u533a\u57df\u7684\u66f4\u591a\u5185\u5bb9\u3002", "748ef5fdbc0e6e6e85c41ee03b1a5e79": "\u767b\u5f55\u5e76\u70b9\u51fb\u201c\u5728 MyGFW \u4e2d\u4fdd\u5b58\u201d\u540e\uff0c\u60a8\u5c31\u53ef\u4ee5\u4fdd\u5b58\u533a\u57df\u4e86\u3002\u5730\u56fe\u4e0a\u5c06\u663e\u793a\u201c\u4fdd\u5b58\u60a8\u7684\u611f\u5174\u8da3\u533a\u201d\u8868\u5355\uff0c\u542b\u6709\u6570\u4e2a\u81ea\u5b9a\u4e49\u9009\u9879\uff0c\u53ef\u7528\u4e8e\u5206\u7c7b\u548c\u5b9a\u5236\u60a8\u7684\u533a\u57df\uff1a\u4e3a\u533a\u57df\u547d\u540d\uff0c\u5206\u914d\u6807\u7b7e\u4ee5\u5e2e\u52a9\u60a8\u6574\u7406\u548c\u7ba1\u7406\u5df2\u4fdd\u5b58\u533a\u57df\uff0c\u6dfb\u52a0\u7535\u5b50\u90ae\u7bb1\u5730\u5740\u4ee5\u63a5\u6536\u901a\u77e5\uff0c\u521b\u5efa webhook URL \u4ee5\u5141\u8bb8 GFW \u5411\u5176\u4ed6\u5e94\u7528\u7a0b\u5e8f\u53d1\u9001\u5b9e\u65f6\u6570\u636e\uff0c\u4ee5\u53ca\u4ece GFW \u517c\u5bb9\u7684 6 \u79cd\u8bed\u8a00\u4e2d\u9009\u62e9 1 \u79cd\u3002", "9d1a85f1420ebb77e99d7b0c60b9b876": "<a rel=\"noreferrer noopener\" href=\"{{0}}\" target=\"_blank\">\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240</a>\u9a7b\u5580\u9ea6\u9686\u529e\u4e8b\u5904\u4e8e 2020 \u5e74 9 \u6708\u521b\u5efa\u4e86\u5229\u6bd4\u91cc\u4e9a\u68ee\u6797\u548c GLAD \u8b66\u62a5\u624b\u518c\uff0c\u4e3a\u5229\u6bd4\u91cc\u4e9a\u68ee\u6797\u76d1\u6d4b\u65b9\u9762\u7684\u6280\u672f\u57f9\u8bad\u63d0\u4f9b\u652f\u6301\u3002\u6b64\u9879\u76ee\u7531<a rel=\"noreferrer noopener\" href=\"{{1}}\" target=\"_blank\">\u7f8e\u56fd\u56fd\u5bb6\u68ee\u6797\u5c40</a>\u8d44\u52a9\uff0c\u6709\u82f1\u6587\u7248\u672c\u53ef\u7528\u3002", "a4f7ce81b3eb6c61f4ce09b95f05bcb1": "\u5728 Forest Watcher \u79fb\u52a8\u5e94\u7528\u4e0a\u76d1\u6d4b\u611f\u5174\u8da3\u533a", "a4b7c8162d3efb4801450df6cfc7dbb4": "MapBuilder \u662f\u4e00\u6b3e\u7b80\u5355\u6613\u7528\u7684\u5de5\u5177\uff0c\u53ef\u7528\u4ee5\u521b\u5efa\u81ea\u5b9a\u4e49\u76d1\u6d4b\u5e94\u7528\u7a0b\u5e8f\uff0c\u5c06 Global Forest Watch \u4e0a\u7684\u7a7a\u95f4\u6570\u636e\u548c\u5206\u6790\u4e0e\u60a8\u7684\u81ea\u6709\u6570\u636e\u76f8\u7ed3\u5408\u3002\u76ee\u524d\uff0c\u5df2\u6709\u6570\u5341\u4e2a\u56fd\u5bb6/\u5730\u533a\u53ca\u7ec4\u7ec7\u4f7f\u7528 MapBuilder \u642d\u5efa\u68ee\u6797\u548c\u571f\u5730\u5229\u7528\u76d1\u6d4b\u5e73\u53f0\u3002", "8b1e464c89333311e2ec8fe9e4712a3e": "\u63a2\u7d22 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">LandMark</a>\uff0c\u4e00\u4e2a\u4ea4\u4e92\u5f0f\u5168\u7403\u5e73\u53f0\uff0c\u63d0\u4f9b\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730\u6743\u5229\u7684\u76f8\u5173\u4fe1\u606f\u3002", "23cbae9e3c3429a6c25743ea25e59ffc": "\u8981\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\uff0c\u60a8\u9700\u8981\u5148\u521b\u5efa\u4e00\u4e2a Web \u5730\u56fe\u3002Web \u5730\u56fe\u662f\u4ee5\u56fe\u5c42\u5f62\u5f0f\u6574\u7406\u7684\u5730\u7406\u4fe1\u606f\u7684\u4ea4\u4e92\u663e\u793a\u3002", "66550ded466689d64351a1f622ce2a1c": "\u4e86\u89e3\u5982\u4f55\u5c06\u5f62\u72b6\u6587\u4ef6 (shapfile) \u4f5c\u4e3a\u8981\u7d20\u670d\u52a1\u53d1\u5e03\u5230 ArcGIS Online \u4e0a\uff0c\u4ee5\u4fbf\u5c06\u5176\u4f5c\u4e3a\u6570\u636e\u56fe\u5c42\u6dfb\u52a0\u81f3\u60a8\u7684 Web \u5730\u56fe\u3002", "9bd2824cd90b03dd0e64af1a09973225": "\u5728 ArcGIS Online \u4e0a\u521b\u5efa Web \u5730\u56fe\u540e\uff0c\u5c31\u80fd\u5c06 MapBuilder \u6a21\u677f\u914d\u7f6e\u5230 Web \u5730\u56fe\u3002", "cac4fd226c89b80250d89a8eaf1ac8cd": "\u4e86\u89e3\u5982\u4f55\u8bbe\u7f6e MyGFW \u8d26\u6237\u5e76\u5f00\u59cb\u7ba1\u7406\u60a8\u7684\u8ba2\u9605\u3002", "1ff2fc202fbb63cc7e68bb7403a30bd3": "<strong>\u8bbf\u95ee\u81ea\u5b9a\u4e49\u533a\u57df\u548c\u64cd\u4f5c\u9762\u677f</strong>\u3002\u8bbf\u95ee\u5df2\u4fdd\u5b58\u81f3 MyGFW \u8d26\u6237\u533a\u57df\u7684\u64cd\u4f5c\u9762\u677f\uff0c\u5e76\u67e5\u770b\u68ee\u6797\u7edf\u8ba1\u8d44\u6599\u3002\u60a8\u53ef\u4ee5\u751f\u6210\u552f\u4e00\u94fe\u63a5\u4ee5\u5206\u4eab\u611f\u5174\u8da3\u533a\u64cd\u4f5c\u9762\u677f\uff0c\u4e5f\u53ef\u4ee5\u7f16\u8f91\u4e0e\u6240\u9009\u5173\u8054\u7684\u4fe1\u606f\u3002<a href=\"{{0}}\">\u5728\u6b64</a>\u4e86\u89e3\u6709\u5173\u67e5\u770b\u68ee\u6797\u7edf\u8ba1\u8d44\u6599\u7684\u66f4\u591a\u5185\u5bb9\u3002", "619ada370be18f802f9d18f3b51ee873": "\u201c\u611f\u5174\u8da3\u533a\u201d\u6570\u636e\u56fe\u5c42\u662f\u6307\u7528\u6237\u5b9a\u4e49\u7684\u3001\u52fe\u52d2\u51fa\u6e05\u6670\u8fb9\u754c\u7684\u533a\u57df\u548c\u6570\u636e\u56fe\u5c42\u2014\u2014\u8bb8\u591a\u6b64\u7c7b\u6570\u636e\u56fe\u5c42\u5747\u53ef\u5728\u201c\u571f\u5730\u8986\u76d6\u201d\u548c\u201c\u571f\u5730\u5229\u7528\u201d\u7c7b\u522b\u4e2d\u627e\u5230\uff0c\u4e14\u4e3b\u8981\u4e3a\u77e2\u91cf\u6570\u636e\u3002", "925bb35ddd2b6d73b1d2cbc900098dd9": "<strong>Google Satellite</strong>\uff1a<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u201c\u536b\u661f\u201d\u5e95\u56fe</a>\u6765\u81ea Google \u536b\u661f\u56fe\u50cf\u3002\u8be5\u5e95\u56fe\u5305\u542b\u6765\u81ea Google \u7684\u5730\u7406\u540d\u79f0\u548c\u6807\u8bb0\uff0c\u6709\u52a9\u4e8e\u63d0\u4f9b\u6709\u5173\u533a\u57df\u7684\u4e0a\u4e0b\u6587\u4fe1\u606f\u3002\u8be5\u56fe\u50cf\u662f\u7531\u4e0d\u540c\u65f6\u6bb5\u7684\u536b\u661f\u56fe\u50cf\u9576\u5d4c\u800c\u6765\uff0c\u56e0\u6b64\u4e0d\u9002\u7528\u4e8e\u51c6\u5b9e\u65f6\u7684\u8c03\u67e5\u8b66\u62a5\uff0c\u4f46\u6709\u52a9\u4e8e\u60a8\u6216\u4ed6\u4eba\u5728\u5730\u56fe\u4e0a\u786e\u5b9a\u65b9\u4f4d\u3002", "9fbaffc802e210842056e109123f93c4": "\u9664\u4e86\u60a8\u5728\u5730\u56fe\u4e0a\u521b\u5efa\u6216\u4e0a\u4f20\u7684\u81ea\u5b9a\u4e49\u5f62\u72b6\u5916\uff0c\u60a8\u8fd8\u53ef\u4ee5\u5728\u56fd\u5bb6\u7ea7\u522b\u6216\u5730\u533a\u7ea7\u522b\u5730\u56fe\u4fdd\u5b58\u533a\u57df\u3002\u8bf7\u6ce8\u610f\uff0c\u8981\u4fdd\u5b58\u548c\u8ba2\u9605\u5730\u56fe\u4e0a\u7684\u4efb\u610f\u533a\u57df\uff0c\u60a8\u9700\u8981\u521b\u5efa MyGFW \u8d26\u6237\u3002", "58d70f3b548923f58552641763cda932": "\u65e0\u8bba\u60a8\u9009\u62e9\u54ea\u79cd\u7c7b\u578b\u7684\u533a\u57df\uff0c\u90fd\u4f1a\u51fa\u73b0\u4e00\u4e2a\u5f39\u51fa\u7a97\u53e3\uff0c\u663e\u793a\u5206\u6790\u6b64\u533a\u57df\u7684\u9009\u9879\u3002\u70b9\u51fb\u201c\u5206\u6790\u201d\uff0c\u5206\u6790\u4f1a\u81ea\u52a8\u8fd0\u884c\uff0c\u5e76\u5728\u56fe\u4f8b/\u5206\u6790\u9762\u677f\u4e0a\u751f\u6210\u6570\u636e\u56fe\u8868\u3002\u56fe\u4f8b/\u5206\u6790\u9762\u677f\u5e95\u90e8\u4f1a\u663e\u793a\u8bbf\u95ee\u201c\u64cd\u4f5c\u9762\u677f\u201d\u548c\u201c\u5728 MyGFW \u4e2d\u4fdd\u5b58\u201d\u7684\u9009\u9879\u3002\u70b9\u51fb\u201c\u5728 MyGFW \u4e2d\u4fdd\u5b58\u201d\u6765\u4fdd\u5b58\u6b64\u533a\u57df\u3002", "d1af8ad50f91c4ab98ccc0d864f3c406": "\u5982\u679c\u60a8\u5c1a\u672a\u767b\u5f55\uff0c\u6216\u5c1a\u672a\u521b\u5efa MyGFW \u8d26\u6237\uff0c\u7cfb\u7edf\u5c06\u63d0\u793a\u60a8\u767b\u5f55\u6216\u521b\u5efa\u8d26\u6237\u3002\u60a8\u53ef\u4ee5\u4f7f\u7528 Twitter\u3001Facebook \u6216 Google \u8d26\u6237\u8f7b\u677e\u521b\u5efa\u8d26\u6237\uff0c\u4e5f\u53ef\u4ee5\u70b9\u51fb\u5f39\u51fa\u7a97\u53e3\u5e95\u90e8\u7684\u201c\u6ce8\u518c\u201d\uff0c\u4f7f\u7528\u4efb\u610f\u6709\u6548\u7535\u5b50\u90ae\u7bb1\u5730\u5740\u6ce8\u518c\u3002\u6ce8\u518c\u540e\uff0c\u60a8\u5c06\u6536\u5230\u4e00\u5c01\u7535\u5b50\u90ae\u4ef6\uff0c\u4ee5\u5b8c\u6210\u60a8\u7684\u8d26\u6237\u8bbe\u7f6e\u3002", "424d9f84686d25dfd09fc17da38cf2c3": "\u70b9\u51fb\u201c\u5728 MyGFW \u4e2d\u4fdd\u5b58\u201d\uff0c\u5c06\u6b64\u533a\u57df\u4fdd\u5b58\u81f3\u60a8\u7684 MyGFW \u8d26\u6237\u3002", "7510e61763526b91d6e6e76370c98866": "\u5982\u679c\u60a8\u6b63\u5728\u521b\u5efa\u8d26\u6237\uff0c\u90a3\u4e48\uff0c\u5c06\u67d0\u4e00\u533a\u57df\u4fdd\u5b58\u81f3 MyGFW \u8d26\u6237\u524d\uff0c\u60a8\u9700\u8981\u5148\u586b\u5199\u4e2a\u4eba\u8d44\u6599\u4fe1\u606f\u3002\u60a8\u7684\u4e2a\u4eba\u8d44\u6599\u4fe1\u606f\u80fd\u8ba9 GFW \u66f4\u597d\u5730\u4e3a\u60a8\u63d0\u4f9b\u5e2e\u52a9\u3002\u672a\u53d6\u5f97\u60a8\u540c\u610f\u7684\u60c5\u51b5\u4e0b\uff0c\u6211\u4eec\u51b3\u4e0d\u4f1a\u5206\u4eab\u60a8\u7684\u4e2a\u4eba\u8d44\u6599\u4fe1\u606f\u3002\u60a8\u9700\u8981\u586b\u5199\u7684\u4fe1\u606f\u6709\uff1a\u60a8\u7684\u59d3\u540d\uff0c\u7535\u5b50\u90ae\u7bb1\u5730\u5740\uff0c\u884c\u4e1a\uff0c\u804c\u4f4d\uff0c\u7ec4\u7ec7\u540d\u79f0\uff0c\u4f4d\u7f6e\uff0c\u5174\u8da3\u548c\u5176\u4ed6\u76f8\u5173\u5b57\u6bb5\u3002\u5b8c\u6210\u540e\uff0c\u8bf7\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\uff0c\u7136\u540e\u60a8\u5c31\u80fd\u5c06\u533a\u57df\u4fdd\u5b58\u81f3\u60a8\u7684 MyGFW \u8d26\u6237\u4e86\u3002", "a8fc6ffd2b03465ce31ded9cabc17acd": "\u70b9\u51fb\u201cMyGFW\u201d\u67e5\u770b\u60a8\u5df2\u4fdd\u5b58\u7684\u533a\u57df\u3002", "3ec6bf49e24dac831c1c72fd979811bd": "\u5c06 MapBuilder \u6a21\u677f\u6ce8\u518c\u5230 ArcGIS Online \u7ec4\u7ec7\u8d26\u6237", "ec0a44b82afbd8b21592d1f77f93a596": "\u5c06\u6570\u636e\u6dfb\u52a0\u5230 ArcGIS Online \u7ec4\u7ec7\u8d26\u6237", "0a8373cc172a209a7c601f024a8e397a": "\u5982\u679c\u60a8\u62e5\u6709 GIS \u670d\u52a1\u5668\uff0c\u5219\u53ef\u4ee5\u7528\u60a8\u7684 ArcGIS Online \u8d26\u6237\u6ce8\u518c\u670d\u52a1\u3002\u6ce8\u518c\u670d\u52a1\u4f1a\u5c06\u5b83\u4eec\u4f5c\u4e3a\u9879\u76ee\u6dfb\u52a0\u5230\u60a8\u7684\u8d26\u6237\u4e2d\u3002", "2d06fa6208be27d909548c2d2feb2c5e": "MapBuilder \u63d0\u4f9b\u4e86\u51e0\u79cd\u81ea\u5b9a\u4e49\u5e94\u7528\u7a0b\u5e8f\u7684\u65b9\u6cd5\u3002\u6b64\u4fe1\u606f\u80fd\u8ba9\u60a8\u901a\u8fc7\u66f4\u6539\u4ee3\u7801\u4e2d\u7684\u7279\u5b9a\u5c5e\u6027\u81ea\u5b9a\u4e49\u5e94\u7528\u7a0b\u5e8f\u3002", "4e5d637d201819ec015852be5245c3e2": "\u5982\u679c\u60a8\u53ef\u4ee5\u8bbf\u95ee ArcGIS Online \u7ec4\u7ec7\u8d26\u6237\uff0c\u5219\u53ef\u4ee5\u6ce8\u518c MapBuilder \u6a21\u677f\u5e76\u5c06\u5176\u7528\u4f5c\u53ef\u914d\u7f6e\u7684\u5236\u56fe\u5e94\u7528\u7a0b\u5e8f\u3002", "d7d195df0a01b219bc94a213c60b8821": "\u5728 ArcGIS Online \u4e0a\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f", "480ed984d3ec48dd1e347e897d4ce92e": "<strong>\u5171\u4eab\u64cd\u4f5c\u9762\u677f\u548c\u4e0b\u8f7d\u6570\u636e</strong>\u3002\u70b9\u51fb\u53f3\u4e0a\u89d2\u7684\u5206\u4eab\u56fe\u6807\u751f\u6210\u552f\u4e00\u94fe\u63a5\uff0c\u6293\u53d6\u60a8\u7684\u64cd\u4f5c\u9762\u677f\u5e76\u5206\u4eab\u7ed9\u4ed6\u4eba\u3002\u60a8\u4e5f\u53ef\u4ee5\u70b9\u51fb\u53f3\u4e0a\u89d2\u7684\u4e0b\u8f7d\u56fe\u6807\uff0c\u4e0b\u8f7d\u6574\u4e2a\u64cd\u4f5c\u9762\u677f\u7684\u6570\u636e\u3002\u5728\u56fd\u5bb6/\u5730\u533a\u64cd\u4f5c\u9762\u677f\u6216\u884c\u653f\u533a\u64cd\u4f5c\u9762\u677f\u4e0a\uff0c\u60a8\u4e5f\u53ef\u4ee5\u5c06\u533a\u57df\u4fdd\u5b58\u81f3 MyGFW \u8d26\u6237\u3002", "a015525f82161c2634ab72a7c745d428": "<strong>Dark Matter</strong>\uff1a<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u201cDark Matter\u201d\u5e95\u56fe</a>\u7531 Carto \u63d0\u4f9b\uff0c\u8be5\u5e95\u56fe\u63d0\u4f9b\u4e86\u4e00\u4e2a\u5e72\u51c0\u7684\u9875\u9762\u4f9b\u60a8\u67e5\u770b\u6570\u636e\u3002\u5b83\u53ef\u4ee5\u7b80\u5316\u5730\u56fe\u89c6\u56fe\uff0c\u5e2e\u52a9\u8bc6\u522b\u5730\u56fe\u4e0a\u7684\u91cd\u8981\u611f\u5174\u8da3\u533a\u3002", "74a18c9239c2956758bc60420eb4b05a": "\u9762\u5411\u516c\u53f8\u3001\u94f6\u884c\u548c\u6240\u6709\u60f3\u76d1\u6d4b\u591a\u5730\u70b9\u68ee\u6797\u7684\u4e2a\u4eba\u3002\u4e86\u89e3\u5982\u4f55\u8bbf\u95ee GFW \u4e13\u4e1a\u7248\u3002", "1c5ba37e00ac915ef94ce25f48108e52": "\u9762\u5411\u90a3\u4e9b\u5e0c\u671b\u5c06\u5730\u533a\u68ee\u6797\u53d8\u5316\u53ef\u89c6\u5316\uff0c\u5e76\u786e\u5b9a\u6b64\u53d8\u5316\u968f\u65f6\u95f4\u6f14\u5316\u8d8b\u52bf\u7684\u4eba\u5458\u3002\u8bbf\u95ee\u6559\u7a0b\uff0c\u5206\u6b65\u64cd\u4f5c\u8bf4\u660e\uff0c\u7f51\u7edc\u7814\u8ba8\u4f1a\u7b49\u3002", "e2d42ab53db247a1b45377c603425fe4": "\u9762\u5411\u5e0c\u671b\u5f00\u53d1\u81ea\u6709\u5728\u7ebf\u5236\u56fe\u548c\u76d1\u6d4b\u7cfb\u7edf\u7684\u4eba\u5458\u3002\u8bbf\u95ee\u6559\u7a0b\uff0c\u5206\u6b65\u64cd\u4f5c\u8bf4\u660e\uff0c\u7f51\u7edc\u7814\u8ba8\u4f1a\u7b49\u3002", "7d720186db0920367b41bbfe360e5b82": "\u4ece\u7f51\u7ad9\u7684\u591a\u4e2a\u4f4d\u7f6e\u8bbf\u95ee\u7a7a\u95f4\u6570\u636e\u56fe\u5c42\u7684\u53ef\u4e0b\u8f7d\u7248\u672c\u53ca\u57fa\u4e8e\u6570\u636e\u7684\u7edf\u8ba1\u8d44\u6599\u3002", "d9586815d147c57aa58562fde3cf6f97": "\u793e\u533a\u8bba\u575b", "fb100262d5ad1b55e496e3f2707a31f0": "\u60a8\u5728\u5730\u56fe\u4e0a\u4fdd\u5b58\u533a\u57df\u540e\uff0cGFW \u4f1a\u751f\u6210\u4e00\u4e2a\u64cd\u4f5c\u9762\u677f\uff0c\u9762\u677f\u4e0a\u5305\u542b\u53ef\u4ea4\u4e92\u3001\u53ef\u5b9a\u5236\u7684\u6570\u636e\u56fe\u8868\uff0c\u4e13\u95e8\u9488\u5bf9\u6b64\u533a\u57df\u7684\u68ee\u6797\u7edf\u8ba1\u8d44\u6599\u8fdb\u884c\u53ef\u89c6\u5316\u3002", "28b5f672d29d2d6f949fe1d6d6dd8637": "\u4e0a\u4f20\u81ea\u5b9a\u4e49\u5e95\u56fe\u548c\u4e0a\u4e0b\u6587\u56fe\u5c42", "46e5e70bc2943df4e0d7ec3d108e392b": "\u8c03\u6574 MapBuilder \u914d\u7f6e\u8bbe\u7f6e", "a6c7b8905dd2415d3d456eebb65ef890": "\u533a\u57df\u3001\u62a5\u544a\u3001\u8def\u5f84\u3001\u5e95\u56fe\u548c\u4e0a\u4e0b\u6587\u56fe\u5c42\u5747\u80fd\u79bb\u7ebf\u5bfc\u51fa\u5e76\u5206\u4eab\u81f3\u5176\u4ed6\u8bbe\u5907\u3002", "6a81a2a317027dc10a12f7a59c98de17": "<strong>\u5207\u7247\u7f13\u5b58</strong>\uff1a\u4ee5 z/y/z \u5207\u7247\u683c\u5f0f\u6293\u53d6\u6805\u683c\u548c/\u6216\u77e2\u91cf\u5207\u7247\u7f13\u5b58\uff0c\u4ee5\u8fdb\u884c\u5730\u56fe\u53ef\u89c6\u5316", "9bd0296d77ab99aa9a81d9e8eb702c9c": "\u9762\u5411\u4e3b\u52a8\u76d1\u6d4b\u548c\u7ba1\u7406\u68ee\u6797\u7684\u4eba\u5458\u3002\u8bbf\u95ee\u6559\u7a0b\uff0c\u5206\u6b65\u64cd\u4f5c\u8bf4\u660e\uff0c\u7f51\u7edc\u7814\u8ba8\u4f1a\u7b49\u3002", "a6884ab04d0ea53615a035c266e1e4a4": "\u4ece GFW \u4e0b\u8f7d\u6570\u636e", "89d194251f032d6ea9535d31e59eed71": "\u4f7f\u7528 MapBuilder \u521b\u5efa\u81ea\u5b9a\u4e49\u5236\u56fe\u5e94\u7528\u7a0b\u5e8f", "6e007ca4b2ae23495693133bc174379e": "MapBuilder \u80fd\u8ba9\u60a8\u5229\u7528 GFW \u7684\u5206\u6790\u5de5\u5177\u521b\u5efa\u5e76\u5b9a\u5236\u68ee\u6797\u76d1\u6d4b\u5e94\u7528\u7a0b\u5e8f\uff0c\u5e76\u5c06\u60a8\u7684\u81ea\u6709\u6570\u636e\u4e0e GFW \u7684\u6838\u5fc3\u6570\u636e\u6574\u5408\u3002", "4a5e905740025dbd225dd37df9f028fc": "\u9009\u62e9\u5e76\u5b9a\u5236\u5e95\u56fe", "ff894cb2c8df9780f0b7822f77c11e5e": "\u4fdd\u5b58\u533a\u57df\u5e76\u8ba2\u9605\uff0c\u63a5\u6536\u68ee\u6797\u53d8\u5316\u901a\u77e5", "85a17a44be0f3fb602db6b2f3e820250": "\u5730\u56fe\u80fd\u8ba9\u60a8\u5bf9\u6570\u5341\u4e2a\u6570\u636e\u56fe\u5c42\u8fdb\u884c\u53ef\u89c6\u5316\u548c\u5206\u6790\u3002\u64cd\u4f5c\u9762\u677f\u4ee5\u4ea4\u4e92\u6570\u636e\u56fe\u8868\u5f62\u5f0f\u63d0\u4f9b\u4e86\u68ee\u6797\u53d8\u5316\u8d8b\u52bf\u7684\u7edf\u8ba1\u8d44\u6599\u3002", "12e1a90585455c72dc041098eae97264": "\u627e\u4e0d\u5230\u60f3\u8981\u7684\u5185\u5bb9\uff1f\u901a\u8fc7\u6211\u4eec\u7684\u8054\u7cfb\u8868\u683c\u8054\u7edc GFW \u56e2\u961f\u3002", "63018852289c4dc1398e60c862f6a3c4": "\u521b\u5efa\u611f\u5174\u8da3\u533a\u5e76\u5728\u5730\u56fe\u4e2d\u4fdd\u5b58\u540e\uff0c\u60a8\u53ef\u901a\u8fc7\u591a\u4e2a\u9009\u9879\u5bf9\u5176\u8fdb\u884c\u7ba1\u7406\u3001\u7f16\u8f91\u548c\u5206\u4eab\u3002", "acc0c5801c9f93b97046be3b7e7f2af7": "\u60a8\u53ef\u4ee5\u4fdd\u5b58\u5730\u56fe\u4e0a\u7684\u4efb\u610f\u611f\u5174\u8da3\u533a\u5e76\u8ba2\u9605\uff0c\u63a5\u6536\u8fd1\u4e4e\u5b9e\u65f6\u7684\u8b66\u62a5\u901a\u77e5\uff0c\u638c\u63e1\u6b64\u533a\u57df\u5185\u68c0\u6d4b\u5230\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u6216\u706b\u707e\u3002", "d6f4a1e4f877cce4100bf5af03f808be": "\u6570\u636e\u5206\u6790\u5de5\u5177\u662f\u4e00\u79cd\u7b80\u5355\u7684\u65b9\u6cd5\uff0c\u53ef\u4ee5\u7528\u6765\u8bc4\u4f30\u5730\u56fe\u4e0a\u67d0\u4e00\u533a\u57df\u7684\u68ee\u6797\u53d8\u5316\u3002\u60a8\u53ef\u4ee5\u5bf9\u56fd\u5bb6/\u5730\u533a\u3001\u884c\u653f\u533a\u533a\u57df\u3001\u4e0a\u4e0b\u6587\u56fe\u5c42\u6216\u81ea\u5b9a\u4e49\u533a\u57df\u7684\u5f62\u72b6\u8fdb\u884c\u5206\u6790\u3002", "e80901b3172c5efbf532a1a66819cb35": "GFW \u63d0\u4f9b\u4e86\u591a\u79cd\u81ea\u5b9a\u4e49\u5730\u56fe\u89c6\u56fe\u548c\u60a8\u67e5\u770b\u7684\u6570\u636e\u7684\u65b9\u6cd5\u3002\u4e86\u89e3\u5982\u4f55\u8c03\u6574\u5730\u56fe\u548c\u6570\u636e\u56fe\u5c42\u8bbe\u7f6e\u3002", "8c103b85faa939ed714fcf97fa4f33f1": "\u4f7f\u7528 Forest Watcher Web \u7ba1\u7406\u68ee\u6797\u76d1\u6d4b\u56e2\u961f", "5d5e6fed6eedab746cca51cd7c7e7ce4": "\u4ed8\u8d39\u7684 ArcGIS Online \u7ec4\u7ec7\u8d26\u6237\u53ef\u4e0e MapBuilder \u914d\u5408\u4f7f\u7528\uff0c\u4ee5\u4f9b\u56e2\u4f53\u3001\u56e2\u961f\u548c\u7ec4\u7ec7\u4e2d\u7684\u7528\u6237\u521b\u5efa\u548c\u7ba1\u7406\u5730\u56fe\u3001\u5e94\u7528\u548c\u6587\u4ef6\u3002\u9664\u4e86\u514d\u8d39\u516c\u5171\u8d26\u6237\u7684\u529f\u80fd\u5916\uff0c\u7ec4\u7ec7\u8d26\u6237\u7684\u7528\u6237\u8fd8\u80fd\u8bbf\u95ee\u66f4\u591a\u9ad8\u7ea7\u7684\u7f51\u9875\u5236\u56fe\u529f\u80fd\uff0c\u79c1\u6709\u6570\u636e\u548c\u5730\u56fe\u5171\u4eab\u529f\u80fd\u3002", "be1876b103e37e22917f2a6997d1ef9b": "MapBuilder \u662f\u4e00\u6b3e\u7b80\u5355\u6613\u7528\u7684\u5de5\u5177\uff0c\u53ef\u7528\u4ee5\u521b\u5efa\u81ea\u5b9a\u4e49\u76d1\u6d4b\u5e94\u7528\u7a0b\u5e8f\uff0c\u5c06 GFW \u4e0a\u7684\u7a7a\u95f4\u6570\u636e\u548c\u5206\u6790\u4e0e\u60a8\u7684\u81ea\u6709\u6570\u636e\u76f8\u7ed3\u5408\u3002\u76ee\u524d\uff0c\u5df2\u6709\u6570\u5341\u4e2a\u56fd\u5bb6/\u5730\u533a\u53ca\u7ec4\u7ec7\u4f7f\u7528 MapBuilder \u642d\u5efa\u68ee\u6797\u548c\u571f\u5730\u5229\u7528\u76d1\u6d4b\u5e73\u53f0\u3002", "c655a43c355459630b94fadccec4a8c9": "MapBuilder \u662f\u4e00\u6b3e\u7b80\u5355\u6613\u7528\u7684\u5de5\u5177\uff0c\u53ef\u7528\u4ee5\u521b\u5efa\u81ea\u5b9a\u4e49\u76d1\u6d4b\u5e94\u7528\u7a0b\u5e8f\uff0c\u5c06 Global Forest Watch \u4e0a\u7684\u7a7a\u95f4\u6570\u636e\u548c\u5206\u6790\u4e0e\u60a8\u7684\u81ea\u6709\u6570\u636e\u76f8\u7ed3\u5408\u3002\u6b64\u6f14\u793a\u5c06\u5f15\u5bfc\u60a8\u4f7f\u7528 ArcGIS Online \u516c\u5171\u8d26\u6237\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\uff0c\u9002\u7528\u4e8e\u6240\u6709\u6280\u672f\u6c34\u5e73\u3002", "168825ad225465caa517e6d2927b1059": "\u8bbf\u95ee <a rel=\"noreferrer noopener\" href=\"{{0}}\" target=\"_blank\">MapBuilder GitHub \u7f51\u9875</a>\uff0c\u67e5\u770b\u6709\u5173\u914d\u7f6e Web \u5730\u56fe\u5e94\u7528\u7a0b\u5e8f\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u5982\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\u65f6<a rel=\"noreferrer noopener\" href=\"{{1}}\" target=\"_blank\">\u9700\u8981\u8f93\u5165\u5230\u201c\u914d\u7f6e\u53c2\u6570\u201d\u7684\u4ee3\u7801</a>\u3002", "cabe36a9540d799941e11335ae68c0ad": "\u60a8\u53ef\u4ee5\u4f7f\u7528 Forest Watcher Web \u7ba1\u7406\u611f\u5174\u8da3\u533a\uff0c\u81ea\u5b9a\u4e49\u62a5\u544a\u6a21\u677f\uff0c\u914d\u7f6e\u7528\u6237\u56e2\u961f\uff0c\u4ee5\u53ca\u67e5\u770b\u548c\u4e0b\u8f7d\u901a\u8fc7\u79fb\u52a8\u5e94\u7528\u63d0\u4ea4\u7684\u62a5\u544a\u3002", "fd8d174c67a87ff40f5af4ca61f1f3ee": "\u6cb9\u68d5\u7279\u8bb8\u533a\u73b0\u5df2\u4fdd\u5b58\u81f3 MyGFW\u3002", "f97b6763ecdad4dccb84bd59f14a89c4": "\u201c\u7814\u7a76\u201d\u6570\u636e\u56fe\u5c42\u662f\u6307\u6807\u793a\u4e86\u5c3a\u5bf8\u6216\u53d8\u5316\u7684\u6570\u636e\u56fe\u5c42\u2014\u2014\u8bb8\u591a\u6b64\u7c7b\u6570\u636e\u5747\u53ef\u5728\u201c\u68ee\u6797\u53d8\u5316\u201d\u7c7b\u522b\u4e2d\u627e\u5230\uff0c\u4e14\u4e3b\u8981\u4e3a\u77e2\u91cf\u6570\u636e\u3002", "3b8ee5aa87a226cde596a4b542cca25f": "\u8981\u4f7f\u7528 MapBuilder\uff0c\u60a8\u9700\u8981\u62e5\u6709 ArcGIS Online \u8d26\u6237\uff0c\u53ef\u4ee5\u662f\u514d\u8d39\u516c\u5171\u8d26\u6237\uff0c\u4e5f\u53ef\u4ee5\u662f\u4ed8\u8d39\u7684\u7ec4\u7ec7\u8d26\u6237\u3002\u6b64\u7f51\u7edc\u7814\u8ba8\u4f1a\u6f14\u793a\u4e86\u5982\u4f55\u4f7f\u7528\u4ed8\u8d39\u7684 ArcGIS Online \u7ec4\u7ec7\u8d26\u6237\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f\uff0c\u9002\u7528\u4e8e\u6240\u6709\u6280\u672f\u6c34\u5e73\u3002\u7f51\u7edc\u7814\u8ba8\u4f1a\u4e0a\u5f15\u7528\u7684\u94fe\u63a5\u5747\u53ef\u5728\u4e0b\u65b9\u627e\u5230\u3002", "8f432764d181dc767879896f8abde993": "\u4f7f\u7528\u4ee5\u4e0b\u4efb\u4e00\u53ef\u7528\u9009\u9879\uff0c\u767b\u5f55 MyGFW \u6216\u521b\u5efa\u8d26\u6237\u3002", "a962d186feb220326be6052d9dc1271a": "\u5728\u56fd\u5bb6/\u5730\u533a\u64cd\u4f5c\u9762\u677f\u6216\u884c\u653f\u533a\u64cd\u4f5c\u9762\u677f\u4e0a\uff0c\u60a8\u53ef\u4ee5\u70b9\u51fb\u53f3\u4e0a\u89d2\u7684\u201c+\u201d\u56fe\u6807\uff0c\u5c06\u533a\u57df\u4fdd\u5b58\u81f3\u60a8\u7684 MyGFW \u8d26\u6237\u3002", "d522b154b55b83e6faa77ebf41545743": "\u68ee\u6797\u706b\u707e\u548c\u6ce5\u70ad\u5730\u706b\u707e\u5f71\u54cd", "9fbe504361a362fca124b0f03b81c66e": "\u89c2\u770b<a href=\"{{0}}\">\u672c\u6b21\u7f51\u7edc\u7814\u8ba8\u4f1a</a>\uff0c\u4e86\u89e3\u5982\u4f55\u4f7f\u7528\u4ed8\u8d39 ArcGIS Online \u7ec4\u7ec7\u8d26\u6237\u521b\u5efa MapBuilder\u3002", "6ecddd6f2bb2847b890ebd98770c1413": "MapBuilder \u514d\u8d39\u516c\u5171 ArcGIS Online \u8d26\u6237\u6559\u7a0b", "6dcba1411859313eddde4465c408ae3c": "MapBuilder ArcGIS Online \u7ec4\u7ec7\u8d26\u6237\u6559\u7a0b", "85e5b120f996cfc483dc0994701a092c": "<strong>\u4e0b\u8f7d</strong>\uff1a\u4e0b\u8f7d\u6570\u636e\u96c6\u6216\u5176\u884d\u751f\u5185\u5bb9", "09df16d2a6cad07875654653d59766df": "\u8981\u76f4\u63a5\u4ece\u5730\u56fe\u4e2d\u7ba1\u7406\u5df2\u4fdd\u5b58\u7684\u611f\u5174\u8da3\u533a\uff0c\u8bf7\u70b9\u51fb\u83dc\u5355\u4e2d\u7684\u201cMyGFW\u201d\u7c7b\u522b\u3002\u8981\u8bbf\u95ee\u5df2\u4fdd\u5b58\u7684\u611f\u5174\u8da3\u533a\uff0c\u60a8\u5fc5\u987b\u767b\u5f55 MyGFW \u8d26\u6237\u3002\u5df2\u4fdd\u5b58\u81f3\u60a8 MyGFW \u8d26\u6237\u7684\u611f\u5174\u8da3\u533a\u5747\u5c06\u5728\u6b64\u663e\u793a\u3002", "efb6a3643b602d7fd079577b21b3c0c2": "\u5e94\u5bf9\u73af\u5883\u72af\u7f6a\u6307\u5bfc\u65b9\u9488", "ac8d275f9ea2d57a86a500fb8c95887b": "Forest Watcher \u5916\u4e1a\u6559\u7a0b", "72aa7f34199f10588816fa950690f836": "\u5728 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">Open Data Portal</a> \u4e0a\u8bbf\u95ee\u5176\u4ed6\u6570\u636e\u3002", "9e07d1de7c3dd87744246022ce84c48b": "\u6ce8\u518c<a rel=\"noreferrer noopener\" href=\"{{0}}\" target=\"_blank\">\u514d\u8d39 ESRI \u516c\u5171\u8d26\u6237</a>\uff0c\u5728 ArcGIS Online \u4e0a\u8bbf\u95ee MapBuilder \u6a21\u677f\u3002", "1c297cb9c05544bbc157a12788238fcf": "\u8bbf\u95ee\u8be5\u6f14\u793a\u4f7f\u7528\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5df4\u897f\u751f\u7269\u7fa4\u843d\u91c7\u6837\u6570\u636e</a>\u3002", "a377f3b3caf6e357a17fc0f188b5ef7a": "\u521b\u5efa\u5e76\u4f7f\u7528 API \u5bc6\u94a5", "cae07a658c1ebcce41e9641bcb78af29": "Forest Watcher \u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u6f14\u793a", "13fee2c3784c9c5adb069653f2651d96": "\u521b\u5efa\u611f\u5174\u8da3\u533a\u5e76\u5728\u5730\u56fe\u4e2d\u4fdd\u5b58\u540e\uff0c\u60a8\u6709\u591a\u79cd\u9009\u9879\u53ef\u5bf9\u5176\u8fdb\u884c\u7ba1\u7406\u3001\u7f16\u8f91\u548c\u5206\u4eab\u3002\u6709\u5173\u5982\u4f55\u4ece\u5730\u56fe\u548c MyGFW \u8d26\u6237\u4e2d\u7ba1\u7406\u5df2\u4fdd\u5b58\u533a\u57df\u7684\u4fe1\u606f\uff0c\u60a8\u53ef\u4ee5\u5728\u4e0b\u65b9\u4e86\u89e3\u66f4\u591a\u3002", "0bbccb92e44ccf4f1f9c07900bd7e67e": "GFW \u548c Forest Watcher \u6307\u5357", "98ad446f682f32248e2f5a5e279da121": "\u79d8\u9c81\u4e9a\u9a6c\u5b59\u96e8\u6797\u9632\u6ee5\u4f10\u8bae\u5b9a\u4e66", "ebf4c79735afad69a067e720bda39a86": "GFW \u53ca Forest Atlas \u4f7f\u7528\u5b9e\u8df5\u8bfe\u7a0b", "1ce4e793c53cf83d8961cb33533068c1": "Forest Watcher \u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u6559\u7a0b", "d07f6a16fe226e78c774df52470c4f1c": "GFW \u7528\u6237\u6307\u5357", "57462d82791cd88afba706f3d67e4f35": "MapBuilder \u6f14\u793a\uff1a\u5728 ArcGIS Online \u4e0a\u514d\u8d39\u521b\u5efa MapBuilder \u5e94\u7528\u7a0b\u5e8f", "4fcff32b6e6be5b7d56ca33c9da1721c": "\u5728\u8bf7\u6c42\u4e2d\u4f7f\u7528 API \u5bc6\u94a5", "aea73137fcb8e8005fb02240bcaa3d0b": "Panduan GFW \u2013 Forest Watcher", "f8b2c73ae10c490d26ff189f6c170b54": "\u4f7f\u7528\u65b0\u6280\u672f\u89e3\u51b3\u73af\u5883\u72af\u7f6a\u624b\u518c", "195fbb57ffe7449796d23466085ce6d8": "5\u6708", "648dbd59b820b881fd1cfe15c3174dd5": "\u6c34\u679c\u6df7\u5408", "9d0013822da31a3dc084fe94963055d3": "\u5168\u7403\u6ce5\u70ad\u5730\u8303\u56f4", "5b031140dbaa43f924612f3e4aa72225": "2010 \u5e74\uff0c\u5b89\u8fbe\u66fc\u548c\u5c3c\u79d1\u5df4\u7fa4\u5c9b\u7684\u5929\u7136\u6797\u9762\u79ef\u4e3a 657kha\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684 89%\u3002{year} \u5e74\uff0c\u5b83\u635f\u5931\u4e86 904ha \u7684\u5929\u7136\u6797\uff0c\u76f8\u5f53\u4e8e 498kt \u7684 CO\u2082 \u6392\u653e\u91cf\u3002 ", "102dc25218d32d56f7ea6f6d0db5f36e": "\u8be5\u8868\u683c\u73b0\u5c06\u663e\u793a\u60a8\u6240\u9009\u5730\u70b9 50 \u516c\u91cc\u8303\u56f4\u5185\u68ee\u6797\u666f\u89c2\u6240\u53d7\u5a01\u80c1\u548c\u68ee\u6797\u666f\u89c2\u6570\u503c\u7684\u98ce\u9669\u7b49\u7ea7\u4fe1\u606f\u3002\u7b2c\u4e00\u5217 \u201cT+V\u201d \u663e\u793a\u53cd\u6620\u5a01\u80c1\u548c\u6570\u503c\u7684\u7efc\u5408\u6027\u98ce\u9669\u6307\u6807\uff0c\u79f0\u4e3a\u603b\u4f53\u69a8\u6cb9\u5382\u4f18\u5148\u7ea7\u3002\u603b\u4f53\u69a8\u6cb9\u5382\u4f18\u5148\u7ea7\u662f\u901a\u8fc7 PALM \u98ce\u9669\u5de5\u5177\u8fd0\u884c\u68d5\u6988\u6cb9\u5382\u98ce\u9669\u5206\u6790\u5f97\u51fa\u7684\u7ed3\u679c\uff0c\u8fd9\u65b9\u9762\u7684\u66f4\u591a\u4fe1\u606f\u53ef\u53c2\u89c1<a href=\"{{0}}\">\u6b64\u5904</a>\u3002\u4e00\u5171\u6709\u4e09\u4e2a\u98ce\u9669\u7b49\u7ea7\uff1a\u4f4e\u3001\u4e2d\u3001\u9ad8\u3002\u60a8\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u5206\u6790\u65c1\u8fb9\u7684\u4fe1\u606f \u201ci\u201d \u56fe\u6807\uff0c\u4e86\u89e3\u66f4\u591a\u5173\u4e8e\u5a01\u80c1\u548c\u6570\u503c\u7684\u4fe1\u606f\u3002\u5982\u679c\u5217\u8868\u662f\u8349\u7a3f\u5f62\u5f0f\uff0c\u5728\u6574\u4e2a\u5217\u8868\u63d0\u4ea4\u5206\u6790\u4e4b\u524d\uff0c\u5217\u8868\u4e2d\u7684\u672a\u5206\u6790\u5730\u70b9\u5c06\u4e0d\u4f1a\u5305\u62ec\u6240\u6709\u4fe1\u606f\u3002", "062ca44932d57edc0288e52263a72608": "\u8fd9\u662f\u4e00\u5f20\u5206\u8fa8\u7387\u7ea6\u4e3a 30m \u7684\u5730\u4e0a\u751f\u7269\u91cf (AGB) \u5168\u7403\u8303\u56f4\u8fde\u7eed\u5730\u56fe\u3002\u6b64\u6570\u636e\u4ea7\u54c1\u62d3\u5c55\u4e86 Baccini et al. (2012) \u63d0\u51fa\u7684\u65b9\u6cd5\uff0c\u4ee5 0.00025 \u5ea6\uff08\u7ea6 30m\uff09\u7684\u5206\u8fa8\u7387\u751f\u6210 2000 \u5e74\u5168\u7403\u5730\u4e0a\u6d3b\u4f53\u6728\u8d28\u751f\u7269\u91cf (AGB) \u5bc6\u5ea6\u5730\u56fe\uff08\u767e\u4e07\u514b\u751f\u7269\u91cf/ha\uff09\u3002\u5730\u9762\u751f\u7269\u91cf\u7684\u4f30\u7b97\u91c7\u7528\u4e86\u4e00\u4e2a\u591a\u6b65\u9aa4\u8fc7\u7a0b\uff0c\u8be5\u8fc7\u7a0b\u4f7f\u7528 LiDAR \u548c\u533a\u57df\u5f02\u901f\u751f\u957f\u65b9\u7a0b\u8ba1\u7b97\u8d85\u8fc7 70 \u4e07\u70b9\u7684 AGB\uff0c\u7136\u540e\u7528\u8fd9\u4e9b\u6570\u636e\u6765\u8bad\u7ec3\u4e00\u4e2a\u57fa\u4e8e Landsat \u56fe\u50cf\u7684\u8fde\u7eed\u6a21\u578b\u3002\u65e0\u6811\u51a0\u7684\u50cf\u7d20\u7684\u751f\u7269\u91cf\u5bc6\u5ea6\u88ab\u5206\u914d\u4e3a 0 Mg/ha\u3002\u6709\u5173\u521b\u5efa\u8be5\u5730\u56fe\u7684\u5176\u4ed6\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605 Harris et al. 2021\u3002", "61ca4278e8a289fb1f47b3ba92100d3d": "\u60a8\u53ef\u4ee5\u9009\u62e9\u70b9\u51fb\u201c\u4fdd\u5b58\u4e3a\u8349\u7a3f\u201d\uff0c\u5c06\u60a8\u7684\u5730\u70b9\u6dfb\u52a0\u5230\u5217\u8868\u4e2d\uff0c\u5e76\u4fdd\u5b58\u8be5\u5217\u8868\u4ee5\u4fbf\u5c06\u6765\u5206\u6790\uff0c\u6216\u8005\u9009\u62e9\u70b9\u51fb\u201c\u63d0\u4ea4\u201d\uff0c\u5c06\u60a8\u7684\u5730\u70b9\u6dfb\u52a0\u5230\u5217\u8868\u4e2d\u5e76\u5bf9\u5217\u8868\u8fdb\u884c\u5206\u6790\u3002\u4ee5\u8349\u7a3f\u5f62\u5f0f\u4fdd\u5b58\u7684\u5217\u8868\uff0c\u53ef\u4ee5\u91cd\u65b0\u5ba1\u89c6\u5e76\u5bf9\u5176\u8fdb\u884c\u540e\u7eed\u6dfb\u52a0\u3001\u7f16\u8f91\u6216\u4fee\u6539\u64cd\u4f5c\uff0c\u7136\u540e\u518d\u63d0\u4ea4\u4f9b\u5206\u6790\u3002\u5982\u679c\u586b\u5199\u4e0d\u5f53\uff0c\u5c31\u4f1a\u663e\u793a\u51fa\u9519\u4fe1\u606f\uff0c\u6307\u51fa\u8be5\u5b57\u6bb5\u9700\u8981\u4fee\u6539\u3002", "26aae18ebeb12fc975912dcabcace885": "\u6570\u636e\u96c6\u53ef\u80fd\u6709\u591a\u4e2a\u7248\u672c\u3002\u65e7\u7248\u672c\u88ab\u4fdd\u5b58\u5728 API \u4e2d\uff0c\u4ee5\u4fbf\u4ee5\u540e\u8bbf\u95ee\u3002\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u6211\u4eec\u5c06\u59cb\u7ec8\u4f7f\u7528\u6700\u65b0\u7684\u5173\u952e\u8bcd\uff0c\u8fd9\u5c06\u81ea\u52a8\u6307\u5411\u6700\u65b0\u7248\u7684\u6570\u636e\u96c6\u3002", "ff733301340cd3aef1b4797ad7f56587": "\u5728 GFW Pro (Pro) \u4e0a\uff0c\u4e00\u65e6\u60a8\u4e0a\u4f20\u4e86\u4e00\u4e2a\u5217\u8868\uff0c\u60a8\u5c31\u53ef\u4ee5\u5728\u5730\u70b9\u7f51\u9875\u548c\u5217\u8868\u89c6\u56fe\u4e2d\u8fdb\u4e00\u6b65\u7ba1\u7406\u548c\u7f16\u8f91\u8be5\u5217\u8868\u3002\u4ee5\u4e0b\u6b65\u9aa4\u5c06\u6307\u5bfc\u60a8\u5982\u4f55\u7ba1\u7406\u60a8\u7684\u5217\u8868\u3001\u4f7f\u7528\u6587\u4ef6\u5939\u7ec4\u7ec7\u5217\u8868\u3001\u7f16\u8f91\u60a8\u7684\u5217\u8868\u3001\u79fb\u52a8\u6216\u590d\u5236\u5217\u8868\u4e2d\u7684\u5730\u70b9\u3001\u5220\u9664\u5217\u8868\u4e2d\u7684\u5730\u70b9\uff0c\u4ee5\u53ca\u901a\u8fc7 GFW \u7ba1\u7406\u5217\u8868\u3002", "69b12fe513e38899afa24174a19eb889": "Abigail \u6bd5\u4e1a\u4e8e Kwame Nkrumah University of Science and Technology\u3002\u5979\u7684\u804c\u4e1a\u7ecf\u5386\u5305\u62ec\u751f\u7269\u591a\u6837\u6027\u4fdd\u62a4\u3001\u6c14\u5019\u53d8\u5316\u7684\u51cf\u7f13\u548c\u9002\u5e94\u3001\u6539\u5584\u519c\u6751\u7ecf\u6d4e\u3001\u5021\u5bfc\u6027\u522b\u4e3b\u6d41\u5316\u548c\u884c\u4e3a\u53d8\u5316\u3002\u4f5c\u4e3a 2019 \u5e74\u7684 Tech Fellow\uff0cAbigail \u901a\u8fc7\u4e3a\u793e\u533a\u76d1\u6d4b\u5458\u63d0\u4f9b\u57f9\u8bad\u5e76\u914d\u5907 GFW \u5de5\u5177\uff0c\u5728\u52a0\u7eb3\u897f\u90e8\u5730\u533a\u5efa\u7acb\u8d77\u4e86\u4e94\u4e2a<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u793e\u533a\u8d44\u6e90\u7ba1\u7406\u533a</a>(CREMA) \u793e\u533a\u7684\u68ee\u6797\u76d1\u6d4b\u80fd\u529b\u3002\u5979\u7684\u9879\u76ee\u4e3a\u4e00\u4e2a\u5f3a\u5927\u7684\u68ee\u6797\u76d1\u6d4b\u7cfb\u7edf\u5960\u5b9a\u4e86\u57fa\u7840\uff0c\u786e\u4fdd\u4e86 CREMA \u62e5\u6709\u6539\u5584\u793e\u533a\u68ee\u6797\u8d44\u6e90\u7ba1\u7406\u6240\u9700\u7684\u6570\u636e\u548c\u5de5\u5177\u3002(\u7167\u7247\u7531 Abigail Frimpong \u63d0\u4f9b\uff09", "2db3aa7ad47ec85806e633a5a3d8bedf": "\u8349\u7a3f\u5217\u8868\u663e\u793a\u5728\u5730\u70b9\u9875\u9762\u4e0a\u3002", "6a991300834c9152976f97e2f88cde24": "\u2022 \u6570\u636e\u662f\u5efa\u6a21\u4ea7\u7269\uff0c\u56e0\u6b64\u5b58\u5728\u56fa\u6709\u8bef\u5dee\u548c\u4e0d\u786e\u5b9a\u6027\u3002\u6211\u4eec\u5f3a\u70c8\u5efa\u8bae\u7528\u6237\u5728\u4f7f\u7528\u6570\u636e\u4e4b\u524d\uff0c\u4ed4\u7ec6\u9605\u8bfb\u5e76\u5145\u5206\u7406\u89e3\u5143\u6570\u636e\u548c\u5176\u4ed6\u53ef\u7528\u6587\u6863\u3002<br>\u2022 \u603b\u6e05\u9664\u91cf\u7684\u4e0d\u786e\u5b9a\u6027\u9ad8\u4e8e\u6392\u653e\u91cf\uff0c\u8fd9\u4e3b\u8981\u662f\u6e90\u4e8e\u7f8e\u56fd\u548c\u6b27\u6d32\u4ee5\u5916\u7684\u6210\u719f\u6e29\u5e26\u68ee\u6797\u5728\u6e05\u9664\u7cfb\u6570\u4e0a\u5b58\u5728\u4e0d\u786e\u5b9a\u6027\u3002<br>\u2022 \u6570\u503c\u9002\u7528\u4e8e\u68ee\u6797\u5730\u533a\uff08\u6797\u51a0\u76d6\u5ea6&gt;30% \u4e14\u9ad8\u5ea6&gt;5 \u7c73\uff09\u548c\u6811\u6728\u8986\u76d6\u7387\u63d0\u9ad8\u7684\u5730\u533a\u3002 \u53c2\u89c1 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. 2021</a> \u4ee5\u8fdb\u4e00\u6b65\u4e86\u89e3\u5206\u6790\u4e2d\u6240\u7528\u7684\u68ee\u6797\u672f\u8bed\u5b9a\u4e49\u3002<br>\u2022 \u6392\u653e\u662f\u6e90\u81ea\u7fa4\u4e1b\u66ff\u4ee3\u5e72\u6270\uff0c\u4e0d\u5305\u62ec\u68ee\u6797\u9000\u5316\u5bfc\u81f4\u7684\u6392\u653e\u3002<br>\u2022 \u7528\u4f5c\u4f30\u7b97\u57fa\u7840\u7684\u6d3b\u52a8\u6570\u636e\u5b58\u5728\u65f6\u95f4\u4e0a\u7684\u4e0d\u4e00\u81f4\u6027\uff1a<br>o \u6811\u6728\u8986\u76d6\u589e\u91cf\u4ee3\u8868 2000-2012 \u5e74\u7684\u7d2f\u8ba1\u603b\u91cf\uff0c\u800c\u4e0d\u662f\u6bcf\u5e74\u7684\u589e\u91cf\u3002<br>o \u6392\u653e\u6570\u636e\u5b58\u5728\u65f6\u95f4\u4e0a\u7684\u4e0d\u4e00\u81f4\u6027\uff0c\u8fd9\u662f\u56e0\u4e3a 2011 \u5e74\u81f3 2015 \u5e74\u95f4\u7b97\u6cd5\u548c\u6570\u636e\u6765\u6e90\u6709\u6240\u53d8\u5316\uff0c\u5bfc\u81f4\u8f83\u665a\u5e74\u4efd\u7684\u635f\u5931\u53ef\u80fd\u5bf9\u8f83\u5c0f\u5c3a\u5ea6\u7684\u68ee\u6797\u5e72\u6270\u66f4\u52a0\u654f\u611f\u3002\u66f4\u591a\u4fe1\u606f\u8bf7\u53c2\u8003\u6b64\u5904\u3002", "bdf8e592cf80ca1a58bba940905f2ce7": "\u5982\u679c\u60a8\u6709\u66f4\u591a\u5173\u4e8e\u201c\u9700\u8981\u89c2\u5bdf\u7684\u5730\u65b9\u201d\u7684\u4fe1\u606f\u53ef\u4f9b\u5206\u4eab\uff0c\u6216\u8005\u5982\u679c\u60a8\u6709\u5174\u8da3\u52a0\u5165\u6211\u4eec\u7684\u884c\u52a8\u7f51\u7edc\u4e3a\u60a8\u9644\u8fd1\u7684\u5730\u65b9\u63d0\u4f9b\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53d1\u9001\u90ae\u4ef6\u7ed9\u6211\u4eec\uff1a<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">PlacestoWatch@wri.org</a>\u3002", "682925648d2d63b32ef6191ca3bea0f1": "\u5f53\u4e00\u4e2a\u8b66\u62a5\u88ab\u5355\u4e2a\u8b66\u62a5\u7cfb\u7edf\u68c0\u6d4b\u5230\u4e24\u6b21\u65f6\uff0c\u5b83\u5c31\u88ab\u5f52\u7c7b\u4e3a<em>\u9ad8</em>\u7f6e\u4fe1\u5ea6\u3002\u7531\u591a\u4e2a\u8b66\u62a5\u7cfb\u7edf\u68c0\u6d4b\u5230\u7684\u8b66\u62a5\u88ab\u5f52\u7c7b\u4e3a<em>\u6700\u9ad8</em>\u7f6e\u4fe1\u5ea6\u3002\u5f53\u591a\u4e2a\u4f20\u611f\u5668\u68c0\u6d4b\u5230\u540c\u4e00\u4f4d\u7f6e\u7684\u53d8\u5316\u65f6\uff0c\u6211\u4eec\u53ef\u4ee5\u66f4\u52a0\u786e\u4fe1\u5b83\u4e0d\u662f\u4e00\u6b21\u8bef\u62a5\uff0c\u53ef\u80fd\u4e0d\u9700\u8981\u7b49\u5f85\u989d\u5916\u7684\u536b\u661f\u56fe\u50cf\u6765\u589e\u52a0\u68c0\u6d4b\u5230\u7684\u635f\u5931\u7684\u7f6e\u4fe1\u5ea6\u3002", "b1f43994ddbf4779ee1a58b24cb3916c": "\u5728 {startYear} \u5230 {endYear} \u5e74\u4e4b\u95f4\uff0c {location} \u56e0\u6811\u6728\u8986\u76d6\u9762\u79ef\u635f\u5931\u5e73\u5747\u6bcf\u5e74\u5411\u5927\u6c14\u4e2d\u6392\u653e {annualAvg}\u3002\u5728\u6b64\u671f\u95f4\u603b\u5171\u6392\u653e\u4e86 {value}\u3002", "9eab9bdb56a428c1e246789ff64abf7e": "\u70b9\u51fb\u60a8\u60f3\u7f16\u8f91\u7684\u884c\u65c1\u8fb9\u7684\u590d\u9009\u6846\uff0c\u9009\u62e9\u60a8\u60f3\u7f16\u8f91\u7684\u884c\u3002\u5982\u679c\u60a8\u60f3\u7f16\u8f91\u6240\u6709\u5730\u70b9\uff0c\u8bf7\u70b9\u51fb\u8868\u683c\u5de6\u4e0a\u65b9\u201c\u5730\u70b9\u540d\u79f0\u201d\u65c1\u8fb9\u7684\u590d\u9009\u6846\u3002\u5982\u679c\u60a8\u9009\u62e9\u4e86\u8349\u7a3f\u5217\u8868\u4e2d\u5c1a\u672a\u5206\u6790\u7684\u5730\u70b9\u8fdb\u884c\u7f16\u8f91\uff0c\u90a3\u4e48\u5728\u63d0\u4ea4\u5217\u8868\u8fdb\u884c\u5206\u6790\u5e76\u83b7\u5f97\u6574\u4e2a\u5217\u8868\u7684\u5206\u6790\u7ed3\u679c\u4e4b\u524d\uff0c\u4ec5\u63d0\u4f9b\u6709\u9650\u7684\u5c5e\u6027\u4fe1\u606f\u3002", "c37007acab7099b1678f76d3c4ecb659": "\u901a\u8fc7 Pro \u5730\u56fe\uff0c\u60a8\u53ef\u4ee5\u5bf9\u4e0a\u4f20\u6570\u636e\u8fde\u540c GFW \u6570\u636e\u4e00\u8d77\u505a\u53ef\u89c6\u5316\u5206\u6790\u5904\u7406\u3002", "b64ce9a0f919ad7c8b49c4867e8dcddc": "\u8981\u7b5b\u9009\u8be5\u8868\u683c\uff0c\u8bf7\u70b9\u51fb\u201c\u9009\u62e9\u7b5b\u9009\u6761\u4ef6\u201d\uff0c\u7136\u540e\u9009\u62e9\u60a8\u60f3\u8981\u7684\u7b5b\u9009\u6761\u4ef6\u3002\u4e00\u65e6\u5b8c\u6210\uff0c\u70b9\u51fb\u201c\u5e94\u7528\u7b5b\u9009\u6761\u4ef6\u201d\u3002\u82e5\u8981\u67e5\u770b\u5df2\u5e94\u7528\u7684\u7b5b\u9009\u6761\u4ef6\uff0c\u5c06\u9f20\u6807\u60ac\u505c\u5728\u7b5b\u9009\u6761\u4ef6\u56fe\u6807\u4e0a\uff1b\u8981\u6e05\u9664\u7b5b\u9009\u6761\u4ef6\uff0c\u70b9\u51fb\u7b5b\u9009\u6761\u4ef6\u56fe\u6807\u65c1\u8fb9\u7684 \"X\"\u3002\u7b5b\u9009\u884c\u4e3a\u5bf9\u5df2\u5206\u6790\u5217\u8868\u548c\u8349\u7a3f\u5217\u8868\u90fd\u540c\u6837\u9002\u7528\u3002", "2438d95128ac4dcf212d1394190c69bd": "\u67d0\u4e2a\u7279\u5b9a\u7248\u672c\u7684\u5b9e\u9645\u6570\u636e\uff0c\u4ee5\u7279\u5b9a\u683c\u5f0f\u8868\u793a\u3002\u8fd9\u4e9b\u6570\u636e\u53ef\u4ee5\u662f\u5730\u7406\u7a7a\u95f4\u6570\u636e\uff0c\u4e5f\u53ef\u4ee5\u662f\u8868\u683c\u6570\u636e\u3002\u8d44\u4ea7\u6309\u4ee5\u4e0b\u65b9\u5f0f\u533a\u5206\uff1a<br> \u2022 \u6570\u636e\u683c\u5f0f<br> \u2022 \u6570\u503c\u5355\u4f4d/\u8868\u793a<br> \u2022 \u7f16\u7801<br> \u2022 \u6295\u5f71<br> \u2022 \u5206\u8fa8\u7387<br> \u2022 \u5141\u8bb8\u8bbf\u95ee\u6a21\u5f0f", "8525812f0ff8fae4b059c92a4241a87a": "\u4e2d\u95f4\u8868\u7684\u540d\u79f0\uff08\u4f60\u53ef\u4ee5\u4efb\u610f\u547d\u540d\uff09", "e088fb1601530556b5173555f692787a": "\u67e5\u8be2\u8bed\u53e5", "ca770c1f648a51dd8b06f938a4a79aed": "GFW Pro \u4ecb\u7ecd\uff1aPALM \u7126\u70b9", "5a712b5240b685806d74431d2f3036c6": "\u521b\u5efa\u5e76\u7ba1\u7406\u8d26\u6237", "5f84f0eb7e63a9541d874bd2bd36cdbd": "\u5206\u6790\u5730\u70b9\u548c\u5217\u8868", "3ea086dfbcbb5aa6f711d40ce1b05e78": "\u5171\u4eab\u3001\u6536\u53d6\u548c\u5bfc\u51fa\u5217\u8868", "e796689b007ddf3df3d42a12eb87671e": "\u5728\u5730\u56fe\u4e0a\u5bf9\u6570\u636e\u52a0\u4ee5\u53ef\u89c6\u5316\u548c\u5206\u6790\u5904\u7406", "86bec70044086ccffa81af4ff606c78e": "\u9009\u62e9\u6b63\u786e\u7684\u6a21\u677f", "00a234227743643087885f81d95e199b": "\u5982\u679c\u5217\u8868\u662f\u88ab\u4fdd\u5b58\u4e3a\u8349\u7a3f\uff0c\u60a8\u5c06\u88ab\u5bfc\u822a\u5230\u5730\u70b9\u7f51\u9875\uff0c\u5217\u8868\u5c06\u4ee5\u8349\u7a3f\u5f62\u5f0f\u663e\u793a\u3002", "8c00ebfbab791bc3368c3ebc3bdfa85e": "\u8981\u5c06\u5217\u8868\u4ece\u4e00\u4e2a\u6587\u4ef6\u5939\u79fb\u5230\u53e6\u4e00\u4e2a\u6587\u4ef6\u5939\uff0c\u6216\u4ece\u4e00\u4e2a\u6587\u4ef6\u5939\u4e2d\u5220\u9664\uff0c\u8bf7\u70b9\u51fb\u6587\u4ef6\u5939\uff0c\u7136\u540e\u70b9\u51fb\u6587\u4ef6\u5939\u4e2d\u8be5\u540d\u5355\u65c1\u8fb9\u7684 \u201c\u2026\u201d \u83dc\u5355\uff0c\u9009\u62e9\u201c\u7ba1\u7406\u201d\u3002\u88ab\u6dfb\u52a0\u5230\u6587\u4ef6\u5939\u4e2d\u7684\u8349\u7a3f\u5217\u8868\u5c06\u4ee5\u8349\u7a3f\u56fe\u6807\u8868\u793a\u3002<img loading=\"lazy\" class=\"wp-image-12575\" style=\"width: 88px;\" src=\"{{0}}\" alt=\"\" width=\"88\" height=\"40\">", "2d3d5414e61512b233854edf46e73cc1": "\u51c6\u5907\u7528\u4e8e\u4e0a\u4f20\u7684\u5f62\u72b6\u6587\u4ef6", "13402c152091f3883248f4e4071d728e": "\u52a1\u5fc5\u5728 GFW Pro \u4e0a\u9009\u62e9\u6b63\u786e\u7684\u6a21\u677f\u7c7b\u578b\uff0c\u8fd9\u53ef\u4ee5\u786e\u4fdd\u60a8\u7684\u6570\u636e\u683c\u5f0f\u6b63\u786e\uff0c\u4ee5\u4fbf Pro \u80fd\u5bf9\u5176\u52a0\u4ee5\u5206\u6790\u3002", "335795db360ed4c265334fcb9ab4dab4": "\u82e5\u8981\u7ba1\u7406\u5730\u70b9\u548c\u5217\u8868\uff0c\u8bf7\u70b9\u51fb\u9876\u90e8\u83dc\u5355\u4e2d\u7684\u201c\u5730\u70b9\u201d\u9009\u9879\u5361\u3002\u201c\u5730\u70b9\u201d\u89c6\u56fe\u663e\u793a GFW \u7ba1\u7406\u7684\u5730\u70b9\u5217\u8868\uff0c\u4ee5\u53ca\u60a8\u4e0a\u4f20\u7684\u5217\u8868\uff0c\u5305\u62ec\u60a8\u5c1a\u672a\u63d0\u4ea4\u5206\u6790\u7684\u5217\u8868\u3002\u5728\u5de6\u4fa7\uff0c\u60a8\u53ef\u4ee5\u4e0a\u4f20\u65b0\u7684\u5730\u70b9\u5e76\u521b\u5efa\u5217\u8868\u3002\u5982\u679c\u60a8\u6253\u7b97\u6dfb\u52a0\u3001\u5220\u9664\u6216\u79fb\u52a8\u4e00\u4e2a\u6216\u591a\u4e2a\u5730\u70b9\uff0c\u8bf7\u4fdd\u5b58\u4e00\u4efd\u539f\u59cb\u5217\u8868\u7684\u526f\u672c\u4ee5\u5907\u8bb0\u5f55\u3002", "3f4cd7610484f2cb42845a137d932bef": "\u5728 {startYear} \u5230 {endYear} \u5e74\u4e4b\u95f4\uff0c{indicator} \u7684<strong>\u5168\u7403</strong>\u68ee\u6797\u6392\u653e\u4e86 {totalEmissions}<b>/\u5e74</b>\uff0c\u6e05\u9664\u4e86 {totalRemovals}<b>/\u5e74</b>\u3002\u8fd9\u4ee3\u8868\u51c0\u78b3\u901a\u91cf\u4e3a {totalFlux}<b>/\u5e74</b>\u3002", "4ad5aa1bed28dbbbd67a13a55a218461": "\u5982\u679c\u5217\u8868\u88ab\u63d0\u4ea4\u5206\u6790\uff0cPro \u5c06\u5bf9\u76ee\u7684\u5730\u5217\u8868\u91cd\u65b0\u8fdb\u884c\u5206\u6790\u3002\u539f\u5217\u8868\u5c06\u53d8\u6210\u8349\u7a3f\u5f62\u5f0f\u3002\u60a8\u5c06\u88ab\u5bfc\u822a\u5230\u5730\u70b9\u7f51\u9875\uff0c\u5e76\u770b\u5230\u4e00\u6761\u6a2a\u5e45\u6d88\u606f\uff0c\u8868\u793a\u6b63\u5728\u5bf9\u60a8\u7684\u5217\u8868\u52a0\u4ee5\u5206\u6790\u3002\u5728\u5206\u6790\u5f00\u59cb\u4ee5\u53ca\u5206\u6790\u5b8c\u6210\u65f6\uff0c\u60a8\u4f1a\u6536\u5230\u4e00\u5c01\u7535\u5b50\u90ae\u4ef6\u3002\u5728\u5206\u6790\u5b8c\u6210\u4e4b\u524d\uff0c\u60a8\u5c06\u65e0\u6cd5\u8bbf\u95ee\u5df2\u63d0\u4ea4\u7684\u5217\u8868\u3002\u5728\u5206\u6790\u7ed3\u679c\u51fa\u6765\u540e\uff0c\u60a8\u53ef\u4ee5\u5728\u5730\u70b9\u7f51\u9875\u4e0a\u7684\u201c\u6211\u7684\u5217\u8868\u201d\u4e0b\u67e5\u770b\u5206\u6790\u7ed3\u679c\u3002\u66f4\u591a\u5173\u4e8e\u5206\u6790\u5730\u70b9\u548c\u5217\u8868\u65b9\u9762\u7684\u4fe1\u606f\uff0c\u8bf7\u53c2\u8003\u6b64\u5904\uff0c\u5173\u4e8e\u8fd1\u5b9e\u65f6\u76d1\u6d4b\u5730\u70b9\u7684\u4fe1\u606f\uff0c\u8bf7\u53c2\u8003\u6b64\u5904\u3002", "08c52311053fb6f676b9793714514e6d": "\u82e5\u8981\u901a\u8fc7\u60a8\u7684\u6a21\u677f\u67e5\u770b\u66f4\u591a\u5217\u6570\u636e\uff0c\u70b9\u51fb\u201c\u6dfb\u52a0\u5217\u201d\uff0c\u7136\u540e\u70b9\u51fb\u60a8\u60f3\u67e5\u770b\u7684\u9644\u52a0\u5b57\u6bb5\u65c1\u8fb9\u7684\u590d\u9009\u6846\u3002\u6dfb\u52a0\u7684\u5217\u5c06\u51fa\u73b0\u5728\u8868\u683c\u7684\u6700\u53f3\u8fb9\u3002\u82e5\u8981\u9690\u85cf\u5217\uff0c\u8bf7\u70b9\u51fb\u201c\u6dfb\u52a0\u5217\u201d\uff0c\u53d6\u6d88\u52fe\u9009\u60a8\u60f3\u9690\u85cf\u7684\u5b57\u6bb5\u3002\u60a8\u4e5f\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u201c\u5168\u9009\u201d\u6216\u201c\u5168\u4e0d\u9009\u201d\uff0c\u4e00\u6b21\u6027\u9009\u62e9\u6216\u53d6\u6d88\u9009\u62e9\u6240\u6709\u5b57\u6bb5\u3002\u5982\u679c\u5217\u8868\u662f\u8349\u7a3f\u5f62\u5f0f\uff0c\u90a3\u4e48\u5728\u6574\u4e2a\u5217\u8868\u63d0\u4ea4\u5206\u6790\u4e4b\u524d\uff0c\u5217\u8868\u4e2d\u672a\u5206\u6790\u7684\u5730\u70b9\u5c06\u4e0d\u4f1a\u5305\u62ec\u6240\u6709\u4fe1\u606f\u3002", "44dd32d91cfe0fc873caa178aa5025a2": "\u6bcf\u4e2a\u5730\u70b9\u6216\u5730\u70b9\u5217\u8868\u5fc5\u987b\u9996\u5148\u4e0a\u4f20\u5e76\u63d0\u4ea4\u5206\u6790\u3002\u4e0a\u4f20\u5904\u7406\u65f6\u95f4\u53ef\u80fd\u9700\u8981\u957f\u8fbe 24 \u5c0f\u65f6\u3002\u5728\u5904\u7406\u5b8c\u6210\u4e4b\u524d\uff0c\u5217\u8868\u5c06\u4ee5\u201c\u6b63\u5728\u5206\u6790\u201d\u7684\u6807\u7b7e\u663e\u793a\u5728\u5730\u70b9\u9875\u9762\u4e0a\uff0c\u5e76\u4e14\u4e0d\u80fd\u70b9\u51fb\u3002\u5728\u5904\u7406\u5f00\u59cb\u548c\u5b8c\u6210\u65f6\uff0c\u60a8\u4f1a\u6536\u5230\u4e00\u5c01\u786e\u8ba4\u90ae\u4ef6\u3002\u6216\u8005\uff0c\u60a8\u53ef\u4ee5\u4ece\u5168\u7403\u69a8\u6cb9\u5382\u5217\u8868\uff08\u4f4d\u4e8e\u5730\u70b9\u7f51\u9875\u4e0a\u7684\u201cGlobal Forest Watch \u5217\u8868\u201d\u4e0b\uff09\u4e2d\u9009\u62e9\u4e00\u4e2a\u68d5\u6988\u6cb9\u5382\u7684\u5b50\u96c6\u3002\u5927\u5b97\u5546\u54c1\u98ce\u9669\u5206\u6790\u5bf9\u5168\u7403\u69a8\u6cb9\u5382\u5217\u8868\u81ea\u52a8\u9002\u7528\u3002", "29b9762e2bb9ecc910d21a3d2c4a44eb": "\u7528\u6237\u6536\u5230\u8349\u7a3f\u5f62\u5f0f\u7684\u5171\u4eab\u5217\u8868\u3002", "82f62e1b6e3b774bfee5945948187183": "\u4e0b\u9762\u7684\u6b65\u9aa4\u5c06\u6307\u5bfc\u60a8\u5982\u4f55\u5728\u5185\u90e8\u5171\u4eab\u5217\u8868\u3001\u63a5\u6536\u5171\u4eab\u7684\u5217\u8868\u548c\u5bfc\u51fa\u5217\u8868\u3002\u82e5\u8981\u4e0e\u7ec4\u7ec7\u4e2d\u7684\u5176\u4ed6\u7528\u6237\u5171\u4eab\u5217\u8868\uff0c\u8bf7\u9075\u5faa\u5185\u90e8\u5171\u4eab\u5217\u8868\u6b65\u9aa4\u3002\u4ec5\u62e5\u6709\u7ba1\u7406\u5458\u7ea7\u522b\u6743\u9650\u7684\u7528\u6237\u624d\u80fd\u5728\u5185\u90e8\u5171\u4eab\u5217\u8868\u2014\u2014\u7f16\u8f91\u548c\u6d4f\u89c8\u8005\u53ef\u4ee5\u63a5\u6536\u5171\u4eab\u7684\u5217\u8868\u3002\u8349\u7a3f\u5217\u8868\uff08\u8fd9\u7c7b\u4fdd\u5b58\u5728\u60a8\u7684 Pro \u8d26\u6237\u4e2d\uff0c\u53ef\u5bf9\u5176\u8fdb\u884c\u540e\u7eed\u6dfb\u52a0\u3001\u7f16\u8f91\u6216\u4fee\u6539\u64cd\u4f5c\uff0c\u7136\u540e\u518d\u63d0\u4ea4\u5206\u6790\uff09\u53ef\u4ee5\u5171\u4eab\u3002\u53ea\u6709\u5217\u8868\u521b\u5efa\u8005\u53ef\u4ee5\u63d0\u4ea4\u5217\u8868\u4ee5\u4f9b\u5206\u6790\u3002\u82e5\u8981\u5728\u7ec4\u7ec7\u4e4b\u5916\u5206\u4eab\u5217\u8868\uff0c\u8bf7\u6309\u7167\u5bfc\u51fa\u540d\u5355\u7684\u6b65\u9aa4\u64cd\u4f5c\u3002", "51056a1e2785396dff0576f1743e7c07": "\u8be5\u89c6\u9891\u6307\u5357\u521b\u5efa\u4e8e 2020 \u5e74 7 \u6708\uff0c\u65e8\u5728\u6f14\u793a\u5982\u4f55\u4f7f\u7528 GFW Pro \u8fdb\u884c\u68d5\u6988\u6cb9\u4f9b\u5e94\u94fe\u76d1\u6d4b\u3002", "4a96a2a950d7c818ecc40a3e8b68d9dd": "<strong>\u6708</strong>\uff1a\u663e\u793a\u8fc7\u53bb\u56db\u5468\u4ee5\u6765\u7684\u8b66\u62a5\u3002\u6bcf\u6708\u8b66\u62a5\u6bcf\u5468\u66f4\u65b0\u4e00\u6b21\u3002", "d7b5742ee6114702579f486b772dfab9": "\u5728\u5bfb\u627e\u6700\u5feb\u901f\u7684\u68ee\u6797\u780d\u4f10\u4fe1\u53f7\uff1f\u4e0d\u59a8\u770b\u770b GFW \u7684\u7efc\u5408\u8b66\u62a5", "423e92b9362b6bc2165fbcec97876114": "\u8fd9\u7bc7\u6587\u7ae0\u6709 0 \u6761\u8bc4\u8bba", "10990929400c3c382daed6ad0b9c0e21": "\u5728 GFW \u4e0a\u63a2\u7d22", "5050de81a215ed5fb8995f857eabd1ea": "\u5728 {location} \u8fc7\u53bb {timeframe} \u65f6\u95f4\u91cc\uff0c\u5171\u68c0\u6d4b\u5230 {count} \u6b21\u68ee\u6797\u780d\u4f10\u8b66\u62a5\uff0c\u5f71\u54cd\u9762\u79ef\u7ea6\u4e3a {area}\u3002\u524d {topRegions} \u540d\u5360\u7efc\u5408\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u7684 {topPercent}\u3002", "0a847f13c87cf49daf7b50ee60a8a9a2": "\u8bc4\u8bba *", "814ef16fed423a8d580cc700ae05b46f": "\u8be5\u56fe\u663e\u793a\u4e86 2001 \u5e74\u81f3 2020 \u5e74\u68ee\u6797\u4e0e\u5927\u6c14\u4e4b\u95f4\u6e29\u5ba4\u6c14\u4f53\u7684\u5e74\u5e73\u5747<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6392\u653e\u91cf</a>\u3001<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6e05\u9664\u91cf</a>\u548c<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u51c0\u901a\u91cf</a>\u3002\u7528\u4e8e\u8ba1\u7b97\u8fd9\u4e9b\u6570\u636e\u7684\u65b9\u6cd5\u8bf7\u53c2\u89c1 <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. 2021</a> \u4e2d\u7684\u63cf\u8ff0\uff0c\u8be5\u6587\u7ae0\u4ecb\u7ecd\u4e86\u4e00\u4e2a\u7528\u4e8e\u4f30\u8ba1\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u7684\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\u3002\u8fd9\u4e9b\u65b9\u6cd5\u9075\u5faa IPCC <a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u6307\u5357\u3002\u6392\u653e\u6e90\u81ea\u7fa4\u4e1b\u66ff\u4ee3\u5e72\u6270\uff0c\u800c\u6e05\u9664\u5219\u53d1\u751f\u5728\u68ee\u6797\u5f97\u5230\u7ef4\u6301\u6216\u6269\u5927\u7684\u5730\u65b9\u3002\u6392\u653e\u5305\u62ec\u6240\u6709\u76f8\u5173\u7684\u751f\u6001\u7cfb\u7edf\u78b3\u5e93\uff08\u5730\u4e0a\u751f\u7269\u91cf\u3001\u5730\u4e0b\u751f\u7269\u91cf\u3001\u67af\u6728\u3001\u5783\u573e\u3001\u571f\u58e4\uff09\u548c\u6e29\u5ba4\u6c14\u4f53 (CO2, NH4, N2O)\uff0c\u800c\u6e05\u9664\u5219\u6d89\u53ca\u5730\u4e0a\u548c\u5730\u4e0b\u751f\u7269\u91cf\u5e93\u3002<br>\u56e0\u4e3a\u6e05\u9664\u91cf\u548c\u51c0\u901a\u91cf\u6570\u636e\u5e76\u975e\u6309\u65f6\u95f4\u5e8f\u5217\u63d0\u4f9b\uff0c\u6240\u4ee5\u8be5\u56fe\u663e\u793a\u6574\u4e2a\u6a21\u578b\u671f\u95f4\u7684\u5e73\u5747\u5e74\u6392\u653e\u91cf\u3001\u6e05\u9664\u91cf\u548c\u51c0\u901a\u91cf\u3002\u5728\u6b64\u56fe\u4e2d\uff0c\u4f7f\u7528\u6240\u6709\u6d41\u91cf\u7684\u7d2f\u79ef\u503c\u9664\u4ee5\u6a21\u578b\u8986\u76d6\u5e74\u6570\uff0c\u6765\u8ba1\u7b97\u6a21\u578b\u671f\u95f4\u7684\u5e74\u5e73\u5747\u6570\u3002\u7edf\u8ba1\u6570\u636e\u5305\u62ec\u9ad8\u4e8e\u6240\u9009\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u533a\u57df\uff0c\u4ee5\u53ca\u672a\u8fbe\u5230\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u4f46\u6811\u6728\u8986\u76d6\u7387\u589e\u52a0\u7684\u533a\u57df\u3002", "cb3d09748c0ab0c1c06e1b550c27883a": "{location} \u4e0e\u68ee\u6797\u76f8\u5173\u7684\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u91cf", "08f9395268f6ce9fa307edf7d5940c1c": "\u4ece {startYear} \u5230 {endYear} \u5e74\uff0c{location} \u6709 {percentage} \u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u53d1\u751f\u5728 {lossPhrase} \u4e4b\u5185\u3002\u5929\u7136\u6797\u7684\u603b\u635f\u5931\u76f8\u5f53\u4e8e {value} \u7684 CO\u2082e \u6392\u653e\u91cf\u3002", "595af0c8969fa5bc47df8829d50b1906": "\u6839\u636e {location} \u6700\u8fd1 {timeframe} \u7684\u6570\u636e\u6765\u770b\uff0c\u706b\u70e7\u8ff9\u5730\u9762\u79ef\u6700 {significant} \u7684\u533a\u57df\u662f {topRegion}\uff0c\u5171\u6709 {topRegionCount} \u571f\u5730\u9762\u79ef\u88ab\u706b\u70e7\u3002\u8fd9\u5360 {location} \u603b\u706b\u70e7\u8ff9\u5730\u9762\u79ef\u7684 {topRegionPerc}\uff0c\u4e0e <b>2001</b> \u5e74\u540c\u671f\u76f8\u6bd4\u5c5e\u4e8e {status} \u6c34\u5e73\u3002", "455348b143f0e4154e0f4f76f47d7c1a": "\u4ece {startYear} \u5230 {endYear} \u5e74\uff0c{location} {indicator} \u635f\u5931\u4e86 {loss} \u7684<b>\u6e7f\u6da6\u539f\u59cb\u6797</b>\uff0c\u5360\u5176\u540c\u671f {total tree cover loss} \u7684 {percent}\u3002\u5728\u6b64\u671f\u95f4\uff0c<b>{location} {indicator} \u7684\u6e7f\u6da6\u539f\u59cb\u6797\u603b\u9762\u79ef\u51cf\u5c11\u4e86</b> {extentDelta}\u3002", "caf22f11d2f8dcf8884ab6c8b79da21a": "\u5728 {location} \u4ece {startYear} \u5230 {endYear} \u5e74\uff0c\u5728\u635f\u5931\u4e3b\u56e0\u5bfc\u81f4 {deforestation} \u7684\u5730\u533a\uff0c\u4e00\u5171\u5e73\u5747\u6392\u653e\u4e86 {totalEmissions}\u3002", "508e83786ddf09fa0ee38699f766ba79": "\u6839\u636e FAO \u7684\u6570\u636e\uff0c{year}\u5e74\uff0c{location} \u7684\u68ee\u6797\u780d\u4f10\u7387\u662f\u6bcf\u5e74 {rate}\uff0c\u5176\u4e2d\u6bcf\u5e74 {human} \u662f\u56e0\u4e3a\u4eba\u7c7b\u6d3b\u52a8\u6240\u81f4\u3002", "8219d824552d7446aabd00340b8f0dfb": "\u7f51\u9875\u7248 <a aria-label=\"undefined (opens in a new tab)\" rel=\"noreferrer noopener\" href=\"{{0}}\" target=\"_blank\">Forest Watcher</a> \u901a\u8fc7\u53ef\u7f16\u8f91\u7684\u62a5\u544a\u6a21\u677f\u63d0\u4f9b\u66f4\u52a0\u51fa\u8272\u7684\u5b9a\u5236\u6027\u80fd\uff0c\u5e76\u4e14\u5177\u5907\u521b\u5efa\u3001\u5ba1\u67e5\u548c\u5411\u56e2\u961f\u6210\u5458\u5206\u914d\u62a5\u544a\u7b49\u9009\u9879\uff0c\u6709\u5229\u4e8e\u4fc3\u8fdb\u5408\u4f5c\u3002", "9bfb6176de480710be618cce016a8e86": "\u65e0\u53ef\u7528\u6570\u636e<img class=\"message-icon\" src=\"{{0}}\" alt=\"tree\" data-gg-hash=\"e4e70c4377f8e1ab4eb7945f66fac720f868ff348afc234c88063d2b3a3e6018\">", "1bf938923759081467e87004fe30a5d1": "\u8fd9\u9879\u6570\u636e\u80cc\u540e\u7684\u65b9\u6cd5\u5df2\u7ecf\u968f\u65f6\u95f4\u53d1\u751f\u6539\u53d8\u3002\u6bd4\u8f83\u65b0\u65e7\u6570\u636e\u65f6\u52a1\u5fc5\u8981\u8c28\u614e\uff0c\u5c24\u5176\u662f 2015 \u5e74\u524d\u540e\u7684\u6570\u636e\u3002<a class=\"caution-link\" href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5728\u6b64\u4e86\u89e3\u66f4\u591a\u4fe1\u606f</a>\u3002", "a07fc4efc5885c4584cba37135eaf900": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\" aria-label=\"undefined (opens in a new tab)\">Forest Watcher</a> \u7684\u7f51\u9875\u7248\u672c\u901a\u8fc7\u53ef\u7f16\u8f91\u7684\u62a5\u544a\u6a21\u677f\u5b9e\u73b0\u4e86\u66f4\u5927\u7a0b\u5ea6\u7684\u81ea\u5b9a\u4e49\uff0c\u5e76\u901a\u8fc7\u521b\u5efa\u62a5\u544a\u3001\u5ba1\u67e5\u62a5\u544a\u548c\u5411\u56e2\u961f\u6210\u5458\u5206\u914d\u62a5\u544a\u7b49\u9009\u9879\u4fc3\u8fdb\u4e86\u534f\u4f5c\u3002", "76bcb774210a04a5238e5999cbf6766d": "\u5df4\u897f\u975e\u653f\u5e9c\u7ec4\u7ec7 Instituto Araguaia \u4f7f\u7528 GFW \u7684\u5730\u56fe\u548c\u652f\u6301\uff0c\u63a8\u52a8\u653f\u5e9c\u4e3a\u4e00\u4e2a\u5173\u952e\u7684\u751f\u6001\u7cfb\u7edf\u5efa\u7acb\u4e00\u4e2a\u6cd5\u5f8b\u8ba4\u53ef\u7684\u65b0\u7f13\u51b2\u533a\u2026\u2026", "35770199dbf9e3bbb52a2c53a851cb14": "\u4e9a\u9a6c\u900a\u4fdd\u62a4\u534f\u4f1a (ACA) \u5229\u7528 GFW \u7684\u536b\u661f\u6570\u636e\uff0c\u9996\u5bb6\u62a5\u9053\u4e86 United Caca \u5728\u79d8\u9c81\u975e\u6cd5\u780d\u4f10\u539f\u59cb\u6797\u7684\u4e8b\u4ef6\u3002GFW \u7684\u6570\u636e\u2026\u2026", "ef055b69f96f6b9e04285fab67d65d23": "\u4e4c\u5e72\u8fbe\u56fd\u5bb6\u68ee\u6797\u7ba1\u7406\u5c40 (NFA) \u7684\u68ee\u6797\u76d1\u6d4b\u5458\u4f7f\u7528 GFW \u7684 GLAD \u68ee\u6797\u780d\u4f10\u8b66\u62a5\u53d1\u73b0\u4e86\u4f4d\u4e8e Kasyoha Kitomi \u5730\u533a\u7684\u4e00\u4e2a\u5c0f\u578b\u975e\u6cd5\u91c7\u4f10\u8425\u5730\u2026\u2026", "50db84dfcf8d8f97f55cb871760184f5": "\u79d8\u9c81\u7684\u68ee\u6797\u548c\u91ce\u751f\u52a8\u7269\u8d44\u6e90\u76d1\u7763\u673a\u6784 (OSINFOR) \u4f7f\u7528 GFW \u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u6765\u786e\u5b9a\u5b9e\u5730\u68c0\u67e5\u7684\u4f18\u5148\u6b21\u5e8f\u3002GFW \u7684\u8b66\u62a5\u5f15\u5bfc\u4ed6\u4eec\u5bf9\u516c\u8def\u8fd0\u8f93\u8fdb\u884c\u68c0\u6d4b\u2026\u2026", "8d2296056b7491ae2f0af671505bcc5b": "\u6574\u5408\u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5", "78c0de9f2775420b2c8943df6e39dea1": "\u83f2\u5f8b\u5bbe\u4f17\u8bae\u9662\u8bae\u5458 Yap \u5f15\u7528\u4e86Global Forest Watch \u5173\u4e8e\u7ea2\u6811\u6797\u635f\u5931\u7684\u6570\u636e\u6765\u4e3a\u56fd\u5bb6\u7ea2\u6811\u6797\u4fdd\u62a4\u7684\u8ba8\u8bba\u63d0\u4f9b\u652f\u6301\u2026\u2026", "d4b669cb43507856693563413afc1485": "\u4e3a\u4e86\u5c06\u4e09\u4e2a\u8b66\u62a5\u7cfb\u7edf\u6574\u5408\u5230\u4e00\u4e2a\u516c\u5171\u7f51\u683c\u4e0a\uff0cGLAD-L \u8fdb\u884c\u4e86\u91cd\u65b0\u53d6\u6837\uff0c\u4ece 30m \u5206\u8fa8\u7387\u5230 10m \u5206\u8fa8\u7387\uff0c\u4ee5\u5339\u914d GLAD-S2 \u548c RADD\u3002\u56e0\u6b64\uff0c\u6574\u5408\u5c42\u4e2d\u7684\u50cf\u7d20\u53ef\u80fd\u4e0e\u5355\u4e2a GLAD-L \u5c42\u4e2d\u7684\u50cf\u7d20\u4e0d\u5b8c\u5168\u5bf9\u9f50\u3002", "225e5a859df3f9a716150452b5f49dc8": "\u4e0a\u4e2a\u6708\u7684\u9ad8\u4f18\u5148\u7ea7\u8b66\u62a5", "00b5158229c852679f036d0cbf0aae2d": "GLAD-S2\uff1a2019 \u5e74 1 \u6708\u81f3\u4eca\uff0c\u9002\u7528\u4e8e\u5357\u7f8e\u6d32\u7684\u4e3b\u8981\u6f6e\u6e7f\u70ed\u5e26\u68ee\u6797\u5730\u533a", "6f8877296a8a782191f6c9e9a8ecd8fc": "\u6bcf 6-12 \u5929\uff0c10m\uff0c \u6f6e\u6e7f\u70ed\u5e26\u5730\u533a\uff0c WUR", "e3d8082c7aa4a040c3d5b1dc26e8ce7d": "5 \u5929\uff0c10m\uff0c\u4e9a\u9a6c\u900a\uff0cUMD/GLAD", "972c72872144ea16ed10bd4669e8ee56": "8 \u5929\uff0c30m\uff0c\u70ed\u5e26\u5730\u533a\uff0cUMD/GLAD", "905feed5ba304f859e9f4b86327d48c5": "\u6b64\u6570\u636e\u96c6\u7531 Global Forest Watch \u6c47\u7f16\u800c\u6210\uff0c\u5c06\u4e09\u4e2a\u8b66\u62a5\u7cfb\u7edf (GLAD-L, GLAD-S2, RADD) \u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u6c47\u603b\u5230\u4e00\u4e2a\u5355\u4e00\u7684\u3001\u6574\u5408\u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u5c42\u4e2d\u3002\u8fd9\u79cd\u6574\u5408\u4f7f\u7528\u6237\u80fd\u591f\u6bd4\u4efb\u4f55\u5355\u4e2a\u7cfb\u7edf\u90fd\u66f4\u5feb\u5730\u53d1\u73b0\u68ee\u6797\u780d\u4f10\u4e8b\u4ef6\uff0c\u56e0\u4e3a\u5f53\u4efb\u4f55\u4e00\u4e2a\u6e90\u8b66\u62a5\u7cfb\u7edf\u66f4\u65b0\u65f6\uff0c\u6574\u5408\u5c42\u90fd\u4f1a\u66f4\u65b0\u3002", "54312b590fa2ad71719738ea38c58c15": "\u4ec5\u663e\u793a\u9ad8\u7f6e\u4fe1\u5ea6\u548c\u6700\u9ad8\u7f6e\u4fe1\u5ea6\u8b66\u62a5", "de8644e49718e6ee798726fd74e683f0": "\u6728\u7ea4\u7ef4/\u6728\u6750\u6df7\u5408", "18b17f1034bdf64c5a0b185a0d2faf6d": "\u6bcf\u6708\u8bc6\u522b\u9ad8\u4f18\u5148\u7ea7 GLAD \u8b66\u62a5\u7684\u533a\u57df\u3002\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8fd9\u91cc</a>\u767b\u8bb0\u8ba2\u9605\u65b0\u95fb\u901a\u8baf\u3002", "b6da8aff99bd2679ccf51ea7e126f20d": "<strong>\u5357\u7f8e\uff1a</strong>\u5df4\u897f\u3001\u79d8\u9c81", "5856b8358162ad70261c2fbd3575e288": "2020\uff0c10m\uff0c\u9009\u5b9a\u5730\u533a\uff0cWRI", "59749ee8a67c1e9141ef3187d75b6523": "\u5168\u7403\u6ce5\u70ad\u5730", "94309f4643209c1d1ec10952c3821052": "\u9700\u8981\u89c2\u5bdf\u7684\u5730\u65b9\u662f\u4e00\u79cd\u81ea\u52a8\u7b97\u6cd5\uff0c\u56e0\u6b64\u53ef\u80fd\u4f1a\u9057\u6f0f\u67d0\u4e9b\u4eba\u8ba4\u4e3a\u7684\u201c\u9ad8\u4f18\u5148\u7ea7\u201d\u533a\u57df\u3002\u6b64\u5916\uff0c\u8be5\u7b97\u6cd5\u5e76\u4e0d\u8003\u8651\u5df2\u8bc6\u522b\u7684\u5730\u65b9\u7684\u5408\u6cd5\u6027\u3002", "1a8b81cd838b25c3988e28ccc5a35289": "\u5168\u7403\u706b\u707e\u5929\u6c14\u6307\u6570 - 2022 \u5e74 3 \u6708 12 \u65e5", "0714daee8a90da8bd49cdee4cb57ff70": "\uff08\u6bcf\u65e5\uff0c0.1\u00b0\uff0c\u5168\u7403\uff0cNASA/GFWED\uff09", "62bf28980ce5109c55b71b641b98a662": "\u4f4e\u5b8c\u6574\u6027", "41e82523465ef67922cf674fa63bd5f5": "\u540c\u610f", "3cfc12d60de58dd1c31c1085f0228eee": "\u96f6\u661f\u7684", "9dd30c1551f7494c90c8f2ed17d4ea6c": "\u539f\u4f4f\u6c11\u571f\u5730 - \u4e0d\u88ab\u653f\u5e9c\u627f\u8ba4", "9b8108931f6f4f718b6a2f83ee5f793e": "\u52fe\u753b\u6ce5\u70ad\u5730\u548c\u6709\u673a\u571f\u58e4\u7684\u8303\u56f4", "cf0de723e9d01043635e7f82e62e44c7": "\u4f10\u6728\u7279\u8bb8\u6743 - 2021", "277ba9e9c4d2fe2beb302fead300a970": "\u4fdd\u62a4\u533a - 2021", "91067a56911ae41a6c22b45da89e6daf": "\u68ee\u6797\u51c0\u78b3\u901a\u91cf", "d6def37791a342abf7f7257fc7a9b9d9": "\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730\u6743\u5229\u7684\u6807\u793a\u533a\u57df", "da679d421ec5176d25789a6b93aaaa6d": "\u663e\u793a\u5730\u4e0a\u6d3b\u4f53\u6728\u8d28\u751f\u7269\u91cf\u5bc6\u5ea6", "d39e046ebbb2d5656acd511d7133f9f7": "\u96f6\u706d\u7edd\u8054\u76df (Alliance for Zero Extinction) \u7f51\u7ad9 - 2019", "2f5f0213ffa64793f189381b3830df93": "\u5bf9\u68ee\u6797\u4fdd\u62a4\u7684\u524a\u51cf\u5f15\u53d1\u5df4\u897f\u4e9a\u9a6c\u900a\u5730\u533a\u7684\u571f\u5730\u63a0\u593a\u72c2\u6f6e", "7b78abce89abf3849f9f040cc820db32": "\u5df4\u5e03\u4e9a\u65b0\u51e0\u5185\u4e9a\u4e1c\u65b0\u4e0d\u5217\u98a0\u7701\u6700\u8fd1\u7684\u536b\u661f\u6570\u636e\u663e\u793a\uff0c\u6811\u6728\u8986\u76d6\u7684\u635f\u5931\u660e\u663e\u589e\u52a0\u3002\u8b66\u62a5\u4f4d\u7f6e\u9760\u8fd1\u2026\u2026", "8addef56d39b503e9e9e4f267eec154e": "\u975e\u6cd5\u9053\u8def\u7a7f\u8fc7\u54e5\u4f26\u6bd4\u4e9a\u4e9a\u9a6c\u900a\u5730\u533a\u7684\u56fd\u5bb6\u516c\u56ed\u548c\u539f\u4f4f\u6c11\u4fdd\u62a4\u533a", "0d58e486c096c2939a5efe3293b00619": "\u5173\u952e\u751f\u7269\u591a\u6837\u6027\u5730\u533a - 2021", "1d5dc026e4e4d0f16b3a5d94c8bd69d9": "GLAD-L\uff1a2018 \u5e74 1 \u6708 1 \u65e5\u81f3\u4eca\uff0c\u9002\u7528\u4e8e\u6574\u4e2a\u70ed\u5e26\u5730\u533a\uff0830\u00b0N \u81f3 30\u00b0S\uff09\uff0c\u4ece 2015 \u5e74\u81f3\u4eca\uff0c\u9002\u7528\u4e8e\u4e9a\u9a6c\u900a\u3001\u521a\u679c\u76c6\u5730\u548c\u4e1c\u5357\u4e9a\u5c9b\u5c7f\u7684\u90e8\u5206\u56fd\u5bb6", "13d6f700e423797bcb3f3661c867249e": "\u5176\u4ed6\u6df7\u5408", "015db133195aaee8fc34f94c6f562283": "\u6309\u7c7b\u578b\u5212\u5206\u7684\u6728\u7ea4\u7ef4\u7279\u8bb8\u6743 - 2021", "0f2254356939ee3f4da2b11782402028": "\u70b9\u51fb\u5730\u70b9\u7f51\u9875\u4e0a\u201c\u6211\u7684\u5217\u8868\u201d\u4e0b\u7684\u4e00\u4e2a\u5217\u8868\u3002\u70b9\u51fb\u60a8\u60f3\u5220\u9664\u7684\u884c\u65c1\u8fb9\u7684\u590d\u9009\u6846\uff0c\u9009\u62e9\u60a8\u60f3\u5220\u9664\u7684\u884c\u3002\u8fd9\u4e2a\u64cd\u4f5c\u5bf9\u4e8e\u8349\u7a3f\u5217\u8868\u6216\u5df2\u5206\u6790\u5217\u8868\u90fd\u9002\u7528\u3002", "66e34915370389e1882357f7dcf79a09": "\u5730\u4e0a\u751f\u7269\u91cf\u53ef\u9009\u62e9\u4e24\u79cd\u4e0d\u540c\u7684\u5355\u4f4d\u8fdb\u884c\u4e0b\u8f7d\uff1a1) \u767e\u4e07\u514b AGB \u6bcf\u516c\u9877\uff0c\u548c 2) \u767e\u4e07\u514b AGB \u6bcf\u50cf\u7d20\u3002\u7b2c\u4e00\u79cd\u5355\u4f4d\u9002\u7528\u4e8e\u53ef\u89c6\u5316\uff08\u7ed8\u56fe\uff09AGB \u548c\u4f30\u7b97\u611f\u5174\u8da3\u5730\u533a\u7684\u5e73\u5747 AGB \u5bc6\u5ea6\uff0c\u56e0\u4e3a\u5b83\u4ee3\u8868\u6bcf\u516c\u9877\u7684 AGB \u5bc6\u5ea6\u3002\u7b2c\u4e8c\u79cd\u5355\u4f4d\u9002\u7528\u4e8e\u8ba1\u7b97\u611f\u5174\u8da3\u5730\u533a\u7684\u5730\u9762\u751f\u7269\u91cf\u603b\u50a8\u91cf\uff0c\u56e0\u4e3a\u53ef\u4ee5\u5c06 AOI \u4e2d\u5404\u50cf\u7d20\u7684\u6570\u503c\u76f8\u52a0\uff0c\u5f97\u5230\u8be5\u5730\u533a\u7684 AGB \u603b\u50a8\u91cf\u3002\u540e\u8005\u6570\u503c\u7684\u8ba1\u7b97\u6309\u7167\u6bcf\u4e2a\u50cf\u7d20\u7684\u5927\u5c0f\u8c03\u6574\u6bcf\u516c\u9877\u7684 AGB\uff0c\u50cf\u7d20\u5927\u5c0f\u56e0\u7eac\u5ea6\u800c\u5f02\u3002", "c82580ca635fe7f15061355b23842854": "\u6b64\u6570\u636e\u96c6\u6839\u636e\u539f\u59cb\u68ee\u6797\u3001\u4fdd\u62a4\u533a\u548c\u8fd1\u671f GLAD \u8b66\u62a5\u7684\u8986\u76d6\u8303\u56f4\uff0c\u6bcf\u6708\u786e\u5b9a GLAD \u68ee\u6797\u780d\u4f10\u8b66\u62a5\u7684\u9ad8\u4f18\u5148\u7ea7\u533a\u57df\u3002GLAD \u8b66\u62a5\u8986\u76d6\u7684 16 \u4e2a\u70ed\u5e26\u56fd\u5bb6\uff08\u622a\u81f3 2017 \u5e74 10 \u6708\uff09\u88ab\u5212\u5206\u4e3a 10 km \u00d7 10 km \u7684\u7f51\u683c\u5355\u5143\uff0c\u6839\u636e IFL \u6216\u4fdd\u62a4\u533a\u8986\u76d6\u7684\u7f51\u683c\u5355\u5143\u7684\u6bd4\u4f8b\uff0c\u6211\u4eec\u7ed9\u8fd9\u4e9b\u7f51\u683c\u5355\u5143\u5206\u914d\u4e86\u4e00\u4e2a\u201c\u5173\u6ce8\u5206 (Concern Score)\u201d\u3002\u7136\u540e\u5c06\u6bcf\u4e2a\u7f51\u683c\u5355\u5143\u7684\u201c\u5173\u6ce8\u5206\u201d\u4e58\u4ee5\u4e0a\u4e2a\u6708\u5728\u8be5\u5355\u5143\u68c0\u6d4b\u5230\u7684\u8b66\u62a5\u6570\u3002\u7136\u540e\u4ece\u6bcf\u4e2a\u5927\u6d32\u9009\u53d6\u524d 10 \u4e2a\u7f51\u683c\u5355\u5143\u4f5c\u4e3a\u6f5c\u5728\u7684\u201c\u9700\u8981\u89c2\u5bdf\u7684\u5730\u65b9\u201d\u3002", "d9ce25858f8c557d97066d8ce3168944": "\u6839\u636e FAO \u7684\u6570\u636e\uff0c{year} \u5e74 {location} \u7684\u68ee\u6797\u780d\u4f10\u7387\u4e3a\u6bcf\u5e74 {rate}\uff0c\u5176\u4e2d\u6bcf\u5e74 {human} \u662f\u7531\u4eba\u7c7b\u6d3b\u52a8\u9020\u6210\u7684\u3002", "41fe5f8f18f8cb7dab130d50b629bfa7": "\u7ba1\u7406\u5730\u70b9\u548c\u5217\u8868", "c3ba1655c3b2253a757d9a5da484044e": "\u6c11\u95f4\u56e2\u4f53", "cae08d969e431c663b4dcdd407eeafb8": "GFW Pro \u7528\u6237\u7c7b\u578b\uff1a\u7ba1\u7406\u5458\u3001\u7f16\u8f91\u548c\u6d4f\u89c8\u8005", "e25fad5d80d2113df4f4009529671c11": "\u67d0\u4e2a\u6570\u636e\u96c6\u5728 GFW Data API \u4e2d\u7684\u552f\u4e00\u540d\u79f0\u3002", "a89c5f2262b2a6dd6ad043bc586094f2": "\u63a2\u7d22\u4ee5\u4e0b\u6750\u6599\uff0c\u4ece\u4e2d\u5b66\u4e60\u5982\u4f55\u5229\u7528 GFW \u6216 Forest Watcher \u76d1\u6d4b\u68ee\u6797\u53d8\u5316\u3002", "d9f23677eeba3a85f7c4dc72bd315304": "\u5c06\u5730\u70b9\u6dfb\u52a0\u5230\u65b0\u7684\u6216\u73b0\u6709\u7684\u5217\u8868\u4e2d\uff0c\u5c06\u60a8\u7684\u5217\u8868\u4fdd\u5b58\u4e3a\u8349\u7a3f\u6216\u63d0\u4ea4\u5206\u6790\u3002", "99dea78007133396a7b8ed70578ac6ae": "\u767b\u5f55", "b27eedc956335ed8d303a4be3c4d510c": "\u5b8c\u6210\u60a8\u6240\u9009\u62e9\u7684\u6a21\u677f", "75d94413693887a1ef15b8b170e769ac": "\u5982\u679c\u5217\u8868\u88ab\u63d0\u4ea4\u5206\u6790\uff0cPro \u5c06\u5bf9\u60a8\u6dfb\u52a0\u5230\u5217\u8868\u4e2d\u7684\u5730\u70b9\u8fdb\u884c\u5206\u6790\u3002\u60a8\u5c06\u88ab\u5bfc\u822a\u5230\u5730\u70b9\u7f51\u9875\uff0c\u5e76\u770b\u5230\u4e00\u6761\u6a2a\u5e45\u6d88\u606f\uff0c\u8868\u793a\u6b63\u5728\u5bf9\u60a8\u7684\u5217\u8868\u52a0\u4ee5\u5206\u6790\u3002\u5728\u5206\u6790\u5f00\u59cb\u4ee5\u53ca\u5206\u6790\u5b8c\u6210\u65f6\uff0c\u60a8\u4f1a\u6536\u5230\u4e00\u5c01\u7535\u5b50\u90ae\u4ef6\u3002\u5728\u5206\u6790\u5b8c\u6210\u4e4b\u524d\uff0c\u60a8\u5c06\u65e0\u6cd5\u8bbf\u95ee\u5df2\u63d0\u4ea4\u7684\u5217\u8868\u3002\u5728\u5206\u6790\u7ed3\u679c\u51fa\u6765\u540e\uff0c\u60a8\u53ef\u4ee5\u5728\u5730\u70b9\u7f51\u9875\u4e0a\u7684\u201c\u6211\u7684\u5217\u8868\u201d\u4e0b\u67e5\u770b\u5206\u6790\u7ed3\u679c\u3002\u66f4\u591a\u5173\u4e8e\u5206\u6790\u5730\u70b9\u548c\u5217\u8868\u65b9\u9762\u7684\u4fe1\u606f\uff0c\u8bf7\u53c2\u8003<a href=\"{{0}}\">\u6b64\u5904</a>\uff0c\u5173\u4e8e\u8fd1\u5b9e\u65f6\u76d1\u6d4b\u5730\u70b9\u7684\u4fe1\u606f\uff0c\u8bf7\u53c2\u8003<a href=\"{{1}}\">\u6b64\u5904</a>\u3002", "f7a84af2380de4bc924c0510e7265b2a": "\u60a8\u5c06\u88ab\u5e26\u5230\u4e00\u4e2a\u8868\u683c\u89c6\u56fe\u4e2d\uff0c\u5728\u6b64\u7f16\u8f91\u60a8\u6240\u9009\u62e9\u7684\u5730\u70b9\u3002\u60a8\u53ef\u4ee5\u7f16\u8f91\u5b83\u4eec\uff0c\u5177\u4f53\u505a\u6cd5\u662f\u70b9\u51fb\u94c5\u7b14\u56fe\u6807\u6240\u793a\u7684\u53ef\u7f16\u8f91\u5b57\u6bb5\uff0c\u66f4\u6539\u4fe1\u606f\uff0c\u7136\u540e\u70b9\u51fb\u201c\u66f4\u65b0\u201d\u3002\u5982\u679c\u6709\u9a8c\u8bc1\u9519\u8bef\uff0c\u5b83\u4eec\u5c06\u663e\u793a\u4e3a\u7ea2\u8272\uff0c\u5e76\u51fa\u73b0\u5728\u201c\u6709\u9519\u8bef\u7684\u5730\u70b9\u201d\u9009\u9879\u5361\u4e2d\u2014\u2014\u60a8\u53ef\u4ee5\u5c06\u9f20\u6807\u60ac\u505c\u5728\u5b83\u4eec\u4e0a\u9762\uff0c\u4ee5\u83b7\u5f97\u66f4\u591a\u4fe1\u606f\u3002\u5982\u679c\u60a8\u7684\u5217\u8868\u4e2d\u5b58\u5728\u9a8c\u8bc1\u9519\u8bef\uff0c\u201c\u66f4\u65b0\u201d\u56fe\u6807\u5c06\u663e\u793a\u4e3a\u7981\u7528\u72b6\u6001\u3002\u5982\u679c\u5217\u8868\u4e3a\u8349\u7a3f\u5f62\u5f0f\uff0c\u5728\u5217\u8868\u540d\u79f0\u65c1\u8fb9\u4f1a\u6709\u4e00\u4e2a\u8349\u7a3f\u56fe\u6807\u3002<img loading=\"lazy\" class=\"wp-image-12575\" style=\"width: 88px;\" src=\"{{0}}\" alt=\"\" width=\"88\" height=\"40\">", "ae978332fce2b4d306cb38e6b8813b2f": "2015 \u5e74\u7684 FAO \u6570\u636e\u663e\u793a\uff0c{location} \u5171\u6709 {extent} \u7684\u68ee\u6797\uff0c\u5360\u5168\u4e16\u754c\u7684 {primaryPercent}\u3002", "8c852851baee81d6fbb7a876f4961944": "\u82e5\u8981\u5206\u6790\u60a8\u7684\u5730\u70b9\uff0c\u60a8\u53ef\u4ee5\u65b0\u5efa\u4e00\u4e2a\u5217\u8868\u6216\u5c06\u5730\u70b9\u6dfb\u52a0\u5230\u73b0\u6709\u5217\u8868\u4e2d\u3002\u5728\u5c06\u5730\u70b9\u6dfb\u52a0\u73b0\u6709\u5217\u8868\u65f6\uff0c\u8be5\u5217\u8868\u5fc5\u987b\u91c7\u7528\u76f8\u540c\u7684\u5927\u5b97\u5546\u54c1\u6a21\u677f\u683c\u5f0f\uff0c\u6216\u5bf9\u4e8e\u901a\u7528\u5927\u5b97\u5546\u54c1\u6a21\u677f\uff0c\u91c7\u7528\u76f8\u540c\u5927\u5b97\u5546\u54c1\u7c7b\u578b\u548c\u5730\u70b9\u5206\u7c7b\u3002\u5982\u679c\u60a8\u5728\u4e0a\u4f20\u8fc7\u7a0b\u4e2d\u5411\u8fd4\u56de\u5230\u524d\u4e00\u4e2a\u6b65\u9aa4\uff0c\u8bf7\u70b9\u51fb\u5c4f\u5e55\u5de6\u4fa7\u60a8\u60f3\u8981\u8fd4\u56de\u7684\u6b65\u9aa4\u3002", "3444ed280ecf96d59d09da46d7b7fda6": "\u82e5\u8981\u5bf9\u5217\u8868\u89c6\u56fe\u4e2d\u6bcf\u4e00\u5217\u8fdb\u884c\u6392\u5e8f\uff0c\u8bf7\u70b9\u51fb\u5217\u5934\u3002\u518d\u6b21\u70b9\u51fb\u5217\u5934\uff0c\u53ef\u4ee5\u5728\u6570\u5b57\u4ece\u6700\u5c0f\u5230\u6700\u5927\u3001\u5b57\u6bcd\u4ece A \u5230 Z\u3001\u65e5\u671f\u4ece\u6700\u65e9\u5230\u6700\u665a\u4e4b\u95f4\u5207\u6362\u6392\u5e8f\u3002\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u5730\u56fe\u201d\uff0c\u53ef\u4ee5\u5728\u5730\u56fe\u89c6\u56fe\u4e0a\u67e5\u770b\u60a8\u7684\u5217\u8868\u5730\u70b9\u3002\u6392\u5e8f\u884c\u4e3a\u5bf9\u5df2\u5206\u6790\u5217\u8868\u548c\u8349\u7a3f\u5217\u8868\u90fd\u540c\u6837\u9002\u7528\u3002", "27bb9553eae27adf3832ee969f3e6abf": "\u4e00\u65e6\u586b\u5199\u5b8c\u6210\u4e86\u76f8\u5173\u4fe1\u606f\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u70b9\u51fb\u201c\u4fdd\u5b58\u4e3a\u8349\u7a3f\u201d\uff0c\u5c06\u60a8\u7684\u5730\u70b9\u6dfb\u52a0\u5230\u5217\u8868\u4e2d\uff0c\u5e76\u4fdd\u5b58\u8be5\u5217\u8868\u4ee5\u4fbf\u5c06\u6765\u5206\u6790\uff0c\u6216\u8005\u9009\u62e9\u70b9\u51fb\u201c\u63d0\u4ea4\u201d\uff0c\u5c06\u60a8\u7684\u5730\u70b9\u6dfb\u52a0\u5230\u5217\u8868\u4e2d\u5e76\u5bf9\u5217\u8868\u8fdb\u884c\u5206\u6790\u3002\u4ee5\u8349\u7a3f\u5f62\u5f0f\u4fdd\u5b58\u7684\u5217\u8868\uff0c\u53ef\u4ee5\u91cd\u65b0\u5ba1\u89c6\u5e76\u5bf9\u5176\u8fdb\u884c\u540e\u7eed\u6dfb\u52a0\u3001\u7f16\u8f91\u6216\u4fee\u6539\u64cd\u4f5c\uff0c\u7136\u540e\u518d\u63d0\u4ea4\u4f9b\u5206\u6790\u3002\u5982\u679c\u586b\u5199\u4e0d\u5f53\uff0c\u5c31\u4f1a\u663e\u793a\u51fa\u9519\u4fe1\u606f\uff0c\u6307\u51fa\u8be5\u5b57\u6bb5\u9700\u8981\u4fee\u6539\u3002", "328f264d9935b023f53bd3ac80401bf3": "<strong>\u5c06\u5730\u70b9\u590d\u5236\u5230\u5217\u8868\u4e2d\uff1a</strong> \u5c06\u5730\u70b9\u590d\u5236\u5230\u4e00\u4e2a\u73b0\u6709\u5217\u8868\u6216\u65b0\u5217\u8868\u4e2d\u3002\u8fd9\u4e9b\u5730\u70b9\u5c06\u4fdd\u7559\u5728\u539f\u5217\u8868\u4e2d\u3002\u60a8\u53ea\u80fd\u628a\u5730\u70b9\u590d\u5236\u5230\u5177\u6709\u76f8\u540c\u6a21\u677f\u7c7b\u578b\u7684\u5176\u4ed6\u5217\u8868\u4e2d\u3002\u5173\u4e8e\u5982\u4f55\u9009\u62e9\u6b63\u786e\u7684\u6a21\u677f\u7c7b\u578b\uff0c\u8bf7\u53c2\u89c1<a href=\"{{0}}\">\u6b64\u5904</a>\u3002", "c52105e38f2ab1ff97a142ecd30bf05c": "\u4e00\u65e6\u5217\u8868\u88ab\u63d0\u4ea4\u5206\u6790\uff0cPro \u5c06\u5bf9\u8be5\u5217\u8868\u91cd\u65b0\u8fdb\u884c\u5206\u6790\u3002\u60a8\u5c06\u88ab\u5bfc\u822a\u5230\u5730\u70b9\u7f51\u9875\uff0c\u5e76\u770b\u5230\u4e00\u6761\u6a2a\u5e45\u6d88\u606f\uff0c\u8868\u793a\u6b63\u5728\u5bf9\u60a8\u7684\u5217\u8868\u52a0\u4ee5\u5206\u6790\u3002\u5728\u5206\u6790\u5f00\u59cb\u4ee5\u53ca\u5206\u6790\u5b8c\u6210\u65f6\uff0c\u60a8\u4f1a\u6536\u5230\u4e00\u5c01\u7535\u5b50\u90ae\u4ef6\u3002\u60a8\u53ef\u4ee5\u5728\u5730\u70b9\u7f51\u9875\u4e0a\u7684\u201c\u6211\u7684\u5217\u8868\u201d\u4e0b\u67e5\u770b\u5206\u6790\u7ed3\u679c\u3002\u66f4\u591a\u5173\u4e8e\u5206\u6790\u5730\u70b9\u548c\u5217\u8868\u65b9\u9762\u7684\u4fe1\u606f\uff0c\u8bf7\u53c2\u8003\u6b64\u5904\uff0c\u5173\u4e8e\u8fd1\u5b9e\u65f6\u76d1\u6d4b\u5730\u70b9\u7684\u4fe1\u606f\uff0c\u8bf7\u53c2\u8003\u6b64\u5904\u3002", "8d22bde7f285f4c2578560fa12b85f6a": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4eba\u5de5\u6797\u573a\uff1a</a> World Resources Institute, Spatial Database of Planted Trees, version 1.0.<br><a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6811\u6728\u8986\u76d6\u635f\u5931\uff1a</a> Hansen/UMD/Google/USGS/NASA<br><a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u884c\u653f\u8fb9\u754c\uff1a</a> Global Administrative Areas database (GADM), version 3.6\u3002", "6e05cfde9ce29f35b8d6aa00c119103c": "\u4e86\u89e3\u66f4\u591a\u4fe1\u606f", "fd2f5e2e5b177ae898b7ea5385a6e2ce": "\u5728\u5927\u5b97\u5546\u54c1\u98ce\u9669\u5217\u8868\u89c6\u56fe\u4e2d\uff0c\u60a8\u53ef\u4ee5\u70b9\u51fb\u8868\u683c\u5de6\u4e0a\u65b9\u7684\u590d\u9009\u6846\uff0c\u5bf9\u5217\u8868\u4e2d\u7684\u6240\u6709\u5730\u70b9\u8fdb\u884c\u8bca\u65ad\uff0c\u6216\u8005\u70b9\u51fb\u5355\u4e2a\u5730\u70b9\u65c1\u8fb9\u7684\u590d\u9009\u6846\uff0c\u5bf9\u5217\u8868\u4e2d\u7684\u5355\u4e2a\u5730\u70b9\u8fdb\u884c\u8bca\u65ad\u3002\u542b\u6709\u5df2\u5206\u6790\u5730\u70b9\u7684\u8349\u7a3f\u5217\u8868\u4ec5\u53ef\u6267\u884c\u5730\u70b9\u7ea7\u8bca\u65ad\u3002", "cedab2c2cbf4f2011a4ef505645c88a3": "2001 \u5e74\uff0c\u5370\u5ea6\u5c3c\u897f\u4e9a\u7684\u539f\u59cb\u6797\u9762\u79ef\u4e3a 93.8Mha*\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684 50%\u3002{year} \u5e74\uff0c\u5b83\u635f\u5931\u4e86 270kha \u7684\u539f\u59cb\u6797*\uff0c\u76f8\u5f53\u4e8e 208Mt \u7684 CO\u2082 \u6392\u653e\u91cf\u3002 ", "9a42df194c02821349ad58d7ae0aadf6": "{location} \u7684\u7efc\u5408\u68ee\u6797\u780d\u4f10\u8b66\u62a5", "1f274a15679cb9dc6bfe36221f4354fb": "\u53d1\u8868\u8bc4\u8bba", "89839f2ee7d4e4a1e215670368c862d0": "{location} \u4e0e\u68ee\u6797\u76f8\u5173\u7684\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u91cf\uff08\u6309\u4e3b\u8981\u52a8\u56e0\u663e\u793a\uff09", "3acfb78f92ccea59991a7c2513f31187": "{location} \u706b\u70e7\u8ff9\u5730\u9762\u79ef\u6700\u5927\u7684\u533a\u57df", "8e5f36344b0ecbe455da0671ddd83670": "\u4ece {startYear} \u5230 {endYear} \u5e74\uff0c{location} {indicator} \u635f\u5931\u4e86 {loss} \u7684<b>\u6e7f\u6da6\u539f\u59cb\u6797</b>\uff0c\u5360\u5176\u540c\u671f {total tree cover loss} \u7684 {percent}\u3002\u5728\u6b64\u671f\u95f4\uff0c<b>{location} {indicator} \u7684\u6e7f\u6da6\u539f\u59cb\u6797\u603b\u9762\u79ef\u51cf\u5c11\u4e86</b> {extentDelta}\u3002", "d7bd362f3ea81919ed86f2d56764c78a": "\u6839\u636e\u6700\u8fd1 {timeframe} \u7684\u6570\u636e\u6765\u770b\uff0c<b>\u5168\u7403</b>\u5728 {indicator} \u5185\u706b\u70e7\u8ff9\u5730\u9762\u79ef\u6700 {significant} \u7684\u56fd\u5bb6\u662f {topRegion}\uff0c\u5171\u6709 {topRegionCount} \u571f\u5730\u9762\u79ef\u88ab\u706b\u70e7\u3002\u8fd9\u5360 {location} \u603b\u706b\u70e7\u8ff9\u5730\u9762\u79ef\u7684 {topRegionPerc}\uff0c\u4e0e <b>2001</b> \u5e74\u540c\u671f\u76f8\u6bd4\u5c5e\u4e8e {status} \u6c34\u5e73\u3002", "0d811d3b664d52eae9e73bec5612b26c": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">VIIRS \u706b\u707e\u6570\u636e\uff1a</a> NASA FIRMS, VIIRS alerts<br><a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">MODIS \u706b\u707e\u6570\u636e\uff1a</a> NASA FIRMS, MODIS alerts<br><a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u884c\u653f\u8fb9\u754c\uff1a</a> Global Administrative Areas database (GADM), version 3.6\u3002", "01c2ef228e050f1b82c78ef593843022": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6811\u6728\u8986\u76d6\u589e\u91cf\uff1a</a> Hansen/UMD/Google/USGS/NASA<br><a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u884c\u653f\u8fb9\u754c\uff1a</a> Global Administrative Areas database (GADM), version 3.6.", "99ef1c82bcc4b8379e7019b0b40d8054": "\u51c6\u5907\u7528\u4e8e\u4e0a\u4f20\u7684 KML/KMZ \u6587\u4ef6", "5e0af2c400e97bdf2339721b5eadc45d": "GFW Pro \u4e0a\u7684\u8fd1\u5b9e\u65f6\u76d1\u6d4b", "17177d28c2157dde28c22d748ada59e9": "\u5728 Pro \u4e0a\uff0c\u4e00\u65e6\u60a8\u4e0a\u4f20\u4e86\u4e00\u4e2a\u5217\u8868\uff0c\u5c31\u53ef\u4ee5\u901a\u8fc7\u5730\u70b9\u7f51\u9875\u8fdb\u4e00\u6b65\u7ba1\u7406\u548c\u7f16\u8f91\u8be5\u5217\u8868\u3002", "63614d2d3a059bfed6cca8642ec4d39a": "Pro \u63d0\u4f9b\u4e24\u7c7b\u5206\u6790\uff1a\u68ee\u6797\u53d8\u5316\u548c\u5927\u5b97\u5546\u54c1\u98ce\u9669\u3002", "3ea4895478e71048f106a2e7a0b905ab": "\u65e5\u671f\u8303\u56f4\uff0c\u4f7f\u7528\u4e4b\u524d\u786e\u5b9a\u7684\u5b57\u6bb5\u540d\u6765\u6307\u5b9a\u5f00\u59cb\u548c\u7ed3\u675f\u65e5\u671f\u3002<br>\u6ce8\u610f\uff0c\u6211\u4eec\u8981\u7ed9\u65e5\u671f\u52a0\u4e0a\u5355\u5f15\u53f7\u3002", "380b9c44c9ac7fd14ca4005042d02bfc": "\u8c01\u4f7f\u7528 GFW \u6216 Forest Watcher \u6765\u76d1\u6d4b\u68ee\u6797\u53d8\u5316\uff1f", "13876b5e6a4044b0bc5cb84f213407ad": "\u6d4f\u89c8\u7528\u6237\u6743\u9650\u7ea7\u522b", "c795ba097e1abe2150bae3dada850e40": "Pro \u4eea\u8868\u677f\u4f7f\u60a8\u80fd\u591f\u5bf9\u533a\u57df\u52a0\u4ee5\u6392\u5e8f\u3001\u5feb\u901f\u8bc6\u522b\u95ee\u9898\u533a\u57df\uff0c\u5e76\u76f4\u89c2\u5730\u663e\u793a\u4e0e\u60a8\u7684\u6570\u636e\u76f8\u5bf9\u5e94\u7684\u8b66\u62a5\u3002", "74bea8436cf0fc4d5137fbacd935916f": "\u65b0\u7684 GIS \u7528\u6237\u548c\u6709\u7ecf\u9a8c\u7684 GIS \u5206\u6790\u5458\u90fd\u5e94\u8be5\u8ba4\u771f\u9605\u8bfb\u8fd9\u4e9b\u6b65\u9aa4\uff0c\u4ee5\u5c3d\u91cf\u51cf\u5c11\u53ef\u80fd\u53d1\u751f\u7684 Pro \u6570\u636e\u4e0a\u4f20\u9519\u8bef\u3002", "ab856f32166cebee26bba58499ad4ba4": "\u5982\u679c\u5217\u8868\u88ab\u63d0\u4ea4\u5206\u6790\uff0cPro \u5c06\u5bf9\u60a8\u6dfb\u52a0\u5230\u5217\u8868\u4e2d\u7684\u5730\u70b9\u8fdb\u884c\u5206\u6790\u3002\u60a8\u5c06\u88ab\u5bfc\u822a\u5230\u5730\u70b9\u7f51\u9875\uff0c\u5e76\u770b\u5230\u4e00\u6761\u6a2a\u5e45\u6d88\u606f\uff0c\u8868\u793a\u6b63\u5728\u5bf9\u60a8\u7684\u5217\u8868\u52a0\u4ee5\u5206\u6790\u3002\u5728\u5206\u6790\u5f00\u59cb\u4ee5\u53ca\u5206\u6790\u5b8c\u6210\u65f6\uff0c\u60a8\u4f1a\u6536\u5230\u4e00\u5c01\u7535\u5b50\u90ae\u4ef6\u3002\u5728\u5206\u6790\u5b8c\u6210\u4e4b\u524d\uff0c\u60a8\u5c06\u65e0\u6cd5\u8bbf\u95ee\u5df2\u63d0\u4ea4\u7684\u5217\u8868\u3002\u5728\u5206\u6790\u7ed3\u679c\u51fa\u6765\u540e\uff0c\u60a8\u53ef\u4ee5\u5728\u5730\u70b9\u7f51\u9875\u4e0a\u7684\u201c\u6211\u7684\u5217\u8868\u201d\u4e0b\u67e5\u770b\u5206\u6790\u7ed3\u679c\u3002", "26e9054be7f40079575582b7ad3f7363": "\u8d44\u4ea7", "9da9e34aabc03992ea12462fccc14b5c": "\u6805\u683c\u74e6\u7247\u96c6<br>\u6805\u683c\u74e6\u7247\u7f13\u5b58<br>\u5730\u7406\u6570\u636e\u5e93\u8868\u683c<br>\u77e2\u91cf\u74e6\u7247\u7f13\u5b58", "47ab9c55a8c579d4bdf9cb82abb27d71": "\u4ec5\u5177\u5907\u7ba1\u7406\u5458\u7ea7\u522b\u6743\u9650\u7684\u7528\u6237\u80fd\u591f\u5728\u5185\u90e8\u5171\u4eab\u5217\u8868\u2014\u2014\u7f16\u8f91\u548c\u6d4f\u89c8\u8005\u53ef\u4ee5\u6536\u5230\u5171\u4eab\u7684\u5217\u8868\u3002", "629fd167c98b94755afc711c0d836c29": "\u5728\u4eea\u8868\u677f\u4e0a\u6807\u8bc6\u95ee\u9898\u533a\u57df", "2c1a9f00d2c4b8db622590e7da03bbb8": "\u6570\u636e\u96c6\u540d\u79f0", "779c69c34c32afc7f9a600ed801fd93d": "\u82e5\u8981\u4f7f\u7528 Pro\uff0c\u60a8\u9700\u8981\u9996\u5148\u521b\u5efa\u4e00\u4e2a\u8d26\u6237\uff0c\u7136\u540e\u5b66\u4e60\u5982\u4f55\u7ba1\u7406\u8be5\u8d26\u6237\u3002", "2157f35354ee982ccd433accaa5b59cd": "\u4e0a\u4f20\u5730\u70b9\u548c\u5217\u8868", "24e064b2f7b54922a6dbec773cd6c793": "\u8bf7\u6c42\u8bed\u53e5", "77ccf6419e271d50de7c68c73472a7cc": "POST \u8bf7\u6c42\u4f53\u5e94\u8be5\u91c7\u7528 JSON \u5bf9\u8c61\u683c\u5f0f\uff0c\u5176\u4e2d\u5305\u62ec\u4ee5\u4e0b\u4e24\u4e2a\u5c5e\u6027\uff1a<br><br><span style=\"text-decoration: underline;\">geometry</span>\uff1aGeoJSON \u683c\u5f0f\u51e0\u4f55\u56fe\u5f62\u3002\u8bbf\u95ee https://geojson.io \u4ee5\u4fbf\u8f7b\u677e\u5728\u5730\u56fe\u4e0a\u521b\u5efa GeoJSON \u683c\u5f0f\u51e0\u4f55\u56fe\u5f62\u3002<br><br><span style=\"text-decoration: underline;\">sql</span>\uff1a\u5bf9\u4e8e\u77e2\u91cf\u548c\u8868\u683c\u6570\u636e\u96c6\uff0c\u8fd9\u662f\u4e00\u4e2a\u6807\u51c6\u7684 SQL \u8bed\u53e5\u3002\u5bf9\u4e8e\u6805\u683c\u6570\u636e\u96c6\uff0c\u8fd9\u662f SQL \u7684\u4e00\u4e2a\u7279\u6b8a\u5b50\u65b9\u8a00\uff0c\u4ec5\u9650\u4e8e SELECT\u3001FROM\u3001WHERE \u548c GROUP BY \u5b50\u53e5\uff0c\u4ee5\u53ca SUM\u3001COUNT \u548c AVG \u805a\u5408\u51fd\u6570\u3002", "ac8a1f13acfac1a879368d5e3012c870": "\u4f53\u6570\u636e", "46fa09026243e1cfcb56d1ba81214112": "\u6211\u4eec\u611f\u5174\u8da3\u7684\u5b57\u6bb5\u3002<br>\u5728\u8fd9\u4e2a\u4f8b\u5b50\u4e2d\uff0c\u6211\u4eec\u53ef\u4ee5\u4f7f\u7528\u7279\u6b8a\u5b57\u6bb5 {{0}} \u548c {{1}} \u6765\u68c0\u7d22\u5750\u6807\u3002", "3549355ca7ddaf6376665b4ea883cf00": "\u5408\u4f5c\u65b9\u6750\u6599", "bf155df366fead17aa333008ef79f245": "\u5982\u4f55\u4f7f\u7528 GFW Pro \u4e2d\u7684 PALM \u98ce\u9669\u5de5\u5177", "e659d6147e5ef26183cf435d1959fe25": "\u6211\u4eec\u611f\u5174\u8da3\u7684\u5b57\u6bb5\u3002\u5728\u8fd9\u4e2a\u4f8b\u5b50\u4e2d\uff0c\u6211\u4eec\u53ef\u4ee5\u4f7f\u7528\u7279\u6b8a\u5b57\u6bb5 {{0}} \u548c\u805a\u5408\u51fd\u6570 {{1}} \u6765\u8fd4\u56de\u6797\u6728\u8986\u76d6\u635f\u5931\u603b\u9762\u79ef\u3002", "306e0553a25df5b8b3b8ce92c195a4b4": "\u635f\u5931\u5e74\u4efd\uff0c\u4f7f\u7528\u4e4b\u524d\u786e\u5b9a\u7684\u5b57\u6bb5\u540d\u6765\u6307\u5b9a\u5355\u4e00\u5e74\u4efd\u3002", "ef21c89a0625cd84ae30d1f3c8fc5401": "\u622a\u81f3 {year}\uff0c{location} \u6709 {percentage} \u7684\u6811\u6728\u8986\u76d6\u9762\u79ef\u5728 {indicator}\u3002", "69b7ffd47deb9e17f9675fcd23a2075c": "GLAD-L \u8b66\u62a5\u66f4\u65b0\u56e0\u7ef4\u62a4\u5df2\u6682\u505c\u3002\u8bf7\u901a\u8fc7<a href=\"{{0}}\" rel=\"noreferrer\" target=\"__BLANK\">\u8ba8\u8bba\u533a</a>\u4e86\u89e3\u6700\u65b0\u60c5\u51b5\uff0c\u5982\u6709\u7591\u95ee\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3 <a href=\"{{1}}\">gfw@wri.org</a>\u3002", "0a932ca42e8d1b453d168f4be217a1d7": "GLAD-L \u8b66\u62a5", "604f70daa7b9863f74cf781251eb6fe7": "\u62a5\u8b66\u7cfb\u7edf", "e19e9b89d7c2db20066ef7368140ca48": "\u8be5\u89c6\u9891\u6307\u5357\u521b\u5efa\u4e8e 2020 \u5e74 7 \u6708\uff0c\u65e8\u5728\u6f14\u793a\u5982\u4f55\u4f7f\u7528\u8b66\u62a5\u6570\u636e\u5728 GFW Pro \u5f00\u5c55\u8fd1\u5b9e\u65f6\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u76d1\u6d4b\u3002", "0c6937f5f19065a435323539f6b7e2f0": "\u4ece {startYear} \u5230 {endYear} \u5e74\uff0c{location} \u5728 {indicator} \u5185\u5171\u635f\u5931\u4e86 {loss} \u7684\u6811\u6728\u8986\u76d6\u9762\u79ef\uff0c\u76f8\u5f53\u4e8e\u6811\u6728\u8986\u76d6\u7387\u81ea {extentYear} \u5e74\u4ee5\u6765\u51cf\u5c11\u4e86 {percent} \u548c\u4ea7\u751f\u4e86 {emissions} \u7684 CO\u2082 \u6392\u653e\u91cf\u3002", "605a92e23dbaa3229e8c63acf95518c2": "<strong>\u5468</strong>\uff1a\u663e\u793a\u4e00\u5468\u4ee5\u6765\u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u3002\u6bcf\u5468\u8b66\u62a5\u6bcf\u516d\u5929\u66f4\u65b0\u4e00\u6b21\u3002", "8145c5b65e148eb0bf960d3575c73540": "\u5728\u7f51\u9875\u53f3\u4e0a\u65b9\u9009\u62e9\u60a8\u60f3\u8981\u7684\u65f6\u95f4\u8303\u56f4\uff0c\u53ef\u8c03\u6574\u6240\u9009\u8b66\u62a5\u5bf9\u5e94\u7684\u65f6\u95f4\u8303\u56f4\u3002\u975e\u8349\u7a3f\u5f62\u5f0f\u7684\u5217\u8868\u5c06\u5728\u591c\u95f4\u5f97\u5230\u5904\u7406\uff0c\u5e76\u4ee5\u6700\u65b0\u6570\u636e\u52a0\u4ee5\u66f4\u65b0\u3002", "47d2216c66a51695368b1a32e419679b": "\u8868\u571f\u6709\u673a\u78b3\u5bc6\u5ea6\uff08\u4ee5\u5428/\u516c\u9877\u4e3a\u5355\u4f4d\uff09\u662f\u5229\u7528\u78b3\u542b\u91cf\u767e\u5206\u6bd4\u3001\u4f53\u79ef\u5bc6\u5ea6\u548c\u783e\u77f3\u4f53\u79ef\u7684\u8f93\u5165\u503c\u8ba1\u7b97\u7684\u3002\u6211\u4eec\u4f7f\u7528\u76f8\u5bf9\u4f53\u79ef\u5bc6\u5ea6\u503c\uff0c\u4f46\u6697\u8272\u571f\u548c\u6709\u673a\u571f\u9664\u5916\uff0c\u5b83\u4eec\u6309\u8fd9\u79cd\u65b9\u6cd5\u5e38\u88ab\u9ad8\u4f30\u3002\u6570\u503c\u662f\u6309 0-30 \u5398\u7c73\u6df1\u5ea6\u8ba1\u7b97\u5f97\u51fa\u7684\u3002\u5173\u4e8e\u6839\u636e HWSD \u8ba1\u7b97 SOC \u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u89c1 Hiederer and K\u00f6chy 2011\u3002\u5173\u4e8e\u6839\u636e HWSD \u8ba1\u7b97 SOC \u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u89c1<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u3002", "61611389de588415c15c178ef34447af": "\u5206\u6790\u7ed3\u679c\u5c06\u51fa\u73b0\u5728\u5206\u6790/\u57fa\u56fe\u9762\u677f\u7684\u5206\u6790\u9009\u9879\u5361\u4e0a\u3002\u70b9\u51fb\u201c\u6dfb\u52a0\u65b0\u5730\u70b9\u201d\uff0c\u5c06\u5df2\u5206\u6790\u5730\u70b9\u6dfb\u52a0\u5230\u60a8\u7684 Pro \u8d26\u6237\u4e2d\u7684\u65b0\u5217\u8868\u3001\u73b0\u6709\u5217\u8868\u6216\u8349\u7a3f\u5217\u8868\u4e2d\u3002", "d557b3764d39e653ed04cc21ee61672d": "\u6392\u653e\u91cf\u3001\u6e05\u9664\u91cf\u3001\u51c0\u901a\u91cf\uff1a<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. 2021</a>", "5654726cee4b2931f7c8814263ce036f": "\u8be5\u5730\u533a\u7531\u4e0d\u540c\u7684\u751f\u5883\u6784\u6210\uff0c\u5305\u62ec {eco_0} \u548c {eco_1}\u3002\u8be5\u5730\u533a\u5b58\u5728\u4e00\u4e9b\u539f\u59cb\u68ee\u6797\u3002\u8be5\u5730\u533a\u6700\u5e38\u89c1\u7684\u73af\u5883\u6761\u4ef6\u662f {kop_0}\u3002\u8be5\u5730\u533a\u7531\u51e0\u79cd\u7c7b\u578b\u7684\u751f\u7269\u7fa4\u843d\u7ec4\u6210\uff0c\u5305\u62ec {bio_0} \u548c {bio_1}\u3002\u8be5\u5730\u4e3b\u8981\u662f {lsf_0}\u3002{area_1} \u6709 {area_0} \u7684\u9762\u79ef\u3002", "07280c47dba1d11dcf7981b49196ac45": "\u501f\u52a9 GFW Pro (Pro) \u5730\u56fe\uff0c\u60a8\u53ef\u4ee5\u5c06\u60a8\u4e0a\u4f20\u7684\u6570\u636e\u8fde\u540c GFW \u7684\u6570\u636e\u4e00\u8d77\u52a0\u4ee5\u53ef\u89c6\u5316\u548c\u5206\u6790\u5904\u7406\u3002\u4e0b\u9762\u7684\u6b65\u9aa4\u5c06\u6307\u5bfc\u60a8\u5982\u4f55\u67e5\u770b\u4e0a\u4f20\u7684\u5217\u8868\u3001\u6dfb\u52a0\u548c\u79fb\u9664\u6570\u636e\u5c42\u3001\u67e5\u770b\u4e0d\u540c\u7684\u57fa\u56fe\u3001\u5206\u6790\u67d0\u4e2a\u533a\u57df\u5185\u7684\u6570\u636e\uff0c\u4ee5\u53ca\u8c03\u6574\u5730\u56fe\u548c\u6570\u636e\u8bbe\u7f6e\u3002\u60a8\u53ef\u4ee5\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u8349\u7a3f\u5217\u8868\uff0c\u5373\u4f7f\u5b83\u4eec\u5305\u542b\u672a\u5206\u6790\u5730\u70b9\u4ea6\u53ef\u3002", "1ce8942750d9e79caccd48481d375e55": "\u8be5\u89c6\u9891\u6307\u5357\u521b\u5efa\u4e8e 2020 \u5e74 7 \u6708\uff0c\u65e8\u5728\u6f14\u793a\u5982\u4f55\u4f7f\u7528\u8be5\u5de5\u5177\u5bf9\u68d5\u6988\u6cb9\u4f9b\u5e94\u94fe\u4e2d\u7684\u9879\u76ee\u4e3e\u63aa\u8fdb\u884c\u5148\u540e\u6392\u5e8f\u3002", "b22009e226783f89eadcf07f6c064b57": "\u88ab\u5220\u9664\u7684\u5730\u70b9\u5c06\u4e0d\u518d\u51fa\u73b0\u5728\u5217\u8868\u89c6\u56fe\u4e2d\u3002\u5982\u679c\u5217\u8868\u8fd8\u4e0d\u662f\u8349\u7a3f\uff0c\u90a3\u4e48\u5b83\u5c06\u53d8\u6210\u8349\u7a3f\u5f62\u5f0f\u3002\u5728\u60a8\u4ece\u201c\u5730\u70b9\u201d\u9875\u9762\u70b9\u51fb\u201c\u63d0\u4ea4\u201d\u4e4b\u524d\uff0c\u8be5\u5217\u8868\u4e0d\u4f1a\u88ab\u63d0\u4ea4\u5206\u6790\u3002", "2e9c5ae921bbec51008d4d762e3cd49d": "\u70b9\u51fb\u5730\u70b9\u7f51\u9875\u4e0a\u201c\u6211\u7684\u5217\u8868\u201d\u4e0b\u7684\u5217\u8868\u3002\u70b9\u51fb\u60a8\u60f3\u590d\u5236\u7684\u884c\u65c1\u8fb9\u7684\u590d\u9009\u6846\uff0c\u9009\u62e9\u60a8\u60f3\u590d\u5236\u7684\u884c\u3002\u8fd9\u4e2a\u64cd\u4f5c\u5bf9\u8349\u7a3f\u5217\u8868\u6216\u5df2\u5206\u6790\u5217\u8868\u90fd\u9002\u7528\u3002", "ddd74cc17405e60200e08d0603efd95d": "\u7531\u4e8e\u4f7f\u7528\u9650\u5236\uff0cGFW\u7684\u201c\u53d7\u4fdd\u62a4\u533a\u57df\u201d\u548c\u201cRSPO \u68d5\u6988\u7279\u8bb8\u79cd\u690d\u533a\u57df\u201d\u5217\u8868\u548c\u5b50\u5217\u8868\u65e0\u6cd5\u4e0b\u8f7d\u3002\u201c\u884c\u653f\u533a\u57df\u201d\u5217\u8868\u5fc5\u987b\u7ecf\u7b5b\u9009\u540e\u624d\u80fd\u4e0b\u8f7d\u3002", "9040e5d5c22898b16805c36a619677d6": "\u6839\u636e FAO \u7684 2015 \u5e74\u68ee\u6797\u8d44\u6e90\u8bc4\u4f30\u62a5\u544a\uff0c\u663e\u793a\u68ee\u6797\u780d\u4f10\u7684\u9762\u79ef\u3002\u8fd9\u91cc\u7684\u68ee\u6797\u780d\u4f10\u662f\u6307\u5c06\u68ee\u6797\u6539\u6362\u4e3a\u5176\u4ed6\u571f\u5730\u7528\u9014\uff0c\u6216\u5c06\u6797\u51a0\u76d6\u5ea6\u6c38\u4e45\u6027\u5730\u964d\u4f4e\u5230 10% \u7684\u6700\u4f4e\u9650\u5ea6\u3002\u5173\u4e8e FAO \u548c GFW \u6570\u636e\u5dee\u5f02\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u89c1<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u3002", "0a6876df79de188ae68c848f9aba4a37": "\u68ee\u6797\u78b3\u6e05\u9664", "19c5552107ca4a546052e618781ecea8": "\u5728\u68ee\u6797\u53d8\u5316\u5217\u8868\u89c6\u56fe\u4e2d\uff0c\u60a8\u53ef\u4ee5\u70b9\u51fb\u8868\u683c\u5de6\u4e0a\u65b9\u7684\u590d\u9009\u6846\uff0c\u5bf9\u5217\u8868\u4e2d\u7684\u6240\u6709\u5730\u70b9\u8fdb\u884c\u8bca\u65ad\uff0c\u6216\u8005\u70b9\u51fb\u5355\u4e2a\u5730\u70b9\u65c1\u8fb9\u7684\u590d\u9009\u6846\uff0c\u5bf9\u5217\u8868\u4e2d\u7684\u5355\u4e2a\u5730\u70b9\u8fdb\u884c\u8bca\u65ad\u3002\u542b\u6709\u5df2\u5206\u6790\u5730\u70b9\u7684\u8349\u7a3f\u5217\u8868\u4ec5\u53ef\u6267\u884c\u5730\u70b9\u7ea7\u8bca\u65ad\u3002", "a115e7b9c81c4398202eb08e9ab9a8f9": "\u82e5\u8981\u5bf9\u5217\u8868\u89c6\u56fe\u4e2d\u6bcf\u4e00\u5217\u8fdb\u884c\u6392\u5e8f\uff0c\u8bf7\u70b9\u51fb\u5217\u5934\u3002\u518d\u6b21\u70b9\u51fb\u5217\u5934\uff0c\u53ef\u4ee5\u5728\u6570\u5b57\u4ece\u6700\u5c0f\u5230\u6700\u5927\u3001\u5b57\u6bcd\u4ece A \u5230 Z\u3001\u65e5\u671f\u4ece\u6700\u65e9\u5230\u6700\u665a\u4e4b\u95f4\u5207\u6362\u6392\u5e8f\u3002\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u5730\u56fe\u201d\uff0c\u53ef\u4ee5\u5728\u5730\u56fe\u89c6\u56fe\u4e0a\u67e5\u770b\u60a8\u7684\u5217\u8868\u5730\u70b9\u3002\u6392\u5e8f\u884c\u4e3a\u5bf9\u5df2\u53d1\u5e03\u5217\u8868\u548c\u8349\u7a3f\u5217\u8868\u90fd\u540c\u6837\u9002\u7528\u3002", "887fb97772320f5d8f4b79ca1bd73ed5": "{location} \u7684\u7efc\u5408\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u5730\u70b9", "88d8f2a436e91eb3930d64b086abb72c": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6811\u6728\u8986\u76d6\u635f\u5931\uff1a</a> Hansen/UMD/Google/USGS/NASA<br><a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u884c\u653f\u8fb9\u754c\uff1a</a> Global Administrative Areas database (GADM), version 3.6.", "d5a56c96969eece32b82953dd7b20207": "\u91cd\u65b0\u9020\u6797\u7684\u9762\u79ef\uff0c\u6839\u636e FAO 2015 \u5e74\u68ee\u6797\u8d44\u6e90\u8bc4\u4f30\u62a5\u544a\u3002\u91cd\u65b0\u9020\u6797\u662f\u6307\u5728\u88ab\u5f52\u7c7b\u4e3a\u68ee\u6797\u7684\u571f\u5730\u4e0a\u901a\u8fc7\u79cd\u690d\u548c/\u6216\u6709\u610f\u64ad\u79cd\u6765\u91cd\u5efa\u68ee\u6797\u3002\u5173\u4e8e FAO \u548c GFW \u6570\u636e\u5dee\u5f02\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u89c1<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u3002", "9fffe19b45efa25bf69431beb0837a9b": "\u9ed8\u8ba4\u60c5\u51b5\u4e0b\uff0c\u8be5\u8868\u683c\u5c06\u663e\u793a\u6709\u5173\u5730\u70b9\u5927\u5c0f\u3001\u5927\u5b97\u5546\u54c1\u7c7b\u578b\u3001\u5730\u7406\u4f4d\u7f6e\u548c\u5730\u70b9\u5185\u6797\u6728\u8986\u76d6\u8303\u56f4\u7b49\u4fe1\u606f\u3002\u5728\u6700\u53f3\u8fb9\uff0c\u8868\u683c\u8fd8\u5c06\u663e\u793a\u6709\u5173\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u4fe1\u606f\u2014\u2014\u60a8\u5c06\u770b\u5230 2000 \u5e74\u540e\u6797\u6728\u8986\u76d6\u635f\u5931\u603b\u91cf\uff0c\u7136\u540e\u662f\u53d1\u751f\u5728\u4fdd\u62a4\u533a\u548c\u539f\u59cb\u68ee\u6797\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u91cf\u3002\u5982\u679c\u5217\u8868\u662f\u8349\u7a3f\u5f62\u5f0f\uff0c\u90a3\u4e48\u5728\u6574\u4e2a\u5217\u8868\u63d0\u4ea4\u5206\u6790\u4e4b\u524d\uff0c\u5217\u8868\u4e2d\u672a\u5206\u6790\u7684\u5730\u70b9\u5c06\u4e0d\u4f1a\u5305\u62ec\u6240\u6709\u4fe1\u606f\u3002", "09ae94fae38f447427364f741f82f5b4": "\u5728 Pro \u4e0a\uff0c\u60a8\u53ef\u4ee5\u4ece\u60a8\u7684\u4f9b\u5e94\u94fe\u6216\u6295\u8d44\u4e2d\u5c06\u90a3\u4e9b\u60a8\u60f3\u8981\u957f\u671f\u76d1\u63a7\u6216\u5206\u6790\u7684\u5730\u70b9\u6dfb\u52a0\u8fdb\u53bb\u548c\u521b\u5efa\u5217\u8868\u3002", "dab853c4aae6720e72e1f0177728d3cb": "\u5f53\u60a8\u6536\u5230\u4e00\u4e2a\u5171\u4eab\u5217\u8868\u65f6\uff0c\u5728\u5730\u70b9\u7f51\u9875\u4e0a\u7684\u5217\u8868\u540d\u79f0\u65c1\u8fb9\u4f1a\u51fa\u73b0\u4e00\u4e2a\u5171\u4eab\u56fe\u6807\u3002\u5217\u8868\u63a5\u6536\u8005\u5c06\u83b7\u5f97\u5b8c\u6574\u7684\u5730\u70b9\u4fe1\u606f\u89c6\u56fe\uff0c\u4f46\u4e0d\u80fd\u5bf9\u5217\u8868\u52a0\u4ee5\u66f4\u65b0\u3001\u7f16\u8f91\u6216\u518d\u6b21\u5171\u4eab\u3002\u4e0d\u8fc7\uff0c\u63a5\u6536\u8005\u53ef\u4ee5\u4e0b\u8f7d\u5217\u8868\u7ed3\u679c\uff0c\u5e76\u5bfc\u51fa CSV \u6216 Shapefile \u5217\u8868\u6a21\u677f\u3002\u5982\u679c\u5217\u8868\u662f\u8349\u7a3f\u5f62\u5f0f\uff0c\u5217\u8868\u540d\u79f0\u65c1\u8fb9\u4f1a\u51fa\u73b0\u4e00\u4e2a\u8349\u7a3f\u56fe\u6807\u3002", "8eb852aeb40f6ff61af6b6fdd537442d": "\u5982\u679c\u62e5\u6709\u5217\u8868\u7684\u7528\u6237\u6267\u884c\u4e86\u66f4\u65b0\uff0c\u6216\u8005\u5c06\u8349\u7a3f\u5217\u8868\u63d0\u4ea4\u5206\u6790\uff0c\u90a3\u4e48\u5c06\u81ea\u52a8\u4e3a\u6240\u6709\u63a5\u6536\u8005\u66f4\u65b0\u8be5\u5217\u8868\u3002", "1420ff89fed5ac74b3a9d405907c0f7c": "\u5982\u679c\u6b63\u5728\u4e0b\u8f7d\u7684\u5217\u8868\u662f\u8349\u7a3f\u5f62\u5f0f\uff0c\u5e76\u4e14\u5305\u62ec\u672a\u5206\u6790\u5730\u70b9\uff0c\u90a3\u4e48\u5728\u5c06\u8be5\u5217\u8868\u91cd\u65b0\u4e0a\u4f20\u5e76\u63d0\u4ea4\u5206\u6790\u4e4b\u524d\uff0c\u4e0b\u8f7d\u7684\u6587\u4ef6\u4e2d\u4e0d\u4f1a\u63d0\u4f9b\u6240\u6709\u5c5e\u6027\u4fe1\u606f\u6216\u7ed3\u679c\u3002", "59852c72212b42e6a158d9f868162dc0": "\u65e0\u53ef\u7528\u6570\u636e<img class=\"message-icon\" alt=\"tree\" src=\"{{0}}\">", "4f2cf85b29dab9cb3782b4ccfb8ac4f5": "\u60a8\u53ef\u80fd\u60f3\u8981\u9605\u8bfb\u6211\u4eec\u7684<a href=\"{{0}}\" target=\"_blank\">\u9690\u79c1\u653f\u7b56</a>\uff0c\u5176\u4e2d\u63d0\u4f9b\u4e86\u5173\u4e8e\u6211\u4eec\u5982\u4f55\u4f7f\u7528\u4e2a\u4eba\u6570\u636e\u7684\u66f4\u591a\u4fe1\u606f\u3002", "c2bb6e982df19a0c88268de4c424db6b": "\u201c\u884c\u653f\u533a\u57df\u201d\u548c\u201c\u53d7\u4fdd\u62a4\u533a\u57df\u201d\u5217\u8868\u4f1a\u63d0\u793a\u60a8\u5148\u7b5b\u9009\u5730\u70b9\u7136\u540e\u624d\u80fd\u770b\u5230\u5217\u8868\u89c6\u56fe\u3002\u4e00\u65e6\u60a8\u5e94\u7528\u4e86\u7b5b\u9009\u6761\u4ef6\uff0c\u60a8\u5c06\u80fd\u591f\u67e5\u770b\u9884\u5148\u8ba1\u7b97\u7684\u5206\u6790\u7ed3\u679c\uff0c\u6216\u8005\u770b\u5230\u6240\u9009\u5730\u533a\u7684\u5730\u56fe\u89c6\u56fe\u3002\u60a8\u5fc5\u987b\u521b\u5efa\u4e00\u4e2a\u7b5b\u9009\u533a\u57df\u7684\u5b50\u5217\u8868\u6765\u67e5\u770b\u5217\u8868\u7ea7\u8bca\u65ad\u3002", "f7aa8f130b48abd548da952879a3d2c5": "\u6bcf\u4e2a\u5730\u70b9\u6216\u5730\u70b9\u5217\u8868\u5fc5\u987b\u9996\u5148\u4e0a\u4f20\u5e76\u63d0\u4ea4\u5206\u6790\u3002\u4e0a\u4f20\u5904\u7406\u65f6\u95f4\u53ef\u80fd\u9700\u8981\u957f\u8fbe 24 \u5c0f\u65f6\u3002\u5728\u5904\u7406\u5b8c\u6210\u4e4b\u524d\uff0c\u5217\u8868\u5c06\u4ee5\u201c\u6b63\u5728\u5206\u6790\u201d\u7684\u6807\u7b7e\u51fa\u73b0\u5728\u5730\u70b9\u7f51\u9875\u4e0a\uff0c\u5e76\u4e14\u4e0d\u80fd\u70b9\u51fb\u3002\u4e00\u65e6\u5904\u7406\u5f00\u59cb\u548c\u5b8c\u6210\uff0c\u60a8\u5c06\u6536\u5230\u4e00\u5c01\u786e\u8ba4\u7535\u5b50\u90ae\u4ef6\u3002\u5217\u8868\u7ea7\u8bca\u65ad\u4e0d\u9002\u7528\u4e8e\u8349\u7a3f\u5f62\u5f0f\u7684\u5217\u8868\u3002", "aca88b01625e537f32ddbe5cffcac453": "GFW Pro \u7528\u6237\u6559\u7a0b\u6700\u8fd1\u4e00\u6b21\u66f4\u65b0\u662f\u5728 2020 \u5e74 9 \u6708\uff0c\u65e8\u5728\u6f14\u793a\u5982\u4f55\u4f7f\u7528 GFW Pro \u5f00\u5c55\u4f9b\u5e94\u94fe\u76d1\u6d4b\u3002", "8ff2135590516e42b2d05199ce1c5272": "2010 \u5e74\uff0c\u5168\u4e16\u754c\u6811\u6728\u8986\u76d6\u9762\u79ef\u4e3a 3.92Gha\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684 30%\u3002{year} \u5e74\uff0c\u5b83\u635f\u5931\u4e86 25.8Mha \u7684\u6811\u6728\u8986\u76d6\u9762\u79ef\u3002", "76d3b970d496f9417dd158e98191543d": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4eba\u5de5\u6797\u573a\uff1a</a> World Resources Institute, Spatial Database of Planted Trees, version 1.0.<br><a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u884c\u653f\u8fb9\u754c\uff1a</a> Global Administrative Areas database (GADM), version 3.6", "2bf92bf708e74df5e7d0f346887f003c": "\u5bf9\u4e8e\u4ee5\u8349\u7a3f\u5f62\u5f0f\u4fdd\u5b58\u7684\u5217\u8868\u4f1a\u6709\u7279\u5b9a\u8003\u8651\u3002\u5217\u8868\u53ef\u4ee5\u8349\u7a3f\u5f62\u5f0f\u4fdd\u5b58\u81f3\u60a8\u7684 Pro \u8d26\u6237\u4ee5\u4f9b\u540e\u7eed\u6dfb\u52a0\u3001\u7f16\u8f91\u6216\u4fee\u6539\uff0c\u7136\u540e\u518d\u63d0\u4ea4\u5217\u8868\u4f9b\u5206\u6790\u3002", "d33d1029f8b0985e867094b395daaff2": "\u5bf9\u4e8e\u8349\u7a3f\u5217\u8868\uff0c\u53ea\u6709\u4ee5\u4e0b\u9009\u9879\u53ef\u7528\uff1a\u6620\u5c04\u3001\u4e0b\u8f7d\u3001\u5171\u4eab\uff08\u9488\u5bf9\u7ba1\u7406\u5458\uff09\u3001\u6dfb\u52a0\u5230\u6587\u4ef6\u5939\u3001\u5220\u9664\uff0c\u4ee5\u53ca\u63d0\u4ea4\uff08\u4f1a\u89e6\u53d1\u5bf9\u8be5\u5217\u8868\u7684\u5206\u6790\uff09\u3002", "6d7215c4b3bc4716d026ac46c6d9ae64": "\u56db\u6708", "1c92611f157907daa8056785e7a0da35": "\u70b9\u51fb\u201c\u786e\u8ba4\u201d\u3002\u8981\u5c06\u5217\u8868\u4fdd\u5b58\u4e3a\u8349\u7a3f\uff0c\u8bf7\u70b9\u51fb\u201c\u4fdd\u5b58\u4e3a\u8349\u7a3f\u201d\u3002\u5c06\u5217\u8868\u4fdd\u5b58\u4e3a\u8349\u7a3f\uff0c\u53ef\u4ee5\u8ba9\u60a8\u91cd\u65b0\u5ba1\u89c6\u8be5\u5217\u8868\u6216\u8fdb\u884c\u989d\u5916\u7684\u7f16\u8f91\uff0c\u7136\u540e\u518d\u63d0\u4ea4\u5206\u6790\u3002\u70b9\u51fb\u201c\u786e\u8ba4\u201d\u6216\u201c\u4fdd\u5b58\u4e3a\u8349\u7a3f\u201d\u540e\uff0c\u60a8\u5c06\u88ab\u5bfc\u822a\u5230\u5730\u70b9\u7f51\u9875\u3002", "c0abf4bbc513da562afa976ae3c60d95": "\u9009\u62e9\u5e76\u4e0b\u8f7d\u6a21\u677f\u540e\uff0c\u60a8\u9700\u8981\u5728 Excel \u4e0a\u586b\u5199\u5b8c\u6210\u6a21\u677f\uff0c\u7136\u540e\u518d\u4e0a\u4f20\u5230 Pro\u3002", "b0f377ffd98650a926713bb74df3422f": "\u8981\u628a\u5217\u8868\u4ece\u4e00\u4e2a\u6587\u4ef6\u5939\u79fb\u52a8\u5230\u53e6\u4e00\u4e2a\u6587\u4ef6\u5939\uff0c\u6216\u4ece\u4e00\u4e2a\u6587\u4ef6\u5939\u4e2d\u5220\u9664\u4e00\u4e2a\u5217\u8868\uff0c\u8bf7\u70b9\u51fb\u8be5\u6587\u4ef6\u5939\uff0c\u7136\u540e\u70b9\u51fb\u6587\u4ef6\u5939\u4e2d\u8be5\u5217\u8868\u65c1\u7684\u201c\u2026\u201d\u83dc\u5355\u5e76\u9009\u62e9\u201c\u7ba1\u7406\u201d\u3002\u5df2\u7ecf\u6dfb\u52a0\u5230\u6587\u4ef6\u5939\u4e2d\u7684\u8349\u7a3f\u5217\u8868\u5c06\u7528\u8349\u7a3f\u56fe\u6807\u8868\u793a\u3002<img src=\"{{0}}\" alt=\"\">", "eccb6e77517a2cce5de6b276dc95ff97": "\u5728 {startDate} \u548c {endDate} \u4e4b\u95f4\uff0c{indicator} \u5185 {location} \u62a5\u544a\u4e86 {total} \u6b21\u68ee\u6797\u780d\u4f10\u8b66\u62a5\uff0c\u603b\u9762\u79ef {totalArea}\uff0c\u5176\u4e2d {highConfPerc} \u662f\u7531\u5355\u4e2a\u7cfb\u7edf\u68c0\u6d4b\u5230\u7684\u9ad8\u7f6e\u4fe1\u5ea6\u8b66\u62a5\uff0c{highestConfPerc} \u662f\u7531\u591a\u4e2a\u7cfb\u7edf\u68c0\u6d4b\u5230\u7684\u8b66\u62a5\u3002", "320e5167774e08a5d42938a6d65b61fd": "\u60a8\u5c06\u88ab\u5e26\u5230\u8868\u683c\u89c6\u56fe\u6765\u7f16\u8f91\u60a8\u9009\u62e9\u7684\u4f4d\u7f6e\u3002\u60a8\u53ef\u4ee5\u6309\u7167\u4ee5\u4e0b\u64cd\u4f5c\u6765\u7f16\u8f91\u5b83\u4eec\uff1a\u70b9\u51fb\u94c5\u7b14\u56fe\u6807\u6807\u8bc6\u7684\u53ef\u7f16\u8f91\u5b57\u6bb5\uff0c\u66f4\u6539\u4fe1\u606f\uff0c\u7136\u540e\u70b9\u51fb\u201c\u66f4\u65b0\u201d\u3002\u5982\u679c\u5b58\u5728\u9a8c\u8bc1\u9519\u8bef\uff0c\u5b83\u4eec\u5c06\u663e\u793a\u4e3a\u7ea2\u8272\uff0c\u5e76\u51fa\u73b0\u5728\u201c\u6709\u9519\u8bef\u7684\u4f4d\u7f6e\u201d\u6807\u7b7e\u4e2d\u2014\u2014\u60a8\u53ef\u4ee5\u5c06\u9f20\u6807\u60ac\u505c\u5728\u8fd9\u4e9b\u4f4d\u7f6e\u4e0a\u6765\u83b7\u53d6\u66f4\u591a\u4fe1\u606f\u3002\u5982\u679c\u60a8\u7684\u5217\u8868\u4e2d\u5b58\u5728\u9a8c\u8bc1\u9519\u8bef\uff0c\u201c\u66f4\u65b0\u201d\u56fe\u6807\u5c06\u663e\u793a\u4e3a\u7981\u7528\u72b6\u6001\u3002\u5982\u679c\u5217\u8868\u4e3a\u8349\u7a3f\u5f62\u5f0f\uff0c\u90a3\u4e48\u5728\u5217\u8868\u540d\u79f0\u65c1\u8fb9\u5c06\u6709\u4e00\u4e2a\u8349\u7a3f\u56fe\u6807\u3002<img src=\"{{0}}\" alt=\"\">", "a236bfb28d805c5d74987a7cfcec0f00": "\u5728\u6700\u8fd1\u7684 {timeframe} \u6570\u636e\u4e2d\uff0c<b>\u5168\u7403</b>\u70e7\u6bc1\u9762\u79ef\u6700 {significant} \u7684\u56fd\u5bb6\u662f {topRegion}\uff0c{topRegionCount} \u7684\u571f\u5730\u88ab\u70e7\u6bc1\u3002\u8fd9\u76f8\u5f53\u4e8e {location} \u88ab\u70e7\u6bc1\u603b\u9762\u79ef\u7684 {topRegionPerc}\uff0c\u4e0e\u53ef\u8ffd\u6eaf\u5230<b>2001</b>\u5e74\u7684\u540c\u4e00\u65f6\u671f\u76f8\u6bd4\uff0c\u662f {status}\u3002", "4e5ae82779798d53862f1a208f26467c": "\u4e16\u754c\u91ce\u751f\u52a8\u7269\u4fdd\u62a4\u534f\u4f1a (Global Wildlife Conservation) \u4e0e\u5c3c\u52a0\u62c9\u74dc\u7684 Rama \u548c Kriol \u793e\u533a\u5408\u4f5c\uff0c\u521b\u5efa\u4e86\u4e00\u4e2a\u65b0\u7684\u539f\u4f4f\u6c11\u62a4\u6797\u5458\u9879\u76ee\uff0c\u4ee5\u4fdd\u62a4 Indio-Mai\u2026\u2026", "1a7046a18b5d1fe6b81f6328d99ac98e": "Durrell Wildlife Conservation Trust  \u4f7f\u7528 GFW \u7684\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u4f5c\u4e3a\u9a6c\u8fbe\u52a0\u65af\u52a0 Menabe-Antimena \u4fdd\u62a4\u533a\u8fd1\u671f\u68ee\u6797\u707e\u96be\u6027\u635f\u5931\u7684\u8bc1\u636e\u3002\u2026\u2026", "20f8c3cbbfc87e6971edc21dd7f82f0d": "\u5728 {startDate} \u548c {endDate} \u4e4b\u95f4\uff0c{location} \u62a5\u544a\u4e86 {total} \u6b21\u68ee\u6797\u780d\u4f10\u8b66\u62a5\uff0c\u603b\u9762\u79ef {totalArea}\uff0c\u5176\u4e2d {highConfPerc} \u662f\u7531\u5355\u4e2a\u7cfb\u7edf\u68c0\u6d4b\u5230\u7684\u9ad8\u7f6e\u4fe1\u5ea6\u8b66\u62a5\uff0c{highestConfPerc} \u662f\u7531\u591a\u4e2a\u7cfb\u7edf\u68c0\u6d4b\u5230\u7684\u8b66\u62a5\u3002", "5779077b2907306aa66fabd6968717f8": "2010 \u5e74\uff0c\u59d4\u5185\u745e\u62c9\u62e5\u6709 57.3Mha \u7684\u5929\u7136\u6797\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684 63%\u3002\u5728 {year} \u5e74\uff0c\u5b83\u635f\u5931\u4e86 139kha \u7684\u5929\u7136\u6797\uff0c\u76f8\u5f53\u4e8e 71.4Mt \u7684 CO\u2082 \u6392\u653e\u91cf\u3002", "b6659c81bbf6620e13666041c4139fcf": "{latestYear} \u5e74\uff0c\u8fc4\u4eca\u4e3a\u6b62\uff0c\u5728 {location}\uff0c{indicator} \u5185 {area} \u7684\u571f\u5730\u5df2\u7ecf\u70e7\u6bc1\u3002\u4e0e\u53ef\u8ffd\u6eaf\u5230 {dataset_start_year} \u7684\u524d\u4e9b\u5e74\u76f8\u6bd4\uff0c\u8fd9\u4e2a\u603b\u91cf{status}\u3002\u4e00\u5e74\u4e2d\u706b\u707e\u8bb0\u5f55\u6700\u591a\u7684\u662f {maxYear} \u5e74\uff0c\u6709 {maxArea}\u3002", "d938986e1a35109aab3f8e6318403804": "\u5728 GFW \u7684\u8d44\u91d1\u548c\u6280\u672f\u652f\u6301\u4e0b\uff0c\u4e16\u754c\u5404\u5730\u7684\u7ec4\u7ec7\u548c\u4e2a\u4eba\u6b63\u5728\u4f7f\u7528 Global Forest Watch \u76d1\u6d4b\u5927\u89c4\u6a21\u7684\u571f\u5730\u4f7f\u7528\u9879\u76ee\u3001\u6267\u884c\u793e\u533a\u571f\u5730\u6743\u5229\u3001\u634d\u536b\u5173\u952e\u6816\u606f\u5730\u5e76\u5f71\u54cd\u68ee\u6797\u653f\u7b56\u3002", "e9f802f6a29612929368f5013c59f18c": "\u5728 {start_date} \u548c {end_date} \u4e4b\u95f4\uff0c{location} \u5171\u53d1\u751f\u4e86 {total_alerts} \u6b21 {dataset} \u706b\u707e\u8b66\u62a5\u3002", "84a198f19f901232c62a0c492f4ba4a6": "\u7531\u5355\u4e2a\u8b66\u62a5\u7cfb\u7edf\u68c0\u6d4b\u5230", "bd543569bcd53936e6546ffdca3768b2": "\u5982\u679c\u8be5\u5730\u70b9\u56e0\u4e3a\u5927\u8c46\u800c\u780d\u4f10\u68ee\u6797\u6216\u79cd\u690d\u5927\u8c46\uff0c\u90a3\u4e48\u5b83\u53ef\u80fd\u4e0d\u7b26\u5408\u516c\u53f8\u5bf9\u4e8e\u4e0d\u780d\u4f10\u68ee\u6797\u627f\u8bfa\u3002", "7aa82f837101081443b46cc7bf3a63d0": "\u201c\u635f\u5931\u201d\u662f\u6307\u6811\u6728\u8986\u76d6\u7684\u79fb\u9664\u6216\u6b7b\u4ea1\uff0c\u53ef\u80fd\u7531\u591a\u79cd\u56e0\u7d20\u9020\u6210\uff0c\u5305\u62ec\u673a\u68b0\u91c7\u4f10\u3001\u706b\u707e\u3001\u75be\u75c5\u6216\u98ce\u66b4\u6bc1\u574f\u3002\u56e0\u6b64\uff0c\u201c\u635f\u5931\u201d\u5e76\u4e0d\u7b49\u540c\u4e8e\u68ee\u6797\u780d\u4f10\u3002", "3f8cfb0419c9c51607b3c4bfb35c96f1": "\u73af\u5883\u6743\u5229\u884c\u52a8\u7ec4\u7ec7 (ERA) \u548c\u5c3c\u65e5\u5229\u4e9a\u5730\u7403\u4e4b\u53cb\u7ec4\u7ec7 (FoE) \u81f4\u529b\u4e8e\u589e\u5f3a\u5c3c\u65e5\u5229\u4e9a\u5357\u90e8\u57c3\u591a\u5dde\u5f53\u5730\u793e\u533a\u7684\u529b\u91cf\uff0c\u5021\u5bfc\u53cd\u5bf9\u571f\u5730\u63a0\u593a\u2026\u2026", "88391efc2ea9845267a812da16bf1098": "\u9700\u8981\u89c2\u5bdf\u7684\u5730\u65b9", "9659d581c008b911ecd6ea1761c3a810": "GLAD-L \u8b66\u62a5<span class=\"citation\">8 \u5929\uff0c30m\uff0c\u70ed\u5e26\u5730\u533a\uff0cUMD/GLAD</span><svg class=\"c-icon icon-arrow \" viewBox=\"0 0 32 32\"><use xlink:href=\"#arrow-down-394c3635--sprite\"></use></svg>", "05367b65ba53445ce278943b8a42c91c": "\u6574\u5408\u5c42\u4e2d\u7684\u6bcf\u4e2a\u50cf\u7d20\u90fd\u4fdd\u7559\u4e86\u4efb\u4f55\u8b66\u62a5\u7cfb\u7edf\u7684\u6700\u65e9\u68c0\u6d4b\u65e5\u671f\uff0c\u5373\u4f7f\u591a\u4e2a\u7cfb\u7edf\u90fd\u62a5\u544a\u4e86\u8be5\u50cf\u7d20\u7684\u8b66\u62a5\u3002\u5728\u67d0\u4e9b\u60c5\u51b5\u4e0b\uff0c\u5f53\u4ece\u6574\u5408\u5c42\u5207\u6362\u5230\u5355\u4e2a\u8b66\u62a5\u7cfb\u7edf\u5c42\u65f6\uff0c\u8fd9\u53ef\u80fd\u5bfc\u81f4\u53ef\u89c6\u5316\u754c\u9762\u7684\u4e0d\u4e00\u81f4\u3002\u5f53\u60a8\u5bf9\u4efb\u4f55\u8b66\u62a5\u7cfb\u7edf\u7684\u6700\u65e9\u68c0\u6d4b\u65e5\u671f\u611f\u5174\u8da3\u65f6\uff0c\u5efa\u8bae\u60a8\u5728\u6574\u5408\u5c42\u4e2d\u4f7f\u7528\u3002\u4f46\u662f\uff0c\u5982\u679c\u60a8\u5bf9\u7279\u5b9a\u7684\u8b66\u62a5\u7c7b\u578b\u611f\u5174\u8da3\uff0c\u90a3\u4e48\u6700\u597d\u4f7f\u7528\u5355\u4e2a\u8b66\u62a5\u7cfb\u7edf\u5c42\u3002", "1c830c92fac642d3cb76d8ac45a9bade": "<strong>\u4e2d\u975e\uff1a</strong> \u5e03\u9686\u8fea\u3001\u5580\u9ea6\u9686\u3001\u4e2d\u975e\u5171\u548c\u56fd\u3001\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u3001\u8d64\u9053\u51e0\u5185\u4e9a\u3001\u52a0\u84ec\u3001\u521a\u679c\u5171\u548c\u56fd\u3001\u5362\u65fa\u8fbe\u3001\u4e4c\u5e72\u8fbe", "88abdd5cdf1fd2fb5be1014baba32f5e": "GLAD-S2 \u8b66\u62a5<span class=\"citation\">5 \u5929\uff0c10m\uff0c\u4e9a\u9a6c\u900a\uff0cUMD/GLAD</span><svg class=\"c-icon icon-arrow \" viewBox=\"0 0 32 32\"><use xlink:href=\"#arrow-down-394c3635--sprite\"></use></svg>", "f6fe88d7214181448dae7c2f70f9709e": "GLAD-L/GLAD-S2/RADD \u7684\u6574\u5408\u5c42\u3002\u6570\u636e\u6765\u81ea UMD \u548c WUR\u3002GLAD-L \u8b66\u62a5\u91cd\u65b0\u91c7\u6837\uff0c\u4ece 30m \u5230 10m\u3002", "016c82271f6bda6d0b247c209f067d79": "\u6cb9\u68d5", "0d649daa98d3d26140e218205dab262d": "2000/2010, Hansen/UMD/Google/USGS/NASA", "6d0dd7c87e6ad3391eb7a4d91bf1e2bf": "\u663e\u793a\u9009\u5b9a\u5730\u533a\u7684\u539f\u59cb\u68ee\u6797\u635f\u5931\u7a0b\u5ea6\u3002\u8fd9\u4e2a\u5206\u6790\u4ec5\u8003\u8651\u4e0e\u6811\u6728\u8986\u76d6\u91cd\u53e0\u7684\u539f\u59cb\u68ee\u6797\u533a\u57df\u3002", "a97388680980911918711c109c78c2d7": "\u6e90\u8b66\u62a5\u7cfb\u7edf\u7684\u6570\u636e\u6765\u81ea\u4e0d\u540c\u5149\u8c31\u548c\u7a7a\u95f4\u5206\u8fa8\u7387\u7684\u536b\u661f\u300230m <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">GLAD \u57fa\u4e8e Landsat \u7684\u8b66\u62a5</a>\u88ab\u4e0a\u91c7\u6837\uff0c\u4ee5\u5339\u914d\u57fa\u4e8e Sentinel \u7684\u8b66\u62a5\u7684 10m \u7a7a\u95f4\u5206\u8fa8\u7387\uff08<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">GLAD-S2</a>\uff0c<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">RADD</a>\uff09\u3002\u8fd9\u907f\u514d\u4e86\u5bf9\u91cd\u53e0\u8b66\u62a5\u7684\u91cd\u590d\u8ba1\u7b97\uff0c\u800c\u662f\u5c06\u5176\u5f52\u7c7b\u4e3a\u66f4\u9ad8\u7684\u7f6e\u4fe1\u5ea6\uff0c\u7528\u989c\u8272\u8f83\u6df1\u7684\u50cf\u7d20\u8868\u793a\u3002", "b4007a3f30fd921013e7f12f2e56806c": "\u793e\u533a\u571f\u5730 - \u4e0d\u88ab\u653f\u5e9c\u627f\u8ba4", "949c5a6a5184bbc8c4deec5d12ea1ac7": "\u5e74\u4efd\u8303\u56f4", "a281587674b0010ca74d6105130dd85e": "\u2022 \u8fd9\u662f\u4e00\u4e2a\u7531\u4e09\u4e2a\u6570\u636e\u96c6\u7ec4\u6210\u7684\u590d\u5408\u5c42\uff0c\u6bcf\u4e2a\u6570\u636e\u96c6\u90fd\u6709\u81ea\u5df1\u7684\u65b9\u6cd5\u548c\u4f18\u7f3a\u70b9\u3002\u8bf7\u53c2\u8003\u6bcf\u4e2a\u6570\u636e\u96c6\u7684\u539f\u59cb\u51fa\u7248\u7269\uff0c\u4e86\u89e3\u6709\u5173\u6bcf\u4e2a\u6570\u636e\u96c6\u5177\u4f53\u6ce8\u610f\u4e8b\u9879\u7684\u66f4\u591a\u4fe1\u606f\u3002<br>\u2022 \u6240\u6709\u4e09\u4e2a\u8f93\u5165\u5c42\u90fd\u662f\u7531\u77e2\u91cf\u6570\u636e\u8f6c\u6362\u800c\u6765\uff0c\u6216\u8005\u4ece\u8f83\u7c97\u7cd9\u7684\u6805\u683c\u6570\u636e\u91cd\u65b0\u53d6\u6837\u3002", "4c2d6e7b378dcac6b7e5032f86b0b9ca": "\u539f\u4f4f\u6c11\u571f\u5730 - \u653f\u5e9c\u627f\u8ba4", "049a4cf0e5f44b17b6487fee42223379": "\u6cb9\u68d5\u6df7\u5408", "6d4afad9e56dda9d83eb01b6449366d9": "\uff0830m\uff0c\u5168\u7403\uff0c\u591a\u4e2a\u6765\u6e90\uff09", "c1f9fc529bdd326bb7ef9d8134a190f2": "\u5b89\u5361\u62c9\u51e1\u5179\u5361\u56fd\u5bb6\u516c\u56ed\u4fdd\u62a4\u7740\u4e00\u7247\u5e72\u65f1\u68ee\u6797\u7eff\u6d32\uff0c\u4e3a\u6781\u5ea6\u6fd2\u5371\u7684\u72d0\u733f\u548c\u5176\u4ed6\u91ce\u751f\u52a8\u7269\u63d0\u4f9b\u4e86\u91cd\u8981\u7684\u6816\u606f\u5730\u3002\u6700\u8fd1\u7684\u706b\u707e\u8086\u8650\u2026\u2026", "e535746a88eb7375d05ffe45824393c5": "\u536b\u661f\u56fe\u50cf\u663e\u793a\uff0c\u54e5\u4f26\u6bd4\u4e9a\u4e9a\u9a6c\u900a\u5730\u533a\u7684\u4e00\u7cfb\u5217\u9053\u8def\u6b63\u5728\u7a7f\u8fc7\u56fd\u5bb6\u516c\u56ed\u548c\u4e00\u4e2a\u539f\u4f4f\u6c11\u4fdd\u62a4\u533a\u3002", "3addd9980c375ea8240bba37036dd05a": "\u68d5\u6988\u6cb9\u5de5\u5382 - 2020", "b36fc5182c2496da830bf6efb735177b": "\uff08\u6c47\uff09", "a788717cf88a576b7973186345ca2d60": "\u6bcf\u5e74\u4e24\u6b21\uff0c\u5168\u7403\uff0c\u56fd\u9645\u9e1f\u76df", "49b1a5e1eb37b4eca6c0fc1d8f31ebb6": "\u8ba1\u7b97\u6cdb\u70ed\u5e26\u5730\u533a\u7684\u539f\u59cb\u68ee\u6797\u635f\u5931\u91cf\u3002", "b0ec357d3ef284a71b13caeef0c4efd0": "\u68ee\u6797\u78b3\u6392\u653e", "8dc9ce7fcf38a020cace9f810ce51ee2": "\u6d88\u606f\u4eba\u58eb\u79f0\uff0c\u5bf9 Guajar\u00e1-Mirim \u5dde\u7acb\u516c\u56ed\u7684\u5165\u4fb5\u4ecd\u5728\u7ee7\u7eed\uff0c\u5e76\u4e14\u6b63\u5728\u9010\u6b65\u63a5\u8fd1\u8106\u5f31\u7684\u539f\u4f4f\u6c11\u548c\u4f20\u7edf\u793e\u533a\u2026\u2026", "4a0880f98159ee457d487851e267dcb4": "\u88ab\u5265\u593a\u4e86\u4fdd\u62a4\u70b9\u7684\u9a6c\u6765\u897f\u4e9a\u68ee\u6797\u7684\u547d\u8fd0\u9762\u4e34\u7740\u4fdd\u62a4\u98ce\u9669", "7cb1c084fafe0c0882df26dfb2d3534e": "\u73af\u4fdd\u4eba\u58eb\u8bf4\uff0cTerra do Meio \u751f\u6001\u7ad9\u5185\u7684\u7834\u574f\u662f\u7531\u975e\u6cd5\u4f10\u6728\u8005\u3001\u7267\u573a\u4e3b\u548c\u571f\u5730\u6295\u673a\u8005\u7684\u8702\u62e5\u800c\u81f3\u9020\u6210\u7684\u2026\u2026", "f8de681dd980bc91fba61be6bb124992": "\u8001\u864e\u4fdd\u62a4\u533a\u6816\u606f\u5730 (Tiger Conservation Landscapes) - 2007-2011", "197ab8de60a9b93bf5287344512c2b8f": "ESA/UCLouvain, 2015", "133fd724de5cf7a0bdcfc27e1f10194a": "\uff08\u6bcf\u6708\uff0c500m\uff0c\u5168\u7403\uff0cNASA\uff09", "7d0a8a61aa072b72fa4941495c82cef8": "\u8fd9\u7bc7\u6587\u7ae0\u6709 {commentCount} \u6761\u8bc4\u8bba", "cc48e98f18a6cecf90b57375621a4492": "\u5728 {start_date} \u548c {end_date} \u4e4b\u95f4\uff0c{indicator} \u5185\u62a5\u544a\u4e86 {count} \u6b21 {dataset} \u706b\u707e\u8b66\u62a5\u3002\u4e0e\u53ef\u8ffd\u6eaf\u5230{dataset_start_year} \u7684\u524d\u4e9b\u5e74\u76f8\u6bd4\uff0c\u8fd9 {status}\u3002", "d7160c363b0db85d8af4987f0ee5eaea": "\u751f\u7269\u91cf\u5bc6\u5ea6\u503c\u5355\u4e2a\u50cf\u7d20\u5177\u6709\u5f88\u5927\u7684\u4e0d\u786e\u5b9a\u6027\u3002\u5355\u4e2a\u50cf\u7d20\u7684\u6570\u503c\u9884\u8ba1\u4f1a\u4e0e\u5b9e\u5730\u6d4b\u91cf\u5730\u5757\u7684\u751f\u7269\u91cf\u4f30\u8ba1\u503c\u4e0d\u540c\u3002", "720f67e9a1ccff9b551ee7cddd7dea53": "\u622a\u81f3 2016 \u5e74\uff0c{indicator} \u4e2d {location} \u6811\u6728\u8986\u76d6\u9762\u79ef\u7684 {percentage} \u4e3a<b>\u539f\u59cb\u68ee\u6797</b>\u3002", "4c929725b30204262d4df76b871cb040": "\u793e\u533a\u571f\u5730 - \u653f\u5e9c\u627f\u8ba4", "302bc30e36ed6951d711950efa4d47c1": "RADD \u8b66\u62a5<span class=\"citation\">\u6bcf 6-12 \u5929\uff0c10m\uff0c\u6f6e\u6e7f\u70ed\u5e26\u5730\u533a\uff0cWUR</span><svg class=\"c-icon icon-arrow \" viewBox=\"0 0 32 32\"><use xlink:href=\"#arrow-down-394c3635--sprite\"></use></svg>", "9135563dda4d5b0ecf6c6328cc77d06b": "\u68d5\u6988\u6cb9\u5de5\u5382", "e2d011dad88e095cfb06932d699cc614": "Unilever \u4f7f\u7528 GFW \u7684 PALM \u98ce\u9669\u5de5\u5177\u6765\u786e\u5b9a\u5176\u4f9b\u5e94\u94fe\u4e2d 29 \u5bb6\u9ad8\u98ce\u9669\u68d5\u6988\u6cb9\u5de5\u5382\uff0c\u73b0\u5728\u4ed6\u4eec\u53ef\u4ee5\u53c2\u4e0e\u5176\u4e2d\uff0c\u4ee5\u51cf\u5c11\u68ee\u6797\u780d\u4f10\u5e76\u91c7\u7528\u66f4\u52a0\u53ef\u6301\u7eed\u7684\u63aa\u65bd\u2026\u2026", "2e7acc3b22cccf20865ae0e4bbef94c6": "landsat 8 / sentinel 2<button class=\"c-button theme-button-tiny theme-button-grey-filled square info-btn\"><div class=\"button-wrapper\"><svg class=\"c-icon \" viewBox=\"0 0 18 32\"><use xlink:href=\"#info-1622ac34--sprite\"></use></svg></div></button>", "f6b6f568909e73c629aad51473e08252": "Mongabay \u62a5\u544a", "5b615f852c527a809aeb171e439118d8": "\u6700\u9ad8\u7f6e\u4fe1\u5ea6\uff1a\u7531\u591a\u4e2a\u8b66\u62a5\u7cfb\u7edf\u68c0\u6d4b\u5230", "aa0a1256728c0c5fc4f80c2cdb9bae6c": "WRI \u5c3d\u4e00\u5207\u52aa\u529b\u786e\u4fdd\uff0c\u4f5c\u4e3a\u201c\u9700\u8981\u89c2\u5bdf\u7684\u5730\u65b9\u201d\u7684\u4e00\u90e8\u5206\uff0c\u6240\u53d1\u5e03\u7684\u4fe1\u606f\u662f\u51c6\u786e\u7684\uff0c\u4f46\u6709\u4e9b\u4fe1\u606f\u6765\u81ea\u4e8e\u5b9e\u5730\u5408\u4f5c\u4f19\u4f34\u7684\u884c\u52a8\u7f51\u7edc\uff0cWRI \u65e0\u6cd5\u6838\u5b9e\u3002\u5982\u679c\u60a8\u53d1\u73b0\u4efb\u4f55\u4e0d\u51c6\u786e\u7684\u5730\u65b9\uff0c\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u7ed9\u6211\u4eec\uff1a<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">PlacestoWatch@wri.org</a>\u3002", "5ffcba74b7218d5d5ccf812bce0b6ca8": "\u9ad8\u5b8c\u6574\u6027", "0f8f2653a17c55246783130c8b49d995": "\u5982\u679c\u8be5\u5730\u70b9\u56e0\u4e3a\u6cb9\u68d5\u800c\u780d\u4f10\u68ee\u6797\u6216\u79cd\u690d\u6cb9\u68d5\uff0c\u90a3\u4e48\u5b83\u53ef\u80fd\u4e0d\u7b26\u5408\u516c\u53f8\u5bf9\u4e8e\u4e0d\u780d\u4f10\u68ee\u6797\u627f\u8bfa\u3002", "4367d3a6a939c8bafcbfcf9d659c37a5": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4f10\u6728\u9053\u8def</a>\u5021\u8bae\u548c<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">OpenStreetMap</a>\u3002", "7d205a105699cab9d0a10cf4e74b4185": "\u9ad8\u7f6e\u4fe1\u5ea6\uff1a\u7531\u5355\u4e2a\u8b66\u62a5\u7cfb\u7edf\u591a\u6b21\u68c0\u6d4b\u5230", "b1ce5bde02dc0e905baf2b6aa777e229": "\u68ee\u6797\u666f\u89c2\u5b8c\u6574\u6027\u6307\u6570", "54fe2ff142a0ad20ca80a5ccb45ba4db": "\u6b64\u6570\u636e\u96c6\u4f7f\u7528\u4e09\u4e2a\u4e0d\u540c\u7684\u5c42\u52fe\u753b\u4e86\u5168\u7403\u6ce5\u70ad\u5730\u548c\u5176\u4ed6\u6709\u673a\u571f\u58e4\u3002Miettinen et al. 2016 \u88ab\u7528\u4e8e\u5370\u5ea6\u5c3c\u897f\u4e9a\u548c\u9a6c\u6765\u897f\u4e9a\uff0cGumbrect et al. 2017 \u88ab\u7528\u4e8e\u5317\u7eac 40 \u5ea6\u548c\u5357\u7eac 60 \u5ea6\uff08\u6574\u4e2a\u5357\u534a\u7403\uff09\u4e4b\u95f4\u7684\u6240\u6709\u5176\u5b83\u571f\u5730\uff0cHengl et al. 2017 (SoilGrids250 available in 2021) \u88ab\u7528\u4e8e\u5317\u7eac 40 \u5ea6\u4ee5\u5317\u7684\u6240\u6709\u571f\u5730\u3002\u6765\u81ea Miettinen et al. 2016 \u7684\u6570\u636e\u88ab\u6805\u683c\u5316\u4e3a\u7ea6 30x30m \u7684\u5206\u8fa8\u7387\uff0c\u6765\u81ea Gumbricht et al. 2017 \u548c Poggio et al. 2021 \u7684\u6570\u636e\u88ab\u4ece\u5176\u539f\u59cb\u5206\u8fa8\u7387\u91cd\u65b0\u53d6\u6837\u6210\u7ea6 30x30m \u7684\u5206\u8fa8\u7387\u3002\u6765\u81ea Poggio et al. 2021 \u7684\u50cf\u7d20\uff0c\u5176\u571f\u58e4\u7c7b\u578b\u6700\u6709\u53ef\u80fd\u662f\u6709\u673a\u571f\uff0c\u88ab\u5305\u62ec\u5728\u8fd9\u4e2a\u6ce5\u70ad\u5c42\u4e2d\u3002\u8fd9\u4e09\u4e2a\u6570\u636e\u6e90\u90fd\u6709\u4e0d\u540c\u7684\u6ce5\u70ad\u5730\u52fe\u753b\u65b9\u6cd5\uff0c\u5728\u5176\u539f\u59cb\u51fa\u7248\u7269\u4e2d\u8fdb\u884c\u4e86\u63cf\u8ff0\u3002", "9d9b07fd08cbe5362dbc274c8caf4898": "\u5168\u7403\u7ea2\u6811\u6797\u89c2\u5bdf", "6c119fc5ca889b900f86d674b2cb74c6": "\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8fd9\u91cc</a>\u767b\u8bb0\u4ee5\u4fbf\u5728\u60a8\u7684\u7535\u5b50\u90ae\u7bb1\u4e2d\u6536\u5230\u5173\u4e8e\u201c\u9700\u8981\u89c2\u5bdf\u7684\u5730\u65b9\u201d\u7684\u6bcf\u4e00\u6b21\u7b56\u5212\uff0c\u5e76\u4f7f\u7528 #PlacestoWatch \u6807\u7b7e\u5728\u793e\u4ea4\u5a92\u4f53\u4e0a\u5206\u4eab\u8fd9\u4e9b\u5730\u65b9\uff01", "9d1781d89ab4a23730709170043a5b88": "\u6a61\u80f6\u6df7\u5408", "b9d0d37fd53700cbd87a802ca17db7b3": "\u968f\u7740\u5df4\u897f\u4e9a\u9a6c\u900a\u5730\u533a\u7267\u725b\u4e1a\u7684\u53d1\u5c55\uff0c\u201c\u7316\u7357\u7684\u68ee\u6797\u7834\u574f\u201d\u6467\u6bc1\u4e86\u4fdd\u62a4\u533a", "23a320752ae72bdb44306b6097f22b15": "\u9a6c\u8fbe\u52a0\u65af\u52a0\u56fd\u5bb6\u516c\u56ed\u201c\u53f2\u65e0\u524d\u4f8b\u201d\u7684\u706b\u707e\u5a01\u80c1\u7740\u5c45\u6c11\u751f\u8ba1\u548c\u72d0\u733f", "6070081e9a57a362ee5c6c390cdcd104": "RTRS \u5173\u4e8e\u8d1f\u8d23\u4efb\u5927\u8c46\u6269\u5f20\u7684\u6307\u5357 - 2015", "096e801e89c294583741b5b7d03109e9": "\u76d1\u6d4b\u68ee\u6797\u6270\u52a8\u8b66\u62a5\uff0c\u6574\u5408\u4e86\u6765\u81ea\u4e09\u4e2a\u536b\u661f\u6e90\u8fd1\u4e4e\u5b9e\u65f6\u7684\u6570\u636e", "d793a92a2fb8aae1db684d1064901f0e": "\u539f\u4f4f\u6c11\u56e2\u4f53\u547c\u5401\u653f\u5e9c\u5e72\u9884\uff0c\u56e0\u4e3a\u571f\u5730\u4fb5\u5360\u8005\u5165\u4fb5\u4e86\u73bb\u5229\u7ef4\u4e9a\u7684\u4fdd\u62a4\u533a", "fb2f6a5644b442aaf1c9e4abeb9ac529": "\u5730\u4e0a\u751f\u7269\u91cf\u5728\u4f4e\u503c\u65f6\u53ef\u80fd\u88ab\u9ad8\u4f30\uff0c\u5728\u9ad8\u503c\u65f6\u53ef\u80fd\u88ab\u4f4e\u4f30\u3002", "531d3a73ddc7d57db38947aa6b434790": "\u5929\u7136\u6797\u518d\u751f\u7684\u6f5c\u5728\u78b3\u56fa\u5b58\u901f\u7387", "c1601dfe36d540feb339c1d5c24f297b": "Bajo Paragu\u00e1 \u7684\u5c45\u6c11\u62a5\u544a\uff0c\u65b0\u7684 San Ignacio de Velasco \u5e02\u4fdd\u62a4\u533a\u5185\u51fa\u73b0\u4e86\u5165\u4fb5\u548c\u4eba\u7c7b\u5b9a\u5c45\u70b9\uff0c\u58f0\u79f0\u2026\u2026", "2e2aaa8eaead209e2ee4b03692308655": "\u751f\u7269\u591a\u6837\u6027\u7684\u610f\u4e49 - 2019", "2c320676d6bd45344b0f68a35f94c66c": "\u91c7\u77ff\u7279\u8bb8\u6743 -  2021", "8c84c981fa1a56dd1864168000d9af04": "\uff08\u6e90\uff09", "d2a3ee5dd5d0c7e9f7610c0e9d654511": "\u4ec5\u9650\u975e\u5546\u4e1a\u7528\u9014", "c33c3ae6e268c05a23ba85bea0495aa7": "RSPO \u6cb9\u68d5\u7279\u8bb8\u6743 - 2019", "afa0690804c9a3b144197e912462cf64": "\u8fb9\u754c\u6765\u81ea\u5404\u79cd\u6765\u6e90\uff0c\u5177\u6709\u4e0d\u540c\u7684\u51c6\u786e\u6027\u3001\u6700\u65b0\u6027\u548c\u5206\u8fa8\u7387\u3002\u4e00\u4e9b\u56fd\u5bb6\u7684\u6570\u636e\u53ef\u80fd\u4e0d\u51c6\u786e\uff0c\u9057\u6f0f\u4e86\u4e00\u4e9b\u4fdd\u62a4\u533a\uff0c\u6216\u5305\u62ec\u4e86\u5df2\u88ab\u53d6\u6d88\u7684\u8fb9\u754c\u3002", "321a34557da9b43fef387b223699ef72": "\u6fd2\u5371\u7684\u9ed1\u7329\u7329\u201c\u6fd2\u4e34\u706d\u7edd\u201d\u662f\u56e0\u4e3a\u5c3c\u65e5\u5229\u4e9a\u7684\u4fdd\u62a4\u533a\u7531\u4e8e\u519c\u4e1a\u548c\u6728\u6750\u800c\u88ab\u5937\u4e3a\u5e73\u5730", "a459cf0001b2b991ec890ebb9160ef74": "\u5df4\u5e03\u4e9a\u65b0\u51e0\u5185\u4e9a\u65b0\u4e0d\u5217\u98a0\u5c9b\u4e0a\u4f10\u6728\u9053\u8def\u6cbf\u7ebf\u68ee\u6797\u780d\u4f10\u52a0\u5267", "0bfec926e3558ab2a5016330ef8f91fb": "\u67d4\u4f5b\u5dde\u7684 Jemaluang \u548c Tenggaroh \u68ee\u6797\u81ea\u4ece\u88ab\u5265\u593a\u4e86\u2026\u2026\u7684\u4e03\u5e74\u4ee5\u6765\u906d\u9047\u4e86\u5927\u89c4\u6a21\u7684\u68ee\u6797\u780d\u4f10", "9233588e5a56643232b9375c57623a65": "\u672a\u77e5\u6df7\u5408", "26706a74b37a9d6820c6f523a61fd9da": "<strong>\u4e1c\u5357\u4e9a\uff1a</strong>\u6587\u83b1\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u3001\u9a6c\u6765\u897f\u4e9a\u3001\u5df4\u5e03\u4e9a\u65b0\u51e0\u5185\u4e9a\u3001\u4e1c\u5e1d\u6c76", "f0f8b8fa907d08a4df101df5aa06d6e8": "\u968f\u7740\u6e90\u6570\u636e\u7684\u66f4\u65b0\uff0c\u7f6e\u4fe1\u5ea6\u53ef\u80fd\u4f1a\u53d1\u751f\u8ffd\u6eaf\u6027\u66f4\u6539", "56fa782b443404476393682353681ca3": "30m\uff0c\u5168\u7403\uff0c\u591a\u4e2a\u6765\u6e90", "3ddef4bccd1e72535f49f0279c9812ca": "\u4f7f\u7528\u8fd9\u4e2a 30 \u5904\u5730\u65b9\u7684\u5217\u8868\uff0cGFW \u4e13\u5bb6\u5bf9\u6240\u6709 30 \u4e2a\u5730\u65b9\u8fdb\u884c\u5ba1\u67e5\uff0c\u6839\u636e\u5bf9\u536b\u661f\u56fe\u50cf\u7684\u8bc4\u4f30\u3001\u80cc\u666f\u4fe1\u606f\u548c\u4ed6\u4eec\u81ea\u5df1\u7684\u4e13\u4e1a\u77e5\u8bc6\uff0c\u6765\u786e\u5b9a\u6700\u503c\u5f97\u5173\u6ce8\u7684\u533a\u57df\u3002\u7136\u540e\uff0cGFW \u56e2\u961f\u4ece\u5408\u4f5c\u4f19\u4f34\u7ec4\u6210\u7684\u201c\u884c\u52a8\u7f51\u7edc\u201d\u4e2d\u83b7\u53d6\u66f4\u591a\u4fe1\u606f\uff0c\u8fd9\u4e9b\u5408\u4f5c\u4f19\u4f34\u5bf9\u8fd9\u4e9b\u5730\u65b9\u53d1\u751f\u7684\u4e8b\u60c5\u53ef\u80fd\u6709\u8fdb\u4e00\u6b65\u7684\u8be6\u7ec6\u4fe1\u606f\u3002\u4fe1\u606f\u6536\u96c6\u5b8c\u6bd5\u540e\uff0cGFW \u901a\u8fc7\u6bcf\u6708\u535a\u5ba2\u3001\u65b0\u95fb\u901a\u8baf\u4ee5\u53ca GFW \u5e73\u53f0\u4e0e\u5168\u4e16\u754c\u5206\u4eab\u8fd9\u4e9b\u201c\u9700\u8981\u89c2\u5bdf\u7684\u5730\u65b9\u201d\u3002\u5982\u9700\u8fdb\u4e00\u6b65\u4e86\u89e3\u786e\u5b9a\u201c\u9700\u8981\u89c2\u5bdf\u7684\u5730\u65b9\u201d\u7684\u65b9\u6cd5\u548c\u7b56\u5212\u8fc7\u7a0b\uff0c\u8bf7\u53c2\u9605\u6b64\u5904\uff1ahttps://www.wri.org/publication/places-to-watch\u3002", "c968fe9c276889c62303c3cebd36bdbd": "\u5927\u8c46", "ba022c36a2547440c111f64a1c208456": "\u6bcf\u5e74, 30m, \u6cdb\u70ed\u5e26, Hansen/UMD", "687f85854b05132384f0cbac6cd014d4": "\u6574\u5408\u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5<span class=\"citation\">GLAD-L/GLAD-S2/RADD \u6574\u5408\u5c42\u3002\u6570\u636e\u6765\u81ea UMD \u548c WUR\u3002GLAD-L \u8b66\u62a5\u91cd\u65b0\u91c7\u6837\uff0c\u4ece 30m \u5230 10m\u3002</span><svg class=\"c-icon icon-arrow \" viewBox=\"0 0 32 32\"><use xlink:href=\"#arrow-down-394c3635--sprite\"></use></svg>", "8624862964e8a204e69492213ffd8d5e": "GLAD-L\uff1a\u8b66\u62a5\u66f4\u65b0\u5728 2021 \u5e74 12 \u6708\u540e\u6682\u505c\u3002\u901a\u8fc7<a href=\"{{0}}\" rel=\"noreferrer\" target=\"__BLANK\">\u8fd9\u7bc7\u8bba\u575b\u8ba8\u8bba\u5e16</a>\u4e86\u89e3\u6700\u65b0\u60c5\u51b5\u3002<br><br>RADD\uff1a\u7531\u4e8e\u536b\u661f\u6545\u969c\uff0c\u76ee\u524d\u8b66\u62a5\u9891\u7387\u6709\u6240\u964d\u4f4e\u3002\u901a\u8fc7<a href=\"{{1}}\" rel=\"noreferrer\" target=\"__BLANK\">\u8fd9\u7bc7\u8bba\u575b\u8ba8\u8bba\u5e16</a>\u4e86\u89e3\u6700\u65b0\u60c5\u51b5\u3002", "90773992583ed97a8c11643627a216ef": "\u4ec5\u8003\u8651<b>