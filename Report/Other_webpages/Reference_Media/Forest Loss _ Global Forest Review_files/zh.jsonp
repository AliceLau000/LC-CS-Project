" rel=\"noopener noreferrer\">GLAD</a>\uff08\u5168\u7403\u571f\u5730\u5206\u6790\u4e0e\u53d1\u73b0\uff09\u5b9e\u9a8c\u5ba4\u521b\u5efa\u5e76\u7531Global Forest Watch\u4e88\u4ee5\u652f\u6301\uff0c\u662f\u7b2c\u4e00\u4e2a\u7528\u4e8e\u68c0\u6d4b\u6797\u6728\u8986\u76d6\u635f\u5931\u7684Landsat\u536b\u661f\u9884\u8b66\u7cfb\u7edf\u3002\u867d\u7136\u5927\u591a\u6570\u73b0\u6709\u635f\u5931\u9884\u8b66\u4ea7\u54c1\u4f7f\u7528250\u7c73\u5206\u8fa8\u7387MODIS\u56fe\u50cf\uff0c\u4f46\u8fd9\u4e9b\u9884\u8b66\u5177\u670930\u7c73\u5206\u8fa8\u7387\uff0c\u56e0\u6b64\u53ef\u4ee5\u5728\u66f4\u7cbe\u7ec6\u7684\u7a7a\u95f4\u5c3a\u5ea6\u4e0a\u68c0\u6d4b\u635f\u5931\u3002\u8fd9\u4e9b\u9884\u8b66\u7684\u5206\u8fa8\u7387\u4e3a30\u7c73\uff0c\u9002\u7528\u4e8e\u5357\u5317\u7eac30\u5ea6\u4e4b\u95f4\u7684\u9646\u5730\u533a\u57df\u3002", "88d0fb2041844f0e19ecea5e949c4e03": "\u57fa\u4e8eSentinel-1\u4e91\u5c42\u7a7f\u900f\u96f7\u8fbe\u4f20\u611f\u5668\u7684\u70ed\u5e26\u539f\u59cb\u6e7f\u6da6\u68ee\u6797\u8fd1\u5b9e\u65f6\u68ee\u6797\u5e72\u6270\u9884\u8b66", "b7b5583391b46d45079058959561c91e": "\u975e\u6d32\uff1a2019\u5e741\u6708\u81f3\u4eca<br>\u5357\u7f8e\u3001\u4e2d\u7f8e\u548c\u4e1c\u5357\u4e9a\uff1a2020\u5e741\u6708\u81f3\u4eca", "eef14230382a491358d89cb87b160cb8": "\u5357\u7f8e\u6d32\u3001\u4e2d\u7f8e\u6d32\u3001\u6492\u54c8\u62c9\u4ee5\u5357\u975e\u6d32\u548c\u4e1c\u5357\u4e9a\u5c9b\u5c7f\u7684\u6f6e\u6e7f\u70ed\u5e26\u68ee\u6797\uff08\u52302023\u5e74\u5e95\u5c06\u6269\u5c55\u5230\u4e1c\u5357\u4e9a\u5927\u9646\u548c\u592a\u5e73\u6d0b\uff09", "7f9a7fde819d42aa85f6dff092289cf1": "\u7531\u4e8e\u4f7f\u7528\u77ed\u6ce2C\u6ce2\u6bb5\u96f7\u8fbe\u76f8\u5bf9\u5bb9\u6613\u63a2\u6d4b\u5230\u68ee\u6797\u8fb9\u7f18\uff0c\u56e0\u6b64\u901a\u5e38\u53ef\u4ee5\u53ca\u65f6\u63a2\u6d4b\u5230\u5c0f\u89c4\u6a21\u53d8\u5316(\u4f8b\u5982\u4f10\u6728\u9053\u8def\u3001\u5c0f\u89c4\u6a21\u519c\u4e1a)\u3002\u5927\u89c4\u6a21\u7684\u5730\u5757\uff08\u4f8b\u5982\uff0c\u79cd\u690d\u56ed\u6269\u5f20\uff09\u53ef\u80fd\u9700\u8981\u66f4\u957f\u7684\u65f6\u95f4\u624d\u80fd\u8fbe\u5230\u8db3\u591f\u9ad8\u7684\u6982\u7387\u6765\u6807\u8bb0\u4e3a\u9884\u8b66\u3002\u7531\u4e8e\u571f\u58e4\u6f6e\u6e7f\u6216\u6b8b\u7559\u7684\u6728\u8d28\u788e\u7247\u7b49\u6761\u4ef6\uff0c\u8fd9\u4e9b\u5927\u7247\u7684\u5730\u5757\u5728\u96f7\u8fbe\u56fe\u50cf\u4e2d\u53ef\u80fd\u770b\u8d77\u6765\u4e0e\u672a\u53d7\u5e72\u6270\u7684\u68ee\u6797\u76f8\u4f3c\u3002", "d559e05f7f6495cf510c5cbf869e389e": "<button role=\"switch\" aria-label=\"toggle\" aria-checked=\"true\" class=\"c-toggle -active toggle-large\"></button>\u5c06\u6b64\u533a\u57df\u8bbe\u4e3a\u516c\u5f00", "308aad5843462f6b0d7dbe791a03ba75": "\u5206\u4eab\u6b64\u533a\u57df", "8c2dcf451731a2b6f402411c1ff59c90": "\u5176\u4ed6\u5173\u6ce8\u533a\u57df\u6216\u5730\u533a", "4f26a9fddb7e690b27fb80baf9a3f836": "\u60a8\u662f\u5426\u613f\u610f\u5e2e\u52a9\u6211\u4eec\u6d4b\u8bd5\u65b0\u7684\u5e94\u7528\u529f\u80fd\uff1f", "978f638fc46501f496e9641acae46359": "<span></span>\u5176\u4ed6", "a1e14995ee2efdfec2d465009e91c30d": "\u5f53\u7f29\u5c0f\u65f6\uff0c\u8be5\u6570\u636e\u5c42\u663e\u793a\u51fa\u4e00\u5b9a\u7a0b\u5ea6\u7684\u4e0d\u51c6\u786e\u6027\uff0c\u8fd9\u662f\u56e0\u4e3a\u6570\u636e\u70b9\u5fc5\u987b\u6298\u53e0\u624d\u80fd\u5728\u66f4\u5927\u7684\u5c3a\u5ea6\u5185\u53ef\u89c1\u3002\u653e\u5927\u67e5\u770b\u66f4\u591a\u7ec6\u8282\u3002", "b19cd460563f4974725cc8a310a71069": "RADD\u9884\u8b66\u4e4b\u6240\u4ee5\u6210\u4e3a\u53ef\u80fd\uff0c\u8981\u5f52\u529f\u4e8e<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u753110\u4e2a\u4e3b\u8981\u68d5\u6988\u6cb9\u751f\u4ea7\u5546\u548c\u4e70\u5bb6</a>\u7ec4\u6210\u7684\u8054\u76df\u7684\u652f\u6301\u3002\u5728\u8be5\u9879\u76ee\u4e0b\uff0c\u74e6\u8d6b\u5b81\u6839\u5927\u5b66\u548c\u7814\u7a76\u4e2d\u5fc3\uff08WUR\uff09\u5f00\u53d1\u4e86\u63a2\u6d4b\u65b9\u6cd5\uff0cSatelligence\u9996\u5148\u5728\u5370\u5ea6\u5c3c\u897f\u4e9a\u548c\u9a6c\u6765\u897f\u4e9a\u6269\u5c55\u4e86\u8be5\u7cfb\u7edf\uff0c\u5e76\u4e3a\u73b0\u573a\u8ddf\u8fdb\u63d0\u4f9b\u4e86\u989d\u5916\u7684\u8b66\u62a5\u4f18\u5148\u6392\u5e8f\u3002\u7f8e\u56fd\u6797\u52a1\u5c40\u548c\u632a\u5a01\u56fd\u9645\u6c14\u5019\u4e0e\u68ee\u6797\u5021\u8bae\u63d0\u4f9b\u4e86\u989d\u5916\u7684\u652f\u6301\u3002\u9884\u8b66\u76ee\u524d\u7531WUR\u4f7f\u7528Google Earth Engine\u8fd0\u4f5c\u3002", "7b2a041ce6fd10ffcf0be7c78f6079fe": "10\u670811\u65e5 - 11\u670810\u65e5\uff0c\u53d1\u5e03\u4e8e2017\u5e7412\u670813\u65e5", "5fe425cedf727f75e01723cbb0e39651": "\u6570\u636e\u53ef\u7528\u6027\u53d7\u9650", "45226858c1db66a149e869633adf1afb": "\u7ed3\u679c\u4e0d\u5e94\u5728\u56fd\u5bb6\u4e4b\u95f4\u76f4\u63a5\u6bd4\u8f83", "7d05062e49feee714153f6dd0f580f1a": "<svg class=\"c-icon \" viewBox=\"0 0 32 32\"><use xlink:href=\"#edit-97ec94d3--sprite\"></use></svg>\u7f16\u8f91\u533a\u57df", "cf72d58f4f13fe062c8f06aa98681e4b": "<span></span>\u76d1\u63a7\u6216\u7ba1\u7406\u4e00\u4e2a\u533a\u57df", "bfa499b24da365b7539ce34150ef9bdb": "<span></span>\u4e86\u89e3\u68ee\u6797/\u6211\u7684\u56fd\u5bb6", "39c43e7a37b3e69ab4f27f65e7dc4b3c": "<span></span>\u4e3a\u62e8\u6b3e\u51b3\u5b9a/\u57fa\u4e8e\u7ed3\u679c\u7684\u4ed8\u6b3e\u63d0\u4f9b\u4fe1\u606f", "85821da0a90fad21c71991cdc7fbc725": "<span></span>\u8bc6\u522b\u975e\u6cd5\u6d3b\u52a8", "4868aa9d084f86c0c00a685011c7b998": "<span></span>\u6559\u80b2\u652f\u6301\u6750\u6599", "acd380eb5ece072ae106a92d047ea7b1": "<span></span>\u7528\u4e8e\u535a\u5ba2\u6216\u5a92\u4f53\u62a5\u9053\u7684\u6570\u636e\u6216\u89c6\u56fe", "e419888394f1fcf097d8d2a259a4661d": "<span></span>\u5021\u5bfc/\u8fd0\u52a8", "0f1070e6d1757d6089e0f7975409a2cf": "\u60a8\u5982\u4f55\u4f7f\u7528global forest watch\uff1f*", "7a4e5f42b1c7f44ac8b2cf97ba50a5a1": "<span></span>\u6d41\u57df", "995e89ae65bf861a1e6df8d2eae754c6": "\u5bf9\u521a\u679c\u76c6\u5730\u786e\u8ba4\u9884\u8b66\u7684\u9a8c\u8bc1\u8868\u660e\uff0c\u5bf9\u4e8e\u5927\u4e8e0.2\u516c\u9877\u7684\u5e72\u6270\uff0c\u51c6\u786e\u7387\u5f88\u9ad8(2%\u8bef\u62a5\uff0c5%\u6f0f\u62a5)\u3002", "3ea6d56a16b6345013241fba462e81be": "\u672a\u53d7\u4fb5\u6270\u7684\u539f\u59cb\u68ee\u6797\u666f\u89c2 - 2000 - 2020", "0f00aeec6631ad83d748502f1456d914": "<span></span>\u8ba1\u5212\u5b9e\u5730\u5de5\u4f5c\uff08\u5de1\u903b/\u8c03\u67e5\uff09", "1e4443f1620b30c057f53844814225fb": "<span></span>\u76d1\u63a7\u7ed3\u679c/\u5f71\u54cd", "0e7c51c088ddac25557cdde0cf83533f": "<span></span>\u7528\u4e8e\u6f14\u793a\u548c\u62a5\u544a\u7684\u6570\u636e\u6216\u89c6\u56fe", "82258e1a10d96b2fea04d5a78d14eb4c": "<span></span>\u690d\u6811\u9020\u6797/\u666f\u89c2\u6062\u590d", "3b561cfed06cff503cbb04f0898e0bc7": "<span></span>\u68ee\u6797\u76d1\u6d4b\u521b\u65b0", "a2f9a569495194e075606c7af049d945": "<span></span>\u5173\u4e8e\u68ee\u6797\u7684\u4e00\u822c\u4fe1\u606f/\u6570\u636e", "3cbd664de1f34041d5c22ed94a2d2614": "<span></span>\u751f\u7269\u591a\u6837\u6027", "e487ede38f67b0d631c93847092a9e6a": "<span></span>\u6c14\u5019/\u78b3\u6392\u653e", "5ad791529b8fc71e12ca80d8f0dd1465": "<span></span>\u68ee\u6797\u780d\u4f10/\u68ee\u6797\u9000\u5316", "b0d7ae99032cece065ad79079604bb9b": "<span></span>\u73b0\u573a/\u56fd\u5bb6\u9a7b\u70b9\u4eba\u5458", "b24d171182d69fd63ee3fe1881d900cc": "<span></span>\u9879\u76ee\u7ecf\u7406", "3dcbe44fdf2ff07c64eb74b57d4acbfb": "<span></span>\u8463\u4e8b/\u9ad8\u7ba1", "06a943c59f33a34bb5924aaf72cd2995": "\u641c\u7d22", "57f0a7008635d0a0fe7a6c9335185020": "\u5206\u6790", "522b6c561b85f60abeea93f01794e8f0": "\u6211\u4eec\u4e0d\u5efa\u8bae\u5c06\u68ee\u6797\u780d\u4f10\u9884\u8b66\u7528\u4e8e\u5168\u7403\u6216\u533a\u57df\u8d8b\u52bf\u8bc4\u4f30\uff0c\u4e5f\u4e0d\u5efa\u8bae\u7528\u4e8e\u9762\u79ef\u4f30\u7b97\u3002\u6211\u4eec\u5efa\u8bae\u4f7f\u7528\u5e74\u5ea6\u6797\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\uff0c\u4ee5\u66f4\u51c6\u786e\u5730\u6bd4\u8f83\u68ee\u6797\u968f\u65f6\u95f4\u53d8\u5316\u7684\u8d8b\u52bf\uff0c\u5e76\u7528\u4e8e\u9762\u79ef\u4f30\u7b97\u3002\u8fd1\u671f\u9884\u8b66\u4f1a\u5305\u62ec\u8bef\u62a5\uff0c\u5b83\u4eec\u7684\u7f6e\u4fe1\u5ea6\u8fd8\u4e0d\u591f\u9ad8\uff0c\u4e14\u6700\u7ec8\u53ef\u80fd\u4f1a\u88ab\u5220\u9664\u3002\u5982\u679c\u57286\u4e2a\u6708\u5185\u5148\u53d1\u751f\u6797\u51a0\u5feb\u901f\u90c1\u95ed\uff0c\u8fc7\u540e\u53c8\u6709\u65e0\u906e\u6321\u536b\u661f\u89c2\u6d4b\u4fe1\u606f\uff0c\u5219\u8fc7\u5f80\u9884\u8b66\u53ef\u80fd\u88ab\u8bef\u5220\u3002\u6b64\u5916\uff0c\u65b9\u6cd5\u7684\u66f4\u65b0\u3001\u4e0d\u540c\u7684\u7cfb\u7edf\u6570\u91cf\uff08\u5c31\u96c6\u6210\u9884\u8b66\u800c\u8a00\uff09\uff0c\u4ee5\u53ca\u6708\u548c\u5e74\u4e4b\u95f4\u4e91\u91cf\u7684\u53d8\u5316\uff0c\u8fd9\u4e9b\u56e0\u7d20\u90fd\u7ed9\u4f7f\u7528\u68ee\u6797\u780d\u4f10\u9884\u8b66\u8fdb\u884c\u5e74\u9645/\u5e74\u5185\u6bd4\u8f83\u5e26\u6765\u4e86\u989d\u5916\u7684\u98ce\u9669\u3002", "f792c4ee01aa224064959828aad1834e": "\u53ef\u5bf9\u9884\u8b66\u52a0\u4ee5\u2018\u7cbe\u9009\u2019\uff0c\u4ee5\u8bc6\u522b\u7528\u6237\u5173\u6ce8\u7684\u9884\u8b66\uff0c\u4f8b\u5982\u90a3\u4e9b\u53ef\u80fd\u662f\u68ee\u6797\u780d\u4f10\u6216\u8bb8\u9700\u8981\u4f18\u5148\u91c7\u53d6\u884c\u52a8\u7684\u9884\u8b66\u3002\u7528\u6237\u53ef\u4ee5\u901a\u8fc7\u53e0\u52a0\u5176\u4ed6\u4e0a\u4e0b\u6587\u6570\u636e\u96c6\uff08\u4f8b\u5982\u4fdd\u62a4\u533a\u6216\u4eba\u5de5\u6797\uff09\u6765\u6267\u884c\u6b64\u64cd\u4f5c\u3002\u8fd9\u91cc\u63d0\u4f9b\u4e86\u975e\u7cbe\u9009\u6570\u636e\uff0c\u4ee5\u4fbf\u7528\u6237\u53ef\u4ee5\u5b9a\u4e49\u81ea\u5df1\u7684\u6392\u5e8f\u65b9\u6cd5\u3002\u7cbe\u9009\u9884\u8b66\u4f4d\u7f6e\u5728\u201c\u5f85\u89c2\u6d4b\u5730\u70b9\u201d\u6570\u636e\u56fe\u5c42\u4e2d\u63d0\u4f9b\u3002<br>\u4e09\u4e2a\u9884\u8b66\u7cfb\u7edf\u5bf9\u68ee\u6797/\u6811\u6728\u8986\u76d6\u548c\u68ee\u6797/\u6811\u6728\u8986\u76d6\u5e72\u6270\u6709\u4e0d\u540c\u7684\u5b9a\u4e49\uff1a<br><br>", "bca62e47ab12b4e798219f7aef3cd65d": "<strong>RADD</strong>\uff1a\u9884\u8b66\u53d1\u751f\u4e8e\u539f\u59cb\u6f6e\u6e7f\u68ee\u6797\u4e2d\u3002\u6797\u6728\u635f\u5931\u88ab\u5b9a\u4e49\u4e3a\u50cf\u7d20\u5185\u7684\u6797\u6728\u8986\u76d6\u5b8c\u5168\u6216\u90e8\u5206\u6d88\u5931\u4e0d\u89c1\uff0c\u6700\u5c0f\u6620\u5c04\u5355\u4f4d\u4e3a0.5\u516c\u9877\u3002 <br>\u8f93\u5165\u9884\u8b66\u7cfb\u7edf\u4e0d\u5177\u6709\u76f8\u540c\u7684\u65f6\u7a7a\u8986\u76d6\u8303\u56f4\uff1a", "f421a865323ac24058aabc267cc1f990": "<strong>RADD</strong>\uff1a\u9002\u7528\u4e8e\u5728\u5357\u7f8e\u6d32\u3001\u6492\u54c8\u62c9\u4ee5\u5357\u975e\u6d32\u548c\u4e1c\u5357\u4e9a\u5c9b\u5c7f\u7684\u539f\u59cb\u6f6e\u6e7f\u70ed\u5e26\u68ee\u6797\u5730\u533a\uff0c\u65f6\u7a7a\u8986\u76d6\u8303\u56f4\u662f\u975e\u6d32\u4ece2019\u5e741\u6708\u81f3\u4eca\uff0c\u5357\u7f8e\u6d32\u548c\u4e1c\u5357\u4e9a\u4ece2020\u5e741\u6708\u81f3\u4eca\uff0c\u4e2d\u7f8e\u6d32\u4ece2023\u5e741\u6708\u8d77\u5f00\u59cb\u8986\u76d6\uff082023\u5e74\u5e95\u5373\u5c06\u6269\u5c55\u5230\u4e1c\u5357\u4e9a\u548c\u592a\u5e73\u6d0b\u5927\u9646\uff09", "534c38443a9890cde729eabbd8d470cc": "\u8be5\u4ea7\u54c1\u53d7\u5230\u6240\u4f7f\u7528\u7684\u5168\u7403\u68ee\u6797\u57fa\u7ebf\u7684\u9650\u5236\uff0c\u8fd9\u53ef\u80fd\u5bfc\u81f4\u5730\u65b9\u4e00\u7ea7\u7684\u4e0d\u4e00\u81f4\u3002\u5728\u57fa\u7ebf\u4e2d\u88ab\u9519\u8bef\u5730\u6807\u8bb0\u4e3a\u539f\u59cb\u68ee\u6797\u7684\u5730\u533a\uff0c\u9884\u8b66\u4e2d\u53ef\u80fd\u5b58\u5728\u4e00\u4e9b\u59d4\u6258\u9519\u8bef\u3002\u5728\u68ee\u6797\u635f\u5931\u53d1\u751f\u5728RADD\u9884\u8b66\u5f00\u59cb\u4e4b\u524d\u4f46\u88ab\u57fa\u7ebf\u8f93\u5165\u6570\u636e\u9057\u6f0f\uff08\u56e0\u6b64\u672a\u4ece\u68ee\u6797\u57fa\u7ebf\u4e2d\u5220\u9664\uff09\u7684\u5730\u533a\uff0c\u9884\u8b66\u53ef\u80fd\u5728\u5e72\u6270\u53d1\u751f\u540e\u5f88\u957f\u65f6\u95f4\u624d\u88ab\u68c0\u6d4b\u5230\u3002\u8fd9\u53ea\u4f1a\u5f71\u54cd2019\u5e74\u521d\uff08\u975e\u6d32\uff09\u548c2020\u5e74\u521d\uff08\u5176\u4ed6\u5730\u533a\uff09\u7684\u9884\u8b66\u3002", "5ccf15a5cbf147bc8e01077a39d32a28": "\u5e2e\u52a9\u6211\u4eec\u6539\u8fdb\u6b64\u5730\u56fe", "6e2066262bd0539a6963c310c49b9a5d": "<span></span>\u571f\u5730\u7528\u9014\u89c4\u5212/\u571f\u5730\u7528\u9014\u5206\u914d", "fdd827c1efb737bc1338f9548d96e821": "<span></span>\u4e3a\u8d2d\u4e70/\u91c7\u8d2d/\u6295\u8d44\u51b3\u7b56\u63d0\u4f9b\u4fe1\u606f", "9b6d3cdcb886ba515d9e5d391d6fae2e": "<span></span>\u4e00\u822c\u7814\u7a76", "4c5ebb5cadf93a3baf4c2d0fe541f350": "<span></span>\u6211\u6240\u5728\u5730\u533a\u6216\u56fd\u5bb6", "1ff1c3751283e3dd5cfe75f3c0658da4": "<span></span>\u7814\u7a76\u4eba\u5458", "05de7dee022972737ba396cef460d448": "<span></span>GIS/\u6280\u672f\u4e13\u5bb6", "8dac5aee29ec4255b6a58c36d2fd4120": "<span></span>\u76d1\u6d4b/\u8bc4\u4f30\u4e13\u5bb6", "ec593b5748948fdd22e6b68633de1198": "\u534a\u7403\uff1a", "e6e42855066e7a3ae050b2c698021b14": "\u5206\u533a\uff1a", "dda047a00d09ba3e9ada973ce1b57bf2": "\u4f7f\u7528\u8fd9\u4e2a\u67e5\u627e\u8981\u6dfb\u52a0\u5230\u5730\u56fe\u7684<b>\u6570\u636e\u96c6</b>\u3002", "b5dccca7175d383b37aa03f516cb6d6f": "\u4e1c\uff1a", "f8bc9f2168f6c822f691337de8c7f7e2": "\u5317\uff1a", "a4abed4f08a5a7efaed05784c7cbb327": "\u8fd9\u4e9b\u6570\u636e\u80cc\u540e\u7684\u65b9\u6cd5\u5df2\u968f\u65f6\u95f4\u6539\u53d8\u3002\u8bf7\u8c28\u614e\u6bd4\u8f83\u65b0\u65e7\u6570\u636e\uff0c\u5c24\u5176\u662f2015\u5e74\u524d\u540e\u7684\u6570\u636e\u3002<a href=\"{{0}}\" target=\"_blank\">\u5728\u6b64\u4e86\u89e3\u66f4\u591a\u4fe1\u606f</a>\u3002", "694d7a31b6bef6d74fc11ef65829d732": "\u9000\u51fa<svg class=\"c-icon logout-icon\" viewBox=\"0 0 32 32\"><use xlink:href=\"#logout-29963891--sprite\"></use></svg>", "a1f7d303b3d5409ff4c1e328a1212dfa": "\u65b0\u7684Landsat 8\u53f7\u548c9\u53f7\u56fe\u50cf\u5728\u53d1\u5e03\u5230\u7f51\u4e0a\u540e\u5373\u88ab\u4e0b\u8f7d\uff0c\u8bc4\u4f30\u662f\u5426\u5b58\u5728\u4e91\u5c42\u8986\u76d6\u6216\u6570\u636e\u8d28\u91cf\u4e0d\u4f73\u7b49\u5e72\u6270\uff0c\u5e76\u4e0e\u524d\u4e09\u5e74\u7684Landsat\u884d\u751f\u6307\u6807\uff08\u5305\u62ec\u7ea2\u6ce2\u3001\u7ea2\u5916\u548c\u77ed\u6ce2\u6ce2\u6bb5\u7684\u6392\u540d\u3001\u5e73\u5747\u503c\u548c\u56de\u5f52\uff0c\u4ee5\u53caNDVI\u3001NBR\u548cNDWI\u7684\u6392\u540d\uff09\u8fdb\u884c\u6bd4\u8f83\u3002\u8fd9\u4e9b\u6307\u6807\u548c\u6700\u65b0\u7684Landsat\u56fe\u50cf\u901a\u8fc7\u4e03\u68f5\u51b3\u7b56\u6811\u8fd0\u884c\u6765\u8ba1\u7b97\u68ee\u6797\u5e72\u6270\u7684\u4e2d\u503c\u6982\u7387\u3002\u6982\u7387\u5927\u4e8e50%\u7684\u50cf\u7d20\u88ab\u62a5\u544a\u4e3a\u6797\u6728\u8986\u76d6\u635f\u5931\u9884\u8b66\u3002\u6574\u4e2a\u8fc7\u7a0b\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Google Earth Engine</a>\u4e2d\u8fd0\u884c\uff0c\u4ee5\u786e\u4fdd\u53ef\u9760\u7684\u66f4\u65b0\u548c\u53ef\u6269\u5c55\u6027\u3002\u6709\u5173\u8be5\u65b9\u6cd5\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605</a>Environmental Research Letters\u4e2d\u7684\u8bba\u6587<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u3002", "cd44478fe333f6382562fac14390f590": "GLAD-Landsat\u68ee\u6797\u780d\u4f10\u9884\u8b66\uff08GLAD-L\uff09", "7376854bd2f2fbca275669f713306029": "\u6211\u4eec\u4e0d\u5efa\u8bae\u5c06\u68ee\u6797\u780d\u4f10\u9884\u8b66\u7528\u4e8e\u5168\u7403\u6216\u533a\u57df\u8d8b\u52bf\u8bc4\u4f30\uff0c\u4e5f\u4e0d\u5efa\u8bae\u7528\u4e8e\u9762\u79ef\u4f30\u7b97\u3002\u6211\u4eec\u5efa\u8bae\u4f7f\u7528\u5e74\u5ea6\u6797\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\uff0c\u4ee5\u66f4\u51c6\u786e\u5730\u6bd4\u8f83\u68ee\u6797\u968f\u65f6\u95f4\u53d8\u5316\u7684\u8d8b\u52bf\uff0c\u5e76\u7528\u4e8e\u68ee\u6797\u780d\u4f10\u9762\u79ef\u4f30\u7b97\u3002\u8fd1\u671f\u9884\u8b66\u4f1a\u5305\u62ec\u8bef\u62a5\uff0c\u5b83\u4eec\u7684\u7f6e\u4fe1\u5ea6\u8fd8\u4e0d\u591f\u9ad8\uff0c\u4e14\u6700\u7ec8\u53ef\u80fd\u4f1a\u88ab\u5220\u9664\u3002\u5982\u679c\u57286\u4e2a\u6708\u5185\u5148\u53d1\u751f\u6797\u51a0\u5feb\u901f\u90c1\u95ed\uff0c\u8fc7\u540e\u53c8\u6709\u65e0\u906e\u6321\u536b\u661f\u89c2\u6d4b\u4fe1\u606f\uff0c\u5219\u8fc7\u5f80\u9884\u8b66\u53ef\u80fd\u88ab\u8bef\u5220\u3002\u6b64\u5916\uff0c\u65b9\u6cd5\u7684\u66f4\u65b0\u3001\u4e0d\u540c\u7684\u7cfb\u7edf\u6570\u91cf\uff08\u5c31\u96c6\u6210\u9884\u8b66\u800c\u8a00\uff09\uff0c\u4ee5\u53ca\u6708\u548c\u5e74\u4e4b\u95f4\u4e91\u91cf\u7684\u53d8\u5316\uff0c\u8fd9\u4e9b\u56e0\u7d20\u90fd\u7ed9\u4f7f\u7528\u68ee\u6797\u780d\u4f10\u9884\u8b66\u8fdb\u884c\u5e74\u9645/\u5e74\u5185\u6bd4\u8f83\u5e26\u6765\u4e86\u989d\u5916\u7684\u98ce\u9669\u3002", "8dbc89e1af584a48804629e218f7a959": "\u4e00\u65e6\u9884\u8b66\u50cf\u7d20\u8fbe\u5230\u9ad8\u7f6e\u4fe1\u5ea6\uff0c\u5c31\u4e0d\u4f1a\u518d\u5728\u8be5\u4f4d\u7f6e\u68c0\u6d4b\u5230\u68ee\u6797\u635f\u5931\u3002", "1144cfc17559b8cafea2cab5f6e0e66a": "\u68ee\u6797\u780d\u4f10\u76d1\u6d4b\u96f7\u8fbe\uff08RADD\uff09\u662f\u4e00\u79cd\u68ee\u6797\u780d\u4f10\u9884\u8b66\u4ea7\u54c1\uff0c\u5b83\u4f7f\u7528\u6b27\u6d32\u7a7a\u95f4\u5c40Sentinel-1\u536b\u661f\u6570\u636e\u8fd1\u5b9e\u65f6\u63a2\u6d4b\u68ee\u6797\u5e72\u6270\uff0c\u5e76\u5728\u6570\u5468\u5185\u786e\u8ba4\u9884\u8b66\u3002RADD\u9884\u8b66\u4f7f\u7528\u74e6\u8d6b\u5b81\u6839\u5927\u5b66\u4e0e\u7814\u7a76\u4e2d\u5fc3\uff08WUR\uff09\u5730\u7403\u4fe1\u606f\u79d1\u5b66\u4e0e\u9065\u611f\u5b9e\u9a8c\u5ba4\u5f00\u53d1\u7684\u63a2\u6d4b\u65b9\u6cd5\u3002\u8fd9\u4e9b\u9884\u8b66\u5728\u76d1\u6d4b\u70ed\u5e26\u68ee\u6797\u65b9\u9762\u7279\u522b\u6709\u5229\uff0c\u56e0\u4e3aSentinel-1\u7684\u4e91\u5c42\u7a7f\u900f\u96f7\u8fbe\u548c\u9891\u7e41\u7684\u91cd\u8bbf\u65f6\u95f4\uff086-12\u5929\uff09\u80fd\u53d6\u5f97\u6bd4\u57fa\u4e8e\u5149\u5b66\u536b\u661f\u56fe\u50cf\u7684\u9884\u8b66\u4ea7\u54c1\u66f4\u52a0\u4e00\u81f4\u7684\u76d1\u6d4b\u6548\u679c\u3002\u9884\u8b66\u53ef\u7528\u4e8e\u5357\u7f8e\u6d32\u3001\u6492\u54c8\u62c9\u4ee5\u5357\u975e\u6d32\u548c\u4e1c\u5357\u4e9a\u5c9b\u5c7f\u7684\u539f\u59cb\u6f6e\u6e7f\u70ed\u5e26\u68ee\u6797\u5730\u533a\uff0c\u5176\u7a7a\u95f4\u5206\u8fa8\u7387\u4e3a10\u7c73\uff0c\u975e\u6d32\u7684\u8986\u76d6\u65f6\u95f4\u4e3a2019\u5e741\u6708\u81f3\u4eca\uff0c\u5357\u7f8e\u6d32\u548c\u4e1c\u5357\u4e9a\u7684\u8986\u76d6\u65f6\u95f4\u4e3a2020\u5e741\u6708\u81f3\u4eca\u3002\u4ece2023\u5e741\u6708\u5f00\u59cb\u8986\u76d6\u4e2d\u7f8e\u6d32\uff0c\u52302023\u5e74\u5e95\u5c06\u6269\u5c55\u5230\u4e1c\u5357\u4e9a\u5927\u9646\u548c\u592a\u5e73\u6d0b\u5730\u533a\u3002\u4eceGoogle Earth Engin\u6536\u96c6\u9884\u5904\u7406\u7684Sentinel-1\u56fe\u50cf\uff0c\u7136\u540e\u4f7f\u7528\u5386\u53f2\u65f6\u95f4\u5e8f\u5217\u6307\u6807\u5bf9\u5176\u52a0\u4ee5\u8d28\u91cf\u63a7\u5236\u548c\u89c4\u8303\u5316\u5904\u7406\u3002\u7136\u540e\u4f7f\u7528\u6982\u7387\u7b97\u6cd5\u68c0\u6d4b\u68ee\u6797\u5e72\u6270\u9884\u8b66\u3002\u6bcf\u4e2a\u5e72\u6270\u9884\u8b66\u90fd\u662f\u4ece\u6700\u65b0\u56fe\u50cf\u7684\u5355\u6b21\u89c2\u6d4b\u4e2d\u68c0\u6d4b\u5230\u7684\uff0c\u5982\u679c\u68ee\u6797\u5e72\u6270\u6982\u7387\u9ad8\u4e8e97.5%\uff0c\u5219\u5728\u6700\u957f90\u5929\u7684\u540e\u7eed\u56fe\u50cf\u4e2d\u6807\u8bb0\u4e3a\u9ad8\u7f6e\u4fe1\u5ea6\u3002\u5bf9\u4e8e\u68ee\u6797\u5e72\u6270\u6982\u7387\u8d85\u8fc785%\u7684\u60c5\u51b5\uff0c\u63d0\u4f9b\u672a\u7ecf\u786e\u8ba4\u7684\u9884\u8b66\u3002\u8be5\u4ea7\u54c1\u7684\u6700\u5c0f\u6620\u5c04\u5355\u5143\u4e3a0.1\u516c\u9877\uff08\u76f8\u5f53\u4e8e10\u4e2aSentinel-1\u50cf\u7d20\uff09\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u9519\u8bef\u68c0\u6d4b\u3002\n\u5728\u539f\u59cb\u6f6e\u6e7f\u70ed\u5e26\u68ee\u6797\u533a\u57df\u5185\u68c0\u6d4b\u5230\u9884\u8b66\uff0c\u7531<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Turubanova et al. (2018)</a>\u5b9a\u4e49\uff0c\u5e76\u5220\u96642001-2018\u5e74\u68ee\u6797\u635f\u5931<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">(Hansen et al. 2013)</a>\u548c\u7ea2\u6811\u6797<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">(Bunting et al. 2018)</a>\u3002\u6709\u5173\u8be5\u65b9\u6cd5\u548c\u9a8c\u8bc1\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u89c1<a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Reiche et al.(2021)</a>\u3002\u8fd9\u91cc\u5c55\u793a\u7684\u7248\u672c\uff08v1\uff09\u5df2\u7ecf\u4ece\u8bba\u6587\u6240\u8ff0\u7248\u672c\uff08V0\uff09\u52a0\u4ee5\u66f4\u65b0\uff0c\u5bf9\u68ee\u6797\u906e\u7f69\u8fdb\u884c\u4e86\u66f4\u6539\uff0c\u5e76\u51cf\u5c11\u4e86\u6700\u5c0f\u6620\u5c04\u5355\u5143\u3002", "243a3be0eac18aa7cfc8390a78065f7a": "<svg class=\"c-icon delete-icon\" viewBox=\"0 0 32 32\"><use xlink:href=\"#delete-b64a0585--sprite\"></use></svg>\u5220\u9664\u533a\u57df", "ca542cc36776f6681ea2aacf37344df2": "<span></span>\u4e0d\u786e\u5b9a\uff1b\u521a\u63a5\u89e6GFW", "6bce693d8719a4cc8ae0bbdb199efd1a": "<span></span>\u6c9f\u901a\u4ea4\u6d41\u4e13\u5458", "d46e37d83a34e9e70f79ecc7b08e06b8": "\u4e3a\u4e86\u5728\u4e00\u4e2a\u516c\u5171\u7f51\u683c\u4e0a\u96c6\u6210\u4e09\u4e2a\u9884\u8b66\u7cfb\u7edf\uff0c\u9700\u8981\u5bf9GLAD-L\u8fdb\u884c\u91cd\u65b0\u91c7\u6837\uff0c\u5c06\u7a7a\u95f4\u5206\u8fa8\u7387\u4ece30\u7c73\u7f29\u5c0f\u523010\u7c73\uff0c\u4ee5\u5339\u914dGLAD-S2\u548cRADD\u3002\u56e0\u6b64\uff0c\u5355\u4e2a30\u7c73GLAD-L\u50cf\u7d20\u5c06\u5728\u96c6\u6210\u56fe\u5c42\u4e2d\u53d8\u6210\u591a\u4e2a10\u7c73\u50cf\u7d20\u3002\u7528\u6237\u5728\u5c06\u5355\u4e2a\u7cfb\u7edf\u7684\u5206\u6790\u7ed3\u679c\u4e0e\u96c6\u6210\u9884\u8b66\u56fe\u5c42\u8fdb\u884c\u6bd4\u8f83\u65f6\u5e94\u8c28\u614e\uff0c\u56e0\u4e3a\u96c6\u6210\u9884\u8b66\u7684\u6570\u91cf\u5c06\u8fdc\u8fdc\u5927\u4e8e\u539f\u751fGLAD-L\u9884\u8b66\u7684\u6570\u91cf\u3002\u6b64\u5916\uff0c\u7531\u4e8e\u8fd9\u79cd\u91cd\u65b0\u91c7\u6837\uff0c\u96c6\u6210\u56fe\u5c42\u4e2d\u7684\u50cf\u7d20\u5728\u5730\u56fe\u4e0a\u53ef\u80fd\u4e0e\u5355\u4e2aGLAD-L\u56fe\u5c42\u4e2d\u7684\u50cf\u7d20\u4e0d\u5b8c\u5168\u5bf9\u9f50\u3002", "dea149d61e2ab48236830956b3c3ddd5": "\u201c\u6700\u9ad8\u7f6e\u4fe1\u5ea6\uff1a\u88ab\u591a\u4e2a\u9884\u8b66\u7cfb\u7edf\u68c0\u6d4b\u5230\u201d\u7ea7\u522b\u53ea\u80fd\u5728\u8be5\u533a\u57df\u6709\u591a\u4e2a\u9884\u8b66\u7cfb\u7edf\u4f5c\u7528\u7684\u65f6\u7a7a\u8303\u56f4\u80cc\u666f\u4e0b\u5b9e\u73b0\u3002", "69635619b50679af7743d1769dffd9d0": "\u968f\u7740\u6e90\u6570\u636e\u7684\u66f4\u65b0\uff0c\u7f6e\u4fe1\u5ea6\u53ef\u80fd\u53d1\u751f\u8ffd\u6eaf\u6027\u53d8\u5316\uff1b\u5728180\u5929\u5185\u672a\u53d8\u4e3a\u9ad8\u7f6e\u4fe1\u5ea6\u7684\u9884\u8b66\u5c06\u4ece\u6570\u636e\u96c6\u4e2d\u5220\u9664\u3002", "3f32b9dc3d01310cbd7db3bc4d59b030": "\u4e00\u65e6\u67d0\u4e2a\u9884\u8b66\u50cf\u7d20\u8fbe\u5230\u9ad8\u7f6e\u4fe1\u5ea6\uff0c\u540c\u4e00\u9884\u8b66\u7cfb\u7edf\u5c06\u4e0d\u4f1a\u5bf9\u8be5\u4f4d\u7f6e\u518d\u6b21\u68c0\u6d4b\u68ee\u6797\u635f\u5931", "7966486542a3de09613e4b2a25f589cd": "\u6e90\u9884\u8b66\u7cfb\u7edf\u6e90\u81ea\u5149\u8c31\u548c\u7a7a\u95f4\u5206\u8fa8\u7387\u5404\u4e0d\u76f8\u540c\u7684\u536b\u661f\u3002\u5bf930\u7c73<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">GLAD Landsat\u9884\u8b66</a>\u8fdb\u884c\u4e0a\u91c7\u6837\uff0c\u4ee5\u5339\u914dSentinel\u9884\u8b66\uff08<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">GLAD-S2</a>\u3001<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">RADD</a>\uff09\u768410\u7c73\u7a7a\u95f4\u5206\u8fa8\u7387\u3002\u8fd9\u6837\u53ef\u4ee5\u907f\u514d\u5bf9\u91cd\u53e0\u9884\u8b66\u8fdb\u884c\u91cd\u590d\u8ba1\u6570\uff0c\u800c\u662f\u5c06\u5176\u5f52\u7c7b\u4e3a\u8f83\u9ad8\u7f6e\u4fe1\u5ea6\uff08\u8868\u73b0\u4e3a\u50cf\u7d20\u989c\u8272\u8f83\u6df1\uff09\u3002", "c267bf719136018eeae41aae6e77d94d": "2021\u5e741\u67081\u65e5\uff08GLAD-L\u9884\u8b66\u81ea2015\u5e74\u4ee5\u6765\u4e00\u76f4\u5728\u4e9a\u9a6c\u900a\u548c\u521a\u679c\u76c6\u5730\u4ee5\u53ca\u4e1c\u5357\u4e9a\u5c9b\u5c7f\u90e8\u5206\u56fd\u5bb6/\u5730\u533a\u8fd0\u884c\uff0c\u4f46GFW\u4e0a\u6ca1\u6709\u5386\u53f2\u6570\u636e\uff09", "be6dbc55ec209b1abcee2d71938914ca": "\u53ef\u5bf9\u9884\u8b66\u52a0\u4ee5\u2018\u7cbe\u9009\u2019\uff0c\u4ee5\u8bc6\u522b\u7528\u6237\u5173\u6ce8\u7684\u9884\u8b66\uff0c\u4f8b\u5982\u90a3\u4e9b\u53ef\u80fd\u662f\u68ee\u6797\u780d\u4f10\u6216\u8bb8\u9700\u8981\u4f18\u5148\u91c7\u53d6\u884c\u52a8\u7684\u9884\u8b66\u3002\u7528\u6237\u53ef\u4ee5\u901a\u8fc7\u53e0\u52a0\u5176\u4ed6\u4e0a\u4e0b\u6587\u6570\u636e\u96c6\uff08\u4f8b\u5982\u4fdd\u62a4\u533a\u6216\u4eba\u5de5\u6797\uff09\u6765\u6267\u884c\u6b64\u64cd\u4f5c\u3002\u8fd9\u91cc\u63d0\u4f9b\u4e86\u975e\u7cbe\u9009\u6570\u636e\uff0c\u4ee5\u4fbf\u7528\u6237\u53ef\u4ee5\u5b9a\u4e49\u81ea\u5df1\u7684\u6392\u5e8f\u65b9\u6cd5\u3002\u7cbe\u9009\u9884\u8b66\u4f4d\u7f6e\u5728\u201c\u5f85\u89c2\u6d4b\u5730\u70b9\u201d\u6570\u636e\u56fe\u5c42\u4e2d\u63d0\u4f9b\u3002<br>", "6547531bbe70f643e59b022b9244e8aa": "\u867d\u7136Landsat 8\u548c9\u536b\u661f\uff08\u4ee5\u524d\u662fLandsat 7\u548c8\uff09\u52a0\u8d77\u6765\u91cd\u8bbf\u5468\u671f\u4e3a8\u5929\uff0c\u4f46\u4e91\u5c42\u8986\u76d6\u4f1a\u9650\u5236\u5f71\u50cf\u7684\u53ef\u7528\u6027\uff0c\u5c24\u5176\u662f\u5728\u96e8\u5b63\u3002\u9884\u8b66\u65e5\u671f\u4ee3\u8868\u68c0\u6d4b\u5b9e\u4f8b\uff0c\u4f46\u7531\u4e8e\u6301\u7eed\u7684\u4e91\u5c42\u8986\u76d6\uff0c\u6797\u6728\u8986\u76d6\u635f\u5931\u6709\u53ef\u80fd\u65e9\u5728\u51e0\u5468\u524d\u5c31\u5df2\u53d1\u751f\u3002\u8bf7\u6ce8\u610f\uff0cGLAD-L\u9884\u8b66\u4ee5\u524d\u6e90\u81eaLandsat 7\u5f71\u50cf\uff0c\u800c\u8be5\u5f71\u50cf\u5177\u6709\u5df2\u77e5\u7684\u626b\u63cf\u7ebf\u95ee\u9898\uff0c\u6709\u65f6\u4f1a\u5bfc\u81f4\u8bef\u62a5\uff0c\u76f4\u52302023\u5e744\u6708\u8f93\u5165\u5207\u6362\u5230Landsat 9\u624d\u89e3\u51b3\u95ee\u9898\u3002", "b2acdd9efc7d122212bb9f683c4b64a4": "\u5728\u6700\u65e9\u5f00\u53d1\u5229\u7528\u9884\u8b66\u7cfb\u7edf\u7684\u79d8\u9c81\uff0c\u4f5c\u8005\u8bc4\u4f30\u6570\u636e\u670913.5%\u7684\u8bef\u62a5\u7387\uff08\u68c0\u6d4b\u5230\u672a\u53d1\u751f\u7684\u635f\u5931\uff09\uff0c\u4e0d\u8fc7\u5927\u591a\u6570\u8bef\u62a5\uff089.5%\uff09\u53d1\u751f\u5728\u7a7a\u5730\u8fb9\u7f18\u3002\u5728\u7a7a\u5730\u8fb9\u7f18\uff0c30\u7c73Landsat\u50cf\u7d20\u663e\u793a\u68ee\u6797\u548c\u5176\u4ed6\u571f\u5730\u8986\u88ab\u7684\u6df7\u5408\u7ed3\u679c\uff0c\u8fd9\u4f7f\u5f97\u5b83\u4eec\u5bb9\u6613\u5728\u7cfb\u7edf\u4e2d\u88ab\u8bef\u8ba4\u3002\u4ec5\u8003\u8651\u9ad8\u7f6e\u4fe1\u5ea6\u9884\u8b66\u65f6\uff0c\u8bef\u62a5\u7387\u964d\u81f3 1%\u3002\u6570\u636e\u670933%\u7684\u6f0f\u62a5\uff08\u672a\u68c0\u6d4b\u5230\u5b9e\u9645\u53d1\u751f\u7684\u635f\u5931\uff09\uff0c\u5176\u4e2d\u5927\u591a\u6570\u53d1\u751f\u5728\u6b21\u751f\u6797\u4e2d\uff0c\u8fd9\u53ef\u80fd\u662f\u56e0\u4e3a\u7b97\u6cd5\u5728\u521b\u5efa\u65f6\u662f\u4e3a\u4e86\u6355\u83b7\u539f\u59cb\u6797\u635f\u5931\u3002\u6f0f\u62a5\u7387\u6bd4\u8bef\u62a5\u7387\u66f4\u9ad8\uff0c\u8fd9\u4e5f\u8868\u660e\u9884\u8b66\u662f\u5bf9\u5b9e\u9645\u53d1\u751f\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u4fdd\u5b88\u4f30\u8ba1\u3002", "f6d40daf87ee0642c404fa4fe288d9dc": "\u4e00\u65e6\u9884\u8b66\u50cf\u7d20\u8fbe\u5230\u9ad8\u7f6e\u4fe1\u5ea6\uff0c\u5c31\u4e0d\u4f1a\u518d\u5728\u8be5\u4f4d\u7f6e\u68c0\u6d4b\u5230\u68ee\u6797\u635f\u5931\u3002", "535135a8128534e700c64147a507f0d2": "<span></span>\u662f", "3f0e61e271f5f116f905212d886cf33a": "\u5176\u4ed6\uff1a*", "b5b7b6c5b5f08dd62ed2dc52c7a4cfe8": "\u4f7f\u7528\u6761\u6b3e", "56c34c6410dd45c5cec44149ad0ce037": "\u9690\u79c1\u653f\u7b56", "8f3559d6b55ee3630f4be088dc65f9b2": "\u9605\u8bfb\u6211\u4eec\u7684\u535a\u5ba2", "97c3e86b81ab7556d0bd4284b3f962a4": "\u67e5\u627e\u6570\u636e\u96c6", "2048a8772269a3da3f4db71a0f5eb7ee": "\u4ee510\u7c73\u6807\u51c6\u7684\u5206\u8fa8\u7387\u663e\u793a&gt;40%\u7684\u6811\u6728\u8303\u56f4\u6982\u7387", "91f33ea37a9465ba4c3e24371280dbbe": "\u70ed\u5e26\u6811\u6728\u8986\u76d6\uff0810x10\u7c73\uff09", "708561b2ba0202f72d35c7c8e369354d": "\u70ed\u5e26\u6811\u6728\u8986\u76d6\uff0810\u7c73\uff09", "af35fc0c79b5b2896c98300fc9fbe808": "\u786e\u5b9a\u70ed\u5e26\u6811\u6728\u8986\u76d6\u533a\u57df", "9357a74be85e08a880eead6865c777f8": "\u663e\u793a\u5e26\u6709  {selector}  \u51a0\u5c42\u9ad8\u5ea6\u7684 {name}", "89dd05a74b31938dbfc4db2a0e116c4c": "\u4ee50.5\u516c\u9877\u5206\u8fa8\u7387\u548c {selector} \u7684\u6811\u6728\u8986\u76d6\u4e3a\u6807\u51c6\uff0c\u6765\u663e\u793a\u6811\u6728\u8986\u76d6", "b5b822cf33b6db5f182e8d3b41cdfc0d": "Forest Watcher\u7684\u65b0\u529f\u80fd", "c24a8ff01f0daecf5cb44519ac3ad5ad": "\u6240\u6709\u89c2\u5bdf\u7684\u5730\u70b9", "91a5c1de1fb151b6924cbefa6e68fb9b": "\u5927\u8c46", "1832d95d64037ed0baa6fcd8422aa617": "\u672c\u6570\u636e\u7684\u91c7\u96c6\u65b9\u6cd5\u968f\u7740\u65f6\u95f4\u7684\u63a8\u79fb\u800c\u6539\u53d8\u3002\u8bf7\u8c28\u614e\u6bd4\u8f83\u65b0\u65e7\u6570\u636e\uff0c\u5c24\u5176\u662f2015\u5e74\u4e4b\u524d/\u4e4b\u540e\u7684\u6570\u636e\u3002<a href=\"{{0}}\" target=\"_blank\">\u70b9\u51fb\u6b64\u5904\u4e86\u89e3\u66f4\u591a</a>\u3002", "346010ce079d3ce98edb063240db2a3b": "\u60a8\u80fd<strong>\u5e2e\u52a9\u6211\u4eec\u4e86\u89e3</strong>\u5982\u4f55\u624d\u80fd\u4ee5\u66f4\u6709\u7528\u7684\u65b9\u5f0f\u5448\u73b0\u8fd9\u4e9b\u6570\u636e\u5417\uff1f<a href=\"{{0}}\" target=\"_blank\"> \u8bf7\u5355\u51fb\u6b64\u5904\u586b\u5199\u95ee\u5377\u8c03\u67e5</a>", "ce322c3dc99f5637adfaafe381714c74": "\u6211\u4eec\u6b63\u51c6\u5907\u4ece\u5168\u7403\u68ee\u6797\u89c2\u5bdf\u7f51\u7ad9\u4e0a\u5220\u9664MODIS\u70e7\u6bc1\u533a\u57df\uff0c\u5e76\u4e14\u4e0d\u4f1a\u518d\u66f4\u65b0\u76f8\u5173\u6570\u636e\u3002\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3<a href=\"{{0}}\" target=\"_blank\">gfw@wri.org</a>\uff0c\u5982\u60a8\u60f3\u8bf7\u6c42\u4fdd\u7559\u6b64\u6570\u636e\u96c6\uff0c\u6216\u6709\u5173\u4e8e\u65b0\u7684\u706b\u707e\u76f8\u5173\u6570\u636e\u96c6\u7684\u5efa\u8bae\u3002\n\n \n", "827c88f708ea2d6fe2da163b8c2aab69": "\u67e5\u627e\u4f4d\u7f6e", "753e4b57d2440c4221fc34b850ef7888": "\u8981\u5305\u542b\u6240\u6709\u68c0\u6d4b\u5230\u7684\u706b\u707e\u8b66\u62a5\uff0c\u8bf7\u524d\u5f80\u5c0f\u7ec4\u4ef6\u8bbe\u7f6e\u56fe\u6807\uff0c\u5e76\u5c06\u7f6e\u4fe1\u6c34\u5e73\u91cd\u65b0\u8c03\u6574\u4e3a\u5168\u90e8\u3002", "087204b3309fb6a208b7ac0ba487a51c": "2020\u5e74\uff0c10\u7c73/0.5\u516c\u9877\uff0c\u70ed\u5e26\uff0c\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240", "9130688fbc10cb412a8ae995e7a0526c": "\u83b7\u53d6\u6570\u636e\u65f6\u51fa\u9519\u3002\u60a8\u53ef\u4ee5\u91cd\u8bd5\uff0c\u6216\u4fdd\u5b58\u56fe\u5f62\u540e\u660e\u5929\u518d\u8fd4\u56de\u67e5\u770b\u3002", "33d7aea4c890378dcbf203a1a97d28a4": "\u70ed\u5e26\u6811\u6728\u8986\u76d6", "fa5ca853ee324839f5aea0ea9dd1696a": "\u70ed\u5e26\u6811\u6728\u8986\u76d6\uff080.5\u516c\u9877\uff09", "a5dba41c2cc690f9d6a0de9fc1e4deb9": "\u4e0e2000/2010\u5e74\u6811\u6728\u8986\u76d6\uff08UMD\uff09 \u6570\u636e\u76f8\u6bd4\uff0c\u6b64\u5904\u4f7f\u7528\u7684\u6570\u636e\u96c6\u4f7f\u7528\u4e86\u4e0d\u540c\u7684\u65b9\u6cd5\u6765\u6d4b\u91cf\u6811\u6728\u8986\u76d6\u3002\u8bf7\u9605\u8bfb<a href=\"{{0}}\" target=\"_blank\">\u6211\u4eec\u7684\u535a\u5ba2</a>\u4ee5\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002", "f252ea907b8bdb29d37624efccec39f6": "10x10 \u7c73", "2cc0488332065661c4446dd692452660": "0.5\u516c\u9877", "48d5708a39907ad86ff2f94f4b098025": "\u9690\u85cf\u9053\u8def", "3d4df91ab42db44d3efde29fcd3a180f": "\u5730\u56fe\u98ce\u683c", "11c137cfa959b4d419ec2d1c80592e13": "\u663e\u793a\u6807\u7b7e", "c18d858b227eebc5d3fdbb08606490ec": "\u6697\u7269\u8d28", "7b91156d64b76a5dda815937fce9119d": "\u653e\u5927", "61608f2b476dadeaf0487942a189e098": "\u5730\u56fe\u4f7f\u7528\u6307\u5357", "528c67311376b9e1d582422553a6d866": "\u5171\u4eab\u6216\u5d4c\u5165\u6b64\u89c6\u56fe", "bf6f0d6ec2e7199040f5bf6e6d15345b": "\u4ec5\u663e\u793a\u5730\u56fe", "3941f3e23f9fea6abd7ec7ff049f5ef0": "\u9690\u85cf\u6807\u7b7e", "c519d5376f988058c4e23cdb0e5b173a": "\u663e\u793a\u9053\u8def", "d9057c70a762bf5a4a1ec15a651e6330": "\u6765\u4f53\u9a8cForest Watcher\u7684\u6700\u65b0\u529f\u80fd\uff0c\u56e2\u961f\u7ba1\u7406\u5de5\u4f5c\u4ece\u672a\u5982\u6b64\u8f7b\u677e\u7b80\u4fbf\u8fc7", "26170b02f2ea7c7ebe35b79cea7ead20": "\u6570\u636e\u96c6\u5373\u5c06\u5220\u9664", "c21f969b5f03d33d43e04f8f136e7682": " \u9ed8\u8ba4", "313356e4058a12f4f59811d8b57e6162": "\u5730\u56fe\u8bbe\u7f6e", "a91585858e2f2ee24adc5e3d6f309032": "\u672c\u6570\u636e\u96c6\u4f7f\u7528\u4e86\u4e0eHansen\u7b49\u4eba\u4e0d\u540c\u7684\u6811\u6728\u5b9a\u4e49\u548c\u6811\u6728\u8986\u76d6\u5b9a\u4e49\u3002\uff082013\uff09\u3002\u672c\u6570\u636e\u96c6\u6839\u636e\u6811\u7684\u9ad8\u5ea6\u548c\u6811\u51a0\u76f4\u5f84\u6765\u5b9a\u4e49\u6811\u6728\u3002\u4efb\u4f55\u9ad8\u4e8e5\u7c73\u7684\u6728\u672c\u690d\u88ab\uff0c\u6216\u9ad8\u5ea6\u4e3a3\u81f35\u7c73\u4e14\u6811\u51a0\u76f4\u5f84\u4e0d\u5c0f\u4e8e5\u7c73\u7684\u7684\u6728\u672c\u690d\u88ab\u53ef\u88ab\u89c6\u4e3a\u6811\u6728\u3002\u8fd9\u4e00\u5b9a\u4e49\u4e0eHansen\u7b49\u4eba\u7684\u4e0d\u540c\uff082013\uff09\uff0c\u4ed6\u4eec\u5c06\u6811\u6728\u5b9a\u4e49\u4e3a\u4efb\u4f55\u9ad8\u5ea6\u4e3a5\u7c73\u53ca\u4ee5\u4e0a\u7684\u690d\u88ab\u3002\u70ed\u5e26\u6811\u6728\u8986\u76d6\u6570\u636e\u96c6\u5e76\u6ca1\u6709\u6d88\u9664\u4eba\u5de5\u6797\u6811\u6728\u548c\u975e\u4eba\u5de5\u6797\u6811\u6728\u7684\u6b67\u4e49\u3002", "24181e7a79e97a4a33a458ec228ea801": "43\u4ebf\u516c\u9877\u70ed\u5e26\u5730\u533a\uff08\u5317\u7eac23.44\u5ea6\u81f3\u5357\u7eac23.44\u5ea6\uff09", "8ae1cb3a39b0772cc6f8ebb2bc41f8f4": "\u70ed\u5e26\u6811\u6728\u8986\u76d6\u6570\u636e\u7ed8\u5236\u51fa\u4e86\u4ee510\u7c73\u4e3a\u5355\u4f4d\u7684\u6811\u6728\u8303\u56f4\u548c\u4ee5\u534a\u516c\u9877\u4e3a\u5355\u4f4d\u7684\u6811\u6728\u8986\u76d6\uff0c\u4ece\u800c\u80fd\u591f\u51c6\u786e\u76d1\u6d4b\u57ce\u5e02\u5730\u533a\u3001\u519c\u4e1a\u7528\u5730\u3001\u7a00\u758f\u6797\u51a0\u548c\u5e72\u71e5\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u4e2d\u7684\u6811\u6728\u3002\u6570\u636e\u6db5\u76d6\u4e86\u5168\u7403\u70ed\u5e26\u5730\u533a\u8d85\u8fc743\u4ebf\u516c\u9877\u7684\u571f\u5730\u3002", "1d32f6a5487572f15f8dd1f669207fe5": "\u5bf9\u5c0f\u4e8e0.5ha\u7684shapefiles\u8fdb\u884c\u7684\u5206\u6790\u6216\u7edf\u8ba1\u53ef\u80fd\u4e0d\u51c6\u786e\u3002", "c81d984278f96177206ffdc1a311a8e6": "\u6570\u636e\u6765\u6e90\u4e8e\u5e94\u7528\u4e8eSentine