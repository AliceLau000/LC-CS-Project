"\u8d2b\u7620\u7684\u571f\u5730\uff08\u5ca9\u77f3/\u6c99\u5b50/\u7c98\u571f\uff09", "58091cd419f36b3852b27525492a5d46": "\u82d4\u85d3", "52b1da12481f483ed4261fa641512bb8": "\u5e38\u5e74\u51b0/\u96ea", "ee0ff9478f3552e07eff1f610298357d": "\u5229\u75282016\u5e74\u56fd\u5bb6\u571f\u5730\u8986\u76d6\u7269\u6570\u636e\u5e93\uff08NLCD\uff09\uff0c\u786e\u5b9a\u7f8e\u56fd\u7684\u571f\u5730\u8986\u76d6\u3002", "402cbd9a74b551ccee64343d78df22e6": "\u975e\u68ee\u6797\u5730\u533a(\u00c1reas no forestales)", "acc8bd94feaf343605bca004e64a8eb0": "\u58a8\u897f\u54e5\u6309\u7c7b\u522b\u5212\u5206\u7684\u68ee\u6797\u533a\u5212 - 2011\u5e74", "bb633a5a1e8c43564fe9b905896fcfa1": "\u58a8\u897f\u54e5\u7684\u68ee\u6797\u533a\u5212\u662f\u57fa\u4e8e\u5927\u91cf\u7684\u5176\u4ed6\u6570\u636e\u96c6\uff0c\u8fd9\u4e9b\u6570\u636e\u96c6\u7684\u6765\u6e90\u5404\u4e0d\u76f8\u540c\uff0c\u7cbe\u786e\u5ea6\u4e5f\u4e0d\u540c\u3002\u8fd9\u5957\u6570\u636e\u5e76\u4e0d\u610f\u5473\u7740\u5728\u5730\u5757\u6216\u5355\u4e2a\u571f\u5730\u6301\u6709\u5c42\u9762\u4e0a\u662f\u7cbe\u786e\u7684\u3002\u8981\u786e\u5b9a\u67d0\u5757\u571f\u5730\u7684\u72b6\u51b5\uff0c\u9700\u8981\u68ee\u6797\u6280\u672f\u5458\u7684\u5b9e\u5730\u8003\u5bdf\u3002", "1e5f0d934b5f701ab1500b44583b9bae": "\u5176\u4ed6\u68ee\u6797\u7c7b\u578b (Otras asociaciones)", "d179aa9a5f2a7f345d33df8b95fce3ec": "\u534a\u5e72\u65f1\u5730\u533a (Semiarid zones)", "85f972182a3a0f1462582b4d02e40c58": "\u7267\u8349/\u5e72\u8349", "a515397b19e5fed7152aa463809624b4": "\u5728<strong>\u7f8e\u56fd</strong>\u6ca1\u6709\u5173\u4e8e\u751f\u7269\u591a\u6837\u6027\u7684\u6570\u636e\u96c6\u3002", "cf14de6106e2648ae6397cd1b59c55b1": "\u4e2d\u7b49\u751f\u4ea7\u529b\u7684\u6797\u5730", "40cf02bb7069a994f6cd7faa9ccfb07b": "\u56fd\u5bb6\u4fdd\u62a4\u533a", "92cdf836f6a2d5595f67b046a5229b94": "\u5dde\u4fdd\u62a4\u533a", "9909133fc4671dbfd6d91d611224ed3a": "\u5e02\u4fdd\u62a4\u533a", "205c64168882c8d73b9a4499ade2b03b": "\u5728<strong>\u7f8e\u56fd</strong>\u6ca1\u6709\u68ee\u6797\u53d8\u5316\u7684\u6570\u636e\u96c6\u3002", "b58131cf733f4f7bc9fc4111fa1ade0c": "\u704c\u6728/\u704c\u6728\u4e1b", "84073d2199c59fff9edf18a8314444a9": "\u5e72\u65f1\u5730\u533a (Zonas \u00e1ridas)", "f80e011f84d0be4c6dd0f98678886600": "\u6240\u6709\u6797\u5730\u88ab\u5206\u4e3a\u4e09\u5927\u7c7b\uff0c\u6bcf\u4e00\u7c7b\u90fd\u6709\u81ea\u5df1\u7684\u5b50\u7c7b:", "9a3992127e5842da9711761ca1f8a469": "\u5761\u5ea6\u8d85\u8fc745\u5ea6\u7684\u5730\u533a", "07c919b28a6a94e9615b8f20d6949e77": "<strong>\u751f\u4ea7\u533a\uff1a</strong>\u5177\u6709\u4f7f\u7528\u6728\u6750\u548c\u5176\u4ed6\u68ee\u6797\u8d44\u6e90\u7684\u9002\u5f53\u6761\u4ef6\u7684\u6797\u5730", "39cab51f231799be4c644770f52a029c": "\u6c34\u4f53", "cd378ffa2cb7b38a82d80744959c53fd": "\u5728<strong>\u7f8e\u56fd</strong>\u6ca1\u6709\u571f\u5730\u5229\u7528\u7684\u6570\u636e\u96c6\u3002", "415ff96c5d34d421d5a1b6446bce2f38": "\u58a8\u897f\u54e5\u4fdd\u62a4\u533a - 2011-2016\u5e74", "a014e08c89a1c6683224e35cb42d2bfb": "\u81ea\u613f\u4fdd\u62a4\u533a", "ca2f485355bfdce4cfa1cc67442ad377": "\u843d\u53f6\u6797", "f90fe86d543eb46acf0802f621bdab60": "\u77ee\u704c\u6728\u4e1b", "1feb29d835c75400177318f86586b3af": "\u6df7\u5408\u6797", "67c159cb42ec7dfb0b5369d9caa61f82": "\u683d\u57f9\u7684\u519c\u4f5c\u7269", "d4bbe272d31971c891c7c795a1305e6d": "\u5df2\u5f00\u53d1\u7684\uff0c\u9ad8\u5f3a\u5ea6", "9cc35ab357087876c9c8eb4795019112": "\u6728\u672c\u6e7f\u5730", "f002c2b92448137541d7ada724527e52": "\u65b0\u751f\u8349\u672c\u6e7f\u5730", "73ea2d895ef77a6753655af1b33a278d": "\u4f4e\u5730\u96e8\u6797(Selvas bajas)", "e8fc98fa15c49b35932d8babba904449": "\u9ad8\u6d77\u62d4\u548c\u4e2d\u6d77\u62d4\u96e8\u6797(Selvas altas y medianas)", "955587a44f5840958a3ddf25ec005afa": "\u7ea2\u6811\u6797\u6216\u4e91\u96fe\u68ee\u6797\u8986\u76d6\u7684\u5730\u533a", "66cf7b6e72a5ca0a1ec977168ad5e5fa": "\u9002\u5408\u9020\u6797\u7684\u571f\u5730", "458bef6e62c3cf09b244d6a87352050f": "\u6c99\u68d8/\u8349\u672c\u690d\u7269", "68a335aa23868ca4b8569ad7117ead0b": "\u5df2\u5f00\u53d1\u7684\uff0c\u5f00\u653e\u7684\u7a7a\u95f4", "c87da5dd5bb135665f74cdedb22cea13": "\u5730\u8863", "a02aad364028b67f0c859c656e6c1312": "\u5728<strong>\u7f8e\u56fd</strong>\u6ca1\u6709\u6c14\u5019\u65b9\u9762\u7684\u6570\u636e\u96c6\u3002", "bd5ff26db2321a70cdfcd2a829179574": "\u5176\u4ed6\u6797\u533a(Otras areas forestales)", "b3e351185c86eed0c408980c085c0ad9": "\u6d77\u62d43000\u7c73\u4ee5\u4e0a\u7684\u5730\u533a", "b4702fc4e943987b919d5bbd9c1dd8cd": "\u6cb3\u5cb8\u690d\u88ab\u8986\u76d6\u7684\u5730\u533a", "93313234cfbe35608e0718403a41d573": "\u672c\u6570\u636e\u96c6\u662f\u7531\u591a\u4e2a\u6765\u6e90\u7684\u6570\u636e\u7ec4\u5408\u800c\u6210\u7684\uff0c\u8d28\u91cf\u5404\u4e0d\u76f8\u540c\u3002", "1e247e9a78534e2af97043359781beb6": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u67ec\u57d4\u5be8</strong>\u571f\u5730\u8986\u88ab\u6570\u636e\u96c6\u3002", "860e76bd7f189671b8993bf28feb6c9c": "\u6b64\u6570\u636e\u96c6\u5305\u62ec\u51e0\u79cd\u4e0d\u540c\u7c7b\u578b\u7684\u7279\u8bb8\uff1a<br>\u7ecf\u6d4e\u7528\u5730\u7279\u8bb8\u2014\u2014\u6570\u636e\u96c6\u4e2d\u6709 250 \u4e2a\u7279\u8bb8<br>\u7ecf\u6d4e\u7279\u533a\u2014\u2014\u6570\u636e\u96c6\u4e2d\u6709 23 \u4e2a\u7279\u8bb8<br>\u5265\u79bb\u7684\u7279\u8bb8\uff1a\u524d\u56fd\u6709\u6a61\u80f6\u79cd\u690d\u56ed\uff0c\u53ef\u8ffd\u6eaf\u5230\u6cd5\u56fd\u6b96\u6c11\u65f6\u671f\uff0c\u5df2\u4e8e 2005 \u5e74\u5de6\u53f3\u5265\u79bb \uff08\u5373\u79c1\u6709\u5316\uff09\uff0c\u6570\u636e\u96c6\u4e2d\u6709 8 \u4e2a\u7279\u8bb8<br>\u65c5\u6e38\u7279\u8bb8\uff1a\u4ee5\u65c5\u6e38\u4e1a\u4e3a\u4e3b\u8981\u76ee\u7684\u7684\u56fd\u5bb6\u79df\u8d41\u7279\u8bb8\uff0c\u6570\u636e\u96c6\u4e2d\u6709 5 \u4e2a\u7279\u8bb8<br>\u5176\u4ed6\uff1a\u4e0d\u5c5e\u4e8e\u4e0a\u8ff0\u4efb\u4f55\u7c7b\u522b\u7684\u56fd\u5bb6\u79df\u8d41\u7279\u8bb8\uff0c\u6570\u636e\u96c6\u4e2d\u6709 15 \u4e2a\u7279\u8bb8", "248a23eece907402afdbbc437a0f7d9b": "\u8be5\u6570\u636e\u96c6\u663e\u793a\u4e86\u81ea 1995 \u5e74\u4ee5\u6765\u67ec\u57d4\u5be8\u653f\u5e9c\u6388\u4e88\u7684\u571f\u5730\u7279\u8bb8\u6743\u3002", "45664af3fc2d558b74e40709d29a757b": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u67ec\u57d4\u5be8</strong>\u6c14\u5019\u6570\u636e\u96c6\u3002", "fa03bbe7068c6a0bbf3d3c733ff63867": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u6d2a\u90fd\u62c9\u65af</strong>\u68ee\u6797\u53d8\u5316\u6570\u636e\u96c6\u3002", "fb8e3b2b44db508e00ccf8ad725a4322": "\u5370\u5ea6\u5c3c\u897f\u4e9a\u6797\u4e1a\u90e8 2020 \u5e74\u7b2c\u4e00\u671f PIPPIB \u539f\u59cb\u5929\u7136\u6797\u548c\u6ce5\u70ad\u5730\u5730\u56fe", "ccdd365f7ef69053925ef390026dbf9d": "\u6ce5\u70ad\u5730", "ba819f30a02ca06fcafffa75d4b26a29": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u5229\u6bd4\u91cc\u4e9a</strong>\u571f\u5730\u8986\u88ab\u6570\u636e\u96c6\u3002", "5ea4a8a7ba2c35076865ba287b12548a": "\u5355\u51fb\u5e76\u7c98\u8d34 HTML \u4ee5\u5d4c\u5165\u7f51\u7ad9", "e04691c26d0039345030e57ed73c59b4": "\u706b\u9669\u6c14\u8c61\u6307\u6570 (FWI) \u63d0\u4f9b\u4e86\u53c2\u8003\u71c3\u6599\u7c7b\u578b\u548c\u6c34\u5e73\u5730\u5f62\u4e2d\u9694\u706b\u5e26\u5f3a\u5ea6\u7684\u603b\u4f53\u8bc4\u7ea7\u3002FWI \u7684\u8ba1\u7b97\u9700\u7ed3\u5408\u521d\u59cb\u8513\u5ef6\u6307\u6570 (ISI) \u548c\u53ef\u71c3\u7269\u603b\u91cf\u6307\u6570 (BUI)\u3002\u82e5\u503c\u5927\u4e8e 50\uff0c\u5219\u8ba4\u4e3a\u662f\u6781\u5371\u3002", "935549bd8989979b23be2f51b480021b": "\u4fdd\u62a4\u533a/\u81ea\u7136\u4fdd\u62a4\u533a", "f41d7b6357f8f9b7c9149db23a79a85c": "\u6d77\u6d0b\u4fdd\u62a4\u533a", "a8e4e771bcf9b402b7135dd0ed39dd4e": "\u53ef\u8f6c\u6362\u751f\u4ea7\u6797", "9636ad6cf7865e22fd55f870aa60b650": "Kawasan hutan Indonesia / \u5370\u5ea6\u5c3c\u897f\u4e9a\u68ee\u6797\u9762\u79ef", "3047aaaf688669cb98145fa61e3d95c5": "\u8868\u793a\u5370\u5c3c\u653f\u5e9c\u5212\u5b9a\u7684\u5408\u6cd5\u6797\u533a", "bd2ae22d8a4d05249b038febc40c1e85": "\u8fd9\u4e9b\u6570\u636e\u4ec5\u4ee3\u8868\u4f9d\u6cd5\u5212\u5b9a\u7684\u68ee\u6797\u9762\u79ef\u3002\u5b83\u4eec\u6ca1\u6709\u663e\u793a\u5b9e\u9645\u7684\u68ee\u6797\u8986\u76d6\u7387\u3002", "65cf1ed858770dd7e86d36a1a7cb964c": "\u4ec5\u4f9b\u67e5\u770b\uff0c\u4e0d\u53ef\u4e0b\u8f7d", "3f7f9184864532d52e7d2253774e6b24": "2020 \u5e74 4 \u6708 23 \u65e5", "9b453a622d6d8b6dd1ab2ab2947f19d7": "\u7b2c\u4e00\u5f20\u6307\u793a\u6027\u6682\u505c\u5730\u56fe (IMM) \u7531\u6797\u4e1a\u90e8\u4e8e 2011 \u5e74 7 \u6708\u53d1\u5e03\u3002IMM \u9700\u8981\u6bcf\u516d\u4e2a\u6708\u4fee\u8ba2\u4e00\u6b21\u3002\u8be5\u6570\u636e\u96c6\u663e\u793a\u4e86 2020 \u5e74\u7b2c\u4e00\u671f\u7ec8\u6b62\u9881\u53d1\u7528\u4e8e\u5f00\u53d1\u539f\u59cb\u5929\u7136\u6797\u548c\u6ce5\u70ad\u5730\u7684\u65b0\u8bb8\u53ef\u8bc1 (PIPPIB) \u7684\u6307\u793a\u6027\u5730\u56fe\u3002", "89c7bc1a1cdfb112030d63739e444358": "\u6c99\u5df4\u5dde\u6728\u6750\u79cd\u690d\u56ed\u8bb8\u53ef\u8bc1", "aed4e3b0e910e75eb7e672365e4061c9": "\u4e91\u96fe\u68ee\u6797 (Bosque mes\u00f3filo)", "7ca06dad11971d3edff2d8d838f44c0b": "2017 \u5e74 12 \u6708 - 2017 \u5e74 6 \u6708", "0c9a3521159f90c841600520f18986e4": "2020 \u5e74 9 \u6708", "fde3a167b138560bd90ac461806a6272": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u5229\u6bd4\u91cc\u4e9a</strong>\u6c14\u5019\u6570\u636e\u96c6\u3002", "4d3d769b812b6faa6b76e1a8abaece2d": "\u6d3b\u52a8", "4d630d8874bf8878f707cff635b458a3": "\u77ff\u4ea7\u52d8\u63a2\u8bb8\u53ef\u8bc1\u6570\u636e\u96c6\u7531 AidData \u6c47\u7f16\uff0cAidData \u6536\u96c6\u4e86\u5229\u6bd4\u91cc\u4e9a\u91c7\u6398\u4e1a\u900f\u660e\u5ea6\u5021\u8bae\u3001\u5229\u6bd4\u91cc\u4e9a\u56fd\u5bb6\u7279\u8bb8\u6743\u95e8\u6237\u7f51\u7ad9\u548c\u5229\u6bd4\u91cc\u4e9a\u91c7\u77ff\u5730\u7c4d\u4fe1\u606f\u7ba1\u7406\u7cfb\u7edf\u7684\u4fe1\u606f\u3002", "0b986bc9833754dcef248c87b5c486d7": "\u77ff\u4ea7\u5f00\u53d1\u534f\u8bae\u7531\u52d8\u63a2\u8bb8\u53ef\u8bc1\u6301\u6709\u8005\uff08\u5df2\u7ecf\u6536\u5230\u5e76\u5411\u653f\u5e9c\u63d0\u4f9b\u4e86\u4e00\u4efd\u4e3b\u7ba1\u4eba\u5458\u7684\u4e66\u9762\u610f\u89c1\uff0c\u5373\u52d8\u63a2\u533a\u7684\u4e00\u90e8\u5206\u5305\u542b\u52d8\u63a2\u8bb8\u53ef\u8bc1\u8303\u56f4\u5185\u7684\u63a8\u65ad\u77ff\u7269\u8d44\u6e90\uff09\u4e0e\u653f\u5e9c\u534f\u5546\u8fbe\u6210\u3002\u52d8\u63a2\u8bb8\u53ef\u8bc1\u6301\u6709\u4eba\u5411\u653f\u5e9c\u63d0\u51fa\u6b64\u8bf7\u6c42\uff0c\u4ee5\u5ef6\u957f\u548c\u4fee\u6539\u5176\u6839\u636e\u52d8\u63a2\u8bb8\u53ef\u8bc1\u4eab\u6709\u7684\u6743\u5229\uff0c\u5e76\u7b7e\u8ba2\u672c\u534f\u8bae\uff0c\u4ee5\u786e\u8ba4\u7ba1\u7406\u516c\u53f8\u5411 A \u7c7b\u5f00\u91c7\u8bb8\u53ef\u8bc1\u8fc7\u6e21\u4ee5\u53ca\u5176\u6839\u636e A \u7c7b\u91c7\u77ff\u8bb8\u53ef\u8bc1\u5f00\u5c55\u4e1a\u52a1\u7684\u6761\u6b3e\u548c\u6761\u4ef6\u3002MDA \u7684\u6761\u6b3e\u548c\u6761\u4ef6\u7531\u7ecf\u8425\u8005\u548c\u90e8\u9645\u77ff\u4ea7\u7279\u8bb8\u6743\u59d4\u5458\u4f1a\u7684\u653f\u5e9c\u4ee3\u8868\u6839\u636e\u300a\u77ff\u4ea7\u5f00\u53d1\u793a\u8303\u534f\u8bae\u300b\u4e2d\u89c4\u5b9a\u7684\u6807\u51c6\u534f\u5546\u5236\u5b9a\u3002", "4f51c2ba2b09e507c96d0d0727d891cb": "\u5229\u6bd4\u91cc\u4e9a\u77ff\u4ea7\u5f00\u53d1\u52d8\u63a2\u8bb8\u53ef\u8bc1", "2a91b5883aaf5c958d07fad34d519626": "\u5f00\u53d1\u52d8\u63a2\u8bb8\u53ef\u8bc1", "ba0ac1bf48101dd936c4fb6e20f9a28f": "\u5f00\u53d1\u52d8\u63a2\u8bb8\u53ef\u8bc1\u6570\u636e\u96c6\u7531 AidData \u6c47\u7f16\uff0cAidData \u6536\u96c6\u4e86\u5229\u6bd4\u91cc\u4e9a\u56fd\u5bb6\u7279\u8bb8\u6743\u95e8\u6237\u7f51\u7ad9\u548c\u5229\u6bd4\u91cc\u4e9a\u91c7\u77ff\u5730\u7c4d\u4fe1\u606f\u7ba1\u7406\u7cfb\u7edf\u7684\u4fe1\u606f\u3002", "9a3152e6fb7c5536841aaa196d05ceb4": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u9a6c\u6765\u897f\u4e9a</strong>\u68ee\u6797\u53d8\u5316\u6570\u636e\u96c6\u3002", "45b61bfde383f973e5686ef744bf2645": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u9a6c\u6765\u897f\u4e9a</strong>\u6c14\u5019\u6570\u636e\u96c6\u3002", "c23e68e66e429a7f120c0b3dd5efb64c": "\u663e\u793a\u5168\u7403 PM2.5 \u7a7a\u6c14\u8d28\u91cf\u6307\u6570\u3002", "5cdcff54cbf0f5b2b208faed4ce06b84": "2020 \u5e74 11 \u6708", "83d9e1b962faf19292572108e4ac7e6c": "2021 \u5e74 2 \u6708", "bfe93d8e39439219ff8468cd6ba95b11": "2021 \u5e74 4 \u6708", "bd445ba44c0a74ed39b00a9d3ca1aea6": "2022 \u5e74 4 \u6708", "40e502be50669a98363d0eb233de3e32": "2021 \u5e74 7 \u6708", "73c0865b87458c44ec75f99ec1fa5787": "2021 \u5e74 8 \u6708", "18bc42d51cf08cced0b61d5963023401": "\u7531 OSINFOR \u76d1\u7763", "67d79620fcd32562683f8b0e73591267": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u79d8\u9c81</strong>\u751f\u7269\u591a\u6837\u6027\u6570\u636e\u96c6\u3002", "514908f3914ead8774d780465f05cc56": "\u758f\u6797\u8349\u539f\u5f62\u6001", "5ed1a239ebbe89fa12801c72e3d1aa65": "\u7267\u573a\u548c\u519c\u4e1a\u5730", "f0b5591e0d012327149564b8f0d65e29": "\u6b64\u6570\u636e\u663e\u793a\u4e86\u67ec\u57d4\u5be8\u5df2\u77e5\u7684\u7279\u8bb8\u7528\u5730\u4f4d\u7f6e\uff0c\u5305\u62ec\u5927\u578b\u519c\u4e1a\u7ecf\u6d4e\u7279\u8bb8\u7528\u5730\u3001\u7ecf\u6d4e\u7279\u533a\u4ee5\u53ca\u5176\u4ed6\u56fd\u5bb6\u79df\u8ba9\u7279\u8bb8\u7528\u5730\u3002", "481aeb43894831c23b0acb41ffadd741": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u5df4\u897f</strong>\u68ee\u6797\u53d8\u5316\u6570\u636e\u96c6\u3002", "ef97b9477516a41027c1d5898bf35a17": "\u4eba\u9020\u6797", "61bfde6751cb845fe65d8cb3b23ed23e": "\u57ce\u5e02\u57fa\u7840\u8bbe\u65bd", "6fa05a6b1838bb1e5cea6828130d830a": "\u6c34\u4f53", "c9972bf5245233ed4b6414fcd2eaefc0": "\u6b64\u6570\u636e\u96c6\u8f7d\u6709\u67ec\u57d4\u5be8\u7ec4\u7ec7 LICADHO \u8bb0\u5f55\u7684\u7279\u8bb8\u6743\uff0c\u4f46\u5e76\u975e\u8be6\u5c3d\u65e0\u9057\u3002", "944df7e7bb9b32c13282efb51422c4f9": "\u67ec\u57d4\u5be8\u571f\u5730\u7279\u8bb8", "02dab7e983b0cdba6e9acdb47cfac5c2": "\u67ec\u57d4\u5be8\u571f\u5730\u7279\u8bb8\u6743 - 1995-2021", "f1489f71d8e7d8d66cd330e74e3b33e2": "\u7ecf\u6d4e\u571f\u5730\u7279\u8bb8\u6743", "128f9ec2968b41df8fd112777fb98fba": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u67ec\u57d4\u5be8</strong>\u751f\u7269\u591a\u6837\u6027\u6570\u636e\u96c6\u3002", "85a735fb1f5281af88aef726d93e0ea8": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u6d2a\u90fd\u62c9\u65af</strong>\u571f\u5730\u5229\u7528\u6570\u636e\u96c6\u3002", "ec67fe4d3513adf85b8d03af7f323a66": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u6d2a\u90fd\u62c9\u65af</strong>\u6c14\u5019\u6570\u636e\u96c6\u3002", "028513b01fc178eaf9229ad82f21491f": "\u571f\u5730\u8986\u88ab \u5370\u5ea6\u5c3c\u897f\u4e9a", "17f55d34c661513dacefca4269b0154c": "\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240\u7b80\u5316\u4e86\u6797\u4e1a\u90e8\u539f\u672c\u7684\u571f\u5730\u8986\u88ab\u5206\u7c7b\uff0c\u4ee5\u4fbf\u66f4\u597d\u5730\u8fdb\u884c\u5c55\u793a\u3002", "70f86d8d0fa109732262c26031a51738": "\u519c\u7530\uff1a\u5e84\u56ed\u79cd\u690d\u56ed\u3001\u65f1\u5730\u519c\u4e1a\u3001\u704c\u6728\u6df7\u5408\u65f1\u5730\u519c\u573a\u3001\u7a3b\u7530", "8c32bbb6db19f34ad77962bed769453f": "\u6e7f\u5730\uff1a\u6cbc\u6cfd\u3001\u6cbc\u6cfd\u704c\u6728", "b123e4d2a211aa6c1f3d5f23224e423c": "\u6b21\u751f\u6797", "3bb7cbc888fb0b9e8010b29b7415c7f3": "\u8349\u539f", "abac36a74672aefa3bebb4dbd621b749": "\u6c34\u4f53", "a2ec94845a342b82977282c157479ed7": "\u519c\u4e1a\u90e8", "a75084a8268e21ce2f20d9c5d5eb24c7": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u5370\u5ea6\u5c3c\u897f\u4e9a</strong>\u6c14\u5019\u6570\u636e\u96c6\u3002", "68321cd9e03c360d42d2e99a96fc3ab3": "\u6709\u9650\u751f\u4ea7\u6797", "907805146545e2b8cd40b80f2d73f961": "\u65e0\u6cd5\u83b7\u5f97\u7528\u4e8e\u751f\u6210\u6b64\u6570\u636e\u7684\u65b9\u6cd5\u7684\u786e\u5207\u5b9a\u4e49\u548c\u8bf4\u660e\u3002", "72f88f0667c3b276be3c3cc0f41d4c03": "\u6b21\u751f\u6797\uff1a\u6b21\u751f\u65f1\u5730\u6797\u3001\u6b21\u751f\u7ea2\u6811\u6797\u3001\u6b21\u751f\u6cbc\u6cfd\u6797", "9800db83d33cead82f468b93775eb404": "\u4eba\u5de5\u6797\uff1a\u4eba\u5de5\u6797", "00237029897a78f23dabd71b076a0150": "\u6797\u533a", "f553eb2849c3288a9c9cb657f1936a41": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u5229\u6bd4\u91cc\u4e9a</strong>\u751f\u7269\u591a\u6837\u6027\u6570\u636e\u96c6\u3002", "0a97e9be2126d07b8a6580a45c5ab67c": "\u77ff\u4ea7\u5f00\u53d1\u534f\u8bae", "708686948dad613bee3a2d2797670924": "\u751f\u4ea7\u6797", "e66b5a3c6799dcc5dd4039a58085fb38": "2017 \u5e74 9 \u6708", "c0535afa5c7e7c5386e501f33442f87a": "\u53ef\u4ece\u73af\u5883\u4e0e\u6797\u4e1a\u90e8 (Kementerian Lingkungan Hidup dan Kehutanan) \u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6570\u636e\u95e8\u6237\u7f51\u7ad9</a>\u8bbf\u95ee", "ca5fde06ffb38c626398671f85d14af7": "2011 \u5e74 5 \u6708\uff0c\u6797\u4e1a\u90e8\u6682\u505c\u9881\u53d1\u7528\u4e8e\u5f00\u53d1\u539f\u59cb\u5929\u7136\u6797\u548c\u6ce5\u70ad\u5730\u7684\u6797\u5730\u4f7f\u7528\u8bb8\u53ef\u8bc1\uff0c\u4e3a\u671f\u4e24\u5e74\u3002\u8fd9\u9879\u7981\u4ee4\u65e8\u5728\u8ba9\u653f\u5e9c\u6709\u65f6\u95f4\u6539\u8fdb\u571f\u5730\u4f7f\u7528\u89c4\u5212\u7a0b\u5e8f\uff0c\u52a0\u5f3a\u4fe1\u606f\u7cfb\u7edf\uff0c\u5e76\u5efa\u7acb\u673a\u6784\uff0c\u4ee5\u5b9e\u73b0\u5370\u5ea6\u5c3c\u897f\u4e9a\u7684\u4f4e\u6392\u653e\u53d1\u5c55\u76ee\u6807\u3002\u8fd9\u9879\u4e3a\u671f\u4e24\u5e74\u7684\u7981\u4ee4\u4e8e 2019 \u5e74\u518d\u6b21\u5ef6\u957f\uff0c\u5370\u5ea6\u5c3c\u897f\u4e9a\u5728\u4e0e\u632a\u5a01\u653f\u5e9c\u8fbe\u6210\u7684 10 \u4ebf\u7f8e\u5143\u534f\u8bae\u4e2d\u627f\u8bfa\u8981\u51cf\u5c11\u68ee\u6797\u780d\u4f10\uff0c\u800c\u8be5\u5ef6\u957f\u7684\u7981\u4ee4\u4fbf\u662f\u627f\u8bfa\u7684\u4e00\u90e8\u5206\u3002", "f150db2910f112ecbc5384d2f41f2b22": "\u8be5\u6570\u636e\u96c6\u7ed3\u5408\u4e86\u73af\u5883\u5f71\u54cd\u8bc4\u4f30 (EIA) \u62a5\u544a\u4e2d\u83b7\u5f97\u7684\u4e2a\u522b\u6cb9\u68d5\u548c LPF \u7279\u8bb8\u6743\uff08\u8de8\u8d8a\u4e0d\u540c\u65e5\u671f\uff09\u7684\u6cb9\u68d5\u8bb8\u53ef\u8bc1\u8fb9\u754c\uff0c\u4ee5\u53ca 2010 \u5e74\u7802\u62c9\u8d8a\u5317\u90e8\u7684\u5dde\u6797\u4e1a\u5c40\u533a\u57df\u5730\u56fe\u3002 \u4ece\u6cb9\u68d5 EIA \u62a5\u544a\u4e2d\u63d0\u53d6\u7684\u4fe1\u606f\u7531 Aidenvironment \u548c SADIA \u6c47\u7f16\uff0c\u5e76\u4e0e Earthsight Investigations \u7684\u5176\u4ed6\u4fe1\u606f\u76f8\u7ed3\u5408\u3002\u6839\u636e\u5df2\u516c\u5e03\u7684\u516c\u53f8\u8bb0\u5f55\u548c\u4e8c\u624b\u8d44\u6599\uff0c\u8bb8\u53ef\u8bc1\uff08\u548c\u88ab\u8bb8\u53ef\u4eba\u5b50\u516c\u53f8\uff09\u5f52\u5c5e\u4e8e\u4e3b\u8981\u516c\u53f8\u96c6\u56e2\u3002", "0bb90c6953ae5fe2e0445e64c9ceea40": "0% \u4e91\u8986\u76d6\u7387", "aed74d48b7bdba5a7dc784c107cd57ae": "\u8bc6\u522b\u706b\u707e\u9020\u6210\u7684\u6797\u6728\u6d41\u5931\u533a\u57df\u3002", "6987e43b3dce40300885b3f98123274d": "\u6a21\u578b\u671f\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u91cf\u548c\u6e05\u9664\u91cf\u4e4b\u95f4\u7684\u5e73\u8861\u3002", "3259a62a0961b9c1dd5e0a29d1af7744": "\u5174\u8da3\u8303\u56f4", "46a371ccd6de901e47f71a8837c64821": "2017 \u5e74 6 \u6708 - 2017 \u5e74 12 \u6708", "e47f45eeb1878341ccdc62ff2db85f19": "2019 \u5e74 12 \u6708 - 2020 \u5e74 6 \u6708", "29a3a10a3ed12f780607362ec5135323": "\u77ff\u4ea7\u52d8\u63a2\u8bb8\u53ef\u8bc1", "9fb832e1a74a24b2395a917910142c9a": "\u5176\u4ed6\u571f\u5730\uff1a\u88f8\u5730\u3001\u9c7c\u5858\u3001\u673a\u573a/\u6e2f\u53e3\u3001\u77ff\u533a", "d7f0b7e64f247ba601e113e50b73b801": "\u6c34\u4f53\uff1a\u6c34\u4f53", "f9e1acff8b5aa652169f4639bb5adafb": "Earthsight \u6839\u636e\u6c99\u5df4\u6797\u4e1a\u5c40 (SFD) \u5728\u5176 2014 \u5e74\u5e74\u5ea6\u62a5\u544a\u4e2d\u53d1\u5e03\u7684\u201c\u6c99\u5df4\u68ee\u6797\u4fdd\u62a4\u533a\u548c\u5176\u4ed6\u6797\u5730\u201d\u5730\u56fe\u5bf9\u8fb9\u754c\u8fdb\u884c\u4e86\u6570\u5b57\u5316\u5904\u7406\uff0c\u8be5\u5730\u56fe\u4e5f\u53ef\u5728 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">SFD \u7f51\u7ad9</a>\u4e0a\u627e\u5230\uff08 2015 \u5e74 12 \u6708\u8bbf\u95ee\uff09\u3002Earthsight \u6839\u636e SFD \u5e74\u5ea6\u62a5\u544a\u548c\u5176\u4ed6\u51fa\u7248\u7269\u4e2d\u7684\u5730\u56fe\u548c\u88ab\u8bb8\u53ef\u4eba\u5217\u8868\u83b7\u5f97\u4e86\u4e2a\u4eba\u8bb8\u53ef\u8bc1\u6301\u6709\u8005\u7684\u8bb8\u53ef\u8bc1\u53f7\u548c\u8eab\u4efd\u3002", "c69648e56627fc2a934ed3836a092b09": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u58a8\u897f\u54e5</strong>\u6c14\u5019\u6570\u636e\u96c6", "51abdf21c2967c24b1ea307b84a88757": "1:50,000 \u6bd4\u4f8b\u5c3a", "3dfbc0aef443e0942ccae871b94ad6b0": "2013-2014 \u5e74\u58a8\u897f\u54e5\u68ee\u6797\u8986\u76d6\u7387", "03352c229ff55323bb162ea419dff4ca": "\u6df7\u4ea4\u6797 (Con\u00edferas y latifoliadas)", "6a69417ca384baa460bf77f9c0d73e72": "\u9488\u53f6\u6797 (Con\u00edferas)", "507f670ff3472f66affa03260c1cd439": "\u7ea2\u6811\u6797 (Manglar)", "3ad823aad466c51dbdd937324fe9c1ff": "\u9614\u53f6\u6797 (Latifoliadas)", "602ce8890df2210f9bfccf3bbeb75f64": "\u663e\u793a\u957f\u8fbe 12 \u4e2a\u6708\u7684\u70e7\u6bc1\u533a\u57df\u6570\u636e\u3002", "f81fc7ca25fdce1327d28911f01212a3": "\u663e\u793a 2000 \u5e74\u548c 2020 \u5e74\u7684\u5168\u7403\u6797\u51a0\u9ad8\u5ea6\u3002", "0e09d4306781c704b6bcfd1db59905f4": "2015 \u5e74 6 \u6708 - 2016 \u5e74 12 \u6708", "f0d3deb6d2c0db949dd1a96eafa0a622": "2016 \u5e74 12 \u6708 - 2017 \u5e74 6 \u6708", "3b14b20ca4ec899310f73a9bb10d98f8": "2019 \u5e74 6 \u6708 - 2019 \u5e74 12 \u6708", "b77ff4334bae6cb5dbfb538ea3f1236c": "2021 \u5e74 10 \u6708", "e8c1328e44c5c12b7ed769f723dc99af": "2022 \u5e74 1 \u6708", "7180067baaad69df0d3d94537d3afe8b": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u79d8\u9c81</strong>\u68ee\u6797\u53d8\u5316\u6570\u636e\u96c6\u3002", "a1ab5b53b6b964486d4c17700c2af139": "\u672a\u53d7\u76d1\u7763", "3d4e5f7bf98a5cd8af781566b95f7eea": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u79d8\u9c81</strong>\u6c14\u5019\u6570\u636e\u96c6\u3002", "b063a25e2d42f2b54d69737e9d8e8a77": "\u68ee\u6797\u5f62\u6001", "22021e4c23a69311fe9580a9efaf56d0": "\u975e\u68ee\u6797\u6e7f\u5730", "79a364e69676684d8dc1404298e41cda": "\u6d77\u6ee9\u548c\u6c99\u4e18", "06b535ccd1955f6c61740152b97975ba": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u67ec\u57d4\u5be8</strong>\u68ee\u6797\u53d8\u5316\u6570\u636e\u96c6\u3002", "bf0fbec01532d137f86766f6af645c3d": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u5229\u6bd4\u91cc\u4e9a</strong>\u68ee\u6797\u53d8\u5316\u6570\u636e\u96c6\u3002", "183d2397d4c4d60de738135f256f1c76": "2021 \u5e74 9 \u6708", "1bd223db13c5eec1eacfd690e9f8edfd": "2020 \u5e74 10 \u6708", "37509c938120fe7a4d3c3dc98585d424": "2020 \u5e74 12 \u6708", "323e5eb8cc9964d8d5e4ce16393515c0": "2021 \u5e74 12 \u6708", "f0c9d93360d6797a9b44299090192022": "2022 \u5e74 2 \u6708", "b52222842d1302ab6e8c5fd474713cc3": "2021 \u5e74 3 \u6708", "0933d4dd2ad52707372be6b67b620890": "2021 \u5e74 5 \u6708", "2ac0c29434b2049814dcaff0f468893e": "\u8be5\u56fe\u5c42\u663e\u793a\u4e86\u6309\u7c7b\u578b\u5206\u7c7b\u7684 2017 \u5e74\u571f\u5730\u8986\u88ab\u3002\u6570\u636e\u6765\u6e90\u4e8e\u73af\u5883\u4e0e\u6797\u4e1a\u90e8 2017 \u5e74\u6570\u636e\uff081:250,000 \u6bd4\u4f8b\u5c3a\uff09\u3002\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240\u5bf9\u73af\u5883\u4e0e\u6797\u4e1a\u90e8\u6570\u636e\u96c6\u4e2d\u7684\u539f\u59cb\u571f\u5730\u8986\u88ab\u7c7b\u522b\u8fdb\u884c\u4e86\u91cd\u65b0\u5206\u7c7b\uff0c\u4ee5\u4fbf\u5728 Suitability Mapper (2012) \u4e2d\u4f7f\u7528\uff0c\u5177\u4f53\u5206\u4e3a\u4ee5\u4e0b\u51e0\u7c7b\uff1a", "10c061aa7cf542d9ddeca539090dece8": "\u539f\u751f\u6797\uff1a\u539f\u751f\u65f1\u5730\u6797\u3001\u539f\u751f\u7ea2\u6811\u6797\u3001\u539f\u751f\u6cbc\u6cfd\u6797", "d85e48bfdfdb7dcafddec0055165a5e6": "\u8349\u5730\uff1a\u77ee\u6811\u4e1b/\u704c\u6728\u4ece\u3001\u7a00\u6811\u8349\u539f", "c0c2d3643a0ea072265f3c10c3e7b12b": "\u5370\u5ea6\u5c3c\u897f\u4e9a 2017 \u5e74\u571f\u5730\u8986\u88ab", "83dd3da7fe26b670c8900dff45d0e3f8": "\u5176\u4ed6\u571f\u5730", "ed72c67cb13ba01748d08c37e5d943f3": "\u805a\u5c45\u5730", "20127aeb9326ca9053e0f76521596355": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u6d2a\u90fd\u62c9\u65af</strong>\u751f\u7269\u591a\u6837\u6027\u6570\u636e\u96c6\u3002", "63799736fba5a0d532f24c04ef4dad42": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u5370\u5ea6\u5c3c\u897f\u4e9a</strong>\u68ee\u6797\u53d8\u5316\u6570\u636e\u96c6\u3002", "45e246d33ca920b5385656d0fe811c65": "2021 \u5e74 11 \u6708", "2d4fadbc7be2c33cc544d39f60e1395b": "2021 \u5e74 1 \u6708", "638ba43a82543378fa7768693f43f86a": "2022 \u5e74 3 \u6708", "472bdf31c0a3dde6325c7f61702d7f57": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u79d8\u9c81</strong>\u571f\u5730\u8986\u88ab\u6570\u636e\u96c6\u3002", "a653ae5284f2127e1a6c6a8dd06cb595": "\u5176\u4ed6\u975e\u68ee\u6797\u690d\u88ab", "3fe069410e62217ddbb5c0263921eec7": "\u67ec\u57d4\u5be8\u571f\u5730\u7279\u8bb8", "c3c557f9be3a3f55ee9abfd181e8898f": "\u805a\u5c45\u5730\uff1a\u79fb\u6c11\u533a\u3001\u805a\u5c45\u533a", "65d26b188580026b00ec4edb88005acb": "\u672a\u77e5\uff1a\u4e91", "f731adf17f0dda45b05e16575b52a790": "\u519c\u7530", "ff6f37af348474cbbac8be639546079c": "\u53d7\u4fdd\u62a4\u7684\u68ee\u6797", "bf45eee2bc207cb12ec27599b948e7a7": "\u5176\u4ed6\u4f7f\u7528\u533a", "a1e0f26c2229e91457d057d251f135ac": "\u53ef\u9881\u53d1\u52d8\u63a2\u8bb8\u53ef\u8bc1\u7684\u5730\u5757\u5e94\u4e3a\u4e0d\u8d85\u8fc7<br> 1000 \u5e73\u65b9\u516c\u91cc\u7684\u672a\u5360\u7528\u8fde\u7eed\u533a\u5757\uff0c\u52d8\u63a2\u8bb8\u53ef\u8bc1\u7684\u9996\u6b21\u6709\u6548\u671f\u4e3a 3 \u5e74\uff0c\u5982\u679c\u6301\u6709\u4eba\u9075\u5b88\u300a\u91c7\u77ff\u6cd5\u300b\u548c\u300a\u77ff\u4ea7\u52d8\u63a2\u6761\u4f8b\u300b\u7684\u6761\u6b3e\u548c\u6761\u4ef6\uff0c\u5219\u53ef\u4ee5\u518d\u5ef6\u957f 2 \u5e74\u3002\u6301\u6709\u4eba\u4e0e\u653f\u5e9c\u4e4b\u95f4\u5fc5\u987b\u7b7e\u8ba2\u52d8\u63a2\u534f\u8bae\uff0c\u5e76\u4e14\u5fc5\u987b\u5728\u6388\u4e88\u8bb8\u53ef\u8bc1\u540e\u7684 90 \u5929\u5185\u5c06\u62df\u8bae\u7684\u5de5\u4f5c\u8ba1\u5212\u63d0\u4ea4\u7ed9\u90e8\u957f\u3002\u5728\u8bb8\u53ef\u8bc1\u671f\u6ee1\u65f6\u6216\u671f\u6ee1\u524d\uff0c\u6301\u6709\u4eba\u53ef\u4ee5\u9009\u62e9\u4fdd\u7559\u6574\u4e2a\u52d8\u63a2\u533a\u6216\u5176\u4efb\u4f55\u90e8\u5206\u4f5c\u4e3a\u62df\u8bae\u751f\u4ea7\u533a\uff0c\u6216\u5728\u52d8\u63a2\u8bb8\u53ef\u8bc1\u9996\u6b21\u6709\u6548\u671f\u671f\u6ee1\u65f6\uff0c\u653e\u5f03\u81f3\u5c11 50% \u7684\u539f\u59cb\u52d8\u63a2\u533a\u540e\u7533\u8bf7\u5ef6\u957f\u52d8\u63a2\u8bb8\u53ef\u8bc1\u3002\u52d8\u63a2\u6743\u4e0d\u5305\u62ec\u8fdb\u884c\u5927\u91cf\u53d6\u6837\u6216\u8bd5\u91c7\u7684\u6743\u5229\uff0c\u6301\u6709\u4eba\u4ec5\u9650\u4e8e\u5728\u5176\u5212\u5b9a\u7684\u533a\u57df\u5185\u8fdb\u884c\u77ff\u4ea7\u52d8\u63a2\u3002\u5fc5\u987b\u9075\u5b88\u300a\u91c7\u77ff\u6cd5\u300b\u548c\u300a\u77ff\u4ea7\u52d8\u63a2\u6761\u4f8b\u300b\u4e2d\u89c4\u5b9a\u7684\u5176\u4ed6\u6761\u6b3e\u548c\u6761\u4ef6\u3002", "a4c162c0b74afa3e25f7d7066992dcf1": "\u663e\u793a\u5168\u7403\u6ce5\u70ad\u5730\u533a\u57df\u3002", "1698d7637a0af3f309998c8d179a3bcf": "2015 \u5e74 12 \u6708 - 2016 \u5e74 6 \u6708", "b4956fe56b8b881b6706546c0ba5a315": "2018 \u5e74 6 \u6708 - 2018 \u5e74 12 \u6708", "23f469559b2ee85f2ff8117df3de4999": "2018 \u5e74 12 \u6708 - 2019 \u5e74 6 \u6708", "0596f7544f0424f43bd24ad6cda80723": "2020 \u5e74 6 \u6708 - 2020 \u5e74 9 \u6708", "b56a5394775a9f077c12cb3e770d913c": "2022 \u5e74 5 \u6708", "bb98d7b257f22cf59230803454c96d55": "\u53ef\u9881\u53d1\u52d8\u63a2\u8bb8\u53ef\u8bc1\u7684\u5730\u5757\u5e94\u4e3a\u4e0d\u8d85\u8fc7 1000 \u5e73\u65b9\u516c\u91cc\u7684\u672a\u5360\u7528\u8fde\u7eed\u533a\u5757\uff0c\u52d8\u63a2\u8bb8\u53ef\u8bc1\u7684\u9996\u6b21\u6709\u6548\u671f\u4e3a 3 \u5e74\uff0c\u5982\u679c\u6301\u6709\u4eba\u9075\u5b88\u300a\u91c7\u77ff\u6cd5\u300b\u548c\u300a\u77ff\u4ea7\u52d8\u63a2\u6761\u4f8b\u300b\u7684\u6761\u6b3e\u548c\u6761\u4ef6\uff0c\u5219\u53ef\u4ee5\u518d\u5ef6\u957f 2 \u5e74\u3002\u6301\u6709\u4eba\u4e0e\u653f\u5e9c\u4e4b\u95f4\u5fc5\u987b\u7b7e\u8ba2\u52d8\u63a2\u534f\u8bae\uff0c\u5e76\u4e14\u5fc5\u987b\u5728\u6388\u4e88\u8bb8\u53ef\u8bc1\u540e\u7684 90 \u5929\u5185\u5c06\u62df\u8bae\u7684\u5de5\u4f5c\u8ba1\u5212\u63d0\u4ea4\u7ed9\u90e8\u957f\u3002\u5728\u8bb8\u53ef\u8bc1\u671f\u6ee1\u65f6\u6216\u671f\u6ee1\u524d\uff0c\u6301\u6709\u4eba\u53ef\u4ee5\u9009\u62e9\u4fdd\u7559\u6574\u4e2a\u52d8\u63a2\u533a\u6216\u5176\u4efb\u4f55\u90e8\u5206\u4f5c\u4e3a\u62df\u8bae\u751f\u4ea7\u533a\uff0c\u6216\u5728\u52d8\u63a2\u8bb8\u53ef\u8bc1\u9996\u6b21\u6709\u6548\u671f\u671f\u6ee1\u65f6\uff0c\u653e\u5f03\u81f3\u5c11 50% \u7684\u539f\u59cb\u52d8\u63a2\u533a\u540e\u7533\u8bf7\u5ef6\u957f\u52d8\u63a2\u8bb8\u53ef\u8bc1\u3002\u52d8\u63a2\u6743\u4e0d\u5305\u62ec\u8fdb\u884c\u5927\u91cf\u53d6\u6837\u6216\u8bd5\u91c7\u7684\u6743\u5229\uff0c\u6301\u6709\u4eba\u4ec5\u9650\u4e8e\u5728\u5176\u5212\u5b9a\u7684\u533a\u57df\u5185\u8fdb\u884c\u77ff\u4ea7\u52d8\u63a2\u3002\u5fc5\u987b\u9075\u5b88\u300a\u91c7\u77ff\u6cd5\u300b\u548c\u300a\u77ff\u4ea7\u52d8\u63a2\u6761\u4f8b\u300b\u4e2d\u89c4\u5b9a\u7684\u5176\u4ed6\u6761\u6b3e\u548c\u6761\u4ef6\u3002", "38a6a75e401f863b41c09c3821f6fc41": "\u300a\u77ff\u4ea7\u5f00\u53d1\u534f\u8bae\u300b\u6570\u636e\u96c6\u7531 AidData \u6c47\u7f16\uff0cAidData \u6536\u96c6\u4e86\u5229\u6bd4\u91cc\u4e9a\u91c7\u6398\u4e1a\u900f\u660e\u5ea6\u5021\u8bae\u3001\u5229\u6bd4\u91cc\u4e9a\u56fd\u5bb6\u7279\u8bb8\u6743\u95e8\u6237\u7f51\u7ad9\u548c\u5229\u6bd4\u91cc\u4e9a\u91c7\u77ff\u5730\u7c4d\u4fe1\u606f\u7ba1\u7406\u7cfb\u7edf\u7684\u4fe1\u606f\u3002", "044abc0226deaf6a8dc22ec0ff3781da": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u9a6c\u6765\u897f\u4e9a</strong>\u571f\u5730\u8986\u88ab\u6570\u636e\u96c6\u3002", "91f94cd3ee0914bb118018d96aa09af0": "\u6ca1\u6709\u53ef\u7528\u7684<strong>\u9a6c\u6765\u897f\u4e9a</strong>\u751f\u7269\u591a\u6837\u6027\u6570\u636e\u96c6\u3002", "5bd769738f51398ffb760d9d0fdc51c9": "\u636e\u4e86\u89e3\uff0c\u6b64\u5730\u56fe\u4e0d\u5b8c\u6574\uff0c\u5e76\u4e14\u67d0\u4e9b\u8fb9\u754c\u4e5f\u4e0d\u7cbe\u786e\u3002\u5730\u56fe\u4e2d\u6ca1\u6709\u5305\u62ec 2010 \u5e74\u4e4b\u540e\u53d1\u5e03\u6216\u516c\u5e03\u7684\u73af\u5883\u5f71\u54cd\u8bc4\u4f30 (EIA) \u7684\u6cb9\u68d5\u7279\u8bb8\u6743\u3002 \u6839\u636e EIA \u62a5\u544a\u7ed8\u5236\u7684\u8fb9\u754c\u5c1a\u4e0d\u7cbe\u786e\uff0c\u56e0\u6b64\u53ef\u80fd\u4e0e\u536b\u661f\u56fe\u50cf\u4e2d\u6240\u793a\u7684\u780d\u4f10\u548c\u79cd\u690d\u60c5\u51b5\u4e0d\u5339\u914d\u3002\u81ea\u6765\u6e90\u8d44\u6599\u516c\u5e03\u4ee5\u6765\uff0c\u4e0e\u8fd9\u4e9b\u7279\u8bb8\u6743\u6709\u5173\u7684\u8fb9\u754c\u548c\u76f8\u5173\u4fe1\u606f\u4e5f\u53ef\u80fd\u53d1\u751f\u4e86\u53d8\u5316\u3002", "42c0333ed769ee39e0ede7fc568ed96e": "\u8be5\u6570\u636e\u96c6\u63d0\u4f9b\u4e86\u9a6c\u6765\u897f\u4e9a\u7802\u62c9\u8d8a\u5dde\u5df2\u77e5\u6cb9\u68d5\u7279\u8bb8\u6743\u7684\u8fb9\u754c\uff0c\u5e76\u6839\u636e\u73b0\u6709\u516c\u5f00\u6587\u4ef6\u6c47\u7f16\u800c\u6210\u3002\u5728\u53ef\u80fd\u7684\u60c5\u51b5\u4e0b\uff0c\u6b64\u6570\u636e\u96c6\u63d0\u4f9b\u7684\u76f8\u5173\u4fe1\u606f\u5305\u62ec\u88ab\u8bb8\u53ef\u4eba\u59d3\u540d\u3001\u8bb8\u53ef\u8bc1\u53f7\uff08\u8fd0\u8425\u7968\u8bc1\uff09\u3001\u516c\u53f8\u5206\u7ec4\u3001\u8bb8\u53ef\u8bc1\u65e5\u671f\u548c\u5b98\u65b9\u8bb8\u53ef\u533a\u57df\u3002\u8be5\u6570\u636e\u96c6\u8fd8\u5305\u62ec\u6839\u636e\u4eba\u5de5\u6797\u8bb8\u53ef\u8bc1 (LPF) \u534f\u8bae\u5df2\u79cd\u690d\u4e00\u8f6e\u6cb9\u68d5\u7684\u533a\u57df\uff08\u5982\u679c\u63d0\u4f9b\uff09", "ae4c7dc358ac2757037fc3d531f1e1fb": "\u672c\u6570\u636e\u96c6\u5305\u542b\u7684\u7ba1\u7406\u8bb8\u53ef\u533a\u57df\u5185\u7684\u90e8\u5206\u5929\u7136\u6797\u533a\u57df\u88ab\u5212\u4e3a\u53ef\u8f6c\u6362\u4e3a\u4eba\u5de5\u6797\u7684\u533a\u57df\u3002\u9664\u4e86 FMU7 \u5185\u7684 Sabah Forest Industries\uff08\u5305\u542b\u5728\u6c99\u5df4\u5dde\u5355\u72ec\u7684\u201c\u6728\u6750\u79cd\u690d\u56ed\u201d\u6570\u636e\u96c6\u4e2d\uff09\u4e4b\u5916\uff0c\u8fd9\u91cc\u6240\u793a\u7684\u68ee\u6797\u7ba1\u7406\u8bb8\u53ef\u8bc1\u8303\u56f4\u5185\u7684\u533a\u57df\u6ca1\u6709\u8fb9\u754c\u6570\u636e\u53ef\u4f9b\u8f6c\u6362\u3002", "8161372c2a225aa337042998f38c0d9d": "\u58a8\u897f\u54e5\u68ee\u6797\u8986\u76d6", "369c2619ed04b37a90183c35562fb83d": "\u6211\u4eec\u5728\u8fd9\u91cc\u5c55\u793a\u4e86\u6574\u4e2a\u58a8\u897f\u54e5\u4e00\u822c\u7684\u68ee\u6797\u8986\u76d6\u7c7b\u578b\u3002\u6709\u5173\u6bcf\u4e2a\u58a8\u897f\u54e5\u5dde\u548c\u5b50\u7c7b\u522b\u7684\u65b9\u6cd5\u7684\u66f4\u591a\u8be6\u7ec6\u4fe1\u606f\u53ef\u5728 CONAFOR\u7684 \u95e8\u6237\u7f51\u7ad9<br><a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\"> eMapas </a>\u4e0a\u627e\u5230\u3002", "11308562531235451e5f451ae6fbea52": "\u5168\u7403\u539f\u751f\u6797\u635f\u5931", "150b6fb44f0935cfbdc406444ac74458": "\u6309\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\u5206\u5217\u7684\u5168\u7403\u5e74\u5ea6\u68ee\u6797\u8986\u76d6\u51cf\u5c11", "53dac59adbfecca2f0f53f8cf0e59743": "\u5168\u7403\u6bcf\u5e74\u6797\u6728\u8986\u76d6\u635f\u5931", "494d9d658bb56641c280482c61e70829": "\u5168\u7403\u6797\u6728\u8986\u76d6\u589e\u957f", "52da65197385788ef44c4f9810be3abb": "\u5168\u7403\u6811\u6728\u8986\u76d6", "bcd335f972621d4360ee8eaf014beb13": "\u5168\u7403\u539f\u751f\u6797", "20bb08a1fea745094fbdb50963fdcf7c": "\u5168\u7403 FAO \u68ee\u6797\u8986\u76d6", "0f0a727d7f593ff20a2f3f00f2fb8b59": "\u5168\u7403 FAO \u518d\u9020\u6797", "1a4bca9a1294b56134410810ba2f289c": "\u5168\u7403\u6811\u6728\u8986\u76d6\u635f\u5931", "64ecc28d3f25f38e6201ce154ea683d5": " FAO \u5168\u7403\u68ee\u6797\u780d\u4f10", "f47083b6c1192d5dd37d87674b7961ce": "\u5168\u7403\u706b\u70e7\u8ff9\u5730\u9762\u79ef\u6700\u5927\u7684\u533a\u57df", "29ef311a5920a7da262b6dbefbd2c8ac": "\u5168\u7403\u4e0e\u68ee\u6797\u6709\u5173\u7684\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf", "b80d4dcccbe913b4cd4c04fd8d20e37b": "\u8be5\u56fe\u663e\u793a\u4e86 2001 \u5e74\u81f3 2020 \u5e74\u68ee\u6797\u4e0e\u5927\u6c14\u4e4b\u95f4\u6e29\u5ba4\u6c14\u4f53\u7684\u5e74\u5e73\u5747<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6392\u653e\u91cf</a>\u3001<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6e05\u9664\u91cf</a>\u548c<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u51c0\u901a\u91cf</a>\u3002\u7528\u4e8e\u8ba1\u7b97\u8fd9\u4e9b\u6570\u636e\u7684\u65b9\u6cd5\u8bf7\u53c2\u89c1 <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. 2021</a> \u4e2d\u7684\u63cf\u8ff0\uff0c\u8be5\u6587\u7ae0\u4ecb\u7ecd\u4e86\u4e00\u4e2a\u7528\u4e8e\u4f30\u8ba1\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u7684\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\u3002\u8fd9\u4e9b\u65b9\u6cd5\u9075\u5faa IPCC <a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u6307\u5357\u3002\u6392\u653e\u6e90\u81ea\u7fa4\u4e1b\u66ff\u4ee3\u5e72\u6270\uff0c\u800c\u6e05\u9664\u5219\u53d1\u751f\u5728\u68ee\u6797\u5f97\u5230\u7ef4\u6301\u6216\u6269\u5927\u7684\u5730\u65b9\u3002\u6392\u653e\u5305\u62ec\u6240\u6709\u76f8\u5173\u7684\u751f\u6001\u7cfb\u7edf\u78b3\u5e93\uff08\u5730\u4e0a\u751f\u7269\u91cf\u3001\u5730\u4e0b\u751f\u7269\u91cf\u3001\u67af\u6728\u3001\u5783\u573e\u3001\u571f\u58e4\uff09\u548c\u6e29\u5ba4\u6c14\u4f53 (CO2, NH4, N2O)\uff0c\u800c\u6e05\u9664\u5219\u6d89\u53ca\u5730\u4e0a\u548c\u5730\u4e0b\u751f\u7269\u91cf\u5e93\u3002<br>\u56e0\u4e3a\u6e05\u9664\u91cf\u548c\u51c0\u901a\u91cf\u6570\u636e\u5e76\u975e\u6309\u65f6\u95f4\u5e8f\u5217\u63d0\u4f9b\uff0c\u6240\u4ee5\u8be5\u56fe\u663e\u793a\u6574\u4e2a\u6a21\u578b\u671f\u95f4\u7684\u5e73\u5747\u5e74\u6392\u653e\u91cf\u3001\u6e05\u9664\u91cf\u548c\u51c0\u901a\u91cf\u3002\u5728\u6b64\u56fe\u4e2d\uff0c\u4f7f\u7528\u6240\u6709\u6d41\u91cf\u7684\u7d2f\u79ef\u503c\u9664\u4ee5\u6a21\u578b\u8986\u76d6\u5e74\u6570\uff0c\u6765\u8ba1\u7b97\u6a21\u578b\u671f\u95f4\u7684\u5e74\u5e73\u5747\u6570\u3002\u7edf\u8ba1\u6570\u636e\u5305\u62ec\u9ad8\u4e8e\u6240\u9009\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u533a\u57df\uff0c\u4ee5\u53ca\u672a\u8fbe\u5230\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u4f46\u6811\u6728\u8986\u76d6\u7387\u589e\u52a0\u7684\u533a\u57df\u3002", "8455316f47af24ef7926bf47f3242a5f": "2001 \u5e74\uff0c{location} \u6709 {primaryForest} \u7247\u539f\u59cb\u68ee\u6797*\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684 {percentagePrimaryForest}\u3002{year} \u5e74\uff0c\u5b83\u635f\u5931\u4e86 {primaryLoss} \u539f\u59cb\u68ee\u6797*\uff0c\u76f8\u5f53\u4e8e {emissionsPrimary} \u7684 CO\u2082 \u6392\u653e\u91cf\u3002", "86521dee425858c53cc4938380b5f0e3": "{Location} \u56e0\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6bd4\u4f8b", "5ef6abcf99eebafd63131e43de6bc4a8": "\u5168\u7403\u68ee\u6797\u4f4d\u7f6e", "1c42acec7ffe70c6e504384a7d55f0af": "{location} \u56e0\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11", "febf70832a0648765866db7099677393": "\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11", "0bda6bab948f7fdd07605a8fa3f56c17": "2010 \u5e74\uff0c\u5168\u4e16\u754c\u6709 3.92Gha \u7684\u6811\u6728\u8986\u76d6\uff0c\u5360\u9646\u5730\u9762\u79ef\u7684 30% \u4ee5\u4e0a\u3002{Year} \u5e74\uff0c\u5168\u4e16\u754c\u51cf\u5c11\u4e86 25.3Mha \u7684\u6811\u6728\u8986\u76d6\u3002", "fb7a9104a49c687eb9e572bf61ff70f1": "{startYear} \u5e74\u81f3 {endYear} \u5e74\uff0c{topLocationLabel} \u56e0\u706b\u707e\u5bfc\u81f4\u6811\u6728\u8986\u76d6\u51cf\u5c11\u7684\u901f\u5ea6\u6700\u5feb\uff0c\u6bcf\u5e74\u5e73\u5747\u51cf\u5c11 {topLocationLossAverage}\u3002", "c15d289d5c484484e8913a9917c53cbd": "{startYear} \u5e74\u81f3 {endYear} \u5e74\uff0c<b>\u5168\u7403\u56e0\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11</b>\u603b\u91cf\u4e3a {treeCoverLossFires}\uff0c\u5176\u4ed6\u51cf\u5c11\u9a71\u52a8\u56e0\u7d20\u5bfc\u81f4\u7684\u6709 {treeCoverLossNotFires}\u3002\u5728\u6b64\u671f\u95f4\uff0c\u56e0\u706b\u707e\u5bfc\u81f4\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6700\u591a\u7684\u5e74\u4efd\u662f {highestYearFires} \u5e74\uff0c\u56e0\u706b\u707e\u51cf\u5c11\u4e86 {highestYearFiresLossFires}\u2014\u2014\u5360\u8be5\u5e74\u6811\u6728\u8986\u76d6\u51cf\u5c11\u603b\u91cf\u7684 {highestYearFiresPercentageLossFires}\u3002", "548d16d2775500430be811c73e1cd6a4": "\u5168\u7403\u56e0\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6bd4\u4f8b", "66880575b9de808aea8d423ebd2c6218": "\u4ec5\u9650\u4e8c\u6c27\u5316\u78b3\u6392\u653e", "9038f21d811e136c32087f761611f25a": "\u6240\u6709\u6c14\u4f53", "97b0cbbe6febc4f90911232dc58d1e4e": "\u975e\u4e8c\u6c27\u5316\u78b3\u6392\u653e", "db0c5b085b31818fb4c2335108397c63": "\u5370\u5ea6\u5c3c\u897f\u4e9a\u68ee\u6797\u9650\u5236\u53d1\u5c55\u533a\u57df", "b0367b1279349f0f4acd332b5e8a3d1c": "\u68ee\u6797\u76f8\u5173\u6e29\u5ba4\u6c14\u4f53\u6392\u653e", "1c07c563c8cc9e544a1c48d1abf1ecff": "\u663e\u793a\u6bcf\u5e74\u56e0\u6797\u5206\u66ff\u4ee3\u68ee\u6797\u5e72\u6270\u5bfc\u81f4\u7684\u6392\u653e", "78499cdc95bc9b807352c3699282d020": "\u2022 \u6392\u653e\u6570\u636e\u662f\u5efa\u6a21\u7684\u4ea7\u7269\uff0c\u56e0\u6b64\u5fc5\u7136\u5b58\u5728\u4e00\u5b9a\u7a0b\u5ea6\u7684\u8bef\u5dee\u548c\u4e0d\u786e\u5b9a\u6027\u3002\u5f3a\u70c8\u5efa\u8bae\u7528\u6237\u5728\u4f7f\u7528\u6570\u636e\u524d\u9605\u8bfb\u5e76\u5145\u5206\u7406\u89e3\u5143\u6570\u636e\u53ca\u5176\u4ed6\u53ef\u7528\u6587\u4ef6\u3002<br>\u2022 \u5404\u9879\u6392\u653e\u6570\u636e\u9002\u7528\u4e8e\u6797\u533a\uff08\u6811\u51a0\u8986\u76d6 &gt;30% \u5e76\u4e14\u9ad8\u5ea6 &gt;5 \u7c73\uff09\u4ee5\u53ca\u6709\u6811\u6728\u8986\u76d6\u589e\u52a0\u7684\u533a\u57df\u3002\u8bf7\u53c2\u89c1 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al.(2021)</a> \u4e86\u89e3\u6709\u5173\u8be5\u5206\u6790\u4e2d\u6240\u7528\u68ee\u6797\u5b9a\u4e49\u7684\u8fdb\u4e00\u6b65\u4fe1\u606f\u3002<br>\u2022 \u6392\u653e\u6570\u636e\u53cd\u6620 Landsat \u536b\u661f\u56fe\u50cf\u4e2d\u89c2\u5bdf\u5230\u7684\u6797\u5206\u66ff\u4ee3\u5e72\u6270\uff0c\u4e0d\u5305\u62ec\u6765\u81ea\u672a\u89c2\u5bdf\u5230\u7684\u68ee\u6797\u9000\u5316\u7684\u6392\u653e\u3002<br>\u2022 \u6392\u653e\u53cd\u6620\u7684\u662f\u603b\u91cf\u4f30\u8ba1\uff0c\u5373\u4e0d\u5305\u62ec\u6765\u81ea\u5e72\u6270\u540e\u53d1\u751f\u7684\u4efb\u4f55\u518d\u751f\u957f\u7684\u78b3\u6d88\u9664\u3002\u800c\u5728\u4f34\u968f\u68ee\u6797\u78b3\u6d88\u9664\u5c42\u4e2d\uff0c\u4f1a\u8003\u8651\u78b3\u6d88\u9664\u603b\u91cf\u3002<br>\u2022 2011 \u5e74\u81f3 2015 \u5e74\u95f4\uff0c\u56e0\u91c7\u7528\u65b0\u7684\u536b\u661f\u6570\u636e\u548c\u65b9\u6cd5\u53d8\u5316\u800c\u5b9e\u73b0\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u63a2\u6d4b\u6539\u8fdb\uff0c\u53ef\u80fd\u5bfc\u81f4\u8fd1\u5e74\u6bd4\u65e9\u5e74\u7684\u4f30\u8ba1\u503c\u9ad8\u3002<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8bf7\u53c2\u8003\u6b64\u5904</a>\u4ee5\u4e86\u89e3\u5176\u4ed6\u4fe1\u606f\u3002", "193acb79609723855d0c5a80d3eb50c4": "\u5168\u7403\u6bcf\u5e74\u56e0\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11", "876cc7b8862e523147eb799f4bb9d865": "{startYear} \u5e74\u81f3 {endYear} \u5e74\u671f\u95f4\uff0c{location} \u6811\u6728\u8986\u76d6\u51cf\u5c11\u7684 {lossFiresPercentage} \u5f52\u7f6a\u4e8e\u706b\u707e\u3002", "208bbc24bbceff432df79c7f306b2b08": "\u5176\u4ed6\u539f\u56e0\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11", "ba2662e9dc370cd0322dac307ac28e8a": "{startYear} \u5e74\u81f3 {endYear} \u5e74\u671f\u95f4\uff0c\u5168\u7403\u6811\u6728\u8986\u76d6\u51cf\u5c11\u7684 {lossFiresPercentage} \u5f52\u7f6a\u4e8e\u706b\u707e\u3002", "b87f1e3ce099c3f92110ab21cca15819": "\u5168\u7403\u56e0\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11", "5eabd29db66ed748ed5bacee2da75c10": "\u2022 \u6570\u636e\u662f\u5efa\u6a21\u7684\u4ea7\u7269\uff0c\u56e0\u6b64\u5fc5\u7136\u5b58\u5728\u4e00\u5b9a\u7a0b\u5ea6\u7684\u8bef\u5dee\u548c\u4e0d\u786e\u5b9a\u6027\u3002\u5f3a\u70c8\u5efa\u8bae\u7528\u6237\u5728\u4f7f\u7528\u6570\u636e\u524d\u9605\u8bfb\u5e76\u5145\u5206\u7406\u89e3\u5143\u6570\u636e\u53ca\u5176\u4ed6\u53ef\u7528\u6587\u4ef6\u3002<br>\u2022 \u6d88\u9664\u603b\u91cf\u7684\u4e0d\u786e\u5b9a\u6027\u9ad8\u4e8e\u6392\u653e\u91cf\uff0c\u4e3b\u8981\u539f\u56e0\u5728\u4e8e\u7f8e\u56fd\u548c\u6b27\u6d32\u4ee5\u5916\u786e\u7acb\u7684\u6e29\u5e26\u68ee\u6797\u7684\u6d88\u9664\u56e0\u7d20\u5b58\u5728\u4e0d\u786e\u5b9a\u6027\u3002<br>\u2022 \u5404\u9879\u503c\u9002\u7528\u4e8e\u6797\u533a\uff08\u6811\u51a0\u8986\u76d6 &gt;30% \u5e76\u4e14\u9ad8\u5ea6 &gt;5 \u7c73\uff09\u4ee5\u53ca\u6709\u6811\u6728\u8986\u76d6\u589e\u52a0\u7684\u533a\u57df\u3002\u8bf7\u53c2\u89c1 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al.2021</a> \u4ee5\u4e86\u89e3\u6709\u5173\u8be5\u5206\u6790\u4e2d\u6240\u7528\u68ee\u6797\u5b9a\u4e49\u7684\u8fdb\u4e00\u6b65\u4fe1\u606f\u3002<br>\u2022 \u6392\u653e\u6765\u81ea\u6797\u5206\u66ff\u4ee3\u5e72\u6270\uff0c\u4e0d\u5305\u62ec\u6765\u81ea\u68ee\u6797\u9000\u5316\u7684\u6392\u653e\u3002<br>\u2022 \u7528\u4f5c\u4f30\u8ba1\u57fa\u7840\u7684\u6d3b\u52a8\u6570\u636e\u5305\u542b\u65f6\u95f4\u4e0d\u4e00\u81f4\u6027\uff1a<br>o \u6811\u6728\u8986\u76d6\u589e\u52a0\u4ee3\u8868 2000 \u5e74\u81f3 2012 \u5e74\u7d2f\u8ba1\u7684\u603b\u548c\uff0c\u800c\u4e0d\u662f\u5e74\u5ea6\u589e\u52a0\u3002<br>o 2011 \u5e74\u81f3 2015 \u5e74\u95f4\uff0c\u56e0\u91c7\u7528\u65b0\u7684\u536b\u661f\u6570\u636e\u548c\u65b9\u6cd5\u53d8\u5316\u800c\u5b9e\u73b0\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u63a2\u6d4b\u6539\u8fdb\uff0c\u53ef\u80fd\u5bfc\u81f4\u8fd1\u5e74\u6bd4\u65e9\u5e74\u7684\u6392\u653e\u4f30\u8ba1\u503c\u9ad8\u3002<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8bf7\u53c2\u8003\u6b64\u5904</a>\u4ee5\u4e86\u89e3\u5176\u4ed6\u4fe1\u606f\u3002", "70d99c841a781226ea6f8de076211901": "{location} \u56e0\u706b\u707e\u5bfc\u81f4\u6811\u6728\u8986\u76d6\u51cf\u5c11\u5360\u591a\u6570\u7684\u5730\u533a", "2cee170a0b4235f2079881d4914c41ef": "\u6309\u4e3b\u5bfc\u9a71\u52a8\u56e0\u7d20\u5206\u5217\u7684\u68ee\u6797\u76f8\u5173\u6e29\u5ba4\u6c14\u4f53\u6392\u653e", "236102b7472c99d70af000045de9a856": "\u6309\u5e72\u6270\u9a71\u52a8\u56e0\u7d20\u663e\u793a\u6bcf\u5e74\u56e0\u6797\u5206\u66ff\u4ee3\u68ee\u6797\u5e72\u6270\u5bfc\u81f4\u7684\u6392\u653e", "dc849a7c2a7717bddc25ad13c1269ccb": "\u2022 \u6392\u653e\u6570\u636e\u662f\u5efa\u6a21\u7684\u4ea7\u7269\uff0c\u56e0\u6b64\u5fc5\u7136\u5b58\u5728\u4e00\u5b9a\u7a0b\u5ea6\u7684\u8bef\u5dee\u548c\u4e0d\u786e\u5b9a\u6027\u3002\u5f3a\u70c8\u5efa\u8bae\u7528\u6237\u5728\u4f7f\u7528\u6570\u636e\u524d\u9605\u8bfb\u5e76\u5145\u5206\u7406\u89e3\u5143\u6570\u636e\u53ca\u5176\u4ed6\u53ef\u7528\u6587\u4ef6\u3002<br>\u2022 \u5404\u9879\u6392\u653e\u6570\u636e\u9002\u7528\u4e8e\u6797\u533a\uff08\u6811\u51a0\u8986\u76d6 &gt;30% \u5e76\u4e14\u9ad8\u5ea6 &gt;5 \u7c73\uff09\u4ee5\u53ca\u6709\u6811\u6728\u8986\u76d6\u589e\u52a0\u7684\u533a\u57df\u3002\u8bf7\u53c2\u89c1 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al.2021</a> \u4e86\u89e3\u6709\u5173\u8be5\u5206\u6790\u4e2d\u6240\u7528\u68ee\u6797\u5b9a\u4e49\u7684\u8fdb\u4e00\u6b65\u4fe1\u606f\u3002<br>\u2022 \u6392\u653e\u6570\u636e\u53cd\u6620 Landsat \u536b\u661f\u56fe\u50cf\u4e2d\u89c2\u5bdf\u5230\u7684\u6797\u5206\u66ff\u4ee3\u5e72\u6270\uff0c\u4e0d\u5305\u62ec\u6765\u81ea\u672a\u89c2\u5bdf\u5230\u7684\u68ee\u6797\u9000\u5316\u7684\u6392\u653e\u3002<br>\u2022 \u6392\u653e\u53cd\u6620\u7684\u662f\u603b\u91cf\u4f30\u8ba1\uff0c\u5373\u4e0d\u5305\u62ec\u6765\u81ea\u5e72\u6270\u540e\u53d1\u751f\u7684\u4efb\u4f55\u518d\u751f\u957f\u7684\u78b3\u6d88\u9664\u3002\u800c\u5728\u4f34\u968f\u68ee\u6797\u78b3\u6d88\u9664\u5c42\u4e2d\uff0c\u4f1a\u8003\u8651\u78b3\u6d88\u9664\u603b\u91cf\u3002<br>\u2022 2011 \u5e74\u81f3 2015 \u5e74\u95f4\uff0c\u56e0\u91c7\u7528\u65b0\u7684\u536b\u661f\u6570\u636e\u548c\u65b9\u6cd5\u53d8\u5316\u800c\u5b9e\u73b0\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u63a2\u6d4b\u6539\u8fdb\uff0c\u53ef\u80fd\u5bfc\u81f4\u8fd1\u5e74\u6bd4\u65e9\u5e74\u7684\u4f30\u8ba1\u503c\u9ad8\u3002<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8bf7\u53c2\u8003\u6b64\u5904</a>\u4ee5\u4e86\u89e3\u5176\u4ed6\u4fe1\u606f\u3002", "2e25ba2bf25816def0de150269bea436": "\u6b64\u56fe\u6309<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6811\u6728\u8986\u76d6\u51cf\u5c11\u4e3b\u5bfc\u9a71\u52a8\u56e0\u7d20</a>\u663e\u793a\u6bcf\u5e74\u56e0\u6797\u5206\u66ff\u4ee3\u68ee\u6797\u5e72\u6270\u5f15\u8d77\u7684\u6e29\u5ba4\u6c14\u4f53<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6392\u653e</a>\u3002\u6392\u653e\u5305\u62ec\u6240\u6709\u76f8\u5173\u751f\u6001\u7cfb\u7edf\u78b3\u6c60\uff08\u5730\u4e0a\u751f\u7269\u91cf\u3001\u5730\u4e0b\u751f\u7269\u91cf\u3001\u67af\u6728\u3001\u843d\u53f6\u3001\u571f\u58e4\uff09\u4ee5\u53ca\u6e29\u5ba4\u6c14\u4f53\uff08CO2\u3001NH4\u3001N2O\uff09\uff0c\u5e76\u4e14\u5047\u5b9a\u6392\u653e\u53d1\u751f\u5728\u5e72\u6270\u5e74\u4efd\u3002\u7528\u4e8e\u8ba1\u7b97\u6392\u653e\u7684\u65b9\u6cd5\u5728 <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. 2021</a> \u4e2d\u6709\u4ecb\u7ecd\uff1b\u8be5\u6587\u4ecb\u7ecd\u4e86\u4e00\u79cd\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u53ef\u7528\u4e8e\u4f30\u8ba1\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u3002\u8be5\u65b9\u6cd5\u9075\u5faa\u53d1\u751f\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u7684\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355\u7684\u201cIPCC \u6307\u5bfc\u51c6\u5219\u201d(IPCC Guidelines)\uff0c\u8fd9\u5728 <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a> \u7684\u5168\u7403\u68ee\u6797\u53d8\u5316\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6570\u636e\u4e2d\u6709\u53cd\u6620\u3002<br>\u6392\u653e\u53cd\u6620\u7684\u662f\u603b\u91cf\u4f30\u8ba1\uff0c\u5373\u4e0d\u5305\u62ec\u540e\u7eed\u518d\u751f\u957f\u5e26\u6765\u7684\u78b3\u6d88\u9664\u3002\u8bf7\u53c2\u8003\u51c0\u901a\u91cf\u56fe\u4ee5\u4e86\u89e3\u6709\u5173\u6d88\u9664\u7684\u4fe1\u606f\u4ee5\u53ca\u9009\u5b9a\u533a\u57df\u7684\u51c0\u901a\u91cf\u3002\u6392\u653e\u5305\u62ec\u9ad8\u4e8e\u9009\u5b9a\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u533a\u57df\u4ee5\u53ca\u6811\u6728\u8986\u76d6\u589e\u52a0\u672a\u8fbe\u5230\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u533a\u57df\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u3002<br>\u6811\u6728\u8986\u76d6\u51cf\u5c11\u7684\u4e94\u4e2a\u9a71\u52a8\u56e0\u7d20\u7684\u5b9a\u4e49\u5982\u4e0b\uff1a<br>\u2014\u2014\u5927\u5b97\u5546\u54c1\u9a71\u52a8\u7684\u68ee\u6797\u780d\u4f10\uff1a\u4e3b\u8981\u4e0e\u5546\u4e1a\u5316\u519c\u4e1a\u6269\u5f20\u5173\u8054\u7684\u5927\u89c4\u6a21\u68ee\u6797\u780d\u4f10\u3002<br>\u2014\u2014\u8f6e\u57a6\u519c\u4e1a\uff1a\u56e0\u4e3a\u4e2d\u5c0f\u89c4\u6a21\u519c\u4e1a\u800c\u6682\u65f6\u51cf\u5c11\u6216\u6c38\u4e45\u68ee\u6797\u780d\u4f10\u3002<br>\u2014\u2014\u6797\u4e1a\uff1a\u79cd\u690d\u56ed\u548c\u81ea\u7136\u68ee\u6797\u91c7\u4f10\u5bfc\u81f4\u7684\u6682\u65f6\u51cf\u5c11\uff0c\u6709\u4e00\u4e9b\u539f\u59cb\u68ee\u6797\u780d\u4f10\u3002<br>\u2014\u2014\u68ee\u6797\u5927\u706b\uff1a\u6682\u65f6\u51cf\u5c11\uff0c\u4e0d\u5305\u62ec\u70e7\u8352\u653e\u706b\u3002<br>\u2014\u2014\u57ce\u5e02\u5316\uff1a\u57ce\u5e02\u4e2d\u5fc3\u6269\u5f20\u5bfc\u81f4\u7684\u68ee\u6797\u780d\u4f10\u3002<br>\u5927\u5b97\u5546\u54c1\u9a71\u52a8\u7684\u68ee\u6797\u780d\u4f10\u548c\u57ce\u5e02\u5316\u7c7b\u522b\u4ee3\u8868\u4e86\u6c38\u4e45\u6027\u68ee\u6797\u780d\u4f10\uff0c\u800c\u53d7\u5176\u4ed6\u7c7b\u522b\u5f71\u54cd\u7684\u6811\u6728\u8986\u76d6\u901a\u5e38\u4f1a\u518d\u751f\u957f\u3002\u8be5\u9a71\u52a8\u56e0\u7d20\u6570\u636e\u96c6\u5e76\u4e0d\u6807\u793a\u6811\u6728\u8986\u76d6\u51cf\u5c11\u53d1\u751f\u540e\u571f\u5730\u8986\u76d6\u7684\u7a33\u5b9a\u6027\u6216\u72b6\u51b5\uff0c\u4e5f\u4e0d\u4f1a\u533a\u5206\u81ea\u7136\u68ee\u6797\u5927\u706b\u548c\u4eba\u4e3a\u68ee\u6797\u5927\u706b\u3002<br>\u8be5\u9a71\u52a8\u56e0\u7d20\u6570\u636e\u96c6\u6807\u793a 10 km \u7f51\u683c\u5355\u5143\u6811\u6728\u8986\u76d6\u51cf\u5c11\u7684\u4e3b\u5bfc\u9a71\u52a8\u56e0\u7d20\uff0c\u5176\u4f9d\u636e\u662f\u8fd1 5,000 \u4e2a\u6837\u672c\u70b9\u4ee5\u53ca\u57fa\u4e8e\u6811\u6728\u8986\u76d6\u3001\u6811\u6728\u8986\u76d6\u51cf\u5c11\u3001\u6811\u6728\u8986\u76d6\u589e\u52a0\u3001\u4eba\u53e3\u5bc6\u5ea6\u3001\u571f\u5730\u8986\u76d6\u548c\u706b\u707e\u7684\u6570\u636e\u6784\u5efa\u7684\u6a21\u578b\u3002\u7136\u540e\uff0c\u6bcf\u4e2a\u5355\u5143\u7684\u4e3b\u5bfc\u9a71\u52a8\u56e0\u7d20\u4e0e\u6bcf\u5e74\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u76f8\u4e92\u53c2\u8003\uff0c\u8ba1\u7b97\u6b64\u5904\u5c55\u793a\u7684\u7edf\u8ba1\u6570\u636e\u3002\u5728\u8be5\u671f\u95f4\u6811\u6728\u8986\u76d6\u51cf\u5c11\u4e0d\u5230 0.5% \u7684\u7f51\u683c\u5355\u5143\u672a\u88ab\u8d4b\u4e88\u7b49\u7ea7\uff0c\u5728\u7edf\u8ba1\u6570\u636e\u4e2d\u6ca1\u6709\u8868\u793a\u3002<br>\u8bf7\u6ce8\u610f\uff0c\u6b64\u6570\u636e\u96c6\u7684\u65e2\u5b9a\u9002\u7528\u5c3a\u5ea6\u662f\u5168\u7403\u6216\u5730\u533a\uff0c\u56e0\u6b64\u5728\u89c2\u5bdf\u5c0f\u533a\u57df\u6216\u7279\u5b9a\u5730\u7406\u533a\u57df\u65f6\uff0c\u53ef\u80fd\u8868\u73b0\u5f97\u4e0d\u51c6\u786e\u3002GFW \u4e0a\u7684\u5168\u7403\u548c\u5730\u533a\u603b\u548c\u4f1a\u53cd\u6620\u50cf\u7d20\u8ba1\u6570\uff0c\u800c\u4e0d\u662f\u57fa\u4e8e\u6837\u672c\u7684\u533a\u57df\u4f30\u8ba1\u3002\u5728\u5168\u7403\u548c\u5730\u533a\u5c3a\u5ea6\u4e0a\uff0c\u57fa\u4e8e\u50cf\u7d20\u8ba1\u6570\u65b9\u6cd5\u7684\u533a\u57df\u4f30\u8ba1\u4f1a\u5728\u57fa\u4e8e\u6837\u672c\u7684\u533a\u57df\u4f30\u8ba1\u7684\u8bef\u5dee\u8303\u56f4\u5185\uff0c\u56e0\u6b64\u53ef\u4ee5\u5728\u533a\u57df\u8ba1\u7b97\u4e2d\u76f4\u63a5\u4f7f\u7528\u5730\u56fe\u8f93\u51fa\u3002<br>\u6570\u636e\u96c6\u7684\u51c6\u786e\u6027\u56e0\u7b49\u7ea7\u548c\u5730\u7406\u533a\u57df\u800c\u6709\u5dee\u5f02\u3002\u6bcf\u4e2a\u7b49\u7ea7\u7684\u5168\u7403\u51c6\u786e\u6027\u5982\u4e0b\u6240\u793a\uff1b\u5730\u533a\u51c6\u786e\u6027\u53ef\u5728 <a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">Curtis et al. 2018</a> \u7684\u201c\u8865\u5145\u6750\u6599\u201d\u4e2d\u627e\u5230\u3002", "761eb00298c334b20e92b140dcb7715c": "\u542b\u6e29\u5ba4\u6c14\u4f53", "99c4231b2ecc7d161cdacd679df42ed5": "\u5370\u5ea6\u5c3c\u897f\u4e9a\u548c\u9a6c\u6765\u897f\u4e9a\u6ce5\u70ad\u5730", "06b9c03dfdc1a3faee25c8f39b2cb462": "\u6b64\u56fe\u663e\u793a\u6bcf\u5e74\u56e0\u6797\u5206\u66ff\u4ee3\u68ee\u6797\u5e72\u6270\u5f15\u8d77\u7684\u6e29\u5ba4\u6c14\u4f53<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6392\u653e</a>\u3002\u6392\u653e\u5305\u62ec\u6240\u6709\u76f8\u5173\u751f\u6001\u7cfb\u7edf\u78b3\u6c60\uff08\u5730\u4e0a\u751f\u7269\u91cf\u3001\u5730\u4e0b\u751f\u7269\u91cf\u3001\u67af\u6728\u3001\u843d\u53f6\u3001\u571f\u58e4\uff09\u4ee5\u53ca\u6e29\u5ba4\u6c14\u4f53\uff08CO2\u3001NH4\u3001N2O\uff09\uff0c\u5e76\u4e14\u5047\u5b9a\u6392\u653e\u53d1\u751f\u5728\u5e72\u6270\u5e74\u4efd\u3002\u7528\u4e8e\u8ba1\u7b97\u6392\u653e\u7684\u65b9\u6cd5\u5728 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a> \u4e2d\u6709\u4ecb\u7ecd\uff1b\u8be5\u6587\u4ecb\u7ecd\u4e86\u4e00\u79cd\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u53ef\u7528\u4e8e\u4f30\u8ba1\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u3002\u8be5\u65b9\u6cd5\u9075\u5faa\u53d1\u751f\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u7684<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u7684\u201cIPCC \u6307\u5bfc\u51c6\u5219\u201d(IPCC Guidelines)\uff0c\u8fd9\u5728 <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a> \u7684\u5168\u7403\u68ee\u6797\u53d8\u5316\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6570\u636e\u4e2d\u6709\u53cd\u6620\u3002<br>\u6392\u653e\u53cd\u6620\u7684\u662f\u603b\u91cf\u4f30\u8ba1\uff0c\u5373\u4e0d\u5305\u62ec\u540e\u7eed\u518d\u751f\u957f\u5e26\u6765\u7684\u78b3\u6d88\u9664\uff08\u5c01\u5b58\uff09\u3002\u8bf7\u53c2\u8003\u51c0\u901a\u91cf\u56fe\u4ee5\u4e86\u89e3\u6709\u5173\u78b3\u6d88\u9664\u7684\u4fe1\u606f\u4ee5\u53ca\u9009\u5b9a\u533a\u57df\u7684\u51c0\u901a\u91cf\u3002\u6392\u653e\u5305\u62ec\u9ad8\u4e8e\u9009\u5b9a\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u533a\u57df\u4ee5\u53ca\u6811\u6728\u8986\u76d6\u589e\u52a0\u672a\u8fbe\u5230\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u533a\u57df\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u3002", "e457d1a2d7a349d8c31a767fa4e50947": "2012 \u5e74 3 \u6708", "01338bef78e9ac46e8dbdd4c303be30e": "{startYear} \u5e74\u81f3 {endYear} \u5e74\uff0c{location} \u56e0\u706b\u707e\u51cf\u5c11\u4e86 {treeCoverLossFires} \u6811\u6728\u8986\u76d6\uff0c\u5176\u4ed6\u51cf\u5c11\u9a71\u52a8\u56e0\u7d20\u5bfc\u81f4\u7684\u6709 {treeCoverLossNotFires}\u3002\u5728\u6b64\u671f\u95f4\uff0c\u56e0\u706b\u707e\u5bfc\u81f4\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6700\u591a\u7684\u5e74\u4efd\u662f {highestYearFires} \u5e74\uff0c\u56e0\u706b\u707e\u51cf\u5c11\u4e86 {highestYearFiresLossFires}\u2014\u2014\u5360\u8be5\u5e74\u6811\u6728\u8986\u76d6\u51cf\u5c11\u603b\u91cf\u7684 {highestYearFiresPercentageLossFires}\u3002", "e0ee65805100dfca15c99a30c8bf8727": "\u5b9a\u5c45\u70b9\u57fa\u7840\u8bbe\u65bd", "985a4b720f9b50ee8ed90a41488d2bb7": "\u4f7f\u7528\u6761\u6b3e", "a6c3f87d90dc159172adf66081c7f149": "2020, \u5168\u7403, AZE", "50a556cf552b6e0645b423aa90c81387": "2002 \u5e74-2024 \u5e74\u7684\u65b0\u5174\u70ed\u70b9", "ee247652de66f818369f98f955a2a75a": "2002 \u81f3 2023 \u5e74\u95f4\u7684\u539f\u751f\u6797\u51cf\u5c11", "76306539e1930fa605f856ff8a1cdeff": "2000-2020, global, UMD/NASA GEDI", "336b69dc2b47f3038cbe3c97bf9db020": "\u8981\u4e0b\u8f7d\u51c0\u901a\u91cf\u6570\u636e\uff0c\u6709\u4e24\u79cd\u4e0d\u540c\u7684\u9762\u79ef\u5355\u4f4d\u53ef\u4f9b\u9009\u62e9\uff1a1) \u5146\u514b\u4e8c\u6c27\u5316\u78b3\u6392\u653e\u91cf/ha\uff0c2) \u5146\u514b\u4e8c\u6c27\u5316\u78b3\u6392\u653e\u91cf/\u50cf\u5143\u3002\u7b2c\u4e00\u79cd\u9002\u7528\u4e8e\u53ef\u89c6\u5316\uff08\u6620\u5c04\uff09\u51c0\u901a\u91cf\uff0c\u56e0\u4e3a\u5b83\u4ee3\u8868\u6bcf\u516c\u9877\u7684\u78b3\u901a\u91cf\u5bc6\u5ea6\u3002\u7b2c\u4e8c\u79cd\u9002\u7528\u4e8e\u8ba1\u7b97\u611f\u5174\u8da3\u533a\u57df (AOI) \u4e2d\u7684\u51c0\u901a\u91cf\uff0c\u56e0\u4e3a AOI \u4e2d\u5404\u4e2a\u50cf\u5143\u7684\u503c\u53ef\u4ee5\u76f8\u52a0\u4ee5\u83b7\u5f97\u8be5\u533a\u57df\u7684\u603b\u78b3\u901a\u91cf\u3002\u540e\u8005\u7684\u503c\u662f\u901a\u8fc7\u6839\u636e\u6bcf\u4e2a\u50cf\u5143\u7684\u5927\u5c0f\u8c03\u6574\u6bcf\u516c\u9877\u7684\u51c0\u901a\u91cf\u6765\u8ba1\u7b97\u7684\uff0c\u6bcf\u4e2a\u50cf\u5143\u7684\u5927\u5c0f\u56e0\u7eac\u5ea6\u800c\u5f02\u3002\u5728\u4f30\u8ba1 2001 \u5e74\u81f3 2023 \u5e74\u671f\u95f4\u6307\u5b9a\u5e74\u9650\u5185\u7684\u51c0\u901a\u91cf\u65f6\uff0c\u9700\u5c06\u503c\u9664\u4ee5\u6a21\u578b\u6301\u7eed\u671f\u9650\uff0c\u7136\u540e\u4e58\u4ee5\u76f8\u5173\u65f6\u6bb5\u7684\u5e74\u6570\u3002\u4e24\u4e2a\u6570\u636e\u96c6\u5982 Harris et al. (2021) \u7684\u65b9\u6cd5\u4e2d\u6240\u5b9a\u4e49\u7684\uff0c\u4ec5\u5305\u542b\u4e86\u68ee\u6797\u5185\u7684\u50cf\u5143\uff0c\u5e76\u4e14\u6839\u636e\u622a\u81f3 2020 \u5e74\u7684\u6797\u6728\u8986\u76d6\u589e\u91cf\u505a\u4e86\u66f4\u65b0\u3002", "4dc6eae07a5ea0220a6565dd4c7c8436": "item-unknown", "a468246c44255f4f325db2332061cdcc": "\u636e\u8054\u5408\u56fd\u7cae\u519c\u7ec4\u7ec7\u7684\u6570\u636e\uff0c{startYearRange} \u5e74\u81f3 {endYearRange} \u5e74\u95f4\uff0c{location} \u6bcf\u5e74\u7684\u68ee\u6797\u780d\u4f10\u7387\u4e3a {rate}\u3002", "e49951001bf8edef9e43059774f77cb5": "2021 - \u5384\u74dc\u591a\u5c14", "299dbbbc7f9cf8b34bff79126884ac2a": "\u5f53\u524d\u7684\u690d\u88ab\u8986\u76d6\u7387\u4f30\u7b97\u503c\u4f1a\u4e0e\u8fc7\u53bb\u4e09\u5e74\u5185\u540c\u4e00\u65f6\u95f4\u6bb5\uff08\u524d\u540e 15 \u5929\u5185\uff09\u7684\u6700\u4f4e\u8986\u76d6\u7387\u8fdb\u884c\u6bd4\u8f83\uff0c\u5982\u679c\u6709\u51cf\u5c11\uff0c\u7cfb\u7edf\u4f1a\u5728\u8be5\u50cf\u7d20\u6807\u8bb0\u4e3a\u8b66\u62a5\u3002\u5728\u539f\u59cb\u4ea7\u54c1\u4e2d\uff0c\u4e0e\u6700\u4f4e\u503c\u76f8\u6bd4\u81f3\u5c11\u51cf\u5c11 10% \u7684\u5f02\u5e38\u4f1a\u88ab\u6807\u8bb0\u4e3a\u8b66\u62a5\uff0c\u800c\u5728 GFW \u4e0a\uff0c\u4e3a\u4e86\u51cf\u5c11\u6570\u636e\u4e2d\u7684\u566a\u58f0\u548c\u8bef\u62a5\uff0c\u91c7\u7528\u4e86\u66f4\u9ad8\u7684 30% \u9608\u503c\u3002\u7531\u4e8e\u8be5\u4ea7\u54c1\u5c06\u6bcf\u4e2a\u50cf\u7d20\u4e0e\u8fc7\u53bb\u51e0\u5e74\u5185\u76f8\u540c\u65f6\u671f\u7684\u6700\u4f4e\u503c\u8fdb\u884c\u6bd4\u8f83\uff0c\u56e0\u6b64\u8003\u8651\u4e86\u690d\u88ab\u8986\u76d6\u7684\u5e38\u89c4\u5b63\u8282\u6027\u53d8\u5316\u3002", "69da99bd55d1cbfbf0775dcf7177b38a": "\u7531\u4e8e\u8be5\u4ea7\u54c1\u662f\u5168\u7403\u6027\u7684\u5e76\u68c0\u6d4b\u690d\u88ab\u5f02\u5e38\uff0c\u56e0\u6b64\u5927\u90e8\u5206\u6570\u636e\u53ef\u80fd\u4e0d\u9002\u7528\u4e8e\u76d1\u6d4b\u68ee\u6797\u7684 GFW \u7528\u6237\u3002\u56e0\u6b64\uff0c\u6211\u4eec\u4f7f\u7528 UMD \u7684\u6811\u6728\u8986\u76d6\u56fe\u5bf9\u8b66\u62a5\u8fdb\u884c\u63a9\u76d6\u5904\u7406\uff0c\u5141\u8bb8\u7528\u6237\u4ec5\u67e5\u770b 30% \u6811\u51a0\u8986\u76d6\u7387\u5185\u7684\u8b66\u62a5\u3002", "4dbb275447a0cba9aff1854fdef3d5f2": "\u5168\u7403\u690d\u88ab\u5e72\u6270\u8b66\u62a5", "8b3f9be2d63815b6120657653bde8e1a": "\u571f\u58e4\u6709\u673a\u78b3\u5bc6\u5ea6", "850d3c5b963473c31407e62beebc850c": "Wageningen University \u4e0e Global Forest Watch \u548c University of Maryland GLAD \u5b9e\u9a8c\u5ba4\u7684\u7814\u7a76\u4eba\u5458\u5408\u4f5c\u8fdb\u884c\u7684\u4e00\u9879\u7814\u7a76\u53d1\u73b0\uff0c\u6574\u5408\u8b66\u62a5\u7cfb\u7edf\u80fd\u591f\u66f4\u5feb\u5730\u68c0\u6d4b\u5230\u65b0\u7684\u5e72\u6270\uff0c\u5c06\u65f6\u95f4\u7f29\u77ed\u6570\u5929\u5230\u6570\u6708\uff0c\u5e76\u7f29\u77ed\u5ef6\u8fdf\u4ee5\u63d0\u9ad8\u7f6e\u4fe1\u5ea6\u3002\u7ec4\u5408\u8b66\u62a5\u5177\u6709\u8f83\u9ad8\u7684\u751f\u4ea7\u8005\u51c6\u786e\u7387\uff08\u8f83\u5c11\u6f0f\u62a5\uff09\uff0c\u4f46\u7528\u6237\u51c6\u786e\u7387\u8f83\u4f4e\uff08\u8f83\u591a\u8bef\u62a5\uff09\uff0c\u56e0\u4e3a\u6765\u81ea\u6bcf\u4e2a\u7cfb\u7edf\u7684\u9519\u5206\u8bef\u5dee\u88ab\u7ec4\u5408\u5728\u4e00\u8d77\uff1b\u7136\u800c\uff0c\u201c\u6700\u9ad8\u7f6e\u4fe1\u5ea6\u201d\u8b66\u62a5\uff08\u5373\u591a\u4e2a\u7cfb\u7edf\u68c0\u6d4b\u5230\u8fd9\u4e00\u53d8\u5316\uff09\u6709\u6548\u5730\u6d88\u9664\u4e86\u8bef\u5224\u68c0\u6d4b\u3002\u4e86\u89e3\u8be6\u60c5\uff1a<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">https://iopscience.iop.org/article/10.1088/1748-9326/ad2d82</a>", "fe79a5b190eaaba823768da2147a7abb": "\u5982\u9700\u4e86\u89e3\u76f8\u5173\u6570\u636e\uff0c\u8bf7\u53c2\u9605  <a href=\"{{0}}\">https://glad.umd.edu/dataset/Fire_GFL/</a>.", "2761bfb12ffdbc9a4978e27659aac7ea": "2002 \u5e74-2024 \u5e74\uff0c\u70ed\u5e26\u5730\u533a\uff0cHarris et al.", "fba6f36e3d6cb088127f472fa9d4a498": "\u79d8\u9c81\u68ee\u6797\u7279\u8bb8\u6743 - 2023", "53a83269c6d7d88887fab0a53facbcef": "\u6bcf\u5e74\uff0c30m\uff0c\u5168\u7403\uff0cUMD GLAD", "0ddb5b404ab4904e9201a5ec32283367": "2001 \u5e74-2024 \u5e74\u68ee\u6797\u78b3\u6e05\u9664\u91cf", "5b4f1ab2d79b4b46ac0fc0329c8f897e": "2001 \u5e74-2024 \u5e74\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u91cf", "9ffac291a69a5a14e4eb35138c65964c": "\u968f\u7740\u65b0\u6570\u636e\u7684\u51fa\u73b0\uff0c\u5b9a\u671f\u66f4\u65b0", "f3d514f3e35c6f14480c72ad260a4405": "\u6ca1\u6709<strong>\u5df4\u897f</strong>\u571f\u5730\u4f7f\u7528\u53ef\u7528\u6570\u636e\u96c6\u3002", "d543152981e488425f648fa6270437f0": "\u6bcf\u5468\u66f4\u65b0\uff0c30 m\uff0c\u5168\u7403\u8303\u56f4\uff0cUMD", "17179b328466b49e91d30414756b169a": "2001 \u5e74-2024 \u5e74\u51c0\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf", "4402ef8152c2746896c20a48dcf76280": "(1 km\uff0c\u5168\u7403\uff0cCook-Patton \u7b49 2020 \u5e74)", "a764aedd50c5e262553eb2a24ae38c81": "\u79d8\u9c81<button><svg class=\"c-icon \" viewBox=\"0 0 32 32\"><use xlink:href=\"#close-41618f4c--sprite\"></use></svg></button>", "fed4b1f9c1c7e946c325956be8088472": "\u6bcf\u5468\u66f4\u65b0\uff0c30 m\uff0c\u5168\u7403\u8303\u56f4\uff0cUMD/GLAD \u548c NASA", "1f654f86e65aeb7cd2f4b4ea8d020737": "\u4e3b\u8981\u56e0\u7d20\u5bfc\u81f4\u7684\u6797\u6728\u6d41\u5931 - 2001-2024", "1ddb4a8406be9949c6ed4ca0b857bda6": "{name} \u662f{marine}\u4fdd\u62a4\u533a\uff0c{status_year} \u7684\u72b6\u6001\u662f {status}\u3002", "25fd44ea21922d6f38f3285f0de8358d": "\u5728\u6b64\u6570\u636e\u96c6\u4e2d\uff0c\u201c\u6811\u6728\u8986\u76d6\u201d\u662f\u6307\u9ad8\u5ea6\u8d85\u8fc7 5 \u7c73\u7684\u6240\u6709\u690d\u88ab\uff0c\u5176\u5f62\u5f0f\u53ef\u80fd\u662f\u6811\u51a0\u5bc6\u5ea6\u5728\u67d0\u4e2a\u8303\u56f4\u7684\u5929\u7136\u6797\u6216\u4eba\u5de5\u6797\u3002", "02ba7c5de5f5742b0e5975b7f7a49192": "(2000-2020, global, UMD/NASA GEDI)", "1263a9d6e336c4f7fe2e771f8985c6b5": "20 years, 30m, global. Hansen/UMD/Google/USGS/NASA", "8f9605e91d6fff52ff2dd8f2c2a47599": "\u884c\u653f\u533a\u5c42\u9762\u6811\u6728\u8986\u76d6\u51c0\u53d8\u5316\u6c47\u603b\u3002", "f581448254479c165c99779b2f1e9883": "\u6811\u6728\u8986\u76d6\u589e\u52a0", "e2f735238499ffee8ffa4156c48a2816": "\u5728\u6b64\u6570\u636e\u96c6\u4e2d\uff0c\u201c\u6811\u6728\u8986\u76d6\u201d\u662f\u6307\u9ad8\u5ea6\u8d85\u8fc7 5 \u7c73\u7684\u6240\u6709\u690d\u88ab\uff0c\u5176\u5f62\u5f0f\u53ef\u4ee5\u662f\u6811\u51a0\u5bc6\u5ea6\u5728\u67d0\u4e2a\u8303\u56f4\u7684\u5929\u7136\u6797\u6216\u4eba\u5de5\u6797\u3002\u6811\u6728\u8986\u76d6\u589e\u52a0\u5e76\u4e0d\u76f4\u63a5\u7b49\u540c\u4e8e\u6062\u590d\u3001\u690d\u6811\u9020\u6797\u6216\u68ee\u6797\u518d\u9020\u3002", "fb6baaf694debdb4189fdb69c63757aa": "\u4f5c\u8005\u8bc4\u4f30\u4e86\u4ea7\u54c1\u7684\u51c6\u786e\u6027\uff0c\u5728\u5047\u9633\u6027\u53d1\u751f\u7387\uff08\u9519\u5206\u8bef\u5dee\uff09\u4e3a 28.6%\u3001\u5047\u9634\u6027\u7387\uff08\u9057\u6f0f\u8bef\u5dee\uff09\u4e3a 42.2% \u7684\u60c5\u51b5\u4e0b\uff0c\u6574\u4f53\u51c6\u786e\u7387\u4e3a 99.3%\u3002\u8be5\u51c6\u786e\u7387\u4f1a\u56e0\u751f\u7269\u7fa4\u843d\u800c\u6709\u5dee\u5f02\uff0c\u56e0\u6b64\u5728\u67d0\u4e2a\u7279\u5b9a\u5730\u70b9\u53ef\u80fd\u4f1a\u504f\u9ad8\u6216\u504f\u4f4e\u3002\u7531\u4e8e\u8be5\u5236\u4f5c\u5de5\u5177\u7684\u7cbe\u5ea6\u662f\u6700\u4f4e\u7684\uff0c\u8fd9\u8868\u660e\u4ea7\u54c1\u63d0\u4f9b\u7684\u662f\u4fdd\u5b88\u7684\u68ee\u6797\u52a8\u6001\u4f30\u8ba1\u6570\u636e\u3002", "1f31926d2dd0358a33d2096574d2fe64": "20 years, 30m, global, Hansen/UMD/Google/USGS/NASA", "1fde133fd37227be92ce439ecdb07af1": "\u6709\u5e72\u6270", "14781ee5e859104d453ad3eb28b441e5": "\u51cf\u5c11", "4f2b94accc734a3e80b4d1cc9bcdca43": "2002-2021, tropics, Harris et al.", "b9f527286a81bc9e3de9adf3142f9dab": "\u6811\u6728\u8986\u76d6\u589e\u52a0\u2014\u20142000 \u5e74\u81f3 2020 \u5e74", "cce9be98d0d4a7c2f18093b8131f98c2": "\u68ee\u6797\u51c0\u53d8\u5316", "cdea70346126867a87869f69350a97e5": "\u6811\u6728\u8986\u76d6\u51c0\u53d8\u5316\u2014\u20142000 \u5e74\u81f3 2020 \u5e74", "dea843696df8f8b61f44507e22ab21b5": "\u6b64\u6570\u636e\u96c6\u662f\u9a6c\u91cc\u5170\u5927\u5b66\u201c\u5168\u7403\u9646\u5730\u5206\u6790\u4e0e\u53d1\u73b0\u201d(Global Land Analysis &amp; Discovery, <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">GLAD</a>) \u5b9e\u9a8c\u5ba4\u3001Google\u3001USGS \u548c NASA \u4e4b\u95f4\u5408\u4f5c\u7684\u7ed3\u679c\uff0c\u6d4b\u91cf\u4e86\u5168\u7403\u6240\u6709\u9646\u5730\uff08\u5357\u6781\u53ca\u5176\u4ed6\u5317\u6781\u5c9b\u5c7f\u9664\u5916\uff09\u7684\u6811\u6728\u8986\u76d6\u589e\u52a0\u7684\u9762\u79ef\uff0c\u5206\u8fa8\u7387\u4e3a 30 \u00d7 30 \u7c73\uff0c\u663e\u793a\u4e3a 20 \u5e74\u7684\u7d2f\u79ef\u5c42\u3002\u6811\u6728\u8986\u76d6\u589e\u52a0\u662f\u4f7f\u7528 2000 \u5e74\u548c 2020 \u5e74\u7684\u6811\u6728\u9ad8\u5ea6\u4fe1\u606f\u786e\u5b9a\u7684\u3002\u6811\u6728\u9ad8\u5ea6\u901a\u8fc7\u6574\u5408 Global Ecosystem Dynamics Investigation (GEDI) \u6fc0\u5149\u96f7\u8fbe\u68ee\u6797\u7ed3\u6784\u6d4b\u91cf\u4e0e Landsat \u5206\u6790\u5c31\u7eea\u6570\u636e\u65f6\u95f4\u7cfb\u5217\u63a8\u5bfc\u800c\u5f97\u3002NASA GEDI \u662f 2019 \u5e74 4 \u6708\u5f00\u59cb\u5728\u56fd\u9645\u7a7a\u95f4\u7ad9\u4e0a\u8fd0\u884c\u7684\u661f\u8f7d\u6fc0\u5149\u96f7\u8fbe\u4eea\u5668\u3002\u5b83\u63d0\u4f9b\u57fa\u4e8e\u70b9\u7684\u690d\u88ab\u7ed3\u6784\u6d4b\u91cf\uff0c\u5176\u4e2d\u5305\u62ec\u5168\u7403\u5317\u7eac 52\u00b0 \u548c\u5357\u7eac 52\u00b0 \u4e4b\u95f4\u7684\u68ee\u6797\u51a0\u5c42\u9ad8\u5ea6\u3002\u589e\u52a0\u4e4b\u5904\u662f 2020 \u5e74\u50cf\u7d20\u9ad8\u5ea6 \u22655 \u7c73\u4e14\u6ee1\u8db3\u4ee5\u4e0b\u6761\u4ef6\u4e4b\u4e00\u7684\u5730\u65b9\uff1a1) 2000 \u5e74\u68ee\u6797\u9ad8\u5ea6 &lt;5 \u7c73\uff0c\u6216\u8005 2) 2000 \u5e74\u81f3 2020 \u5e74\u68ee\u6797\u9ad8\u5ea6\u51c0\u589e\u52a0 \u2265100%\u3002", "49c3bef6a3ffe92c2fc6f552e9d4471c": "\u5168\u7403\u6811\u6728\u8986\u76d6\u51c0\u53d8\u5316\u7684\u7ec4\u6210", "a77600e44b1b3dafacfe476f01979c10": "\u7a33\u5b9a\u7684\u68ee\u6797", "8dbaaff4c4282ac21feafa6bdea02434": "\u60a8\u662f\u5426\u613f\u610f\u5e2e\u52a9\u6211\u4eec\u4e86\u89e3\u5982\u4f55\u4ee5\u66f4\u6709\u7528\u7684\u65b9\u5f0f\u5c55\u793a\u6b64\u6570\u636e\uff1f\u8bf7<a class=\"caution-link\" rel=\"noopener noreferrer\" href=\"{{0}}\" target=\"_blank\">\u5355\u51fb\u6b64\u5904\u586b\u5199\u8c03\u67e5</a>", "b84e9c0f302bce3b90127660dac37e62": "\u5e72\u6270\u4ee3\u8868\u5728 2000 \u5e74\u81f3 2020 \u5e74\u95f4\u65e2\u6709\u51cf\u5c11\u4e5f\u6709\u589e\u52a0\u7684\u533a\u57df", "946f76dcde6350db1067daefba8b3945": "\u5168\u7403\u79cd\u690d\u56ed\u5916\u7684\u6811\u6728\u8986\u76d6\u589e\u52a0", "c651bf41bd06cb8c15a0fa2a999e6dd0": "2000 \u5e74\u81f3 2020 \u5e74\u95f4\uff0c\u5168\u7403\u6811\u6728\u8986\u76d6\u589e\u52a0\u7684 {gainPercent} \u53d1\u751f\u5728\u79cd\u690d\u56ed\u5916\u3002", "2450fe6de6ac9e60c86c6a8a1c84d13c": "\u79cd\u690d\u56ed\u5916\u7684\u6811\u6728\u8986\u76d6\u589e\u52a0", "41bc02f663e36fa5c6ccab63ccc3f2f2": "\u79cd\u690d\u56ed\u5185\u7684\u6811\u6728\u8986\u76d6\u589e\u52a0", "85c0163bb3f4a525a4e8d6b8a48f10cd": "\u5728\u5c55\u793a\u6b64\u6570\u636e\u65f6\uff0c\u8bf7\u4f7f\u7528\u4ee5\u4e0b\u81f4\u8c22\u4fe1\u606f\uff1a<br>\u901a\u8fc7 Global Forest Watch \u4e8e 04/10/2022 \u8bbf\u95ee\u3002www.globalforestwatch.org\u3002", "387b049c6459ae8cf4c8322caef88e5c": "2000 \u5e74\u548c 2020 \u5e74\u7684\u68ee\u6797\u8303\u56f4\u4ee5\u53ca\u8be5\u65f6\u95f4\u6bb5\u7684\u7a33\u5b9a\u68ee\u6797\u9762\u79ef\u5747\u6709\u7cbe\u5ea6\u6307\u6807\u8ba1\u7b97\u3002\u6574\u4f53\u7cbe\u5ea6\u3001\u7528\u6237\u7684\u7cbe\u5ea6\uff08\u57fa\u4e8e\u5047\u9633\u6027\uff0c\u5e76\u4ee5 100%-\u9519\u5206\u8bef\u5dee\u8ba1\u7b97\uff09\u4ee5\u53ca\u5236\u4f5c\u5de5\u5177\u7684\u8bef\u5dee\uff08\u57fa\u4e8e\u5047\u9634\u6027\uff0c\u5e76\u4ee5 100%-\u9057\u6f0f\u8bef\u5dee\u8ba1\u7b97\uff09\u5747\u5927\u4e8e 93%\u3002", "dbc8af43e433db63a7afa8c41197e2ca": "\u6811\u6728\u8986\u76d6\u589e\u52a0\u901a\u8fc7 2020 \u5e74\u6811\u6728\u9ad8\u5ea6 \u22655 \u7c73\u5e76\u4e14 2000 \u5e74\u6811\u6728\u9ad8\u5ea6 &lt;5 \u7c73\u7684\u50cf\u7d20\u786e\u5b9a\u3002\u6b64\u6570\u636e\u96c6\u6765\u81ea\u9a6c\u91cc\u5170\u5927\u5b66\u201c\u5168\u7403\u9646\u5730\u5206\u6790\u4e0e\u53d1\u73b0\u201d(Global Land Analysis &amp; Discovery, <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">GLAD</a>) \u5b9e\u9a8c\u5ba4\uff0c\u6d4b\u91cf\u4e86\u5168\u7403\u6240\u6709\u9646\u5730\uff08\u5357\u6781\u53ca\u5176\u4ed6\u5317\u6781\u5c9b\u5c7f\u9664\u5916\uff09\u7684\u6811\u6728\u8986\u76d6\u589e\u52a0\u7684\u9762\u79ef\uff0c\u5206\u8fa8\u7387\u4e3a 30 \u00d7 30 \u7c73\uff0c\u663e\u793a\u4e3a 20 \u5e74\u7684\u7d2f\u79ef\u5c42\u3002\u6811\u6728\u8986\u76d6\u589e\u52a0\u662f\u4f7f\u7528 2000 \u5e74\u548c 2020 \u5e74\u7684\u6811\u6728\u9ad8\u5ea6\u4fe1\u606f\u786e\u5b9a\u7684\u3002\u6811\u6728\u9ad8\u5ea6\u901a\u8fc7\u6574\u5408 Global Ecosystem Dynamics Investigation (GEDI) \u6fc0\u5149\u96f7\u8fbe\u68ee\u6797\u7ed3\u6784\u6d4b\u91cf\u4e0e Landsat \u5206\u6790\u5c31\u7eea\u6570\u636e\u65f6\u95f4\u7cfb\u5217\u63a8\u5bfc\u800c\u5f97\u3002", "49e08fb2d1f88201ae0b97465000e3e8": "2000 \u5e74\u81f3 2020 \u5e74\uff0c{gain} \u7684\u6811\u6728\u8986\u76d6\u662f\u5728 {location} \u589e\u52a0\u7684\u3002", "1dce7ee6336810698af04cda6ff0a092": "2000 \u5e74\u81f3 2020 \u5e74\uff0c{location} \u7684\u6811\u6728\u8986\u76d6\u51c0\u53d8\u5316\u4e3a {netChange} ({netChangePerc})\u3002", "39fe0b5e5a3b99fedeff2d5d5c7bcd0c": "2000 \u5e74\u81f3 2020 \u5e74\uff0c{location} \u589e\u52a0\u4e86 {gain} \u7684\u6811\u6728\u8986\u76d6\uff0c\u76f8\u5f53\u4e8e\u5168\u7403\u603b\u91cf\u7684 {gainPercent}\u3002", "0fff7f67db73e41f877ad5facc801cfb": "2010 \u5e74\uff0c{location} \u6709 {naturalForest} \u7684\u5929\u7136\u68ee\u6797\uff0c\u5360\u5176\u9646\u5730\u9762\u79ef\u7684 {percentage} \u4ee5\u4e0a\u3002{year} \u5e74\uff0c\u5176\u5929\u7136\u68ee\u6797\u51cf\u5c11\u4e86 {naturalLoss}\uff0c\u76f8\u5f53\u4e8e\u6392\u653e\u4e86 {emissions} \u4e8c\u6c27\u5316\u78b3 (CO\u2082)\u3002", "127fe34c350f9d7f56cf52688cfda7f7": "\u6807\u8bc6\u51c0\u6811\u6728\u8986\u76d6\u53d8\u5316", "9fc44271dcc0d9c6a81b09bf9ad731b8": "\u6811\u6728\u8986\u76d6\u51c0\u53d8\u5316", "f86b3fc137ce674746d94181cafedc0f": "\u68ee\u6797\u6539\u5584\uff08\u73b0\u6709\u68ee\u6797\u9ad8\u5ea6\u589e\u52a0\uff09\u4e0e\u68ee\u6797\u589e\u52a0\uff08\u5728 2000 \u5e74\u975e\u6797\u5730\u4e2d\u5efa\u7acb\u68ee\u6797\uff09\u4e4b\u95f4\u5b58\u5728\u6df7\u6dc6\uff0c\u8fd9\u79cd\u60c5\u51b5\u5728\u5317\u65b9\u68ee\u6797\u533a\u57df\u66f4\u4e3a\u7a81\u51fa\uff0c\u56e0\u4e3a\u8fd9\u4e9b\u533a\u57df\u7684 2000 \u5e74\u68ee\u6797\u9ad8\u5ea6\u96be\u4ee5\u786e\u5b9a\u3002", "1a36dd620a49e6c0926d3f7e172d7b05": "\u5728\u7f29\u5c0f\uff08\u5c0f\u4e8e 12 \u7ea7\u7f29\u653e\uff09\u65f6\uff0c\u589e\u52a0\u7684\u50cf\u7d20\u5e26\u9634\u5f71\uff08\u6839\u636e 30 \u7c73 X 30 \u7c73\u5c3a\u5ea6\u7684\u589e\u52a0\u5bc6\u5ea6\u786e\u5b9a\uff09\u3002\u9634\u5f71\u989c\u8272\u8f83\u6df1\u7684\u50cf\u7d20\u4ee3\u8868\u6811\u6728\u8986\u76d6\u589e\u52a0\u96c6\u4e2d\u5ea6\u8f83\u9ad8\u7684\u533a\u57df\uff0c\u800c\u9634\u5f71\u989c\u8272\u8f83\u6d45\u7684\u50cf\u7d20\u8868\u793a\u6811\u6728\u8986\u76d6\u589e\u52a0\u96c6\u4e2d\u5ea6\u8f83\u4f4e\u3002\u5f53\u6570\u636e\u5904\u4e8e\u5b8c\u5168\u5206\u8fa8\u7387\u65f6\uff08\u7b49\u4e8e\u6216\u5927\u4e8e 12 \u7ea7\u7f29\u653e\uff09\uff0c\u50cf\u7d20\u9634\u5f71\u6ca1\u6709\u5dee\u5f02\u3002", "a8ff8a5e81223156d6d876caa186c524": "\u6811\u6728\u8986\u76d6\u589e\u52a0\u53ef\u80fd\u8868\u660e\u5b58\u5728\u4e00\u4e9b\u6f5c\u5728\u7684\u6d3b\u52a8\uff0c\u5305\u62ec\u5929\u7136\u6797\u751f\u957f\u6216\u6811\u6728\u79cd\u690d\u56ed\u7684\u8f6e\u4f5c\u5468\u671f\u3002", "8000cae1cbc9a1d361bda4a41bfb8a8c": "{Location} \u6811\u6728\u8986\u76d6\u51c0\u53d8\u5316\u7684\u7ec4\u6210", "35d72fa7d84f4ae67d705373d1d44b88": "\u589e\u52a0", "ad59f3ee19cece699f8b7bbec3660c17": "2000 \u5e74\u81f3 2020 \u5e74\uff0c\u5168\u4e16\u754c\u7684\u6811\u6728\u8986\u76d6\u51c0\u53d8\u5316\u4e3a {netChange} ({netChangePerc})\u3002", "d6288d0fbfb71158c15896676f5b3576": "\u68ee\u6797\u589e\u52a0", "68e28639e9ee77dbf71e33bee8ced8a2": "\u68ee\u6797\u51cf\u5c11", "b39b49ce8df9d3514521f2a21ee4c61a": "\u5c55\u793a\u6811\u6728\u79cd\u690d\u56ed\u5185\u5916\u7684\u6811\u6728\u8986\u76d6\u589e\u52a0\u3002\u79cd\u690d\u56ed\u5185\u7684\u589e\u52a0\u53ef\u89c6\u4e3a\u6709\u7ba1\u7406\u7684\u751f\u4ea7\u6811\u6728\u751f\u957f\uff0c\u800c\u79cd\u690d\u56ed\u5916\u7684\u589e\u52a0\u53ef\u5f52\u56e0\u4e8e\u5e72\u6270\u3001\u571f\u5730\u5e9f\u5f03\u6216\u6062\u590d\u5e72\u9884\u540e\u7684\u81ea\u7136\u518d\u751f\u3002", "8893f54ac6ba104a3c15f4ce8eb1d9ac": "\u5728 {location}\uff0c\u5728 2000 \u5e74\u81f3 2020 \u5e74\u95f4\uff0c\u524d {percentileLength} \u5730\u533a\u5360\u5168\u90e8\u6811\u6728\u8986\u76d6\u589e\u52a0\u7684 {topGain}\u3002\u4e0e\u5e73\u5747\u503c {average} \u76f8\u6bd4\uff0c{region} \u7684\u6700\u5927\u6811\u6728\u8986\u76d6\u589e\u52a0\u8fbe\u5230\u4e86 {value}\u3002", "89e916854acad48107dc53769ecc59db": "{Location} \u79cd\u690d\u56ed\u5916\u7684\u6811\u6728\u8986\u76d6\u589e\u52a0", "d6620f41bd98a0e7ed2494cabf9d41ae": "2000 \u5e74\u81f3 2020 \u5e74\u95f4\uff0c{location} \u6811\u6728\u8986\u76d6\u589e\u52a0\u7684 {gainPercent} \u53d1\u751f\u5728\u79cd\u690d\u56ed\u5916\u3002", "389cb99d458fbcd671a9a5d82aff856d": "2000 \u5e74\u81f3 2020 \u5e74\uff0c{location} \u589e\u52a0\u4e86 {gain} \u7684\u6811\u6728\u8986\u76d6  {indicator}\uff0c\u76f8\u5f53\u4e8e {parent} \u6811\u6728\u8986\u76d6\u589e\u52a0\u603b\u91cf\u7684 {gainPercent}\u3002", "7666e955ee69ec96408486de8af8b1c3": "30 meters (30 m)", "dba9da6a6995cb1d6702c4cfeba8d59b": "\u5c55\u793a 2000 \u5e74\u548c 2020 \u5e74\u5168\u7403\u68ee\u6797\u51a0\u5c42\u7684\u9ad8\u5ea6\u3002", "2d49b1cf2d51563c9371396cf7aff103": "\u884c\u653f\u533a", "099cfba38d2588646625ed1a6a8a3987": "\u5982\u679c\u4e0d\u5e94\u7528\u5b9a\u4e49\u6b64\u4ea7\u54c1\u4e2d\u68ee\u6797\u9ad8\u5ea6\u589e\u52a0\u548c\u51cf\u5c11\u7684\u9608\u503c\uff0c2000 \u5e74\u4e0e 2020 \u5e74\u68ee\u6797\u9ad8\u5ea6\u4ea7\u54c1\u7684\u76f4\u63a5\u6bd4\u8f83\u4e0d\u4f1a\u63d0\u4f9b\u4e00\u81f4\u7684\u6709\u610f\u4e49\u7ed3\u679c\uff0c\u56e0\u6b64\u4e0d\u53ef\u4e0e\u6b64\u4ea7\u54c1\u6bd4\u8f83\u3002\u5728\u6574\u5408\u5229\u7528 GFW \u53e6\u5916\u63d0\u4f9b\u7684\u5176\u4ed6\u4ea7\u54c1\uff08\u5982\u6811\u51a0\u8986\u76d6\u5bc6\u5ea6\u6570\u636e\uff09\u65f6\uff0c\u5e94\u8c28\u614e\u4ece\u4e8b\u3002", "60689e8c51fcaa70ab6704a30a0f8d3d": "\u51c0\u6811\u6728\u8986\u76d6\u53d8\u5316", "b87d3f385c90b4741ba8b714a8ed3752": "\u6b64\u6570\u636e\u96c6\u662f\u9a6c\u91cc\u5170\u5927\u5b66\u201c\u5168\u7403\u9646\u5730\u5206\u6790\u4e0e\u53d1\u73b0\u201d(Global Land Analysis &amp; Discovery, GLAD) \u5b9e\u9a8c\u5ba4\u3001Google\u3001USGS \u548c NASA \u4e4b\u95f4\u5408\u4f5c\u7684\u7ed3\u679c\uff0c\u6d4b\u91cf\u4e86\u5168\u7403\u6240\u6709\u9646\u5730\uff08\u5357\u6781\u53ca\u5176\u4ed6\u5317\u6781\u5c9b\u5c7f\u9664\u5916\uff09\u884c\u653f\u533a\u7684\u51c0\u6811\u6728\u8986\u76d6\u53d8\u5316\u7684\u9762\u79ef\u3002\u6811\u6728\u8986\u76d6\u53d8\u5316\u662f\u4f7f\u7528 2000 \u5e74\u548c 2020 \u5e74\u7684\u6811\u6728\u8986\u76d6\u8303\u56f4\u786e\u5b9a\u7684\uff0c\u800c\u6811\u6728\u8986\u76d6\u8303\u56f4\u57fa\u4e8e\u6811\u6728\u9ad8\u5ea6\u4fe1\u606f\u3002\u6811\u6728\u9ad8\u5ea6\u901a\u8fc7\u6574\u5408 Global Ecosystem Dynamics Investigation (GEDI) \u6fc0\u5149\u96f7\u8fbe\u68ee\u6797\u7ed3\u6784\u6d4b\u91cf\u4e0e Landsat \u5206\u6790\u5c31\u7eea\u6570\u636e\u65f6\u95f4\u7cfb\u5217\u6765\u786e\u5b9a\u3002NASA GEDI \u662f 2019 \u5e74 4 \u6708\u5f00\u59cb\u5728\u56fd\u9645\u7a7a\u95f4\u7ad9\u4e0a\u8fd0\u884c\u7684\u661f\u8f7d\u6fc0\u5149\u96f7\u8fbe\u4eea\u5668\u3002\u5b83\u63d0\u4f9b\u57fa\u4e8e\u70b9\u7684\u690d\u88ab\u7ed3\u6784\u6d4b\u91cf\uff0c\u5176\u4e2d\u5305\u62ec\u5168\u7403\u5317\u7eac 52\u00b0 \u548c\u5357\u7eac 52\u00b0 \u4e4b\u95f4\u7684\u68ee\u6797\u51a0\u5c42\u9ad8\u5ea6\u30022000 \u5e74\u548c 2020 \u5e74\u7684\u6811\u6728\u8986\u76d6\u8303\u56f4\u5730\u56fe\u5236\u4f5c\u65f6\uff0c\u50cf\u7d20\u4ee3\u8868 \u22655 m \u9ad8\u5ea6\u7684\u6811\u6728\u8986\u76d6\u8303\u56f4\u3002\u6811\u6728\u8986\u76d6\u589e\u51cf\u901a\u8fc7 2000 \u5e74\u548c 2020 \u5e74\u5730\u56fe\u5bf9\u6bd4\u63a8\u5bfc\u800c\u5f97\uff0c\u5e76\u91c7\u53d6\u63aa\u65bd\u6765\u6d88\u9664\u9ad8\u5ea6\u5c0f\u53d8\u5316\u6570\u636e\u201c\u566a\u97f3\u201d\u3002\u7136\u540e\uff0c\u901a\u8fc7\u8ba1\u7b97\u4ee5\u5360 2000 \u5e74\u6811\u6728\u8986\u76d6\u9762\u79ef\u767e\u5206\u6bd4\u8868\u793a\u7684\u6811\u6728\u8986\u76d6\u589e\u51cf\uff0c\u63a8\u5bfc\u51fa\u6bcf\u4e2a\u884c\u653f\u533a\u6811\u6728\u8986\u76d6\u51c0\u53d8\u5316\u767e\u5206\u6bd4\u3002", "aec7a35117f16fd2bd5491a669311345": "&lt;1 ha \u68ee\u6797\u8303\u56f4", "57addf5de041fdba3fb28580d5c1644c": "\u60a8\u662f\u5426\u613f\u610f\u5e2e\u52a9\u6211\u4eec\u4e86\u89e3\u5982\u4f55\u4ee5\u66f4\u6709\u7528\u7684\u65b9\u5f0f\u5c55\u793a\u6b64\u6570\u636e\uff1f\u8bf7<a href=\"{{0}}\" rel=\"noreferrer\" target=\"__BLANK\">\u5355\u51fb\u6b64\u5904\u586b\u5199\u8c03\u67e5</a>\u3002", "8302eb4610f7d1cedfbb83651b9283ac": "\u7531\u4e8e\u7814\u7a76\u65b9\u6cd5\u548c\u5185\u5bb9\u65e5\u671f\u7684\u53d8\u5316\uff0c\u6811\u6728\u8986\u76d6\u3001\u589e\u52a0\u548c\u5e74\u5ea6\u51cf\u5c11\u6570\u636e\u96c6\u65e0\u6cd5\u51c6\u786e\u5730\u4e92\u76f8\u6bd4\u8f83\u3002\u76f8\u5e94\u5730\uff0c\u65e0\u6cd5\u901a\u8fc7\u4ece\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u51cf\u5c11\u4e2d\u51cf\u53bb\uff08\u57fa\u4e8e\u9ad8\u5ea6\u7684\uff09\u6811\u6728\u8986\u76d6\u589e\u52a0\u7684\u6570\u5b57\u6765\u8ba1\u7b97\u201c\u51c0\u201d\u503c\uff0c\u800c\u662f\u5e94\u8be5\u4f7f\u7528\u51c0\u6811\u6728\u8986\u76d6\u53d8\u5316\u5c42\uff0c\u8fd9\u662f\u4e13\u95e8\u6839\u636e\u6811\u6728\u9ad8\u5ea6\u6570\u636e\u8ba1\u7b97\u5f97\u5230\u7684\u3002", "10705f646fad732a07ea0232c666228c": "\u5728\u6574\u5408\u5229\u7528 GFW \u53e6\u5916\u63d0\u4f9b\u7684\u5176\u4ed6\u4ea7\u54c1\uff08\u5982\u6811\u51a0\u8986\u76d6\u5bc6\u5ea6\u6570\u636e\uff09\u65f6\uff0c\u5e94\u8c28\u614e\u4ece\u4e8b\u3002", "f95592ae36ae8bb6538f3907709739b4": "30m, global, Harris et al. 2021", "9e8d24e1ecff135704544923ea0fd872": "2000/2020, 30m, global, UMD/NASA GEDI", "9d1b45fe5127c0b2dee3095d35b44c04": "<strong>\u6301\u7eed</strong>\uff1a\u5728 22 \u5e74\u4e2d\u6709\u8d85\u8fc7 19 \u5e74 (>90%) \u662f\u7edf\u8ba1\u610f\u4e49\u4e0a\u7684\u70ed\u70b9\u4f4d\u7f6e\uff0c\u5e76\u4e14\u6ca1\u6709\u660e\u663e\u7684\u8d8b\u52bf\u53ef\u8868\u660e\u805a\u96c6\u5f3a\u5ea6\u968f\u7740\u65f6\u95f4\u7684\u63a8\u79fb\u800c\u589e\u52a0\u6216\u51cf\u5c11\u3002", "bbef642d92cdfbc3a382702b91743bdd": "Forest Watcher (FW) \u652f\u6301\u79bb\u7ebf\u4f7f\u7528 GFW \u7684\u7a7a\u95f4\u6570\u636e\uff0c\u4ee5\u4fbf\u5728\u91ce\u5916\u76d1\u6d4b\u548c\u7ba1\u7406\u68ee\u6797\u3002\u8bbf\u95ee\u548c\u4f7f\u7528 FW \u7684\u9014\u5f84\u6709\u4e24\u79cd\uff1a<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u79fb\u52a8\u7aef\u5e94\u7528\u7a0b\u5e8f</a>\u548c<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u7f51\u7edc\u7248</a>\u3002", "5f61184eef1ed5df8e516bfbb97fc35e": "\u6982\u89c8", "8b7459ad2078f4239e3823013b17594c": "Forest Watcher \u53d8\u901a\u89e3\u51b3\u529e\u6cd5\u6307\u5bfc", "7b86128fc0b411effe51aff62b1fcd58": "GFW \u56e2\u961f\u66f4\u65b0 FW \u4ee5\u6539\u8fdb\u548c\u589e\u5f3a\u5de5\u5177\u671f\u95f4\uff0c\u5efa\u8bae\u6309\u4ee5\u4e0b\u6307\u5bfc\u89e3\u51b3\u5e38\u89c1\u95ee\u9898\u3002", "d04e8f547583c5619bc4da44cb6f6d95": "<strong>\u73b0\u5728\uff0c\u7ba1\u7406\u4eba\u5458\u53ef\u4ee5\u67e5\u770b\u76d1\u6d4b\u8005\u521b\u5efa\u7684\u6709\u5173\u5176\u56e2\u961f\u7684\u81ea\u5b9a\u4e49\u6a21\u677f\u62a5\u544a</strong>\u3002\u5230\u76ee\u524d\u4e3a\u6b62\uff0c\u7ba1\u7406\u4eba\u5458\u53ea\u80fd\u67e5\u770b\u4f7f\u7528\u9ed8\u8ba4\u6a21\u677f\u521b\u5efa\u7684\u62a5\u544a\u3002", "3a7d81e41942f5fc87ffb0860f123e26": "*FW \u4e0a\u7684\u65b0\u529f\u80fd*", "ff52159c993cbd732b78518d1bec7268": "FW \u4e0a\u73b0\u6709\u9519\u8bef\u7684\u89e3\u51b3\u529e\u6cd5\uff1a", "0bf6dfb172e409259415cea7b52b79d7": "\u8d26\u6237\u767b\u5f55", "09f0dd104211204b7a38cedf72be5bd0": "<strong>\u89e3\u51b3\u529e\u6cd5\uff1a</strong>\u767b\u51fa\u8d26\u6237\uff0c\u7136\u540e\u91cd\u65b0\u767b\u5f55\u3002\u5982\u679c\u6b64\u529e\u6cd5\u65e0\u6548\uff0c\u8bf7\u8bd5\u8bd5\u91cd\u65b0\u542f\u52a8\u5e94\u7528\u7a0b\u5e8f\u3002", "1cdb06b0eddd18a653824c015f9bf593": "<strong>\u95ee\u9898\uff1a</strong>\u4fdd\u5b58\u5728 Flagship \u4e2d\u4e14\u5728\u5730\u56fe\u4e2d\u6709\u73b0\u6210\u8fb9\u754c\u7ebf\u7684\u5173\u6ce8\u533a\u57df\uff08\u6bd4\u5982 GADM\u3001WDPA \u4fdd\u62a4\u533a\u3001\u9646\u5730\u751f\u6001\u533a\u3001\u4e3b\u8981\u6d41\u57df\u7b49\uff09\u5728 FW \u4e2d\u4e0d\u53ef\u7528\u3002", "67c2d225e2688d9eb979d55d3eb476fd": "<strong>\u89e3\u51b3\u529e\u6cd5\uff1a</strong>\u5982\u679c\u8981\u5728 FW \u4e2d\u5229\u7528\u9884\u5148\u786e\u5b9a\u7684\u8fb9\u754c\u521b\u5efa\u81ea\u5b9a\u4e49\u5173\u6ce8\u533a\u57df\uff0c\u53ef\u6cbf\u8be5\u8fb9\u754c\u63cf\u6479\uff0c\u4ee5\u5176\u4e3a\u53c2\u8003\u521b\u5efa\u81ea\u5df1\u7684\u8fb9\u754c\u3002", "1e9572b5f1590571eb5ae50883facdcc": "<strong>\u95ee\u9898\uff1a</strong>\u56e2\u961f\u6210\u5458\u65e0\u6cd5\u67e5\u770b\u5176\u7ba1\u7406\u4eba\u5458\u5206\u4eab\u7684\u533a\u57df\u3002", "719e1ee718b10f76c6c5f5437375c4fa": "<strong>\u95ee\u9898\uff1a</strong>\u81ea\u5b9a\u4e49\u62a5\u544a\u6a21\u677f\u4e0d\u5728 FW \u79fb\u52a8\u7aef\u5e94\u7528\u7a0b\u5e8f\u4e2d\u663e\u793a\u3002", "9306429936b828bfff26d0919a4129fe": "FW \u79fb\u52a8\u7aef\u5e94\u7528\u7a0b\u5e8f", "f04e2dbb88b3303fce59e2b4827c0b5c": "<strong>\u89e3\u51b3\u529e\u6cd5\uff1a</strong>\u786e\u4fdd\u62a5\u544a\u5904\u4e8e\u201c\u5df2\u4e0a\u4f20\u201d(Uploaded) \u72b6\u6001\uff0c\u800c\u4e0d\u662f\u201c\u5df2\u5b8c\u6210\u201d(Completed)\u3002", "829cad19d063cb569f4c9dcd243bdeba": "\u6982\u89c8&nbsp; Forest Watcher (FW) \u6301\u79bb\u7ebf\u4f7f\u7528 GFW \u7684\u7a7a\u95f4\u6570\u636e\uff0c\u4ee5\u4fbf\u5728\u91ce\u5916\u76d1\u6d4b\u548c\u7ba1\u7406\u68ee\u6797\u3002\u8bbf\u95ee\u548c\u4f7f\u7528 FW \u7684\u9014\u5f84\u6709\u4e24\u79cd\uff1a\u79fb\u52a8\u7aef\u5e94\u7528\u7a0b\u5e8f\u548c\u7f51\u7edc\u7248\u3002GFW \u56e2\u961f\u66f4\u65b0 FW \u4ee5\u6539\u8fdb\u548c\u589e\u5f3a\u5de5\u5177\u671f\u95f4\uff0c\u5efa\u8bae [\u2026]", "a396af5bf659bfc062aeb812e5d74f9f": "<strong>\u73b0\u5728\uff0c\u6700\u5c0f\u5316\u5e94\u7528\u7a0b\u5e8f\u4ee5\u53ca/\u6216\u8005\u9501\u5b9a\u5c4f\u5e55\u65f6\uff0c\u8def\u7ebf\u8ddf\u8e2a\u4e0d\u4f1a\u505c\u6b62</strong>\u3002\u4ee5\u524d\uff0c\u7528\u6237\u6267\u884c\u8fd9\u4e9b\u64cd\u4f5c\u65f6\uff0c\u8def\u7ebf\u8ddf\u8e2a\u4f1a\u505c\u6b62\uff0c\u91cd\u65b0\u6253\u5f00\u5e94\u7528\u7a0b\u5e8f\u540e\u624d\u6062\u590d\u3002", "068f077a445e828b7d29ec18b6060038": "\u53d8\u901a\u89e3\u51b3\u529e\u6cd5", "6715474b30f6654b87b46664514a690b": "<strong>\u95ee\u9898\uff1a</strong>\u65e0\u6cd5\u4f7f\u7528\u65e2\u6709\u8d26\u6237\u8bbf\u95ee Forest Watcher\u3002", "516555b2ab54fbaf9e6207f05b7b70eb": "<strong>\u89e3\u51b3\u529e\u6cd5\uff1a</strong>\u786e\u4fdd\u5728 FW \u7f51\u7edc\u7248\u4e2d\u5c06\u8be5\u8868\u5355\u8bbe\u7f6e\u4e3a\u201c\u5df2\u53d1\u5e03\u201d(Published)\u3002", "9b6b795e6be0e2086731ff6796caee73": "Forest Watcher Version 3\uff1a\u65b0\u529f\u80fd", "99d61eb2665bb340e27e9714b50399b1": "\u6211\u4eec\u5f88\u9ad8\u5174\u5206\u4eab\u5bf9 Forest Watcher Version 3 \u7684\u4ee5\u4e0b\u66f4\u65b0\uff0c\u5176\u4e2d\u6709\u4e00\u4e9b\u4ee4\u4eba\u6fc0\u52a8\u7684\u65b0\u529f\u80fd\uff0c\u53ef\u8ba9\u91ce\u5916\u7684\u56e2\u961f\u7ba1\u7406\u548c\u62a5\u544a\u53d8\u5f97\u66f4\u52a0\u65b9\u4fbf\u3002", "3bfea10466f09c9b783c812506de0a0e": "\u4ee5\u4e0b\u66f4\u65b0\u5c06\u5728 Forest Watcher \u4e0a\u5206\u4e24\u4e2a\u9636\u6bb5\u63a8\u51fa\u3002\u8bf7\u67e5\u770b\u4e0b\u9762\u7684\u65f6\u95f4\u8868\uff0c\u4e86\u89e3\u7b2c\u4e00\u8f6e\u66f4\u65b0\u7684\u9884\u671f\u65f6\u95f4\uff0c\u5e76\u6301\u7eed\u5173\u6ce8 2023 \u5e74\u521d\u5c06\u63a8\u51fa\u7684\u5176\u4ed6\u6709\u7528\u7684\u6539\u53d8\u3002", "91daeb049a5b707c3c0251f4c4c2905a": "\u5c06\u6570\u636e\u5bfc\u51fa\u4e3a Shapefile\u3001GeoJSON\u3001CSV \u6216 PDF", "2a42de7e689002a0992e28e53e59dcd7": "\u7b2c 2 \u9636\u6bb5\u2014\u20142023 \u5e74\u521d*", "961d95ca54a2d520f9dd8e7156074313": "\u5f15\u5165\u4efb\u52a1\u6307\u6d3e\u529f\u80fd\uff0c\u6bd4\u5982\uff1a", "74766e7b54c4df65f707a13d496dcfb4": "\u6307\u6d3e\u67d0\u4e2a\u9884\u8b66\u8ba9\u76d1\u6d4b\u8005\u6216\u56e2\u961f\u53bb\u8c03\u67e5&nbsp;\u5728\u91ce\u5916\u5b8c\u6210\u6307\u6d3e\u4efb\u52a1", "5c793c61d88e370ea936c54375ea6a9c": "\u5728\u7f51\u7edc\u4e0a\u6838\u67e5\u6307\u6d3e\u4efb\u52a1\u7684\u72b6\u6001", "a346f054c5ff9835ed40ae8342a64ef7": "\u65b0\u7684\u91ce\u5916\u6570\u636e\u8bb0\u5f55\u65b9\u5f0f\uff0c\u5305\u62ec\uff1a", "cff4ae6c16b4b9a0dffa60049b9f2372": "\u5f55\u5236\u97f3\u9891\u6587\u4ef6", "34a10d5df61a8306f5d50a41c9902fa8": "\u66f4\u65b0\u4ee5\u89e3\u51b3 FW \u4e0a\u4ee5\u524d\u7684\u9519\u8bef\uff1a", "8e99cbdfa75d0e12cdcaeda5349b0ba9": "<strong>\u95ee\u9898\uff1a</strong>FW \u79fb\u52a8\u7aef\u5e94\u7528\u7a0b\u5e8f\u4e2d\u5b8c\u6210\u7684\u62a5\u544a\u4e0d\u5728 FW \u7f51\u7edc\u7248\u4e2d\u663e\u793a\u3002", "48ef66279f7d3def2d9778a7f424bf8d": "\u60a8\u7684\u53cd\u9988\u6709\u52a9\u4e8e\u6211\u4eec\u7ee7\u7eed\u6539\u8fdb Forest Watcher\u3002\u5982\u679c\u60a8\u4ecd\u9047\u5230\u95ee\u9898\uff0c\u8bf7\u8054\u7cfb\u6211\u4eec", "d84f6aa1becd1b67f7172a4728d4be19": "<strong>Forest Watcher</strong> \u662f\u53ef\u79bb\u7ebf\u4f7f\u7528\u7684\u514d\u8d39\u89e3\u51b3\u65b9\u6848\uff0c\u68ee\u6797\u4fdd\u536b\u8005\u53ef\u7528\u5b83\u5728\u91ce\u5916\u5b9a\u4f4d\u3001\u8bb0\u5f55\u548c\u63ed\u9732\u975e\u6cd5\u7684\u68ee\u6797\u780d\u4f10\u6d3b\u52a8\u3002\u91cd\u8981\u7684\u529f\u80fd\u5305\u62ec\uff1a\u4e0b\u8f7d\u68ee\u6797\u53d8\u5316\u9884\u8b66\u3001\u5728\u91ce\u5916\u6536\u96c6\u6570\u636e\u3001\u7ba1\u7406\u56e2\u961f\u4ee5\u53ca\u5206\u4eab\u62a5\u544a\u3002", "4153da01dbe4246610db0c363fe22eac": "\u7b2c 1 \u9636\u6bb5\u2014\u20142022 \u5e74 10 \u6708", "4aadb3334029b379720c65083044771e": "\u65b0\u529f\u80fd\uff0c\u5305\u62ec\uff1a", "7214b4540630b9aefd6439407953376f": "\u5168\u9762\u6539\u8fdb\u56e2\u961f\u7ba1\u7406\uff1a", "c9bf00ed214b04578b603ef745a1914c": "\u4f7f\u7528 Forest Watcher Web \u7ba1\u7406\u591a\u4e2a\u76d1\u6d4b\u8005\u56e2\u961f", "1fb096bb43d28252123a0d530940607b": "\u9488\u5bf9\u67d0\u4e2a\u533a\u57df\uff0c\u76d1\u6d4b\u8005\u6709\u591a\u4e2a\u62a5\u544a\u6a21\u677f\u53ef\u4f9b\u9009\u62e9", "f8cfe9c46ab99d0c4f50e4bb6e20592a": "\u901a\u8fc7\u4ee5\u4e0b\u9014\u5f84\u5bfc\u51fa\u548c\u5206\u4eab\u6570\u636e\uff1a", "bd153125c9996e72216a20d77d2241d9": "\u5c06\u56e2\u961f\u7ba1\u7406\u6743\u8f6c\u8ba9\u7ed9\u4ed6\u4eba\uff0c\u8fd9\u5bf9\u57f9\u8bad\u5f88\u6709\u7528", "f5c97b0ae670f6d50ab7e3bdaeb8146b": "\u5728\u5bfc\u51fa\u548c\u5206\u4eab\u6570\u636e\u65f6\u6392\u9664\u654f\u611f\u4fe1\u606f", "e11fd6dd5142cf3617e4df719f6dc3c9": "\u901a\u8fc7\u7535\u5b50\u90ae\u4ef6\u6216\u94fe\u63a5\u5206\u4eab\u6570\u636e", "0d9c787905dffc995ad23d45c48fec8c": "\u5728\u56fe\u5e93\u4e2d\u62cd\u6444\u591a\u5f20\u7167\u7247\u548c\u89c6\u56fe", "7453acb9c64fae78a0a528ace671936c": "*\u6211\u4eec\u8ba1\u5212\u5728\u8fd9\u4e9b\u529f\u80fd\u4e0a\u7ebf\u540e\u5206\u4eab\u66f4\u591a\u4fe1\u606f\u3002\u60a8\u53ef\u4ee5\u671f\u5f85\u5728 2023 \u5e74\u63a8\u51fa\u7684\u66f4\u65b0\u3002\u8bf7\u5173\u6ce8", "1b66ca5529068b4cf4cf420b0f792581": "\u5173\u6ce8\u533a\u57df", "77d0c9ce47ea2e092e6d5480027881e9": "<strong>\u6ce8\u610f\uff1a</strong>\u5982\u679c\u591a\u4e2a\u7528\u6237\u5c06\u67d0\u4e2a\u73b0\u6709\u8fb9\u754c\u4fdd\u5b58\u4e3a\u7528\u6237\u5173\u6ce8\u533a\u57df\uff0c\u5219\u5728\u540e\u53f0\uff0c\u8be5\u5173\u6ce8\u533a\u57df\u4f1a\u6307\u5411\u6570\u636e\u5e93\u4e2d\u7684\u540c\u4e00\u4e2a\u8bb0\u5f55\u3002\u8bf7\u6ce8\u610f\uff0c\u5982\u679c\u8981\u7f16\u8f91\u8be5\u8fb9\u754c\uff0c\u5c06\u540c\u65f6\u7f16\u8f91\u5176\u4ed6\u7528\u6237\u7684\u8fb9\u754c\u3002", "33f58ab2a018a01eedbce232f972f9da": "<strong>\u89e3\u51b3\u529e\u6cd5\uff1a</strong>\u8981\u4f7f\u7528<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u56e2\u961f\u529f\u80fd</a>\uff0c\u9700\u8981\u6709 <a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">MyGFW \u8d26\u6237</a>\u3002\u8bf7\u786e\u4fdd\u5df2\u5728\u60a8\u7684\u79fb\u52a8\u8bbe\u5907\u4e0a\u7528\u7f51\u7edc\u6d4f\u89c8\u5668\u767b\u5f55\u60a8\u7684 MyGFW \u8d26\u6237\uff0c<em>\u7136\u540e</em>\u518d\u5355\u51fb\u7535\u5b50\u90ae\u4ef6\u4e2d\u7684\u201c\u63a5\u53d7\u56e2\u961f\u9080\u8bf7\u201d(accept team invitation) \u94fe\u63a5\u3002\u5982\u679c\u4e0d\u767b\u5f55 MyGFW \u8d26\u6237\u5c31\u5355\u51fb\u8be5\u94fe\u63a5\uff0c\u7cfb\u7edf\u4e0d\u4f1a\u6ce8\u610f\u5230\u60a8\u63a5\u53d7\u4e86\u9080\u8bf7\uff0c\u4ece\u800c\u9700\u8981\u91cd\u65b0\u767b\u5f55 MyGFW \u5e76\u5355\u51fb\u8be5\u94fe\u63a5\u3002", "cc37fdfebabd5c1071345b7297167a8f": "\u8be5\u79fb\u52a8\u5e94\u7528\u4e13\u4e3a\u5b9e\u5730\u5de1\u903b\u548c\u8c03\u67e5\u6700\u8fd1\u7684\u68ee\u6797\u780d\u4f10\u6216\u706b\u707e\u60c5\u51b5\u800c\u8bbe\u8ba1\u3002\u5b83\u51e0\u4e4e\u53ef\u4ee5\u5b8c\u5168\u79bb\u7ebf\u4f7f\u7528\uff08\u5c3d\u7ba1\u6709\u65f6\u53ef\u80fd\u9700\u8981\u8fde\u63a5\u4e92\u8054\u7f51\u6765\u4e0b\u8f7d\u57fa\u4e8e\u4e91\u7684\u65b0\u6570\u636e\uff0c\u4f8b\u5982\u8b66\u62a5\u6216\u5173\u8054\u56fe\u5c42\uff09\u3002\u5728<a href=\"{{0}}\">Google Play\u5546\u5e97</a>\u6216<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">Apple\u5e94\u7528\u5546\u5e97</a>\u53ef\u4e0b\u8f7d\u6b64\u5e94\u7528\uff0c\u5b83\u80fd\u4f5c\u4e3a\u72ec\u7acb\u5de5\u5177\u4f7f\u7528\u6216\u4e0eForest Watcher\u7f51\u7edc\u7248\u7ed3\u5408\u4f7f\u7528\u3002 ", "82484c64d6bda82f69b07051275396e7": "\u521b\u5efa\u548c\u7ba1\u7406\u5173\u6ce8\u533a\u57df\n", "ca3cafc595059a282125aebe2a55d41e": "\u5bfc\u822a\u81f3\u5173\u6ce8\u533a\u57df\u5e76\u62a5\u544a\u60a8\u7684\u53d1\u73b0", "bc67d3ff4bd25cdaf1e16476da60c096": "\u8def\u7ebf\u8ddf\u8e2a", "466b22be41a06b2281921415bffaff58": "\u7ba1\u7406\u5df2\u4fdd\u5b58\u5230MyGFW\u7684\u533a\u57df", "2e11073dc4ea9a6d7369860e2b7e59d6": "\u4e0e\u5176\u4ed6\u8bbe\u5907\u5171\u4eab\u5e94\u7528\u7a0b\u5e8f\u5305\n", "2d88a08094d7c2e295df92323499b2dc": "Forest Watcher\u7f51\u7edc\u7248", "28783c276d9895ff0b517b3d96ec0c1f": "Forest Watcher\u7f51\u7edc\u7248\u63d0\u4f9b\u66f4\u591a\u7684\u81ea\u5b9a\u4e49\u548c\u7ba1\u7406\u9009\u9879\uff0c\u5b83\u53ef\u4e0e Forest Watcher\u79fb\u52a8\u5e94\u7528\u7248<s></s>\u540c\u6b65\u6570\u636e\uff0c\u4e14\u5fc5\u987b\u8fde\u63a5\u4e92\u8054\u7f51\u624d\u80fd\u4f7f\u7528\u3002", "3820372ec328fff4c43b8a7918d9cba0": "\u521b\u5efa\u5173\u6ce8\u533a\u57df ", "a3393e640a17284917dcdc36d26e93e1": "\u67e5\u770b\u548c\u4e0b\u8f7d\u81ea\u5df1\u6216\u56e2\u961f\u521b\u5efa\u7684\u62a5\u544a ", "bec5bf5dc02eb842c1385b160726dbf4": "\u82e5\u8981\u8be6\u7ec6\u4e86\u89e3Forest Watcher\uff0c\u53ef\u53c2\u9605\u5206\u6b65\u8bf4\u660e\u3001\u9644\u52a0\u57f9\u8bad\u6750\u6599\u3001\u5e38\u89c1\u95ee\u9898\u89e3\u7b54\uff0c\u4ee5\u53ca\u53c2\u52a0\u7f51\u7edc\u7814\u8ba8\u4f1a\u3002\n", "7d89895660831571597ab6231bd747b9": "\u4e86\u89e3\u6700\u65b0\u66f4\u65b0", "f49dcc64eb6783fb36876ac765c8edb8": "\u5728GFW\u7684\u535a\u5ba2\u4e0a\u53ef\u67e5\u770b\u6709\u5173\u6570\u636e\u548c\u5de5\u5177\u7684\u6587\u7ae0\u3001GFW\u7528\u6237\u5b9e\u5730\u8003\u5bdf\u7684\u6545\u4e8b\u4ee5\u53ca\u6211\u4eec\u7814\u7a76\u56e2\u961f\u7684\u53d1\u73b0\u3002", "80453566f920b4a51df6277a1dbbc411": "\u63a2\u7d22Global Forest Review", "44ccf74dd4f9505e2e252e805bea6f95": "2021\u5e74\u6811\u6728\u8986\u76d6\u635f\u5931\u60c5\u51b5\u7684\u6570\u636e\u5206\u6790", "7a8e3c62c6b228070a2a764351fe69b8": "\u67e5\u770b\u5df2\u63d0\u4ea4\u7684\u62a5\u544a", "d085523bae4fa5918eb4418318012844": "\u81ea\u5b9a\u4e49\u62a5\u544a\u6a21\u677f ", "6e69a5138cdac79f79c8bd807013d16b": "\u4e0a\u4f20\u548c\u7ba1\u7406\u591a\u4e2a\u5173\u6ce8\u533a\u57df ", "3804a92947dc32799128dbb4decb3b22": "\u521b\u5efa\u548c\u7ba1\u7406\u68ee\u6797\u76d1\u6d4b\u56e2\u961f", "b56fd330dcef36d9e1b471e6a98ac77c": "\u5173\u6ce8\u533a\u57df\u4e5f\u53ef\u4ee5\u5728Forest Watcher\u548c <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">MyGFW</a>\u4e4b\u95f4\u8fdb\u884c\u540c\u6b65\u3002", "2b80a4c40d069ec09dc4f25bc1f9d9a2": "\u4e16\u754c\u68ee\u6797\u72b6\u51b5", "9d4c3e1893d1607e23e3f73c98aa60e5": "\u67e5\u9605Global Forest Review\uff08\u5168\u7403\u68ee\u6797\u8bc4\u8bba\uff09\uff0c\u63a2\u7d22\u6709\u5173\u6811\u6728\u8986\u76d6\u7387\u635f\u5931\u8d8b\u52bf\u548c\u68ee\u6797\u72b6\u51b5\u7684\u6df1\u5165\u62a5\u544a\u548c\u5206\u6790\u3002", "c9d5913fe0813378b333bf588ca39862": "Forest Watcher\u624b\u673a\u5e94\u7528", "dc4438ed3b12a3e6a6061d4fdd19fc9e": "Forest Watcher\u624b\u673a\u5e94\u7528\u7a0b\u5e8f\u652f\u6301\u79bb\u7ebf\u4f7f\u7528\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u8b66\u62a5\u7cfb\u7edf\uff0c\u56e0\u6b64\u60a8\u5728\u91ce\u5916<s></s>\u53ef\u76f4\u63a5\u901a\u8fc7\u667a\u80fd\u624b\u673a\u76d1\u63a7\u548c\u7ba1\u7406\u68ee\u6797\u3002\u60a8\u53ef\u5728\u6b64\u624b\u673a\u5e94\u7528\u4e2d\u8bbe\u7f6e\u5173\u6ce8\u533a\u57df\u3001\u4e0b\u8f7d\u5e76\u5bfc\u822a\u81f3\u8b66\u62a5\u533a\u57df\u3001\u81ea\u5b9a\u4e49\u5e95\u56fe\u3001\u8ddf\u8e2a\u60a8\u7684\u8def\u7ebf<s></s>\uff0c\u5e76\u4e14\u5373\u4f7f\u6ca1\u6709\u4e92\u8054\u7f51\u8fde\u63a5\u4e5f\u53ef\u8fdb\u884c\u8c03\u67e5\u5e76\u62a5\u544a\u60a8\u7684\u53d1\u73b0\u3002\u60a8\u8fd8\u53ef\u4ece\u7535\u8111\u5728\u7ebf\u8bbf\u95eeForest Watcher\u7f51\u7edc\u7248\uff0c\u4ee5\u8fdb\u884c\u66f4\u591a\u64cd\u4f5c\u3002\u6b64\u5916\uff0c\u4f60\u8fd8\u80fd\u5728Forest Watcher\u548c<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">MyGFW</a>\u4e4b\u95f4\u540c\u6b65\u5173\u6ce8\u533a\u57df\u3002", "74995d301df20ada87f6efa78e94e079": "\u8bbf\u95eeForest Watcher\u6709\u4e24\u79cd\u65b9\u5f0f\uff1a ", "d6295c05503596b3ed3528aee83e3ef7": "\u529f\u80fd\uff1a", "c51a5396f1999e7b1d2d723b1f29663a": "\u7ba1\u7406\u5173\u8054\u6570\u636e\u5c42", "85a9526012839b3ac50360b3225ee768": "\u79bb\u7ebf\u5bfc\u51fa\u5e94\u7528\u5185\u5bb9\u5e76\u4e0e\u5176\u4ed6\u8bbe\u5907\u5171\u4eab", "f832a6433fa233ce5c2192d59a14f13a": "\u5bfc\u51fa\u5355\u4e2a\u533a\u57df\u3001\u62a5\u544a\u3001\u8def\u7ebf\u3001\u5e95\u56fe\u548c\u5173\u8054\u56fe\u5c42 ", "c91d64a06c8df7cdad80232e017bc36a": "\u4e0b\u8f7d\u3001\u67e5\u770b\u3001\u9009\u62e9\u4ee5\u53ca\u5bfc\u822a\u81f3\u8b66\u62a5\u533a\u57df", "0034842b9b52b0e11fb9f1b9deba3e6c": "\u4e3a\u8b66\u62a5\u533a\u57df\uff08\u6216\u5730\u56fe\u4e0a\u7684\u4efb\u610f\u4f4d\u7f6e\uff09\u521b\u5efa\u7167\u7247\u548c\u6587\u672c\u62a5\u544a\uff0c\u4e0b\u8f7d\u5e76\u5171\u4eab\u5b83\u4eec", "8df5131ec30dc5c86dd7e78741a2ae61": "\u5728\u4eea\u8868\u677f\u4e0a\u67e5\u770b\u81ea\u5b9a\u4e49\u533a\u57df\u7684\u68ee\u6797\u7edf\u8ba1\u6570\u636e ", "4fa0eac7004a530726f48dafd807aebf": "\u4e0a\u4f20\u81ea\u5b9a\u4e49\u5e95\u56fe\u548c\u5173\u8054\u56fe\u5c42 ", "114643dde1bbcaea998d54ee15ee32a0": "\u529f\u80fd\uff1a", "af421010ddf7da9af31833038805bb44": "\u68ee\u6797\u5b88\u62a4\u8005\u6253\u51fb\u975e\u6cd5\u780d\u4f10\u6d3b\u52a8", "9b8f8f07ff99dc93d21c6d032906fd65": "\u6392\u653e\u91cf\u53cd\u6620\u7684\u662f\u4e00\u4e2a\u7c97\u7565\u7684\u4f30\u7b97\uff0c\u5373\u672a\u5305\u62ec\u53d1\u751f\u5e72\u6270\u540e\u68ee\u6797\u518d\u751f\u4ea7\u751f\u7684\u78b3\u6e05\u9664\u91cf\u3002\u800c\u603b\u78b3\u6e05\u9664\u91cf\u8ba1\u5165\u4e86\u9644\u5e26\u7684\u68ee\u6797\u78b3\u6e05\u9664\u56fe\u5c42\u548c\u51c0\u901a\u91cf\u56fe\u4e2d\u3002", "ffe445af6c894ef6eaa56e19ba1d4292": "\u6570\u503c\u9002\u7528\u4e8e\u68ee\u6797\u533a\u57df\uff08\u6811\u51a0\u8986\u76d6\u7387 > 30% \u4e14\u9ad8\u5ea6 > 5 \u7c73\uff0c\u6216\u6797\u6728\u8986\u76d6\u7387\u589e\u52a0\u7684\u533a\u57df\uff09\u3002\u6709\u5173\u5206\u6790\u4e2d\u4f7f\u7528\u7684\u68ee\u6797\u5b9a\u4e49\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605 Harris et al. (2021)\u3002", "43b0f4db411d703b85d574249c22779a": "\u5168\u7403\u6240\u6709\u690d\u88ab\u7684\u5168\u65b0\u8fd1\u5b9e\u65f6\u5e72\u6270\u8b66\u62a5\u73b0\u5df2\u63a8\u51fa\uff01 <a href=\"{{0}}\">\u8bf7\u5728\u6b64\u67e5\u770b</a>\u5e76<a href=\"{{1}}\">\u5728\u8fd9\u91cc\u4e86\u89e3\u8be6\u60c5</a>\u3002", "76d60ad8bac11e0048236249e0e63473": "10 \u7c73\u5206\u8fa8\u7387\u53ef\u7a7f\u900f\u4e91\u5c42\u7684\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u73b0\u5df2\u8986\u76d6\u4e1c\u5357\u4e9a\u5927\u9646\u7684\u5176\u4ed6 5 \u4e2a\u56fd\u5bb6\uff1a\u67ec\u57d4\u5be8\u3001\u8d8a\u5357\u3001\u8001\u631d\u3001\u7f05\u7538\u548c\u6cf0\u56fd\u3002\u5728<a href=\"{{0}}\">\u96c6\u6210\u7684\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u56fe\u5c42</a>\u4e2d\u67e5\u770b\u5427\uff01", "c3494137aea4224aab6e22bb39180d87": "20 \u5e74\uff0c\u5168\u7403\uff0cUMD/NASA GEDI", "433edd1b7dfc8430a38c4ad41a8f2eb9": "\u65b0\uff1aRADD \u8b66\u62a5\u5df2\u6269\u5c55\u81f3\u4e1c\u5357\u4e9a", "1e291ce66ada9600af67484fa1761c1c": "\u7528\u6237\u5728\u884c\u52a8", "3698304431855e8dc69903f5bec0996e": "<b></b>\u67e5\u8be2\u81ea\u5b9a\u4e49\u51e0\u4f55\u6570\u636e", "f79db9f900c824d8ea5a4ca22d4dba4e": "<b></b>\u68ee\u6797\u780d\u4f10\u96c6\u6210\u8b66\u62a5", "32621e41a465c45d985e537f45215891": "\u867d\u7136\u88ab\u79f0\u4e3a\u201c\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u201d\uff0c\u4f46\u8fd9\u4e9b\u8b66\u62a5\u4f1a\u68c0\u6d4b\u68ee\u6797\u6216\u6811\u6728\u8986\u76d6\u7684\u5e72\u6270\u6d3b\u52a8\u3002\u672c\u4ea7\u54c1\u4e0d\u533a\u5206\u4eba\u4e3a\u5e72\u6270\u548c\u5176\u4ed6\u5e72\u6270\u7c7b\u578b\u3002\u5982\u679c\u5728\u4eba\u5de5\u6797\u4e2d\u68c0\u6d4b\u5230\u8b66\u62a5\uff08\u5728 GLAD-L \u7cfb\u7edf\u4e2d\u66f4\u53ef\u80fd\u53d1\u751f\uff0c\u5219\u8be5\u8b66\u62a5\u53ef\u80fd\u4ee3\u8868\u6728\u6750\u91c7\u4f10\u4f5c\u4e1a\uff0c\u800c\u4e0d\u4f1a\u8f6c\u53d8\u4e3a\u975e\u6797\u5730\u7528\u9014\u3002", "2a21d6491b78bc82a72e8bb2eac24fe6": "<strong>GLAD-S2</strong>\uff1a\u4ece 2019 \u5e74 1 \u6708\u81f3\u4eca\u5728\u5357\u7f8e\u6d32\u7684\u70ed\u5e26\u539f\u59cb\u6e7f\u6797\u5730\u533a\u8fd0\u884c", "6bf20b1a5a0c9d4052badca02d99b26b": "\u201c\u6700\u9ad8\u7f6e\u4fe1\u5ea6\uff1a\u7531\u591a\u4e2a\u8b66\u62a5\u7cfb\u7edf\u68c0\u6d4b\u5230\u201d\uff0c\u8fd9\u4e00\u7ea7\u522b\u53ea\u80fd\u5728\u591a\u4e2a\u8b66\u62a5\u7cfb\u7edf\u8fd0\u884c\u7684\u533a\u57df\u548c\u65f6\u95f4\u6bb5\u5185\u8fbe\u5230\u3002", "0f1e451ea68ac720d8868b75adc494d0": "\u968f\u7740\u6e90\u6570\u636e\u7684\u66f4\u65b0\uff0c\u7f6e\u4fe1\u6c34\u5e73\u53ef\u80fd\u4f1a\u53d1\u751f\u8ffd\u6eaf\u6027\u53d8\u5316", "f5cb799b3b2732d592520f2939190a08": "\u5728 180 \u5929\u5185\u672a\u53d8\u4e3a\u9ad8\u7f6e\u4fe1\u5ea6\u7684\u8b66\u62a5\u5c06\u4ece\u6570\u636e\u96c6\u4e2d\u5220\u9664", "ef920d2f66a1d025e0d154f4b72a8b2a": "\u7531\u4e8e\u4e09\u4e2a\u8b66\u62a5\u7cfb\u7edf\u7684\u4e0d\u540c\u7279\u5f81\uff0c\u96c6\u6210\u8b66\u62a5\u8986\u76d6\u8303\u56f4\u7684\u51c6\u786e\u6027\u5404\u4e0d\u76f8\u540c\u2014\u2014\u4f8b\u5982\uff0c\u7531\u4e8e\u77ed\u6ce2\u957f C \u6ce2\u6bb5\u96f7\u8fbe\u5bf9\u6e7f\u5ea6\u53d8\u5316\u7684\u9ad8\u7075\u654f\u5ea6\uff0cRadar (RADD) \u8b66\u62a5\u5728\u6cbc\u6cfd\u68ee\u6797\u4e2d\u53ef\u80fd\u51fa\u73b0\u66f4\u591a\u9519\u8bef\u68c0\u6d4b", "c3a3caafce27c0522919042e41b2935d": "\u5728\u9ad8\u7f6e\u4fe1\u5ea6\u8b66\u62a5\u50cf\u7d20\u4e0a\u7684\u68ee\u6797\u635f\u5931\u4e0d\u4f1a\u518d\u6b21\u68c0\u6d4b\u3002", "add3dae886655e97024976f7ca9b893e": "\u7f29\u5c0f\u65f6\uff0c\u6b64\u6570\u636e\u5c42\u663e\u793a\u4f1a\u51fa\u73b0\u67d0\u79cd\u7a0b\u5ea6\u7684\u4e0d\u51c6\u786e\u6027\uff0c\u56e0\u4e3a\u6570\u636e\u70b9\u5fc5\u987b\u6298\u53e0\u624d\u80fd\u5728\u66f4\u5927\u6bd4\u4f8b\u4e0a\u53ef\u89c1\u3002\u8bf7\u653e\u5927\u4ee5\u83b7\u53d6\u66f4\u591a\u8be6\u7ec6\u4fe1\u606f\u3002&nbsp;", "4ff29acbb171e58d8b16e77ab6793dc4": "<b></b>\u5728\u6570\u636e\u76ee\u5f55\u4e2d\u53d1\u73b0\u6570\u636e\u96c6", "42ab1c672af03fc17cacf7fd6961d9ef": "<b></b>\u521b\u5efa\u548c\u4f7f\u7528 API \u5bc6\u94a5", "75691b35e13bdd05a23728d19143e3b2": "\u8be5\u6570\u636e\u96c6\u7531 Global Forest Watch \u6c47\u7f16\u800c\u6210\uff0c\u5c06\u6765\u81ea\u4e09\u4e2a\u8b66\u62a5\u7cfb\u7edf\uff08GLAD-L\u3001GLAD-S2\u3001RADD\uff09\u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u6c47\u603b\u5230\u4e00\u4e2a\u5355\u4e00\u7684\u3001\u96c6\u6210\u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u5c42\u4e2d\u3002\u76f8\u6bd4\u4efb\u4f55\u5355\u4e2a\u7cfb\u7edf\uff0c\u8fd9\u79cd\u96c6\u6210\u7cfb\u7edf\u53ef\u4ee5\u8ba9\u7528\u6237\u66f4\u5feb\u5730\u68c0\u6d4b\u5230\u68ee\u6797\u780d\u4f10\u4e8b\u4ef6\uff0c\u56e0\u4e3a\u5f53\u4efb\u4f55\u6e90\u8b66\u62a5\u7cfb\u7edf\u66f4\u65b0\u65f6\uff0c\u96c6\u6210\u5c42\u4e5f\u4f1a\u66f4\u65b0\u3002", "314e169cd68e44331770889f9c98a0c3": "<b></b>\u5206\u6790\u5730\u56fe\u4e0a\u67d0\u4e2a\u533a\u57df\u5185\u7684\u6570\u636e", "bfce9909cf10286bb448d262e4010349": "<b></b>Forest Watcher \u89e3\u51b3\u65b9\u6cd5\u6307\u5357", "3af427783fb6532306e965c4e3770e1d": "<b></b>\u68ee\u6797\u5730\u56fe\u96c6", "d289bc9d72531895687aaa27e84ad205": "\u4f7f\u7528\u68ee\u6797\u780d\u4f10\u4e00\u8bcd\uff0c\u662f\u56e0\u4e3a\u8fd9\u4e9b\u662f\u6f5c\u5728\u7684\u68ee\u6797\u780d\u4f10\u4e8b\u4ef6\uff0c\u53ef\u5bf9\u8b66\u62a5\u8fdb\u884c\u8fdb\u4e00\u6b65\u8c03\u67e5\u4ee5\u786e\u5b9a\u3002", "a472be0eb8f97827b885aaa362cccfac": "\u4f7f\u7528\u6765\u81ea\u4e09\u4e2a\u8b66\u62a5\u7cfb\u7edf\u7684\u96c6\u6210\u8b66\u62a5\uff0c\u8fd1\u4e4e\u5b9e\u65f6\u5730\u76d1\u6d4b\u68ee\u6797\u5e72\u6270\u6d3b\u52a8", "7abc65081febea231460de45ddc84fdf": "\u8b66\u62a5\u53ef\u4ee5\u7ecf\u8fc7\u201c\u7b5b\u9009\u201d\uff0c\u4ee5\u8bc6\u522b\u7528\u6237\u611f\u5174\u8da3\u7684\u8b66\u62a5\uff0c\u4f8b\u5982\u53ef\u80fd\u662f\u68ee\u6797\u780d\u4f10\u4e14\u53ef\u80fd\u9700\u8981\u4f18\u5148\u91c7\u53d6\u884c\u52a8\u7684\u8b66\u62a5\u3002\u7528\u6237\u53ef\u4ee5\u901a\u8fc7\u53e0\u52a0\u5176\u4ed6\u573a\u666f\u6570\u636e\u96c6\uff08\u4f8b\u5982\u4fdd\u62a4\u533a\u6216\u79cd\u690d\u7684\u6811\u6728\uff09\u6765\u5b8c\u6210\u6b64\u64cd\u4f5c\u3002\u6b64\u5904\u63d0\u4f9b\u672a\u7ecf\u7b5b\u9009\u7684\u6570\u636e\uff0c\u4ee5\u4fbf\u7528\u6237\u53ef\u4ee5\u5b9a\u4e49\u81ea\u5df1\u7684\u4f18\u5148\u7ea7\u65b9\u6cd5\u3002 \u201cPlaces to Watch\u201d \u6570\u636e\u5c42\u4e2d\u63d0\u4f9b\u4e86\u7b5b\u9009\u7684\u8b66\u62a5\u4f4d\u7f6e\u3002", "8c826aede67490552613814bf53045f8": "\u4e09\u4e2a\u8b66\u62a5\u7cfb\u7edf\u5bf9\u68ee\u6797/\u6811\u6728\u8986\u76d6\u548c\u68ee\u6797/\u6811\u6728\u8986\u76d6\u5e72\u6270\u6d3b\u52a8\u7684\u5b9a\u4e49\u4e0d\u540c\uff1a", "b6a7791d406adcb2879b1e696ff880a1": "<strong>RADD</strong>\uff1a\u8b66\u62a5\u4f4d\u4e8e\u539f\u59cb\u6e7f\u6797\u5185\u3002\u68ee\u6797\u635f\u5931\u7684\u5b9a\u4e49\u4e3a\u4e00\u4e2a\u50cf\u7d20\u5185\u7684\u6811\u6797\u690d\u88ab\u5b8c\u5168\u6216\u90e8\u5206\u53bb\u9664\uff0c\u4f7f\u7528 0.5 ha \u7684\u6700\u5c0f\u5236\u56fe\u5355\u4f4d\u3002", "153c16729f446c34a2d81ac4d1b8ea86": "\u8f93\u5165\u8b66\u62a5\u7cfb\u7edf\u7684\u7a7a\u95f4\u548c\u65f6\u95f4\u8986\u76d6\u8303\u56f4\u4e0d\u540c\uff1a<br>", "9136c72689eba8de3a2ea4a62edf6760": "<strong>GLAD-S2</strong>\uff1a\u8b66\u62a5\u4f4d\u4e8e\u4e9a\u9a6c\u900a\u6cb3\u6d41\u57df <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Turubanova et al (2018)</a> \u7684\u539f\u59cb\u68ee\u6797\u63a9\u7801\u5185\uff0c2001 \u5e74\u81f3\u4eca\u6765\u81ea <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a> \u7684\u68ee\u6797\u635f\u5931\u5df2\u5220\u9664\u3002&nbsp;", "bea0b8d070b0b1ab5031412ab4f63a96": "<strong>GLAD-L</strong>\uff1a\u8b66\u62a5\u4f4d\u4e8e\u201c\u6811\u6728\u8986\u76d6\u201d\u8303\u56f4\u5185\uff0c\u201c\u6811\u6728\u8986\u76d6\u201d\u7684\u5b9a\u4e49\u4e3a\u6240\u6709\u9ad8\u5ea6\u8d85\u8fc7 5 \u7c73\u4e14\u6811\u51a0\u8986\u76d6\u7387\u8d85\u8fc7 60% \u7684\u690d\u88ab\uff0c\u53ef\u80fd\u4ee5\u5929\u7136\u6797\u6216\u79cd\u690d\u56ed\u7684\u5f62\u5f0f\u5b58\u5728\u3002 \u201c\u6811\u6728\u8986\u76d6\u635f\u5931\u201d\u8868\u793a\u6811\u51a0\u79fb\u9664\u81f3\u5c11\u534a\u4e2a\u50cf\u7d20\uff0c\u8fd9\u53ef\u80fd\u7531\u591a\u79cd\u56e0\u7d20\u9020\u6210\uff0c\u5305\u62ec\u673a\u68b0\u91c7\u4f10\u3001\u706b\u707e\u3001\u75be\u75c5\u6216\u98ce\u66b4\u7834\u574f\u3002\u56e0\u6b64\uff0c\u201c\u635f\u5931\u201d\u5e76\u4e0d\u7b49\u540c\u4e8e\u68ee\u6797\u780d\u4f10\u3002", "753d69cc57220575e973ef25a5254a65": "<strong>GLAD-L</strong>\uff1a\u4ece 2018 \u5e74 1 \u6708 1 \u65e5\u81f3\u4eca\u5728\u6574\u4e2a\u70ed\u5e26\u5730\u533a\uff0830\u00b0N \u5230 30\u00b0S\uff09\u8fd0\u884c\uff0c\u4ece 2015 \u5e74\u81f3\u4eca\uff08\u5c3d\u7ba1\u5728 2022 \u5e74\u6682\u505c\u4e86\u4e00\u6bb5\u65f6\u95f4\uff09\u5728\u4e9a\u9a6c\u900a\u3001\u521a\u679c\u76c6\u5730\u548c\u4e1c\u5357\u4e9a\u5c9b\u5c7f\u7684\u6307\u5b9a\u56fd\u5bb6\u8fd0\u884c", "275d90927ff88afeec8219debb89009f": "<strong>RADD</strong>\uff1a\u5728\u5357\u7f8e\u6d32\u3001\u6492\u54c8\u62c9\u4ee5\u5357\u975e\u6d32\u548c\u4e1c\u5357\u4e9a\u5c9b\u5c7f\u7684\u70ed\u5e26\u539f\u59cb\u6e7f\u6797\u5730\u533a\u4ee5 10 m \u7684\u7a7a\u95f4\u5206\u8fa8\u7387\u8fd0\u884c\uff0c\u975e\u6d32\u7684\u8986\u76d6\u65f6\u95f4\u4e3a 2019 \u5e74 1 \u6708\u81f3\u4eca\uff0c\u5357\u7f8e\u6d32\u548c\u4e1c\u5357\u4e9a\u7684\u8986\u76d6\u65f6\u95f4\u4e3a 2020 \u5e74 1 \u6708\u81f3\u4eca", "9a8c040d15b285ed66f1fd60ef2ac320": "\u4e3a\u4e86\u5c06\u4e09\u4e2a\u8b66\u62a5\u7cfb\u7edf\u96c6\u6210\u5728\u4e00\u4e2a\u516c\u5171\u7f51\u683c\u4e0a\uff0cGLAD-L \u4ece 30 m \u7a7a\u95f4\u5206\u8fa8\u7387\u91cd\u65b0\u91c7\u6837\u5230 10 m\uff0c\u4ee5\u5339\u914d GLAD-S2 \u548c RADD\u3002\u56e0\u6b64\uff0c\u96c6\u6210\u5c42\u4e2d\u7684\u50cf\u7d20\u53ef\u80fd\u4e0e\u5355\u4e2a GLAD-L \u5c42\u4e2d\u7684\u50cf\u7d20\u4e0d\u5b8c\u5168\u4e00\u81f4\u3002 <br>", "a3c275764e374b81123ec291fb581020": "\u96c6\u6210\u5c42\u4e2d\u7684\u6bcf\u4e2a\u50cf\u7d20\u90fd\u4f1a\u4fdd\u7559\u6240\u6709\u8b66\u62a5\u7cfb\u7edf\u7684\u6700\u65e9\u68c0\u6d4b\u65e5\u671f\uff0c\u5373\u4f7f\u591a\u4e2a\u7cfb\u7edf\u5df2\u5728\u8be5\u50cf\u7d20\u4e2d\u62a5\u544a\u4e86\u8b66\u62a5\u3002\u5728\u67d0\u4e9b\u60c5\u51b5\u4e0b\uff0c\u5728\u4ece\u96c6\u6210\u5c42\u5207\u6362\u5230\u5355\u72ec\u7684\u8b66\u62a5\u7cfb\u7edf\u5c42\u65f6\uff0c\u53ef\u80fd\u4f1a\u4ea7\u751f\u4e0d\u4e00\u81f4\u7684\u53ef\u89c6\u5316\u6548\u679c\u3002\u5982\u679c\u60a8\u5bf9\u4efb\u4f55\u8b66\u62a5\u7cfb\u7edf\u7684\u6700\u65e9\u68c0\u6d4b\u65e5\u671f\u611f\u5174\u8da3\uff0c\u5efa\u8bae\u4f7f\u7528\u96c6\u6210\u5c42\u3002\u4f46\u662f\uff0c\u5982\u679c\u60a8\u5bf9\u67d0\u4e2a\u7279\u5b9a\u7684\u8b66\u62a5\u7c7b\u578b\u611f\u5174\u8da3\uff0c\u6700\u597d\u4f7f\u7528\u5355\u72ec\u7684\u8b66\u62a5\u7cfb\u7edf\u5c42\u3002", "e57f593af48fb1d9d393c59d0a4752bb": "<b></b>\u4f7f\u7528\u5730\u56fe\u548c\u4fe1\u606f\u4e2d\u5fc3", "4e2da60d1b78bc2cc843c5f355558f43": "<b></b>\u4e0b\u8f7d\u68ee\u6797\u7edf\u8ba1\u4fe1\u606f", "7e94f7e444c69f8530ee1cd2e4187d51": "<b></b>\u68ee\u6797\u780d\u4f10\u8b66\u62a5", "41e4952a9e9209c14562721e9c0fc596": "\u5f53\u5355\u4e2a\u8b66\u62a5\u7cfb\u7edf\u68c0\u6d4b\u5230\u4e24\u6b21\u8b66\u62a5\u65f6\uff0c\u8be5\u8b66\u62a5\u88ab\u5f52\u7c7b\u4e3a_\u9ad8_\u7f6e\u4fe1\u5ea6\u3002\u8fd9\u53ef\u80fd\u53d1\u751f\u5728\u53ea\u6709\u4e00\u4e2a\u8b66\u62a5\u7cfb\u7edf\u8fd0\u884c\u7684\u533a\u57df\u548c\u65f6\u95f4\u3002\u5728\u591a\u4e2a\u8b66\u62a5\u7cfb\u7edf\u8fd0\u884c\u7684\u60c5\u51b5\u4e0b\uff0c\u7531\u591a\u4e2a\uff08\u4e24\u4e2a\u6216\u4e09\u4e2a\uff09\u7cfb\u7edf\u68c0\u6d4b\u5230\u7684\u8b66\u62a5\u88ab\u5f52\u7c7b\u4e3a_\u6700\u9ad8_\u7f6e\u4fe1\u5ea6\u3002\u901a\u8fc7\u591a\u4e2a\u4f20\u611f\u5668\u5728\u540c\u4e00\u4f4d\u7f6e\u68c0\u6d4b\u5230\u53d8\u5316\uff0c\u6211\u4eec\u53ef\u4ee5\u66f4\u52a0\u786e\u4fe1\u8be5\u8b66\u62a5\u4e0d\u662f\u8bef\u62a5\uff0c\u800c\u65e0\u9700\u7b49\u5f85\u989d\u5916\u7684\u536b\u661f\u56fe\u50cf\u6765\u786e\u4fe1\u68c0\u6d4b\u5230\u7684\u68ee\u6797\u635f\u5931\uff0c\u548c\u5355\u4e00\u8b66\u62a5\u7cfb\u7edf\u76f8\u6bd4\uff0c\u53ef\u4ee5\u66f4\u5feb\u5730\u63d0\u4f9b\u7f6e\u4fe1\u5ea6\u66f4\u9ad8\u7684\u8b66\u62a5\u3002", "1c0fabe85ee2b8dad5a70575c3fa8feb": "<b></b>\u4f7f\u7528 Global Forest Watch \u63a2\u7d22\u6d3b\u8dc3\u706b\u707e\u548c\u8d8b\u52bf", "37a5f791bc91f3a1bf2da6b0f89029b1": "<b></b>\u5728 Forest Watcher \u79fb\u52a8\u5e94\u7528\u4e0a\u76d1\u63a7\u611f\u5174\u8da3\u7684\u533a\u57df", "3c5aef8f251a794f7e441192252b368a": "<b></b>\u5728\u4eea\u8868\u677f\u4e0a\u67e5\u770b\u5168\u7403\u3001\u56fd\u5bb6\u548c\u56fd\u5bb6\u4ee5\u4e0b\u5404\u7ea7\u68ee\u6797\u7edf\u8ba1\u6570\u636e", "58f5e316de8e304a9c78c489597750ba": "<b></b>\u4fdd\u5b58\u533a\u57df\u5e76\u8ba2\u9605\uff0c\u4ee5\u63a5\u6536\u68ee\u6797\u53d8\u5316\u901a\u77e5", "43bdfbcf2cc4bb605ac92e801d9d2937": "<b></b>\u901a\u8fc7\u8fd1\u671f\u536b\u661f\u56fe\u50cf\u7814\u7a76\u68ee\u6797\u53d8\u5316", "f3d003b9752a5a9e8aee975debcce039": "<b></b>\u4f7f\u7528 MapBuilder \u521b\u5efa\u81ea\u5b9a\u4e49\u5730\u56fe\u5e94\u7528", "00744fa4b0e36399a087b44c2b6d2286": "<b></b>\u5206\u6790", "dc08e8bf66ce053cc2764bb6fb0133b6": "<b></b>\u78b3", "3416d7ed75766f0ce794305b7cb93e42": "<b></b>\u6c14\u5019", "6e3446913434d5638cd8370b90fcaf42": "<b></b>\u81ea\u5b9a\u4e49\u68ee\u6797\u5730\u56fe", "ded889baa6300fa0b440f5704a20a504": "<b></b>\u5e95\u56fe", "1f373ab2e64a46ee70ca868e7930e530": "<b></b>\u4eea\u8868\u677f", "e903590d7d9c6c1897cd9a673a43735c": "<b></b>\u706b\u707e", "7f8ffc3436b4edc60e643b16cc21ede0": "\u4f7f\u7528 Sentinel-1 \u7684\u4e91\u5c42\u7a7f\u900f\u96f7\u8fbe\u4f20\u611f\u5668\u5728\u6f6e\u6e7f\u7684\u539f\u59cb\u70ed\u5e26\u68ee\u6797\u4e2d\u8fd1\u4e4e\u5b9e\u65f6\u5730\u83b7\u53d6\u68ee\u6797\u7834\u574f\u8b66\u62a5", "6b64312dbb5c72e5d5df6282d8935ec6": "10 x 10m\uff0c\u6700\u5c0f\u6620\u50cf\u5355\u4f4d\u4e3a0.1ha", "4ff0844a74746b93f5e48082596b2baa": "\u5357\u7f8e\u6d32\u3001\u6492\u54c8\u62c9\u4ee5\u5357\u975e\u6d32\u548c\u4e1c\u5357\u4e9a\u5c9b\u5c7f\u7684\u6f6e\u6e7f\u7684\u70ed\u5e26\u68ee\u6797", "14df305aa612ce4bcc9e20e4ba6c69e4": "\u6bcf 6-12 \u5929", "fd8a4cfe4a5fb4a60f6325ea350d3455": "\u975e\u6d32\uff1a2019 \u5e74 1 \u6708\u81f3\u4eca<br>\u5176\u4ed6\u5730\u533a\uff1a2020 \u5e74 1 \u6708\u81f3\u4eca", "2d25af47018b01fb9168146675871255": "\u672c\u4ea7\u54c1\u65e0\u6cd5\u533a\u5206\u4eba\u4e3a\u6bc1\u6797\u4e0e\u5176\u4ed6\u68ee\u6797\u7834\u574f", "da9d340b411fa86996e9626bb23117b5": "\u7531\u4e8e\u77ed\u6ce2\u957f C \u6ce2\u6bb5\u96f7\u8fbe\u5bf9\u6c34\u5206\u53d8\u5316\u7684\u9ad8\u5ea6\u654f\u611f\u6027\uff0c\u6cbc\u6cfd\u68ee\u6797\u4e2d\u53ef\u80fd\u4f1a\u53d1\u751f\u9519\u8bef\u68c0\u6d4b", "bc0b3ae3a7b60cd27ab4031f6c844ab7": "\u5c0f\u89c4\u6a21\u53d8\u5316\uff08\u4f8b\u5982\u4f10\u6728\u53d6\u9053\u3001\u5c0f\u89c4\u6a21\u519c\u4e1a\uff09\u901a\u5e38\u4f1a\u88ab\u53ca\u65f6\u68c0\u6d4b\u5230\uff0c\u56e0\u4e3a\u4f7f\u7528\u77ed\u6ce2\u957f C \u6ce2\u6bb5\u96f7\u8fbe\u68c0\u6d4b\u68ee\u6797\u8fb9\u7f18\u76f8\u5bf9\u7b80\u5355\u3002\u5927\u89c4\u6a21\u6591\u5757\uff08\u4f8b\u5982\u79cd\u690d\u56ed\u6269\u5f20\uff09\u53ef\u80fd\u9700\u8981\u66f4\u957f\u7684\u65f6\u95f4\u5c06\u5176\u53d8\u5316\u6807\u8bb0\u4e3a\u8b66\u62a5\u3002\u7531\u4e8e\u6f6e\u6e7f\u7684\u571f\u58e4\u6216\u6b8b\u7559\u7684\u6728\u8d28\u788e\u7247\u7b49\u60c5\u51b5\uff0c\u8fd9\u4e9b\u5927\u6591\u5757\u5728\u96f7\u8fbe\u56fe\u50cf\u4e2d\u53ef\u80fd\u770b\u8d77\u6765\u66f4\u7c7b\u4f3c\u4e8e\u672a\u53d7\u7834\u574f\u7684\u68ee\u6797\u3002", "2c95f7865bce2e46b8edaa6b307a4910": "\u6bcf\u5468\u66f4\u65b0", "0d81155559333a2ad789790283e7fca8": "\u672c\u4ea7\u54c1\u53d7\u5230\u6240\u4f7f\u7528\u7684\u5168\u7403\u68ee\u6797\u57fa\u7ebf\u7684\u9650\u5236\uff0c\u53ef\u80fd\u4f1a\u5b58\u5728\u5730\u533a\u5c42\u9762\u7684\u4e0d\u4e00\u81f4\u6027\u3002\u5728\u57fa\u7ebf\u4e2d\u88ab\u9519\u8bef\u5730\u6807\u8bb0\u4e3a\u539f\u59cb\u6797\u7684\u533a\u57df\u4e2d\uff0c\u8b66\u62a5\u53ef\u80fd\u4f1a\u51fa\u73b0\u9519\u5206\u8bef\u5dee\u3002\u5728 RADD \u8b66\u62a5\u5efa\u7acb\u4e4b\u524d\u53d1\u751f\u68ee\u6797\u6d41\u5931\u4f46\u672a\u88ab\u57fa\u7ebf\u8f93\u5165\u6570\u636e\u8bc6\u522b\uff08\u56e0\u6b64\u672a\u4ece\u68ee\u6797\u57fa\u7ebf\u4e2d\u5220\u9664\uff09\u7684\u5730\u533a\uff0c\u8b66\u62a5\u53ef\u80fd\u5728\u68ee\u6797\u7834\u574f\u53d1\u751f\u540e\u5f88\u957f\u65f6\u95f4\u624d\u88ab\u68c0\u6d4b\u5230\u3002\u8fd9\u53ea\u4f1a\u5f71\u54cd 2019 \u5e74\u521d\uff08\u975e\u6d32\uff09\u548c 2020 \u5e74\u521d\uff08\u5176\u4ed6\u5730\u533a\uff09\u7684\u8b66\u62a5\u3002", "3ae82bd2870c45a3c3a30c27ec3fe91d": "\u5728\u521a\u679c\u76c6\u5730\u5bf9\u5df2\u786e\u8ba4\u8b66\u62a5\u7684\u9a8c\u8bc1\u8868\u660e\uff0c\u5bf9\u4e8e\u5927\u4e8e 0.2 ha \u7684\u68ee\u6797\u7834\u574f\uff0c\u8b66\u62a5\u5177\u6709\u5f88\u9ad8\u7684\u51c6\u786e\u6027\uff082% \u5047\u9633\u6027\u8bef\u62a5\uff0c5% \u5047\u9634\u6027\u8bef\u62a5\uff09\u3002", "b0c556344e68e25c26ed5f471143488a": "RADD\uff08RAdar for Detecting Deforestation\uff09\u662f\u4e00\u4e2a\u68ee\u6797\u9000\u5316\u8b66\u62a5\uff0c\u5b83\u4f7f\u7528\u6765\u81ea\u6b27\u6d32\u822a\u5929\u5c40\u7684 Sentinel-1 \u536b\u661f\u7684\u6570\u636e\u6765\u8fd1\u4e4e\u5b9e\u65f6\u5730\u68c0\u6d4b\u68ee\u6797\u7834\u574f\uff0c\u5e76\u5728\u6570\u5468\u5185\u786e\u8ba4\u8b66\u62a5\u3002RADD\uff08RAdar for Detecting Deforestation\uff09\u8b66\u62a5\u4f7f\u7528\u7531\u74e6\u683c\u5b81\u6839\u5927\u5b66\u4e0e\u7814\u7a76\u4e2d\u5fc3 (WUR)\u4e0e Laboratory of Geo-information Science and Remote Sensing \u5f00\u53d1\u7684\u68c0\u6d4b\u65b9\u6cd5\u3002\u6b64\u7c7b\u8b66\u62a5\u5728\u76d1\u6d4b\u70ed\u5e26\u68ee\u6797\u65b9\u9762\u7279\u522b\u6709\u5229\uff0c\u56e0\u4e3a Sentinel-1 \u7684\u4e91\u5c42\u7a7f\u900f\u96f7\u8fbe\u548c\u66f4\u4e3a\u9891\u7e41\u7684\u56de\u626b\u65f6\u95f4\uff086-12 \u5929\uff09\u4f7f\u5176\u6bd4\u57fa\u4e8e\u5149\u5b66\u536b\u661f\u56fe\u50cf\u7684\u8b66\u62a5\u4ea7\u54c1\u7684\u76d1\u6d4b\u66f4\u5177\u6709\u4e00\u81f4\u6027\u3002\u8b66\u62a5\u9002\u7528\u4e8e\u5357\u7f8e\u6d32\u3001\u6492\u54c8\u62c9\u4ee5\u5357\u975e\u6d32\u548c\u4e1c\u5357\u4e9a\u5c9b\u5c7f\u7684\u539f\u59cb\u6f6e\u6e7f\u70ed\u5e26\u68ee\u6797\u5730\u533a\uff0c\u7a7a\u95f4\u5206\u8fa8\u7387\u4e3a 10m\uff0c\u975e\u6d32\u7684\u8986\u76d6\u65f6\u957f\u4e3a 2019 \u5e74 1 \u6708\u81f3\u4eca\uff0c\u5357\u7f8e\u548c\u4e1c\u5357\u4e9a\u7684\u8986\u76d6\u65f6\u957f\u4e3a 2020 \u5e74 1 \u6708\u81f3\u4eca\u3002", "00310423dab570ba96863d57697b87b3": "\u4ece Google Earth Engine \u6536\u96c6\u9884\u5904\u7406\u7684 Sentinel-1 \u56fe\u50cf\uff0c\u7136\u540e\u4f7f\u7528\u5386\u53f2\u65f6\u95f4\u5e8f\u5217\u7684\u6307\u6807\u8fdb\u884c\u8d28\u91cf\u63a7\u5236\u548c\u6807\u51c6\u5316\u3002\u7136\u540e\u4f7f\u7528\u6982\u7387\u7b97\u6cd5\u68c0\u6d4b\u68ee\u6797\u7834\u574f\u8b66\u62a5\u3002\u6bcf\u4e2a\u7834\u574f\u8b66\u62a5\u4e3a\u6700\u65b0\u56fe\u50cf\u4e2d\u6240\u89c2\u5bdf\u68c0\u6d4b\u5230\u7684\u4e00\u6b21\u68ee\u6797\u7834\u574f\uff1b\u5982\u679c\u68ee\u6797\u7834\u574f\u6982\u7387\u9ad8\u4e8e 97.5%\uff0c\u5219\u672c\u8b66\u62a5\u4f1a\u5728\u6700\u957f 90 \u5929\u7684\u65f6\u95f4\u5185\u5c06\u540e\u7eed\u56fe\u50cf\u6807\u8bb0\u4e3a\u9ad8\u7f6e\u4fe1\u5ea6\u3002\u68ee\u6797\u7834\u574f\u6982\u7387\u8d85\u8fc7 85% \u65f6\u4f1a\u53d1\u51fa\u672a\u7ecf\u786e\u8ba4\u7684\u8b66\u62a5\u3002\u8be5\u4ea7\u54c1\u7684\u6700\u5c0f\u6620\u50cf\u5355\u5143\u4e3a 0.1 ha\uff08\u5373\u4e3a 10 \u4e2a Sentinel-1 \u50cf\u7d20\uff09\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u9519\u8bef\u68c0\u6d4b\u3002\u8b66\u62a5\u68c0\u6d4b\u8303\u56f4\u4e3a\u7531<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Turubanova et al. (2018)</a> \u6807\u8bb0\u7684\u539f\u59cb\u6f6e\u6e7f\u70ed\u5e26\u68ee\u6797\u5730\u533a\uff0c\u5e76\u5220\u9664\u4e862001-2018 \u68ee\u6797\u6d41\u5931 (<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. 2013</a>) \u53ca\u7ea2\u6811\u6797  (<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Bunting et al. 2018</a>)\u3002\u6709\u5173\u65b9\u6cd5\u548c\u9a8c\u8bc1\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605 <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Reiche et. al. (2021)</a>\u3002\u6b64\u5904\u4ecb\u7ecd\u7684\u7248\u672c (v1) \u4e3a\u8bba\u6587 (v0) \u4e2d\u63cf\u8ff0\u7684\u7248\u672c\u7684\u66f4\u65b0\u7248\uff0c\u66f4\u6539\u4e86\u68ee\u6797\u63a9\u7801\u5e76\u51cf\u5c11\u4e86\u6700\u5c0f\u6620\u50cf\u5355\u5143\u3002", "15d770f41ea6d822220aeec3be17aa54": "\u5f97\u76ca\u4e8e<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">ten major palm oil producers and buyers</a>\u8054\u76df\u7684\u652f\u6301\uff0c RADD \u8b66\u62a5\u5f97\u4ee5\u53d1\u5e03\u3002\u5728\u672c\u9879\u76ee\u4e2d\uff0c\u74e6\u683c\u5b81\u6839\u5927\u5b66\u4e0e\u7814\u7a76\u4e2d\u5fc3 (WUR) \u5f00\u53d1\u4e86\u68c0\u6d4b\u65b9\u6cd5\uff0cSatelligence \u9996\u5148\u5728\u5370\u5ea6\u5c3c\u897f\u4e9a\u548c\u9a6c\u6765\u897f\u4e9a\u843d\u5730\u4e86\u672c\u7cfb\u7edf\uff0c\u5e76\u5927\u529b\u652f\u6301\u73b0\u573a\u8b66\u62a5\u8ddf\u8fdb\u3002\u7f8e\u56fd\u6797\u52a1\u5c40\u548c\u632a\u5a01\u7684\u56fd\u9645\u6c14\u5019\u4e0e\u68ee\u6797\u5021\u8bae\uff08International Climate and Forest Initiative\uff09\u63d0\u4f9b\u4e86\u989d\u5916\u7684\u652f\u6301\u3002\u8fd9\u4e9b\u8b66\u62a5\u76ee\u524d\u7531 WUR \u4f7f\u7528 Google Earth Engine \u64cd\u4f5c\u3002", "fbba60e24944f1b795cf842350eb20a3": "(\u6bcf 6 \u81f3 12 \u5929\uff0c10m\uff0c\u9009\u62e9\u56fd\u5bb6\u6216\u5730\u533a\uff0cWUR)", "374834aa7dd7a2b2790fcd23fa96014a": "\u68ee\u6797\u780d\u4f10\u8b66\u62a5 (RADD)", "8fa05ef4b0144bef634f29802e2905b3": "(\u6bcf\u5468\uff0c30m\uff0c\u70ed\u5e26\uff0cUMD/GLAD)", "7b94978c847f684372098ffb5b83408e": "\u8fd1\u5b9e\u65f6\u8bc6\u522b\u53ef\u80fd\u53d1\u751f\u7684\u68ee\u6797\u8986\u76d6\u51cf\u5c11", "974cc4676ffd10d905ebed0cedb65956": "\u5317\u7eac30\u5ea6\u81f3\u5357\u7eac30\u5ea6", "6a6c6131388e92bd4ee7e5e67ca57b8f": "2018 \u5e74 1 \u6708 1 \u65e5\u2014\u2014\u81f3\u4eca\uff08\u4e9a\u9a6c\u900a\u3001\u521a\u679c\u76c6\u5730\u548c\u4e0e\u4e16\u9694\u7edd\u7684\u4e1c\u5357\u4e9a\u90e8\u5206\u56fd\u5bb6\u4ece 2015 \u5e74\u5f00\u59cb\uff09", "16c3a4b886b0d86bbca343a96f002298": "\u9646\u5730\u536b\u661f7\u53f7\u548c8\u53f7\u4e00\u9f50\u67098\u5929\u7684\u91cd\u8bbf\u671f\uff0c\u4f46\u4e91\u5c42\u53ef\u80fd\u6781\u5927\u5730\u9650\u5236\u56fe\u50cf\u7684\u53ef\u7528\u6027\uff0c\u7279\u522b\u5728\u96e8\u5b63\u65f6\u3002\u7531\u4e8e\u6301\u7eed\u5b58\u5728\u7684\u4e91\u5c42\uff0c\u68ee\u6797\u8986\u76d6\u635f\u5931\u53ef\u80fd\u53d1\u751f\u5728\u65e9\u4e9b\u65f6\u5019\uff08\u53ef\u80fd\u51e0\u4e2a\u661f\u671f\u4e4b\u524d\uff09\uff0c\u4f46\u9884\u8b66\u65e5\u671f\u4ecd\u8868\u793a\u63a2\u6d4b\u7684\u5b9e\u4f8b\u3002", "12502f5c72dbc381473dd9ca7e81019f": "\u5728\u8be5\u6570\u636e\u96c6\u4e2d\uff0c\u201c\u68ee\u6797\u8986\u76d6\u201d\u5b9a\u4e49\u4e3a\u6240\u6709\u9ad8\u5ea6\u8d85\u8fc7 5 \u7c73\u3001\u6797\u51a0\u76d6\u5ea6\u8d85\u8fc7 60% \u7684\u690d\u88ab\uff0c\u5176\u5f62\u5f0f\u65e2\u53ef\u4ee5\u662f\u5929\u7136\u6797\u4e5f\u53ef\u4ee5\u662f\u4eba\u5de5\u6797\u3002\u201c\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u201d\u8868\u793a\u4e00\u534a\u4ee5\u4e0a\u50cf\u7d20\u7684\u6797\u51a0\u5df2\u6d88\u5931\uff0c\u53ef\u80fd\u7531\u591a\u79cd\u56e0\u7d20\u9020\u6210\uff0c\u5305\u62ec\u673a\u68b0\u91c7\u4f10\u3001\u706b\u707e\u3001\u75be\u75c5\u6216\u8005\u98ce\u66b4\u707e\u5bb3\u3002\u8fd9\u6837\u770b\u6765\uff0c\u201c\u51cf\u5c11\u201d\u4e0d\u7b49\u540c\u6ee5\u4f10\u3002", "63d138ecf2823bb8f3790c29de12ca09": "\u4e9a\u9a6c\u900a\u76c6\u5730", "be9b698f608fa360290a378e6dc95277": "\u5728\u672c\u8b66\u62a5\u7cfb\u7edf\u9996\u6b21\u5e94\u7528\u7684\u79d8\u9c81\uff0c\u5f00\u53d1\u8005\u8bc4\u4f30\u5176\u6570\u636e\u5b58\u5728 13.5% \u7684\u5047\u9633\u6027\u8bef\u62a5\uff08\u8bef\u5c06\u5176\u4ed6\u60c5\u51b5\u68c0\u6d4b\u4e3a\u68ee\u6797\u6d41\u5931\uff09\uff0c\u4f46\u5927\u591a\u6570\u6b64\u7c7b\u8bef\u62a5\uff089.5%\uff09\u53d1\u751f\u5728\u7a7a\u65f7\u5730\u5e26\u7684\u8fb9\u7f18\u3002\u5728\u8fd9\u4e9b\u8fb9\u7f18\u5730\u5e26\uff0c30 \u7c73\u7cbe\u5ea6\u7684 Landsat \u50cf\u7d20\u663e\u793a\u68ee\u6797\u548c\u5176\u4ed6\u571f\u5730\u8986\u76d6\u7c7b\u578b\u76f8\u6df7\u5408\uff0c\u8fd9\u4f7f\u5f97\u5b83\u4eec\u5728\u7cfb\u7edf\u4e2d\u5bb9\u6613\u51fa\u9519\u3002\u4ec5\u8003\u8651\u9ad8\u7f6e\u4fe1\u5ea6\u8b66\u62a5\u65f6\uff0c\u5047\u9633\u6027\u8bef\u62a5\u7387\u964d\u81f3 1%\u3002 \u6570\u636e\u6709 33% \u7684\u5047\u9634\u6027\u8bef\u62a5\uff08\u672a\u68c0\u6d4b\u5230\u5df2\u53d1\u751f\u7684\u68ee\u6797\u6d41\u5931\uff09\uff0c\u4f46\u5176\u4e2d\u5927\u90e8\u5206\u53d1\u751f\u5728\u6b21\u751f\u6797\u4e2d\u2014\u2014\u539f\u56e0\u53ef\u80fd\u662f\u56e0\u4e3a\u8be5\u7b97\u6cd5\u7684\u76ee\u7684\u662f\u4e3a\u4e86\u6355\u6349\u539f\u59cb\u68ee\u6797\u6d41\u5931\u3002\u4e0e\u5047\u9633\u6027\u8bef\u62a5\u76f8\u6bd4\uff0c\u66f4\u9ad8\u7684\u5047\u9634\u6027\u8bef\u62a5\u7387\u4e5f\u8868\u660e\u672c\u8b66\u62a5\u662f\u5bf9\u5b9e\u9645\u53d1\u751f\u7684\u6811\u6728\u8986\u76d6\u6d41\u5931\u7684\u66f4\u4fdd\u5b88\u7684\u4f30\u8ba1\u3002", "7bf99b9626e74745d2a6fcb10a23e744": "\u6b64\u6570\u636e\u96c6\u7531\u9a6c\u91cc\u5170\u5927\u5b66<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">GLAD</a> (Global Land Analysis &amp; Discovery) \u5b9e\u9a8c\u5ba4\u521b\u5efa\uff0c\u7531 Global Forest Watch \u63d0\u4f9b\u652f\u6301\uff0c\u662f\u7b2c\u4e00\u4e2a\u57fa\u4e8e\u9646\u5730\u536b\u661f\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u9884\u8b66\u7cfb\u7edf\u3002\u867d\u7136\u5927\u591a\u6570\u73b0\u6709\u7684\u635f\u5931\u8b66\u62a5\u4ea7\u54c1\u4f7f\u7528 250 \u7c73\u5206\u8fa8\u7387\u7684 MODIS \u56fe\u50cf\uff0c\u800c\u8fd9\u4e9b\u8b66\u62a5\u5177\u6709 30 \u7c73\u5206\u8fa8\u7387\uff0c\u56e0\u6b64\u53ef\u4ee5\u5728\u66f4\u7cbe\u7ec6\u7684\u7a7a\u95f4\u5c3a\u5ea6\u4e0a\u68c0\u6d4b\u635f\u5931\u3002\u8b66\u62a5\u9002\u7528\u4e8e\u5317\u90e8\u548c\u5357\u90e8 30 \u5ea6\u4e4b\u95f4\u7684\u5730\u533a.", "02bf1d083ee2172b77776f7c453e2216": "\u4e0b\u8f7d\u7684\u65b0Landsat 7\u548c8\u56fe\u50cf\u5c06\u4f1a\u548c\u7f51\u4e0a\u516c\u5e03\u7684\u4e00\u6837\uff0c\u8bc4\u4f30\u4e86\u4e91\u5c42\u8986\u76d6\u6216\u8f83\u5dee\u7684\u6570\u636e\u8d28\u91cf\uff0c\u5e76\u4e0eLandsat\u5f97\u51fa\u7684\u524d\u4e09\u5e74\u6307\u6807\u8fdb\u884c\u6bd4\u8f83\uff08\u5305\u62ec\u6392\u540d\uff0c\u624b\u6bb5\uff0c\u7ea2\u8272\u3001\u7ea2\u5916\u548c\u77ed\u6ce2\u6ce2\u6bb5\u7684\u9000\u5316 \uff0c\u4ee5\u53caNDVI\uff0cNBR\u548cNDWI\u7684\u6392\u540d\uff09\u3002\u5ea6\u91cf\u6807\u51c6\u548c\u6700\u65b0\u7684Landsat\u56fe\u50cf\u901a\u8fc7\u4e03\u4e2a\u51b3\u7b56\u6811\u8fd0\u884c\uff0c\u4ee5\u8ba1\u7b97\u68ee\u6797\u6270\u52a8\u7684\u4e2d\u4f4d\u6570\u6982\u7387\u3002\u6982\u7387\u4e3a&gt;50\uff05\u7684\u50cf\u7d20\u88ab\u62a5\u544a\u4e3a\u6811\u6728\u8986\u76d6\u7387\u51cf\u5c11\u8b66\u62a5\u3002\u6574\u4e2a\u8fc7\u7a0b\u90fd\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Google Earth Engine</a>\u4e2d\u8fd0\u884c\uff0c\u4ee5\u786e\u4fdd\u53ef\u9760\u7684\u66f4\u65b0\u548c\u53ef\u91cf\u6d4b\u6027\u3002\u6709\u5173\u65b9\u6cd5\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u89c1<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u300a\u73af\u5883\u7814\u7a76\u5feb\u62a5\u300b\u4e2d\u7684\u8bba\u6587</a>\u3002", "bf232e36409ecf78d9ede8c6eee57085": "\u53ea\u6709\u5f53\u56db\u6b21\u8fde\u7eed\u89c2\u5bdf\u4e2d\u7684\u81f3\u5c11\u4e24\u6b21\u88ab\u6807\u8bb0\u4e3a\u68ee\u6797\u6d41\u5931\u65f6\uff0c\u8b66\u62a5\u624d\u4f1a\u88ab\u5f52\u7c7b\u4e3a\u9ad8\u7f6e\u4fe1\u5ea6\u3002\u5982\u679c\u8b66\u62a5\u672a\u88ab\u5f52\u7c7b\u4e3a\u9ad8\u7f6e\u4fe1\u5ea6\uff0c\u5219\u4f1a\u5728\u8fde\u7eed\u56db\u6b21\u89c2\u5bdf\u6216\u8d85\u8fc7 180 \u5929\u540e\u88ab\u4ece\u6570\u636e\u96c6\u4e2d\u5220\u9664\u3002\u60a8\u53ef\u4ee5\u9009\u62e9\u5728\u83dc\u5355\u4e2d\u4ec5\u67e5\u770b\u9ad8\u7f6e\u4fe1\u5ea6\u8b66\u62a5\u533a\u57df\uff0c\u4f46\u8bf7\u6ce8\u610f\uff0c\u8fd9\u5c06\u8fc7\u6ee4\u6389\u6700\u8fd1\u68c0\u6d4b\u5230\u7684\u68ee\u6797\u6d41\u5931\u3002", "da115536ae521fec4b7a0d19933ecf87": "\u5f53\u6570\u636e\u663e\u793a\u65f6\u4f7f\u7528\u4e0b\u5217\u7248\u6743\u4fe1\u606f\uff1a", "0c171c2f6395ad751539de8254033393": "\u6765\u6e90\uff1aGLAD/UMD\uff0c\u901a\u8fc7\u5168\u7403\u68ee\u6797\u89c2\u6d4b\u83b7\u53d6", "1e1a4cdf10f521ae62185b3b69e4c828": "\u5f15\u7528\u8fd9\u4e9b\u6570\u636e\u65f6\uff0c\u5e94\u63d0\u53ca\u4e0b\u9762\u7684\u6765\u6e90\uff1a", "8dfc6869d5f30851ca0ec8fed749ad30": "\u68ee\u6797\u780d\u4f10\u8b66\u62a5\uff08GLAD-S2\uff09", "707e74aae1c516fd57bf20b4a12bd1ed": "\u6bcf\u65e5\u66f4\u65b0\uff0c\u56de\u626b\u65f6\u95f4\u4e3a 5 \u65e5", "e2b810d7512c03d867b62be4929c2cf0": "2019 \u5e74 1 \u6708 1 \u65e5 - \u81f3\u4eca", "dca27fa0e87ce273faa0de31a6c3625e": "\u56fe\u50cf\u4ec5\u63d0\u53d6\u4f4d\u4e8e<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Turubanova et al (2018)</a>\u6240\u5236\u7684\u4e9a\u9a6c\u900a\u6cb3\u6d41\u57df\u7684\u539f\u59cb\u68ee\u6797\u63a9\u819c\u5185\u7684\u4fe1\u606f\uff0c\u5176\u4e2d\u7531 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a> \u6240\u786e\u5b9a\u7684 2001-2018 \u5e74\u68ee\u6797\u6d41\u5931\u533a\u57df\u5df2\u88ab\u5220\u9664\u3002", "a6328e6b24a2e7717e91f7ec2eaedd52": "\u5728\u56db\u4e2a\u8fde\u7eed\u56fe\u50cf\u4e2d\u68c0\u6d4b\u5230\u4e24\u4e2a\u8b66\u62a5\u7684\u60c5\u51b5\u88ab\u5f52\u7c7b\u4e3a\u9ad8\u7f6e\u4fe1\u5ea6\u3002\u5df2\u88ab\u68c0\u6d4b\u4e3a\u542b\u9ad8\u7f6e\u4fe1\u5ea6\u8b66\u62a5\u7684\u50cf\u7d20\u683c\u65e0\u6cd5\u518d\u6b21\u53d1\u51fa\u8b66\u62a5\u3002", "92aebd1e2971f0a088529383f736efc9": "\u672c\u4ea7\u54c1\u7684\u51c6\u786e\u6027\u5c1a\u672a\u8bc4\u4f30", "7c7be98e2d43e6f40a25e9c60adbecea": "\u672c\u6570\u636e\u96c6\u662f\u7531\u9a6c\u91cc\u5170\u5927\u5b66\u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">GLAD</a>\uff08\u5168\u7403\u571f\u5730\u5206\u6790\u548c\u53d1\u73b0\u7814\u7a76\uff09\u5b9e\u9a8c\u5ba4\u5f00\u53d1\u7684\u68ee\u6797\u6d41\u5931\u8b66\u62a5\u4ea7\u54c1\u3002GLAD-S2 \u8b66\u62a5\u5229\u7528\u6765\u81ea\u6b27\u6d32\u822a\u5929\u5c40 Sentinel-2 \u536b\u661f\u4efb\u52a1\u7684\u6570\u636e - \u56de\u626b\u65f6\u95f4\u4e3a 5 \u65e5\u3001 10m \u7a7a\u95f4\u5206\u8fa8\u7387\u7684\u5149\u5b66\u56fe\u50cf\u3002\u4e0e GLAD Landsat \u8b66\u62a5\u76f8\u6bd4\uff0c\u66f4\u77ed\u7684\u56de\u626b\u65f6\u95f4\u4f7f\u68ee\u6797\u6d41\u5931\u7684\u68c0\u6d4b\u66f4\u4e3a\u5373\u65f6\uff0c\u5e76\u7f29\u77ed\u4e86\u83b7\u53d6\u68c0\u6d4b\u68ee\u6797\u6d41\u5931\u7684\u521d\u59cb\u6570\u636e\u548c\u5c06\u5176\u5206\u7c7b\u4e3a\u9ad8\u7f6e\u4fe1\u5ea6\u7684\u68c0\u6d4b\u7ed3\u679c\u4e4b\u95f4\u7684\u65f6\u95f4\u3002\u8fd9\u5bf9\u6f6e\u6e7f\u548c\u70ed\u5e26\u5730\u533a\u7684\u68c0\u6d4b\u5c24\u5176\u6709\u5229\uff0c\u56e0\u4e3a\u5176\u6301\u7eed\u7684\u4e91\u5c42\u8986\u76d6\u53ef\u80fd\u4f1a\u5ef6\u8fdf\u6570\u5468\u5230\u6570\u6708\u7684\u68c0\u6d4b\u3002\u4ece 2019 \u5e74 1 \u6708 1 \u65e5\u81f3\u4eca\uff0c GLAD-S2 \u8b66\u62a5\u5df2\u8986\u76d6\u4e9a\u9a6c\u900a\u6d41\u57df\u7684\u539f\u59cb\u68ee\u6797\uff0c\u6570\u636e\u6bcf\u65e5\u66f4\u65b0\u3002", "225b085682f061619adb2d25462ddf16": "\u5728\u83b7\u53d6\u65b0\u7684 Sentinel-2 \u56fe\u50cf\u540e\u5c06\u7acb\u5373\u5bf9\u5176\u8fdb\u884c\u5206\u6790\u3002\u65b0\u56fe\u50cf\u5c06\u7b5b\u9009\u6389\u4e91\u3001\u9634\u5f71\u548c\u6c34\uff0c\u5e76\u5c06\u68ee\u6797\u6d41\u5931\u7b97\u6cd5\u5e94\u7528\u4e8e\u6240\u6709\u5269\u4f59\u7684\u51c0\u571f\u5730\u89c2\u6d4b\u4e2d\u3002\u8be5\u7b97\u6cd5\u4f9d\u6258\u4e8e\u6bcf\u4e2a\u65b0\u56fe\u50cf\u4e2d\u7684\u5149\u8c31\u6570\u636e\u4ee5\u53ca\u57fa\u4e8e\u524d\u4e24\u5e74\u57fa\u7ebf\u671f\u7684\u5149\u8c31\u6307\u6807\u3002", "ea2abf1e0ce00e1c36946088ae3b76e9": "\u5f53\u540e\u7eed\u56db\u6b21\u89c2\u5bdf\u4e2d\u7684\u81f3\u5c11\u4e24\u6b21\u88ab\u6807\u8bb0\u4e3a\u68ee\u6797\u6d41\u5931\u65f6\uff0c\u8b66\u62a5\u53d8\u4e3a\u9ad8\u7f6e\u4fe1\u5ea6\uff08\u8fd9\u5bf9\u5e94\u4e8e\u4e0b\u9762\u8fde\u63a5\u4e2d\u7684 GLAD \u5e94\u7528\u7a0b\u5e8f\u4e0a\u7684\u201c\u9ad8\u201d\u3001\u201c\u4e2d\u201d\u548c\u201c\u4f4e\u201d\u6d41\u5931\u7f6e\u4fe1\u5ea6\uff09\u3002\u8b66\u62a5\u65e5\u671f\u8868\u793a\u68ee\u6797\u6d41\u5931\u68c0\u6d4b\u7684\u65e5\u671f\u3002\u7528\u6237\u53ef\u4ee5\u9009\u62e9\u4ec5\u5728\u5730\u56fe\u4e0a\u663e\u793a\u9ad8\u7f6e\u4fe1\u5ea6\u8b66\u62a5\u533a\u57df\uff0c\u4f46\u8bf7\u6ce8\u610f\uff0c\u8fd9\u5c06\u8fc7\u6ee4\u6389\u6700\u8fd1\u68c0\u6d4b\u5230\u7684\u68ee\u6797\u6d41\u5931\u3002\u6b64\u5916\uff0c\u5728\u5df2\u88ab\u6807\u8bb0\u4e3a\u9ad8\u7f6e\u4fe1\u5ea6\u8b66\u62a5\u7684\u50cf\u7d20\u4e0a\u4e0d\u4f1a\u518d\u6b21\u663e\u793a\u68c0\u6d4b\u5230\u68ee\u6797\u6d41\u5931\u3002\u5728 180 \u5929\u5185\u672a\u53d8\u4e3a\u9ad8\u7f6e\u4fe1\u5ea6\u7684\u8b66\u62a5\u5c06\u4ece\u6570\u636e\u96c6\u4e2d\u5220\u9664\u3002", "8808477b3bf2a4a003d7b0ebb2d07627": "\u4f7f\u7528 Sentinel-2 \u56fe\u50cf\u67e5\u8be2\u63a5\u8fd1\u5b9e\u65f6\u7684\u539f\u59cb\u68ee\u6797\u6d41\u5931\u7684\u533a\u57df", "1a3e962df9ea7f33e0cc9e08920d5fa6": "(\u6bcf 5 \u5929\uff0c10m\uff0c\u4e9a\u9a6c\u900a\u76c6\u5730\uff0cUMD/GLAD)", "38de78dd8e41ee1476fff8b138aa786a": "\u76d1\u6d4b\u68ee\u6797\u6270\u52a8\u8b66\u62a5\uff0c\u6574\u5408\u4e86\u6765\u81ea\u4e09\u4e2a\u536b\u661f\u6e90\u8fd1\u4e4e\u5b9e\u65f6\u7684\u6570\u636e", "2c9d9a2f95bec33466f30c1a9f572c7c": "\u4f7f\u7528 Landsat \u56fe\u50cf\uff0c\u8fd1\u4e4e\u5b9e\u65f6\u5730\u8bc6\u522b\u6f5c\u5728\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u533a\u57df", "2493efabba6bea4d7d5652688a6f8f14": "GLAD-S2 \u7684\u5730\u7406\u8986\u76d6\u8303\u56f4", "c9e80a0b7c1f8781a620984a4dca52ec": "\u663e\u793a\u6b64\u6570\u636e\u65f6\u8bf7\u6ce8\u660e\u4ee5\u4e0b\u51fa\u5904\uff1a<br>\u6765\u6e90\uff1aGLAD/UMD\uff0c\u4e8e 2022 \u5e74 11 \u6708 16 \u65e5\u901a\u8fc7 Global Forest Watch \u83b7\u53d6", "f3cb9b64abfd8a971fbb0a145500dcdf": "\u5f15\u7528\u6b64\u6570\u636e\u65f6\u8bf7\u6ce8\u660e\u4ee5\u4e0b\u51fa\u5904\uff1a<br>Pickens, A.H.\u3001Hansen, M.C.\u3001Adusei, B. \u548c Potapov P. 2020\u3002Sentinel-2 Forest Loss Alert\u3002Global Land Analysis and Discovery (GLAD)\uff0c\u9a6c\u91cc\u5170\u5927\u5b66\u3002\u4e8e [date] \u901a\u8fc7 Global Forest Watch \u83b7\u53d6\u3002 www.globalforestwatch.org", "db3674c1da77d926a40a722a8992e9ca": "RADD\uff1a\u5f53\u8b66\u62a5\u4e8e 90 \u5929\u5185\u5728\u591a\u5f20\u56fe\u50cf\u4e2d\u8fbe\u5230 97.5% \u7684\u6982\u7387\u9608\u503c\u65f6\uff0c\u8b66\u62a5\u88ab\u6807\u8bb0\u4e3a\u9ad8\u7f6e\u4fe1\u5ea6\u8b66\u62a5\u3002", "35bdd5265d284b1f2d3942e1435afaa6": "RADD \u8b66\u62a5\u56fe\u5c42\u7684\u5730\u7406\u8986\u76d6\u8303\u56f4\u3002", "2930bf0f6f5416029b50dcbb8c9f237d": "GLAD-S2\uff1a\u5f53\u56db\u5f20\u8fde\u7eed\u65e0\u4e91\u56fe\u50cf\u4e2d\u81f3\u5c11\u6709\u4e24\u5f20\u8bc6\u522b\u51fa\u68ee\u6797\u635f\u5931\u65f6\uff0c\u8b66\u62a5\u88ab\u5f52\u7c7b\u4e3a\u9ad8\u7f6e\u4fe1\u5ea6\u8b66\u62a5\u3002", "3b260e44b533dadcc2614b19459e9ab7": "GLAD-L \u7684\u5730\u7406\u8986\u76d6\u8303\u56f4", "246a16b2b8f5405ef7b5e2fb19a89d7f": "GLAD-L\uff1a\u5f53\u4e94\u5f20\u8fde\u7eed\u65e0\u4e91\u56fe\u50cf\u4e2d\u81f3\u5c11\u6709\u4e24\u5f20\u8bc6\u522b\u51fa\u68ee\u6797\u635f\u5931\u65f6\uff0c\u8b66\u62a5\u88ab\u5f52\u7c7b\u4e3a\u9ad8\u7f6e\u4fe1\u5ea6\u8b66\u62a5\u3002\u8fd1\u671f\u8b66\u62a5\u4e3a\u9ad8\u53ef\u4fe1\u5ea6\u8b66\u62a5\u7684\u6bd4\u4f8b\u8f83\u5c0f\uff0c\u56e0\u4e3a\u4ea7\u751f\u53e6\u4e00\u5f20\u65e0\u4e91\u56fe\u50cf\u53ef\u80fd\u9700\u8981\u6570\u5468\u6216\u6570\u6708\u7684\u65f6\u95f4\u3002", "62b9d3195580b1763ff28cb416c59383": "\u5168\u7403\u6811\u6728\u8986\u76d6\u7387\uff08\u6309\u7c7b\u578b\u5212\u5206\uff09", "efda31345331ec1407c70cb4a3388a60": "{location}\u6811\u6728\u8986\u76d6\u7387\uff08\u6309\u7c7b\u578b\u5206\u7c7b\uff09", "2e6d85329b35bb08542df2075cff2076": "\u4ece 2000 \u5e74\u5230 2020 \u5e74\uff0c{location} \u7684\u6811\u6728\u8986\u76d6\u7387\u53d1\u751f\u4e86 {netChange} ({netChangePerc}) \u7684\u51c0\u53d8\u5316\u3002", "96ebd2bde492267ceaf5b922f2b54598": "\u6c14\u5019", "f2dba425213eb60f91a86fd4bad69503": "\u68ee\u6797\u4f4d\u7f6e", "a0bcfb57421567af1aaafa0df86cca07": "\u5982\u679c\u60a8\u6709\u5174\u8da3\u5b66\u4e60\u5982\u4f55\u4f7f\u7528 GFW Pro\uff0c\u8bf7\u89c2\u770b\u4e0b\u9762\u7684\u5206\u6b65\u8bb2\u89e3\u89c6\u9891\u3002 \u5982\u6709\u5176\u4ed6\u95ee\u9898\uff0c\u8bf7\u8054\u7cfb <a href=\"{{0}}\" rel=\"noreferrer noopener\" target=\"_blank\">GFWPROsupport@wri.org</a>", "b75bf5bcc2400f308478a2ca82a239f8": "\u6309\u767e\u5206\u6bd4\u663e\u793a{selector}\u6811\u6728\u8986\u76d6\u7387\u7684\u51c0\u53d8\u5316", "fb748291b1e964d6a54aa7db36963156": "\u5f53\u524d\u8d60\u6b3e\u5468\u671f\u7684\u7533\u8bf7\u73b0\u5df2\u7ed3\u675f\u3002", "391396a75c94b5887eaf926c91027502": "\u70b9\u51fb<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"{{0}}\">\u6b64\u5904</a>\u4e86\u89e3\u5176\u4ed6\u4eba\u5982\u4f55\u5728\u4ed6\u4eec\u7684\u7f51\u7edc\u4e2d\u4f7f\u7528 Global Forest Watch\u3002", "70ca0242ee55a3a06ace3740a4068328": "\u4eba\u4eec\u5982\u4f55\u4f7f\u7528 GLOBAL FOREST WATCH\uff1f", "2827a551fbbbd91ec3f21e161f9ba576": "\u5728\u6b64\u6570\u636e\u96c6\u4e2d\uff0c\u201c\u6811\u6728\u8986\u76d6\u201d\u7684\u5b9a\u4e49\u662f\u9ad8\u5ea6\u4e3a 5 m \u53ca\u4ee5\u4e0a\u7684\u6797\u6728\u690d\u88ab\uff0c\u5404\u79cd\u6797\u51a0\u5bc6\u5ea6\u7684\u5929\u7136\u6797\u5730\u3001\u68ee\u6797\u6216\u4eba\u5de5\u6797\u5747\u662f\u5176\u53ef\u80fd\u5b58\u5728\u7684\u5f62\u6001\u3002\u6811\u6728\u8986\u76d6\u589e\u52a0\u5e76\u4e0d\u76f4\u63a5\u7b49\u540c\u4e8e\u6062\u590d\u3001\u9020\u6797\u6216\u518d\u9020\u6797\u3002&nbsp;", "32ea2b1c6d947e667ecefa1d648fdda8": "\u7531\u4e8e\u7814\u7a76\u65b9\u6cd5\u548c\u5185\u5bb9\u65e5\u671f\u7684\u5dee\u5f02\uff0c\u6811\u6728\u8986\u76d6\u3001\u589e\u52a0\u548c\u5e74\u635f\u5931\u6570\u636e\u96c6\u4e4b\u95f4\u65e0\u6cd5\u505a\u5230\u51c6\u786e\u5bf9\u7167\u3002\u56e0\u6b64\uff0c\u4e0d\u80fd\u901a\u8fc7\u4ece\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u96c6\u4e2d\u51cf\u53bb\u6811\u6728\u8986\u76d6\u589e\u52a0\u7684\u6570\u503c\u6765\u8ba1\u7b97\u201c\u51c0\u503c\u201d\uff0c\u800c\u662f\u5e94\u5f53\u4f7f\u7528\u51c0\u6811\u6728\u8986\u76d6\u53d8\u5316\u56fe\u5c42\uff0c\u8be5\u56fe\u5c42\u5b8c\u5168\u662f\u6839\u636e\u6811\u9ad8\u6570\u636e\u8ba1\u7b97\u5f97\u51fa\u7684\u3002&nbsp;&nbsp;", "4f24e6ae03fc820c4d7a2f791ebeddc3": "\u7efc\u5408\u5229\u7528\u5176\u4ed6\u4ea7\u54c1\uff08\u4f8b\u5982 GFW \u4e0a\u63d0\u4f9b\u7684\u6797\u51a0\u8986\u76d6\u5bc6\u5ea6\u6570\u636e\uff09\u65f6\u5e94\u5ba1\u614e\u5904\u7406\u3002&nbsp;", "60f2986b77bb313682c99b009fdab78a": "\u4f5c\u8005\u8bc4\u4f30\u4e86\u4ea7\u54c1\u7684\u51c6\u786e\u7387\uff0c\u53d1\u73b0\u603b\u4f53\u51c6\u786e\u7387\u4e3a 99.3%\uff0c\u9519\u5206\u8bef\u5dee\uff08\u8bef\u62a5\uff09\u4e3a 28.6%\uff0c\u6f0f\u5206\u8bef\u5dee\uff08\u6f0f\u62a5\uff09\u4e3a 42.2%\u3002\u51c6\u786e\u7387\u4f1a\u56e0\u751f\u7269\u7fa4\u843d\u800c\u5f02\uff0c\u56e0\u6b64\u5728\u4efb\u4f55\u7279\u5b9a\u5730\u70b9\u90fd\u53ef\u80fd\u66f4\u9ad8\u6216\u66f4\u4f4e\u3002\u7531\u4e8e\u6f0f\u5206\u8bef\u5dee\u9ad8\u4e8e\u9519\u5206\u8bef\u5dee\uff0c\u8fd9\u8868\u660e\u4ea7\u54c1\u63d0\u4f9b\u4e86\u5bf9\u68ee\u6797\u52a8\u6001\u7684\u4fdd\u5b88\u4f30\u8ba1\u3002&nbsp;&nbsp;", "73e0934df832d912d6840da7759184dc": "\u76ee\u524d\u63d0\u4f9b\u4e86\u5580\u9ea6\u9686\u3001\u67ec\u57d4\u5be8\u3001\u52a0\u62ff\u5927\u3001\u54e5\u4f26\u6bd4\u4e9a\u3001\u521a\u679c\u5171\u548c\u56fd\u3001\u52a0\u84ec\u3001\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u3001\u79d8\u9c81\u3001\u5df4\u897f\u548c\u58a8\u897f\u54e5\u7684\u6570\u636e", "2435bf6db0bb7c0ca0f771e727fe1f02": "\u4f7f\u7528 2016 \u5e74\u5168\u7403\u5168\u8986\u76d6 Landsat \u56fe\u50cf\u5408\u6210\u548c\u5168\u7403\u68ee\u6797\u8986\u76d6\u635f\u5931\u6570\u636e\u96c6\uff0c\u786e\u5b9a\u4e86 2000 \u5e74\u5b8c\u6574\u68ee\u6797\u666f\u89c2 (IFL) \u8fb9\u754c\u5185\u5b8c\u6574\u68ee\u6797\u666f\u89c2\u8303\u56f4\u7684\u53d8\u5316 (Hansen et al., 2016)\u3002\u786e\u5b9a\u4e3a\u201c\u8303\u56f4\u7f29\u5c0f\u201d\u7684\u533a\u57df\u5728 2000 \u5e74\u7b26\u5408\u5b8c\u6574\u68ee\u6797\u666f\u89c2\u6807\u51c6\uff0c\u4f46\u5728 2020 \u5e74\u4e0d\u518d\u7b26\u5408\u6807\u51c6\u3002\u9020\u6210\u53d8\u5316\u7684\u4e3b\u8981\u539f\u56e0\u662f\u519c\u4e1a\u548c\u6811\u6728\u79cd\u690d\u56ed\u7684\u6e05\u7406\u3001\u4f10\u6728\u548c\u91c7\u77ff\u7b49\u5de5\u4e1a\u6d3b\u52a8\u3001\u57fa\u7840\u8bbe\u65bd\u548c\u65b0\u9053\u8def\u9020\u6210\u7684\u788e\u7247\u5316\u4ee5\u53ca\u88ab\u8ba4\u4e3a\u662f\u7531\u4eba\u4e3a\u5f15\u8d77\u7684\u706b\u707e\u3002", "7a967e6fdc8d7f907e301ae92373d73c": "\u6811\u6728\u8986\u76d6\u589e\u52a0\u53ef\u80fd\u8868\u660e\u5b58\u5728\u4e00\u7cfb\u5217\u6f5c\u5728\u6d3b\u52a8\uff0c\u5305\u62ec\u5929\u7136\u6797\u751f\u957f\u3001\u6811\u6728\u4f5c\u7269\u8f6e\u4f5c\u5468\u671f\u6216\u4eba\u9020\u6797\u7ba1\u7406\u3002&nbsp;", "df011829013da4f5fbdff926128e2637": "\u5bf9\u4e8e\u6811\u6728\u7684\u5b9a\u4e49\u4e5f\u503c\u5f97\u6ce8\u610f\u3002<strong>\u6811\u6728\u7684\u5b9a\u4e49\u662f\u9ad8\u5ea6\u8d85\u8fc7 5 \u7c73\u7684\u6728\u672c\u690d\u88ab\uff0c\u6216\u9ad8\u5ea6\u8d85\u8fc7 3 \u7c73\u4e14\u6811\u51a0\u76f4\u5f84\u81f3\u5c11\u4e3a 5 \u7c73\u7684\u6728\u672c\u690d\u88ab\u3002</strong>\u6b64\u6570\u636e\u96c6\u5b8c\u5168\u6392\u9664\u4e86\u975e\u6811\u6728\u4f5c\u7269\uff0c\u4f8b\u5982\u8336\u3001\u7cd6\u3001\u9999\u8549\u548c\u4ed9\u4eba\u638c\uff0c\u4f46\u76ee\u524d\u6ca1\u6709\u533a\u5206\u4eba\u5de5\u6797\u4e0e\u975e\u4eba\u5de5\u6797\u3002", "c18c30c517f466a765cdb3fb92727cad": "\u4e0e\u4ee5\u524d\u7684\u6570\u636e\u96c6\u76f8\u6bd4\uff0c\u4ee5\u524d\u7684\u6570\u636e\u96c6\u901a\u5e38\u5728\u6ca1\u6709\u7a7a\u95f4\u6216\u65f6\u95f4\u80cc\u666f\u7684\u60c5\u51b5\u4e0b\u4e3a\u6bcf\u4e2a\u50cf\u7d20\u7684\u5e74\u5ea6\u56fe\u50cf\u5408\u6210\u8fdb\u884c\u5355\u72ec\u5efa\u6a21\uff0c\u800c\u6b64\u6570\u636e\u96c6\u5219\u5728 10 \u7c73\u81f3 320 \u7c73\u7684\u7a7a\u95f4\u5c3a\u5ea6\u4e0a\u6a21\u62df\u6708\u5ea6\u7269\u5019\u53d8\u5316\u3002\u5b83\u5c55\u793a\u4e86\u5728\u5c0f\u7a7a\u95f4\u5c3a\u5ea6\u4e0a\uff0c\u7279\u522b\u662f\u5728\u65f1\u5730\u3001\u57ce\u5e02\u5730\u533a\u548c\u519c\u7530\u4e0a\uff0c\u7ed8\u5236\u96f6\u6563\u548c\u5f00\u9614\u51a0\u5c42\u68ee\u6797\u7684\u80fd\u529b\u7684\u63d0\u9ad8\u3002\u56e0\u6b64\uff0c\u8be5\u6570\u636e\u6709\u671b\u5728\u5c40\u90e8\u8303\u56f4\u5185\u6539\u8fdb\u5bf9\u6811\u6728\u52a8\u6001\u7684\u76d1\u6d4b\u3002", "ab2db0f6e28a6e5a562b6682dcdc40d6": "\uff08\u6bcf\u5e74\uff0c300 m\uff0c\u5168\u7403\uff0cWCS\uff09", "95eafe7994082a98ef565bc49b0bd0bc": "2022 \u5e74 6 \u6708", "c5b5184ead3a27588f5c225a34d89eb2": "\u57fa\u7840\u7269\u79cd\u5206\u5e03\u56fe\u6765\u81ea<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u9645\u81ea\u7136\u4fdd\u62a4\u8054\u76df\u6fd2\u5371\u7269\u79cd\u7ea2\u8272\u540d\u5f55 (IUCN Red List)</a> \u548c<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u9645\u9e1f\u76df (BirdLife International)</a>\u3002<a href=\"{{5}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u751f\u7269\u591a\u6837\u6027\u7efc\u5408\u8bc4\u4f30\u5de5\u5177</a>\u4e2d\u63d0\u4f9b\u4e86<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u9645\u81ea\u7136\u4fdd\u62a4\u8054\u76df\u6fd2\u5371\u7269\u79cd\u7ea2\u8272\u540d\u5f55 (IUCN Red List)</a>\u3001<a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4e16\u754c\u751f\u7269\u591a\u6837\u6027\u91cd\u8981\u533a\u57df\u6570\u636e\u5e93</a>\u548c<a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4e16\u754c\u4fdd\u62a4\u533a\u6570\u636e\u5e93</a>\u7684\u7efc\u5408\u6570\u636e\u3002", "0cf03266cf5e8f22e1cf3b75169883c2": "2015 \u5e74, 250 m, \u5168\u7403\uff0cJRC", "0b7143af1f961531e8b72bae39e946e8": "\u6b64\u6570\u636e\u53ef\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u4e0b\u8f7d\uff0c\u4e5f\u53ef\u4f7f\u7528\u4ee5\u4e0b\u56fe\u50cf ID \u901a\u8fc7 Google Earth Engine \u8bbf\u95ee\uff08\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">https://glad.umd.edu/dataset/Fire_GFL/</a>\uff09\uff1a<br>- \u706b\u707e\u786e\u5b9a\u6027\uff1ausers/sashatyu/2001-2021_fire_forest_loss<br>- \u6d41\u5931\u65e5\u671f\uff1ausers/sashatyu/2001-2021_fire_forest_loss_annual", "a373c1a68a0bd817598c0cb3412ab220": "\u68d5\u6988\u6cb9\u5382 - 2022 \u5e74", "044357348783c1af3e6cdf7dcb1da3b2": "\u6309\u56fd\u5bb6/\u5730\u533a\u7b5b\u9009", "e6ec3cec87646aa7a9d7bd271153f851": "\u2014\u2014\u89c2\u770b <a class=\"text -paragraph -color-4 -bold\" href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">2023 \u5e74\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u7533\u8bf7\u4eba\u7f51\u7edc\u7814\u8ba8\u4f1a</a>\u7684\u5f55\u50cf", "0706cd79ea892098ef081b23ba851078": "\u60a8\u4e5f\u53ef\u4ee5\u4ece\u4e0b\u9762\u7684\u5217\u8868\u4e2d\u9009\u62e9\u4e00\u4e2a\u56fd\u5bb6/\u5730\u533a\uff1a", "0466913693540a0d51240dfbedec2145": "\u68ee\u6797\u589e\u5f3a\uff08\u73b0\u6709\u68ee\u6797\u9ad8\u5ea6\u589e\u52a0\uff09\u548c\u68ee\u6797\u589e\u52a0\uff082000 \u5e74\u975e\u6797\u5730\u5185\u690d\u6811\u9020\u6797\uff09\u4e4b\u95f4\u5b58\u5728\u6df7\u6dc6\uff0c\u8fd9\u5728\u96be\u4ee5\u786e\u5b9a 2000 \u5e74\u68ee\u6797\u9ad8\u5ea6\u7684\u5317\u65b9\u68ee\u6797\u5730\u533a\u66f4\u4e3a\u7a81\u51fa\u3002 &nbsp;", "3e9d959ab39f767a56fa46f2ecbc5089": "\u6b64\u6570\u636e\u96c6\u6765\u81ea\u9a6c\u91cc\u5170\u5927\u5b66\u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">GLAD</a>\uff08\u5168\u7403\u571f\u5730\u5206\u6790\u4e0e\u53d1\u73b0\uff09\u5b9e\u9a8c\u5ba4\uff0c\u4ee5 30 \u00d7 30 \u7c73\u7684\u5206\u8fa8\u7387\u6d4b\u91cf\u4e86 2000 \u5e74\u81f3 2020 \u5e74\u5168\u7403\u6811\u6728\u8986\u76d6\u9762\u79ef\u589e\u52a0\u60c5\u51b5\uff0c\u5e76\u4ee5 20 \u5e74\u7d2f\u52a0\u56fe\u5c42\u7684\u5f62\u5f0f\u663e\u793a\u3002\u6811\u6728\u8986\u76d6\u589e\u52a0\u662f\u4f7f\u7528 2000 \u5e74\u548c 2020 \u5e74\u7684\u6811\u6728\u9ad8\u5ea6\u4fe1\u606f\u786e\u5b9a\u7684\u3002\u6811\u6728\u9ad8\u5ea6\u662f\u901a\u8fc7\u6574\u5408\u5168\u7403\u751f\u6001\u7cfb\u7edf\u52a8\u529b\u5b66\u8c03\u67e5 (GEDI) \u6fc0\u5149\u96f7\u8fbe\u68ee\u6797\u7ed3\u6784\u6d4b\u91cf\u548c Landsat \u53ef\u7528\u4e8e\u5206\u6790\u7684\u6570\u636e\u65f6\u95f4\u5e8f\u5217\u6765\u5efa\u6a21\u7684\u3002NASA GEDI \u662f 2019 \u5e74 4 \u6708\u8d77\u5728\u56fd\u9645\u7a7a\u95f4\u7ad9\u4e0a\u8fd0\u884c\u7684\u661f\u8f7d\u6fc0\u5149\u96f7\u8fbe\u4eea\u5668\u3002\u5b83\u63d0\u4f9b\u57fa\u4e8e\u70b9\u7684\u690d\u88ab\u7ed3\u6784\u6d4b\u91cf\uff0c\u5305\u62ec\u5168\u7403 \u5317\u7eac 52\u00b0 \u81f3\u5357\u7eac 52\u00b0 \u8303\u56f4\u5185\u7684\u68ee\u6797\u51a0\u5c42\u9ad8\u5ea6\u30022020 \u5e74\u6811\u9ad8 \u2265 5 m \u4e14 2000 \u5e74\u6811\u9ad8 < 5 m \u7684\u50cf\u7d20\u5373\u8ba4\u5b9a\u4e3a\u589e\u52a0\u3002", "5a71f37601b227a5c6492fd82e12efbb": "\u7f29\u5c0f\u65f6\uff08< \u7f29\u653e\u7ea7\u522b 12\uff09\uff0c\u589e\u52a0\u50cf\u7d20\u6839\u636e 30 x 30 \u7c73\u5c3a\u5ea6\u7684\u589e\u52a0\u5bc6\u5ea6\u6539\u53d8\u8272\u5ea6\u3002\u8272\u5ea6\u8f83\u6df1\u7684\u50cf\u7d20\u8868\u793a\u6811\u6728\u8986\u76d6\u589e\u52a0\u96c6\u4e2d\u5ea6\u8f83\u9ad8\u7684\u533a\u57df\uff0c\u800c\u8272\u5ea6\u8f83\u6d45\u7684\u50cf\u7d20\u8868\u793a\u6811\u6728\u8986\u76d6\u589e\u52a0\u96c6\u4e2d\u5ea6\u8f83\u4f4e\u3002\u5f53\u6570\u636e\u8fbe\u5230\u5168\u5206\u8fa8\u7387\uff08\u2265 \u7f29\u653e\u7ea7\u522b 12\uff09\u65f6\uff0c\u50cf\u7d20\u8272\u5ea6\u4e0d\u518d\u53d8\u5316\u3002&nbsp;", "645acda0368282d8b1a1ef5e8b747dc4": "\u5e74\u5ea6\u53d8\u5316\u68c0\u6d4b\u56fe\uff082016 \u5e74\u81f3\u4eca\uff09\u5c06\u4e8e 2023 \u5e74\u8bd5\u884c\u3002", "e42110dbab50596d68425761ee587158": "\u867d\u7136\u6b64\u6570\u636e\u96c6\u5728\u5c0f\u7a7a\u95f4\u5c3a\u5ea6\u4e0a\u4ee5\u9ad8\u7cbe\u5ea6\u7ed8\u5236\u4e86\u70ed\u5e26\u5730\u533a\u7684\u6811\u6728\u8303\u56f4\uff0c\u4f46\u4ecd\u5b58\u5728\u9700\u8981\u8003\u8651\u7684\u5c40\u9650\u6027\u3002\u4f7f\u7528\u65f6\u6001\u5206\u6790\u6bcf\u6708\u7efc\u5408\u6570\u636e\u53ef\u4ee5\u8bc6\u522b\u7a00\u758f\u6811\u6797\uff0c\u4f46\u4ee3\u4ef7\u662f\u9700\u8981\u6781\u5176\u7a33\u5065\u7684\u4e91\u63a9\u6a21\u3002\u4e0e\u5206\u6790\u5e74\u5ea6\u7efc\u5408\u6570\u636e\u6216\u65f6\u95f4\u884d\u751f\u7279\u5f81\u7684\u6570\u636e\u96c6\u76f8\u6bd4\uff0c\u8fd9\u79cd\u65b9\u6cd5\u65e0\u6cd5\u901a\u8fc7\u65f6\u95f4\u805a\u5408\uff08\u4f8b\u5982\u4e2d\u4f4d\u6570\u6216\u767e\u5206\u4f4d\u6570\uff09\u6765\u51cf\u4f4e\u4e91\u6f0f\u5206\u8bef\u5dee\u3002\u56e0\u6b64\uff0c\u8fd9\u79cd\u65b9\u6cd5\u5927\u591a\u4f1a\u589e\u52a0\u4e91\u63a9\u6a21\u7684\u9519\u5206\u8bef\u5dee\uff0c\u4f7f\u5f97\u4e00\u4e9b\u591a\u4e91\u5730\u533a\u7684\u6570\u636e\u53ef\u7528\u6027\u964d\u4f4e\u3002\u8fd9\u79cd\u5bf9\u6bcf\u5e45\u56fe\u50cf\u4e91\u63a9\u6a21\u7684\u4f9d\u8d56\u589e\u52a0\u53ef\u80fd\u4f1a\u589e\u52a0\u4e91\u68c0\u6d4b\u7b97\u6cd5\u4e2d\u5177\u6709\u9ad8\u9519\u5206\u8bef\u5dee\u5730\u533a\u7684\u8bef\u5dee\uff0c\u4f8b\u5982\u4e00\u4e9b\u571f\u58e4\u660e\u4eae\u7684\u533a\u57df\u3002", "32b2e68407cd5d38ff72f6d62db5c2eb": "\u57fa\u7840\u6570\u636e\u89c4\u8303\u4e5f\u53ef\u80fd\u5f71\u54cd\u4e92\u64cd\u4f5c\u6027\u3002\u8be5\u6570\u636e\u96c6\u805a\u5408\u4e86\u4ece\u4e8c\u8fdb\u5236\u9010\u50cf\u7d20\u8bad\u7ec3\u6570\u636e\u5bfc\u51fa\u5230\u8f83\u7c97\u5206\u8fa8\u7387\u7684\u8fde\u7eed\u6982\u7387\u3002\u76f8\u6bd4\u4e4b\u4e0b\uff0cHansen et al. (2013) \u5c06\u4e9a\u50cf\u7d20\u4e8c\u8fdb\u5236\u8bad\u7ec3\u6570\u636e\u805a\u5408\u5230\u50cf\u7d20\u5c3a\u5ea6\uff0c\u5e76\u5c06\u5176\u4e0e MODIS \u4e2d\u66f4\u7c97\u7565\u7684\u6811\u6728\u8986\u76d6\u4f30\u8ba1\u76f8\u7ed3\u5408\u3002\u8fd9\u4e9b\u5b9a\u4e49\u4e0a\u7684\u5dee\u5f02\u6709\u5229\u6709\u5f0a\uff0c\u56e0\u6b64\u8fd9\u4e9b\u6570\u636e\u5728\u6bcf\u50cf\u7d20\u5c3a\u5ea6\u4e0a\u5bf9\u8bc4\u4f30\u8303\u56f4\uff08\u800c\u4e0d\u662f\u8986\u76d6\uff09\u6709\u610f\u4e49\uff0c\u4f46\u4e0e Hansen \u76f8\u6bd4\uff0c\u5b83\u4e0e\u534a\u516c\u9877\u5c3a\u5ea6\u7684\u6811\u6728\u8986\u76d6\u8bc4\u4f30\u6709\u66f4\u5f3a\u7684\u76f8\u5173\u6027\u3002", "41322991fe9f0d9b5e687136f6f61ac4": "\u6b64\u70ed\u5e26 10 \u7c73\u6811\u8303\u56f4\u6570\u636e\u96c6\u6620\u5c04\u4e86\u4e00\u68f5\u6216\u591a\u68f5\u6811\u4e0e\u6bcf\u4e2a 10 \u7c73\u50cf\u7d20\u7684\u8d28\u5fc3\u76f8\u4ea4\u7684\u6982\u7387\u3002\u8fd9\u4e9b\u6570\u636e\u5206\u5e03\u5728 43.5 \u4ebf\u516c\u9877\u7684\u571f\u5730\u4e0a\uff0c\u6e90\u81ea\u5e94\u7528\u4e8e Sentinel-2 \u5149\u5b66\u548c Sentinel-1 \u96f7\u8fbe\u56fe\u50cf\u7684\u591a\u65f6\u76f8\u5377\u79ef\u795e\u7ecf\u7f51\u7edc\u6a21\u578b\u3002\u7a7a\u95f4\u805a\u5408\u7684\u6811\u6728\u8986\u76d6\u6570\u636e\u662f\u4ee5\u534a\u516c\u9877\u4e3a\u5c3a\u5ea6\uff0c\u901a\u8fc7\u5bf9\u6811\u6728\u8303\u56f4\u6982\u7387\u6570\u636e\u8fdb\u884c\u5e73\u5747\u91cd\u91c7\u6837\u5f97\u51fa\u7684\u3002", "1d67793613a0386eaa95d5257e52a182": "\u9576\u5d4c\u666f\u89c2\u4e2d\u7684\u6811\u6728\uff08\u6709\u9608\u503c\uff09", "6d30efc7d53999bb00dfdcfcf864475e": "GitHub \u4e0a\u63d0\u4f9b\u4e86\u4ee3\u7801\uff0c\u6570\u636e\u5219\u53ef\u5728 Google Earth Engine \u4e0a\u67e5\u770b\u3002", "376de5b360a18f560500f97672a4286c": "\u786e\u5b9a\u4e16\u754c\u4e0a\u5269\u4f59\u7684\u6700\u540e\u4e00\u7247\u672a\u88ab\u5206\u5272\u7684\u68ee\u6797\u666f\u89c2\uff0c\u5176\u9762\u79ef\u8db3\u4ee5\u4fdd\u7559\u6240\u6709\u539f\u751f\u751f\u7269\u591a\u6837\u6027\uff0c\u622a\u81f3 2020 \u5e74\u6ca1\u6709\u51fa\u73b0\u4eba\u4e3a\u6539\u53d8\u7684\u8ff9\u8c61\u3002\u8be5\u56fe\u5c42\u8fd8\u663e\u793a\u4e86\u4ece 2000 \u5e74\u5230 2020 \u5e74\u5b8c\u6574\u68ee\u6797\u666f\u89c2\u8303\u56f4\u7684\u51cf\u5c11\u3002", "f5ac8f50425ba4b6d4837c97a282f0cb": "\u91c7\u77ff\u7279\u8bb8\u6743 - 2022 \u5e74", "9ff4fe49d72e75c2048c3f2863bb279a": "\u5168\u7403\u6240\u6709\u751f\u6001\u7cfb\u7edf\u5e72\u6270\u8b66\u62a5 (DIST-ALERT)", "c1e957b135115dff42c9d3de10d00d9a": "\u4f4e\u7f6e\u4fe1\u5ea6\uff1a\u68c0\u6d4b\u5230 2-3 \u6b21", "3f41625d83a7bad48fc129cfb3de6a64": "\u9ad8\u7f6e\u4fe1\u5ea6\uff1a\u68c0\u6d4b\u5230 4 \u6b21\u6216\u4ee5\u4e0a", "db4f033b556c3589e4670c9a37861ae3": "\u663e\u793a DIST-ALERT", "6cfcd17af5af67e1782e75f59f2f4721": "<a href=\"{{0}}\" target=\"_blank\">\u5bf9\u5373\u5c06\u8fdb\u884c\u7684\u6539\u8fdb\u63d0\u4f9b\u53cd\u9988</a>\u3002\u5206\u6790\u529f\u80fd\u5373\u5c06\u4e0a\u7ebf\u3002", "39aca20da185ed7140a2861abbf2abde": "\u56fe\u5c42\u5f00\u53d1\u4e2d\uff0c\u6682\u65e0\u5206\u6790\u529f\u80fd\u3002", "e001660a374dc8a58fa8af005cbb1a55": "\u8fd1\u4e4e\u5b9e\u65f6\u5730\u8bc6\u522b\u53ef\u80fd\u7684\u690d\u88ab\u635f\u5931\u3002", "d7b1bbed2507ee77cee6785dbc276bbd": "\u5168\u7403\u690d\u88ab\u5e72\u6270\u8b66\u62a5 (DIST-ALERT)", "953e37ca7522a606df1be17420c834c7": "<a href=\"{{0}}\" target=\"_blank\">\u4e86\u89e3\u66f4\u591a</a>\u5e76<a href=\"{{1}}\" target=\"_blank\">\u5bf9\u5373\u5c06\u8fdb\u884c\u7684\u6539\u8fdb\u63d0\u4f9b\u53cd\u9988</a>\u3002\u5206\u6790\u529f\u80fd\u5373\u5c06\u4e0a\u7ebf\u3002", "37ed6572b7db04cd7e403f68d986456b": "\u5168\u65b0\u7684\u8fd1\u5b9e\u65f6\u5168\u7403\u690d\u88ab\u5e72\u6270\u8b66\u62a5\u73b0\u5df2\u63a8\u51fa\uff01\u8bf7<br><a href=\"{{0}}\">\u5728\u6b64</a>\u6d4f\u89c8\uff0c\u5e76\u5728<a href=\"{{1}}\">\u8fd9\u91cc</a>\u9605\u8bfb\u66f4\u591a\u4fe1\u606f\u3002", "3b6c2b4caaf4f14f8d7feeddc4ac3f4d": "\u670d\u52a1\u6761\u6b3e", "833d49b16914980b6279122ffbe5f1ae": "\u4f7f\u7528\u534f\u8c03\u7684 Landsat-Sentinel-2 (HLS) \u5f71\u50cf\uff0c\u8fd1\u4e4e\u5b9e\u65f6\u5730\u76d1\u6d4b\u5168\u7403\u690d\u88ab\u5e72\u6270", "e7fb8f5db67317977476032d31cf7bca": "\u57fa\u7840\u4ea7\u54c1\u6bcf\u65e5\u66f4\u65b0\uff0c\u56fe\u50cf\u91cd\u8bbf\u65f6\u95f4\u4e3a\u6bcf 2-4 \u5929\u3002GFW \u4e0a\u7684\u4ea7\u54c1\u6bcf\u5468\u66f4\u65b0\u3002", "90e699b2f989ce3c05a0f3da1a192dd9": "\u8fd9\u4e9b\u8b66\u62a5\u53ef\u68c0\u6d4b\u690d\u88ab\u8986\u76d6\u635f\u5931\u6216\u5e72\u6270\u3002\u672c\u4ea7\u54c1\u65e0\u6cd5\u533a\u5206\u4eba\u4e3a\u6216\u5176\u4ed6\u7c7b\u578b\u7684\u5e72\u6270\u3002\u4f8b\u5982\uff0c\u5728\u4eba\u5de5\u56ed\u6797\u5185\u68c0\u6d4b\u5230\u8b66\u62a5\u65f6\uff0c\u53ef\u80fd\u4ee3\u8868\u4f10\u6728\u4f5c\u4e1a\uff0c\u800c\u672a\u8f6c\u6362\u4e3a\u975e\u68ee\u6797\u571f\u5730\u7528\u9014\uff0c\u800c\u5728\u519c\u7530\u4e2d\u68c0\u6d4b\u5230\u8b66\u62a5\u65f6\uff0c\u53ef\u80fd\u4ee3\u8868\u519c\u4f5c\u7269\u6536\u5272\u6d3b\u52a8", "a21c7870cfac114925f4297ca39c60e5": "2023 \u5e74 1 \u6708 1 \u65e5\u81f3\u4eca\uff08GFW \u62e5\u6709\u81ea 2023 \u5e74 12 \u6708 1 \u65e5\u4ee5\u6765\u7684\u6570\u636e\uff0c\u672a\u6765\u4ec5\u663e\u793a\u6700\u8fd1 2 \u5e74\u7684\u8b66\u62a5\u6570\u636e\uff09", "f72550a4d732ba1881d19a8801a38a23": "\u6211\u4eec\u4e0d\u5efa\u8bae\u5c06\u8fd9\u4e9b\u8b66\u62a5\u7528\u4e8e\u5168\u7403\u6216\u533a\u57df\u8d8b\u52bf\u8bc4\u4f30\uff0c\u4e5f\u4e0d\u5efa\u8bae\u4f7f\u7528\u8b66\u62a5\u8fdb\u884c\u9762\u79ef\u4f30\u7b97\u3002\u6211\u4eec\u5efa\u8bae\u4f7f\u7528\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\uff0c\u4ee5\u66f4\u51c6\u786e\u5730\u6bd4\u8f83\u68ee\u6797\u968f\u65f6\u95f4\u53d8\u5316\u7684\u8d8b\u52bf\uff0c\u5e76\u8fdb\u884c\u9762\u79ef\u4f30\u7b97\u3002\u5bf9\u4e8e\u5168\u7403\u571f\u5730\u8986\u76d6\u53d8\u5316\uff0c20 \u5e74\u6570\u636e\u53ef\u80fd\u66f4\u9002\u7528\u4e8e\u67d0\u4e9b\u7279\u5b9a\u76ee\u7684\uff0c\u5e94\u8fdb\u4e00\u6b65\u63a2\u7d22\u3002\u6b64\u5916\uff0c\u65b9\u6cd5\u5b66\u7684\u66f4\u65b0\u4ee5\u53ca\u6708\u5ea6\u548c\u5e74\u5ea6\u4e4b\u95f4\u7684\u4e91\u91cf\u53d8\u5316\u7ed9\u4f7f\u7528\u8b66\u62a5\u8fdb\u884c\u5e74\u95f4/\u5e74\u5185\u6bd4\u8f83\u5e26\u6765\u4e86\u989d\u5916\u7684\u98ce\u9669\u3002", "efd7ce2454266231581012d55ca750ce": "\u53ef\u4ee5\u201c\u7b5b\u9009\u201d\u8b66\u62a5\u6765\u8bc6\u522b\u7528\u6237\u611f\u5174\u8da3\u7684\u8b66\u62a5\uff0c\u4f8b\u5982\u53ef\u80fd\u6d89\u53ca\u68ee\u6797\u780d\u4f10\u5e76\u4e14\u9700\u8981\u4f18\u5148\u91c7\u53d6\u884c\u52a8\u7684\u8b66\u62a5\u3002\u7528\u6237\u53ef\u4ee5\u901a\u8fc7\u8986\u76d6\u5176\u4ed6\u60c5\u5883\u6027\u6570\u636e\u96c6\uff08\u4f8b\u5982\u4fdd\u62a4\u533a\u6216\u79cd\u690d\u7684\u6811\u6728\uff09\u6765\u5b9e\u73b0\u8fd9\u4e00\u70b9\u3002\u6b64\u5904\u63d0\u4f9b\u672a\u7ecf\u7b5b\u9009\u7684\u6570\u636e\uff0c\u4ee5\u4fbf\u7528\u6237\u81ea\u884c\u5b9a\u4e49\u4f18\u5148\u7ea7\u65b9\u6cd5\u3002\u201c\u9700\u8981\u5173\u6ce8\u7684\u5730\u70b9\u201d (Places to Watch) \u6570\u636e\u5c42\u63d0\u4f9b\u4e86\u6811\u6728\u8986\u76d6\u8303\u56f4\u5185\u7b5b\u9009\u7684\u8b66\u62a5\u4f4d\u7f6e\u3002", "452e423b2d988731e14e477a1f2ce0ca": "\u6211\u4eec\u5728\u201c\u6811\u6728\u8986\u76d6\u201d\u8303\u56f4\u5185\u63d0\u4f9b\u4ea7\u54c1\u7684\u63a9\u76d6\u7248\u672c\uff0c\u8be5\u8303\u56f4\u5b9a\u4e49\u4e3a\u6240\u6709\u9ad8\u5ea6\u8d85\u8fc7 5 \u7c73\uff082020 \u5e74\uff09\u4e14\u6811\u51a0\u8986\u76d6\u7387\u8d85\u8fc7 30%\uff082010 \u5e74\uff09\u7684\u690d\u88ab\uff0c\u5305\u62ec\u5929\u7136\u6797\u6216\u4eba\u5de5\u6797\u5f62\u5f0f\u3002 2021 \u5e74\u4ee5\u6765\u7684\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u635f\u5931\u5df2\u88ab\u63a9\u76d6\u3002", "fd3a26d8ed1a594c61224d92f77c4135": "UMD \u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Google Earth Engine \u5e94\u7528</a>\u663e\u793a\u8b66\u62a5\uff0c\u5176\u91c7\u7528\u4e0d\u540c\u7684\u65b9\u6cd5\u6765\u5b9a\u4e49\u7f6e\u4fe1\u5ea6\uff0c\u540c\u65f6\u9488\u5bf9\u89e6\u53d1\u8b66\u62a5\u7684\u690d\u88ab\u51cf\u5c11\u91c7\u7528\u4e0d\u540c\u7684\u9608\u503c\u3002", "c9304e861dda8c92c100e56fa61b09a4": "\u4e0e GFW \u4e0a\u7684\u5176\u4ed6\u8b66\u62a5\u7cfb\u7edf\u76f8\u6bd4\uff0cDIST-ALERT \u4f1a\u6301\u7eed\u76d1\u6d4b\u8fc7\u53bb\u5df2\u8bc6\u522b\u8b66\u62a5\u533a\u57df\u7684\u50cf\u7d20\u3002DIST-ALERT \u4fdd\u7559\u6700\u8fd1\u68c0\u6d4b\u5230\u5e72\u6270\u7684\u65e5\u671f\uff0c\u8ba9\u7528\u6237\u4e86\u89e3\u6811\u6728\u8986\u76d6\u8303\u56f4\u5185\u7684\u6700\u65b0\u53d8\u5316\u3002", "fe4973286262cfbc2ba0cbae76611191": "GFW \u4e0a\u7684 DIST-ALERT \u662f\u5176\u884d\u751f\u4ea7\u54c1\uff0cGFW \u4ea7\u54c1\u4e2d\u672a\u4f7f\u7528\u7684\u5176\u4ed6\u6570\u636e\u5c42\u53ef\u901a\u8fc7 LPDAAC \u548c GEE \u83b7\u5f97\uff0c\u4f8b\u5982\u521d\u59cb\u690d\u88ab\u8986\u76d6\u7387\u548c\u5e72\u6270\u6301\u7eed\u65f6\u95f4\u3002 LPDAAC \u4e0a\u7684\u7248\u672c\u6bcf 2-4 \u5929\u66f4\u65b0\u4e00\u6b21\uff0c\u800c GFW \u4e0a\u7684\u6570\u636e\u6bcf\u5468\u66f4\u65b0\u4e00\u6b21\u3002", "c529b3a89590291ce60ea79dc288cc15": "\u8be5\u6570\u636e\u96c6\u662f OPERA \u7684 DIST-ALERT \u4ea7\u54c1\uff08\u57fa\u4e8e Harmonized Landsat Sentinel-2 \u4ea7\u54c1\u7684 OPERA \u5730\u8868\u5e72\u6270\u8b66\u62a5\uff09\u7684\u884d\u751f\u4ea7\u54c1\uff0c\u901a\u8fc7\u5bf9 NASA/USGS Landsat \u548c ESA Sentinel-2 \u536b\u661f\uff08\u5373 HLS \u6570\u636e\u96c6\uff09\u7684\u534f\u8c03\u6570\u636e\u8fdb\u884c\u65f6\u95f4\u5e8f\u5217\u800c\u5206\u6790\u5f97\u51fa\u3002\u8be5\u4ea7\u54c1\u5728\u5168\u7403\u8303\u56f4\u5185\u4ee5 3000 \u4e07\u50cf\u7d20\u8bc6\u522b\u5e76\u6301\u7eed\u76d1\u6d4b\u690d\u88ab\u8986\u76d6\u53d8\u5316\u3002\u53ef\u901a\u8fc7 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">LPDAAC \u7f51\u7ad9</a> \u53ca Google Earth Engine (GEE) \u8bbf\u95ee\uff0c\u8d44\u4ea7 ID \u4e3a\uff1aprojects/glad/HLSDIST/current", "e143649359527211fe11a1c672e20166": "\u6bcf\u5f53\u83b7\u5f97\u65b0\u7684\u536b\u661f\u6570\u636e\u4e14\u5730\u9762\u672a\u88ab\u4e91\u6216\u96ea\u906e\u6321\u65f6\uff0c\u8be5\u4ea7\u54c1\u90fd\u4f1a\u68c0\u6d4b\u6bcf\u4e2a\u50cf\u7d20\u7684\u690d\u88ab\u8986\u76d6\u663e\u8457\u51cf\u5c11\uff08\u4ee5\u201c\u690d\u88ab\u8986\u76d6\u7387\u201d\u6216\u5730\u9762\u88ab\u690d\u88ab\u8986\u76d6\u7684\u767e\u5206\u6bd4\u8868\u793a\uff09\u3002", "8554ef2bea70b4dfae05b824fe62b312": "\u8bf7\u786e\u8ba4\u6b64\u8ba2\u9605", "a9a7fa5a19ef9c43ce5ba2ff1c6e7157": "\u7531\u4e8e\u6d88\u9664\u91cf\u548c\u51c0\u901a\u91cf\u6570\u636e\u4e0d\u80fd\u4ee5\u65f6\u95f4\u5e8f\u5217\u7684\u65b9\u5f0f\u63d0\u4f9b\uff0c\u6b64\u56fe\u663e\u793a\u5728\u6574\u4e2a\u6a21\u578b\u671f\u95f4\u7684\u5e74\u5747\u6392\u653e\u91cf\u3001\u6d88\u9664\u91cf\u548c\u51c0\u901a\u91cf\u3002\u5728\u6b64\u56fe\u4e2d\uff0c\u6240\u6709\u6d41\u91cf\u7684\u7d2f\u8ba1\u503c\u9664\u4ee5\u5efa\u6a21\u5e74\u6570\uff0c\u53ef\u8ba1\u7b97\u5f97\u5230\u6a21\u578b\u671f\u95f4\u7684\u5e74\u5747\u503c\u3002\u7edf\u8ba1\u6570\u636e\u5305\u62ec\u9ad8\u4e8e\u9009\u5b9a\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u533a\u57df\uff0c\u4ee5\u53ca\u6811\u6728\u8986\u76d6\u589e\u52a0\u672a\u8fbe\u5230\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u533a\u57df\u3002", "19f410072316f9c9d40ce72bdf992907": "\u6b64\u56fe\u663e\u793a 2001 \u5e74\u81f3 2022 \u5e74\u95f4\uff0c\u68ee\u6797\u4e0e\u5927\u6c14\u7684\u5e74\u5747<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6392\u653e\u91cf</a>\u3001<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6d88\u9664\u91cf</a>\uff08\u5c01\u5b58\uff09\u4ee5\u53ca\u68ee\u6797\u4e0e\u5927\u6c14\u4e4b\u95f4\u7684\u6e29\u5ba4\u6c14\u4f53<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u51c0\u901a\u91cf</a>\u3002\u7528\u4e8e\u8ba1\u7b97\u8fd9\u4e9b\u6570\u636e\u7684\u65b9\u6cd5\u5728 <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. 2021</a> \u4e2d\u6709\u4ecb\u7ecd\uff1b\u8be5\u6587\u4ecb\u7ecd\u4e86\u4e00\u79cd\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u53ef\u7528\u4e8e\u4f30\u8ba1\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u3002\u8fd9\u4e9b\u65b9\u6cd5\u9075\u5faa<a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u7684 IPCC \u51c6\u5219\u3002\u6392\u653e\u6765\u81ea\u6797\u5206\u66ff\u4ee3\u5e72\u6270\uff0c\u800c\u6d88\u9664\u5219\u53d1\u751f\u5728\u68ee\u6797\u5f97\u5230\u7ef4\u62a4\u6216\u6269\u5927\u7684\u5730\u65b9\u3002\u6392\u653e\u5305\u62ec\u6240\u6709\u76f8\u5173\u751f\u6001\u7cfb\u7edf\u78b3\u6c60\uff08\u5730\u4e0a\u751f\u7269\u91cf\u3001\u5730\u4e0b\u751f\u7269\u91cf\u3001\u67af\u6728\u3001\u843d\u53f6\u3001\u571f\u58e4\uff09\u4ee5\u53ca\u6e29\u5ba4\u6c14\u4f53\uff08CO2\u3001NH4\u3001N2O\uff09\uff0c\u800c\u6d88\u9664\u5219\u662f\u8fdb\u5165\u5730\u4e0a\u548c\u5730\u4e0b\u751f\u6001\u7cfb\u7edf\u78b3\u6c60\u3002", "036d4387adbde9f486c373c235961ca9": "\u2022 \u6570\u636e\u662f\u5efa\u6a21\u7684\u4ea7\u7269\uff0c\u56e0\u6b64\u5fc5\u7136\u5b58\u5728\u4e00\u5b9a\u7a0b\u5ea6\u7684\u8bef\u5dee\u548c\u4e0d\u786e\u5b9a\u6027\u3002\u5f3a\u70c8\u5efa\u8bae\u7528\u6237\u5728\u4f7f\u7528\u6570\u636e\u524d\u9605\u8bfb\u5e76\u5145\u5206\u7406\u89e3\u5143\u6570\u636e\u53ca\u5176\u4ed6\u53ef\u7528\u6587\u4ef6\u3002<br>\u2022 \u6d88\u9664\u603b\u91cf\u7684\u4e0d\u786e\u5b9a\u6027\u9ad8\u4e8e\u6392\u653e\u91cf\uff0c\u4e3b\u8981\u539f\u56e0\u5728\u4e8e\u7f8e\u56fd\u548c\u6b27\u6d32\u4ee5\u5916\u786e\u7acb\u7684\u6e29\u5e26\u68ee\u6797\u7684\u6d88\u9664\u56e0\u7d20\u5b58\u5728\u7684\u4e0d\u786e\u5b9a\u6027\u3002<br>\u2022 \u5404\u9879\u503c\u9002\u7528\u4e8e\u6797\u533a\uff08\u6811\u51a0\u8986\u76d6 &gt;30% \u5e76\u4e14\u9ad8\u5ea6 &gt;5 \u7c73\uff09\u4ee5\u53ca\u6709\u6811\u6728\u8986\u76d6\u589e\u52a0\u7684\u533a\u57df\u3002\u8bf7\u53c2\u89c1 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. 2021</a> \u4e86\u89e3\u6709\u5173\u8be5\u5206\u6790\u4e2d\u6240\u7528\u68ee\u6797\u5b9a\u4e49\u7684\u8fdb\u4e00\u6b65\u4fe1\u606f\u3002<br>\u2022 \u6392\u653e\u6765\u81ea\u6797\u5206\u66ff\u4ee3\u5e72\u6270\uff0c\u4e0d\u5305\u62ec\u6765\u81ea\u68ee\u6797\u9000\u5316\u7684\u6392\u653e\u3002<br>\u2022 \u7528\u4f5c\u4f30\u8ba1\u57fa\u7840\u7684\u6d3b\u52a8\u6570\u636e\u5b58\u5728\u65f6\u95f4\u4e0d\u4e00\u81f4\u6027\uff1a<br>o \u6d88\u9664\u6570\u636e\u5b58\u5728\u65f6\u95f4\u4e0d\u4e00\u81f4\u6027\u7684\u539f\u56e0\u662f\uff0c\u6811\u6728\u8986\u76d6\u589e\u52a0\u4ee3\u8868 2000 \u5e74\u81f3 2012 \u5e74\u7d2f\u8ba1\u7684\u603b\u548c\uff0c\u800c\u4e0d\u662f\u6574\u4e2a 2022 \u5e74\u4f30\u8ba1\u7684\u5e74\u5ea6\u589e\u52a0\u3002<br>o 2011 \u5e74\u81f3 2015 \u5e74\u95f4\uff0c\u56e0\u91c7\u7528\u65b0\u7684\u536b\u661f\u6570\u636e\u548c\u6539\u53d8\u65b9\u6cd5\uff0c\u5b9e\u73b0\u4e86\u6811\u6728\u8986\u76d6\u51cf\u5c11\u63a2\u6d4b\u6539\u8fdb\uff0c\u8fd9\u53ef\u80fd\u5bfc\u81f4\u8fd1\u5e74\u6bd4\u65e9\u5e74\u7684\u6392\u653e\u4f30\u8ba1\u503c\u9ad8\u3002\u8bf7\u53c2\u8003\u6b64\u5904\u4ee5\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002\u8bf7<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u53c2\u8003\u6b64\u5904</a>\u4ee5\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002", "d65e9a996335c01df410ab394cb8debe": "\u5728\u7eb3\u5165 2022 \u5e74\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u7684\u60c5\u51b5\u4e0b\uff0c\u5c11\u6570\u5176\u4ed6\u6a21\u578b\u8f93\u5165\u6570\u636e\u96c6\u548c\u5e38\u91cf\u53d1\u751f\u4e86\u53d8\u5316\uff0c\u5982\u4e0b\u6240\u8ff0\u3002\u8be6\u60c5\u8bf7\u53c2\u9605<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u535a\u5ba2\u6587\u7ae0</a>\u3002<br><br>1. \u5730\u4e0b\u78b3\u4e0e\u5730\u4e0a\u78b3\u6bd4\u4f8b\u6570\u636e\u7684\u6765\u6e90\u3002\u4ee5\u524d\u4f7f\u7528\u4e00\u4e2a\u5168\u7403\u5e38\u91cf\uff0c\u73b0\u5728\u4f7f\u7528 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Huang et al. 2021</a> \u4e2d\u7684\u5730\u56fe\u3002<br>2. \u6811\u6728\u8986\u76d6\u589e\u52a0\u7684\u5e74\u4efd\u3002\u4ee5\u524d\u4f7f\u7528 2000 \u5e74\u81f3 2012 \u5e74\u7684\u6570\u636e\uff0c\u73b0\u5728\u4f7f\u7528 <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Potapov et al. 2022</a> \u4e2d 2000 \u5e74\u81f3 2020 \u5e74\u7684\u6570\u636e\u3002<br>3. \u706b\u707e\u6570\u636e\u7684\u6765\u6e90\u3002\u4ee5\u524d\u4f7f\u7528 MODIS \u8fc7\u706b\u9762\u79ef\u6570\u636e\uff0c\u73b0\u5728\u4f7f\u7528 <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Tyukavina et al. 2022</a> \u4e2d\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6570\u636e\u3002<br>4. \u6ce5\u70ad\u5730\u56fe\u7684\u6765\u6e90\u3002\u65b0\u7684\u70ed\u5e26\u6570\u636e\u96c6\u5df2\u7eb3\u5165\uff0c\u9ad8\u4e8e\u5317\u7eac 40 \u5ea6\u5730\u533a\u7684\u6570\u636e\u96c6\u6709\u53d8\u5316\u3002<br>5. CH4 \u548c N2O \u7684\u5168\u7403\u53d8\u6696\u6f5c\u52bf (GWP) \u5e38\u91cf\u3002\u4ee5\u524d\u4f7f\u7528 IPCC \u7b2c\u4e94\u6b21\u8bc4\u4f30\u62a5\u544a\u4e2d\u7684 GWP \u6570\u636e\uff0c\u73b0\u5728\u4f7f\u7528 <a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">IPCC \u7b2c\u516d\u6b21\u8bc4\u4f30\u62a5\u544a</a>\u4e2d\u7684 GWP \u6570\u636e\u3002", "ff1e568abdff584ad0b1a026db264fa8": "\u663e\u793a\u68ee\u6797\u7684\u5e74\u5e73\u5747\u603b\u6392\u653e\u91cf\u3001\u603b\u6d88\u9664\u91cf\u548c\u51c0\u901a\u91cf", "ee0c21c5dca8884b7303bea11c66a76c": "\u6d4f\u89c8\u5404\u9879\u5206\u6790", "7597b7a72dac9c88eb66da2edf2b724c": "\u663e\u793a\u6797\u5206\u66ff\u4ee3\u68ee\u6797\u5e72\u6270\u5bfc\u81f4\u7684\u5e74\u603b\u6392\u653e\u91cf", "935e50db587c6eb73d8b4dc456806174": "\u2022 \u6392\u653e\u6570\u636e\u662f\u5efa\u6a21\u7684\u4ea7\u7269\uff0c\u56e0\u6b64\u5fc5\u7136\u5b58\u5728\u4e00\u5b9a\u7a0b\u5ea6\u7684\u8bef\u5dee\u548c\u4e0d\u786e\u5b9a\u6027\u3002\u5f3a\u70c8\u5efa\u8bae\u7528\u6237\u5728\u4f7f\u7528\u6570\u636e\u524d\u9605\u8bfb\u5e76\u5145\u5206\u7406\u89e3\u5143\u6570\u636e\u53ca\u5176\u4ed6\u53ef\u7528\u6587\u4ef6\u3002<br>\u2022 \u5404\u9879\u6392\u653e\u6570\u636e\u9002\u7528\u4e8e\u6797\u533a\uff08\u6811\u51a0\u8986\u76d6 &gt;30% \u5e76\u4e14\u9ad8\u5ea6 &gt;5 \u7c73\uff09\u4ee5\u53ca\u6709\u6811\u6728\u8986\u76d6\u589e\u52a0\u7684\u533a\u57df\u3002\u8bf7\u53c2\u89c1 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a> \u4e86\u89e3\u6709\u5173\u8be5\u5206\u6790\u4e2d\u6240\u7528\u68ee\u6797\u5b9a\u4e49\u7684\u8fdb\u4e00\u6b65\u4fe1\u606f\u3002<br>\u2022 \u6392\u653e\u6570\u636e\u53cd\u6620 Landsat \u536b\u661f\u56fe\u50cf\u4e2d\u89c2\u5bdf\u5230\u7684\u6797\u5206\u66ff\u4ee3\u5e72\u6270\uff0c\u4e0d\u5305\u62ec\u6765\u81ea\u672a\u89c2\u5bdf\u5230\u7684\u68ee\u6797\u9000\u5316\u7684\u6392\u653e\u3002<br>\u2022 \u6392\u653e\u53cd\u6620\u7684\u662f\u603b\u91cf\u4f30\u8ba1\uff0c\u5373\u4e0d\u5305\u62ec\u6765\u81ea\u5e72\u6270\u540e\u53d1\u751f\u7684\u4efb\u4f55\u518d\u751f\u957f\u7684\u78b3\u6d88\u9664\u3002\u76f8\u53cd\uff0c\u5728\u4f34\u968f\u68ee\u6797\u78b3\u6d88\u9664\u56fe\u5c42\uff0c\u4f1a\u8003\u8651\u78b3\u6d88\u9664\u603b\u91cf\u3002<br>\u2022 2011 \u5e74\u81f3 2015 \u5e74\u95f4\uff0c\u56e0\u91c7\u7528\u65b0\u7684\u536b\u661f\u6570\u636e\u4ee5\u53ca\u6539\u53d8\u65b9\u6cd5\uff0c\u5b9e\u73b0\u4e86\u6811\u6728\u8986\u76d6\u51cf\u5c11\u63a2\u6d4b\u6539\u8fdb\uff0c\u8fd9\u53ef\u80fd\u5bfc\u81f4\u8fd1\u5e74\u6bd4\u65e9\u5e74\u7684\u4f30\u8ba1\u503c\u9ad8\u3002\u8bf7\u53c2\u8003\u6b64\u5904\u4ee5\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002<br>\u2022 \u68ee\u6797\u78b3\u6392\u653e\u4e0d\u4f1a\u53cd\u6620\u4ece\u751f\u6001\u7cfb\u7edf\u78b3\u6c60\u5230\u91c7\u4f10\u6728\u5236\u54c1 (HWP) \u78b3\u6c60\u4e4b\u95f4\u7684\u78b3\u8f6c\u79fb\u3002<br>\u2022 \u6b64\u56fe\u81ea\u6700\u521d\u53d1\u5e03\u4ee5\u540e\u6709\u66f4\u65b0\u3002\u5982\u9700\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u89c1\u201c\u6982\u89c8\u201d\u3002", "0e9ff52afd853e47de68309c6fc072bb": "\u6b64\u56fe\u663e\u793a\u6bcf\u5e74\u56e0\u6797\u5206\u66ff\u4ee3\u68ee\u6797\u5e72\u6270\u5f15\u8d77\u7684\u6e29\u5ba4\u6c14\u4f53<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6392\u653e</a>\u3002\u6392\u653e\u5305\u62ec\u6240\u6709\u76f8\u5173\u751f\u6001\u7cfb\u7edf\u78b3\u6c60\uff08\u5730\u4e0a\u751f\u7269\u91cf\u3001\u5730\u4e0b\u751f\u7269\u91cf\u3001\u67af\u6728\u3001\u843d\u53f6\u3001\u571f\u58e4\uff09\u4ee5\u53ca\u6e29\u5ba4\u6c14\u4f53\uff08CO2\u3001NH4\u3001N2O\uff09\uff0c\u5e76\u4e14\u5047\u5b9a\u6392\u653e\u53d1\u751f\u5728\u5e72\u6270\u5e74\u4efd\u3002\u7528\u4e8e\u8ba1\u7b97\u6392\u653e\u7684\u65b9\u6cd5\u5728 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a> \u4e2d\u6709\u4ecb\u7ecd\uff1b\u8be5\u6587\u4ecb\u7ecd\u4e86\u4e00\u79cd\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u53ef\u7528\u4e8e\u4f30\u8ba1\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u3002\u8be5\u65b9\u6cd5\u9075\u5faa\u53d1\u751f\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u7684<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u7684\u201cIPCC \u6307\u5bfc\u51c6\u5219\u201d(IPCC Guidelines)\uff0c\u8fd9\u5728 <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a> \u7684\u5168\u7403\u68ee\u6797\u53d8\u5316\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6570\u636e\u4e2d\u6709\u53cd\u6620\u3002", "9a102a71b5f3f207e3eb91249342d218": "\u6392\u653e\u53cd\u6620\u7684\u662f\u603b\u91cf\u4f30\u8ba1\uff0c\u5373\u4e0d\u5305\u62ec\u540e\u7eed\u518d\u751f\u5e26\u6765\u7684\u78b3\u6d88\u9664\uff08\u5c01\u5b58\uff09\u3002\u8bf7\u53c2\u8003\u51c0\u901a\u91cf\u56fe\u4ee5\u4e86\u89e3\u6709\u5173\u78b3\u6d88\u9664\u7684\u4fe1\u606f\u4ee5\u53ca\u9009\u5b9a\u533a\u57df\u7684\u51c0\u901a\u91cf\u3002\u6392\u653e\u91cf\u5305\u62ec\u9ad8\u4e8e\u9009\u5b9a\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u533a\u57df\u4ee5\u53ca\u6811\u6728\u8986\u76d6\u589e\u52a0\u672a\u8fbe\u5230\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u533a\u57df\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u3002", "8ef3131adbc6199163be8166ddb30291": "\u6309\u5e72\u6270\u9a71\u52a8\u56e0\u7d20\u663e\u793a\u6bcf\u5e74\u56e0\u6797\u5206\u66ff\u4ee3\u68ee\u6797\u5e72\u6270\u5bfc\u81f4\u7684\u603b\u6392\u653e\u91cf", "986be19ff8746d2fc82bd1d30fc782c5": "\u2022 \u6392\u653e\u6570\u636e\u662f\u5efa\u6a21\u7684\u4ea7\u7269\uff0c\u56e0\u6b64\u5fc5\u7136\u5b58\u5728\u4e00\u5b9a\u7a0b\u5ea6\u7684\u8bef\u5dee\u548c\u4e0d\u786e\u5b9a\u6027\u3002\u5f3a\u70c8\u5efa\u8bae\u7528\u6237\u5728\u4f7f\u7528\u6570\u636e\u524d\u9605\u8bfb\u5e76\u5145\u5206\u7406\u89e3\u5143\u6570\u636e\u53ca\u5176\u4ed6\u53ef\u7528\u6587\u4ef6\u3002<br>\u2022 \u8fd9\u4e9b\u503c\u4ec5\u9002\u7528\u4e8e\u6797\u533a\uff08\u6811\u51a0\u8986\u76d6 &gt;30% \u5e76\u4e14\u9ad8\u5ea6 gt;5 \u7c73\uff0c\u6216\u8005\u6811\u6728\u8986\u76d6\u589e\u52a0\u7684\u533a\u57df\uff09\u3002\u8bf7\u53c2\u89c1 Harris et al. (2021) \u4e86\u89e3\u6709\u5173\u8be5\u5206\u6790\u4e2d\u6240\u7528\u68ee\u6797\u5b9a\u4e49\u7684\u8fdb\u4e00\u6b65\u4fe1\u606f\u3002<br>\u2022 \u6392\u653e\u6570\u636e\u53cd\u6620 Landsat \u536b\u661f\u56fe\u50cf\u4e2d\u89c2\u5bdf\u5230\u7684\u6797\u5206\u66ff\u4ee3\u5e72\u6270\uff0c\u4e0d\u5305\u62ec\u6765\u81ea\u672a\u89c2\u5bdf\u5230\u7684\u68ee\u6797\u9000\u5316\u7684\u6392\u653e\u3002<br>\u2022 \u6392\u653e\u53cd\u6620\u7684\u662f\u603b\u91cf\u4f30\u8ba1\uff0c\u5373\u4e0d\u5305\u62ec\u6765\u81ea\u5e72\u6270\u540e\u53d1\u751f\u7684\u4efb\u4f55\u518d\u751f\u7684\u78b3\u6d88\u9664\u3002\u76f8\u53cd\uff0c\u5728\u4f34\u968f\u68ee\u6797\u78b3\u6d88\u9664\u56fe\u5c42\uff0c\u4f1a\u8003\u8651\u78b3\u6d88\u9664\u603b\u91cf\u3002<br>\u2022 2011 \u5e74\u81f3 2015 \u5e74\u95f4\uff0c\u56e0\u91c7\u7528\u65b0\u7684\u536b\u661f\u6570\u636e\u548c\u6539\u53d8\u65b9\u6cd5\uff0c\u5b9e\u73b0\u4e86\u6811\u6728\u8986\u76d6\u51cf\u5c11\u63a2\u6d4b\u6539\u8fdb\uff0c\u8fd9\u53ef\u80fd\u5bfc\u81f4\u8fd1\u5e74\u6bd4\u65e9\u5e74\u7684\u4f30\u8ba1\u503c\u9ad8\u3002\u8bf7<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u53c2\u8003\u6b64\u5904</a>\u4ee5\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002<br> \u68ee\u6797\u78b3\u6392\u653e\u4e0d\u4f1a\u53cd\u6620\u4ece\u751f\u6001\u7cfb\u7edf\u78b3\u6c60\u5230\u91c7\u4f10\u6728\u5236\u54c1 (HWP) \u78b3\u6c60\u4e4b\u95f4\u7684\u78b3\u8f6c\u79fb\u3002<br>\u2022\u8bf7\u6ce8\u610f\uff0c\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6570\u636e\u96c6\u9a71\u52a8\u56e0\u7d20\u7684\u65e2\u5b9a\u9002\u7528\u8303\u56f4\u662f\u5168\u7403\u6216\u5730\u533a\uff0c\u56e0\u6b64\u5728\u89c2\u5bdf\u5c0f\u533a\u57df\u6216\u7279\u5b9a\u5730\u7406\u533a\u57df\u7684\u6392\u653e\u65f6\uff0c\u53ef\u80fd\u8868\u73b0\u5f97\u4e0d\u51c6\u786e\u3002\u5982\u9700\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u8003\u201c\u68ee\u6797\u53d8\u5316\u201d(Forest Change) \u6807\u7b7e\u4e0a\u7684\u201c\u6309\u4e3b\u5bfc\u9a71\u52a8\u56e0\u7d20\u5217\u51fa\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u201d\uff08Tree Cover Loss by Dominant Driver) \u56fe\u3002", "bd504094b28a475c47979ed3a434465a": "<span></span>GLAD-S2 \u9884\u8b66", "cbc5cefbe1d7935bc7d3bc1f027d10d3": "<span></span>RADD \u9884\u8b66", "64f6ce4dbf43464e095105d7af7e60d8": "<button data-id=\"toggle-undefined\" id=\"toggle-undefined\" role=\"switch\" aria-label=\"toggle\" aria-checked=\"true\" class=\"c-toggle -active toggle-large\"></button>\u516c\u5f00\u6b64\u533a\u57df", "8694c75108b96741839398f59df153c4": "<b>\u8bf7\u68c0\u67e5\u60a8\u7684\u7535\u5b50\u90ae\u4ef6\uff0c\u7136\u540e\u5355\u51fb\u94fe\u63a5\u6765\u786e\u8ba4\u60a8\u7684\u8ba2\u9605\u3002</b>\u5982\u679c\u60a8\u6ca1\u6709\u770b\u5230\u7535\u5b50\u90ae\u4ef6\uff0c\u8bf7\u68c0\u67e5\u60a8\u7684\u5783\u573e\u90ae\u4ef6\u6587\u4ef6\u5939\u3002", "f50eaa3930f971a70b974197d7822603": "\u5df2\u8ba2\u9605\u6240\u6709\u901a\u77e5", "4cc80a2826b80191744ed3d4eb5d9b6e": "\u6b64\u56fe\u6309<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6811\u6728\u8986\u76d6\u51cf\u5c11\u4e3b\u5bfc\u9a71\u52a8\u56e0\u7d20</a>\u663e\u793a\u6bcf\u5e74\u56e0\u6797\u5206\u66ff\u4ee3\u68ee\u6797\u5e72\u6270\u5f15\u8d77\u7684\u6e29\u5ba4\u6c14\u4f53<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6392\u653e</a>\u3002\u6392\u653e\u5305\u62ec\u6240\u6709\u76f8\u5173\u751f\u6001\u7cfb\u7edf\u78b3\u6c60\uff08\u5730\u4e0a\u751f\u7269\u91cf\u3001\u5730\u4e0b\u751f\u7269\u91cf\u3001\u67af\u6728\u3001\u843d\u53f6\u3001\u571f\u58e4\uff09\u4ee5\u53ca\u6e29\u5ba4\u6c14\u4f53\uff08CO2\u3001NH4\u3001N2O\uff09\uff0c\u5e76\u4e14\u5047\u5b9a\u6392\u653e\u53d1\u751f\u5728\u5e72\u6270\u5e74\u4efd\u3002\u7528\u4e8e\u8ba1\u7b97\u6392\u653e\u7684\u65b9\u6cd5\u5728 <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. 2021</a> \u4e2d\u6709\u4ecb\u7ecd\uff1b\u8be5\u6587\u4ecb\u7ecd\u4e86\u4e00\u79cd\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u53ef\u7528\u4e8e\u4f30\u8ba1\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u3002\u8be5\u65b9\u6cd5\u9075\u5faa\u53d1\u751f\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u7684\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355\u7684\u201cIPCC \u6307\u5bfc\u51c6\u5219\u201d(IPCC Guidelines)\uff0c\u8fd9\u5728 <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a>\u7684\u5168\u7403\u68ee\u6797\u53d8\u5316\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6570\u636e\u4e2d\u6709\u53cd\u6620\u3002<br>\u6392\u653e\u53cd\u6620\u7684\u662f\u603b\u91cf\u4f30\u8ba1\uff0c\u5373\u4e0d\u5305\u62ec\u540e\u7eed\u518d\u751f\u5e26\u6765\u7684\u78b3\u6d88\u9664\u3002\u8bf7\u53c2\u8003\u51c0\u901a\u91cf\u56fe\u4ee5\u4e86\u89e3\u6709\u5173\u6d88\u9664\u7684\u4fe1\u606f\u4ee5\u53ca\u9009\u5b9a\u533a\u57df\u7684\u51c0\u901a\u91cf\u3002\u6392\u653e\u5305\u62ec\u9ad8\u4e8e\u9009\u5b9a\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u533a\u57df\u4ee5\u53ca\u6811\u6728\u8986\u76d6\u589e\u52a0\u672a\u8fbe\u5230\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u533a\u57df\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u3002<br>\u6811\u6728\u8986\u76d6\u51cf\u5c11\u7684\u4e94\u4e2a\u9a71\u52a8\u56e0\u7d20\u7684\u5b9a\u4e49\u5982\u4e0b\uff1a<br>\u2014\u2014\u5927\u5b97\u5546\u54c1\u9a71\u52a8\u7684\u68ee\u6797\u780d\u4f10\uff1a\u4e3b\u8981\u4e0e\u5546\u4e1a\u5316\u519c\u4e1a\u6269\u5f20\u5173\u8054\u7684\u5927\u89c4\u6a21\u68ee\u6797\u780d\u4f10\u3002<br>\u2014\u2014\u8f6e\u57a6\u519c\u4e1a\uff1a\u56e0\u4e3a\u4e2d\u5c0f\u89c4\u6a21\u519c\u4e1a\u800c\u6682\u65f6\u51cf\u5c11\u6216\u6c38\u4e45\u68ee\u6797\u780d\u4f10\u3002<br>\u2014\u2014\u6797\u4e1a\uff1a\u79cd\u690d\u56ed\u548c\u81ea\u7136\u68ee\u6797\u91c7\u4f10\u5bfc\u81f4\u7684\u6682\u65f6\u51cf\u5c11\uff0c\u6709\u4e00\u4e9b\u539f\u59cb\u68ee\u6797\u780d\u4f10\u3002<br>\u2014\u2014\u91ce\u706b\uff1a\u6682\u65f6\u51cf\u5c11\uff0c\u4e0d\u5305\u62ec\u70e7\u8352\u653e\u706b\u3002<br>\u2014\u2014\u57ce\u5e02\u5316\uff1a\u57ce\u5e02\u4e2d\u5fc3\u6269\u5f20\u5bfc\u81f4\u7684\u68ee\u6797\u780d\u4f10\u3002<br>\u5927\u5b97\u5546\u54c1\u9a71\u52a8\u7684\u68ee\u6797\u780d\u4f10\u548c\u57ce\u5e02\u5316\u7c7b\u522b\u4ee3\u8868\u4e86\u6c38\u4e45\u6027\u68ee\u6797\u780d\u4f10\uff0c\u800c\u53d7\u5176\u4ed6\u7c7b\u522b\u5f71\u54cd\u7684\u6811\u6728\u8986\u76d6\u901a\u5e38\u4f1a\u518d\u751f\u3002\u8be5\u9a71\u52a8\u56e0\u7d20\u6570\u636e\u96c6\u5e76\u4e0d\u6807\u793a\u6811\u6728\u8986\u76d6\u51cf\u5c11\u53d1\u751f\u540e\u571f\u5730\u8986\u76d6\u7684\u7a33\u5b9a\u6027\u6216\u72b6\u51b5\uff0c\u4e5f\u4e0d\u533a\u5206\u81ea\u7136\u68ee\u6797\u5927\u706b\u548c\u4eba\u4e3a\u68ee\u6797\u5927\u706b\u3002<br>\u8be5\u9a71\u52a8\u56e0\u7d20\u6570\u636e\u96c6\u6807\u793a 10 km \u7f51\u683c\u5355\u5143\u6811\u6728\u8986\u76d6\u51cf\u5c11\u7684\u4e3b\u5bfc\u9a71\u52a8\u56e0\u7d20\uff0c\u5176\u4f9d\u636e\u662f\u8fd1 5,000 \u4e2a\u6837\u672c\u70b9\u4ee5\u53ca\u57fa\u4e8e\u6811\u6728\u8986\u76d6\u3001\u6811\u6728\u8986\u76d6\u51cf\u5c11\u3001\u6811\u6728\u8986\u76d6\u589e\u52a0\u3001\u4eba\u53e3\u5bc6\u5ea6\u3001\u571f\u5730\u8986\u76d6\u548c\u706b\u707e\u7684\u6570\u636e\u6784\u5efa\u7684\u6a21\u578b\u3002\u7136\u540e\uff0c\u6bcf\u4e2a\u5355\u5143\u7684\u4e3b\u5bfc\u9a71\u52a8\u56e0\u7d20\u4e0e\u6bcf\u5e74\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u76f8\u4e92\u53c2\u8003\uff0c\u8ba1\u7b97\u6b64\u5904\u5c55\u793a\u7684\u7edf\u8ba1\u6570\u636e\u3002\u5728\u8be5\u671f\u95f4\u6811\u6728\u8986\u76d6\u51cf\u5c11\u4e0d\u5230 0.5% \u7684\u7f51\u683c\u5355\u5143\u672a\u88ab\u8d4b\u4e88\u7b49\u7ea7\uff0c\u5728\u7edf\u8ba1\u6570\u636e\u4e2d\u6ca1\u6709\u8868\u793a\u3002<br>\u8bf7\u6ce8\u610f\uff0c\u6b64\u6570\u636e\u96c6\u7684\u65e2\u5b9a\u9002\u7528\u8303\u56f4\u662f\u5168\u7403\u6216\u5730\u533a\uff0c\u56e0\u6b64\u5728\u89c2\u5bdf\u5c0f\u533a\u57df\u6216\u7279\u5b9a\u5730\u7406\u533a\u57df\u65f6\uff0c\u53ef\u80fd\u8868\u73b0\u5f97\u4e0d\u51c6\u786e\u3002GFW \u4e0a\u7684\u5168\u7403\u548c\u5730\u533a\u603b\u548c\u4f1a\u53cd\u6620\u50cf\u7d20\u8ba1\u6570\uff0c\u800c\u4e0d\u662f\u57fa\u4e8e\u6837\u672c\u7684\u533a\u57df\u4f30\u8ba1\u3002\u5728\u5168\u7403\u548c\u5730\u533a\u8303\u56f4\uff0c\u57fa\u4e8e\u50cf\u7d20\u8ba1\u6570\u65b9\u6cd5\u7684\u533a\u57df\u4f30\u8ba1\u4f1a\u5728\u57fa\u4e8e\u6837\u672c\u7684\u533a\u57df\u4f30\u8ba1\u7684\u8bef\u5dee\u8303\u56f4\u5185\uff0c\u56e0\u6b64\u53ef\u4ee5\u5728\u533a\u57df\u8ba1\u7b97\u4e2d\u76f4\u63a5\u4f7f\u7528\u5730\u56fe\u8f93\u51fa\u3002<br>\u6570\u636e\u96c6\u7684\u51c6\u786e\u6027\u56e0\u7b49\u7ea7\u548c\u5730\u7406\u533a\u57df\u800c\u6709\u5dee\u5f02\u3002\u6bcf\u4e2a\u7b49\u7ea7\u7684\u5168\u7403\u51c6\u786e\u6027\u5982\u4e0b\u6240\u793a\uff1b\u5730\u533a\u51c6\u786e\u6027\u53ef\u5728 <a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">Curtis et al. 2018</a> \u7684\u8865\u5145\u6750\u6599\u4e2d\u627e\u5230\u3002<br>\u5728\u7eb3\u5165 2022 \u5e74\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u7684\u60c5\u51b5\u4e0b\uff0c\u5c11\u6570\u5176\u4ed6\u6a21\u578b\u8f93\u5165\u6570\u636e\u96c6\u548c\u5e38\u91cf\u53d1\u751f\u4e86\u53d8\u5316\uff0c\u5982\u4e0b\u6240\u8ff0\u3002\u8be6\u60c5\u8bf7\u53c2\u9605<a href=\"{{5}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u535a\u5ba2\u6587\u7ae0</a>\u3002<br><br>1. \u5730\u4e0b\u78b3\u4e0e\u5730\u4e0a\u78b3\u6bd4\u4f8b\u6570\u636e\u7684\u6765\u6e90\u3002\u4ee5\u524d\u4f7f\u7528\u4e00\u4e2a\u5168\u7403\u5e38\u91cf\uff0c\u73b0\u5728\u4f7f\u7528 <a href=\"{{6}}\" target=\"_blank\" rel=\"noopener noreferrer\">Huang et al. 2021</a> \u4e2d\u7684\u5730\u56fe\u3002<br>2. \u6811\u6728\u8986\u76d6\u589e\u52a0\u7684\u5e74\u4efd\u3002\u4ee5\u524d\u4f7f\u7528 2000 \u5e74\u81f3 2012 \u5e74\u7684\u6570\u636e\uff0c\u73b0\u5728\u4f7f\u7528 <a href=\"{{7}}\" target=\"_blank\" rel=\"noopener noreferrer\">Potapov et al. 2022</a> \u4e2d 2000 \u5e74\u81f3 2020 \u5e74\u7684\u6570\u636e\u3002<br>3.\u706b\u707e\u6570\u636e\u7684\u6765\u6e90\u3002\u4ee5\u524d\u4f7f\u7528 MODIS \u8fc7\u706b\u9762\u79ef\u6570\u636e\uff0c\u73b0\u5728\u4f7f\u7528 <a href=\"{{8}}\" target=\"_blank\" rel=\"noopener noreferrer\">Tyukavina et al. 2022</a> \u4e2d\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6570\u636e\u3002<br>4. \u6ce5\u78b3\u5730\u56fe\u7684\u6765\u6e90\u3002\u65b0\u7684\u70ed\u5e26\u6570\u636e\u96c6\u5df2\u7eb3\u5165\uff0c\u9ad8\u4e8e\u5317\u7eac 40 \u5ea6\u5730\u533a\u7684\u6570\u636e\u96c6\u6709\u53d8\u5316\u3002<br>5. CH4 \u548c N2O \u7684\u5168\u7403\u53d8\u6696\u6f5c\u52bf (GWP) \u5e38\u91cf\u3002\u4ee5\u524d\u4f7f\u7528 IPCC \u7b2c\u4e94\u6b21\u8bc4\u4f30\u62a5\u544a\u4e2d\u7684 GWP \u6570\u636e\uff0c\u73b0\u5728\u4f7f\u7528 <a href=\"{{9}}\" target=\"_blank\" rel=\"noopener noreferrer\">IPCC \u7b2c\u516d\u6b21\u8bc4\u4f30\u62a5\u544a</a>\u4e2d\u7684 GWP \u6570\u636e\u3002", "bc0273498f67aee77b126e20a7d6d00f": "\u2022 \u8fd9\u662f\u4e00\u4e2a\u590d\u5408\u56fe\u5c42\uff0c\u7531\u4e94\u4e2a\u6570\u636e\u96c6\u7ec4\u6210\uff0c\u6bcf\u4e2a\u6570\u636e\u96c6\u6709\u81ea\u5df1\u7684\u65b9\u6cd5\u4ee5\u53ca\u4f18\u7f3a\u70b9\u3002\u5982\u8981\u8fdb\u4e00\u6b65\u4e86\u89e3\u6bcf\u4e2a\u6570\u636e\u96c6\u7684\u7279\u5b9a\u6ce8\u610f\u4e8b\u9879\uff0c\u8bf7\u53c2\u89c1\u6bcf\u4e2a\u6570\u636e\u96c6\u7684\u539f\u59cb\u53d1\u5e03\u5185\u5bb9\u3002<br><br>\u2022 \u6240\u6709\u8f93\u5165\u56fe\u5c42\u5747\u4ece\u77e2\u91cf\u6570\u636e\u8f6c\u5316\u800c\u6765\uff0c\u6216\u8005\u662f\u4ece\u7c97\u6805\u683c\u6570\u636e\u91cd\u65b0\u91c7\u6837\u800c\u6765\u3002", "ad36b75fdc1cc5b6441bbb4acacc11a1": "\u6b64\u6570\u636e\u96c6\u4f7f\u7528\u4e94\u4e2a\u56fe\u5c42\u6807\u793a\u5168\u7403\u8303\u56f4\u7684\u6ce5\u70ad\u5730\u53ca\u5176\u4ed6\u6709\u673a\u8d28\u571f\u58e4\u3002 Miettinen et al. 2016 \u7528\u4e8e\u5370\u5ea6\u5c3c\u897f\u4e9a\u548c\u9a6c\u6765\u897f\u4e9a\uff0cHastie et al. 2022 \u7528\u4e8e\u4f4e\u5730\u79d8\u9c81\uff0cCrezee et al. 2022 \u7528\u4e8e\u521a\u679c\u76c6\u5730\uff0cGumbricht et al. 2017 \u7528\u4e8e\u5317\u7eac 40 \u5ea6\u548c\u5357\u7eac 60 \u5ea6\u4e4b\u95f4\u7684\u6240\u6709\u571f\u5730\uff08\u5305\u62ec\u524d\u8ff0\u6570\u636e\u96c6\u6db5\u76d6\u7684\u533a\u57df\uff09\u3002 Xu et al. 2018 \u7528\u4e8e\u5317\u7eac 40 \u5ea6\u4ee5\u5317\u7684\u6240\u6709\u571f\u5730\u3002Miettinen et al. 2016\u3001Xu et al. 2018 \u5df2\u683c\u6805\u5316\u4e3a\u5927\u7ea6 30x30 m \u5206\u8fa8\u7387\uff0c\u800c Gumbricht et al. 2017\u3001Crezee et al. 2022 \u548c Hastie et al. 2022 \u5df2\u4ece\u539f\u751f\u5206\u8fa8\u7387\u91cd\u65b0\u91c7\u6837\u4e3a\u5927\u7ea6 30x30 m \u5206\u8fa8\u7387\uff0c\u8fd9\u662f\u4e3a\u4e86\u8ddf Hansen et al. 2013 \u4e2d\u7684 Global Forest Change \u5730\u56fe\u4fdd\u6301\u4e00\u81f4\u3002\u6240\u6709\u56fe\u5c42\u5747\u6709\u7ec4\u5408\uff0c\u5373 Gumbricht et al. 2017 \u4e5f\u7528\u4e8e\u5370\u5ea6\u5c3c\u897f\u4e9a/\u9a6c\u6765\u897f\u4e9a\u3001\u79d8\u9c81\u4e9a\u9a6c\u900a\u548c\u521a\u679c\u76c6\u5730\u3002\u6240\u6709\u6570\u636e\u6765\u6e90\u5747\u6709\u4e0d\u540c\u7684\u6ce5\u70ad\u5730\u5212\u754c\u65b9\u6cd5\uff0c\u8fd9\u5728\u5b83\u4eec\u7684\u539f\u59cb\u53d1\u5e03\u5185\u5bb9\u4e2d\u6709\u4ecb\u7ecd\u3002", "f11ff303d06cc4e85bcac92dbfa56915": "\u6ce5\u70ad\u5730\u7684\u5212\u754c\u8303\u56f4", "06825fd558f528c0dbecb6d269d79629": "<button data-id=\"toggle-undefined\" id=\"toggle-undefined\" role=\"switch\" aria-label=\"toggle\" aria-checked=\"false\" class=\"c-toggle toggle-large\"></button>\u516c\u5f00\u6b64\u533a\u57df", "46ea117ededf39b3cd72005686da397b": "\u6211\u4eec\u5df2\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u5230 <i></i>\uff0c\u5176\u4e2d\u6709\u7528\u4e8e\u9a8c\u8bc1<i>\u6bdb\u4f0a\u5c9b\u5730\u533a</i>\u9884\u8b66\u8ba2\u9605\u7684\u94fe\u63a5", "ba779facf190e4b839ede91d54bf408c": "\u8bf7\u68c0\u67e5\u60a8\u7684\u6536\u4ef6\u7bb1\u5e76\u5355\u51fb\u786e\u8ba4\u94fe\u63a5\u3002\u5982\u679c\u60a8\u6ca1\u6709\u770b\u5230\u6b64\u7535\u5b50\u90ae\u4ef6\uff0c\u8bf7\u68c0\u67e5\u60a8\u7684\u5783\u573e\u90ae\u4ef6\u6587\u4ef6\u5939\u770b\u770b\u3002", "84b9100979650619ff5001f00e9bf079": "\u91cd\u65b0\u53d1\u9001\u7535\u5b50\u90ae\u4ef6", "267372176e24cd645a78d8d10d7e6b75": "<span></span>\u6240\u6709\u9884\u8b66", "fe4577bbb70694cac9a2cc6a484abfd9": "<span></span>GLAD-L \u9884\u8b66", "787508daa7c6f87c8b9a0eb2a3204425": "\u5df2\u8ba2\u9605\u6bcf\u6708\u6458\u8981", "0b51902093dbd1da1e47c6ee6cdd5be1": "\u5df2\u8ba2\u9605\u68ee\u6797\u53d8\u5316\u9884\u8b66", "190108bb7b5b2bdecd144e774c1b78e3": "\u5df2\u8ba2\u9605\u68ee\u6797\u53d8\u5316\u9884\u8b66\u548c\u6bcf\u6708\u6458\u8981", "9af173d632e94474b0a0dec7c6cdd8d5": "\u5df2\u8ba2\u9605\u706b\u707e\u9884\u8b66\u548c\u6bcf\u6708\u6458\u8981", "3c1374afe5d21a37d3e85ad99a45cb9b": "\u5df2\u8ba2\u9605\u706b\u707e\u9884\u8b66", "6ad7bb4a124b20978d963d7549c3a571": "\u6d4f\u89c8\u4e0d\u540c\u4e3b\u9898\u7684\u53ef\u7528\u5206\u6790\u3002", "e98ce3ae34b8dcee4b9a935acefba553": "\u5728\u7eb3\u5165 2022 \u5e74\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u7684\u60c5\u51b5\u4e0b\uff0c\u5c11\u6570\u5176\u4ed6\u6a21\u578b\u8f93\u5165\u6570\u636e\u96c6\u548c\u5e38\u91cf\u53d1\u751f\u4e86\u53d8\u5316\uff0c\u5982\u4e0b\u6240\u8ff0\u3002\u8be6\u60c5\u8bf7\u53c2\u9605<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u535a\u5ba2\u6587\u7ae0</a>\u3002<br><br>1. \u5730\u4e0b\u78b3\u4e0e\u5730\u4e0a\u78b3\u6bd4\u4f8b\u6570\u636e\u7684\u6765\u6e90\u3002\u4ee5\u524d\u4f7f\u7528\u4e00\u4e2a\u5168\u7403\u5e38\u91cf\uff0c\u73b0\u5728\u4f7f\u7528 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Huang et al. 2021</a> \u4e2d\u7684\u5730\u56fe\u3002<br>2. \u6811\u6728\u8986\u76d6\u589e\u52a0\u7684\u5e74\u4efd\u3002\u4ee5\u524d\u4f7f\u7528 2000 \u5e74\u81f3 2012 \u5e74\u7684\u6570\u636e\uff0c\u73b0\u5728\u4f7f\u7528 <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Potapov et al. 2022</a> \u4e2d 2000 \u5e74\u81f3 2020 \u5e74\u7684\u6570\u636e\u3002<br>3. \u706b\u707e\u6570\u636e\u7684\u6765\u6e90\u3002\u4ee5\u524d\u4f7f\u7528 MODIS \u8fc7\u706b\u9762\u79ef\u6570\u636e\uff0c\u73b0\u5728\u4f7f\u7528 <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Tyukavina et al.2022</a> \u4e2d\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6570\u636e\u3002<br>4. \u6ce5\u70ad\u5730\u56fe\u7684\u6765\u6e90\u3002\u65b0\u7684\u70ed\u5e26\u6570\u636e\u96c6\u5df2\u7eb3\u5165\uff0c\u9ad8\u4e8e\u5317\u7eac 40 \u5ea6\u5730\u533a\u7684\u6570\u636e\u96c6\u6709\u53d8\u5316\u3002<br>5. CH4 \u548c N2O \u7684\u5168\u7403\u53d8\u6696\u6f5c\u52bf (GWP) \u5e38\u91cf\u3002\u4ee5\u524d\u4f7f\u7528 IPCC \u7b2c\u4e94\u6b21\u8bc4\u4f30\u62a5\u544a\u4e2d\u7684 GWP \u6570\u636e\uff0c\u73b0\u5728\u4f7f\u7528 <a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">IPCC \u7b2c\u516d\u6b21\u8bc4\u4f30\u62a5\u544a</a>\u4e2d\u7684 GWP \u6570\u636e\u3002", "f7ac35fdd2b361bc7ad9e4b7379e99c9": "\u7efc\u5408\u9884\u8b66", "2b9daf4ee6810aaa9d619803f41e549e": "\u5982\u4f55\u5c06\u62a5\u544a\u5bfc\u51fa\u4e3a CSV\u3002&nbsp;", "242b18d617e1784dea4bcded6ce90ea5": "<strong>\u62a5\u544a\uff1a</strong>\u5bf9\u901a\u8fc7\u6a21\u677f\u6536\u96c6\u7684\u73b0\u573a\u6570\u636e\u8fdb\u884c\u603b\u7ed3\uff0c\u636e\u6b64\u751f\u6210\u7684\u6587\u4ef6\u5373\u4e3a\u62a5\u544a\u3002\u53ef\u5728 FW Mobile \u4e0a\u521b\u5efa\u62a5\u544a\uff0c\u4e14\u53ef\u4ee5\u5728 FW Mobile \u6216 FW Web \u4e0a\u67e5\u770b\u3002", "339f814cc9a7069164ecda016fd5a3df": "\u67e5\u770b\u56e2\u961f\u8be6\u60c5", "acfbfb10c9561c9fa4cca581bafd29d3": "1. \u5728\u9080\u8bf7\u8be6\u60c5\u9875\u9762\uff0c\u70b9\u51fb\u8868\u683c\u4e2d\u56e2\u961f\u540d\u79f0\u65c1\u8fb9\u5782\u76f4\u7684\u4e09\u4e2a\u70b9\u3002&nbsp;", "ede874d547ff474f67c128eae34d446a": "1. \u8fd4\u56de Teams \u9875\u9762\uff08\u53c2\u89c1\u4e0a\u9762\u7684\u7b2c\u4e00\u6b65\uff09\u3002\u5728\u6807\u6709\u201c\u6211\u5df2\u52a0\u5165\u201d\u7684\u5730\u65b9\u53ef\u4ee5\u770b\u5230\u60a8\u7684\u56e2\u961f\u3002&nbsp;", "2fbf864d94e48df91affd343aeb9bcac": "2. \u70b9\u51fb\u533a\u57df\u5757\u4e2d\u6807\u6709\u201c\u67e5\u770b\u56e2\u961f\u201d\u7684\u6309\u94ae\uff0c\u8fdb\u5165\u56e2\u961f\u8be6\u60c5\u9875\u9762\u3002&nbsp;&nbsp;", "53b28174f5a258973de822c541f91b49": "\u5982\u679c\u73b0\u5728\u65e0\u6cd5\u5b8c\u6210\u4efb\u52a1\uff0c\u5982\u4f55\u5c06\u4efb\u52a1\u6807\u8bb0\u4e3a\u201c\u6682\u505c\u201d\u4ece\u800c\u901a\u77e5\u4efb\u52a1\u7684\u521b\u5efa\u8005\u3002&nbsp;", "82ccae8c08b5055947a08da1aab967af": "\u60a8\u7684\u8d26\u6237\u4e2d\u6709\u81f3\u5c11\u4e00\u9879\u4efb\u52a1\u3002\u5982\u679c\u5c1a\u672a\u521b\u5efa\u4efb\u4f55\u4efb\u52a1\u6216\u672a\u6536\u5230\u56e2\u961f\u7ecf\u7406\u5206\u53d1\u7684\u4efb\u52a1\uff0c\u8bf7<a href=\"{{0}}\">\u9605\u8bfb\u672c\u6559\u7a0b\u4ee5\u4e86\u89e3\u5982\u4f55\u64cd\u4f5c\u3002</a>", "6f3808a32e6209130ffa1e46ba1c821e": "1. \u5728\u4e3b\u83dc\u5355\u4e2d\uff0c\u70b9\u51fb\u6807\u6709\u201c\u4efb\u52a1\u201d\u7684\u6309\u94ae\u3002\u8bf7\u6ce8\u610f\uff0c\u83dc\u5355\u9879\u5e94\u8be5\u6709\u4e00\u4e2a\u526f\u6807\u9898\u663e\u793a\u60a8\u6709\u591a\u5c11\u672a\u5b8c\u6210\u4efb\u52a1\u3002&nbsp;", "dfc3dad2e36a0fbbc1517da5f6b4a146": "\u5b8c\u6210\u4efb\u52a1", "26bc100bfaf19d4b7f51a11df4caeb40": "1. \u4efb\u52a1\u5f00\u59cb\u540e\uff0c\u60a8\u5c06\u6765\u5230\u5730\u56fe\u9875\u9762\u3002\u5206\u5f00\u4e24\u6307\u53ef\u5728\u5730\u56fe\u4e0a\u653e\u5927\u4efb\u52a1\u6240\u5728\u533a\u57df\uff0c\u4ee5\u4fbf\u8fd1\u8ddd\u79bb\u67e5\u770b\u3002\u4efb\u52a1\u5c06\u663e\u793a\u4e3a\u4e00\u4e2a\u5185\u90e8\u5e26\u6709\u65d7\u5e1c\u7684\u6b63\u65b9\u5f62\u3002\u5982\u679c\u4efb\u52a1\u7531\u591a\u4e2a\u8b66\u62a5\u7ec4\u6210\uff0c\u4e5f\u90fd\u4f1a\u663e\u793a\u51fa\u6765\uff0c\u4f46\u53ea\u6709\u4e00\u4e2a\u8b66\u62a5\u4f1a\u663e\u793a\u4efb\u52a1\u6807\u5fd7\u3002&nbsp;&nbsp;", "940c55a4ea6f6af214ae0c572cff13fa": "\u5982\u679c\u79bb\u7ebf\uff0c\u8bf7\u5728\u8fde\u7ebf\u65f6\u5c06\u5b8c\u6210\u7684\u4efb\u52a1\u540c\u6b65\u5230\u7f51\u7ad9", "187ef328e8ccadf5d62ede728e31e3b5": "1. \u5728\u4e3b\u83dc\u5355\u4e2d\uff0c\u70b9\u51fb\u6807\u6709\u201c\u62a5\u544a\u201d\u7684\u6309\u94ae\u3002\u8bf7\u6ce8\u610f\uff0c\u83dc\u5355\u9879\u5e94\u8be5\u6709\u4e00\u4e2a\u526f\u6807\u9898\uff0c\u663e\u793a\u60a8\u6709\u591a\u5c11\u672a\u540c\u6b65\u5230\u7f51\u7ad9\u7684\u5df2\u5b8c\u6210\u62a5\u544a\u3002&nbsp;", "8aa478ba722cdda5d50c2d6a3d14ae94": "\u5728\u4f7f\u7528 Global Forest \u79fb\u52a8\u7248\u548c\u7f51\u7edc\u7248\u65f6\uff0c\u4ee5\u4e0b\u662f\u53ef\u80fd\u9047\u5230\u7684 Global Forest Watch \u4e3b\u8981\u5b9a\u4e49\u3002", "38b4f397e6cf36e90787a502b4a0f2ce": "<strong>RADD</strong>\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u6bcf 6-12 \u5929\u66f4\u65b0\u4e00\u6b21\uff0c\u5206\u8fa8\u7387\u4e3a 10-meter\uff0c\u5e94\u7528\u4e8e\u6f6e\u6e7f\u7684\u70ed\u5e26\u5730\u533a\uff08\u5305\u62ec\u5357\u7f8e\u6d32\u3001\u4e2d\u7f8e\u6d32\u3001\u6492\u54c8\u62c9\u4ee5\u5357\u975e\u6d32\u548c\u4e1c\u5357\u4e9a\u5c9b\u5c7f\uff09\u3002 &nbsp;", "a6dae6a3b580137224189b8b55c5b7f7": "\u68ee\u6797\u8986\u76d6\u51cf\u635f\uff082015 \u2013 2019\uff09\u3002&nbsp", "ca91e076f4a98b3703d8e817fde86e0d": "\u4e16\u754c\u4fdd\u62a4\u533a\u6570\u636e\u5e93 (WDPA)&nbsp;", "9d4dd46d173c251db5950f4bf285c29c": "Forest Watcher \u662f\u4e00\u6b3e\u514d\u8d39\u7684\u79bb\u7ebf\u89e3\u51b3\u65b9\u6848\uff0c\u4f9b\u68ee\u6797\u4fdd\u536b\u8005\u5b9a\u4f4d\u3001\u8bb0\u5f55\u548c\u63ed\u9732\u5f53\u5730\u975e\u6cd5\u7684\u68ee\u6797\u780d\u4f10\u3002\u4e3b\u8981\u529f\u80fd\u5305\u62ec\u4e0b\u8f7d\u68ee\u6797\u53d8\u5316\u8b66\u62a5\u3001\u6536\u96c6\u73b0\u573a\u6570\u636e\u3001\u7ba1\u7406\u56e2\u961f\u548c\u5171\u4eab\u62a5\u544a\u3002&nbsp;&nbsp;&nbsp;\u6211\u4eec\u5f88\u9ad8\u5174\u5728\u6b64\u5206\u4eab\u5bf9 Forest Watcher \u7b2c 3 \u7248\u7684\u66f4\u65b0\uff0c\u5176\u4e2d\u5305\u62ec\u4ee4\u4eba\u5174\u594b\u7684\u65b0\u529f\u80fd [...]", "bec3ea09ab267b6232b1f7c3bc5d0fa8": "Forest Watcher \u5173\u952e\u5b9a\u4e49", "dc2baaf99d4f3fe55edabe3a41c21ad5": "Forest Watcher \u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u652f\u6301\u79bb\u7ebf\u4f7f\u7528\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u8b66\u62a5\uff0c\u60a8\u53ef\u4ee5\u5728\u73b0\u573a\u76f4\u63a5\u901a\u8fc7\u667a\u80fd\u624b\u673a\u76d1\u63a7\u548c\u7ba1\u7406\u68ee\u6797\u3002\u4f7f\u7528\u6b64\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\uff0c\u53ef\u4ee5\u8bbe\u7f6e\u611f\u5174\u8da3\u7684\u533a\u57df\u3001\u4e0b\u8f7d\u548c\u5bfc\u822a\u5230\u8b66\u62a5\u3001\u81ea\u5b9a\u4e49\u5e95\u56fe\u3001\u8ddf\u8e2a\u60a8\u7684\u8def\u7ebf\u4ee5\u53ca\u8c03\u67e5\u548c\u62a5\u544a\u53d1\u73b0\u7684\u5185\u5bb9\uff0c\u5373\u4f7f\u6ca1\u6709\u4e92\u8054\u7f51\u4e5f\u53ef\u4ee5\u505a\u5230\u3002\u60a8\u4e5f\u53ef\u4ee5\u901a\u8fc7\u7535\u8111\u5728\u7ebf\u8bbf\u95ee Forest Watcher Web\uff0c\u4ee5\u83b7\u5f97\u66f4\u591a\u9009\u62e9\u3002&nbsp;", "d0cf1d838714c15b85834249c9aa75d6": "\u7ba1\u5236\u68ee\u6797\u7279\u8bb8\u533a", "18d0862663309b0d5598217bb68a7644": "<strong>\u8def\u7ebf\uff1a</strong>\u7528\u6237\u7684\u79fb\u52a8\u8bbe\u5907\u5bfc\u822a\u5230\u5730\u56fe\u4e0a\u7684\u7279\u5b9a\u8b66\u62a5\u6216\u533a\u57df\u65f6\u6240\u8bb0\u5f55\u4e0b\u7684 GPS \u8f68\u8ff9\u3002\u53ea\u6709\u5728\u7528\u6237\u901a\u8fc7\u5176\u79fb\u52a8\u8bbe\u5907\u8868\u793a\u540c\u610f\u7684\u60c5\u51b5\u4e0b\uff0c\u624d\u4f1a\u8bb0\u5f55\u57fa\u4e8e\u7528\u6237\u4f4d\u7f6e\u7684\u8def\u7ebf\u3002\u53ef\u4ee5\u5728 FW Mobile \u6216 FW Web \u4e2d\u67e5\u770b\u8def\u7ebf\u3002", "4c557dd76b87564fd62cf2d4a3ae1270": "<strong>\u5e95\u56fe\uff1a</strong>\u4e00\u79cd\u53c2\u8003\u5730\u56fe\uff0c\u63d0\u4f9b\u5168\u7403\u8303\u56f4\u5185\u6709\u5173\u57fa\u672c\u7279\u5f81\u3001\u653f\u6cbb\u8fb9\u754c\u548c\u57fa\u7840\u8bbe\u65bd\u7684\u4fe1\u606f\u3002\u8fd9\u79cd\u7c7b\u578b\u7684\u5730\u56fe\u4f4d\u4e8e\u5176\u4ed6\u5730\u7406\u6570\u636e\u5c42\u4e0b\u65b9\uff0c\u4f8b\u5982 FW \u5730\u56fe\u4e0a\u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u548c\u60c5\u5883\u6570\u636e\u5c42\u3002", "d99e14ea4a6d22127a6ad168c3a57c09": "<strong>\u6a21\u677f\uff1a</strong>\u7528\u4e8e\u521b\u5efa\u65b0\u62a5\u544a\u7684\u8868\u5355\u3002 FW Mobile \u4e2d\u6709\u4e24\u4e2a\u9ed8\u8ba4\u6a21\u677f\u53ef\u7528\u3002\u9664\u4e86\u9ed8\u8ba4\u6a21\u677f\u5916\uff0c\u7528\u6237\u53ef\u4ee5\u7528 FW Web \u521b\u5efa\u65e0\u9650\u6570\u91cf\u7684\u81ea\u5b9a\u4e49\u6a21\u677f\u3002\u6a21\u677f\u53ef\u4ee5\u5305\u62ec\u4ee5\u4e0b\u95ee\u9898\u7c7b\u578b\uff1a&nbsp;", "02ef17ec822bbd66b330c4c58cd94849": "<strong>\u56fe\u7247</strong>\uff1a\u6839\u636e\u9884\u5148\u786e\u5b9a\u7684\u6743\u9650\uff0c\u7528\u6237\u53ef\u4e0a\u4f20 1-10 \u5f20\u56fe\u7247\u3002\u8bf7\u6ce8\u610f\uff0c\u53ef\u4ee5\u5728\u540c\u4e00\u62a5\u544a\u6a21\u677f\u4e2d\u591a\u6b21\u6dfb\u52a0\u6b64\u95ee\u9898\u7c7b\u578b\u3002&nbsp;", "676ccbffbe9cac6509833fb24693f98a": "<strong>\u56e2\u961f\uff1a</strong>\u4e00\u7ec4\u7279\u5b9a\u7684\u7528\u6237\uff0c\u4ed6\u4eec\u5728 Forest Watcher \u4e2d\u5171\u4eab\u611f\u5174\u8da3\u7684\u9886\u57df\u3001\u6a21\u677f\u3001\u4efb\u52a1\u548c\u62a5\u544a\u3002\u56e2\u961f\u6210\u5458\u5206\u522b\u62c5\u5f53\u7ba1\u7406\u5458\u3001\u7ecf\u7406\u6216\u76d1\u5bdf\u5458\u89d2\u8272\u3002\u4e0b\u8868\u5b9a\u4e49\u4e86\u8fd9\u4e9b\u89d2\u8272\u7684\u6743\u9650\uff1a&nbsp;", "3e2d087d6a9072de5bd5db63e3a0cdea": "<strong>\u4efb\u52a1\uff1a</strong>\u7528\u6237\u9700\u8981\u8c03\u67e5\u7684\u7279\u5b9a\u8b66\u62a5\u3001\u591a\u4e2a\u8b66\u62a5\u6216\u533a\u57df\u3002\u53ef\u5728 FW Web \u4e2d\u521b\u5efa\u4efb\u52a1\uff0c\u5e76\u663e\u793a\u5728 FW Mobile \u4e2d\u3002\u7528\u6237\u901a\u8fc7\u521b\u5efa\u6709\u5173\u8be5\u8b66\u62a5\u6216\u533a\u57df\u7684\u62a5\u544a\u5373\u53ef\u5b8c\u6210\u4efb\u52a1\u3002", "accf4302b9a99fc979548046e5737bd9": "<strong>Shapefile</strong>\uff1a\u4e00\u79cd\u77e2\u91cf\u6570\u636e\u6587\u4ef6\u683c\u5f0f\uff0c\u7528\u4e8e\u5b58\u50a8\u611f\u5174\u8da3\u533a\u57df\u7684\u7a7a\u95f4\u4fe1\u606f\uff08\u5730\u7406\u8981\u7d20\u7684\u4f4d\u7f6e\u3001\u51e0\u4f55\u548c\u5c5e\u6027\u4fe1\u606f\uff09\u3002&nbsp;&nbsp;", "84d520074107cba54f263724a7cb1374": "<strong>GeoJSON</strong>\uff1a\u4e00\u9879\u5f00\u653e\u6807\u51c6\u7684\u5730\u7406\u7a7a\u95f4\u6570\u636e\u683c\u5f0f\uff0c\u6807\u793a\u5730\u7406\u7279\u5f81\u53ca\u5176\u975e\u7a7a\u95f4\u5c5e\u6027\u3002&nbsp;", "5acc36b94b294fa390663cbf8baf89f4": "<strong>CSV</strong>\uff1a\u4e00\u79cd\u9017\u53f7\u5206\u9694\u503c\u6587\u4ef6\u683c\u5f0f\uff0c\u5c06\u6570\u636e\u7f6e\u4e8e\u8868\u7ed3\u6784\u5f62\u5f0f\u4e2d\u3002 &nbsp;", "2dbd5719890d20422479d16bf22c3a76": "<strong>FW \u5305\uff1a</strong>\u4e00\u79cd\u5141\u8bb8\u7528\u6237\u5c06\u6570\u636e\uff08\u533a\u57df\u3001\u8b66\u62a5\u3001\u8def\u7ebf\u3001\u4efb\u52a1\u548c\u62a5\u544a\uff09\u5bfc\u5165 FW Mobile \u7684\u6587\u4ef6\u683c\u5f0f\u3002FW \u6570\u636e\u5305\u53ef\u4ee5\u5728 FW Web \u6216 FW Mobile \u4e2d\u521b\u5efa\uff0c\u4f46\u53ea\u80fd\u5bfc\u5165\u5230 FW Mobile\u3002&nbsp;", "4818db157cde0ca7f180829c019946b7": "\u5982\u679c\u662f\u5728\u79bb\u7ebf\u72b6\u6001\u4e0b\u5b8c\u6210\u4efb\u52a1\u7684\uff0c\u8bf7\u52a1\u5fc5\u5728\u518d\u6b21\u8fde\u7ebf\u65f6\u624b\u52a8\u5c06\u76f8\u5173\u62a5\u544a\u4e0a\u4f20\u5230 Forest Watcher Web\u3002&nbsp;", "37eb85ef676508108981c1f6b74ad62e": "2. \u5728\u6807\u6709\u201c\u5b8c\u6210\uff08\u672a\u540c\u6b65\u5230 FW Web\uff09\u201d\u7684\u5730\u65b9\uff0c\u70b9\u51fb\u5176\u4e2d\u7684\u4e00\u4e2a\u62a5\u544a\u3002&nbsp;", "458c5e2dd38b1f585e099301be728a71": "3. \u70b9\u51fb\u9875\u9762\u53f3\u4e0a\u89d2\u7684\u5411\u4e0a\u7bad\u5934\u56fe\u6807\u3002&nbsp;", "e5895fe7db3c5113771f2c8f748f95f4": "4. \u70b9\u51fb\u6807\u6709\u201c\u4e0a\u4f20\u201d\u7684\u6309\u94ae\u3002&nbsp;", "6b873a5139ddae64eae56c6b18b0273a": "Forest Watcher \u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u652f\u6301\u79bb\u7ebf\u4f7f\u7528\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u8b66\u62a5\uff0c\u60a8\u53ef\u4ee5\u5728\u73b0\u573a\u76f4\u63a5\u901a\u8fc7\u667a\u80fd\u624b\u673a\u76d1\u63a7\u548c\u7ba1\u7406\u68ee\u6797\u3002\u4f7f\u7528\u6b64\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\uff0c\u53ef\u4ee5\u8bbe\u7f6e\u611f\u5174\u8da3\u7684\u533a\u57df\u3001\u4e0b\u8f7d\u548c\u5bfc\u822a\u5230\u8b66\u62a5\u3001\u81ea\u5b9a\u4e49\u5e95\u56fe\u3001\u8ddf\u8e2a\u60a8\u7684\u8def\u7ebf\u4ee5\u53ca\u8c03\u67e5\u548c\u62a5\u544a [\u2026]", "9fe9dbc5a1bb48fcdf8884a8d4d343ec": "<strong>\u611f\u5174\u8da3\u533a\u57df (AOI)\uff1a</strong>\u7528\u6237\u5b9a\u4e49\u7684\u5730\u7406\u8fb9\u754c\uff0c\u663e\u793a\u7528\u6237\u6b63\u5728\u76d1\u6d4b\u68ee\u6797\u7834\u574f\uff08\u4f8b\u5982\u68ee\u6797\u780d\u4f10\u6216\u706b\u707e\u8b66\u62a5\uff09\u7684\u5730\u57df\u3002\u901a\u8fc7\u76f4\u63a5\u5728\u5730\u56fe\u4e0a\u7ed8\u5236\u6216\u4e0a\u4f20\u5730\u7406\u7a7a\u95f4\u6587\u4ef6\uff0c\u7528\u6237\u53ef\u4ee5\u5728 Global Forest Watch (GFW) Map\u3001Forest Watch (FW) Mobile \u6216 Web \u4e2d\u521b\u5efa\u611f\u5174\u8da3\u7684\u533a\u57df\u3002&nbsp;\u5728 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">globalforestwatch.org</a> \u4e0a\u521b\u5efa\u7684\u81ea\u5b9a\u4e49\u611f\u5174\u8da3\u533a\u57df\u4f1a\u81ea\u52a8\u663e\u793a\u5728\u7528\u6237\u7684 FW \u8d26\u6237\u4e2d\u3002&nbsp;", "60764d15050633b126cf2c3efce3c8fd": "<strong>\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u8b66\u62a5</strong>\u662f\u63a5\u8fd1\u5b9e\u65f6\u7684\u8b66\u62a5\uff0c\u4f7f\u7528\u56db\u79cd\u8b66\u62a5\u7cfb\u7edf\u76d1\u6d4b\u68ee\u6797\u7834\u574f\uff1a&nbsp;", "33d4319d9e47540d2936403ddfcc7603": "<strong>GLAD-L</strong> \u68ee\u6797\u780d\u4f10\u8b66\u62a5\u6bcf 8 \u5929\u66f4\u65b0\u4e00\u6b21\uff0c\u5206\u8fa8\u7387\u4e3a 30-meter\uff0c\u5e94\u7528\u4e8e\u70ed\u5e26\u5730\u533a\uff08\u4ece\u5317\u7eac 30\u00b0 \u5230\u5357\u7eac 30\u00b0\uff09\u3002 &nbsp;", "d72ce8cb0fe576f7526102653bcc3023": "<strong>GLAD-S2</strong> \u68ee\u6797\u780d\u4f10\u8b66\u62a5\u6bcf 5 \u5929\u66f4\u65b0\u4e00\u6b21\uff0c\u5206\u8fa8\u7387\u4e3a 10-meter\uff0c\u5e94\u7528\u4e8e\u5357\u7f8e\u6d32\uff08\u4e9a\u9a6c\u900a\u76c6\u5730\uff09\u7684\u4e3b\u8981\u6f6e\u6e7f\u70ed\u5e26\u68ee\u6797\u5730\u533a\uff0c &nbsp;", "5cbb0346d6a948db4751766f9b5cfc0d": "<strong>GFW \u60c5\u5883\u6570\u636e\u5c42</strong>\uff1a\u5305\u62ec\u53ef\u4ee5\u5728\u5730\u56fe\u4e0a\u663e\u793a\u7684\u6570\u636e\u5c42\uff0c\u4ee5\u4fbf\u63d0\u4f9b\u5173\u4e8e\u5b9e\u5730\u53d1\u751f\u7684\u4e8b\u60c5\u7684\u66f4\u591a\u80cc\u666f\u4fe1\u606f\u3002\u53ef\u5728 FW \u4e2d\u663e\u793a\u7684 GFW \u60c5\u5883\u6570\u636e\u5c42\u5305\u62ec\uff1a &nbsp;", "5deb012f2fc1376618b7ec09cca47c19": "<strong>VIIRS</strong> <strong>\u6d3b\u8dc3\u706b\u707e\u8b66\u62a5</strong>\u63a5\u8fd1\u5b9e\u65f6\u5730\u68c0\u6d4b\u706b\u707e\u4f4d\u7f6e\uff0c\u6bcf\u5929\u5728\u5168\u7403\u8303\u56f4\u5185\u66f4\u65b0\u4e24\u6b21\uff0c\u5206\u8fa8\u7387\u4e3a 375-meter\u3002 &nbsp;", "9a3989063726a8cbdebb5098ca6ab83d": "\u751f\u7269\u591a\u6837\u6027\u5b8c\u6574\u6027&nbsp;", "16021c374ff452010e08f5283eb82cea": "\u751f\u7269\u591a\u6837\u6027\u91cd\u8981\u6027&nbsp;", "5c5132ad121972973d5ee873a86b1718": "\u571f\u8457\u548c\u793e\u533a\u571f\u5730&nbsp;", "9b3f2606b7ee6dbf2e1d61