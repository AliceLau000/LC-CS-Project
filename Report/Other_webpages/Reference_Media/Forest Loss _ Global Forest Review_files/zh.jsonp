e6649": "<strong>\u89e3\u538b\u7f29</strong>: .csv\u3001.json\u3001.geojson\u3001.kml\u3001.kmz \uff08.csv \u6587\u4ef6\u5fc5\u987b\u6709\u4e00\u4e2ageom \u5217\uff0c\u5176\u4e2d\u5305\u542b\u8f6c\u6362\u4e3a\u719f\u77e5\u6587\u672c WKT \u683c\u5f0f\u7684\u5f62\u72b6\u6570\u636e\uff09\u3002&nbsp;", "cb7b9d64a9ee8f01ce9ad1196012501e": "\u5982\u679c\u60a8\u5c06\u5173\u6ce8\u533a\u57df\u4fdd\u5b58\u4e3a\u5730\u7406\u7a7a\u95f4\u6587\u4ef6\uff0c\u5219\u53ef\u4ee5\u5c06\u5176\u4e0a\u4f20\u6765\u521b\u5efa\u533a\u57df\uff0c\u4ee5\u6b64\u4f5c\u4e3a\u533a\u57df\u7ed8\u5236\uff08\u4e0a\u9762\u7684\u6b65\u9aa4\uff1a\u7ed8\u5236\u4e00\u4e2a\u533a\u57df\uff09\u7684\u66ff\u4ee3\u65b9\u6cd5\u3002\u4ee5\u4e0b\u662f\u652f\u6301\u7684\u6587\u4ef6\u683c\u5f0f\u5217\u8868\uff1a&nbsp;", "ffd277e9ce214760863d23522354ef18": "\u82e5\u8981\u901a\u8fc7\u4e0a\u4f20\u5730\u7406\u7a7a\u95f4\u6587\u4ef6\u6765\u521b\u5efa\u5173\u6ce8\u533a\u57df\uff1a&nbsp;", "092e87e46e5b5d628c1a872140aa7493": "\u70b9\u51fb\u5730\u56fe\u4e0b\u65b9\u6807\u6709\u201c\u4e0a\u4f20\u5f62\u72b6\u6587\u4ef6\u201d\u7684\u6309\u94ae\u3002&nbsp;", "a3b9462ad2de4332b62ccf70acf794b5": "\u8fb9\u754c\u5f62\u72b6\u4fee\u6539\u5b8c\u6210\u540e\uff0c\u70b9\u51fb\u5730\u56fe\u4e0a\u5173\u6ce8\u533a\u57df\u5916\u7684\u4efb\u4f55\u4f4d\u7f6e\u3002\u60a8\u4f1a\u770b\u5230\u70b9\u6d88\u5931\u4e0d\u89c1\uff0c\u4f46\u4ee3\u8868\u8fb9\u754c\u7684\u5b9e\u7ebf\u5c06\u4f1a\u4fdd\u7559\u4e0b\u6765\u3002&nbsp;", "c00365cea30e49d84d9702e686902d61": "\u7f16\u8f91\u6216\u5220\u9664\u73b0\u6709\u533a\u57df", "f2f15f19a55de06d835bfcae4f0fe527": "\u9996\u5148\uff0c\u6267\u884c\u4ee5\u4e0b\u4e00\u9879\u64cd\u4f5c\uff0c\u4ee5\u663e\u793a\u533a\u57df\u8fb9\u754c\u7684\u5404\u4e2a\u70b9\uff1a&nbsp;", "6ec878bbe615614fb8ce2402b9a67830": "\u4fee\u6539\u533a\u57df\u7684\u5f62\u72b6", "bf50547ad96ef2f8953abe75564428e7": "\u70b9\u51fb\u5730\u56fe\u53f3\u4e0b\u89d2\u6807\u6709\u201c\u7f16\u8f91\u201d\u7684\u6309\u94ae\u3002&nbsp;", "4a6f54cf0e69e1fea2eafb70891d7679": "\u8981\u8c03\u6574\u73b0\u6709\u8fb9\u754c\u70b9\uff0c\u70b9\u51fb\u8be5\u8fb9\u754c\u70b9\u5e76\u5c06\u5176\u62d6\u52a8\u5230\u65b0\u4f4d\u7f6e\u3002&nbsp;", "0f0dbeec316452718cc71a1308b5e8f2": "\u8981\u5220\u9664\u6574\u4e2a\u5173\u6ce8\u533a\u57df\u5e76\u91cd\u65b0\u5f00\u59cb\u786e\u5b9a\u8fb9\u754c\uff0c\u70b9\u51fb\u5730\u56fe\u53f3\u4e0b\u89d2\u6807\u6709\u201c\u5220\u9664\u201d\u7684\u6309\u94ae&nbsp;", "0bc51e1b21b8d16d1d42beb4edc8aa1b": "\u7ed9\u533a\u57df\u547d\u540d\u5e76\u4fdd\u5b58", "3e024e0d6ba242d822d5b8ba4944d536": "\u5bfc\u822a\u5230\u201c\u533a\u57df\u201d\u9875\u9762\uff08\u8bf7\u53c2\u9605\u7b2c 1 \u6b65\uff09\u3002&nbsp;", "fcaf02c78fb164e8a56479fba5954b26": "\u5411\u4e0b\u6eda\u52a8\u9875\u9762\uff0c\u5728\u5730\u56fe\u4e0b\u65b9\u53ef\u770b\u5230\u4e00\u7ec4\u4ee3\u8868\u6bcf\u4e2a\u533a\u57df\u7684\u4e00\u4e2a\u6216\u591a\u4e2a\u65b9\u6846\u3002&nbsp;", "423304d094f005d27f096ec3e2fce39e": "\u627e\u5230\u60a8\u5173\u6ce8\u533a\u57df\u5bf9\u5e94\u7684\u65b9\u6846\uff0c\u7136\u540e\u70b9\u51fb\u6807\u6709\u201c\u7ba1\u7406\u201d\u7684\u6309\u94ae\u3002&nbsp;&nbsp;", "c3e1de268421adbc02b97a542866c196": "\u8981\u7f16\u8f91\u533a\u57df\u7684\u540d\u79f0\u6216\u8fb9\u754c\uff0c\u8bf7\u540c\u6837\u6309\u7167\u4e0a\u9762\u7b2c 5-6 \u6b65\u4e2d\u7684\u6307\u793a\u64cd\u4f5c\u3002&nbsp;", "86de30b9a965194cb63ea3351ddb15f9": "1. \u5982\u679c\u60a8\u77e5\u9053\u5173\u6ce8\u533a\u57df\u7684\u5730\u5740\u6216\u7eac\u5ea6/\u7ecf\u5ea6\uff0c\u8bf7\u70b9\u51fb\u5730\u56fe\u53f3\u4e0a\u89d2\u5e26\u6709\u653e\u5927\u955c\u56fe\u6807\u7684\u6309\u94ae\u3002\u8fd9\u5c06\u663e\u793a\u4e00\u4e2a\u8868\u5355\uff0c\u60a8\u53ef\u4ee5\u7528\u5b83\u5728\u5730\u56fe\u4e0a\u641c\u7d22\u6b63\u786e\u7684\u4f4d\u7f6e\u3002\u60a8\u8fd8\u53ef\u4ee5\u4f7f\u7528\u6b64\u83dc\u5355\u5bfc\u822a\u5230\u7279\u5b9a\u56fd\u5bb6/\u5730\u533a\u3002&nbsp;", "de06d3723f7a17ebfef431f110d25f71": "\u60a8\u4f1a\u770b\u5230\u4e00\u6761\u6d88\u606f\uff0c\u63d0\u793a\u60a8\u521b\u5e