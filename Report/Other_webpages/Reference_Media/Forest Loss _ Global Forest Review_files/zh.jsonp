<strong>Download Method</strong>\uff08\u4e0b\u8f7d\u65b9\u6cd5\uff09\uff0c\u7136\u540e\u6309 <strong>Done</strong>\uff08\u5b8c\u6210\uff09\u3002", "a2af529e925305071cd95a281959846e": "1. \u524d\u5f80 <strong>Monitoring</strong>\uff08\u76d1\u6d4b\uff09\u9009\u9879\u5361\uff0c\u5207\u6362\u5230 <strong>Assignments</strong>\uff08\u4efb\u52a1\uff09\u5c4f\u5e55\u3002", "3df29a8a66302edc617d3a53f7f558b9": "2. \u8981\u5bfc\u51fa\u6240\u6709\u4efb\u52a1\uff0c\u8bf7\u6309\u7b5b\u9009\u6761\u4ef6\u4e0a\u65b9\u7684 <strong>Export All</strong>\uff08\u5168\u90e8\u5bfc\u51fa\uff09\u6309\u94ae\u3002", "f5f31f2c8329cb95b4799bb0717e4ecb": "3. \u8981\u5bfc\u51fa\u9009\u62e9\u7684\u62a5\u544a\uff0c\u8bf7\u5355\u51fb\u8868\u683c\u4e2d\u4e00\u4e2a\u6216\u591a\u4e2a\u62a5\u544a\u65c1\u8fb9\u7684\u590d\u9009\u6846\uff0c\u7136\u540e\u6309 <strong>Export Selected</strong>\uff08\u5bfc\u51fa\u9009\u5b9a\u9879\uff09\u6309\u94ae\u3002", "c51ae6712d403da315cd82638b4d1462": "4<strong>. \u9009\u62e9</strong> <strong>File Type </strong>\uff08\u6587\u4ef6\u7c7b\u578b\uff09\uff0c\u5176\u4e2d\u5305\u62ec CSV\u3001GeoJson\u3001SHP \u6216 FW Bundle \u7b49\u7c7b\u578b\u3002", "b195ad76a835f852fa4cc616062e18bf": "\u5bfc\u51fa\u62a5\u544a\u548c\u62a5\u544a\u56fe\u50cf", "66cb98b4dd26ab9193e0f1dbffc5afe9": "\u524d\u5f80 Settings\uff08\u8bbe\u7f6e\uff09\u5c4f\u5e55", "630e9011c667992937a33946f3521ff1": "\u5728\u4e3b\u83dc\u5355\u4e2d\u70b9\u51fb Settings\uff08\u8bbe\u7f6e\uff09\u6309\u94ae\u3002", "546cfe187be8665db01832f688e10ca7": "\u66f4\u6539\u5750\u6807\u683c\u5f0f", "e299163d7eb30933c786c804e11a3af7": "6. \u6309 <strong>Download</strong>\uff08\u4e0b\u8f7d\uff09\u6309\u94ae\u3002", "a0c0f7b4bbf59cd336084ffe115ad535": "7. \u8981\u4e0b\u8f7d\u5355\u4e2a\u62a5\u544a\u56fe\u50cf\uff0c\u8bf7\u5355\u51fb\u56fe\u50cf\u53f3\u4e0a\u65b9\u7684 <strong>download</strong>\uff08\u4e0b\u8f7d\uff09\u56fe\u6807\u3002", "20a2b2aa392ff698644807ba70d360d5": "\u5728\u6b64\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a", "13bf2ba8b95cdc9b911afbfdd3c6ab58": "\u5982\u4f55\u8fdb\u5165\u79bb\u7ebf\u6a21\u5f0f\u3002", "7fd69ae7e732569b6e553f7be714ac2c": "MyGFW \u8d26\u6237\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5982\u679c\u60a8\u6ca1\u6709\u8d26\u6237\uff0c\u8bf7\u524d\u5f80\u6b64\u9875\u9762\u6ce8\u518c</a>\u3002", "8b364f96ef0be7abe0897683687ec6c7": "\u5982\u4f55\u67e5\u9605\u6709\u5173 Forest Watcher \u7684\u66f4\u591a\u4fe1\u606f\u3002", "dd9c73f0981bb135d872c21fc6c4da7e": "Forest Watcher Mobile \u5411\u7528\u6237\u63d0\u4f9b\u591a\u4e2a\u9009\u9879\u6765\u5b9a\u5236\u5e94\u7528\u7a0b\u5e8f\u7684\u4f7f\u7528\u4f53\u9a8c\u3002", "14f1d2ca0f91d172eb90c9565a099407": "\u767b\u5f55 Forest Watcher Mobile", "c3084bdb754bffc930ae65dca0907cf7": "1. \u5728\u60a8\u7684\u79fb\u52a8\u8bbe\u5907\u4e0a\u6253\u5f00 Forest Watcher\u3002", "dd3edd126535e6e25d97a8d7ae027c41": "2. \u4f7f\u7528\u60a8\u7684 MyGFW \u8d26\u6237\u767b\u5f55\u3002", "17732e10a7c611c5d8744ed7f4a1d0dd": "\u70b9\u51fb Coordinates Format\uff08\u5750\u6807\u683c\u5f0f\uff09\u680f\u4e0b\u65b9\u7684\u6309\u94ae\u3002", "239bf96ed15e969fab91b7e183c1295d": "\u70b9\u51fb Done\uff08\u5b8c\u6210\uff09\u6309\u94ae\u3002", "745ecaa3f3be8d7b51227d5b117b8603": "\u60a8\u5c06\u5728 Custom Basemaps\uff08\u81ea\u5b9a\u4e49\u5e95\u56fe\uff09\u680f\u4e2d\u770b\u5230\u60a8\u7684\u5e95\u56fe\u3002", "9b2351e36ef439f54ec4b686ec876d5c": "\u5c06\u60a8\u7684\u5e95\u56fe\u6dfb\u52a0\u5230\u5730\u56fe\u4e2d", "54e87c59fd6531babda88d55dceca980": "\u4ece\u83dc\u5355\u4e2d\u9009\u62e9\u60a8\u7684\u67d0\u4e2a\u5173\u6ce8\u533a\u57df\u3002", "636620fbe4651fc76d8e57010d56290c": "\u5728\u4e3b\u83dc\u5355\u4e2d\uff0c\u70b9\u51fb Areas\uff08\u533a\u57df\uff09\u6309\u94ae\u3002", "17f463fc9c31b9b997e23c83a09d98be": "\u5728\u5730\u56fe\u4e2d\uff0c\u70b9\u51fb\u5c4f\u5e55\u53f3\u4e0a\u65b9\u7684\u9f7f\u8f6e\u56fe\u6807\u3002", "89f3d98fe37ec7f0cbb5198b4c4fabe1": "\u5728\u56fe\u5c42\u83dc\u5355\u4e2d\uff0c\u70b9\u51fb Basemap Satellite\uff08\u5e95\u56fe\u536b\u661f\uff09\u6309\u94ae\u3002", "fb54abd61ee09f19ecd9af5eaa5c4a2a": "\u5728 Custom Basemaps\uff08\u81ea\u5b9a\u4e49\u5e95\u56fe\uff09\u680f\u4e2d\u627e\u5230\u60a8\u7684\u5e95\u56fe\uff0c\u7136\u540e\u70b9\u51fb\u6b64\u5e95\u56fe\u5c06\u5176\u6dfb\u52a0\u5230\u5730\u56fe\u4e2d\u3002", "50be4523e4749c2c0a43b3c12b799435": "\u4e0a\u4f20\u81ea\u5b9a\u4e49\u5173\u8054\u56fe\u5c42", "8b3a52b45273cb2282688b4717606c38": "\u70b9\u51fb\u5c4f\u5e55\u5de6\u4e0a\u65b9\u7684\u5411\u5de6\u7bad\u5934\u4e24\u6b21\u4ee5\u8fd4\u56de\u5230\u5730\u56fe", "bc988294eebaea37699839e46f13827f": "\u70b9\u51fb Contextual Layers\uff08\u5173\u8054\u56fe\u5c42\uff09\u6309\u94ae\u3002", "68c2973d503eca4fcbce12082f3bba67": "\u70b9\u51fb Custom Contextual Layer\uff08\u81ea\u5b9a\u4e49\u5173\u8054\u56fe\u5c42\uff09\u6309\u94ae\u3002", "e2cb664fa07405aa75337265cdbbf1a7": "\u6728\u7ea4\u7ef4\u7279\u8bb8\u6743", "45cd5798de0a1464786411d969cb4df5": "\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u627e\u5230\u60a8\u7684\u5173\u8054\u56fe\u5c42\u6587\u4ef6\uff0c\u7136\u540e\u70b9\u51fb\u9009\u62e9\u8be5\u6587\u4ef6\u3002", "eabb40b66773efe1622d356fd2903e5a": "\u5728\u56fe\u5c42\u83dc\u5355\u4e2d\uff0c\u5728 Contextual Layers\uff08\u5173\u8054\u56fe\u5c42\uff09\u680f\u4e2d\u70b9\u51fb\u7070\u8272\u5706\u5708\u3002\u60a8\u5c06\u770b\u5230\u8be5\u5706\u5708\u53d8\u6210\u5e26\u5bf9\u52fe\u6807\u8bb0\u7684\u7eff\u8272\u5706\u5708\u3002", "f3f25925ad607f873f6c16403ce9513f": "\u5728Custom Layers\uff08\u81ea\u5b9a\u4e49\u56fe\u5c42\uff09\u680f\u4e2d\u627e\u5230\u60a8\u7684\u56fe\u5c42\uff0c\u7136\u540e\u70b9\u51fb\u6b64\u56fe\u5c42\u5c06\u5176\u6dfb\u52a0\u5230\u5730\u56fe\u4e2d\u3002", "4aadacfa520c1dfd6a066670406e0334": "\u70b9\u51fb\u5c4f\u5e55\u5de6\u4e0a\u65b9\u7684\u5411\u5de6\u7bad\u5934\u4e24\u6b21\u4ee5\u8fd4\u56de\u5230\u5730\u56fe\u3002", "a3b51cffe5d07d0c0308a6ede5c11e2d": "\u5982\u4f55\u5728 Forest Watcher Web \u4e2d\u4e3a\u76d1\u6d4b\u56e2\u961f\u9009\u62e9\u5173\u8054\u56fe\u5c42", "f6e441919ad1390072a64be4f4941ceb": "\u5173\u8054\u56fe\u5c42\u662f\u53ef\u5728\u5730\u56fe\u4e0a\u53ef\u89c6\u5316\u7684\u6570\u636e\u96c6\uff0c\u7528\u4e8e\u63d0\u4f9b\u8ddf\u5730\u9762\u4e0a\u53d1\u751f\u7684\u4e8b\u60c5\u6709\u5173\u7684\u989d\u5916\u5173\u8054\u80cc\u666f\u4fe1\u606f\u3002\u9ed8\u8ba4\u60c5\u51b5\u4e0b\uff0c\u7528\u6237\u53ef\u4ee5\u5728 Forest Watcher Web \u548c Forest Watcher Mobile \u4e2d\uff0c\u5c06\u5c55\u793a\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u51cf\u5c11\u53ca\u53d7\u4fdd\u62a4\u533a\u57df\u7684\u5173\u8054\u56fe\u5c42\u6dfb\u52a0\u5230\u5730\u56fe\u4e2d\u3002", "98069b6bbca33c89239c23f37f634881": "\u56e2\u961f\u8d1f\u8d23\u4eba\u53ef\u4ee5\u9009\u62e9\u81ea\u52a8\u5141\u8bb8\u5176\u76d1\u6d4b\u56e2\u961f\u8bbf\u95ee 1-3 \u4e2a\u975e\u9ed8\u8ba4\u56fe\u5c42\u3002\u76d1\u6d4b\u8005\u59cb\u7ec8\u53ef\u4ee5\u9009\u62e9\u81ea\u5df1\u6dfb\u52a0\u8fd9\u4e9b\u56fe\u5c42\uff0c\u4f46\u56e2\u961f\u8d1f\u8d23\u4eba\u6267\u884c\u6b64\u64cd\u4f5c\u901a\u5e38\u66f4\u4e3a\u65b9\u4fbf\uff0c\u4ece\u800c\u53ef\u4ee5\u8ba9\u76d1\u6d4b\u8005\u5c06\u5de5\u4f5c\u91cd\u5fc3\u653e\u5728\u62a5\u544a\u4e0a\u3002\u4e0b\u9762\u662f GFW \u63d0\u4f9b\u7684\u56fe\u5c42\u5217\u8868\uff0c\u53ef\u5c06\u8fd9\u4e9b\u56fe\u5c42\u63d0\u4f9b\u7ed9\u60a8\u7684\u56e2\u961f\uff1a", "8b81366748a6e10ad0af0ba85b1fd49a": "\u6258\u7ba1\u68ee\u6797\u7279\u8bb8\u6743", "369be84fb01c4af8d52002faacac5bba": "\u5728 Layers\uff08\u56fe\u5c42\uff09\u9875\u9762\u4e0a\uff0c\u5411\u4e0b\u6eda\u52a8\u5230 Team Layers\uff08\u56e2\u961f\u56fe\u5c42\uff09\u680f\u3002", "0b6a9ea10bb3a394de03f615a71928fa": "\u627e\u5230\u60a8\u7684\u56e2\u961f\u7684\u540d\u79f0\uff0c\u7136\u540e\u5355\u51fb Edit\uff08\u7f16\u8f91\uff09\u6309\u94ae\u3002", "db232017efbabd9e87d3781a381aa1f6": "\u627e\u5230\u60a8\u5e0c\u671b\u60a8\u7684\u56e2\u961f\u80fd\u8bbf\u95ee\u7684\u56fe\u5c42\uff0c\u7136\u540e\u5355\u51fb\u590d\u9009\u6846\u5c06\u5176\u9009\u4e2d\u3002\u8bf7\u786e\u4fdd\u56fe\u5c42\u540d\u79f0\u53f3\u4fa7\u6709\u4e00\u4e2a\u7eff\u8272\u5bf9\u52fe\u6807\u8bb0\u3002\u8bf7\u6ce8\u610f\uff0c\u6700\u591a\u53ef\u4ee5\u9009\u62e9 3 \u4e2a\u56fe\u5c42\u3002", "34d4c71d928cca651ef83a1fde2f468f": "\u5355\u51fb Done\uff08\u5b8c\u6210\uff09\u6309\u94ae\u3002\u60a8\u5c06\u770b\u5230\u56fe\u5c42\u540d\u79f0\u51fa\u73b0\u5728\u56e2\u961f\u540d\u79f0\u4e0b\u65b9\u7684\u5217\u8868\u4e2d\u3002", "c452629067d8cd881eee80c4a68905fd": "\u5728 Forest Watcher Web \u4e2d\uff0c\u56e2\u961f\u6210\u5458\u5728 Monitoring\uff08\u76d1\u6d4b\uff09\u9875\u9762\u4e0a\u67e5\u770b\u56e2\u961f\u533a\u57df\u65f6\uff0c\u5730\u56fe\u63a7\u5236\u9762\u677f\u4e2d\u4f1a\u81ea\u52a8\u51fa\u73b0\u9009\u62e9\u7684\u5173\u8054\u56fe\u5c42\u3002", "fa3575aeffa62232cbb751214d77c96a": "2. \u5728 Forest Watcher Mobile \u4e2d\uff0c\u56e2\u961f\u6210\u5458\u5728\u67e5\u770b\u56e2\u961f\u533a\u57df\u65f6\uff0c\u56fe\u5c42\u63a7\u5236\u9762\u677f\u4e2d\u4f1a\u81ea\u52a8\u51fa\u73b0\u9009\u62e9\u7684\u5173\u8054\u56fe\u5c42\u3002", "e1cf9f8c4c0de39e93fdc6a4f4226008": "\u5728 Forest Watcher Web \u4e2d\u6709\u4e24\u79cd\u4e0d\u540c\u7684\u533a\u57df\u521b\u5efa\u65b9\u6cd5\uff1a\u7ed8\u5236\u8fb9\u754c\uff0c\u6216\u8005\u4e0a\u4f20\u5730\u7406\u7a7a\u95f4\u6587\u4ef6\u3002", "8fe756427bda2cb3fd1bc3ec263f2c45": "\u9010\u6b65\u8bf4\u660e", "bad68d6a9a2b86b9ef52fdc3f619d090": "\u524d\u5f80 Layers\uff08\u56fe\u5c42\uff09\u9875\u9762", "7281cc4ad4cc335d96ccd97507b7098a": "\u5bfc\u822a\u5230 Forest Watcher Web (<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">forestwatcher.globalforestwatch.org</a>)\u3002", "ed6a82f30f11ed5c0fdb3373fef9ba28": "\u5355\u51fb Access Web App\uff08\u8bbf\u95ee Web \u5e94\u7528\uff09\u6309\u94ae\uff0c\u7136\u540e\u4f7f\u7528\u60a8\u7684 MyGFW \u8d26\u6237\u767b\u5f55\u3002", "11f6648a5e6d90b543271afdbe8454e1": "\u4e3a\u60a8\u7684\u56e2\u961f\u6700\u591a\u9009\u62e9 3 \u4e2a\u5173\u8054\u56fe\u5c42", "0a30c9d728f332bd0f217fb230984094": "\u767b\u5f55\u540e\uff0c\u5355\u51fb\u9876\u90e8\u83dc\u5355\u680f\u4e2d\u7684 Layers\uff08\u56fe\u5c42\uff09\u6309\u94ae\u3002", "1a58e20c9f825ef9449d3995c35fba87": "\u5982\u4f55\u4fee\u6539\u548c\u5220\u9664\u533a\u57df\u3002", "e20420804384ab5287f9eda435074288": "\u8981\u5b8c\u6210\u6b64\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a", "391535c9845ad139a54788222810ed41": "\u7528\u6237\u53ef\u4ee5\u5728 Forest Watcher Mobile \u6216 Forest Watcher Web \u4e2d\u521b\u5efa\u5173\u6ce8\u533a\u57df\u3002\u5982\u679c\u56e2\u961f\u8d1f\u8d23\u4eba\u8981\u4e3a\u56e2\u961f\u51c6\u5907\u91ce\u5916\u8bbf\u95ee\u7684\u6570\u636e\u4ee5\u53ca\u7ba1\u7406\u591a\u4e2a\u533a\u57df\uff0c\u5728 Forest Watcher Web \u4e2d\u521b\u5efa\u533a\u57df\u662f\u5f88\u6709\u7528\u7684\u529f\u80fd\u3002\u5982\u679c\u8981\u5c06\u533a\u57df\u5b58\u50a8\u4e3a\u5730\u7406\u7a7a\u95f4\u6587\u4ef6\uff08\u4f8b\u5982\uff0cShapefile\u3001GeoJSON\u3001KML\uff09\uff0cForest Watcher Web \u4e5f\u662f\u4e0d\u9519\u7684\u9009\u62e9\uff0c\u56e0\u4e3a\u4e0e\u79fb\u52a8\u8bbe\u5907\u76f8\u6bd4\uff0c\u5728\u53f0\u5f0f\u673a\u4e0a\u7ba1\u7406\u8fd9\u4e9b\u6587\u4ef6\u901a\u5e38\u66f4\u52a0\u5bb9\u6613\u3002", "9b9939fc68fd8846180c1117ff3b3dcf": "\u524d\u5f80 Areas\uff08\u533a\u57df\uff09\u9875\u9762", "739bccabefdf93c22b01bfe29548deb2": "\u4f7f\u7528\u79bb\u7ebf\u6a21\u5f0f\u53ef\u963b\u6b62 Forest Watcher Mobile \u4e0e Forest Watcher Web \u4e4b\u95f4\u76f8\u4e92\u540c\u6b65\u6570\u636e\u3002\u5982\u679c\u60f3\u5ef6\u957f\u7535\u6c60\u7eed\u822a\u65f6\u95f4\uff0c\u9650\u5236\u6570\u636e\u4f20\u8f93\uff0c\u53ef\u4f7f\u7528\u6b64\u6a21\u5f0f\u3002", "0fcbd5ffb3fb103f9842bc07889f2e93": "\u8fdb\u5165\u79bb\u7ebf\u6a21\u5f0f", "cab2571e236c8e83adb371dcf270d7ec": "\u60a8\u5c06\u770b\u5230\uff0c\u5e94\u7528\u7a0b\u5e8f\u9876\u90e8\u7684\u6a2a\u5e45\u73b0\u5728\u53d8\u7070\u4e86\uff0c\u5e76\u663e\u793a Offline Mode\uff08\u79bb\u7ebf\u6a21\u5f0f\uff09\u6807\u7b7e\u3002", "5efe0a284fe8a3e90f0cd3edbbd2a1f7": "\u627e\u5230 About this app\uff08\u5173\u4e8e\u6b64\u5e94\u7528\uff09\u680f\u3002", "cc65bfaea76d9e2771b7766a55b516c7": "\u67e5\u9605\u6709\u5173 Forest Watcher \u7684\u66f4\u591a\u4fe1\u606f", "40d4d87b3b46271eb6074e0572634a67": "\u70b9\u51fb\u4e0e\u60a8\u5173\u6ce8\u7684\u4fe1\u606f\u5bf9\u5e94\u7684\u83dc\u5355\u9879\u3002", "d7dccd6fec652651eefe9f67ec738e3f": "\u5982\u4f55\u5c06\u81ea\u5b9a\u4e49\u5e95\u56fe\u4e0a\u4f20\u5230 Forest Watcher Mobile\u3002", "398035d2cbdccb5348f907d217cc7796": "\u5982\u4f55\u5c06\u81ea\u5b9a\u4e49\u5173\u8054\u56fe\u5c42\u4e0a\u4f20\u5230 Forest Watcher Mobile\u3002", "8ffc0988c506032840bf6912d64a6228": "Forest Watcher Mobile \u5141\u8bb8\u7528\u6237\u5c06\u81ea\u5b9a\u4e49\u5e95\u56fe\u548c\u5173\u8054\u56fe\u5c42\u76f4\u63a5\u4ece\u81ea\u5df1\u7684\u8bbe\u5907\u4e0a\u4f20\u5230\u5e94\u7528\u7a0b\u5e8f\uff0c\u4f9b\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u3002\u5982\u679c\u76d1\u6d4b\u8005\u60f3\u7528\u7279\u5b9a\u4e8e\u4f4d\u7f6e\u7684\u4fe1\u606f\u6765\u8865\u5145 GFW \u6570\u636e\uff0c\u53ef\u7528\u6b64\u65b9\u6cd5\u3002", "5a7695bbd9d0f4bc7fbf332e95e77a4b": "2. \u5355\u51fb Access Web App\uff08\u8bbf\u95ee Web \u5e94\u7528\uff09\u6309\u94ae\uff0c\u7136\u540e\u4f7f\u7528\u60a8\u7684 MyGFW \u8d26\u6237\u767b\u5f55\u3002", "e3d1405346ed06cef3c0b9a624a2d636": "4. \u6b64\u9875\u9762\u9876\u90e8\u6709\u4e00\u4e2a\u5730\u56fe\uff0c\u663e\u793a\u4e0e\u60a8\u7684\u8d26\u6237\u5173\u8054\u7684\u6240\u6709\u533a\u57df\u3002", "632faa2fd580da435d5d604321cac9f4": "\u521b\u5efa\u65b0\u533a\u57df", "edb888dfcbf12514574916368176d4ec": "2. \u5982\u679c\u60a8\u7684\u8d26\u6237\u4e2d\u5df2\u7ecf\u6709\u533a\u57df\uff1a", "e0672a4336e2c51b9c2e756783caca7f": "\u8981\u521b\u5efa\u65b0\u533a\u57df\uff0c\u8bf7\u5355\u51fb + Add Area\uff08+ \u6dfb\u52a0\u533a\u57df\uff09\u6309\u94ae\u3002", "5f6bb151bc4522da5b97b4a838a9a424": "1. \u5728\u4e3b\u83dc\u5355\u4e2d\u70b9\u51fb Settings\uff08\u8bbe\u7f6e\uff09\u6309\u94ae\u3002", "df33b77d410c0c1987241f21653fcc75": "1. \u5bfc\u822a\u5230 Forest Watcher Web (<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">forestwatcher.globalforestwatch.org</a>)\u3002", "0f3a9d542ff05860fb6ce2e86507c1ad": "3. \u767b\u5f55\u4e4b\u540e\uff0c\u6b64\u5e94\u7528\u4f1a\u81ea\u52a8\u8f6c\u5230 Areas\uff08\u533a\u57df\uff09\u9875\u9762\u3002\u5982\u679c\u60a8\u662f\u4ece\u5176\u4ed6\u9875\u9762\u8f6c\u8fc7\u6765\u7684\uff0c\u8bf7\u5355\u51fb\u9876\u90e8\u83dc\u5355\u680f\u4e0a\u7684 Areas\uff08\u533a\u57df\uff09\u6309\u94ae\u3002", "3ad104d2360bd37f3531f62747dfbedf": "1. \u5728 Areas\uff08\u533a\u57df\uff09\u9875\u9762\u4e0a\uff0c\u5411\u4e0b\u6eda\u52a8\u5230\u5730\u56fe\u4e0b\u65b9\u3002", "d0e5aec8ffbeb68c07741dbe15008733": "\u60a8\u5c06\u770b\u5230\u4e00\u7ec4\u65b9\u6846\uff0c\u5176\u4e2d\u7684\u4e00\u4e2a\u6216\u591a\u4e2a\u65b9\u6846\u4ee3\u8868\u60a8\u7684\u5404\u4e2a\u533a\u57df\u3002", "bf5668ff0cc46ef92023644a5b0fc834": "3. \u5982\u679c\u60a8\u7684\u8d26\u6237\u4e2d\u6ca1\u6709\u4efb\u4f55\u533a\u57df\uff1a", "982955278a2cc5251419e5f4e0b2f7cd": "\u70b9\u51fb Offline Mode\uff08\u79bb\u7ebf\u6a21\u5f0f\uff09\u680f\u4e2d\u7684\u5207\u6362\u6309\u94ae\u3002", "3cacd9e6dc91ee24b81db61557e16282": "\u70b9\u51fb Showing: 0 Contextual Layers\uff08\u663e\u793a\uff1a0 \u4e2a\u5173\u8054\u56fe\u5c42\uff09\u6309\u94ae\u3002", "75e6994811f7175bd747b1ed7a57753f": "\u56e2\u961f\u6210\u5458\u5982\u4f55\u5728 Forest Watcher Mobile \u548c Forest Watcher Web \u4e2d\u4f7f\u7528\u8fd9\u4e9b\u5173\u8054\u56fe\u5c42", "d36a7c595f5d4cbb25c08abdf10b0cf1": "\u4e86\u89e3\u56e2\u961f\u6210\u5458\u5982\u4f55\u67e5\u770b\u5173\u8054\u56fe\u5c42", "40902a8d62baaa86a539063e372cf531": "\u5982\u4f55\u5728 Forest Watcher Web \u4e2d\u7ba1\u7406\u5173\u6ce8\u533a\u57df\u3002", "4b2a003a0b95232efae7063f9e055f61": "5. \u9009\u62e9 <strong>Download Method</strong>\uff08\u4e0b\u8f7d\u65b9\u6cd5\uff09\uff0c\u7136\u540e\u6309 <strong>Done</strong>\uff08\u5b8c\u6210\uff09\u3002", "8ed1f0036328b1040695f89210b295fb": "2. \u8981\u5bfc\u51fa\u6240\u6709\u62a5\u544a\uff0c\u8bf7\u6309\u7b5b\u9009\u