u5e94\u534f\u8bae\uff0c\u7528\u4e8e\u9ad8\u4fdd\u62a4\u4ef7\u503c (HCV) \u548c\u9ad8\u2026\u2026", "038204d534f66c740e728158f9440a15": "2017 - \u82f1\u56fd", "5883d84cea587ff0e1d84c1df18c4184": "Rainforest Foundation US \u652f\u6301\u4e86\u793e\u533a\u68ee\u6797\u76d1\u6d4b\u5458\u548c\u79d8\u9c81\u56fd\u5bb6\u2026\u2026", "0ee7808165e5c3769927b3d3bae3b9b4": "Sociedad Peruana de Derecho Ambiental \u4e0e\u79d8\u9c81\u5883\u5185\u7684\u4e00\u4e2a\u79c1\u4eba\u4fdd\u62a4\u533a\u7f51\u7edc\u5408\u4f5c\u2026\u2026", "e934f0a4b55e55c14a32fd91a94f245c": "2016 - \u54e5\u4f26\u6bd4\u4e9a\u3001\u82cf\u91cc\u5357", "fec424f35fb895b7a88de225a75f3189": "Code for Africa \u5c06\u57f9\u8bad\u4e2d\u975e\u8bb0\u8005\u4f7f\u7528 GFW\uff0c\u5e76\u53d1\u8868\u6709\u5173\u68ee\u6797\u6ee5\u4f10\u7684\u62a5\u9053\u2026\u2026", "eec0a6335c6f3f7a3ea05d15d51a17c9": "2020 - \u5370\u5ea6\u5c3c\u897f\u4e9a", "980b867c29d0f342b72bccd0f1603020": "IBIF \u5c06\u52a0\u5f3a\u6797\u4e1a\u6280\u672f\u90e8\u7684\u68ee\u6797\u6ee5\u4f10\u548c\u706b\u707e\u6d3b\u52a8\u9632\u8303\u2026\u2026", "ff5821b593faffee73c491f974f2a14c": "2020 - \u73bb\u5229\u7ef4\u4e9a", "78718a4bafe435667c72a8c378fbdd69": "ICV \u5c06\u5bf9\u5df4\u897f\u9a6c\u6258\u683c\u7f57\u7d22\u5dde\u7684\u68c0\u5bdf\u673a\u5173 (MPMT) \u5c55\u5f00\u57f9\u8bad\uff0c\u6307\u5bfc\u4ed6\u4eec\u8fd0\u7528 GFW \u904f\u5236\u68ee\u6797\u6ee5\u4f10\u2026\u2026", "f50040d16396031bb82ace279032ec10": "Ny Tanintsika \u5c06\u5efa\u8bbe\u76d1\u6d4b Ambositra Vondrozo \u68ee\u6797\u8d70\u5eca\u6ee5\u4f10\u533a\u7684\u80fd\u529b\u2026\u2026", "11160e1b7751b66895e102f77837d1dd": "2020 - \u9a6c\u8fbe\u52a0\u65af\u52a0", "89519e19ae88fd501e0dcee4521f6641": "KUASA \u5c06\u52a0\u5f3a\u9a6c\u6765\u897f\u4e9a\u8482\u8482\u65fa\u6c99\u4e2d\u592e\u68ee\u6797\u810a\u7ebf\u7684\u68ee\u6797\u7ba1\u7406\u2026\u2026", "792228be3a8f797d21235d41d8930456": "Rep\u00f3rter Brasil \u5c06\u91cd\u89c6\u5f3a\u8c03\u5df4\u897f\u7ecf\u6d4e\u653f\u7b56\u5bf9\u539f\u4f4f\u6c11\u9020\