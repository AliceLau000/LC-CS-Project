84\u57fa\u7840\u4e0a\uff0c\u91cd\u70b9\u5173\u6ce8\u2026\u2026", "a0f7f485651cdd2244311d3dec86d176": "Aves y Conservaci\u00f3n \u5c06\u52a0\u5f3a\u68ee\u6797\u76d1\u6d4b\u5de5\u4f5c\u2026\u2026", "0869150cb6c06ea2041a497c5eda135b": "FOCEN \u5c06\u5bf9\u5f53\u5730\u793e\u533a\u8fdb\u884c\u68ee\u6797\u76d1\u6d4b\u548c\u4fe1\u606f\u4f7f\u7528\u65b9\u9762\u7684\u57f9\u8bad\u2026\u2026", "090a8f858d27dbfc77510715c98a9da0": "2021 - \u58a8\u897f\u54e5", "fb94668d09ec9ac2f43e393de674f114": "2021 - \u5370\u5ea6\u5c3c\u897f\u4e9a", "10e6b0eeb8ab5ac926a25ee1bb5738b7": "Pledge Ghana \u5c06\u63d0\u9ad8\u5c0f\u519c\u53ef\u53ef\u79cd\u690d\u8005\u53ca\u5176\u2026\u2026", "4ecfeb68c64f9ba04156a9b3700bc5f0": "ProCAT Colombia \u65e8\u5728\u5229\u7528 GFW \u6ee5\u4f10\u9884\u8b66\u51cf\u8f7b\u3001\u63a7\u5236\u2026\u2026", "7746f6c8f58514afc65c183ae02412d4": "Rainforest Alliance \u5c06\u63d0\u9ad8\u68ee\u6797\u7267\u6c11\u7684\u80fd\u529b\u5e76\u4e3a\u5176\u63d0\u4f9b\u57f9\u8bad\u2026\u2026", "859e42972d3f886c6c6bd752fe61fc39": "Ajemalebu\u81ea\u52a9\u7ec4\u7ec7 (Ajemalebu Self Help, AJESH) \u5c06\u4e0e\u653f\u5e9c\u4e00\u8d77\u81f4\u529b\u4e8e\u4fdd\u62a4 Yabas\u2026\u2026", "af0d23f669b674ad370b63268730ad6e": "2024 - \u7f05\u7538", "c983cc58304358de727f67498af34d19": "2024 - \u5384\u74dc\u591a\u5c14", "3c6e2abac14c4882340c6686e5bd5a8c": "\u73bb\u5229\u7ef4\u4e9a\u68ee\u6797\u8c03\u67e5\u7814\u7a76\u6240 (Instituto Boliviano de Investigacion Forestal, IBIF) \u5c06\u4e0e\u74dc\u62c9\u7ea6\u65af\u5408\u4f5c\u2026\u2026", "69fcdb4efeb8c056a3030c2c6f09276a": "2024 - \u79d8\u9c81", "e7878ed91ecdfd6e8a4898ce720006e0": "\u975e\u6d32\u6c34\u5229\u8bb0\u8005 (Water Journalists Africa) \u5f00\u5c55\u7684 InfoNile \u8ba1\u5212\u5c06\u5bf9\u6765\u81ea\u4ee5\u4e0b\u5730\u533a\u7684\u8bb0\u8005\u5f00\u5c55\u57f9\u8bad\uff0c\u63d0\u4f9b\u652f\u6301\u2026\u2026", "5e48a4f977d5904091ceb9edef366dff": "2024 - \u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd", "536f818929a0e852d91be875874af305": "2024 - \u5370\u5ea6\u5c3c\u897f\u4e9a", "78c54d7389e9e8a097887b251b31bc4e": "\u72ec\u7acb\u68ee\u6797\u76d1\u6d4b\u57fa\u91d1\u4f1a - \u5370\u5ea6\u5c3c\u897f\u4e9a\u72ec\u7acb\u6797\u4e1a\u76d1\u6d4b\u57fa\u91d1\u4f1a (YPIKI-IFMF) \u5c06\u81f4\u529b\u4e8e\u5efa\u8bbe\u68ee\u6797\u76d1\u6d4b\u7ad9\u7684\u80fd\u529b\u2026\u2026", "f16bfd5bb3b00d5520c978e22de87fec": "\u516c\u6c11\u54cd\u5e94 (Civic Response) \u6b63\u5728\u52a0\u7eb3\u7684\u82cf\u4f0a\u68ee\u6797\u4fdd\u62a4\u533a\u5f00\u5c55\u5de5\u4f5c\uff0c\u8fd9\u91cc\u4e00\u4e2a\u751f\u7269\u591a\u6837\u6027\u7684\u70ed\u70b9\u5730\u533a\u2026\u2026", "c09c6189c51814ffb1c6f8e46fece0f5": "\u6b64\u4eba\u5de5\u6797\u8303\u56f4\u6570\u636e\u96c6 (SDPT) \u7531 Global Forest Watch \u5229\u7528\u4ece\u5404\u56fd\u653f\u5e9c\u3001\u975e\u653f\u5e9c\u7ec4\u7ec7\u548c\u72ec\u7acb\u7814\u7a76\u4eba\u5458\u5904\u83b7\u5f97\u7684\u6570\u636e\u7f16\u5236\u800c\u6210\u30022.0 \u7248 (v2.0) \u4e2d\u7f16\u5236\u7684\u6570\u636e\u6db5\u76d6\u5168\u7403 158 \u4e2a\u56fd\u5bb6/\u5730\u533a\uff0c\u5927\u591a\u6570\u56fd\u5bb6/\u5730\u533a\u5730\u56fe\u6e90\u81ea Landsat\u3001SPOT \u6216 RapidEye \u536b\u661f\u56fe\u50cf\u7684\u76d1\u7763\u5206\u7c7b\u6216\u624b\u52a8\u591a\u8fb9\u5f62\u7ed8\u5236\u3002<br>SDPT \u4e2d\u7684\u201c\u4eba\u5de5\u6797\u201d\u5305\u62ec\u4eba\u5de5\u6797\u5730\u3001\u7ecf\u6d4e\u6797\u6728\u4e4b\u5916\u7684\u4eba\u5de5\u6797\u6797\u5206\uff08\u4e3a\u751f\u4ea7\u6728\u6750\u548c\u6728\u7ea4\u7ef4\u6216\u4e3a\u9632\u6b62\u98ce\u8680\u548c/\u6216\u6c34\u571f\u6d41\u5931\u800c\u79cd\u690d\u7684\u6797\u6728\uff09\u3002\u4eba\u5de5\u6797\u80fd\u591f\u9ad8\u6548\u4ea7\u51fa\u5927\u91cf\u6728\u6750\u4ea7\u54c1\uff0c\u4ece\u800c\u51cf\u8f7b\u5bf9\u5929\u7136\u6797\u7684\u538b\u529b\uff0c\u521b\u9020\u652f\u6301\u519c\u6751\u53d1\u5c55\u7684\u5c31\u4e1a\u673a\u4f1a\uff0c\u4ee5\u53ca/\u6216\u8005\u63d0\u4f9b\u4e00\u7cfb\u5217\u751f\u6001\u7cfb\u7edf\u670d\u52a1\u3002\u7279\u522b\u662f\u5728\u9000\u5316\u571f\u5730\u4e0a\u5efa\u7acb\u8d77\u6765\u7684\u4eba\u5de5\u6797\uff0c\u5176\u751f\u6001\u548c\u7ecf\u6d4e\u6548\u76ca\u5c24\u4e3a\u663e\u8457\u3002\u6570\u636e\u96c6\u8fd8\u5305\u62ec\u591a\u5e74\u751f\u7ecf\u6d4e\u6797\u6728\uff0c\u5982\u6a61\u80f6\u3001\u6cb9\u68d5\u3001\u5496\u5561\u3001\u6930\u5b50\u3001\u53ef\u53ef\u548c\u679c\u56ed\u3002 SDPT \u4e0d\u4ec5\u80fd\u591f\u5c06\u4eba\u5de5\u6797\u548c\u7ecf\u6d4e\u6797\u6728\u4e0e\u5929\u7136\u6797\u533a\u5206\u5f00\u6765\uff0c\u8fd8\u80fd\u72ec\u7acb\u4e8e\u5168\u7403\u5929\u7136\u68ee\u6797\u8986\u76d6\u53d8\u5316\uff0c\u76d1\u6d4b\u8fd9\u4e9b\u4eba\u5de5\u79cd\u690d\u533a\u57df\u7684\u53d8\u5316\u3002<br>SDPT v2.0 \u5305\u542b 2.64 \u4ebf\u516c\u9877\u4eba\u5de5\u6797\u548c 6500 \u4e07\u516c\u9877\u519c\u7528\u6811\u6728\uff0c\u7ea6\u5360 2020 \u5e74\u5168\u7403\u4eba\u5de5\u6797\u603b\u9762\u79ef\u7684 90% (FAO 2020)\u3002SDPT \u7684\u7f16\u5236\u8fc7\u7a0b\u5305\u62ec\u5bf9\u6bcf\u4e2a\u5355\u72ec\u6570\u636e\u96c6\u8fdb\u884c\u6e05\u7406\u548c\u5904\u7406\uff0c\u5e76\u6700\u7ec8\u521b\u5efa\u4e00\u4e2a\u7edf\u4e00\u7684\u5c5e\u6027\u8868\u3002\n<br>\u6709\u5173\u66f4\u591a\u8be6\u7ec6\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6280\u672f\u8bf4\u660e</a>\u3002<br>\u9664\u5df4\u5e03\u4e9a\u65b0\u51e0\u5185\u4e9a\u5916\uff0c\u6240\u6709\u56fd\u5bb6/\u5730\u533a\u7684\u6570\u636e\u90fd\u53ef\u4ee5\u4e0b\u8f7d\u3002", "64ea6b442e6d992ef4b47eac66a69ead": "\u5728{location}\uff0c\u6700\u5927\u7684\u79cd\u690d\u56ed\u7c7b\u578b\u662f{topType}\uff0c\u5360\u5730 {extent}\uff0c\u5360\u571f\u5730\u9762\u79ef\u7684 {percent}\u3002", "79c99d7f142cbebba6e577efdff149b1": "*\u8be5\u6570\u636e\u96c6\u6c47\u96c6\u4e86\u6765\u81ea\u591a\u4e2a\u56fd\u5bb6\u548c\u4e0d\u540c\u6765\u6e90\u7684\u4eba\u5de5\u6797\u6570\u636e\u3002\u56e0\u6b64\uff0c\u6570\u636e\u5e93\u4e2d\u5b58\u5728\u65f6\u95f4\u4e0a\u7684\u5dee\u5f02\uff0c\u6700\u5e38\u89c1\u7684\u65f6\u95f4\u70b9\u4e3a 2020 \u5e74\uff0c\u4f46\u5177\u4f53\u5e74\u4efd\u8303\u56f4\u6839\u636e\u6570\u636e\u6765\u6e90\u7684\u4e0d\u540c\uff0c\u53ef\u80fd\u5728 2000 \u5e74\u81f3 2021 \u5e74\u4e4b\u95f4\u3002\u6b64\u5916\uff0c\u5b9a\u4e49\u4e0a\u4e5f\u5b58\u5728\u4e0d\u4e00\u81f4\u4e4b\u5904\u3002\u8be6\u7ec6\u4fe1\u606f\u8bf7\u53c2\u9605\u6280\u672f\u6587\u6863\u3002", "4a5eb49151b6f1daa035a14ac9fda2e4": "\u4ece {baselineYear} \u5230 2020 \u5e74\uff0c{location} \u7684\u6811\u6728\u8986\u76d6\u9762\u79ef\u589e\u52a0\u4e86 {gain}\uff0c\u76f8\u5f53\u4e8e\u5168\u7403\u603b\u91cf\u7684 {gainPercent}\u3002", "5649bc8c191a1cccebd008766af1ace0": "\u4ece {startYear} \u5230 {endYear}\uff0c{location}\u7684\u76f8\u5bf9\u6811\u6728\u8986\u76d6\u9762\u79ef\u51cf\u5c11\u4e86{loss} \uff0c\u76f8\u5f53\u4e8e\u81ea {extentYear} \u4ee5\u6765\u51cf\u5c11\u4e86 {localPercent}\uff0c\u5360 {parent} \u6240\u6709\u6811\u6728\u8986\u76d6\u635f\u5931\u7684 {globalPercent}\u3002", "96414f74cd3c7303fa2ff7d0656baae4": "\u4ece {baselineYear} \u5230 2020 \u5e74\uff0c{location}\u7684\u6811\u6728\u8986\u76d6\u9762\u79ef\u589e\u52a0\u4e86 {gain}\u3002", "be15cf3639c50d57f8e1cf6ca94cc264": " {baselineYear} \u81f3 2020 \u5e74\u95f4\uff0c{location} {gainPercent} \u7684\u6811\u6728\u8986\u76d6\u9762\u79ef\u589e\u957f\u53d1\u751f\u5728\u79cd\u690d\u56ed\u4ee5\u5916\u7684\u5730\u533a\u3002", "7c1f7838f6755c55b15d3ed5a2577ab4": "\u4ece\u5168\u7403\u6765\u770b\uff0c{baselineYear} \u81f3 2020 \u5e74\u95f4\uff0c{gainPercent} \u7684\u6811\u6728\u8986\u76d6\u9762\u79ef\u589e\u957f\u53d1\u751f\u5728\u79cd\u690d\u56ed\u4ee5\u5916\u7684\u5730\u533a\u3002", "6f790b9f346d100267d49084d0e4e19c": "\u6728\u7ea4\u7ef4\u6216\u6728\u6750", "13538193db8e35b64f74594b0a7aadfc": "\u636e\u8054\u5408\u56fd\u7cae\u98df\u53ca\u519c\u4e1a\u7ec4\u7ec7 (FAO) \u7edf\u8ba1\uff0c{startYearRange} \u81f3 {endYearRange} \u671f\u95f4\uff0c{location}\u7684\u68ee\u6797\u780d\u4f10\u7387\u4e3a\u6bcf\u5e74 {rate}\u3002", "1cf17ae56d21da0dfbc757bcdb873cb7": "\u636e\u8054\u5408\u56fd\u7cae\u98df\u53ca\u519c\u4e1a\u7ec4\u7ec7 (FAO) \u7edf\u8ba1\uff0c{startYearRange} \u81f3 {endYearRange} \u671f\u95f4\uff0c{location}\u7684\u518d\u9020\u6797\u7387\u4e3a\u6bcf\u5e74 {rate}\u3002", "97460c02ca6067b385d063064bbdf297": "\u5728 {location}\uff0c\u6392\u540d\u524d {percentileLength} \u5360 {baselineYear} \u81f3 2020 \u5e74\u671f\u95f4\u6811\u6728\u8986\u76d6\u9762\u79ef\u603b\u589e\u957f\u91cf\u7684 {topGain}%\u3002\u4e0e\u540c\u671f\u5185\u7684\u5e73\u5747\u589e\u957f\u91cf {average} \u76f8\u6bd4\uff0c{region}\u7684\u6811\u6728\u8986\u76d6\u9762\u79ef\u589e\u957f\u6700\u4e3a\u663e\u8457\uff0c\u8fbe\u5230\u4e86 {value}\u3002", "cffd09c0ba3d655a71f12315bd84a5d6": "\u4ece {baselineYear} \u5230 2020 \u5e74\uff0c{location} \u7684\u6811\u6728\u8986\u76d6 {indicator} \u589e\u52a0\u4e86 {gain}\uff0c\u76f8\u5f53\u4e8e{parent}\u6811\u6728\u8986\u76d6\u9762\u79ef\u603b\u589e\u957f\u91cf\u7684 {gainPercent}\u3002", "2c20bf9e8e1898f552457ebac320e380": "\u5df2\u66f4\u65b0\u79cd\u690d\u6811\u6728\u56fe\u5c42", "8a8381ffc8a70dd5402b05bdc33dbabb": "\u9009\u62e9\u57fa\u51c6\u5e74\u4efd\u4ee5\u67e5\u770b\u589e\u957f\u6570\u636e\uff1a", "802264ce84d323f4e5c28b683ea61b43": "\u6811\u51a0\u589e\u52a0\u6570\u636e\u7684\u65b0\u57fa\u51c6\u5e74\u4efd", "06020b551c17f275b130f1935bf00ea5": "\u8986\u76d6\u8fd1\u5168\u7403\u8303\u56f4\u7684\u79cd\u690d\u6811\u6728\u548c\u4eba\u5de5\u6797\u56fe\u5c42\u7684\u6700\u65b0\u7248\u672c\u73b0\u5df2\u5728 GFW \u4e0a\u7ebf\uff01<a href=\"{{0}}\">\u5728\u5730\u56fe\u4e0a\u67e5\u770b</a>\uff0c\u5e76<a href=\"{{1}}\">\u4e86\u89e3\u66f4\u591a\u4fe1\u606f</a>\u3002", "81ba5d0906a2505fc99e48bb4662db75": "\u66f4\u65b0\u540e\u7684\u6811\u51a0\u589e\u52a0\u6570\u636e\u663e\u793a\u4e86\u5728\u57fa\u51c6\u5e74\u4efd\uff082000 \u5e74\u30012005 \u5e74\u30012010 \u5e74\u6216 2015 \u5e74\uff09\u4e0e 2020 \u5e74\u4e4b\u95f4\u6811\u51a0\u589e\u957f\u7684\u533a\u57df\u3002<a href=\"{{0}}\">\u5728\u6b64\u63a2\u7d22\u66f4\u65b0\u540e\u7684\u56fe\u5c42\u5e76\u8bbe\u7f6e\u57fa\u51c6</a>\uff0c\u5e76<a href=\"{{1}}\">\u4e86\u89e3\u66f4\u591a\u4fe1\u606f</a>\u3002", "a53ba4039becc843d0a0920d891af11c": "RADD \u8b66\u62a5\u5305\u542b\u5728 GFW \u7684\u7efc\u5408\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u5c42\u4e2d\uff0c\u8fd9\u610f\u5473\u7740\u73b0\u5728\u8b66\u62a5\u7684\u7f6e\u4fe1\u5ea6\u66f4\u9ad8\uff0c\u5bf9\u4e1c\u5357\u4e9a\u5927\u9646\u6f5c\u5728\u68ee\u6797\u780d\u4f10\u884c\u4e3a\u7684\u68c0\u6d4b\u66f4\u5feb\uff0c\u4ece\u800c\u4f7f\u7528\u6237\u53d7\u76ca\u3002", "7523820ad5d90c336a7336227eeb7056": "Global Forest Watch (GFW) \u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u65e8\u5728\u8fd1\u5b9e\u65f6\u5730\u63d0\u9192\u7528\u6237\u53ef\u80fd\u5b58\u5728\u7684\u68ee\u6797\u780d\u4f10\u884c\u4e3a\uff0c\u4ece\u800c\u5e2e\u52a9\u5176\u8fc5\u901f\u4f5c\u51fa\u53cd\u5e94\u3002\u6700\u8fd1\uff0c\u4e00\u79cd\u540d\u4e3a RADD \u7684\u8b66\u62a5\u8986\u76d6\u8303\u56f4\u6269\u5c55\u5230\u4e86\u4e1c\u5357\u4e9a\u5927\u9646\u3002\u8fd9\u79cd\u57fa\u4e8e\u96f7\u8fbe\u7684\u8b66\u62a5\u7cfb\u7edf\u73b0\u5728\u53ef\u4ee5\u68c0\u6d4b\u5230 5 \u4e2a\u65b0\u589e\u56fd\u5bb6\u7684\u539f\u59cb\u70ed\u5e26\u96e8\u6797\u6270\u52a8\uff1a\u8d8a\u5357\u3001\u8001\u631d\u3001\u6cf0\u56fd\u3001\u67ec\u57d4\u5be8\u548c\u7f05\u7538\u3002", "57f3801e59cdea8c2697ff0962904f7d": "\u6b22\u8fce\u53c2\u52a0 GFW \u4e13\u5bb6\u4e3b\u6301\u7684\u529e\u516c\u65f6\u95f4\u6d3b\u52a8\uff0c\u4e86\u89e3\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u7cfb\u7edf\u7684\u6982\u51b5\u3001\u5173\u4e8e RADD \u8b66\u62a5\u7cfb\u7edf\u5728\u4e1c\u5357\u4e9a\u5927\u9646\u6269\u5c55\u60c5\u51b5\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u6d3b\u52a8\u65f6\u95f4\u4e3a\u5317\u7f8e\u4e1c\u90e8\u65f6\u95f4 11 \u6708 20 \u65e5\u665a 9 \u70b9 | \u5370\u5ea6\u5c3c\u897f\u4e9a\u897f\u90e8\u65f6\u95f4 11 \u6708 21 \u65e5\u4e0a\u5348 9 \u70b9\u3002\u5728\u529e\u516c\u65f6\u95f4\u6d3b\u52a8\u4e2d\uff0c\u60a8\u5c06\u6709\u673a\u4f1a\u63d0\u51fa\u95ee\u9898\u3001\u89e3\u51b3\u95ee\u9898\u3001\u5206\u4eab\u7ecf\u9a8c\u6559\u8bad\u3002<a href=\"{{0}}\">\u5728\u6b64\u5904\u6ce8\u518c</a>\u3002", "65f63c64247307927cc2e510c46734bc": "\u529e\u516c\u65f6\u95f4\uff1a\u68ee\u6797\u780d\u4f10\u8b66\u62a5", "ce1f8b8ad62fc6baf25bf366772ff1b3": "\u670d\u52a1\u6761\u6b3e\u548c\u9690\u79c1\u653f\u7b56\u66f4\u65b0", "f905e41305cecf957c6e822f7fd625af": "\u4e0b\u8f7d\u6570\u636e", "2da4567c9fef8db6f75d418415e21f98": "GFW \u548c\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240\u5df2\u66f4\u65b0\u6211\u4eec\u7684<a href=\"{{0}}\">\u670d\u52a1\u6761\u6b3e</a>\u548c<a href=\"{{1}}\">\u9690\u79c1\u6743\u653f\u7b56</a>\u3002", "7148cd976ed6350c66fa21b9221b2c0b": "\u65b0\u7684\u5929\u7136\u6797\u6570\u636e\u53ef\u5728<a href=\"{{0}}\">\u5730\u56fe</a>\u548c<a href=\"{{1}}\">\u63a7\u5236\u9762\u677f</a>\u4e0a\u67e5\u770b\u3002<a href=\"{{2}}\">\u5728\u6b64\u5904\u4e86\u89e3\u66f4\u591a\u4fe1\u606f</a>\u3002", "a863ac663b2058d60e8d0f1f8d243cdd": "\u4ece 2015 \u5e74\u81f3 2020 \u5e74 5 \u6708\u6bcf\u534a\u5e74\u4e00\u6b21\uff0c\u4ece 2020 \u5e74 6 \u6708\u81f3 8 \u6708\u6bcf\u4e09\u4e2a\u6708\u4e00\u6b21\uff0c\u4ece 2020 \u5e74 9 \u6708\u8d77\u6bcf\u6708\u4e00\u6b21\u3002", "7f1a35648fd2e93b2cdc1a4d4c75e3c9": "\u53d7\u65b0\u51a0\u80ba\u708e\u75ab\u60c5\u7684\u523a\u6fc0\u548c\u68d5\u6988\u6cb9\u4ef7\u683c\u8d70\u9ad8\u7684\u63a8\u52a8\uff0c\u5de5\u4e1a\u5316\u79cd\u690d\u56ed\u6b63\u5728\u8fc5\u901f\u53d6\u4ee3\u5269\u4f59\u7684\u690d\u7269\u548c\u54fa\u4e73\u52a8\u7269\u2026\u2026", "7e1522d49f7ccbb2250cfe9086cf03ac": "\u5c0f\u519c\u548c\u4f10\u6728\u8005\u6df1\u5165\u5230\u82cf\u95e8\u7b54\u814a\u5c9b\u6700\u5927\u7684\u516c\u56ed", "a0b6e74473f166b55d8119ac44754f4b": "\u539f\u4f4f\u6c11\u62c5\u5fc3\uff0c\u65b0\u4fee\u7684\u4e00\u6761\u516c\u8def\u5c06\u4f7f\u4ed6\u4eec\u7684\u9886\u5730\u7545\u901a\u65e0\u963b\uff0c\u5438\u5f15\u6765\u571f\u5730\u63a0\u593a\u8005\u3001\u76f2\u76ee\u91c7\u77ff\u8005\u548c\u6709\u7ec4\u7ec7\u72af\u7f6a\u56e2\u4f19\u2026\u2026", "85498d498393a8a2818b323d9263c52c": "\u5728\u5df4\u897f\u4e9a\u9a6c\u900a\u5730\u533a\uff0c\u4e00\u6761\u9690\u79d8\u9053\u8def\u5a01\u80c1\u7740\u539f\u59cb\u4fdd\u62a4\u533a", "58594c4dd6fecb879a0ce7de4feec285": "\u5a92\u4f53\u54a8\u8be2\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3 <a href=\"{{0}}\" class=\"css-du67jw e17dsij80\">Kaitlyn.Thayer@wri.org</a>\u3002", "8f88b5956b50f787cba869b62a124ed9": "\u9605\u8bfb 2023 \u5e74<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">\u7533\u8bf7\u4eba\u6307\u5357</a>", "869a9f25bd88d87d7f25760e97732473": "\u67e5\u770b<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u5e38\u89c1\u95ee\u9898\u89e3\u7b54</a>", "f8e34e8e9e5a785ab0af782a4876045e": "\u4e2a\u6027\u5316\u57f9\u8bad\u548c\u652f\u6301\u3002", "990ad2acbdaf5e72274bb253b0a629ce": "\u6bcf\u6708\u6709\u6d25\u8d34\uff0c\u5e76\u53ef\u4ee5\u83b7\u5f97\u989d\u5916\u7684\u53ef\u81ea\u7531\u652f\u914d\u8d44\u91d1\uff0c\u7528\u4e8e\u5b9e\u5730\u8003\u5bdf\u3001\u8d2d\u4e70\u8bbe\u5907\u3001\u804c\u4e1a\u53d1\u5c55\u6216\u8bb2\u4e60\u73ed\u8d39\u7528\u3002", "e103022d548eaef52d4daf3cef700ca8": "\u62a5\u9500\u53c2\u52a0\u534e\u76db\u987f\u7279\u533a\u6280\u672f\u8425\u548c GFW \u7528\u6237\u5cf0\u4f1a\u7684\u6240\u6709\u8d39\u7528\uff08\u673a\u7968\u3001\u7b7e\u8bc1\u8d39\u7528\u3001\u98df\u5bbf\uff09\u3002", "059c4489e97c77ab5729375cdf44e30e": "\u7531\u68ee\u6797\u76d1\u6d4b\u3001\u571f\u5730\u5229\u7528\u89c4\u5212\u3001\u5ba3\u4f20\u548c\u6267\u884c\u4ee5\u53ca\u9879\u76ee\u8bbe\u8ba1\u548c\u5b9e\u65bd\u65b9\u9762\u7684\u4e13\u5bb6\u63d0\u4f9b\u57f9\u8bad\u3002", "bceb3755a85c2c844a4136e88da9ff8c": "\u53c2\u4e0e GFW \u5408\u4f5c\u4f19\u4f34\u5173\u7cfb\u548c SGF/\u7814\u7a76\u5458\u9879\u76ee\u6821\u53cb\u4f1a\u3002", "375d55bcc8722f45bbb08e55a59da957": "WRI \u7684\u7b80\u62a5\u3001\u535a\u5ba2\u548c\u793e\u4ea4\u5a92\u4f53\u4e2d\u7684\u62a5\u9053\u3002", "697674e1118a2367af85b17addfe0a55": "\u5982\u679c\u60a8\u60f3\u5e2e\u52a9\u793e\u533a\u3001\u6c11\u95f4\u793e\u56e2\u3001\u7ec4\u7ec7\u548c\u4e2a\u4eba\u5229\u7528 GFW \u6765\u4fdd\u62a4\u548c\u53ef\u6301\u7eed\u7ba1\u7406\u5168\u7403\u68ee\u6797\uff0c\u8bf7\u901a\u8fc7 <a class=\"text -paragraph -color-4 -light\" href=\"{{0}}\">gfwfund@wri.org</a> \u4e0e\u6211\u4eec\u8054\u7cfb\u3002", "4baa4f577fcc233141fd6f8981001457": "\u8bf7\u7a0d\u540e\u56de\u6765\u67e5\u770b\u66f4\u591a\u66f4\u65b0\uff01", "498f79c4c5bbde77f1bceb6c86fd0f6d": "\u663e\u793a", "f489ccf1d67925cfddaa90c223488ece": "\u663e\u793a {selector} \u8b66\u62a5", "abca7cba75e5a9ff86b1490f32891f82": "\u8b66\u62a5", "c1f627decb0ab5d31b91475f494d45e5": "\u60a8\u8fd8\u53ef\u4ee5\u5728 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">www.planet.com/nicfi</a> \u5bf9 Planet-NICFI \u5e95\u56fe\u8fdb\u884c\u76f4\u63a5\u67e5\u770b\u3001\u6d41\u5a92\u4f53\u64ad\u653e\u548c\u4e0b\u8f7d", "44bf57a08e3b03a55b9d6b0f484c9596": "2015 \u5e74 12 \u6708\u81f3\u4eca", "90e99c689b293256eb2e83df6709405c": "\u81ea\u7136\u8272\u5f69\u56fe\u50cf\u4f7f\u7528\u53ef\u89c1\u5149\uff08\u7ea2\u8272\u3001\u7eff\u8272\u548c\u84dd\u8272\uff09\u7684\u4fe1\u606f\u6765\u663e\u793a\u5730\u7403\u8868\u9762\uff0c\u5c31\u50cf\u4eba\u773c\u770b\u5230\u7684\u90a3\u6837\u3002", "9c8f5797a83eccd527d9f3665774762f": "\u5168\u7403\u706b\u707e\u5929\u6c14\u6307\u6570 - 2024 \u5e74 1 \u6708 9 \u65e5", "a7528a73d8d2cd34e76f66facf09f8a2": "\u8be5\u6392\u653e\u5c42\u662f <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021) \u6240\u63cf\u8ff0\u7684\u68ee\u6797\u78b3\u901a\u91cf\u6a21\u578b\u7684\u4e00\u90e8\u5206</a>\u3002\u8be5\u8bba\u6587\u4ecb\u7ecd\u4e86\u4e00\u4e2a\u7528\u4e8e\u4f30\u7b97\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u7684\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u8be5\u6846\u67b6\u53ef\u4ee5\u5e2e\u52a9\u5404\u79cd\u53c2\u4e0e\u8005\u548c\u7ec4\u7ec7\u8ddf\u8e2a\u68ee\u6797\u7684\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf\u3001\u51cf\u5c11\u6392\u653e\u91cf\u6216\u589e\u52a0\u68ee\u6797\u79fb\u9664\u91cf\u3002\u68ee\u6797\u78b3\u6392\u653e\u91cf\u8868\u793a\u6bcf\u4e2a\u6a21\u578b\u5e74\u4efd\u53d1\u751f\u7684\u6797\u5206\u7f6e\u6362\u5e72\u6270\u4ea7\u751f\u7684\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u91cf\uff08\u5146\u514b CO2 \u6392\u653e\u91cf/\u516c\u9877\uff0c2001 \u5e74\u81f3 2022 \u5e74\uff09\u3002\u6392\u653e\u7269\u5305\u62ec\u6240\u6709\u76f8\u5173\u7684\u751f\u6001\u7cfb\u7edf\u78b3\u5e93\uff08\u5730\u4e0a\u751f\u7269\u91cf\u3001\u5730\u4e0b\u751f\u7269\u91cf\u3001\u67af\u6728\u3001\u67af\u679d\u843d\u53f6\u3001\u571f\u58e4\uff09\u548c\u6e29\u5ba4\u6c14\u4f53\uff08CO2\u3001CH4\u3001N2O\uff09\u3002\u6bcf\u4e2a\u50cf\u7d20\u7684\u4f30\u7b97\u6392\u653e\u91cf\u5747\u6309\u7167 IPCC <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u6307\u5357\u8ba1\u7b97\uff08\u53d1\u751f\u6797\u5206\u7f6e\u6362\u5e72\u6270\u65f6\uff0c\u5982 <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013) \u7684\u5168\u7403\u68ee\u6797\u53d8\u5316\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u6240\u793a</a>\uff09\u3002\u6bcf\u4e2a\u50cf\u7d20\u7684\u78b3\u6392\u653e\u91cf\u6839\u636e\u7684\u662f 2000 \u5e74\u7684\u78b3\u5bc6\u5ea6\uff0c\u5e76\u6839\u636e 2000 \u5e74\u548c\u5e72\u6270\u5e74\u4efd\u4e4b\u95f4\u7d2f\u79ef\u7684\u78b3\u8fdb\u884c\u8c03\u6574\u3002&nbsp;&nbsp;<br>\u6392\u653e\u91cf\u53cd\u6620\u7684\u662f\u6bdb\u4f30\u7b97\u91cf\uff0c\u5373\u4e0d\u5305\u62ec\u4e4b\u540e\u7684\u518d\u751f\u690d\u88ab\u4ea7\u751f\u7684\u78b3\u79fb\u9664\u91cf\u3002\u6811\u6728\u6e05\u9664\u540e\u7684\u518d\u751f\u690d\u88ab\u6240\u4ea7\u751f\u7684\u6bdb\u78b3\u79fb\u9664\u91cf\u4f1a\u5728<a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5bf9\u5e94\u7684\u68ee\u6797\u78b3\u79fb\u9664\u5c42</a>\u4e2d\u5f97\u5230\u4f53\u73b0\u3002\u5728\u53d7\u5230\u5e72\u6270\u65f6\u6bcf\u50cf\u7d20\u6392\u653e\u7684\u78b3\u7684\u6bd4\u4f8b\uff08\u6392\u653e\u56e0\u5b50\uff09\u53d7\u591a\u79cd\u56e0\u7d20\u5f71\u54cd\uff0c\u5305\u62ec\u5e72\u6270\u7684\u76f4\u63a5\u539f\u56e0\u3001\u662f\u5426\u5728\u89c2\u5bdf\u5230\u7684\u5e72\u6270\u4e8b\u4ef6\u5f53\u5e74\u6216\u524d\u4e00\u5e74\u89c2\u5bdf\u5230\u706b\u707e\u3001\u5e72\u6270\u662f\u5426\u53d1\u751f\u5728\u6ce5\u70ad\u4e0a\u7b49\u56e0\u7d20\u3002\u6240\u6709\u6392\u653e\u90fd\u5047\u5b9a\u53d1\u751f\u5728\u5e72\u6270\u5e74\u4efd\u3002\u60a8\u53ef\u4ee5\u4f7f\u7528 Hansen \u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\uff0c\u5c06\u6392\u653e\u91cf\u5206\u914d\u5230\u7279\u5b9a\u5e74\u4efd\uff1bGFW \u65e0\u6cd5\u63d0\u4f9b\u6bcf\u5e74\u6392\u653e\u91cf\u7684\u5355\u72ec\u6805\u683c\u3002<br>\u6240\u6709\u8f93\u5165\u56fe\u5c42\u5747\u91cd\u65b0\u91c7\u6837\u4e3a\u5e38\u7528\u5206\u8fa8\u7387 0.00025 x 0.00025 \u5ea6\u6bcf\u50cf\u7d20\uff0c\u4ee5\u4fbf\u4e0e Hansen et al. (2013) \u5339\u914d\u3002\u968f\u7740 2022 \u5e74\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u7684\u52a0\u5165\uff0c\u5176\u4ed6\u4e00\u4e9b\u6a21\u578b\u8f93\u5165\u6570\u636e\u96c6\u548c\u5e38\u91cf\u4e5f\u53d1\u751f\u4e86\u53d8\u5316\uff0c\u5982\u4e0b\u6240\u8ff0\u3002\u8bf7\u53c2\u9605<a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8fd9\u7bc7\u535a\u5ba2\u6587\u7ae0</a>\u4e86\u89e3\u8be6\u60c5\u3002&nbsp;<br>1. \u5730\u4e0b\u78b3\u4e0e\u5730\u4e0a\u78b3\u6bd4\u7387\u7684\u6765\u6e90\u3002\u4ee5\u524d\u4f7f\u7528\u4e00\u4e2a\u5168\u5c40\u5e38\u91cf\uff1b\u73b0\u5728\u4f7f\u7528<a href=\"{{5}}\" target=\"_blank\" rel=\"noopener noreferrer\"> Huang et al. 2021 \u7684\u5730\u56fe</a>&nbsp;<br>2. \u6811\u6728\u8986\u76d6\u589e\u76ca\u7684\u5e74\u4efd\u3002\u4ee5\u524d\u4f7f\u7528 2000-2012 \u6570\u636e\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{6}}\" target=\"_blank\" rel=\"noopener noreferrer\">Potapov et al. 2022 \u7684 2000-2020 \u6570\u636e</a>\u3002&nbsp;<br>3. \u706b\u707e\u6570\u636e\u6765\u6e90\u3002\u4ee5\u524d\u4f7f\u7528 MODIS \u706b\u70e7\u8ff9\u5730\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{7}}\" target=\"_blank\" rel=\"noopener noreferrer\">Tyukavina et al. 2022</a> \u7684\u706b\u707e\u9020\u6210\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u3002<br>4. \u6ce5\u70ad\u5730\u56fe\u7684\u6765\u6e90\u3002\u52a0\u5165\u4e86\u65b0\u7684\u70ed\u5e26\u6570\u636e\u96c6\uff0c\u5e76\u5bf9\u5317\u7eac 40 \u5ea6\u4ee5\u4e0a\u7684\u6570\u636e\u96c6\u505a\u4e86\u6539\u52a8\u3002&nbsp;<br>5. CH4 \u548c N2O \u7684\u5168\u7403\u53d8\u6696\u6f5c\u52bf (GWP) \u5e38\u6570\u3002\u4ee5\u524d\u4f7f\u7528 IPCC \u7b2c\u4e94\u6b21\u8bc4\u4f30\u62a5\u544a\u4e2d\u7684 GWP\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{8}}\" target=\"_blank\" rel=\"noopener noreferrer\">IPCC \u7b2c\u516d\u6b21\u8bc4\u4f30\u62a5\u544a</a>\u4e2d\u7684 GWP\u3002<br>\u6709\u4e24\u79cd\u4e0d\u540c\u9762\u79ef\u5355\u4f4d\u7684\u6392\u653e\u91cf\u53ef\u4f9b\u4e0b\u8f7d\uff1a1) \u5146\u514b CO2 \u6392\u653e\u91cf/\u516c\u9877\uff0c\u4ee5\u53ca 2) \u5146\u514b CO2 \u6392\u653e\u91cf/\u50cf\u7d20\u3002\u7b2c\u4e00\u4e2a\u9002\u7528\u4e8e\u76f4\u89c2\u663e\u793a\uff08\u7ed8\u5236\uff09\u6392\u653e\u91cf\uff0c\u56e0\u4e3a\u5b83\u8868\u793a\u6bcf\u516c\u9877\u7684\u6392\u653e\u5bc6\u5ea6\u3002 \u7b2c\u4e8c\u4e2a\u9002\u7528\u4e8e\u8ba1\u7b97\u611f\u5174\u8da3\u533a\u57df (AOI) \u4e2d\u7684\u6392\u653e\u91cf\uff0c\u56e0\u4e3a\u60a8\u53ef\u4ee5\u5c06 AOI \u4e2d\u7684\u50cf\u7d20\u503c\u76f8\u52a0\uff0c\u6c42\u51fa\u8be5\u533a\u57df\u7684\u603b\u6392\u653e\u91cf\u3002\u540e\u8005\u7684\u503c\u662f\u6839\u636e\u6bcf\u4e2a\u50cf\u7d20\u7684\u5927\u5c0f\uff08\u56e0\u7eac\u5ea6\u800c\u5f02\uff09\u8c03\u6574\u6bcf\u516c\u9877\u7684\u6392\u653e\u91cf\u4e4b\u540e\u8ba1\u7b97\u51fa\u6765\u7684\u3002\u4e24\u4e2a\u6570\u636e\u96c6\u90fd\u53ea\u5305\u542b\u68ee\u6797\u5185\u7684\u50cf\u7d20\uff0c\u5982 Harris et al. (2021) \u4e2d\u7684\u65b9\u6cd5\u6240\u5b9a\u4e49\uff0c\u5e76\u4e14\u6811\u6728\u8986\u76d6\u589e\u76ca\u90fd\u66f4\u65b0\u5230\u4e86 2020 \u5e74\u3002", "8ea62f2e9d47cd57ee57612a5e74606d": "\u78b3\u79fb\u9664\u91cf\u53cd\u6620\u4e86 2001 \u5230 2022 \u5e74\u6a21\u578b\u671f\u95f4\u7684\u603b\u79fb\u9664\u91cf\uff0c\u800c\u4e0d\u662f\u53ef\u4ee5\u4ece\u4e2d\u5f97\u51fa\u8d8b\u52bf\u7684\u5e74\u5ea6\u65f6\u95f4\u5e8f\u5217\u3002\u56e0\u6b64\uff0c\u8981\u8ba1\u7b97\u5e73\u5747\u5e74\u79fb\u9664\u91cf\uff0c\u5fc5\u987b\u5c06\u503c\u9664\u4ee5 22\u3002", "d6b31dfe08320d958208262e518a218f": "\u663e\u793a\u68ee\u6797\u78b3\u79fb\u9664\u91cf", "1af2d37315e88d766a92347131bb7e4c": "\u78b3\u79fb\u9664\u91cf\u53cd\u6620\u4e86\u6bdb\u4f30\u7b97\u91cf\uff0c\u5373\u4e0d\u5305\u62ec\u4e4b\u524d\u6216\u4e4b\u540e\u6811\u6728\u8986\u76d6\u635f\u5931\u9020\u6210\u7684\u78b3\u6392\u653e\u3002\u6bdb\u78b3\u6392\u653e\u91cf\u8ba1\u5165\u5bf9\u5e94\u7684\u68ee\u6797\u78b3\u6392\u653e\u5c42\u3002", "f928da94c4189c5e639dd23d54752fad": "\u4e00\u4e9b\u8fb9\u754c\u5904\u7684\u79fb\u9664\u91cf\u51fa\u73b0\u5927\u5e45\u6ce2\u52a8\uff0c\u8fd9\u662f\u56e0\u4e3a\u4f7f\u7528\u4e86\u9488\u5bf9\u7279\u5b9a\u751f\u6001\u533a\u7684\u79fb\u9664\u56e0\u5b50\u3002\u79fb\u9664\u91cf\u7684\u53d8\u5316\u53d1\u751f\u5728\u4e24\u4fa7\u4f7f\u7528\u4e0d\u540c\u79fb\u9664\u56e0\u5b50\u7684\u751f\u6001\u533a\u8fb9\u754c\u3002", "e844877412286ca496cebf59514c9ee3": "\u79fb\u9664\u91cf\u6570\u636e\u4e2d\u6709\u65f6\u95f4\u4e0d\u4e00\u81f4\u7684\u60c5\u51b5\uff0c\u56e0\u4e3a\u6811\u6728\u8986\u76d6\u589e\u76ca\u8868\u793a 2000 \u5e74\u81f3 2020 \u5e74\u7684\u7d2f\u79ef\u603b\u91cf\uff0c\u800c\u4e0d\u662f\u622a\u81f3 2022 \u5e74\u7684\u5e74\u5ea6\u4f30\u7b97\u589e\u76ca\u3002", "d63ce4ab9166cdd5c99851e9502eaf9c": "\u8be5\u6570\u636e\u96c6\u5728\u9996\u6b21\u53d1\u5e03\u540e\u8fdb\u884c\u8fc7\u66f4\u65b0\u3002\u8bf7\u67e5\u770b\u6982\u8ff0\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002", "2ba5d4e142b77960b608c5dda8369b54": "\u4e3a\u4e86\u5411 GFW \u4e0a\u53ef\u7528\u7684\u5176\u4ed6\u6570\u636e\u5c42\u63d0\u4f9b\u80cc\u666f\uff0c\u6bd4\u5982\u89e3\u91ca\u9020\u6210\u6811\u6728\u8986\u76d6\u53d8\u5316\u7684\u539f\u56e0\uff0c\u9ad8\u5206\u8fa8\u7387\u536b\u661f\u56fe\u50cf\u5fc5\u4e0d\u53ef\u5c11\u3002\u5b83\u5e38\u7528\u6765\u67e5\u627e\u51c6\u5b9e\u65f6\u68ee\u6797\u7834\u574f\u8b66\u62a5\u7684\u53ef\u80fd\u539f\u56e0\u3002\u5b83\u8fd8\u53ef\u4ee5\u5728\u9a8c\u8bc1\u534f\u8bae\u4e2d\u4f7f\u7528\uff0c\u7528\u4e8e\u8bc4\u4f30\u571f\u5730/\u68ee\u6797\u8986\u76d6\u7684\u51c6\u786e\u6027\u53ca\u66f4\u6539\u4ea7\u54c1", "5e08d5629b0bb503b1f8e71a5e12260f": "\u663e\u793a\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u78b3\u7684\u51c0\u635f\u5931\uff0c\u8be5\u503c\u7b49\u4e8e\u6797\u5206\u7f6e\u6362\u5e72\u6270\u9020\u6210\u7684\u68ee\u6797\u78b3\u6392\u653e\u91cf\u4e0e\u68ee\u6797\u751f\u957f\u4ea7\u751f\u7684\u78b3\u79fb\u9664\u91cf\u4e4b\u95f4\u7684\u5dee\u503c&nbsp;", "d26bd619e86ab3b6b1a61c39b65f9c21": "\u51c0\u901a\u91cf\u53cd\u6620\u4e86 2001 \u81f3 2022 \u5e74\u6a21\u578b\u671f\u95f4\u7684\u603b\u91cf\uff0c\u800c\u4e0d\u662f\u53ef\u4ee5\u4ece\u4e2d\u5f97\u51fa\u8d8b\u52bf\u7684\u5e74\u5ea6\u65f6\u95f4\u5e8f\u5217\u3002\u56e0\u6b64\uff0c\u8981\u8ba1\u7b97\u5e73\u5747\u5e74\u51c0\u901a\u91cf\uff0c\u5fc5\u987b\u5c06\u503c\u9664\u4ee5 22\u3002", "0a1b40dad9e333e18d6dc15e1a19fdd0": "\u4e00\u4e9b\u8fb9\u754c\u5904\u7684\u51c0\u901a\u91cf\u51fa\u73b0\u5927\u5e45\u6ce2\u52a8\uff0c\u8fd9\u662f\u56e0\u4e3a\u4f7f\u7528\u4e86\u9488\u5bf9\u7279\u5b9a\u751f\u6001\u533a\u7684\u79fb\u9664\u56e0\u5b50\u3002\u51c0\u901a\u91cf\u7684\u53d8\u5316\u53d1\u751f\u5728\u4e24\u4fa7\u4f7f\u7528\u4e0d\u540c\u79fb\u9664\u56e0\u5b50\u7684\u751f\u6001\u533a\u8fb9\u754c\u3002", "10eabbb28b10e4ccc2ac057ae190ec49": "\u5371\u5730\u9a6c\u62c9\u51c6\u5907\u5e94\u5bf9\u739b\u96c5\u4fdd\u62a4\u533a\u68ee\u6797\u7834\u574f\u7a7a\u524d\u4e25\u91cd\u7684\u4e00\u5e74", "8c703da92a624ba08a65b7afe094f3f9": "\u67ec\u57d4\u5be8\u4fdd\u62a4\u533a\u7684\u65b0\u7279\u8bb8\u6743\u5f15\u8d77\u4e86\u6c11\u95f4\u793e\u4f1a\u56e2\u4f53\u7684\u62c5\u5fe7\uff0c\u56e0\u4e3a\u88ab\u7279\u8bb8\u4eba\u56e0\u975e\u6cd5\u4f10\u6728\u3001\u5f3a\u8feb\u8fc1\u79bb\u548c\u2026\u2026\u800c\u81ed\u540d\u8fdc\u64ad", "3d66164ce14cf40e0173340cd72aa20b": "\u67ec\u57d4\u5be8\u7687\u5bb6\u96c6\u56e2\u83b7\u5f97\u4e03\u661f\u6d77\u56fd\u5bb6\u516c\u56ed\u7684\u65b0\u7279\u8bb8\u6743", "a2cc6da463a0349c2dd5036f03261db6": "\u89c6\u9891\uff1a\u67ec\u57d4\u5be8\u666e\u96f7\u6717\u4fdd\u62a4\u533a\u7684\u771f\u76f8 | \u8ffd\u8e2a\u68ee\u6797\u7834\u574f", "0d2c161d77383a293052b32ea2d72f5e": "\u4eba\u5de5\u548c\u534a\u5de5\u4e1a\u91c7\u77ff\u5bf9\u970d\u5361\u76ae\u91ce\u751f\u52a8\u690d\u7269\u4fdd\u62a4\u533a\u6784\u6210\u4e25\u91cd\u5a01\u80c1\uff0c\u5bfc\u81f4\u68ee\u6797\u7834\u574f\u548c\u6c34\u9053\u6c61\u67d3\uff0c\u7279\u522b\u662f\u5728\u2026\u2026", "56cf17d0bdd7aa4e67d57ec627f17c75": "\u5728\u80af\u5c3c\u4e9a\u6db5\u517b\u6c34\u6e90\u7684\u6700\u5927\u68ee\u6797\uff0c\u7834\u574f\u4ecd\u5728\u7ee7\u7eed\uff0c\u536b\u661f\u663e\u793a", "7ffcfb331b5fcae526f8eef87b5b1b21": "\u201c\u8fd9\u771f\u662f\u4e00\u56e2\u7cdf\u201d\uff1a\u91c7\u77ff\u548c\u68ee\u6797\u7834\u574f\u5a01\u80c1\u7740\u521a\u679c\uff08\u91d1\uff09\u65e0\u4e0e\u4f26\u6bd4\u7684\u91ce\u751f\u52a8\u690d\u7269\u4e50\u56ed", "bf7bdcb5ba0e836742c3b176f0ddbbaf": "\u6797\u4e1a\u548c\u519c\u4e1a\u4e2d\u7684\u6b3a\u8bc8\u884c\u4e3a\u5bfc\u81f4\u5168\u56fd\u68ee\u6797\u5927\u91cf\u51cf\u5c11\uff0c\u800c\u9053\u8def\u7f51\u6269\u5f20\u8ba1\u5212\u2026\u2026", "c57ab01622d1b832b8c24eca0651ddec": "\u4f10\u6728\u548c\u4fee\u8def\u52a0\u5267\u5df4\u5e03\u4e9a\u65b0\u51e0\u5185\u4e9a\u7684\u68ee\u6797\u7f29\u51cf", "113780576501b890427b26ce0936d7cf": "\u5370\u5ea6\u5c3c\u897f\u4e9a\u9971\u53d7\u56f0\u6270\u7684\u6cf0\u7d22\u5c3c\u6d1b\u56fd\u5bb6\u516c\u56ed\u56e0\u68ee\u6797\u7834\u574f\u52a0\u5267\u800c\u906d\u53d7\u91cd\u521b\uff0c\u536b\u661f\u663e\u793a", "b7e3b8c363b7a83a92f8d60fc770b4d5": "\u201c\u6211\u4eec\u53ea\u60f3\u8fc7\u5e73\u9759\u7684\u751f\u6d3b\u201d\uff1a\u5728\u5df4\u897f\u4e9a\u9a6c\u900a\u5730\u533a\uff0c\u5927\u8c46\u96c4\u5fc3\u7b3c\u7f69\u7740\u539f\u4f4f\u6c11\u7684\u571f\u5730", "81d603bff9e44e5605b56755b86587a9": "\u663e\u793a\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u51c0\u901a\u91cf", "6ee776de1a6e1aab9f17ee9d3cbe988e": "\u7528\u4f5c\u4f30\u7b97\u57fa\u7840\u7684\u6d3b\u52a8\u6570\u636e\u4e2d\u6709\u65f6\u95f4\u4e0d\u4e00\u81f4\u7684\u60c5\u51b5\uff1a<br> - \u79fb\u9664\u91cf\u6570\u636e\u4e2d\u6709\u65f6\u95f4\u4e0d\u4e00\u81f4\u7684\u60c5\u51b5\uff0c\u56e0\u4e3a\u6811\u6728\u8986\u76d6\u589e\u76ca\u8868\u793a 2000 \u5e74\u81f3 2020 \u5e74\u7684\u7d2f\u79ef\u603b\u91cf\uff0c\u800c\u4e0d\u662f\u622a\u81f3 2022 \u5e74\u7684\u5e74\u5ea6\u4f30\u7b97\u589e\u76ca\u3002<br> - 2011 \u5e74\u81f3 2015 \u5e74\u671f\u95f4\uff0c\u7531\u4e8e\u65b0\u7684\u536b\u661f\u6570\u636e\u7684\u52a0\u5165\u548c\u65b9\u6cd5\u7684\u6539\u53d8\uff0c\u5bf9\u6811\u6728\u8986\u76d6\u635f\u5931\u7684\u68c0\u6d4b\u5f97\u5230\u6539\u8fdb\uff0c\u8fd9\u53ef\u80fd\u5bfc\u81f4\u8fd1\u5e74\u6765\u7684\u4f30\u7b97\u6392\u653e\u91cf\u9ad8\u4e8e\u524d\u51e0\u5e74\u3002\u8bf7\u53c2\u9605<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u4e86\u89e3\u66f4\u591a\u4fe1\u606f", "a100b733e022d2d9cfa4c7476fd99b61": "\u8be5\u6570\u636e\u96c6\u5728\u9996\u6b21\u53d1\u5e03\u540e\u8fdb\u884c\u8fc7\u66f4\u65b0\u3002\u8bf7\u67e5\u770b\u6982\u8ff0\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002&nbsp;", "3df1886b33d11244dfb56a3e416f5607": "\u739b\u96c5\u751f\u7269\u5708\u4fdd\u62a4\u533a\u6b63\u9762\u4e34\u7740\u6765\u81ea\u517b\u725b\u4e1a\u548c\u79cd\u690d\u4e1a\u4e0d\u65ad\u589e\u5927\u7684\u538b\u529b\uff0c\u540c\u65f6\u5e72\u65f1\u6709\u53ef\u80fd\u5f15\u53d1\u524d\u6240\u672a\u6709\u2026\u2026", "8defdd63eb329957bcc70d44fd892b0a": "\u67ec\u57d4\u5be8\u662f\u4e16\u754c\u4e0a\u68ee\u6797\u7834\u574f\u7387\u6700\u9ad8\u7684\u56fd\u5bb6\u4e4b\u4e00\uff0c\u6a2a\u8de8\u56db\u4e2a\u7701\u7684\u666e\u96f7\u6717\u91ce\u751f\u52a8\u690d\u7269\u4fdd\u62a4\u533a\u7684\u72b6\u51b5\u662f\u8c61\u5f81\u2026\u2026", "16f7260fd005fb239007c6736f3f778e": "\u9762\u5bf9\u8d2b\u56f0\u3001\u6218\u4e89\u548c\u8150\u8d25\u7684\u5730\u65b9\u653f\u5e9c\u90e8\u95e8\uff0c\u5580\u9ea6\u9686\u5317\u90e8\u7684\u5f53\u5730\u4eba\u548c\u96be\u6c11\u6b63\u5728\u65b0\u4fdd\u62a4\u533a\u780d\u4f10\u6811\u6728\uff0c\u4ee5\u83b7\u53d6\u6728\u67f4\u6216\u2026\u2026", "e5c718fe31e3988c2b02144028670a18": "\u6570\u5343\u79fb\u6c11\u6d8c\u5165\u5c3c\u65e5\u5229\u4e9a\u5357\u90e8\u5965\u5362\u74e6\u68ee\u6797\u4fdd\u62a4\u533a\uff0c\u4f7f\u96e8\u6797\u906d\u5230\u7834\u574f\u3002\u536b\u661f\u6570\u636e\u548c\u56fe\u50cf\u663e\u2026\u2026", "30c6e7ae75aac6baa017bf7559418d6d": "\u780d\u4f10\u5377\u571f\u91cd\u6765\uff1a\u7316\u7357\u7684\u4f10\u6728\u6d3b\u52a8\u4f7f\u65b0\u5b9e\u65bd\u7684\u8428\u8d6b\u52d2\u91cd\u65b0\u9020\u6797\u9879\u76ee\u5c8c\u5c8c\u53ef\u5371", "09875a5d302fcb619fc43a76d4b7bdf8": "\u8d2b\u56f0\u4e0e\u79cd\u690d\u56ed\uff1a\u5c3c\u65e5\u5229\u4e9a\u4fdd\u62a4\u533a\u9006\u5883\u6c42\u751f", "330dde4a5012ab4814830a8e977b9d8b": "\u65b0\u7684\u536b\u661f\u6570\u636e\u663e\u793a\uff0c\u5c3d\u7ba1\u4eba\u4eec\u4e3a\u4fdd\u62a4\u68ee\u6797\u4ed8\u51fa\u4e86\u52aa\u529b\uff0c\u80af\u5c3c\u4e9a\u8302\u68ee\u6797\u7684\u6811\u6728\u8986\u76d6\u4ecd\u5728\u51cf\u5c11\u3002\u73af\u4fdd\u4e3b\u4e49\u8005\u4e3b\u5f20\u66f4\u6709\u6548\u7684\u2026\u2026", "d3277b7f8d254b4695e3a30f4c27e4ff": "\u5c3c\u65e5\u5229\u4e9a\u963f\u83f2\u6cb3\u68ee\u6797\u4fdd\u62a4\u533a\u7684\u68ee\u6797\u7834\u574f\u4f7f\u6816\u606f\u5730\u7684\u7269\u79cd\u4e0d\u65ad\u51cf\u5c11\u3002\u636e\u62a5\u9053\uff0c\u4ece\u4fdd\u62a4\u533a\u8d70\u5931\u7684\u5927\u8c61\u2026\u2026", "b8a55953211931754b699873571e0276": "\u968f\u7740\u5c3c\u65e5\u5229\u4e9a\u68ee\u6797\u4fdd\u62a4\u533a\u4e2d\u6816\u606f\u5730\u5feb\u901f\u7f29\u51cf\uff0c\u5927\u8c61\u4fb5\u5165", "051a9994b76ee0c8c4c2ee903435c5a9": "\u5728\u5370\u5ea6\u5c3c\u897f\u4e9a\u82cf\u95e8\u7b54\u814a\u5c9b\u7684\u845b\u6797\u829d\u585e\u5e03\u62c9\u56fd\u5bb6\u516c\u56ed\uff0c\u5f88\u5927\u6bd4\u4f8b\u7684\u68ee\u6797\u7834\u574f\u662f\u7531\u9644\u8fd1\u4eba\u53e3\u7684\u4f10\u6728\u548c\u519c\u4e1a\u6d3b\u52a8\u9020\u6210\u7684\uff0c\u7279\u522b\u662f\u2026\u2026", "0f09eb8fae399b6f2423b2afa9820a89": "Terra do Meio \u751f\u6001\u7ad9\u662f\u4e00\u4e2a\u53d7\u8054\u90a6\u653f\u5e9c\u4fdd\u62a4\u7684\u539f\u59cb\u4fdd\u62a4\u533a\uff0c\u5728\u4e00\u6761\u7a7f\u8d8a......\u7684\u975e\u6cd5\u9053\u8def\u7684\u4fee\u5efa\u8fc7\u7a0b\u4e2d\u906d\u5230\u5165\u4fb5", "ef4bc199016d14a246975015f6464895": "\u975e\u653f\u5e9c\u7ec4\u7ec7 Global Conservation \u5f00\u59cb\u57f9\u8bad\u539f\u4f4f\u6c11\u5982\u4f55\u76d1\u6d4b\u548c\u6267\u884c\u68ee\u6797\u4fdd\u62a4\u6cd5\u89c4\u3002", "50f428ab55a55320cd2eedbadfbda4e1": "\u9ad8\u7f6e\u4fe1\u5ea6", "d2aaaf95365f91686c5bb529e209b60c": "\u4e3a\u4e86\u5411 GFW \u4e0a\u53ef\u7528\u7684\u5176\u4ed6\u6570\u636e\u5c42\u63d0\u4f9b\u80cc\u666f\uff0c\u6bd4\u5982\u89e3\u91ca\u9020\u6210\u6811\u6728\u8986\u76d6\u53d8\u5316\u7684\u539f\u56e0\uff0c\u9ad8\u5206\u8fa8\u7387\u536b\u661f\u56fe\u50cf\u5fc5\u4e0d\u53ef\u5c11\u3002\u5b83\u5e38\u7528\u6765\u67e5\u627e\u51c6\u5b9e\u65f6\u68ee\u6797\u7834\u574f\u8b66\u62a5\u7684\u53ef\u80fd\u539f\u56e0\u3002\u5b83\u8fd8\u53ef\u4ee5\u5728\u9a8c\u8bc1\u534f\u8bae\u4e2d\u4f7f\u7528\uff0c\u7528\u4e8e\u8bc4\u4f30\u571f\u5730/\u68ee\u6797\u8986\u76d6\u7684\u51c6\u786e\u6027\u53ca\u66f4\u6539\u4ea7\u54c1", "a181a603769c1f98ad927e7367c7aa51": "\u5168\u90e8", "e0617fb2b90427edbea7305752dbea12": "\u4e3a\u4e86\u5411 GFW \u4e0a\u53ef\u7528\u7684\u5176\u4ed6\u6570\u636e\u5c42\u63d0\u4f9b\u80cc\u666f\uff0c\u6bd4\u5982\u89e3\u91ca\u9020\u6210\u6811\u6728\u8986\u76d6\u53d8\u5316\u7684\u539f\u56e0\uff0c\u9ad8\u5206\u8fa8\u7387\u536b\u661f\u56fe\u50cf\u5fc5\u4e0d\u53ef\u5c11\u3002\u5b83\u5e38\u7528\u6765\u67e5\u627e\u51c6\u5b9e\u65f6\u68ee\u6797\u7834\u574f\u8b66\u62a5\u7684\u53ef\u80fd\u539f\u56e0\u3002\u5b83\u8fd8\u53ef\u4ee5\u5728\u9a8c\u8bc1\u534f\u8bae\u4e2d\u4f7f\u7528\uff0c\u7528\u4e8e\u8bc4\u4f30\u571f\u5730/\u68ee\u6797\u8986\u76d6\u7684\u51c6\u786e\u6027\u53ca\u66f4\u6539\u4ea7\u54c1.&nbsp;&nbsp;", "515284733c56e9f019de80d694ddd7f2": "\u901a\u8fc7\u632a\u5a01\u7684 International Climate &amp; Forests Initiative\uff0c\u4efb\u4f55\u4eba\u73b0\u5728\u90fd\u53ef\u4ee5\u8bbf\u95ee Planet \u7684\u53ef\u4f9b\u5206\u6790\u7684\u9ad8\u5206\u8fa8\u7387\u4e16\u754c\u70ed\u5e26\u9576\u5d4c\u56fe\uff0c\u4ee5\u5e2e\u52a9\u51cf\u7f13\u548c\u626d\u8f6c\u70ed\u5e26\u68ee\u6797\u7684\u51cf\u5c11\u3001\u5e94\u5bf9\u6c14\u5019\u53d8\u5316\u3001\u4fdd\u62a4\u751f\u7269\u591a\u6837\u6027\u548c\u4fc3\u8fdb\u53ef\u6301\u7eed\u53d1\u5c55\u3002&nbsp;\u81ea\u7136\u8272\u5f69\u56fe\u50cf\u4f7f\u7528\u53ef\u89c1\u5149\uff08\u7ea2\u8272\u3001\u7eff\u8272\u548c\u84dd\u8272\uff09\u7684\u4fe1\u606f\u6765\u663e\u793a\u5730\u7403\u8868\u9762\uff0c\u5c31\u50cf\u4eba\u773c\u770b\u5230\u7684\u90a3\u6837\u3002&nbsp;", "fb2a5fd21c725c4c659a7d2699db4143": "\u5927\u7ea6 1 \u5230 3 \u5e74&nbsp;", "d9b8bebf5058363428c30874f6ba1bda": "\u8be5\u6570\u636e\u663e\u793a\u4e86\u7b26\u5408 Sentinel-2 \u548c Landsat 8 \u7cfb\u7edf\u4e2d\u6240\u9009\u4e91\u5c42\u8986\u76d6\u6807\u51c6\u7684\u6700\u65b0\u536b\u661f\u56fe\u50cf\u3002Sentinel-2 \u7531\u6b27\u6d32\u822a\u5929\u5c40\u8fd0\u8425\uff0c\u63d0\u4f9b\u5206\u8fa8\u7387\u4e3a 10 \u7c73\u7684\u8986\u76d6\u5168\u7403\u7684\u56fe\u50cf\uff0c\u6bcf 10 \u5929\u66f4\u65b0\u4e00\u6b21\u3002\u7531\u7f8e\u56fd\u5730\u8d28\u8c03\u67e5\u5c40\u8fd0\u8425\u7684 Landsat 8 \u4e5f\u662f\u4e00\u9897\u5168\u7403\u536b\u661f\uff0c\u63d0\u4f9b\u5206\u8fa8\u7387\u4e3a 30 \u7c73\u7684\u56fe\u50cf\uff0c\u6bcf 16 \u5929\u66f4\u65b0\u4e00\u6b21\u3002&nbsp;\u4e24\u9897\u536b\u661f\u5747\u53ef\u63d0\u4f9b\u663e\u793a\u81ea\u7136\u8272\u5f69\u548c\u690d\u88ab\u5065\u5eb7\u72b6\u51b5\u7684\u56fe\u50cf\u3002\u81ea\u7136\u8272\u5f69\u56fe\u50cf\u4f7f\u7528\u53ef\u89c1\u5149\uff08\u7ea2\u8272\u3001\u7eff\u8272\u548c\u84dd\u8272\uff09\u7684\u4fe1\u606f\u6765\u663e\u793a\u5730\u7403\u8868\u9762\uff0c\u5c31\u50cf\u4eba\u773c\u770b\u5230\u7684\u90a3\u6837\u3002\u5f52\u4e00\u5316\u5dee\u5f02\u690d\u88ab\u6307\u6570 (NDVI) \u7528\u4e8e\u68c0\u6d4b\u690d\u88ab\u5065\u5eb7\u72b6\u51b5\uff0c\u8be5\u6307\u6570\u5305\u542b\u7ea2\u5149\u548c\u8fd1\u7ea2\u5916\u5149\u53cd\u5c04\u7387\u7684\u4fe1\u606f\u3002\u8be5\u65b9\u6cd5\u57fa\u4e8e\u8fd9\u6837\u4e00\u4e2a\u4e8b\u5b9e\uff1a\u5065\u5eb7\u7684\u690d\u88ab\u5438\u6536\u5927\u90e8\u5206\u53ef\u89c1\u5149\uff0c\u5e76\u5c06\u7167\u5c04\u5728\u5176\u8868\u9762\u4e0a\u7684\u5927\u90e8\u5206\u8fd1\u7ea2\u5916\u5149\u53cd\u5c04\u51fa\u53bb\u3002\u5728\u5bf9\u663e\u793a\u690d\u88ab\u5065\u5eb7\u72b6\u51b5\u7684\u56fe\u50cf\u8fdb\u884c\u89e3\u8bfb\u65f6\uff0c\u7ea2\u8272\u8868\u793a\u5065\u5eb7\u751f\u957f\u7684\u690d\u88ab\uff0c\u7eff\u8272\u8868\u793a\u88f8\u9732\u7684\u5730\u9762\uff0c\u9ed1\u8272\u8868\u793a\u6c34\u4f53\u3002&nbsp;", "9df63cdbfc63cd8e04f2778252349d66": "2012 \u5e74 1 \u6708\u81f3\u4eca", "26412da1f36327b9278e2a349154b7f9": "\u5168\u7403\u7ea2\u6811\u6797\u8303\u56f4 - 2020 \u5e74", "36c98c21be0bca628b9bd3b49493a3aa": "\u4fdd\u62a4\u533a - 2023 \u5e74 8 \u6708", "7c33a8988aef7dc75869d18efc27b17b": "\u68ee\u6797\u78b3\u6392\u653e\u91cf\u5e76\u4e0d\u53cd\u6620\u4ece\u751f\u6001\u7cfb\u7edf\u78b3\u5e93\u5230\u6728\u8d28\u6797\u4ea7\u54c1 (HWP) \u5e93\u7684\u78b3\u8f6c\u79fb\u3002", "d649ff2cfc80256dad412cfd5f40636c": "\u8be5\u6570\u636e\u96c6\u5728\u9996\u6b21\u53d1\u5e03\u540e\u8fdb\u884c\u8fc7\u66f4\u65b0\u3002\u8bf7\u67e5\u770b\u6982\u8ff0\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002&nbsp;&nbsp;", "4270349c0e9268fad1e0e6c108febede": "\u6bdb\u79fb\u9664\u91cf\u7684\u4e0d\u786e\u5b9a\u6027\u9ad8\u4e8e\u6392\u653e\u91cf\uff0c\u8fd9\u4e3b\u8981\u662f\u7531\u7f8e\u56fd\u548c\u6b27\u6d32\u4ee5\u5916\u7684\u5df2\u5efa\u6210\u6e29\u5e26\u68ee\u6797\u7684\u79fb\u9664\u56e0\u5b50\u7684\u4e0d\u786e\u5b9a\u6027\u9020\u6210\u7684", "28b57d6dcbf41814a6ee2ed7e7bcccb9": "\u8be5\u78b3\u79fb\u9664\u5c42\u662f <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021) \u6240\u63cf\u8ff0\u7684\u68ee\u6797\u78b3\u901a\u91cf\u6a21\u578b\u7684\u4e00\u90e8\u5206</a>\u3002\u672c\u6587\u4ecb\u7ecd\u4e86\u4e00\u4e2a\u7528\u4e8e\u4f30\u7b97\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u7684\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u8be5\u6846\u67b6\u53ef\u4ee5\u5e2e\u52a9\u5404\u79cd\u53c2\u4e0e\u8005\u548c\u7ec4\u7ec7\u8ddf\u8e2a\u68ee\u6797\u7684\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf\u3001\u51cf\u5c11\u6392\u653e\u91cf\u6216\u589e\u52a0\u68ee\u6797\u79fb\u9664\u91cf\u3002\u68ee\u6797\u78b3\u6c47\u4ece\u5927\u6c14\u4e2d\u79fb\u9664\uff08\u5c01\u5b58\uff09\u7684\u68ee\u6797\u78b3\u79fb\u9664\u91cf\u8868\u793a 2001 \u81f3 2022 \u5e74\u6a21\u578b\u671f\u95f4\u5df2\u5efa\u6210\u7684\u548c\u65b0\u518d\u751f\u7684\u68ee\u6797\u5728\u751f\u957f\u4e2d\u6355\u83b7\u7684\u7d2f\u79ef\u78b3\u91cf\uff08\u5146\u514b CO2/\u516c\u9877\uff09\u3002\u79fb\u9664\u91cf\u5305\u62ec\u5730\u4e0a\u548c\u5730\u4e0b\u6d3b\u6811\u751f\u7269\u91cf\u4e2d\u7684\u7d2f\u79ef\u78b3\u91cf\u3002\u6839\u636e IPCC Tier 1 \u5173\u4e8e\u4ecd\u4e3a\u68ee\u6797\u7684\u68ee\u6797 (forests remaining forests) \u7684\u5047\u8bbe\uff0c\u67af\u6728\u3001\u67af\u679d\u843d\u53f6\u548c\u571f\u58e4\u78b3\u5e93\u7684\u79fb\u9664\u91cf\u88ab\u5047\u5b9a\u4e3a\u96f6\u3002\u5728\u6bcf\u4e2a\u50cf\u7d20\u4e2d\uff0c\u78b3\u79fb\u9664\u91cf\u5747\u6309\u7167 IPCC \u7684<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u6307\u5357\u8ba1\u7b97\uff08\u68ee\u6797\u5728 2000 \u5e74\u5b58\u5728\uff0c\u6216\u6839\u636e <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Potapov et al. 2022\uff0c\u5728 2000 \u5e74\u81f3 2020 \u5e74\u95f4\u5efa\u6210</a>\uff09\u3002\u6bcf\u4e2a\u50cf\u7d20\u7684\u78b3\u79fb\u9664\u91cf\u6839\u636e\u7684\u662f\u68ee\u6797\u7c7b\u578b\uff08\u4f8b\u5982\u7ea2\u6811\u6797\u3001\u4eba\u5de5\u6797\uff09\u3001\u751f\u6001\u533a\uff08\u4f8b\u5982\u6e7f\u6da6\u7684\u65b0\u70ed\u5e26\u533a\uff09\u3001\u68ee\u6797\u5e74\u9f84\uff08\u4f8b\u5982\u539f\u751f\u6797\u3001\u8001\u6b21\u751f\u6797\uff09\u548c\u78b3\u79fb\u9664\u5e74\u6570\u7684\u5730\u56fe\u3002\u8be5\u56fe\u5c42\u53cd\u6620\u4e86\u6a21\u578b\u671f\u95f4\uff082001-2022\uff09\u7684\u7d2f\u79ef\u79fb\u9664\u91cf\uff0c\u5982\u8981\u8ba1\u7b97\u6a21\u578b\u671f\u95f4\u7684\u5e74\u5e73\u5747\u91cf\uff0c\u5fc5\u987b\u5c06\u503c\u9664\u4ee5 22\uff1b\u79fb\u9664\u7387\u4e0d\u80fd\u5206\u914d\u5230\u6a21\u578b\u7684\u5355\u4e2a\u5e74\u4efd\u3002<br>\u6240\u6709\u8f93\u5165\u56fe\u5c42\u5747\u91cd\u65b0\u91c7\u6837\u4e3a\u5e38\u7528\u5206\u8fa8\u7387 0.00025 x 0.00025 \u5ea6\u6bcf\u50cf\u7d20\uff0c\u4ee5\u4fbf\u4e0e<a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\"> Hansen et al. (2013)</a> \u5339\u914d\u3002\u968f\u7740 2022 \u5e74\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u7684\u52a0\u5165\uff0c\u5176\u4ed6\u4e00\u4e9b\u6a21\u578b\u8f93\u5165\u6570\u636e\u96c6\u548c\u5e38\u91cf\u4e5f\u53d1\u751f\u4e86\u53d8\u5316\uff0c\u5982\u4e0b\u6240\u8ff0\u3002\u8bf7\u53c2\u9605<a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8fd9\u7bc7\u535a\u5ba2\u6587\u7ae0</a>\u4e86\u89e3\u8be6\u60c5\u3002&nbsp;<br>1. \u5730\u4e0b\u78b3\u4e0e\u5730\u4e0a\u78b3\u6bd4\u7387\u7684\u6765\u6e90\u3002\u4ee5\u524d\u4f7f\u7528\u4e00\u4e2a\u5168\u5c40\u5e38\u91cf\uff1b\u73b0\u5728\u4f7f\u7528<a href=\"{{5}}\" target=\"_blank\" rel=\"noopener noreferrer\"> Huang et al. 2021 \u7684\u5730\u56fe</a>&nbsp;<br>2. \u6811\u6728\u8986\u76d6\u589e\u76ca\u7684\u5e74\u4efd\u3002\u4ee5\u524d\u4f7f\u7528 2000-2012 \u6570\u636e\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{6}}\" target=\"_blank\" rel=\"noopener noreferrer\">Potapov et al. 2022 \u7684 2000-2020 \u6570\u636e</a>\u3002&nbsp;<br>3. \u706b\u707e\u6570\u636e\u6765\u6e90\u3002\u4ee5\u524d\u4f7f\u7528 MODIS \u706b\u70e7\u8ff9\u5730\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{7}}\" target=\"_blank\" rel=\"noopener noreferrer\">Tyukavina et al. 2022</a> \u7684\u706b\u707e\u9020\u6210\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u3002<br>4. \u6ce5\u70ad\u5730\u56fe\u7684\u6765\u6e90\u3002\u52a0\u5165\u4e86\u65b0\u7684\u70ed\u5e26\u6570\u636e\u96c6\uff0c\u5e76\u5bf9\u5317\u7eac 40 \u5ea6\u4ee5\u4e0a\u7684\u6570\u636e\u96c6\u505a\u4e86\u6539\u52a8\u3002&nbsp;<br>5. CH4 \u548c N2O \u7684\u5168\u7403\u53d8\u6696\u6f5c\u52bf (GWP) \u5e38\u6570\u3002\u4ee5\u524d\u4f7f\u7528 IPCC \u7b2c\u4e94\u6b21\u8bc4\u4f30\u62a5\u544a\u4e2d\u7684 GWP\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{8}}\" target=\"_blank\" rel=\"noopener noreferrer\">IPCC \u7b2c\u516d\u6b21\u8bc4\u4f30\u62a5\u544a</a>\u4e2d\u7684 GWP\u3002<br>\u6709\u4e24\u79cd\u4e0d\u540c\u9762\u79ef\u5355\u4f4d\u7684\u79fb\u9664\u91cf\u53ef\u4f9b\u4e0b\u8f7d\uff1a1) \u5146\u514b CO2 \u79fb\u9664\u91cf/\u516c\u9877\uff0c\u4ee5\u53ca 2) \u5146\u514b CO2 \u79fb\u9664\u91cf/\u50cf\u7d20\u3002\u7b2c\u4e00\u4e2a\u9002\u7528\u4e8e\u76f4\u89c2\u663e\u793a\uff08\u7ed8\u5236\uff09\u79fb\u9664\u91cf\uff0c\u56e0\u4e3a\u5b83\u8868\u793a\u6bcf\u516c\u9877\u7684\u79fb\u9664\u5bc6\u5ea6\u3002 \u7b2c\u4e8c\u4e2a\u9002\u7528\u4e8e\u8ba1\u7b97\u611f\u5174\u8da3\u533a\u57df (AOI) \u4e2d\u7684\u79fb\u9664\u91cf\uff0c\u56e0\u4e3a\u60a8\u53ef\u4ee5\u5c06 AOI \u4e2d\u7684\u50cf\u7d20\u503c\u76f8\u52a0\uff0c\u6c42\u51fa\u8be5\u533a\u57df\u7684\u603b\u79fb\u9664\u91cf\u3002\u540e\u8005\u7684\u503c\u662f\u6839\u636e\u6bcf\u4e2a\u50cf\u7d20\u7684\u5927\u5c0f\uff08\u56e0\u7eac\u5ea6\u800c\u5f02\uff09\u8c03\u6574\u6bcf\u516c\u9877\u7684\u79fb\u9664\u91cf\u4e4b\u540e\u8ba1\u7b97\u51fa\u6765\u7684\u3002\u5728\u4f30\u7b97 2001 \u5e74\u81f3 2022 \u5e74\u671f\u95f4\u6307\u5b9a\u5e74\u6570\u7684\u79fb\u9664\u91cf\uff0c\u5e76\u4e0e\u6392\u653e\u91cf\u8fdb\u884c\u6bd4\u8f83\u65f6\uff0c\u60a8\u9700\u8981\u5c06\u603b\u78b3\u79fb\u9664\u91cf\u9664\u4ee5\u6a21\u578b\u65f6\u957f\uff0c\u7136\u540e\u4e58\u4ee5\u611f\u5174\u8da3\u65f6\u671f\u7684\u5e74\u6570\u3002\u4e24\u4e2a\u6570\u636e\u96c6\u90fd\u53ea\u5305\u542b\u68ee\u6797\u5185\u7684\u50cf\u7d20\uff0c\u5982 Harris et al. (2021) \u4e2d\u7684\u65b9\u6cd5\u6240\u5b9a\u4e49\u7684\uff0c\u5e76\u4e14\u6811\u6728\u8986\u76d6\u589e\u76ca\u90fd\u66f4\u65b0\u5230\u4e86 2020 \u5e74", "4dcb6980a3a25cd1c403a87908e93182": "\u6388\u4e88 3 \u4e2a\u91d1\u989d\u4ecb\u4e8e $10,000 \u548c $40,000 \u4e4b\u95f4\u7684\u5956\u9879\u3002", "4536ab5f52c147a6e50b0c73a8756a22": "\u8be5\u51c0\u901a\u91cf\u5c42\u662f Harris et al. (2021) \u6240\u63cf\u8ff0\u7684\u68ee\u6797\u78b3\u901a\u91cf\u6a21\u578b\u7684\u4e00\u90e8\u5206\u3002\u672c\u6587\u4ecb\u7ecd\u4e86\u4e00\u4e2a\u7528\u4e8e\u4f30\u7b97\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u7684\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u8be5\u6846\u67b6\u53ef\u4ee5\u5e2e\u52a9\u5404\u79cd\u53c2\u4e0e\u8005\u548c\u7ec4\u7ec7\u8ddf\u8e2a\u68ee\u6797\u7684\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf\u3001\u51cf\u5c11\u6392\u653e\u91cf\u6216\u589e\u52a0\u68ee\u6797\u79fb\u9664\u91cf\u3002\u68ee\u6797\u51c0\u78b3\u901a\u91cf\u8868\u793a\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u78b3\u7684\u51c0\u635f\u5931\uff0c\u8be5\u503c\u7b49\u4e8e\u6a21\u578b\u671f\u95f4\u68ee\u6797\u78b3\u6392\u653e\u91cf\u4e0e\u78b3\u79fb\u9664\uff08\u5c01\u5b58\uff09\u91cf\u4e4b\u95f4\u7684\u5dee\u503c\u3002\u51c0\u78b3\u901a\u91cf\u7684\u8ba1\u7b97\u65b9\u6cd5\u662f\u7528\u6bcf\u4e2a\u68ee\u6797\u50cf\u7d20\u7684\u5e74\u6bdb\u6392\u653e\u91cf\u51cf\u53bb\u5e73\u5747\u6bdb\u79fb\u9664\u91cf\uff1b\u8d1f\u503c\u8868\u793a 2001 \u5e74\u81f3 2022 \u5e74\u95f4\u68ee\u6797\u662f\u51c0\u78b3\u6c47\uff0c\u6b63\u503c\u8868\u793a\u68ee\u6797\u662f\u51c0\u78b3\u6e90\u3002\u5728\u6bcf\u4e2a\u50cf\u7d20\u4e2d\uff0c\u51c0\u901a\u91cf\u5747\u6309\u7167 IPCC \u7684\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355\u6307\u5357\u8ba1\u7b97\uff08\u68ee\u6797\u5728 2000 \u5e74\u5b58\u5728\uff0c\u6216\u6839\u636e <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Potapov et al. 2022\uff0c\u5728 2000 \u5e74\u81f3 2020 \u5e74\u95f4\u5efa\u6210</a>\uff09\u3002\u8be5\u56fe\u5c42\u53cd\u6620\u4e86\u6a21\u578b\u671f\u95f4\uff082001-2022\uff09\u7684\u7d2f\u79ef\u51c0\u901a\u91cf\uff0c\u5982\u8981\u8ba1\u7b97\u5e73\u5747\u5e74\u51c0\u901a\u91cf\uff0c\u5fc5\u987b\u5c06\u503c\u9664\u4ee5 22\uff1b\u51c0\u901a\u91cf\u4e0d\u80fd\u5206\u914d\u5230\u6a21\u578b\u7684\u5355\u4e2a\u5e74\u4efd\u3002<br>\u6240\u6709\u8f93\u5165\u56fe\u5c42\u5747\u91cd\u65b0\u91c7\u6837\u4e3a\u5e38\u7528\u5206\u8fa8\u7387 0.00025 x 0.00025 \u5ea6\u6bcf\u50cf\u7d20\uff0c\u4ee5\u4fbf\u4e0e Hansen et al. (2013) \u5339\u914d\u3002\u968f\u7740 2022 \u5e74\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u7684\u52a0\u5165\uff0c\u5176\u4ed6\u4e00\u4e9b\u6a21\u578b\u8f93\u5165\u6570\u636e\u96c6\u548c\u5e38\u91cf\u4e5f\u53d1\u751f\u4e86\u53d8\u5316\uff0c\u5982\u4e0b\u6240\u8ff0\u3002\u8bf7\u53c2\u9605<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8fd9\u7bc7\u535a\u5ba2\u6587\u7ae0</a>\u4e86\u89e3\u8be6\u60c5\u3002<br>1. \u5730\u4e0b\u78b3\u4e0e\u5730\u4e0a\u78b3\u6bd4\u7387\u7684\u6765\u6e90\u3002\u4ee5\u524d\u4f7f\u7528\u4e00\u4e2a\u5168\u5c40\u5e38\u91cf\uff1b\u73b0\u5728\u4f7f\u7528<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\"> Huang et al. 2021 \u7684\u5730\u56fe</a>&nbsp;<br>2. \u6811\u6728\u8986\u76d6\u589e\u76ca\u7684\u5e74\u4efd\u3002\u4ee5\u524d\u4f7f\u7528 2000-2012 \u6570\u636e\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Potapov et al. 2022 \u7684 2000-2020 \u6570\u636e</a>\u3002&nbsp;<br>3. \u706b\u707e\u6570\u636e\u6765\u6e90\u3002\u4ee5\u524d\u4f7f\u7528 MODIS \u706b\u70e7\u8ff9\u5730\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">Tyukavina et al. 2022</a> \u7684\u706b\u707e\u9020\u6210\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u3002 <br>4. \u6ce5\u70ad\u5730\u56fe\u7684\u6765\u6e90\u3002\u52a0\u5165\u4e86\u65b0\u7684\u70ed\u5e26\u6570\u636e\u96c6\uff0c\u5e76\u5bf9\u5317\u7eac 40 \u5ea6\u4ee5\u4e0a\u7684\u6570\u636e\u96c6\u505a\u4e86\u6539\u52a8\u3002&nbsp;<br>5. CH4 \u548c N2O \u7684\u5168\u7403\u53d8\u6696\u6f5c\u52bf (GWP) \u5e38\u6570\u3002\u4ee5\u524d\u4f7f\u7528 IPCC \u7b2c\u4e94\u6b21\u8bc4\u4f30\u62a5\u544a\u4e2d\u7684 GWP\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{5}}\" target=\"_blank\" rel=\"noopener noreferrer\">IPCC \u7b2c\u516d\u6b21\u8bc4\u4f30\u62a5\u544a</a>\u4e2d\u7684 GWP\u3002<br>\u6709\u4e24\u79cd\u4e0d\u540c\u9762\u79ef\u5355\u4f4d\u7684\u51c0\u901a\u91cf\u53ef\u4f9b\u4e0b\u8f7d\uff1a1) \u5146\u514b CO2 \u6392\u653e\u91cf/\u516c\u9877\uff0c\u4ee5\u53ca 2) \u5146\u514b CO2 \u6392\u653e\u91cf/\u50cf\u7d20\u3002\u7b2c\u4e00\u4e2a\u9002\u7528\u4e8e\u76f4\u89c2\u663e\u793a\uff08\u7ed8\u5236\uff09\u51c0\u901a\u91cf\uff0c\u56e0\u4e3a\u5b83\u8868\u793a\u6bcf\u516c\u9877\u7684\u78b3\u901a\u91cf\u5bc6\u5ea6\u3002 \u7b2c\u4e8c\u4e2a\u9002\u7528\u4e8e\u8ba1\u7b97\u611f\u5174\u8da3\u533a\u57df (AOI) \u4e2d\u7684\u51c0\u901a\u91cf\uff0c\u56e0\u4e3a\u60a8\u53ef\u4ee5\u5c06 AOI \u4e2d\u7684\u50cf\u7d20\u503c\u76f8\u52a0\uff0c\u6c42\u51fa\u8be5\u533a\u57df\u7684\u603b\u78b3\u901a\u91cf\u3002\u540e\u8005\u7684\u503c\u662f\u6839\u636e\u6bcf\u4e2a\u50cf\u7d20\u7684\u5927\u5c0f\uff08\u56e0\u7eac\u5ea6\u800c\u5f02\uff09\u8c03\u6574\u6bcf\u516c\u9877\u7684\u79fb\u9664\u91cf\u4e4b\u540e\u8ba1\u7b97\u51fa\u6765\u7684\u3002\u5728\u4f30\u7b97 2001 \u5e74\u81f3 2022 \u5e74\u671f\u95f4\u6307\u5b9a\u5e74\u6570\u7684\u51c0\u901a\u91cf\u65f6\uff0c\u60a8\u9700\u8981\u5c06\u503c\u9664\u4ee5\u6a21\u578b\u65f6\u957f\uff0c\u7136\u540e\u4e58\u4ee5\u611f\u5174\u8da3\u65f6\u671f\u7684\u5e74\u6570\u3002\u4e24\u4e2a\u6570\u636e\u96c6\u90fd\u53ea\u5305\u542b\u68ee\u6797\u5185\u7684\u50cf\u7d20\uff0c\u5982 Harris et al. (2021) \u4e2d\u7684\u65b9\u6cd5\u6240\u5b9a\u4e49\u7684\uff0c\u5e76\u4e14\u6811\u6728\u8986\u76d6\u589e\u76ca\u90fd\u66f4\u65b0\u5230\u4e86 2020 \u5e74\u3002&nbsp;<br>&nbsp;&nbsp;", "69d07baed7bc17e10ad87e79825f666c": "\u8d29\u6bd2\u5371\u53ca\u79d8\u9c81\u4e9a\u9a6c\u900a\u5730\u533a\u7684\u56fd\u5bb6\u516c\u56ed\u548c\u539f\u4f4f\u6c11\u4fdd\u62a4\u533a", "e5d1aa675938dbd19777814b91bb0a3a": "\u5982\u679c\u5bf9\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u6216\u6280\u672f\u7814\u7a76\u5458\u9879\u76ee\u6709\u7591\u95ee\uff0c\u6216\u8005\u5e0c\u671b\u9879\u76ee\u4e0b\u4e00\u6b21\u5bf9\u5916\u5f00\u653e\u65f6\u6536\u5230\u901a\u77e5\uff0c\u8bf7\u7ed9\u6211\u4eec\u53d1\u9001\u90ae\u4ef6\uff1a<a href=\"{{0}}\">gfwfund@wri.org</a>", "f2770315a8783cc2088e3d53990fba4e": "\u6211\u4eec\u76ee\u524d\u4e0d\u63a5\u53d7 GFW \u6280\u672f\u7814\u7a76\u5458\u9879\u76ee\u7533\u8bf7\u3002\u5982\u8981\u8fdb\u4e00\u6b65\u4e86\u89e3\u6280\u672f\u7814\u7a76\u5458\u9879\u76ee\uff0c\u8bf7\u53c2\u9605\u6211\u4eec\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">\u5e38\u89c1\u95ee\u9898\u89e3\u7b54</a>\u3002", "85e2f09c2c9372f63d188036c909f8d4": "\u89c2\u770b <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">2023 \u5e74\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u7533\u8bf7\u4eba\u7f51\u7edc\u7814\u8ba8\u4f1a</a>\u7684\u5f55\u50cf", "43ef4e78c1db512dc75f2efba2de3a86": "\u4e0e GFW \u5efa\u7acb\u5408\u4f5c\u4f19\u4f34\u5173\u7cfb\u3002", "b3b3a6ac74ecbd56bcdbefa4799fb9df": "\u4e9a\u9a6c\u900a", "71fd2100e4844adf083859f496720215": "\u4e3b\u9898", "fbebe083c5b1b5e088996c28fb19f9e4": "\u78b3", "605bc46570621bdf3f7bed23112155dc": "\u5bb6\u755c", "71b5ee5a967359a5749416b856f3f301": "\u53ef\u53ef", "16b0988ee0c916c258e1e7f0cccf3c17": "\u6240\u6709\u6587\u7ae0", "284f95e407948989065bc887cd3c9069": "\u68ee\u6797\u54c1\u8d28", "1666159520ca14a037c678afd8769fa3": "\u68d5\u6988\u6cb9", "51359e8b51c63b87d50cb1bab73380e2": "\u653f\u7b56", "fa842aab8895c16045b781d27a16d2e2": "\u6062\u590d", "8db7df66ab1d7ab5f1dc947acdb5fae4": "\u8bb0\u5f55", "e2ad35114a1297215a3adfec3df007bc": "\u7cbe\u9009\u6587\u7ae0", "d7a57b58e976247d141e17e20e1692d5": "\u6765\u5bbe\u5e16\u5b50", "0014f8b96d996135614c21355a053994": "\u5236\u56fe", "ea2ddd68250b44a031a25094993d1434": "\u539f\u4f4f\u6c11\u548c\u672c\u5730\u793e\u533a", "cdab0604d0c576c76a1b9368167dad43": "\u7528\u6237\u5728\u884c\u52a8", "de5601c0d7a14e6e03d9cef0ebf8c16d": "\u6570\u636e\u548c\u5de5\u5177", "3a75f475ae2b8fbc36088b70b251ecab": "\u68ee\u6797\u6d1e\u5bdf", "41d0a08ef480e07869dfff00d6c7e63c": "\u535a\u5ba2\u8bbe\u8ba1\u66f4\u65b0", "2c2a74c1e8cb5013eabcea40af908e2c": "GFW \u535a\u5ba2\u73b0\u5728\u6709\u4e86\u65b0\u5916\u89c2\uff0c\u5e76\u66f4\u65b0\u4e86\u7b5b\u9009\u6761\u4ef6\u3002<a href=\"{{0}}\" rel=\"noopener\" target=\"_blank\">\u56db\u5904\u770b\u770b\uff01</a>", "f6068daa29dbb05a7ead1e3b5a48bbee": "\u6570\u636e", "7dc1d31827b6ed0e1661f49695cc5e39": "\u68ee\u6797\u76d1\u6d4b\u548c\u6267\u6cd5", "9c6861f62734c2faf951aa516dce3857": "\u662f\u7684\uff0c\u53ea\u8981\u63d0\u6848\u7684\u9879\u76ee\u8303\u56f4\u4e0d\u540c\uff0c\u4e14\u4e0d\u4f1a\u88ab\u89c6\u4e3a\u91cd\u590d\u63d0\u4ea4\u3002", "3ef8e4bb8a48361148d2c8b6dc55565d": "\u5c0f\u989d\u8d44\u52a9\u91d1 2024 \u8d44\u52a9\u5468\u671f\u7684\u6700\u7ec8\u5165\u56f4\u8005\u5c06\u4e8e 2024 \u5e74 4 \u6708\u5de6\u53f3\u6536\u5230\u901a\u77e5\u3002", "7a52f1d3b40ba37e58840d55ff9ac046": "\u8d85\u8fc7 <strong>6,000</strong> \u4eba\u63a5\u53d7\u4e86 GFW \u4f7f\u7528\u57f9\u8bad", "badf86fc5d4fa1029a71efaf77ad5aed": "2024 \u5e74\u5c0f\u989d\u8d44\u52a9\u91d1 (Small Grants Fund) \u5468\u671f\u5df2\u5f00\u653e\u7533\u8bf7\uff01<a target=\"_blank\" href=\"{{0}}\" rel=\"noopener\">\u5728\u6b64\u5904\u62a5\u540d\u53c2\u52a0\u7533\u8bf7\u8005\u7f51\u7edc\u7814\u8ba8\u4f1a</a>\uff0c\u4ee5\u4fbf\u4e86\u89e3\u6709\u5173\u7533\u8bf7\u6d41\u7a0b\u548c\u8d44\u683c\u8981\u6c42\u7684\u66f4\u591a\u4fe1\u606f\u3002", "9087e939e0944a351659e2ecfaec1dc5": "\u4eba\u4eec\u91c7\u7528 GFW \u76d1\u6d4b\u8d85\u8fc7 <strong>8.4</strong><b> \u4ebf\u516c\u9877</b>\u7684\u68ee\u6797", "c259702029d3cd11e00e14cbe0b7acd5": "\u9605\u8bfb 2024 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">\u7533\u8bf7\u8005\u6307\u5357</a>", "749b905c11b82f067d063f8e7b97c208": "\u5982\u679c\u60a8\u4e0d\u719f\u6089 SurveyMonkey \u7533\u8bf7\u5e73\u53f0\uff0c\u8bf7\u67e5\u770b\u8be5\u5e73\u53f0", "57b4bb1e29e88b3b78371c8836da6de0": "\u6307\u5357\u5728\u8fd9\u91cc", "fe51451e15cdea8994fab0a0bf5e8430": "\u5982\u679c\u5c0f\u989d\u8d44\u52a9\u91d1\u7533\u8bf7\u8005\u5165\u9009/\u672a\u5165\u9009\uff0c\u4ed6\u4eec\u4f55\u65f6\u4f1a\u6536\u5230\u901a\u77e5\uff1f", "f0a37ebe786a54e6056a1f308ef41bf6": "\u53ea\u6709\u88ab\u5408\u6cd5\u6307\u5b9a\u4e3a\u975e\u8425\u5229\u548c\u975e\u653f\u5e9c\u7ec4\u7ec7\u7684\u673a\u6784\u624d\u6709\u8d44\u683c\u7533\u8bf7\u5c0f\u989d\u8d44\u52a9\u91d1 (Small Grants Fund) \u3002\u60a8\u53ef\u4ee5\u67e5\u770b\u8d44\u683c\u6807\u51c6\uff0c\u5305\u62ec\u9879\u76ee\u6240\u5728\u56fd\u7684\u7533\u8bf7\u8d44\u683c", "e053f3a00f188184dea13e8951c95fd6": "\u6240\u6709\u7533\u8bf7\u90fd\u5fc5\u987b\u6e05\u695a\u5730\u9610\u660e GFW \u5c06\u5982\u4f55\u5728\u9879\u76ee\u4e2d\u53d1\u6325\u5173\u952e\u4f5c\u7528\u3002\u5982\u9700\u4e86\u89e3\u6709\u5173\u5982\u4f55\u4f7f\u7528 GFW \u7684\u66f4\u591a\u4fe1\u606f\uff0c\u60a8\u53ef\u4ee5\u67e5\u770b<a href=\"{{0}}\">\u5e2e\u52a9\u4e2d\u5fc3</a>\u7684\u5e2e\u52a9\u6750\u6599\u3002", "08966f27a5067c13da431f45b755b04a": "\u6210\u529f\u5b8c\u6210\u9879\u76ee\u7684\u5c0f\u989d\u8d44\u52a9\u91d1\u83b7\u5f97\u8005\u548c\u6280\u672f\u7814\u7a76\u5458\u5c06\u7ee7\u7eed\u6210\u4e3a\u6211\u4eec\u8d44\u52a9\u91d1 &amp; \u6280\u672f\u7814\u7a76\u91d1&nbsp; \u9879\u76ee\u7684\u6bd5\u4e1a\u6210\u5458\uff0c\u5e76\u6210\u4e3a GFW \u5408\u4f5c\u7684\u4e00\u90e8\u5206\uff0c\u5176\u4e2d\u5305\u62ec\u53d7\u9080\u53c2\u52a0 GFW \u7528\u6237\u793e\u533a\u7684\u6d3b\u52a8\u3002\u5728\u8d44\u91d1\u5f85\u5b9a\u7684\u60c5\u51b5\u4e0b\uff0c\u6211\u4eec\u8fd8\u5e0c\u671b\u6bd5\u4e1a\u6210\u5458\u4eec\u80fd\u591f\u6307\u5bfc\u65b0\u7684\u8d44\u52a9\u91d1\u83b7\u5f97\u8005\u6216\u7814\u7a76\u5458\uff0c\u5e76\u63d0\u4f9b\u5fae\u578b\u8d44\u52a9\u91d1\u4f7f\u4ed6\u4eec\u80fd\u591f\u7ee7\u7eed\u5f00\u5c55\u6d3b\u52a8\u3002", "fb82a66b3253df2daffe2f8656891361": "\u89c2\u770b GFW \u5c0f\u989d\u8d44\u52a9\u91d1\u7f51\u7edc\u7814\u8ba8\u4f1a\uff0c\u8be6\u7ec6\u4e86\u89e3\u8be5\u57fa\u91d1\u5982\u4f55\u5411\u4e16\u754c\u5404\u5730\u7684\u7ec4\u7ec7\u63d0\u4f9b\u8d44\u91d1\u548c\u6280\u672f\u652f\u6301\u4ee5\u4fbf\u4f7f\u7528 GFW \u7684\u5de5\u5177\u548c\u6570\u636e\u5c06\u68ee\u6797\u76d1\u6d4b\u4fe1\u606f\u8f6c\u5316\u4e3a\u884c\u52a8\u3002", "c13c5a9a44b24e610595ae2c7e429e7e": "\u5c0f\u989d\u8d44\u52a9\u91d1 (Small Grants Fund) \u6982\u51b5", "76e6a29b5191b280b4e2bab7b8525e13": "\u6765\u81ea <b>30 \u4e2a\u56fd\u5bb6</b>\u7684 <b>102 \u4e2a\u9879\u76ee</b>", "142ed0b3968f053cf809dc8beb3f497c": "\u5c0f\u989d\u8d44\u52a9\u91d1 (Small Grants Fund) \u7533\u8bf7\u8005\u7f51\u7edc\u7814\u8ba8\u4f1a", "586a7f953c216660c1203d80fc9a91ed": "Global Forest Watch \u5c0f\u989d\u8d44\u52a9\u91d1\u65e8\u5728\u901a\u8fc7\u5c06 GFW \u7eb3\u5165\u68ee\u6797\u76d1\u6d4b\u6218\u7565\uff0c\u52a0\u5f3a\u6c11\u95f4\u793e\u4f1a\u7ec4\u7ec7\u7684\u80fd\u529b\uff0c\u4ee5\u51cf\u5c11\u975e\u6cd5\u6216\u65e0\u8ba1\u5212\u7684\u68ee\u6797\u780d\u4f10\u5e76\u4ee5\u53ef\u6301\u7eed\u7684\u65b9\u5f0f\u7ba1\u7406\u68ee\u6797\u3002\u6210\u529f\u7684\u9879\u76ee\u5c06\u6570\u636e\u8f6c\u5316\u4e3a\u884c\u52a8\uff0c\u5e94\u7528 GFW \u6765\u6218\u80dc\u4e16\u754c\u68ee\u6797\u4fdd\u62a4\u4e2d\u7684\u6311\u6218\u3002", "cba1fb780acc3ebfb19c26075e62b63a": "\u6709\u5173 2024 \u8d44\u52a9\u5468\u671f\u7684\u4fe1\u606f\uff0c\u8bf7\u70b9\u51fb\u4e0b\u9762\u7684\u94fe\u63a5\u3002", "dfee28f7bdac3e4e37171872b1f80023": "\u62a5\u540d\u53c2\u52a0<a href=\"{{0}}\"> 2024 \u5c0f\u989d\u8d44\u52a9\u91d1\u7533\u8bf7\u8005\u7f51\u7edc\u7814\u8ba8\u4f1a</a>\uff0c\u8be5\u7814\u8ba8\u4f1a\u5c06\u4e8e\u7f8e\u56fd\u4e1c\u90e8\u65f6\u95f4 <strong>1 \u6708 30 \u65e5\u4e0a\u5348 9 \u70b9\u4e3e\u884c</strong>", "0233e15da6a5aebf1a31002fd78376b4": "2024 \u8d44\u52a9\u5468\u671f\u7533\u8bf7\u5f00\u653e\u81f3\u7f8e\u56fd\u4e1c\u90e8\u65f6\u95f4 <strong>2024 \u5e74 2 \u6708 13 \u65e5\u665a\u4e0a 23:59</strong>\u3002<a href=\"{{0}}\"><strong>\u7acb\u5373\u7533\u8bf7</strong></a>\u3002", "1c8e53a131dc9721ae1aa3c1b76564ed": "\u5f88\u9057\u61be\uff0c\u6211\u4eec\u53ea\u63a5\u53d7\u82f1\u6587\u7533\u8bf7\u3002\u8bf7\u8bbf\u95ee", "eb599a402dc0ffd8adf5dccd1bdcb6a3": "2024 \u5e74\u8d44\u52a9\u5468\u671f\u5f00\u653e\u7533\u8bf7\u7684\u622a\u6b62\u65f6\u95f4\u662f<strong>\u7f8e\u56fd\u4e1c\u90e8\u6807\u51c6\u65f6\u95f4 2024 \u5e74 2 \u6708 13 \u65e5\u5348\u591c 23:59</strong>\u3002<strong>\u7533\u8bf7\u5fc5\u987b\u4ee5\u82f1\u8bed\u63d0\u4ea4\uff0c\u5426\u5219\u4e0d\u4e88\u8003\u8651\u3002<a href=\"{{0}}\">\u7acb\u5373\u7533\u8bf7</a>\u3002</strong>", "f1c9e9af80bb533618f5bdefe333747d": "\u771f\u77e5\u707c\u89c1\n", "44d6f0b06fe487be1409890932d29234": "\u8bf7\u4e8e\u7f8e\u56fd\u4e1c\u90e8\u65f6\u95f44\u67084\u65e5\u4e0a\u53489\u70b9\uff0c\u53c2\u52a0\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240\u7684Global Forest Watch\u5bf9\u9a6c\u91cc\u5170\u5927\u5b66GLAD\u5b9e\u9a8c\u5ba4\u7684\u6700\u65b0\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u7684\u5206\u6790\u62a5\u544a\u3002<a href=\"{{0}}\" rel=\"noopener\" target=\"_blank\">\u70b9\u51fb\u6b64\u5904\u62a5\u540d\u3002</a>", "e32b02530c2762e13d2a10ef3ce68646": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a2023\u5e74\u7684\u68ee\u6797\u635f\u5931", "e4120aefffef803e7169bb07bfabe729": "\u8bf7\u6ce8\u610f\uff0c\u60a8\u7684 Forest Watcher \u8d26\u53f7\u4e0e\u8bb8\u591a\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240 (WRI) \u7684\u5e94\u7528\u7a0b\u5e8f\u8d26\u53f7\u662f\u901a\u7528\u7684\u3002\u8fd9\u5305\u62ec\uff1a", "8c4f5488860d00a650add909920b33d0": "\u8981\u5220\u9664\u60a8\u7684\u8d26\u53f7\uff0c\u8bf7\u4f7f\u7528\u4e0e\u60a8\u5e0c\u671b\u5220\u9664\u7684\u8d26\u53f7\u76f8\u540c\u7684\u7535\u5b50\u90ae\u4ef6\u5730\u5740\u53d1\u9001\u90ae\u4ef6\u81f3 <strong>forestwatcher@wri.org</strong> \u4e0e\u6211\u4eec\u8054\u7cfb\u3002", "873463a78257122a122600c9d7f7e8a7": "\u5982\u679c\u60a8\u5220\u9664\u60a8\u7684 Forest Watcher \u8d26\u53f7\uff0c\u60a8\u5c06\u65e0\u6cd5\u518d\u4f7f\u7528\u8be5\u8d26\u53f7\u8bbf\u95ee\u8fd9\u4e9b\u5e94\u7528\u7a0b\u5e8f\u3002\u5982\u679c\u60a8\u5c06\u6765\u60f3\u4f7f\u7528\u8fd9\u4e9b\u5e94\u7528\u7a0b\u5e8f\uff0c\u5219\u9700\u8981\u91cd\u65b0\u6ce8\u518c\u4e00\u4e2a\u8d26\u53f7\u3002", "246e578036601f94ce0cc0246739ceed": "2023\u5e74\u6811\u6728\u8986\u76d6\u635f\u5931\u60c5\u51b5\u7684\u6570\u636e\u5206\u6790", "6e58d1573785c451cb0db3433bcadecd": "\u68ee\u6797\u8986\u76d6\u51cf\u5c11 - 2001-2023", "42fe079a3ea3c21a5441d555c8bc06f5": "\"\u5728\u8fd9\u7ec4\u6570\u636e\u96c6\u4e2d\uff0c\u201c\u6797\u6728\u8986\u76d6\u201d\u88ab\u5b9a\u4e49\u4e3a\u6240\u6709\u9ad8\u4e8e5\u7c73\u7684\u690d\u88ab\uff0c\u800c\u4e14\u53ef\u80fd\u91c7\u53d6\u4e00\u5217\u6797\u51a0\u90c1\u95ed\u5ea6\u5185\u7684\u81ea\u7136\u68ee\u6797\u6216\u4eba\u5de5\u6797\u7684\u5f62\u5f0f\u3002\u201c\u635f\u5931\u201d\u6307\u7684\u662f\u6797\u6728\u8986\u76d6\u7684\u53bb\u9664\u548c\u6b7b\u4ea1\u7387\uff0c\u8fd9\u53ef\u80fd\u662f\u7531\u4e8e\u5404\u79cd\u56e0\u7d20\u9020\u6210\u7684\uff0c\u5305\u62ec\u673a\u68b0\u780d\u4f10\u3001\u706b\u707e\u3001\u75be\u75c5\u6216\u98ce\u66b4\u9020\u6210\u7684\u635f\u5931\u3002\u56e0\u6b64\uff0c\u201c\u635f\u5931\u201d\u5e76\u4e0d\u7b49\u540c\u4e8e\u68ee\u6797\u780d\u4f10\u3002", "bd0d8f9e292ac934cfd9d639c0e77449": "\u4f5c\u8005\u8bc4\u4f30\u4e86\u6b64\u6570\u636e\u4e2d\u7684\u4f2a\u9633\u6027\u53d1\u751f\u7387\uff08\u9519\u5206\u8bef\u5dee\uff09\u4e3a 13%\uff0c\u4f2a\u9634\u6027\u53d1\u751f\u7387\uff08\u6f0f\u5206\u8bef\u5dee\uff09\u4e3a 12%\uff0c\u4e0d\u8fc7\u51c6\u786e\u6027\u56e0\u751f\u7269\u7fa4\u843d\u800c\u5f02\uff0c\u56e0\u6b64\u5728\u4efb\u4f55\u7279\u5b9a\u4f4d\u7f6e\u53ef\u80fd\u66f4\u9ad8\u6216\u66f4\u4f4e\u3002\u8be5\u6a21\u578b\u5f80\u5f80\u5ffd\u7565\u4e86\u5c0f\u519c\u5730\u8c8c\u7684\u5e72\u6270\u56e0\u7d20\uff0c\u5bfc\u81f4\u6492\u54c8\u62c9\u4ee5\u5357\u975e\u6d32\u5730\u533a\u6570\u636e\u51c6\u786e\u6027\u66f4\u4f4e\uff0c\u56e0\u4e3a\u90a3\u91cc\u6b64\u7c7b\u5e72\u6270\u56e0\u7d20\u66f4\u5e38\u89c1\u3002\u4f5c\u8005\u6709 75% \u7684\u4fe1\u5fc3\u8ba4\u4e3a\uff0c\u6d41\u5931\u5728\u6240\u8ff0\u5e74\u4efd\u53d1\u751f\uff0c\u4e14\u6709 97% \u7684\u4fe1\u5fc3\u8ba4\u4e3a\uff0c\u6d41\u5931\u5728\u6240\u8ff0\u5e74\u4efd\u524d\u540e\u4e00\u5e74\u5185\u53d1\u751f\u3002\u6b64\u6570\u636e\u7684\u7528\u6237\u53ef\u4ee5\u901a\u8fc7\u68c0\u67e5\u591a\u4e2a\u5e74\u4efd\u7684\u5747\u503c\uff0c\u6d88\u9664\u8fd9\u79cd\u4e0d\u786e\u5b9a\u6027\u3002\u8bf7\u9605\u8bfb\u6b64\u6570\u636e\u51c6\u786e\u6027\u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u535a\u5ba2\u7cfb\u5217</a>\uff0c\u4ee5\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002\"", "e428584581f77341950fc9752c3a271e": "2011-2023 \u5e74\u6570\u636e\u4f7f\u7528<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u66f4\u65b0\u7684\u65b9\u6cd5</a>\u751f\u6210\u3002\u5728\u5bf9\u6bd4\u539f\u6765\u7684 2001-2010 \u5e74\u6570\u636e\u548c 2011-2023 \u5e74\u66f4\u65b0\u540e\u7684\u6570\u636e\u7684\u65f6\u5019\u5e94\u8be5\u683c\u5916\u5c0f\u5fc3\u3002", "39535fa9d04b1337c8394b684ccec7bb": "\u6211\u540c\u610f", "6d56610499752d2b64f8dab7ce597687": "2010 \u5e74\uff0c{location} \u6709 {extent} \u7684\u6811\u6728\u8986\u76d6\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684 {percentage} \u4ee5\u4e0a\uff0c\u76f8\u5f53\u4e8e {emissions} \u4e8c\u6c27\u5316\u78b3\u6392\u653e\u3002", "e9b9af3370b6ca6e711137162ec1b794": "2023\u5e74\u6811\u6728\u8986\u76d6\u635f\u5931\u60c5\u51b5\u7684\u6570\u636e\u5206\u6790", "8d6ec33f3815418767e0c567c76a1e50": "\u5220\u9664\u60a8\u7684 Forest Watcher \u8d26\u53f7", "1e1acfa1c9c872293f4c8a11de1d9eef": "\u60a8\u8fd8\u53ef\u4ee5\u4f7f\u7528 Forest Watcher \u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u6765\u8bf7\u6c42\u5220\u9664\u60a8\u7684\u8d26\u53f7\uff0c\u5982\u4e0b\u9762\u7684\u4e00\u7cfb\u5217\u5c4f\u5e55\u622a\u56fe\u6240\u793a\u3002", "917283d5bc95da4e617f00ec9d4d32c7": "\u6b64\u5916\uff0c\u4e0e\u6b64\u8d26\u53f7\u5173\u8054\u7684\u6240\u6709\u5185\u5bb9\uff08\u8de8\u6240\u6709\u5e94\u7528\u7a0b\u5e8f\uff09\u90fd\u5c06\u88ab\u5220\u9664\u3002\u8fd9\u5305\u62ec\uff1a", "aa90cad52f0e828371fe5b221b2f0b41": "\u5982\u9700\u5185\u5bb9\u7c7b\u578b\u7684\u5b8c\u6574\u5217\u8868\uff0c\u8bf7\u8bbf\u95ee <a href=\"{{0}}\">Resource Watch API \u6587\u6863</a>\u3002", "ef0353a7e5934eeadcced2d92c14a3d0": "\u60c5\u5883\u56fe\u5c42", "4ca2c509994c2776d0880357b4e8e5be": "\u8ba2\u9605", "fa07652cb6a5517c5dffb407c8eca014": "\u5c0f\u90e8\u4ef6", "8fad77c05d28a6e6a1ffdf01a24bdc7e": "<a href=\"{{0}}\">\u5e2e\u52a9\u4e2d\u5fc3\u9996\u9875</a><span class=\"css-1h3kxp2 e8lo49c0\">/</span>\u5206\u6b65\u8bf4\u660e<span class=\"css-1h3kxp2 e8lo49c0\">/</span>\u5220\u9664\u60a8\u7684 Forest Watcher \u8d26\u53f7", "f1cb45f64cdd7b55480ba6aeecd7b797": "\u6570\u636e\u96c6", "c12ae72e0ad6483664994660fba9871a": "GFW \u6700\u8fd1\u66f4\u65b0\u4e86<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">\u4e00\u4e9b\u91cd\u8981\u7684 FAO \u5c0f\u7ec4\u4ef6</a>\uff0c\u5176\u4e2d\u5305\u542b\u4e86\u6765\u81ea\u5168\u7403\u68ee\u6797\u8d44\u6e90\u8bc4\u4f30\u62a5\u544a (FRA) \u7684\u6700\u65b0\u6570\u636e\u3002\u5982\u9700\u4e86\u89e3 FAO \u6700\u65b0\u6570\u636e\u4e0e GFW \u6570\u636e\u6709\u5173\u68ee\u6797\u8303\u56f4\u7684\u5bf9\u6bd4\uff0c<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener\">\u8bf7\u9605\u8bfb\u6211\u4eec\u7684\u65b0\u535a\u5ba2</a>\u3002", "a2a07859aebae54588c41d383b0cd9af": "\u5bf9\u6bd4 GFW \u548c FRA 2020 \u5e74\u68ee\u6797\u8303\u56f4", "1b62cce99785698451e59cbaa1889d28": "\u636e\u8054\u5408\u56fd\u7cae\u519c\u7ec4\u7ec7\u7edf\u8ba1\uff0c{year} \u5e74\uff0c{country}\u7684\u68ee\u6797\u8986\u76d6\u9762\u79ef ({amountInHectares}) \u5360\u5176\u56fd\u571f\u603b\u9762\u79ef\u7684 {percent} \u3002\u5176\u4e2d\uff0c{primaryPercent} \u7684\u68ee\u6797\u88ab\u5f52\u7c7b\u4e3a\u539f\u59cb\u68ee\u6797\u3002", "2185115c07ef8a2f00cd58cc44042aa1": "\u622a\u81f3 {year} \u5e74\uff0c{location} {percentage} \u7684\u571f\u5730\u8986\u76d6\u4e3a<strong>\u6811\u6728\u8986\u76d6</strong>\uff0c\u6811\u51a0\u5bc6\u5ea6\u8fbe\u5230 {threshold}\u3002", "82555330a05accf09927dc9243636276": "\u636e\u8054\u5408\u56fd\u7cae\u519c\u7ec4\u7ec7\u7edf\u8ba1\uff0c{year} \u5e74 {location} \u6797\u4e1a\u90e8\u95e8\u5c31\u4e1a\u4eba\u5458\u6709 {numPeople} \u4eba\u3002", "0dce24a62d49d707d44b039bbcc3aa85": "\u636e\u8054\u5408\u56fd\u7cae\u519c\u7ec4\u7ec7\u7edf\u8ba1\uff0c{year} \u5e74\uff0c\u5168\u7403\u68ee\u6797\u8986\u76d6\u9762\u79ef ({amountInHectares}) \u5360\u571f\u5730\u603b\u9762\u79ef\u7684 {percent}\u3002\u5176\u4e2d {primaryPercent} \u7684\u68ee\u6797\u88ab\u5f52\u7c7b\u4e3a\u539f\u59cb\u68ee\u6797\u3002", "fa135952c8beab63cd47e1b960585d29": "\u636e\u8054\u5408\u56fd\u7cae\u519c\u7ec4\u7ec7\u7edf\u8ba1\uff0c{location} \u5728 {startYearRange} \u81f3 {endYearRange} \u5e74\u671f\u95f4\uff0c\u6bcf\u5e74\u7684\u518d\u9020\u6797\u7387\u4e3a {rate}\u3002", "9e61df7c9ceee9e8bad022302bbc80bf": "\u5021\u8bae", "009d453831eb36b517ef465b383d1d8f": "Ajemalebu\u81ea\u52a9\u7ec4\u7ec7 (Ajemalebu Self Help, AJESH) \u5c06\u4e0e\u653f\u5e9c\u4e00\u8d77\u81f4\u529b\u4e8e\u4fdd\u62a4 Yabas\u2026\u2026", "371314c1ecf8ff07c831c539ccdb48bd": "\u88ab\u6388\u4e88\u8005", "6cafbe433c7243d3ef7aff26ce576b2a": "\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u7f16\u8f91\u201d\u56fe\u6807\u3002&nbsp;", "68e542c09ead7642c65d48f0c4480257": "\u5728\u5730\u70b9\u9875\u9762\u4e0a\u70b9\u51fb\u201c\u6211\u7684\u5730\u70b9\u201d\u4e0b\u7684\u5217\u8868\u3002\u70b9\u51fb\u6240\u9700\u5730\u70b9\u65c1\u8fb9\u7684\u590d\u9009\u6846\u6765\u9009\u62e9\u8981\u79fb\u52a8\u7684\u5730\u70b9\u3002&nbsp;", "2972b5d4b5ad8451d446ae31b20e63a0": "GFW \u7684\u4e94\u4e2a\u5217\u8868\u5728 Pro \u4e0a\u7684\u8fd0\u884c\u65b9\u5f0f\u7565\u6709\u4e0d\u540c\u3002&nbsp;", "13919530b6eaa47e06fa22938a495182": "\u9009\u62e9\u5730\u56fe\u4e0b\u65b9\u53f3\u4e0a\u89d2\u7684\u201c\u62a5\u544a\u201d\uff0c\u5373\u53ef\u751f\u6210\u8be5\u9875\u9762\u7684\u53ef\u6253\u5370 PDF \u6587\u4ef6\u3002\u60a8\u4e5f\u53ef\u70b9\u51fb\u201c\u4e0b\u8f7d\u201d\uff0c\u4ee5 CSV \u6587\u4ef6\u683c\u5f0f\u4e0b\u8f7d\u7f51\u9875\u4e0a\u7684\u6240\u6709\u6570\u636e\u3002", "7c3fe0866253fc00701e79d8bd2c9e3b": "\u82e5\u5217\u8868\u66f4\u65b0\u5931\u8d25\uff0c\u8bf7\u5728\u5730\u70b9\u9875\u9762\u70b9\u51fb\u201c\u66f4\u65b0\u5206\u6790\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u786e\u5b9a\u201d\u8fdb\u884c\u786e\u8ba4\u3002\u4e4b\u540e\u5217\u8868\u5c06\u5f97\u5230\u91cd\u65b0\u5904\u7406\u3002", "52290777c98a2d43be467c9ee99f3ca6": "\u82e5\u8981\u7528\u6700\u65b0\u6570\u636e\u66f4\u65b0\u5217\u8868\u4e2d\u7684\u5730\u70b9\uff0c\u8bf7\u6309\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\u3002", "645c1cbfe1d67c1cd9a4e389fc9ba485": "\u70b9\u51fb\u201c\u66f4\u65b0\u5206\u6790\u201d\u5e76\u70b9\u51fb\u201c\u786e\u5b9a\u201d\uff0c\u786e\u8ba4\u8981\u66f4\u65b0\u5217\u8868\u3002", "330b5a0b1d983bd5b2d06e603c6cceb3": "\u67e5\u770b SBTN \u6570\u636e\u5c42\u65f6\uff0c\u60a8\u8fd8\u5c06\u4e86\u89e3\u5230\u5404\u5730\u70b9\u7684\u201c\u53ef\u5ffd\u7565\u98ce\u9669\u201d\u3002\u6eda\u52a8\u5230\u5c4f\u5e55\u5e95\u90e8\uff0c\u5373\u53ef\u67e5\u770b\u6574\u4e2a\u5217\u8868\u7684\u201c\u53ef\u5ffd\u7565\u98ce\u9669\u201d\u91cd\u53e0\u603b\u91cf\u3002", "03c63d7987524ce9904f263997e932d9": "\u6309\u7167\u4e0a\u8ff0\u8bf4\u660e\u9009\u62e9\u201c\u5217\u8868\u8bca\u65ad\u201d\u6216\u201c\u5730\u70b9\u8bca\u65ad\u201d\u3002", "d92b65a03e92eb11f7cd93ca60f0d556": "\u5c06\u52a0\u8f7d\u8bca\u65ad\u9875\u9762\u3002", "599741946501ba401f5d36090acf8586": "\u82e5\u8981\u5bf9\u8868\u683c\u8fdb\u884c\u7b5b\u9009\uff0c\u8bf7\u70b9\u51fb\u7b5b\u9009\u5668\u56fe\u6807\uff0c\u7136\u540e\u9009\u62e9\u9996\u9009\u7b5b\u9009\u6761\u4ef6\uff0c\u5b8c\u6210\u540e\u70b9\u51fb\u201c\u5e94\u7528\u201d\u3002\u82e5\u8981\u6e05\u9664\u7b5b\u9009\u6761\u4ef6\uff0c\u8bf7\u70b9\u51fb\u201c\u6e05\u9664\u201d\u3002\u5df2\u5206\u6790\u5217\u8868\u548c\u8349\u7a3f\u5217\u8868\u5177\u6709\u76f8\u540c\u7684\u7b5b\u9009\u884c\u4e3a\u3002", "dba8e55b3f4cf416b93d79eacb1597de": "GFW Pro \u662f Global Forest Watch \u5e73\u53f0\u7684\u4f9b\u5e94\u94fe\u7248\u672c\uff0c\u65e8\u5728\u5e2e\u52a9\u4f01\u4e1a\u5229\u7528\u548c\u5206\u6790\u5730\u7406\u7a7a\u95f4\u4f9b\u5e94\u94fe\u6570\u636e\uff0c\u4ee5\u8ddf\u8e2a\u3001\u7ba1\u7406\u548c\u62a5\u544a\u6bc1\u6797\u98ce\u9669\uff0c\u4ece\u800c\u6ee1\u8db3\u76d1\u7ba1\u8981\u6c42\u5e76\u5c65\u884c\u96f6\u6bc1\u6797\u627f\u8bfa\u3002\u8be5\u7cfb\u7edf\u63d0\u4f9b\u57fa\u4e8e API \u7684\u8bbf\u95ee\u548c\u6613\u4e8e\u4f7f\u7528\u7684\u7528\u6237\u754c\u9762\uff0c\u652f\u6301\u5728\u5730\u4ea7\u3001\u4f9b\u5e94\u68da\u548c\u6295\u8d44\u7ec4\u5408\u5c42\u9762\u63d0\u4f9b\u5206\u6790\u548c\u4eea\u8868\u677f\u3002GFW Pro \u91c7\u7528<a href=\"{{0}}\">\u4e00\u6d41\u7684\u5b89\u5168\u534f\u8bae</a>\u6765\u5168\u65b9\u4f4d\u786e\u4fdd\u7cfb\u7edf\u548c\u7528\u6237\u6570\u636e\u7684\u5b8c\u6574\u6027\u4e0e\u5b89\u5168\u6027\u3002", "0961810df1b8ac0b1f9989bed58c0d80": "\u5982\u679c\u60a8\u7684\u7ec4\u7ec7\u6709\u610f\u4f7f\u7528 GFW Pro \u6765\u5c3d\u91cf\u964d\u4f4e\u6bc1\u6797\u98ce\u9669\uff0c\u8bf7\u63d0\u4ea4<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8d26\u6237\u7533\u8bf7\u8868</a>\u4ee5\u5f00\u59cb\u4f7f\u7528\u3002", "e4db635bda9f7984ca73c6ff16316e74": "\u8bbf\u95ee\u201c\u68d5\u6988\u98ce\u9669\u201d\u8bca\u65ad", "63e0789993c09b13ba0ff3cc3bf67c3e": "\u52a0\u5165\u8fd9\u573a\u53ca\u65f6\u7684\u7f51\u7edc\u7814\u8ba8\u4f1a\uff0c\u8046\u542c\u4f9b\u5e94\u94fe\u5229\u76ca\u76f8\u5173\u8005\u7545\u8c08\u5982\u4f55\u9632\u6b62\u68ee\u6797\u7834\u574f\u3002\u901a\u8fc7\u4e86\u89e3\u4f01\u4e1a\u3001\u91d1\u878d\u673a\u6784\u548c\u5546\u54c1\u751f\u4ea7\u5546\u7684\u610f\u89c1\uff0c\u6211\u4eec\u5c06\u63a2\u8ba8 Global Forest Watch (GFW) Pro\uff08GFW \u7684\u4f9b\u5e94\u94fe\u7248\u672c\uff09\u5982\u4f55\u5e2e\u52a9\u4ed6\u4eec\u5f00\u53d1\u521b\u65b0\u7684\u89e3\u51b3\u65b9\u6848\u6765\u5e94\u5bf9\u68ee\u6797\u635f\u5931\uff0c\u5e76\u6ee1\u8db3\u6cd5\u89c4\u548c\u5e02\u573a\u63d0\u51fa\u7684\u900f\u660e\u5ea6\u8981\u6c42\u3002\u70b9\u51fb<a href=\"{{0}}\">\u8fd9\u91cc</a>\u6ce8\u518c\u3002", "21979119a46343770f5af4a891817b96": "\u96f6\u6bc1\u6797\u4f9b\u5e94\u94fe\u7684\u521b\u65b0", "6570667b35edab35c907dd4a441e2ffd": "\u9009\u62e9\u4e00\u4e2a\u5217\u8868\u5e76\u70b9\u51fb\u201c\u66f4\u65b0\u201d\uff0c\u5373\u53ef\u91cd\u65b0\u5206\u6790\u5931\u8d25\u7684\u5217\u8868\u6216\u4f7f\u7528\u6700\u65b0\u6570\u636e\u66f4\u65b0\u5217\u8868\u3002&nbsp;", "64bd1febaf264384eccc879b490f8f1a": "\u70b9\u51fb\u201c\u2026\u201d\u83dc\u5355\u8bbf\u95ee\u4ee5\u4e0b\u9009\u9879\u3002&nbsp;", "eaa0a449a86906c489cf099ac8348377": "<strong>\u8bca\u65ad</strong>\uff1a\u67e5\u770b\u60a8\u7684\u5730\u70b9\u5217\u8868\u5728 2000 \u5e74\u540e\u7684\u68ee\u6797\u53d8\u5316\u5206\u6790\u3002\u68ee\u6797\u53d8\u5316\u5206\u6790\u5c06\u663e\u793a\u60a8\u7684\u5730\u70b9\u4e2d\u6709\u54ea\u4e9b\u5730\u65b9\u53d1\u751f\u4e86\u6811\u6728\u8986\u76d6\u635f\u5931\uff0c\u5e76\u7a81\u51fa\u663e\u793a\u4e86\u4e00\u4e9b\u5728\u68ee\u6797\u780d\u4f10\u653f\u7b56\u4e2d\u6700\u5e38\u63d0\u53ca\u7684\u654f\u611f\u6797\u533a\u53d1\u751f\u7684\u635f\u5931\u3002\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u6d4f\u89c8\u68ee\u6797\u53d8\u5316\u8bca\u65ad\u3002&nbsp\uff1b", "90a141ad8b828f8fcf57ce358933bb78": "<strong>\u5730\u56fe</strong>\uff1a\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u60a8\u7684\u5730\u70b9\u5217\u8868\u3002\u60a8\u53ef\u4ee5\u5728\u5730\u56fe\u4e0a\u6fc0\u6d3b\u4e0d\u540c\u7684\u68ee\u6797\u53d8\u5316\u548c\u80cc\u666f\u6570\u636e\u56fe\u5c42\uff0c\u4f8b\u5982\u6811\u6728\u8986\u76d6\u635f\u5931\u548c\u4fdd\u62a4\u533a\uff0c\u5e76\u5bf9\u7279\u5b9a\u533a\u57df\u8fdb\u884c\u5206\u6790\u3002\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u5728\u5730\u56fe\u4e0a\u53ef\u89c6\u5316\u548c\u5206\u6790\u6570\u636e\u3002&nbsp;", "4f2cfb5250bcf847f71b358dbf0f48df": "<strong>\u4e0b\u8f7d</strong>\uff1a\u5c06\u60a8\u7684\u539f\u59cb\u8f93\u5165\u6587\u4ef6\u4e0b\u8f7d\u4e3a CSV \u6216 shapefile \u6587\u4ef6\u3002&nbsp;", "4f9fabc50093343b10cadb5f2fc7dfb5": "<strong>\u5206\u4eab</strong>\uff1a\u4e0e\u60a8 GFW Pro \u8d26\u6237\u4e2d\u7684\u5176\u4ed6\u7528\u6237\u5171\u4eab\u60a8\u7684\u5217\u8868\u3002\u53ea\u6709\u7ba1\u7406\u5458\u53ef\u4ee5\u542f\u52a8\u5217\u8868\u5171\u4eab\u2014\u2014\u7f16\u8f91\u8005\u548c\u67e5\u770b\u8005\u53ef\u4ee5\u63a5\u6536\u5171\u4eab\u5217\u8868\u3002&nbsp;", "0831f8320b98f5f102cfe9c8c00dd47f": "<strong>\u66f4\u6539\u5206\u6790\u7c7b\u578b\uff1a</strong>\u5f53\u60a8\u6700\u5f00\u59cb\u5c06\u5217\u8868\u6dfb\u52a0\u5230\u8d26\u6237\u65f6\uff0c\u60a8\u53ef\u80fd\u53ea\u9009\u62e9\u4e86\u4e00\u79cd\u6216\u4e24\u79cd\u5206\u6790\u7c7b\u578b\u3002\u60a8\u53ef\u4ee5\u968f\u65f6\u6dfb\u52a0\u5176\u4ed6\u5206\u6790\u3002", "0c6fd639a0857a914039d34f06223a64": "\u5728\u5730\u70b9\u9875\u9762\u4e0a\u70b9\u51fb\u201c\u6211\u7684\u5730\u70b9\u201d\u4e0b\u7684\u5217\u8868\u3002\u901a\u8fc7\u52fe\u9009\u8981\u590d\u5236\u7684\u5730\u70b9\u65c1\u8fb9\u7684\u590d\u9009\u6846\u6765\u9009\u62e9\u8981\u590d\u5236\u7684\u5730\u70b9\u3002\u6b64\u64cd\u4f5c\u53ef\u5728\u8349\u7a3f\u5217\u8868\u6216\u5df2\u5206\u6790\u7684\u5217\u8868\u4e0a\u6267\u884c\u3002&nbsp;", "6aed4904a51613d1248d7c33ffea754f": "\u901a\u8fc7\u4e0b\u62c9\u83dc\u5355\u9009\u62e9\u8981\u6dfb\u52a0\u5730\u70b9\u7684\u73b0\u6709\u5217\u8868\uff0c\u6216\u521b\u5efa\u65b0\u5217\u8868\u3002&nbsp;", "dbb576cf57b94f774cb5d3b9671f4b59": "\u5f53\u60a8\u5728 Pro \u8d26\u6237\u4e2d\u4e0a\u4f20\u4e86\u81f3\u5c11\u4e24\u4e2a\u5217\u8868\u540e\uff0c\u60a8\u5c31\u53ef\u4ee5\u4f7f\u7528\u6587\u4ef6\u5939\u4ece\u5730\u70b9\u9875\u9762\u7ec4\u7ec7\u6574\u7406\u60a8\u7684\u5217\u8868\uff1b", "e59b48c0cfea7e0ec59cd5dd8cfaa514": "\u4e0a\u4f20\u7b2c\u4e8c\u4e2a\u5217\u8868\u540e\uff0c\u60a8\u5c06\u770b\u5230\u4e00\u4e2a\u6a2a\u5e45\uff0c\u63d0\u793a\u60a8\u5c06\u5217\u8868\u7ec4\u7ec7\u6574\u7406\u5230\u6587\u4ef6\u5939\u4e2d\u3002\u60a8\u5728\u8d26\u6237\u4e2d\u521b\u5efa\u7684\u6587\u4ef6\u5939\u4ec5\u5bf9\u60a8\u53ef\u89c1\u3002&nbsp;", "5e66601f74be7ae5b307e6c334d67720": "<strong>\u5220\u9664</strong>\uff1a\u4ece\u60a8\u7684 Pro \u8d26\u6237\u4e2d\u6c38\u4e45\u5220\u9664\u5931\u8d25\u548c\u6d3b\u8dc3\u7684\u5217\u8868\u3002&nbsp;", "d37cf1f26601db6b9743705911bf6e02": "\u5728\u5730\u70b9\u9875\u9762\uff0c\u9009\u62e9\u201c\u6211\u7684\u5730\u70b9\u201d\u4e0b\u7684\u5217\u8868\u3002\u70b9\u51fb\u5217\u8868\u65c1\u8fb9\u7684\u201c\u2026\u201d\u83dc\u5355\uff0c\u7136\u540e\u9009\u62e9\u201c\u6dfb\u52a0\u5230\u6587\u4ef6\u5939\u201d\u3002&nbsp;", "5a5904693b202c12c650acc1f5639f31": "\u5bf9\u4e8e\u60a8\u7684\u7b2c\u4e00\u4e2a\u6587\u4ef6\u5939\uff0c\u7cfb\u7edf\u5c06\u63d0\u793a\u60a8\u521b\u5efa\u4e00\u4e2a\u65b0\u6587\u4ef6\u5939\u3002\u5bf9\u4e8e\u7b2c\u4e00\u4e2a\u6587\u4ef6\u5939\u4e4b\u540e\u7684\u6bcf\u4e2a\u6587\u4ef6\u5939\uff0c\u60a8\u90fd\u53ef\u4ee5\u9009\u62e9\u521b\u5efa\u65b0\u6587\u4ef6\u5939\u6216\u6dfb\u52a0\u5230\u73b0\u6709\u6587\u4ef6\u5939\u3002&nbsp;", "6f50f31bc7c7249d1b37a9e03b8cf541": "\u70b9\u51fb\u8981\u7f16\u8f91\u7684\u884c\u65c1\u8fb9\u7684\u590d\u9009\u6846\u6765\u9009\u62e9\u8981\u7f16\u8f91\u7684\u5730\u70b9\u3002\u5982\u679c\u8981\u7f16\u8f91\u6240\u6709\u5730\u70b9\uff0c\u8bf7\u70b9\u51fb\u8868\u683c\u5de6\u4e0a\u89d2\u201c\u5730\u70b9\u540d\u79f0\u201d\u65c1\u8fb9\u7684\u590d\u9009\u6846\u3002\u5982\u679c\u60a8\u5df2\u7ecf\u5728\u8349\u7a3f\u5217\u8868\u4e2d\u9009\u62e9\u4e86\u8981\u7f16\u8f91\u7684\u672a\u5206\u6790\u5730\u70b9\uff0c\u5219\u5728\u5217\u8868\u63d0\u4ea4\u5206\u6790\u5e76\u83b7\u5f97\u6574\u4e2a\u5217\u8868\u7684\u5206\u6790\u7ed3\u679c\u4e4b\u524d\uff0c\u53ef\u7528\u7684\u5c5e\u6027\u4fe1\u606f\u5c06\u662f\u6709\u9650\u7684\u3002&nbsp;", "268089059e63be7268ec9354e8981514": "\u5728\u5730\u70b9\u9875\u9762\u4e0a\u70b9\u51fb\u201c\u6211\u7684\u5730\u70b9\u201d\u4e0b\u7684\u5217\u8868\u3002&nbsp;", "db8f27d3dfad3e9b01906b541933c8c2": "\u8981\u5c06\u5217\u8868\u4ece\u4e00\u4e2a\u6587\u4ef6\u5939\u79fb\u52a8\u5230\u53e6\u4e00\u4e2a\u6587\u4ef6\u5939\uff0c\u6216\u4ece\u6587\u4ef6\u5939\u4e2d\u5220\u9664\u5217\u8868\uff0c\u8bf7\u70b9\u51fb\u6587\u4ef6\u5939\uff0c\u7136\u540e\u70b9\u51fb\u6587\u4ef6\u5939\u4e2d\u8be5\u5217\u8868\u65c1\u8fb9\u7684\u201c\u2026\u201d\u83dc\u5355\uff0c\u7136\u540e\u9009\u62e9\u201c\u7ba1\u7406\u201d\u3002\u5df2\u6dfb\u52a0\u5230\u6587\u4ef6\u5939\u7684\u8349\u7a3f\u5217\u8868\u5c06\u7528\u8349\u7a3f\u56fe\u6807\u8868\u793a\u3002<img src=\"{{0}}\" alt=\"\" class=\"css-4g6ai3 e1i5xcrv0\">", "17c5872c9af659010d62d8a620d81600": "\u60a8\u5c06\u8fdb\u5165\u8868\u683c\u89c6\u56fe\uff0c\u4ee5\u4fbf\u7f16\u8f91\u5df2\u9009\u62e9\u7684\u5730\u70b9\u3002\u7f16\u8f91\u6b65\u9aa4\u5982\u4e0b\uff1a\u70b9\u51fb\u94c5\u7b14\u56fe\u6807\u6240\u6307\u793a\u7684\u53ef\u7f16\u8f91\u5b57\u6bb5\uff0c\u66f4\u6539\u4fe1\u606f\uff0c\u7136\u540e\u70b9\u51fb\u201c\u66f4\u65b0\u201d\u3002\u5982\u679c\u51fa\u73b0\u9a8c\u8bc1\u9519\u8bef\uff0c\u5b83\u4eec\u5c06\u4ee5\u7ea2\u8272\u663e\u793a\uff0c\u5e76\u51fa\u73b0\u5728\u201c\u6709\u9519\u8bef\u7684\u5730\u70b9\u201d\u6807\u7b7e\u4e2d\u2014\u2014\u60a8\u53ef\u4ee5\u5c06\u9f20\u6807\u60ac\u505c\u5728\u8fd9\u4e9b\u9519\u8bef\u4e0a\u4ee5\u83b7\u53d6\u66f4\u591a\u4fe1\u606f\u3002\u5982\u679c\u5217\u8868\u4e2d\u5b58\u5728\u9a8c\u8bc1\u9519\u8bef\uff0c\u201c\u66f4\u65b0\u201d\u56fe\u6807\u5c06\u663e\u793a\u4e3a\u7981\u7528\u3002\u5982\u679c\u5217\u8868\u662f\u8349\u7a3f\u5f62\u5f0f\uff0c\u5219\u5217\u8868\u540d\u79f0\u65c1\u8fb9\u4f1a\u6709\u4e00\u4e2a\u8349\u7a3f\u56fe\u6807\u3002<img src=\"{{0}}\" alt=\"\" class=\"css-4g6ai3 e1i5xcrv0\">", "abbc13f7e6768587a2c5cafa9aa146a1": "<strong>\u5c06\u5730\u70b9\u590d\u5236\u5230\u5217\u8868\uff1a</strong>\u5c06\u5730\u70b9\u590d\u5236\u5230\u73b0\u6709\u5217\u8868\u6216\u65b0\u5217\u8868\u4e2d\u3002\u5730\u70b9\u5c06\u4fdd\u7559\u5728\u539f\u59cb\u5217\u8868\u4e2d\u3002\u60a8\u53ea\u80fd\u5c06\u5730\u70b9\u590d\u5236\u5230\u5177\u6709\u76f8\u540c\u6a21\u677f\u7c7b\u578b\u7684\u5176\u4ed6\u5217\u8868\u4e2d\u3002\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u9009\u62e9\u6b63\u786e\u7684\u6a21\u677f\u7c7b\u578b\u3002", "6201a323739570a3f3579ceceb0d5bef": "\u5f53\u60a8\u63d0\u4ea4\u5217\u8868\u8fdb\u884c\u5206\u6790\u540e\uff0cPro \u5c06\u91cd\u65b0\u8fd0\u884c\u5bf9\u8be5\u5217\u8868\u7684\u5206\u6790\u3002\u60a8\u5c06\u88ab\u5e26\u56de\u5230\u5730\u70b9\u9875\u9762\uff0c\u9875\u9762\u4e0a\u4f1a\u51fa\u73b0\u4e00\u4e2a\u6a2a\u5e45\uff0c\u663e\u793a\u6b63\u5728\u5bf9\u60a8\u7684\u5217\u8868\u8fdb\u884c\u5206\u6790\u3002\u5206\u6790\u5f00\u59cb\u548c\u5206\u6790\u5b8c\u6210\u540e\uff0c\u60a8\u90fd\u4f1a\u6536\u5230\u4e00\u5c01\u7535\u5b50\u90ae\u4ef6\u3002\u60a8\u53ef\u4ee5\u5728\u5730\u70b9\u9875\u9762\u7684\u201c\u6211\u7684\u5730\u70b9\u201d\u4e0b\u67e5\u770b\u5206\u6790\u7ed3\u679c\u3002\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u4e86\u89e3\u6709\u5173\u5206\u6790\u5730\u70b9\u548c\u5217\u8868\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u5728<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u67e5\u770b\u6709\u5173\u8fd1\u4e4e\u5b9e\u65f6\u76d1\u63a7\u5730\u70b9\u7684\u66f4\u591a\u4fe1\u606f\u3002&nbsp;", "0b0db3fa9ef4c7181d51d36519f82048": "<strong>\u884c\u653f\u533a\u57df</strong>\uff1a\u5168\u7403\u6240\u6709\u56fd\u5bb6\u3001\u5dde\u53ca\u5176\u4e0b\u7ea7\u884c\u653f\u533a\u3002&nbsp;", "b0a6b5b5e3a137f3c6ae70a789fd166b": "<strong>\u6cb9\u68d5\u7279\u8bb8\u7ecf\u8425\u533a</strong>\uff1a\u6587\u83b1\u3001\u5580\u9ea6\u9686\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u3001\u5229\u6bd4\u91cc\u4e9a\u3001\u9a6c\u6765\u897f\u4e9a\u3001\u5df4\u5e03\u4e9a\u65b0\u51e0\u5185\u4e9a\u3001\u521a\u679c\u5171\u548c\u56fd\u548c\u6240\u7f57\u95e8\u7fa4\u5c9b\u7684\u6cb9\u68d5\u7279\u8bb8\u7ecf\u8425\u533a\u3002&nbsp;", "2ef591d49bf03b6249c68f85d7cd9eae": "\u70b9\u51fb\u201c\u63d0\u4ea4\u5206\u6790\u201d\uff0c\u6216\u70b9\u51fb\u201c\u53e6\u5b58\u4e3a\u8349\u7a3f\u201d\u6765\u5c06\u5217\u8868\u4fdd\u5b58\u4e3a\u8349\u7a3f\u3002\u5c06\u5217\u8868\u4fdd\u5b58\u4e3a\u8349\u7a3f\u53ef\u4ee5\u8ba9\u60a8\u5728\u63d0\u4ea4\u5217\u8868\u8fdb\u884c\u5206\u6790\u4e4b\u524d\u91cd\u65b0\u8bbf\u95ee\u5217\u8868\u6216\u8fdb\u884c\u5176\u4ed6\u7f16\u8f91\u3002\u70b9\u51fb\u201c\u63d0\u4ea4\u5206\u6790\u201d\u6216\u201c\u53e6\u5b58\u4e3a\u8349\u7a3f\u201d\u540e\uff0c\u60a8\u5c06\u88ab\u5bfc\u822a\u5230\u5730\u70b9\u9875\u9762\u3002&nbsp;", "b87c962ac6dc574ac278ff5e2b77d25a": "\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u79fb\u52a8\u201d\u56fe\u6807\u3002&nbsp;", "6bdcfdf081b2d283f5df17292d064b3c": "\u70b9\u51fb\u201c\u63d0\u4ea4\u5206\u6790\u201d\u3002&nbsp;", "9a6c33d558bee80f3c24c7086fe74dae": "\u5982\u679c\u5217\u8868\u88ab\u63d0\u4ea4\u8fdb\u884c\u5206\u6790\uff0cPro \u5c06\u5bf9\u6dfb\u52a0\u5230\u76ee\u6807\u5217\u8868\u7684\u5730\u70b9\u8fdb\u884c\u5206\u6790\u3002\u5982\u679c\u5c06\u65b0\u7684\u5206\u6790\u7c7b\u578b\u6dfb\u52a0\u5230\u76ee\u6807\u5217\u8868\uff0c\u5219\u5c06\u5bf9\u6574\u4e2a\u5217\u8868\u8fdb\u884c\u5206\u6790\u3002\u539f\u5217\u8868\u5c06\u8fdb\u5165\u8349\u7a3f\u72b6\u6001\u3002\u60a8\u5c06\u88ab\u5bfc\u822a\u5230\u5730\u70b9\u7f51\u9875\uff0c\u7f51\u9875\u4e0a\u4f1a\u51fa\u73b0\u4e00\u4e2a\u6a2a\u5e45\uff0c\u663e\u793a\u6b63\u5728\u5bf9\u60a8\u7684\u5217\u8868\u8fdb\u884c\u5206\u6790\u3002\u5206\u6790\u5f00\u59cb\u548c\u5206\u6790\u5b8c\u6210\u540e\uff0c\u60a8\u90fd\u4f1a\u6536\u5230\u4e00\u5c01\u7535\u5b50\u90ae\u4ef6\u3002\u60a8\u53ef\u4ee5\u5728\u5730\u70b9\u9875\u9762\u7684\u201c\u6211\u7684\u5730\u70b9\u201d\u4e0b\u67e5\u770b\u5206\u6790\u7ed3\u679c\u3002\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u4e86\u89e3\u6709\u5173\u5206\u6790\u5730\u70b9\u548c\u5217\u8868\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u5728<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u67e5\u770b\u6709\u5173\u8fd1\u4e4e\u5b9e\u65f6\u76d1\u63a7\u5730\u70b9\u7684\u66f4\u591a\u4fe1\u606f\u3002&nbsp;", "d8f3ea38450b7b2d248fc9da829efed7": "\u5728\u5730\u70b9\u9875\u9762\u4e0a\u70b9\u51fb\u201c\u6211\u7684\u5730\u70b9\u201d\u4e0b\u7684\u5217\u8868\u3002\u70b9\u51fb\u8981\u5220\u9664\u7684\u884c\u65c1\u8fb9\u7684\u590d\u9009\u6846\u6765\u9009\u62e9\u8981\u5220\u9664\u7684\u5730\u70b9\u3002\u6b64\u64cd\u4f5c\u53ef\u5728\u8349\u7a3f\u5217\u8868\u6216\u5df2\u5206\u6790\u7684\u5217\u8868\u4e0a\u6267\u884c\u3002&nbsp;", "e7683e8ff47f9b3d7bb70c8ae042a20b": "\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u5220\u9664\u201d\u56fe\u6807\u5e76\u786e\u8ba4\u5220\u9664\u3002&nbsp;", "30411ec315c4075abe5e09e4143398a6": "\u5df2\u5220\u9664\u7684\u5730\u70b9\u5c06\u4e0d\u518d\u51fa\u73b0\u5728\u5217\u8868\u89c6\u56fe\u4e2d\u3002\u5982\u679c\u5217\u8868\u5c1a\u672a\u5904\u4e8e\u8349\u7a3f\u72b6\u6001\uff0c\u5219\u5b83\u5c06\u8fdb\u5165\u8349\u7a3f\u72b6\u6001\u3002\u5728\u60a8\u70b9\u51fb\u201c\u5730\u70b9\u201d\u9875\u9762\u4e0a\u7684\u201c\u63d0\u4ea4\u5206\u6790\u201d\u4e4b\u524d\uff0c\u8be5\u5217\u8868\u5c06\u4e0d\u4f1a\u63d0\u4ea4\u8fdb\u884c\u5206\u6790\u3002&nbsp;", "5ad33fbf62c4a3e574246183d6ffbb0f": "\u8349\u7a3f\u5f62\u5f0f\u7684\u5217\u8868\u53ef\u80fd\u4f1a\u6709\u4e00\u4e9b\u7279\u5b9a\u7684\u8003\u8651\u4e8b\u9879\u3002\u5728\u63d0\u4ea4\u5217\u8868\u8fdb\u884c\u5206\u6790\u4e4b\u524d\uff0c\u53ef\u4ee5\u5c06\u5217\u8868\u4ee5\u8349\u7a3f\u5f62\u5f0f\u4fdd\u5b58\u5230\u60a8\u7684 Pro \u8d26\u6237\u6237\uff0c\u4ee5\u4fbf\u65e5\u540e\u6dfb\u52a0\u3001\u7f16\u8f91\u6216\u66f4\u6539\u3002&nbsp;", "efd9c485280a7ec2f3887fb1da8860ed": "<strong>\u68d5\u6988\u6cb9\u52a0\u5de5\u5382</strong>\uff1a\u5168\u7403\u68d5\u6988\u6cb9\u52a0\u5de5\u5382\u7684\u884c\u4e1a\u6807\u51c6\u3002&nbsp;", "ac3f479e990ca502eadb28c55a5f2b81": "<strong>\u4fdd\u62a4\u533a</strong>\uff1a<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u4e16\u754c\u4fdd\u62a4\u533a\u6570\u636e\u5e93</a>\u4e2d\u8bb0\u5f55\u7684\u53d7\u6cd5\u5f8b\u4fdd\u62a4\u6216\u7ba1\u7406\u7684\u4fdd\u62a4\u533a\uff0c\u5305\u62ec\u56fd\u5bb6\u516c\u56ed\u548c\u91ce\u751f\u52a8\u7269\u4fdd\u62a4\u533a\u3002\u7531\u4e8e\u4f7f\u7528\u9650\u5236\uff0c\u65e0\u6cd5\u5728 Pro \u4e4b\u5916\u4e0b\u8f7d\u4fdd\u62a4\u533a\u3002&nbsp;", "0a3b3e268e2629869c4a053c1c69313b": "<strong>RSPO \u68d5\u6988\u6cb9\u7279\u8bb8\u7ecf\u8425\u533a</strong>\uff1a\u7ecf<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u53ef\u6301\u7eed\u68d5\u6988\u6cb9\u5706\u684c\u4f1a\u8bae (RSPO) \u8ba4\u8bc1\u7684\u68d5\u6988\u6cb9\u7279\u8bb8\u7ecf\u8425\u533a</a>\u3002\u7531\u4e8e\u4f7f\u7528\u9650\u5236\uff0c\u65e0\u6cd5\u5728 Pro \u4e4b\u5916\u4e0b\u8f7dRSPO \u7279\u8bb8\u7ecf\u8425\u533a\u3002&nbsp;", "d937f88e49010ff777d2a2c3544ac2fb": "\u70b9\u51fb\u201c\u6cb9\u68d5\u7279\u8bb8\u7ecf\u8425\u533a\u201d\u3001\u201c\u68d5\u6988\u6cb9\u52a0\u5de5\u5382\u201d\u6216\u201cRSPO \u68d5\u6988\u7279\u8bb8\u7ecf\u8425\u533a\u201d\u5217\u8868\u540e\uff0c\u6240\u6709\u5730\u70b9\u90fd\u5c06\u51fa\u73b0\u5728\u5217\u8868\u89c6\u56fe\u4e2d\u3002\u7136\u540e\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u4e00\u4e2a\u5730\u70b9\u6216\u6240\u6709\u5730\u70b9\u6765\u67e5\u770b\u9884\u5904\u7406\u5206\u6790\uff0c\u6216\u5bfc\u822a\u5230\u5730\u56fe\u89c6\u56fe\u3002nbsp;", "1819ff4c5808419e46c4f3f8a932c4e0": "\u5728\u8fdb\u5165\u5217\u8868\u89c6\u56fe\u4e4b\u524d\uff0c\u201c\u884c\u653f\u533a\u57df\u201d\u548c\u201c\u4fdd\u62a4\u533a\u201d\u5217\u8868\u4f1a\u63d0\u793a\u60a8\u7b5b\u9009\u5730\u70b9\u3002\u5e94\u7528\u7b5b\u9009\u5668\u540e\uff0c\u60a8\u5c31\u53ef\u4ee5\u67e5\u770b\u9884\u8ba1\u7b97\u5206\u6790\u6216\u67e5\u770b\u6240\u9009\u533a\u57df\u7684\u5730\u56fe\u89c6\u56fe\u3002\u8981\u67e5\u770b\u5217\u8868\u7ea7\u8bca\u65ad\uff0c\u60a8\u5fc5\u987b\u521b\u5efa\u5df2\u7b5b\u9009\u533a\u57df\u7684\u5b50\u5217\u8868\u3002&nbsp;", "2d9354a4e0309f7a29c10744f22e7589": "<strong>\u884c\u653f\u533a\u57df</strong>\uff1a\u7cfb\u7edf\u5c06\u63d0\u793a\u60a8\u9009\u62e9\u4e00\u4e2a\u56fd\u5bb6\u3002\u60a8\u8fd8\u53ef\u4ee5\u9009\u62e9\u5dde\u548c\u5dde\u7684\u4e0b\u7ea7\u884c\u653f\u533a\uff0c\u4ee5\u4fbf\u8fdb\u4e00\u6b65\u7b5b\u9009\u5217\u8868\u3002\u9009\u62e9\u60a8\u60f3\u8981\u7684\u5730\u533a\u540e\uff0c\u70b9\u51fb\u201c\u5e94\u7528\u7b5b\u9009\u5668\u201d\u3002\u5982\u679c\u60a8\u60f3\u7f16\u8f91\u60a8\u7684\u9009\u62e9\uff0c\u8bf7\u70b9\u51fb\u53f3\u4e0a\u89d2\u7684\u201c\u7b5b\u9009\u201d\u3002&nbsp;", "d94cfc1f7baaa7c847a6a1df63952c27": "\u8fdb\u5165\u60a8\u60f3\u8981\u7684\u5217\u8868\u89c6\u56fe\u540e\uff0c\u6309\u7167\u4e0a\u8ff0\u7684\u201c\u590d\u5236\u5730\u70b9\u201d\u5de5\u4f5c\u6d41\u7a0b\uff0c\u4ece GFW \u5217\u8868\u521b\u5efa\u4e00\u4e2a\u5730\u70b9\u5b50\u5217\u8868\u5230\u60a8\u81ea\u5df1\u7684\u8d26\u6237\uff0c\u4ee5\u4fbf\u5206\u6790\u548c\u7a0d\u540e\u8fd4\u56de\u67e5\u770b\u3002&nbsp;", "e12a10892a24f26e55af1e1d14a9d798": "\u5982\u679c\u60a8\u6ca1\u6709\u627e\u5230\u6240\u9700\u7684\u5185\u5bb9\u6216\u5982\u679c\u60a8\u9700\u8981\u5176\u4ed6\u652f\u6301\uff0c\u8bf7\u586b\u5199<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u8868\u683c</a>\u3002&nbsp;", "2da3af9c71b2c9573f520c67ac2ead48": "\u5728 GFW Pro \u4e0a\uff0c\u5f53\u60a8\u5c06\u5730\u70b9\u5217\u8868\u4e0a\u4f20\u5230 GFW Pro \u540e\uff0c\u60a8\u5c31\u53ef\u4ee5\u4ece\u5730\u70b9\u9875\u9762\u548c\u5217\u8868\u89c6\u56fe\u8fdb\u4e00\u6b65\u7ba1\u7406\u548c\u7f16\u8f91\u8be5\u5217\u8868\u3002\u4ee5\u4e0b\u6b65\u9aa4\u5c06\u4e3a\u60a8\u8be6\u7ec6\u8bb2\u89e3\u5982\u4f55\u7ba1\u7406\u5217\u8868\u3001\u4f7f\u7528\u6587\u4ef6\u5939\u7ec4\u7ec7\u6574\u7406\u5217\u8868\u3001\u7f16\u8f91\u5217\u8868\u3001\u79fb\u52a8\u6216\u590d\u5236\u5217\u8868\u4e2d\u7684\u5730\u70b9\u3001\u5220\u9664\u5217\u8868\u4e2d\u7684\u5730\u70b9\u4ee5\u53ca\u7ba1\u7406\u6765\u81ea GFW \u7684\u5217\u8868\u3002&nbsp;", "50d8ec409e49ec732f6158c9fc828786": "\u70b9\u51fb\u9876\u90e8\u83dc\u5355\u4e2d\u7684\u201c\u5730\u70b9\u201d\uff0c\u7136\u540e\u4f7f\u7528\u641c\u7d22\u680f\u5c31\u53ef\u4ee5\u8f7b\u677e\u627e\u5230\u60a8\u5df2\u6dfb\u52a0\u5230\u8d26\u6237\u4e2d\u7684\u5217\u8868\u3002&nbsp;", "ba99f2590b5e9a86e5bd6240a7fb5b80": "\u521b\u5efa\u6587\u4ef6\u5939\u5e76\u5411\u5176\u4e2d\u6dfb\u52a0\u5217\u8868\u540e\uff0c\u8be5\u6587\u4ef6\u5939\u5c06\u663e\u793a\u5728\u5730\u70b9\u7f51\u9875\u4e0a\u7684\u5217\u8868\u4e0a\u65b9\u3002\u5c06\u51fa\u73b0\u4e00\u4e2a\u6a2a\u5e45\uff0c\u8868\u793a\u60a8\u5df2\u5c06\u5217\u8868\u6dfb\u52a0\u5230\u6587\u4ef6\u5939\u4e2d\u3002\u5373\u4f7f\u60a8\u7684\u5217\u8868\u5df2\u6dfb\u52a0\u5230\u6587\u4ef6\u5939\u4e2d\uff0c\u5b83\u4ecd\u5c06\u663e\u793a\u5728\u201c\u6211\u7684\u5730\u70b9\u201d\u4e0b\u3002&nbsp;", "3058810a3e7034dce434624c667e4d8a": "<strong>\u4fdd\u62a4\u533a</strong>\uff1a\u7cfb\u7edf\u5c06\u63d0\u793a\u60a8\u6309\u56fd\u5bb6\u7b5b\u9009\u7ed3\u679c\u3002\u60a8\u8fd8\u53ef\u4ee5\u9009\u62e9\u5dde\u3001\u5dde\u7684\u4e0b\u7ea7\u884c\u653f\u533a\u3001\u6307\u5b9a\u7c7b\u578b\uff08\u4fdd\u62a4\u533a\u7c7b\u578b\uff09\u548c\u6307\u5b9a\u533a\u57df\uff08\u7279\u5b9a\u7684\u4fdd\u62a4\u533a\uff09\u6765\u8fdb\u4e00\u6b65\u7b5b\u9009\u5217\u8868\u3002\u9009\u62e9\u60a8\u60f3\u8981\u7684\u5730\u533a\u540e\uff0c\u70b9\u51fb\u201c\u5e94\u7528\u7b5b\u9009\u5668\u201d\u3002\u5982\u679c\u60a8\u60f3\u7f16\u8f91\u60a8\u7684\u9009\u62e9\uff0c\u8bf7\u70b9\u51fb\u53f3\u4e0a\u89d2\u7684\u201c\u7b5b\u9009\u201d\u3002&nbsp;", "a9a845997cf9dfa7ddae36a53f0fdcae": "\u8349\u7a3f\u5217\u8868\u5982\u4f55\u663e\u793a\u5728\u201c\u5730\u70b9\u201d\u9875\u9762\u4e0a\u3002", "eb52b8fa819c22c9b8bda7e4baf8f325": "<strong>\u6dfb\u52a0\u5230\u6587\u4ef6\u5939</strong>\uff1a\u901a\u8fc7\u5c06\u5217\u8868\u6dfb\u52a0\u5230\u6587\u4ef6\u5939\u6765\u7ec4\u7ec7\u6574\u7406\u5217\u8868\u3002\u5982\u679c\u5217\u8868\u5df2\u5728\u6587\u4ef6\u5939\u4e2d\uff0c\u5219\u201c\u6dfb\u52a0\u5230\u6587\u4ef6\u5939\u201d\u9009\u9879\u5c06\u663e\u793a\u4e3a\u201c\u7ba1\u7406\u201d\u3002\u4e00\u4e2a\u5217\u8868\u4e00\u6b21\u53ea\u80fd\u4f4d\u4e8e\u4e00\u4e2a\u6587\u4ef6\u5939\u4e2d\u3002&nbsp;", "96799547b9fff4e6e6089115f25f19d8": "\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u79fb\u52a8\u201d\u56fe\u6807\uff0c\u7136\u540e\u9009\u62e9\u201c\u590d\u5236\u201d\u3002\u5bf9\u4e8e\u6765\u81ea GFW \u7684\u5217\u8868\uff0c\u53ea\u6709\u201c\u590d\u5236\u201d\u53ef\u7528\u3002&nbsp;", "35a19ef1b86f2d11cf2fad8f508fdf0f": "\u901a\u8fc7\u4e0b\u62c9\u83dc\u5355\u9009\u62e9\u8981\u6dfb\u52a0\u5730\u70b9\u7684\u73b0\u6709\u5217\u8868\u3002\u79fb\u52a8\u5730\u70b9\u65f6\uff0c\u60a8\u5fc5\u987b\u5c06\u5176\u6dfb\u52a0\u5230\u73b0\u6709\u5217\u8868\u4e2d\u3002\u79fb\u52a8\u5730\u70b9\u65f6\uff0c\u60a8\u4e0d\u80fd\u521b\u5efa\u65b0\u5217\u8868\u3002&nbsp;", "04e312f4904cfa237a20b67d7a2838e7": "<strong>\u5c06\u5730\u70b9\u79fb\u52a8\u5230\u5217\u8868</strong>\uff1a\u5c06\u5730\u70b9\u4ece\u539f\u5217\u8868\u79fb\u52a8\u5230\u53e6\u4e00\u4e2a\u5217\u8868\u3002\u5730\u70b9\u5c06\u4e0d\u518d\u51fa\u73b0\u5728\u539f\u5217\u8868\u4e2d\u3002\u60a8\u53ea\u80fd\u5c06\u5730\u70b9\u79fb\u52a8\u5230\u5177\u6709\u76f8\u540c\u6a21\u677f\u7c7b\u578b\u7684\u5176\u4ed6\u5217\u8868\u4e2d\u3002\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u9009\u62e9\u6b63\u786e\u7684\u6a21\u677f\u7c7b\u578b\u3002&nbsp;", "caa9c65e17f82b9dcab36c9d82d098bf": "GFW \u6709\u4e94\u4e2a\u5217\u8868\u53ef\u5728 Pro \u4e0a\u4f7f\u7528\u3002\u8fd9\u4e9b\u5217\u8868\u4ee3\u8868\u4e86 GFW \u56e2\u961f\u9009\u62e9\u6216\u521b\u5efa\u7684\u6570\u636e\u3002\u60a8\u53ef\u4ee5\u4f7f\u7528\u8fd9\u4e9b\u5217\u8868\u521b\u5efa\u60a8\u81ea\u5df1\u7684\u5b50\u5217\u8868\u3002&nbsp;", "d8b3ffda7bdfa0d402eee246be6c2c83": "\u9009\u62e9\u8981\u5bf9\u201c2020 \u5e74\u540e\u7684\u98ce\u9669\u8bc4\u4f30\u201d\u5e94\u7528\u7684\u6570\u636e\u5c42\u3002", "120dc3409762b89ff5bbd6abe881e961": "\u5411\u4e0b\u6eda\u52a8\u67e5\u770b\u5217\u8868\u5185\u5730\u70b9\u7684\u53ef\u5ffd\u7565\u98ce\u9669\u91cd\u53e0\u3002", "3c134a6cc5f161c64a96f532c8c22ca4": "\u4ee5\u4e0b\u6b65\u9aa4\u5c06\u6307\u5bfc\u60a8\u5982\u4f55\u5728\u5185\u90e8\u5171\u4eab\u5217\u8868\u3001\u63a5\u6536\u5171\u4eab\u5217\u8868\u4ee5\u53ca\u5bfc\u51fa\u5217\u8868\u3002\u82e5\u8981\u4e0e\u7ec4\u7ec7\u5185\u7684\u5176\u4ed6\u7528\u6237\u5171\u4eab\u5217\u8868\uff0c\u8bf7\u6309\u7167\u5728\u5185\u90e8\u5171\u4eab\u5217\u8868\u7684\u6b65\u9aa4\u64cd\u4f5c\u3002\u53ea\u6709\u5177\u6709\u7ba1\u7406\u5458\u6743\u9650\u7684\u7528\u6237\u53ef\u5728\u5185\u90e8\u5171\u4eab\u5217\u8868\uff0c\u7f16\u8f91\u8005\u548c\u67e5\u770b\u8005\u5219\u53ef\u63a5\u6536\u5171\u4eab\u5217\u8868\u3002\u8349\u7a3f\u5217\u8868\uff08\u5373\u4fdd\u5b58\u5728\u60a8\u7684 Pro \u8d26\u6237\u4e2d\uff0c\u7559\u5f85\u7a0d\u540e\u6dfb\u52a0\u3001\u7f16\u8f91\u6216\u66f4\u6539\u5185\u5bb9\u540e\u518d\u63d0\u4ea4\u5206\u6790\u7684\u5217\u8868\uff09\u53ef\u4ee5\u5171\u4eab\u3002\u53ea\u6709\u5217\u8868\u521b\u5efa\u8005\u53ef\u5c06\u5217\u8868\u63d0\u4ea4\u5206\u6790\u3002\u82e5\u8981\u5728\u7ec4\u7ec7\u5916\u5171\u4eab\u5217\u8868\uff0c\u8bf7\u6309\u7167\u5bfc\u51fa\u5217\u8868\u7684\u6b65\u9aa4\u64cd\u4f5c\u3002", "f11d7745b3098ef277272ca87a7a0090": "\u5982\u6709\u7591\u95ee\u6216\u9700\u8981\u5176\u4ed6\u652f\u6301\uff0c\u8bf7\u586b\u5199<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u8868\u5355</a>\u8054\u7cfb\u6211\u4eec\u3002", "8b93e110a9b106398f74ef03070ea309": "\u6b63\u5728\u4ece\u5730\u70b9\u9875\u9762\u5171\u4eab", "455fa049aa77115b3a3afb019b0e1b93": "\u5bf9\u5217\u8868\u7684\u4efb\u4f55\u66f4\u65b0\u6216\u7f16\u8f91\u90fd\u5c06\u81ea\u52a8\u66f4\u65b0\u7ed9\u8be5\u5217\u8868\u7684\u6240\u6709\u5171\u4eab\u7528\u6237\u3002", "b1a6c976e40de70631a085d91bbe45fe": "\u9009\u62e9\u201c\u5171\u4eab\u201d\u9009\u9879\uff0c\u7136\u540e\u5728\u4e0b\u62c9\u83dc\u5355\u5185\u9009\u62e9\u8981\u5728\u7ec4\u7ec7\u5185\u5171\u4eab\u5217\u8868\u7684\u5bf9\u8c61\u3002\u9009\u62e9\u5b8c\u6bd5\u540e\uff0c\u70b9\u51fb\u201c\u6dfb\u52a0\u7528\u6237\u201d\u3002", "91e2593fca064affa02e692534560a2c": "\u6b63\u5728\u4ece\u5217\u8868\u8be6\u60c5\u9875\u9762\u5171\u4eab", "59b53a219a2f8ecfee260a159e2bf59d": "\u5728\u9876\u90e8\u83dc\u5355\u70b9\u51fb\u201c\u5730\u70b9\u201d\u9009\u9879\u5361\uff0c\u7136\u540e\u5411\u4e0b\u6eda\u52a8\u5230\u201c\u6211\u7684\u5217\u8868\u201d\uff0c\u9009\u62e9\u8981\u5171\u4eab\u7684\u5217\u8868\u3002", "801b0246bad246d62884d9a63478ffc3": "\u5728\u5217\u8868\u53f3\u4e0a\u89d2\u9009\u62e9\u201c\u5171\u4eab\u201d\u3002", "6bf7f7b438f1f0b21707eb6a4155b1f6": "\u70b9\u51fb\u201c\u786e\u5b9a\u201d\uff0c\u786e\u8ba4\u8981\u5171\u4eab\u5217\u8868\u3002\u786e\u8ba4\u5b8c\u6bd5\u540e\uff0c\u4e0e\u60a8\u5171\u4eab\u5217\u8868\u7684\u7528\u6237\u5c06\u51fa\u73b0\u5728\u5171\u4eab\u7528\u6237\u5217\u8868\u4e2d\uff0c\u5e76\u5c06\u5e26\u6709\u6307\u660e\u5171\u4eab\u65f6\u95f4\u7684\u65f6\u95f4\u6233\u3002", "12a994c68aa3b09396230e6417bffbfe": "\u70b9\u51fb\u201c\u786e\u5b9a\u201d\uff0c\u786e\u8ba4\u8981\u5171\u4eab\u5217\u8868\u3002", "e675671f7c940296dd3c33f66ef20465": "\u60a8\u9700\u8981\u7533\u8bf7\u7ec4\u7ec7\u8d26\u6237\u624d\u80fd\u8bbf\u95ee <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">GFW Pro</a>\u3002\u8d26\u6237\u6fc0\u6d3b\u540e\u5373\u53ef\u6dfb\u52a0\u7528\u6237\u548c\u7ba1\u7406\u6743\u9650\u3001\u4e0a\u4f20\u5e76\u5206\u6790\u5730\u70b9\u3001\u6d4f\u89c8\u5e76\u4e0b\u8f7d\u7279\u5b9a\u5730\u70b9\u6216\u5730\u70b9\u5217\u8868\u7684\u8be6\u7ec6\u8bca\u65ad\u3001\u67e5\u770b\u8fd1\u5b9e\u65f6\u8b66\u62a5\uff0c\u4ee5\u53ca\u4e0e\u540c\u4e8b\u5206\u4eab\u62a5\u544a\u3002", "3dc02872c77eba6302ab5fc9e131f9a3": "\u5982\u9700\u4e86\u89e3\u7ec4\u7ec7\u53ef\u4ee5\u5982\u4f55\u4f7f\u7528 GFW Pro\uff0c\u60a8\u53ef\u4ee5\u89c2\u770b\u6765\u81ea <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">ofi</a> \u548c<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5609\u5409 (Cargill)</a> \u7684\u5ba2\u6237\u8bc4\u4ef7\u89c6\u9891\u3002", "9c38589c872383ac5855f45053a886b0": "GFW Pro\uff08\u7b80\u79f0 Pro\uff09\u63d0\u4f9b\u4ee5\u4e0b\u4e09\u79cd\u4e0d\u540c\u7684\u5206\u6790\uff1a2000 \u5e74\u540e\u7684\u68ee\u6797\u53d8\u5316\u30012020 \u5e74\u540e\u7684\u98ce\u9669\u8bc4\u4f30\u548c\u8fd1\u671f\u6bc1\u6797\u8b66\u62a5\u3002", "ce5bf1497d7490e77ac83dc52372bce5": "\u5206\u6790\u60a8\u7684\u5730\u70b9", "44ee6e46e551e7c571be5f3ce7b51ae5": "Pro \u53ef\u5bf9\u4efb\u4f55\u5df2\u5904\u7406\u5217\u8868\u5e94\u7528\u201c2000 \u5e74\u540e\u7684\u68ee\u6797\u53d8\u5316\u201d\u5206\u6790\u3002", "d9a8d1bf5db77e6aae391cb2abf6ca5c": "\u60a8\u5c06\u5728\u6709\u65b0\u7684\u6570\u636e\u66f4\u65b0\u53ef\u7528\u65f6\u6536\u5230\u6765\u81ea GFW Pro \u7684\u901a\u4fe1\u3002\u82e5\u8981\u7528\u6700\u65b0\u6570\u636e\u66f4\u65b0\u5217\u8868\u4e2d\u7684\u5730\u70b9\uff0c\u8bf7\u6309\u4ee5\u4e0b\u56db\u6b65\u64cd\u4f5c\u3002", "1facd494b725dabe1083616700969bd4": "\u60a8\u5c06\u5728\u9875\u9762\u9876\u90e8\u770b\u5230\u5730\u70b9\u7684\u76f8\u5173\u5386\u53f2\u7279\u5f81\u4ee5\u53ca\u5730\u70b9\u5730\u56fe\u3002\u70b9\u51fb\u5730\u56fe\u5373\u53ef\u4ee5\u5730\u56fe\u89c6\u56fe\u67e5\u770b\u5730\u70b9\u3002", "dec38605ab5761df00769e25fc950c1c": "\u5728\u9876\u90e8\u83dc\u5355\u70b9\u51fb\u201c\u5730\u70b9\u201d\u9009\u9879\u5361\u3002", "a381930cae181e93a9678a94210f9de6": "\u70b9\u51fb\u5217\u8868\u884c\u53f3\u4fa7\u7684\u4e09\u70b9\u7b26\u53f7\u3002", "b40a96566a9b944fb16f7d06254f1af8": "\u70b9\u51fb\u201c\u786e\u5b9a\u201d\uff0c\u786e\u8ba4\u8981\u505c\u6b62\u4e0e\u7279\u5b9a\u7528\u6237\u5171\u4eab\u5217\u8868\u3002", "26b35e2a433cbc3e8838d8bae16286a6": "\u6536\u5230\u5171\u4eab\u5217\u8868\u65f6\uff0c\u5730\u70b9\u9875\u9762\u4e0a\u7684\u5217\u8868\u540d\u79f0\u65c1\u5c06\u663e\u793a\u5df2\u5171\u4eab\u56fe\u6807\u3002\u5217\u8868\u63a5\u6536\u4eba\u53ef\u67e5\u770b\u5b8c\u6574\u7684\u5730\u70b9\u4fe1\u606f\uff0c\u4f46\u65e0\u6cd5\u66f4\u65b0\u3001\u7f16\u8f91\u6216\u5728\u5185\u90e8\u518d\u6b21\u5171\u4eab\u5217\u8868\u3002\u4e0d\u8fc7\uff0c\u63a5\u6536\u4eba\u53ef\u4ee5\u4e0b\u8f7d\u5217\u8868\u7ed3\u679c\u5e76\u5bfc\u51fa CSV \u6216 Shapefile \u5217\u8868\u6a21\u677f\u3002\u82e5\u5217\u8868\u5904\u4e8e\u8349\u7a3f\u72b6\u6001\uff0c\u5219\u5217\u8868\u540d\u79f0\u65c1\u5c06\u663e\u793a\u8349\u7a3f\u56fe\u6807\u3002", "4d3d4f5442fa900518ef7e4b3bfea884": "\u5728\u9876\u90e8\u83dc\u5355\u70b9\u51fb\u201c\u5730\u70b9\u201d\u9009\u9879\u5361\uff0c\u7136\u540e\u5411\u4e0b\u6eda\u52a8\u5230\u201c\u6211\u7684\u5217\u8868\u201d\uff0c\u9009\u62e9\u8981\u5bfc\u51fa\u7684\u5217\u8868\u3002", "76fdd632e848148560424a07de13da26": "\u60a8\u5c06\u8fdb\u5165\u5217\u8868\u8be6\u60c5\u9875\u9762\u3002\u5728\u8be5\u9875\u9762\u70b9\u51fb\u8868\u683c\u76f8\u5e94\u884c\u65c1\u7684\u590d\u9009\u6846\uff0c\u5373\u53ef\u9009\u4e2d\u8981\u5bfc\u51fa\u7684\u5730\u70b9\u3002\u82e5\u8981\u5bfc\u51fa\u6240\u6709\u5730\u70b9\uff0c\u70b9\u51fb\u8868\u683c\u5de6\u4e0a\u89d2\u201c\u5730\u70b9\u540d\u79f0\u201d\u65c1\u7684\u590d\u9009\u6846\uff0c\u5373\u53ef\u9009\u4e2d\u6240\u6709\u5730\u70b9\u3002", "1a843b0869004afca5d3802a4f8fa65a": "\u82e5\u6b63\u5728\u4e0b\u8f7d\u7684\u5217\u8868\u5904\u4e8e\u8349\u7a3f\u72b6\u6001\u4e14\u5305\u542b\u672a\u7ecf\u5206\u6790\u7684\u5730\u70b9\uff0c\u5219\u5728\u91cd\u65b0\u4e0a\u4f20\u5217\u8868\u5e76\u63d0\u4ea4\u5206\u6790\u524d\uff0c\u4e0b\u8f7d\u7684\u6587\u4ef6\u4e2d\u5c06\u4e0d\u4f1a\u5305\u542b\u6240\u6709\u53c2\u6570\u4fe1\u606f\u6216\u7ed3\u679c\u3002", "590392386161536994629c2b56a08584": "\u6ce8\uff1a\u7531\u4e8e\u4f7f\u7528\u91cf\u9650\u5236\uff0c\u5c06\u65e0\u6cd5\u4e0b\u8f7d\u201c\u4fdd\u62a4\u533a\u201d\u548c\u201cRSPO \u68d5\u6988\u7279\u8bb8\u7ecf\u8425\u6743\u201d\u7684 GFW \u5217\u8868\u548c\u5730\u70b9\u3002\u201c\u884c\u653f\u533a\u57df\u201d\u7684 GFW \u5217\u8868\u5219\u5fc5\u987b\u7ecf\u8fc7\u7b5b\u9009\u624d\u80fd\u4e0b\u8f7d\u3002", "dd82c9cf3fa6e76d5f74d24b63edc1c0": "<strong>\u300a\u68d5\u6988\u98ce\u9669\u8bc4\u4f30\u300b</strong>\u662f\u5305\u542b\u5728\u68ee\u6797\u53d8\u5316\u5206\u6790\u4e2d\u7684\u9644\u52a0\u62a5\u544a\u3002\u8be5\u8bc4\u4f30\u5c06\u8bf4\u660e\u60a8\u7684\u68d5\u6988\u6cb9\u91c7\u8d2d\u5730\u6216\u68d5\u6988\u6cb9\u5382\u7684\u6bc1\u6797\u76f8\u5173\u98ce\u9669\u3002\u60a8\u662f\u5426\u4f1a\u6536\u5230\u300a\u68d5\u6988\u98ce\u9669\u8bc4\u4f30\u300b\u53d6\u51b3\u4e8e\u60a8\u5728\u5217\u8868\u4e2d\u5b9a\u4e49\u7684\u5546\u54c1\u7c7b\u578b\u3002", "366f8f3f4753a26a318f6d5b1a737c23": "\u5404\u5730\u70b9\u6216\u5730\u70b9\u5217\u8868\u53ef\u4ee5\u5148\u4e0a\u4f20\u4e3a\u8349\u7a3f\u3002\u82e5\u8981\u83b7\u5f97\u6d1e\u89c1\uff0c\u5fc5\u987b\u5c06\u5217\u8868\u63d0\u4ea4\u5230\u4e09\u79cd\u53ef\u7528\u5206\u6790\u4e2d\u7684\u81f3\u5c11\u4e00\u79cd\u3002\u4e0a\u4f20\u5904\u7406\u65f6\u95f4\u6700\u957f\u53ef\u8fbe 24 \u5c0f\u65f6\u3002\u5728\u5904\u7406\u5b8c\u6210\u4e4b\u524d\uff0c\u663e\u793a\u5728\u5730\u70b9\u9875\u9762\u4e0a\u7684\u76f8\u5173\u5217\u8868\u5c06\u5e26\u6709\u201c\u6b63\u5728\u5206\u6790\u201d\u6807\u7b7e\uff0c\u800c\u4e14\u65e0\u6cd5\u67e5\u770b\u3002\u60a8\u5c06\u5728\u5904\u7406\u5f00\u59cb\u65f6\u548c\u5b8c\u6210\u540e\u5206\u522b\u6536\u5230\u786e\u8ba4\u90ae\u4ef6\u3002\u5217\u8868\u7ea7\u8bca\u65ad\u4e0d\u53ef\u7528\u4e8e\u8349\u7a3f\u72b6\u6001\u4e0b\u7684\u5217\u8868\u3002", "435f1f0795a70a1863237a8ae8a8d38a": "\u82e5\u8981\u67e5\u770b\u201c2000 \u5e74\u540e\u7684\u68ee\u6797\u53d8\u5316\u201d\u5206\u6790\uff0c\u8bf7\u5148\u5728\u9876\u90e8\u83dc\u5355\u70b9\u51fb\u201c\u5730\u70b9\u201d\u9009\u9879\u5361\uff0c\u7136\u540e\u5411\u4e0b\u6eda\u52a8\u5230\u201c\u6211\u7684\u5730\u70b9\u201d\uff0c\u9009\u62e9\u4e00\u4e2a\u5df2\u5f7b\u5e95\u5904\u7406\u5b8c\u6bd5\u5e76\u5e94\u7528\u4e86\u8be5\u5206\u6790\u7684\u5217\u8868\u3002\u4e4b\u540e\u7cfb\u7edf\u5c06\u52a0\u8f7d\u4e00\u5f20\u5305\u542b\u8be5\u5217\u8868\u6240\u6709\u5730\u70b9\u7684\u8868\u683c\u3002", "c2568a39ee97774b7a323f25116a00d9": "\u9ed8\u8ba4\u60c5\u51b5\u4e0b\uff0c\u8868\u683c\u5c06\u663e\u793a\u5730\u70b9\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u60c5\u51b5\u3001\u5f53\u524d\u6811\u6728\u8986\u76d6\u60c5\u51b5\u548c\u539f\u59cb\u68ee\u6797\u8986\u76d6\u60c5\u51b5\u3002\u60a8\u53ef\u4ee5\u6458\u8981\uff08\u662f/\u5426\uff09\u3001\u516c\u9877\u6570 (Ha) \u6216\u5404\u5730\u70b9\u767e\u5206\u6bd4 (%) \u7684\u5f62\u5f0f\u67e5\u770b\u8fd9\u4e9b\u6570\u636e\u3002\u82e5\u5217\u8868\u5904\u4e8e\u8349\u7a3f\u72b6\u6001\uff0c\u5219\u5728\u5c06\u6574\u4e2a\u5217\u8868\u63d0\u4ea4\u5206\u6790\u4e4b\u524d\uff0c\u5217\u8868\u5185\u7684\u672a\u5206\u6790\u5730\u70b9\u5c06\u4e0d\u4f1a\u5305\u542b\u6240\u6709\u4fe1\u606f\u3002", "cd90c4e9c94a7f2070b077941491c251": "\u5728\u5730\u70b9\u9875\u9762\u70b9\u51fb\u8981\u5206\u6790\u7684\u5217\u8868\u3002", "9b6c28b6c84d37540148ae37985314bf": "\u70b9\u51fb \u201c\u2026\u201d \u83dc\u5355\u5e76\u9009\u62e9\u5176\u4ed6\u8981\u67e5\u770b\u7684\u5b57\u6bb5\u3002", "02e04e133acc6fef5242866116d3ebbb": "\u5217\u8868\u53ef\u6392\u5e8f\u5217\u7684\u5217\u540d\u65c1\u6807\u6709\u5411\u4e0a/\u5411\u4e0b\u7684\u5c0f\u7bad\u5934\u3002\u82e5\u8981\u5728\u5217\u8868\u89c6\u56fe\u4e0b\u5bf9\u5404\u5217\u6392\u5e8f\uff0c\u8bf7\u70b9\u51fb\u5217\u6807\u9898\u3002\u518d\u6b21\u70b9\u51fb\u5217\u6807\u9898\uff0c\u5373\u53ef\u5728\u6309\u6570\u5b57\u5347\u5e8f\u6392\u5e8f\u3001\u6309 A-Z \u5b57\u6bcd\u6392\u5e8f\u548c\u6309\u65e5\u671f\u5347\u5e8f\u6392\u5e8f\u7b49\u6392\u5e8f\u65b9\u5f0f\u95f4\u8fdb\u884c\u5207\u6362\u3002\u5df2\u5206\u6790\u5217\u8868\u548c\u8349\u7a3f\u5217\u8868\u5177\u6709\u76f8\u540c\u7684\u6392\u5e8f\u884c\u4e3a\u3002", "f26937f865feaacd1d53cc728f967ae5": "\u9875\u9762\u7684\u5176\u4f59\u90e8\u5206\u5c06\u663e\u793a\u5bf9\u5730\u70b9\u5728 2000 \u5e74\u540e\u7684\u68ee\u6797\u53d8\u5316\u7684\u5206\u6790\u4ee5\u53ca\u76f8\u5173\u56fe\u8868\uff0c\u5305\u62ec\u654f\u611f\u5730\u533a\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u60c5\u51b5\u548c\u4e00\u6bb5\u65f6\u95f4\u5185\u7684\u6811\u6728\u8986\u76d6\u60c5\u51b5\u3002\u60a8\u53ef\u4ee5\u9009\u62e9\u6811\u6728\u8986\u76d6\u635f\u5931\u548c/\u6216\u5176\u4ed6\u6570\u636e\u5c42\u81ea\u5b9a\u4e49\u6570\u636e\u56fe\u8868\uff0c\u5e76\u53ef\u901a\u8fc7\u62d6\u653e\u4e24\u7aef\u7684\u65f6\u95f4\u6ed1\u5757\u6765\u8bbe\u7f6e\u8981\u67e5\u770b\u7684\u65e5\u671f\u8303\u56f4\u3002", "5894864a509bc9e0f59ed5e53c329d7e": "\u8bbf\u95ee\u201c\u68d5\u6988\u98ce\u9669\u201d\u5217\u8868\u89c6\u56fe", "7147f22a3e161c38dc89c0bf9718b00b": "\u82e5\u8981\u67e5\u770b\u201c\u68d5\u6988\u98ce\u9669\u8bc4\u4f30\u201d\uff0c\u8bf7\u5148\u5728\u9876\u90e8\u83dc\u5355\u70b9\u51fb\u201c\u5730\u70b9\u201d\u9009\u9879\u5361\uff0c\u7136\u540e\u5411\u4e0b\u6eda\u52a8\u5230\u201c\u6211\u7684\u5217\u8868\u201d\uff0c\u9009\u62e9\u4e00\u4e2a\u5df2\u5f7b\u5e95\u5904\u7406\u5b8c\u6bd5\u7684\u5217\u8868\u3002\u8be5\u5217\u8868\u5e94\u5305\u542b\u5b9a\u4e49\u4e3a\u68d5\u6988\u6cb9\u7684\u5546\u54c1\u6216\u4e0a\u4f20\u81f3 Pro \u7684\u68d5\u6988\u6cb9\u5382\u3002\u4e4b\u540e\u7cfb\u7edf\u5c06\u52a0\u8f7d\u4e00\u5f20\u5305\u542b\u8be5\u5217\u8868\u6240\u6709\u5730\u70b9\u7684\u8868\u683c\uff0c\u5728\u8868\u683c\u4e0a\u65b9\u9009\u62e9\u201c\u68d5\u6988\u98ce\u9669\u8bc4\u4f30\u201d\u9009\u9879\u5361\u5373\u53ef\u3002", "54292f8ad29d1e516d1014aab43cb520": "\u9009\u62e9\u5730\u56fe\u4e0b\u65b9\u53f3\u4e0a\u89d2\u7684\u201c\u62a5\u544a\u201d\uff0c\u5373\u53ef\u751f\u6210\u8be5\u9875\u9762\u7684\u53ef\u6253\u5370 PDF \u6587\u4ef6\u3002\u60a8\u4e5f\u53ef\u9009\u62e9\u201c\u4e0b\u8f7d\u201d\uff0c\u4ee5 CSV \u6587\u4ef6\u683c\u5f0f\u4e0b\u8f7d\u9875\u9762\u4e0a\u7684\u6240\u6709\u6570\u636e\u3002", "82479bcba3f604c08e9ad8993d9cc4fa": "\u5982\u9002\u7528\u4e8e\u60a8\u7684\u5217\u8868\u548c\u6240\u5b9a\u4e49\u7684\u5546\u54c1\u7c7b\u578b\uff0c\u5728\u9760\u8fd1\u9875\u9762\u9876\u90e8\u7684\u4f4d\u7f6e\u9009\u62e9\u201c\u68ee\u6797\u53d8\u5316\u201d\u65c1\u7684\u9009\u9879\u5361\uff0c\u5373\u53ef\u67e5\u770b\u201c\u68d5\u6988\u98ce\u9669\u8bc4\u4f30\u201d\u3002", "3a666a17dda4e263f74dbca7d9f6ad95": "\u9009\u62e9\u201c\u68ee\u6797\u53d8\u5316\u201d\u65c1\u7684\u201c\u68d5\u6988\u98ce\u9669\u8bc4\u4f30\u201d\u9009\u9879\u5361", "06243341f235e724e01a1e12134345bd": "\u6309\u7167\u4e0a\u8ff0\u8bf4\u660e\u70b9\u51fb\u201c\u5217\u8868\u8bca\u65ad\u201d\u6216\u201c\u5730\u70b9\u8bca\u65ad\u201d\u8fdb\u5165\u8bca\u65ad\u9875\u9762\u3002", "39479700686122baa987b2c6816ab412": "\u70b9\u51fb\u7b5b\u9009\u5668\u56fe\u6807\uff0c\u7136\u540e\u9009\u62e9\u8981\u5bf9\u8868\u683c\u5e94\u7528\u7684\u7b5b\u9009\u6761\u4ef6\u3002", "1b551ebda19971592a24bcf0eb321a4d": "\u82e5\u8981\u5728\u5217\u8868\u89c6\u56fe\u4e0b\u5bf9\u5404\u5217\u6392\u5e8f\uff0c\u8bf7\u70b9\u51fb\u5217\u6807\u9898\u3002\u518d\u6b21\u70b9\u51fb\u5217\u6807\u9898\uff0c\u5373\u53ef\u5728\u6309\u6570\u5b57\u5347\u5e8f\u6392\u5e8f\u3001\u6309 A-Z \u5b57\u6bcd\u6392\u5e8f\u548c\u6309\u65e5\u671f\u5347\u5e8f\u6392\u5e8f\u7b49\u6392\u5e8f\u65b9\u5f0f\u95f4\u8fdb\u884c\u5207\u6362\u3002\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u5730\u56fe\u201d\uff0c\u5373\u53ef\u4ee5\u5730\u56fe\u89c6\u56fe\u67e5\u770b\u5217\u8868\u4e2d\u7684\u5730\u70b9\u3002\u5df2\u5206\u6790\u5217\u8868\u548c\u8349\u7a3f\u5217\u8868\u5177\u6709\u76f8\u540c\u7684\u6392\u5e8f\u884c\u4e3a\u3002", "6be994cad9c337dfcd182bc109e05619": "\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u53ef\u70b9\u51fb\u9009\u9879\u5361\u5373\u53ef\u9009\u62e9\u201c2020 \u5e74\u540e\u7684\u98ce\u9669\u8bc4\u4f30\u201d\u5206\u6790\u3002", "3fc7a02f6462cc77e21dfd00d52845dc": "\u5728\u5730\u70b9\u7f51\u9875\u70b9\u51fb\u8981\u67e5\u770b\u7684\u5217\u8868\u3002", "f9f77fd5cccc0db9313cf7cbee7550f0": "\u82e5\u76f8\u5173\u5730\u70b9\u4e0e\u539f\u4f4f\u6c11\u9886\u5730\u6216\u4fdd\u62a4\u533a\u6709\u91cd\u53e0\uff0c\u5219\u8be5\u8868\u683c\u5c06\u663e\u793a 2020 \u5e74\u4ee5\u6765\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u4fe1\u606f\u3002\u60a8\u53ef\u4ee5\u6458\u8981\uff08\u662f/\u5426\uff09\u3001\u516c\u9877\u6570 (Ha) \u6216\u5404\u5730\u70b9\u767e\u5206\u6bd4 (%) \u7684\u5f62\u5f0f\u67e5\u770b\u8fd9\u4e9b\u6570\u636e\u3002\u82e5\u5217\u8868\u5904\u4e8e\u8349\u7a3f\u72b6\u6001\uff0c\u5219\u5728\u5c06\u6574\u4e2a\u5217\u8868\u63d0\u4ea4\u5206\u6790\u4e4b\u524d\uff0c\u5217\u8868\u5185\u7684\u672a\u5206\u6790\u5730\u70b9\u5c06\u4e0d\u4f1a\u5305\u542b\u6240\u6709\u4fe1\u606f\u3002", "7c2104f2995d2c5d4d9b53535be8f44f": "\u82e5\u8981\u67e5\u770b\u6a21\u677f\u4e2d\u7684\u5176\u4ed6\u6570\u636e\u5217\uff0c\u8bf7\u70b9\u51fb \u201c\u2026\u201d \u83dc\u5355\uff0c\u7136\u540e\u5728\u5176\u4ed6\u8981\u67e5\u770b\u7684\u5b57\u6bb5\u65c1\u70b9\u51fb\u590d\u9009\u6846\u3002\u65b0\u52a0\u5217\u5c06\u663e\u793a\u5728\u8868\u683c\u6700\u53f3\u4fa7\u3002\u82e5\u8981\u9690\u85cf\u5217\uff0c\u8bf7\u70b9\u51fb \u201c\u2026\u201d \u83dc\u5355\u5e76\u53d6\u6d88\u9009\u4e2d\u8981\u9690\u85cf\u7684\u5b57\u6bb5\u3002\u60a8\u4e5f\u53ef\u4ee5\u70b9\u51fb\u201c\u5168\u9009\u201d\u6216\u201c\u53d6\u6d88\u5168\u9009\u201d\u6765\u4e00\u6b21\u6027\u9009\u4e2d\u6216\u53d6\u6d88\u9009\u4e2d\u6240\u6709\u5b57\u6bb5\u3002\u82e5\u5217\u8868\u5904\u4e8e\u8349\u7a3f\u72b6\u6001\uff0c\u5219\u5728\u5c06\u6574\u4e2a\u5217\u8868\u63d0\u4ea4\u5206\u6790\u4e4b\u524d\uff0c\u5217\u8868\u5185\u7684\u672a\u5206\u6790\u5730\u70b9\u5c06\u4e0d\u4f1a\u5305\u542b\u6240\u6709\u4fe1\u606f\u3002", "4adcde909d5e42f0a67d9d312043fc7c": "\u70b9\u51fb \u201d\u2026\u201d \u83dc\u5355\u5e76\u9009\u62e9\u5176\u4ed6\u8981\u67e5\u770b\u7684\u5b57\u6bb5\u3002", "e97b565db847f5ead43c6c506b6baf8e": "\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u5217\u8868\u5730\u56fe\u201d\uff0c\u5373\u53ef\u4ee5\u5730\u56fe\u89c6\u56fe\u67e5\u770b\u5217\u8868\u4e2d\u7684\u5730\u70b9\u3002\u5c06\u9f20\u6807\u60ac\u505c\u5728\u5355\u4e2a\u5730\u70b9\u4e0a\uff0c\u7136\u540e\u9009\u62e9\u201c\u5730\u56fe\u201d\uff0c\u5373\u53ef\u4ee5\u5730\u56fe\u89c6\u56fe\u67e5\u770b\u7279\u5b9a\u5730\u70b9\u3002", "4e98f4a6c0611bd3b8281599f6bed8c1": "\u60a8\u5c06\u6536\u5230\u4e00\u5c01\u901a\u77e5\u90ae\u4ef6\uff0c\u544a\u77e5\u60a8\u7cfb\u7edf\u5df2\u7ecf\u7528\u6700\u65b0\u7684\u53ef\u7528\u6570\u636e\u5f00\u59cb\u5206\u6790\u60a8\u7684\u5730\u70b9\u548c\u5217\u8868\u3002\u60a8\u7684\u5217\u8868\u5c06\u5728\u5206\u6790\u5904\u7406\u671f\u95f4\u4e0d\u53ef\u7528\u3002", "494c745eb334aa40ef5af1ed865081d0": "\u60a8\u5c06\u5728\u5206\u6790\u7ed3\u675f\u4e14\u5217\u8868\u53ef\u7528\u65f6\u518d\u6b21\u6536\u5230\u7535\u5b50\u90ae\u4ef6\u3002", "c9ad15c38b4d6e5a56e387ed0dc7e72f": "\u6309\u7167\u4e0a\u8ff0\u8bf4\u660e\u70b9\u51fb\u201c\u5217\u8868\u8bca\u65ad\u201d\u6216\u201c\u5730\u70b9\u8bca\u65ad\u201d\u8fdb\u5165\u8bca\u65ad\u9875\u9762\u3002", "c47fba43069ff092fd1c7152f6f3ac83": "\u201c2020 \u5e74\u540e\u7684\u98ce\u9669\u8bc4\u4f30\u201d\u8bca\u65ad\u89c6\u56fe\u5c06\u63d0\u4f9b\u5404\u5730\u70b9\u7684\u56fd\u5bb6\u548c\u5730\u65b9\u4fe1\u606f\u3001\u5929\u7136\u6797\u8986\u76d6\u60c5\u51b5\u3001\u5929\u7136\u6797\u635f\u5931\u60c5\u51b5\u4ee5\u53ca\u4e0e\u4fdd\u62a4\u533a\u548c\u539f\u4f4f\u6c11\u9886\u571f\u7684\u91cd\u53e0\u6570\u91cf\u3002", "73b0f7a97da98f2a94906feb1bbdf2f9": "\u60a8\u5c06\u5728\u5206\u6790\u7ed3\u675f\u4e14\u5217\u8868\u53ef\u7528\u65f6\u518d\u6b21\u6536\u5230\u7535\u5b50\u90ae\u4ef6\u3002", "757268d058738c5c5135d0cc03f0a3ee": "\u8bbf\u95ee\u201c2000 \u5e74\u540e\u7684\u68ee\u6797\u53d8\u5316\u201d\u8bca\u65ad\u89c6\u56fe", "998ff4b07b9a7b3641dc34491f0ebe6f": "\u5728\u201c2000 \u5e74\u540e\u7684\u68ee\u6797\u53d8\u5316\u201d\u5217\u8868\u89c6\u56fe\u4e2d\u9009\u62e9\u201c\u5217\u8868\u8bca\u65ad\u201d\uff0c\u5373\u53ef\u67e5\u770b\u5217\u8868\u4e2d\u6240\u6709\u5730\u70b9\u7684\u8bca\u65ad\u4fe1\u606f\u3002\u5c06\u9f20\u6807\u60ac\u505c\u5728\u5355\u4e2a\u5730\u70b9\u4e0a\uff0c\u7136\u540e\u9009\u62e9\u201c\u5730\u70b9\u8bca\u65ad\u201d\uff0c\u5373\u53ef\u67e5\u770b\u5217\u8868\u4e2d\u5355\u4e2a\u5730\u70b9\u7684\u8bca\u65ad\u4fe1\u606f\u3002\u5305\u542b\u5df2\u5206\u6790\u5730\u70b9\u7684\u8349\u7a3f\u5217\u8868\u5c06\u4ec5\u53ef\u4f7f\u7528\u5730\u70b9\u7ea7\u8bca\u65ad\u3002", "2d48d50d45cfb0d8cde0e14fb023aa27": "\u6709\u5173\u8be5\u7f51\u9875\u4efb\u4f55\u7ec4\u4ef6\u7684\u8be6\u7ec6\u4fe1\u606f\uff0c\u8bf7\u70b9\u51fb\u4fe1\u606f\u56fe\u6807 \u201ci\u201d \u67e5\u9605\u3002", "e97253e7de76d766729f6c4bb4150206": "\u9009\u62e9\u5730\u56fe\u4e0b\u65b9\u53f3\u4e0a\u89d2\u7684\u201c\u62a5\u544a\u201d\uff0c\u5373\u53ef\u751f\u6210\u8be5\u7f51\u9875\u7684\u53ef\u6253\u5370 PDF \u6587\u4ef6\u3002\u60a8\u4e5f\u53ef\u70b9\u51fb\u201c\u4e0b\u8f7d\u201d\uff0c\u4ee5 CSV \u6587\u4ef6\u683c\u5f0f\u4e0b\u8f7d\u9875\u9762\u4e0a\u7684\u6240\u6709\u6570\u636e\u3002", "b6d2f97c7de7a8c22215e2e1d293c060": "\u82e5\u8981\u67e5\u770b\u201c2000 \u5e74\u540e\u7684\u68ee\u6797\u53d8\u5316\u201d\u5206\u6790\uff0c\u8bf7\u5148\u5728\u9876\u90e8\u83dc\u5355\u70b9\u51fb\u201c\u5730\u70b9\u201d\u9009\u9879\u5361\uff0c\u7136\u540e\u5411\u4e0b\u6eda\u52a8\u5230\u201c\u6211\u7684\u5730\u70b9\u201d\uff0c\u9009\u62e9\u4e00\u4e2a\u5df2\u5f7b\u5e95\u5904\u7406\u5b8c\u6bd5\u5e76\u5e94\u7528\u4e86\u8be5\u5206\u6790\u7684\u5217\u8868\u3002\u4e4b\u540e\u7cfb\u7edf\u5c06\u52a0\u8f7d\u4e00\u5f20\u5305\u542b\u8be5\u5217\u8868\u6240\u6709\u5730\u70b9\u7684\u8868\u683c\u3002", "82d87946ea9350788cc10044f0cbdd99": "\u60a8\u53ef\u4ee5\u4f7f\u7528\u8868\u683c\u4e0a\u65b9\u7684\u4e0b\u62c9\u83dc\u5355\uff0c\u7528<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u201c\u79d1\u5b66\u76ee\u6807\u7f51\u7edc\u201d</a> (SBTN) \u6570\u636e\u5c42\u6216<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u201c\u6b27\u76df\u8054\u5408\u7814\u7a76\u4e2d\u5fc3\u201d</a> (JRC) \u6570\u636e\u5c42\u67e5\u770b 2020 \u5e74\u540e\u7684\u98ce\u9669\u8bc4\u4f30\u7ed3\u679c\u3002", "3075de69025725dda40cdffe5055ef96": "\u82e5\u8981\u5bf9\u8868\u683c\u8fdb\u884c\u7b5b\u9009\uff0c\u8bf7\u70b9\u51fb\u7b5b\u9009\u5668\u56fe\u6807\uff0c\u7136\u540e\u9009\u62e9\u9996\u9009\u7b5b\u9009\u6761\u4ef6\uff0c\u5b8c\u6210\u540e\u70b9\u51fb\u201c\u5e94\u7528\u201d\u3002\u82e5\u8981\u6e05\u9664\u7b5b\u9009\u6761\u4ef6\uff0c\u8bf7\u70b9\u51fb\u201c\u6e05\u9664\u201d\u3002\u5df2\u5206\u6790\u5217\u8868\u548c\u8349\u7a3f\u5217\u8868\u5177\u6709\u76f8\u540c\u7684\u7b5b\u9009\u884c\u4e3a\u3002", "c092d789e8cc94e40f16983cc7881124": "\u5217\u8868\u53ef\u6392\u5e8f\u5217\u7684\u5217\u540d\u65c1\u6807\u6709\u5411\u4e0a/\u5411\u4e0b\u7684\u5c0f\u7bad\u5934\u3002\u82e5\u8981\u5728\u5217\u8868\u89c6\u56fe\u4e0b\u5bf9\u5404\u5217\u6392\u5e8f\uff0c\u8bf7\u70b9\u51fb\u5217\u6807\u9898\u3002\u518d\u6b21\u70b9\u51fb\u5217\u6807\u9898\uff0c\u5373\u53ef\u5728\u6309\u6570\u5b57\u5347\u5e8f\u6392\u5e8f\u3001\u6309 A-Z \u5b57\u6bcd\u6392\u5e8f\u548c\u6309\u65e5\u671f\u5347\u5e8f\u6392\u5e8f\u7b49\u6392\u5e8f\u65b9\u5f0f\u95f4\u8fdb\u884c\u5207\u6362\u3002\u5df2\u5206\u6790\u5217\u8868\u548c\u8349\u7a3f\u5217\u8868\u5177\u6709\u76f8\u540c\u7684\u6392\u5e8f\u884c\u4e3a\u3002", "664d4b684e252c5f6ce52214fe5fa8e2": "\u8bbf\u95ee\u201c2020 \u5e74\u540e\u7684\u98ce\u9669\u8bc4\u4f30\u201d\u8bca\u65ad\u89c6\u56fe", "876fe2ea74a498d2e0adf0511e573236": "\u82e5\u5217\u8868\u66f4\u65b0\u5931\u8d25\uff0c\u8bf7\u5728\u5730\u70b9\u7f51\u9875\u70b9\u51fb\u201c\u66f4\u65b0\u5206\u6790\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u786e\u5b9a\u201d\u3002\u4e4b\u540e\u5217\u8868\u5c06\u5f97\u5230\u91cd\u65b0\u5904\u7406\u3002", "46526f6f704b57c2f4c40833ff8c955f": "\u5728\u201c2020 \u5e74\u540e\u7684\u98ce\u9669\u8bc4\u4f30\u201d\u5217\u8868\u89c6\u56fe\u4e2d\u9009\u62e9\u201c\u5217\u8868\u8bca\u65ad\u201d\uff0c\u5373\u53ef\u67e5\u770b\u5217\u8868\u4e2d\u6240\u6709\u5730\u70b9\u7684\u8bca\u65ad\u4fe1\u606f\u3002\u5c06\u9f20\u6807\u60ac\u505c\u5728\u5355\u4e2a\u5730\u70b9\u4e0a\uff0c\u7136\u540e\u70b9\u51fb\u201c\u5730\u70b9\u8bca\u65ad\u201d\uff0c\u5373\u53ef\u67e5\u770b\u5217\u8868\u4e2d\u5355\u4e2a\u5730\u70b9\u7684\u8bca\u65ad\u4fe1\u606f\u3002\u5305\u542b\u5df2\u5206\u6790\u5730\u70b9\u7684\u8349\u7a3f\u5217\u8868\u5c06\u4ec5\u53ef\u4f7f\u7528\u5730\u70b9\u7ea7\u8bca\u65ad\u3002", "70be906bcfb2f2651e495334627b43ab": "\u60a8\u53ef\u4ee5\u5728\u9875\u9762\u9876\u90e8\u9009\u62e9\u8981\u5e94\u7528\u5230\u201c2020 \u5e74\u540e\u7684\u98ce\u9669\u8bc4\u4f30\u201d\u8bca\u65ad\u89c6\u56fe\u7684\u6570\u636e\u5c42\uff0c\u6709<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u201c\u79d1\u5b66\u76ee\u6807\u7f51\u7edc\u201d</a> (SBTN) \u6570\u636e\u5c42\u548c<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u201c\u6b27\u76df\u8054\u5408\u7814\u7a76\u4e2d\u5fc3\u201d</a> (JRC) \u6570\u636e\u5c42\u53ef\u9009\u3002", "2a81ca4a8fd5a68f53b1fe0854d01475": "\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u5217\u8868\u5730\u56fe\u201d\uff0c\u5373\u53ef\u4ee5\u5730\u56fe\u89c6\u56fe\u67e5\u770b\u5730\u70b9\u5217\u8868\u3002\u5c06\u9f20\u6807\u60ac\u505c\u5728\u5355\u4e2a\u5730\u70b9\u4e0a\uff0c\u7136\u540e\u9009\u62e9\u201c\u5730\u56fe\u201d\uff0c\u5373\u53ef\u4ee5\u5730\u56fe\u89c6\u56fe\u67e5\u770b\u7279\u5b9a\u5730\u70b9\u3002", "1c6e2e4598cd7a69d79bb0af5d8818fa": "\u8bbf\u95ee\u201c\u68d5\u6988\u98ce\u9669\u8bc4\u4f30\u201d", "61d5fddd7d7a61679e31cb1be1f8e9e3": "Pro \u5141\u8bb8\u60a8\u67e5\u770b\u68d5\u6988\u6cb9\u5382\u6216\u68d5\u6988\u6cb9\u5f00\u91c7\u5730\u7684\u6bc1\u6797\u98ce\u9669\u3002\u8be5\u62a5\u544a\u53ef\u80fd\u4f1a\u88ab\u7eb3\u5165\u201c2000 \u5e74\u540e\u7684\u68ee\u6797\u53d8\u5316\u201d\u5206\u6790\uff0c\u5c06\u53ef\u7528\u4e8e\u4ee5\u68d5\u6988\u5382 ID \u63d0\u4ea4\u7684\u5217\u8868\u6216\u5728\u5546\u54c1\u5b9a\u4e49\u4e3a\u68d5\u6988\u6cb9\u65f6\u53ef\u7528\u3002\u82e5\u8981\u7eb3\u5165\u68d5\u6988\u98ce\u9669\u8bc4\u4f30\uff0c\u5fc5\u987b\u5148\u4e0a\u4f20\u5e76\u63d0\u4ea4\u5404\u5730\u70b9\u6216\u5730\u70b9\u5217\u8868\u3002\u8be5\u62a5\u544a\u5c06\u4e0d\u8ba1\u5165\u60a8\u7684\u4f7f\u7528\u91cf\u9650\u5236\u3002\u60a8\u4e5f\u53ef\u4ee5\u5728\u5730\u70b9\u9875\u9762\u201cGlobal Forest Watch \u5217\u8868\u201d\u4e0b\u7684\u201c\u901a\u7528\u5de5\u5382\u5217\u8868\u201d\u4e2d\u9009\u62e9\u68d5\u6988\u6cb9\u5382\u5b50\u96c6\uff0c\u68d5\u6988\u98ce\u9669\u8bc4\u4f30\u5c06\u81ea\u52a8\u5bf9\u201c\u901a\u7528\u5de5\u5382\u5217\u8868\u201d\u53ef\u7528\u3002", "782cd29dcfac43c87bf56542f08c4679": "\u8be5\u8868\u683c\u5c06\u7acb\u5373\u663e\u793a\u4f4d\u4e8e\u5730\u70b9\u65b9\u5706 50 KM \u5185\u7684\u68ee\u6797\u666f\u89c2\u3001\u4fdd\u62a4\u533a\u3001\u6ce5\u70ad\u5730\u6240\u53d7\u5a01\u80c1\u7684\u98ce\u9669\u7b49\u7ea7\u4fe1\u606f\u548c\u68ee\u6797\u666f\u89c2\u4ef7\u503c\u3002\u7b2c\u4e00\u5217\u201c\u5de5\u5382\u4f18\u5148\u7ea7\u201d\u5c06\u57fa\u4e8e\u603b\u4f53\u5a01\u80c1\u548c\u4ef7\u503c\u663e\u793a\u7efc\u5408\u98ce\u9669\u6307\u6807\u3002\u5de5\u5382\u603b\u4f53\u4f18\u5148\u7ea7\u662f\u7528\u201c\u68d5\u6988\u98ce\u9669\u5de5\u5177\u201d\u5bf9\u68d5\u6988\u6cb9\u5382\u8fdb\u884c\u8bc4\u4f30\u7684\u7ed3\u679c\uff0c\u60a8\u53ef\u4ee5\u5728<a href=\"{{0}}\">\u6b64\u5904</a>\u4e86\u89e3\u8be5\u5de5\u5177\u7684\u8be6\u60c5\u3002", "503c196f7e7e6afe9ae6344ff948ffe7": "\u98ce\u9669\u7b49\u7ea7\u5206\u4e3a\u4f4e\u3001\u4e2d\u3001\u9ad8\u4e09\u7ea7\u3002\u60a8\u53ef\u4ee5\u70b9\u51fb\u5206\u6790\u65c1\u7684\u4fe1\u606f\u56fe\u6807 \u201ci\u201d \u9605\u8bfb\u5a01\u80c1\u548c\u4ef7\u503c\u8be6\u60c5\u3002\u82e5\u5217\u8868\u5904\u4e8e\u8349\u7a3f\u72b6\u6001\uff0c\u5219\u5728\u5c06\u6574\u4e2a\u5217\u8868\u63d0\u4ea4\u5206\u6790\u4e4b\u524d\uff0c\u5217\u8868\u5185\u7684\u672a\u5206\u6790\u5730\u70b9\u5c06\u4e0d\u4f1a\u5305\u542b\u6240\u6709\u4fe1\u606f\u3002", "07dcbd6f152c36e483f3a5360ec20b99": "\u9009\u62e9\u201c\u68d5\u6988\u98ce\u9669\u8bc4\u4f30\u201d\u9009\u9879\u5361\u8bbf\u95ee\u5217\u8868\u89c6\u56fe\u3002", "5a9f53408ec9eec4334824321a219299": "\u82e5\u8981\u67e5\u770b\u6a21\u677f\u4e2d\u7684\u5176\u4ed6\u6570\u636e\u5217\uff0c\u8bf7\u70b9\u51fb \u201c\u2026\u201d \u83dc\u5355\uff0c\u7136\u540e\u5728\u5176\u4ed6\u8981\u67e5\u770b\u7684\u5b57\u6bb5\u65c1\u70b9\u51fb\u590d\u9009\u6846\u3002\u65b0\u52a0\u5217\u5c06\u663e\u793a\u5728\u8868\u683c\u6700\u53f3\u4fa7\u3002\u82e5\u8981\u9690\u85cf\u5217\uff0c\u8bf7\u70b9\u51fb \u201c\u2026\u201d \u83dc\u5355\u5e76\u53d6\u6d88\u9009\u4e2d\u8981\u9690\u85cf\u7684\u5b57\u6bb5\u3002\u60a8\u4e5f\u53ef\u4ee5\u70b9\u51fb\u201c\u5168\u9009\u201d\u6216\u201c\u53d6\u6d88\u5168\u9009\u201d\u6765\u4e00\u6b21\u6027\u9009\u4e2d\u6216\u53d6\u6d88\u9009\u4e2d\u6240\u6709\u5b57\u6bb5\u3002\u82e5\u5217\u8868\u5904\u4e8e\u8349\u7a3f\u72b6\u6001\uff0c\u5219\u5728\u5c06\u6574\u4e2a\u5217\u8868\u63d0\u4ea4\u5206\u6790\u4e4b\u524d\uff0c\u5217\u8868\u5185\u7684\u672a\u5206\u6790\u5730\u70b9\u5c06\u4e0d\u4f1a\u5305\u542b\u6240\u6709\u4fe1\u606f\u3002", "954ce89c741dd27dc10e8e8f53715ae3": "\u82e5\u8981\u5bf9\u8868\u683c\u8fdb\u884c\u7b5b\u9009\uff0c\u8bf7\u70b9\u51fb\u7b5b\u9009\u5668\u56fe\u6807\uff0c\u7136\u540e\u9009\u62e9\u9996\u9009\u7b5b\u9009\u6761\u4ef6\uff0c\u5b8c\u6210\u540e\u70b9\u51fb\u201c\u5e94\u7528\u201d\u3002\u82e5\u8981\u67e5\u770b\u5df2\u5e94\u7528\u7684\u7b5b\u9009\u6761\u4ef6\uff0c\u8bf7\u70b9\u51fb\u7b5b\u9009\u5668\u56fe\u6807\u3002\u5df2\u5206\u6790\u5217\u8868\u548c\u8349\u7a3f\u5217\u8868\u5177\u6709\u76f8\u540c\u7684\u7b5b\u9009\u884c\u4e3a\u3002", "ce4ca20adf7fbc3ec5804182d03758eb": "\u5728\u201c\u68d5\u6988\u98ce\u9669\u8bc4\u4f30\u201d\u5217\u8868\u89c6\u56fe\u4e2d\u70b9\u51fb\u8868\u683c\u5de6\u4e0a\u89d2\u7684\u201c\u5217\u8868\u8bca\u65ad\u201d\u6309\u94ae\uff0c\u5373\u53ef\u8bbf\u95ee\u5217\u8868\u4e2d\u6240\u6709\u5730\u70b9\u7684\u8bca\u65ad\u4fe1\u606f\u3002\u5c06\u9f20\u6807\u60ac\u505c\u5728\u5355\u4e2a\u5730\u70b9\u4e0a\uff0c\u7136\u540e\u70b9\u51fb\u201c\u5730\u70b9\u8bca\u65ad\u201d\uff0c\u5373\u53ef\u67e5\u770b\u5217\u8868\u4e2d\u5355\u4e2a\u5730\u70b9\u7684\u8bca\u65ad\u4fe1\u606f\u3002\u5305\u542b\u5df2\u5206\u6790\u5730\u70b9\u7684\u8349\u7a3f\u5217\u8868\u5c06\u4ec5\u53ef\u4f7f\u7528\u5730\u70b9\u7ea7\u8bca\u65ad\u3002", "6e6be34ae56a5fdf5dc69fd6f2185a0b": "\u60a8\u5c06\u5728\u9875\u9762\u9876\u90e8\u770b\u5230\u5730\u70b9\u7684\u76f8\u5173\u5386\u53f2\u7279\u5f81\u4ee5\u53ca\u5730\u70b9\u5730\u56fe\u3002\u70b9\u51fb\u5730\u56fe\u5373\u53ef\u4ee5\u5730\u56fe\u89c6\u56fe\u67e5\u770b\u5730\u70b9\u3002", "e19c494ada92f94a98d9094353989c4b": "\u9875\u9762\u7684\u5176\u4f59\u90e8\u5206\u5c06\u663e\u793a\u5bf9\u5730\u70b9\u7684\u68d5\u6988\u98ce\u9669\u5206\u6790\u4ee5\u53ca\u76f8\u5173\u56fe\u8868\u3002\u6240\u63d0\u4f9b\u7684\u4fe1\u606f\u5c06\u4f9d\u636e\u60a8\u662f\u5728\u67e5\u770b\u6240\u6709\u5730\u70b9\u8fd8\u662f\u5355\u4e2a\u5730\u70b9\u7684\u8bca\u65ad\u4fe1\u606f\u800c\u6709\u6240\u4e0d\u540c\u3002", "5ffb3584a59e50569de85ac3a44a8712": "Pro \u53ef\u5bf9\u4efb\u4f55\u5df2\u5904\u7406\u5217\u8868\u5e94\u7528\u201c2020 \u5e74\u540e\u7684\u98ce\u9669\u8bc4\u4f30\u201d\u5206\u6790\u3002", "377ccb827d460ffec6ac4a535986635d": "\u70b9\u51fb\u5217\u8868\u540d\u79f0\u53f3\u4fa7\u7684\u201c\u5df2\u5171\u4eab\u201d\u56fe\u6807\uff0c\u5373\u53ef\u67e5\u770b\u4e0e\u60a8\u5171\u4eab\u7684\u5217\u8868\u3002", "dea4af925d7a8b502cbd6f41791ccbad": "\u5982\u5bf9\u4f7f\u7528\u3001\u5b9a\u4ef7\u3001\u8bb8\u53ef\u6216\u57fa\u4e8e API \u7684\u8bbf\u95ee\u6709\u4efb\u4f55\u7591\u95ee\uff0c\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">gfwprosales@wri.org</a> \u54a8\u8be2\u3002", "5190920872adbf482c5d97f2ef4ebc29": "<strong>\u201c2020 \u5e74\u540e\u7684\u98ce\u9669\u8bc4\u4f30\u201d</strong>\u5206\u6790\u53ef\u8ba9\u60a8\u4e86\u89e3\u54ea\u4e9b\u5730\u70b9\u7684\u98ce\u9669\u53ef\u5ffd\u7565\u4e0d\u8ba1\uff0c\u5e76\u80fd\u5e2e\u52a9\u60a8\u6ee1\u8db3\u6bc1\u6797\u76d1\u7ba1\u8981\u6c42\u3002", "12a41116ece6a076c3bec7a1e4d49586": "<strong>\u201c\u8fd1\u671f\u6bc1\u6797\u8b66\u62a5\u201d</strong>\u5206\u6790\u80fd\u8ba9\u60a8\u4f18\u5148\u5904\u7406\u7279\u5b9a\u533a\u57df\u3001\u8fc5\u901f\u8bc6\u522b\u95ee\u9898\u533a\u57df\u4ee5\u53ca\u76f4\u89c2\u5730\u663e\u793a\u4e0e\u6570\u636e\u76f8\u5bf9\u5e94\u7684\u8b66\u62a5\u3002\u60a8\u53ef\u4ee5\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u4e86\u89e3\u8fd1\u671f\u6bc1\u6797\u8b66\u62a5\u7684\u8be6\u60c5\u3002", "b84154273f6bd1c18653217c7556b7a8": "Pro \u5141\u8bb8\u60a8\u5bf9\u5546\u54c1\u548c\u6295\u8d44\u5217\u8868\u4e2d\u7684\u6240\u6709\u5730\u70b9\u5e94\u7528\u4e09\u79cd\u53ef\u7528\u5206\u6790\u4e2d\u7684\u4efb\u4f55\u4e00\u79cd\u3002\u5728\u67e5\u770b\u5404\u9879\u5206\u6790\u7684\u76f8\u5173\u6570\u636e\u4e4b\u524d\uff0c\u60a8\u9700\u8981\u5148\u5c06\u5730\u70b9\u4e0a\u4f20\u5230 Pro\u2014\u2014\u8bf7\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u4e0a\u4f20\u5730\u70b9\uff0c\u5728<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u9009\u5bf9\u6a21\u677f\uff0c\u5728<a href=\"{{2}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u5904</a>\u4e86\u89e3\u5982\u4f55\u586b\u5199\u6240\u9009\u6a21\u677f\u3002", "803ed2ef7a126f366fa71bf100694bdc": "\u8bbf\u95ee\u201c2000 \u5e74\u540e\u7684\u68ee\u6797\u53d8\u5316\u201d\u5217\u8868\u89c6\u56fe", "ca4d70e48f4aecd8a0956edc5f111abd": "\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u53ef\u70b9\u51fb\u9009\u9879\u5361\u5373\u53ef\u9009\u62e9\u201c2000 \u5e74\u540e\u7684\u68ee\u6797\u53d8\u5316\u201d\u5206\u6790\u3002", "f4d6c5836cc800fabe506605b9f5f5a3": "\u82e5\u8981\u67e5\u770b\u6a21\u677f\u4e2d\u7684\u5176\u4ed6\u6570\u636e\u5217\uff0c\u8bf7\u70b9\u51fb \u201c\u2026\u201d \u83dc\u5355\uff0c\u7136\u540e\u5728\u5176\u4ed6\u8981\u67e5\u770b\u7684\u5b57\u6bb5\u65c1\u70b9\u51fb\u590d\u9009\u6846\u3002\u65b0\u52a0\u5217\u5c06\u663e\u793a\u5728\u8868\u683c\u6700\u53f3\u4fa7\u3002\u82e5\u8981\u9690\u85cf\u5217\uff0c\u8bf7\u70b9\u51fb \u201c\u2026\u201d \u83dc\u5355\u5e76\u53d6\u6d88\u9009\u4e2d\u8981\u9690\u85cf\u7684\u5b57\u6bb5\u3002\u60a8\u4e5f\u53ef\u4ee5\u70b9\u51fb\u201c\u5168\u9009\u201d\u6216\u201c\u53d6\u6d88\u5168\u9009\u201d\u6765\u4e00\u6b21\u6027\u9009\u4e2d\u6216\u53d6\u6d88\u9009\u4e2d\u6240\u6709\u5b57\u6bb5\u3002\u82e5\u5217\u8868\u5904\u4e8e\u8349\u7a3f\u72b6\u6001\uff0c\u5219\u5728\u5c06\u6574\u4e2a\u5217\u8868\u63d0\u4ea4\u5206\u6790\u4e4b\u524d\uff0c\u5217\u8868\u5185\u7684\u672a\u5206\u6790\u5730\u70b9\u5c06\u4e0d\u4f1a\u5305\u542b\u6240\u6709\u4fe1\u606f\u3002", "535d3873ed9a982e489babdba91b7947": "\u70b9\u51fb\u7b5b\u9009\u5668\u56fe\u6807\uff0c\u7136\u540e\u9009\u62e9\u8981\u5bf9\u8868\u683c\u5e94\u7528\u7684\u7b5b\u9009\u6761\u4ef6\u3002", "b01a7991d3cdfa750939336ae22d6aa8": "\u70b9\u51fb\u201c\u66f4\u65b0\u5206\u6790\u201d\u5e76\u786e\u8ba4\u8981\u66f4\u65b0\u5217\u8868\u3002", "898816ddd9a9a0f329784345135bf7ae": "\u5c06\u52a0\u8f7d\u8bca\u65ad\u9875\u9762\u3002", "af5b5c89d76aefc8d1e24fee69194c33": "\u5bf9\u4e8e\u4f4d\u4e8e\u4e1c\u5357\u4e9a\u3001\u5357\u7f8e\u3001\u963f\u6839\u5ef7\u548c\u54e5\u4f26\u6bd4\u4e9a\u7684\u5730\u70b9\uff0c\u5c06\u663e\u793a\u533a\u57df\u6570\u636e\u9762\u677f\uff0c\u5176\u4e2d\u5c06\u5305\u542b\u8fd9\u4e9b\u5730\u533a\u7279\u6709\u7684\u6570\u636e\u5c42\u3002", "04969ab19a9e2d310c570f279f35709f": "\u6709\u5173\u8be5\u9875\u9762\u4efb\u4f55\u7ec4\u4ef6\u7684\u8be6\u7ec6\u4fe1\u606f\uff0c\u8bf7\u70b9\u51fb\u4fe1\u606f\u56fe\u6807 \u201ci\u201d \u67e5\u9605\u3002", "c008157764a2c9bfab4ed5d98408c561": "Shapefile \u5c06\u5bfc\u51fa\u539f\u59cb\u8f93\u5165\u6587\u4ef6\u7684 Shapefile \u7248\u672c\uff0c\u800c\u8be5\u7248\u672c\u53ef\u91cd\u65b0\u4e0a\u4f20\u81f3 Pro\u3002", "4fc1929b880c0e2db87adc7b7c24bdcf": "\u5982\u5bf9\u4f7f\u7528\u3001\u5b9a\u4ef7\u3001\u8bb8\u53ef\u6216\u57fa\u4e8e API \u7684\u8bbf\u95ee\u6709\u4efb\u4f55\u7591\u95ee\uff0c\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">gfwprosales@wri.org</a> \u54a8\u8be2\u3002", "2d04831bb4d30844d8c1f2651629ffc8": "\u5982\u679c\u60a8\u5728\u4f7f\u7528 GFW Pro \u65f6\u9700\u8981\u5176\u4ed6\u652f\u6301\uff0c\u8bf7\u586b\u5199<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u8868\u5355\u3002</a>", "a2a8ea6445eb3311fe1f3e5a106b7f8c": "<strong>\u201c2000 \u5e74\u540e\u7684\u68ee\u6797\u53d8\u5316\u201d\u5206\u6790</strong>\u5c06\u663e\u793a\u60a8\u6709\u54ea\u4e9b\u5730\u70b9\u53d1\u751f\u4e86\u6811\u6728\u8986\u76d6\u635f\u5931\uff0c\u5e76\u5c06\u91cd\u70b9\u7a81\u51fa\u53cd\u6bc1\u6797\u653f\u7b56\u6700\u5e38\u63d0\u53ca\u7684\u4e00\u4e9b\u654f\u611f\u6797\u533a\u7684\u635f\u5931\u60c5\u51b5\u3002", "12a0bd29a4e6d90682feea080f3f7531": "\u5411\u4e0b\u6eda\u52a8\u5230\u201c\u6211\u7684\u5217\u8868\u201d\uff0c\u4f7f\u7528\u641c\u7d22\u680f\u67e5\u627e\u5217\u8868\u6216\u76f4\u63a5\u627e\u5230\u5217\u8868\u3002", "a67e4e438b32b47bea4ece4bb5e3617d": "\u9009\u5b9a\u5217\u8868\u540e\uff0c\u5728\u9875\u9762\u53f3\u4e0a\u89d2\u70b9\u51fb\u201c\u5171\u4eab\u201d\u3002", "e517f45866f5f9ac718264b228f7d7f5": "\u5728\u4e0b\u62c9\u83dc\u5355\u5185\u9009\u62e9\u8981\u5728\u7ec4\u7ec7\u5185\u5171\u4eab\u5217\u8868\u7684\u5bf9\u8c61\u3002\u9009\u62e9\u5b8c\u6bd5\u540e\uff0c\u70b9\u51fb\u201c\u6dfb\u52a0\u7528\u6237\u201d\u3002", "1345a8f505a061ba1d0fa4dd7599d3ba": "\u9009\u62e9\u8981\u5728\u7ec4\u7ec7\u5185\u5171\u4eab\u5217\u8868\u7684\u5bf9\u8c61\u3002", "e38033ea6b1ea46ccdbfe8707a023ac0": "\u82e5\u8981\u505c\u6b62\u4e0e\u67d0\u7528\u6237\u5171\u4eab\u5217\u8868\uff0c\u8bf7\u70b9\u51fb\u201c\u5171\u4eab\u201d\uff0c\u518d\u70b9\u51fb\u8be5\u7528\u6237\u59d3\u540d\u65c1\u7684 \u201cX\u201d \u7b26\u53f7\uff0c\u7136\u540e\u70b9\u51fb\u201c\u786e\u5b9a\u201d\u8fdb\u884c\u786e\u8ba4\u3002", "bd1755105efcbe839528056341d62eda": "\u5728\u5730\u70b9\u9875\u9762\u67e5\u770b\u4e0e\u60a8\u5171\u4eab\u7684\u5217\u8868\u3002\u6b64\u7c7b\u5217\u8868\u7684\u540d\u79f0\u53f3\u4fa7\u4f1a\u663e\u793a\u5df2\u5171\u4eab\u56fe\u6807\u3002", "dbdae544fb43dd70b4883aa2a05be67a": "\u6ce8\uff1a\u8be5\u529f\u80fd\u7528\u4e8e\u4ee5 CSV \u6216 Shapefile \u683c\u5f0f\u4e0b\u8f7d\u5730\u70b9\u6570\u636e\uff0c\u5176\u4e2d\u5e76\u4e0d\u5305\u542b\u4efb\u4f55\u5206\u6790\u6570\u636e\u3002\u5217\u8868\u548c\u5730\u70b9\u7684\u5206\u6790\u6570\u636e\u53ca\u6307\u6807\u53ef\u5728\u5217\u8868\u6216\u5730\u70b9\u8bca\u65ad\u9875\u9762\u4e0b\u8f7d\u3002", "9737a398cf2269d8e457faf175c5f32d": "\u70b9\u51fb\u8868\u683c\u4e0a\u65b9\u7684\u201c\u4e0b\u8f7d\u201d\u3002\u7cfb\u7edf\u5c06\u63d0\u4f9b \u201cCSV\u201d \u548c \u201cShapefile\u201d \u4e24\u79cd\u683c\u5f0f\u4f9b\u60a8\u9009\u62e9\uff0c\u5e76\u5c06\u5728\u60a8\u9009\u5b9a\u9996\u9009\u683c\u5f0f\u540e\u5f00\u542f\u4e0b\u8f7d\u3002\u5982\u679c\u5f53\u521d\u4e0a\u4f20\u5217\u8868\u7684\u683c\u5f0f\u4e3a Shapefile\uff0c\u5219\u5efa\u8bae\u4ee5 Shapefile \u683c\u5f0f\u5bfc\u51fa\u8be5\u5217\u8868\u3002\u82e5\u4ee5 CSV \u683c\u5f0f\u5bfc\u51fa\u4ee5 Shapefile \u683c\u5f0f\u4e0a\u4f20\u7684\u6587\u4ef6\uff0c\u5c31\u53ef\u80fd\u5f97\u5230\u4e0d\u540c\u7684\u5206\u6790\u7ed3\u679c\u3002CSV \u5c06\u5bfc\u51fa\u539f\u59cb\u8f93\u5165\u6587\u4ef6\u7684 CSV \u7248\u672c\uff0c\u800c\u8be5\u7248\u672c\u53ef\u91cd\u65b0\u4e0a\u4f20\u81f3 Pro\u3002", "00374844cea733066521a37a189b6e70": "2020 \u5e74\uff0c30 \u7c73\uff0c\u5168\u7403\uff0c\u57fa\u4e8e\u79d1\u5b66\u7684\u76ee\u6807\u7f51\u7edc (SBTN)\uff0c\u7248\u672c 0.3", "5187c11591976b1db29fc8dda4bfbb25": "\u786e\u5b9a 2020 \u5e74\u7684\u5929\u7136\u6797\u533a\u57df", "684311d518bddbc8669e6204b4fbb03c": "\u8be5\u6570\u636e\u96c6\u6839\u636e\u7684\u662f\u57fa\u4e8e\u79d1\u5b66\u7684\u76ee\u6807\u7f51\u7edc (SBTN) \u81ea\u7136\u571f\u5730\u5730\u56fe\u4e2d\u5212\u5b9a\u7684\u76f8\u5173\u68ee\u6797\u548c\u690d\u88ab\u7c7b\u522b\uff0c\u4e0a\u8ff0\u5730\u56fe\u672c\u8eab\u662f\u901a\u8fc7\u6574\u5408\u591a\u4e2a\u6570\u636e\u96c6\u5f00\u53d1\u7684\uff0c\u8fd9\u4e9b\u6570\u636e\u96c6\u786e\u5b9a\u4e86\u81ea\u7136\u571f\u5730\u548c\u975e\u81ea\u7136\u571f\u5730\u7684\u8303\u56f4\u3002\u6211\u4eec\u9f13\u52b1\u7528\u6237\u4f7f\u7528\u5176\u4ed6\u6570\u636e\uff08\u5305\u62ec\u9ad8\u5206\u8fa8\u7387\u56fe\u50cf\uff09\u6765\u4ea4\u53c9\u6838\u5bf9\u4ed6\u4eec\u7684\u5206\u6790\u7ed3\u679c\uff0c\u5e76\u901a\u8fc7\u5b9e\u5730\u8003\u5bdf\u6765\u8ddf\u8fdb\u3002\u5982\u8981\u8be6\u7ec6\u4e86\u89e3\u8fd9\u4e9b\u6570\u636e\u7684\u5c40\u9650\u6027\uff0c\u8bf7\u53c2\u9605<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6280\u672f\u6587\u6863</a>", "ff221856835cb9c2c2cdf0d5065677ce": "\u8be5\u6570\u636e\u96c6\u663e\u793a\u4e86 2020 \u5e74\u5929\u7136\u6797\u548c\u975e\u5929\u7136\u690d\u88ab\u7684\u8303\u56f4\uff0c\u5404\u53d6\u81ea\u57fa\u4e8e\u79d1\u5b66\u7684\u76ee\u6807\u7f51\u7edc (STBN) \u81ea\u7136\u571f\u5730\u5730\u56fe\u4e2d\u5212\u5b9a\u7684\u76f8\u5173\u7c7b\u522b\u3002\u8fd9\u4e9b\u6570\u636e\u6765\u81ea\u591a\u4e2a\u6765\u6e90\uff0c\u6309\u7167\u5168\u7403\u4e00\u81f4\u7684\u5206\u7c7b\u65b9\u6848\uff0c\u6765\u5f00\u53d1\u5168\u7403\u81ea\u7136\u548c\u975e\u81ea\u7136\u571f\u5730\u8986\u76d6\u5730\u56fe\u3002<br>\u5728\u5f00\u53d1\u8be5\u5730\u56fe\u65f6\uff0c\u6211\u4eec\u53c2\u8003\u4e86\u95ee\u8d23\u5236\u6846\u67b6\u5021\u8bae (AFi) \u548c\u7cae\u98df\u53ca\u519c\u4e1a\u7ec4\u7ec7 (FAO) \u53d1\u5e03\u7684\u81ea\u7136\u751f\u6001\u7cfb\u7edf\u548c\u68ee\u6797\u7684\u5b9a\u4e49\u3002AFi \u548c FAO \u5c06\u68ee\u6797\u5b9a\u4e49\u4e3a\u9762\u79ef\u5728 0.5 \u516c\u9877\u4ee5\u4e0a\uff0c\u4e3b\u8981\u6811\u6728\u9ad8\u4e8e 5 \u7c73\u3001\u6797\u51a0\u8986\u76d6\u7387\u8d85\u8fc7 10%\uff0c\u6216\u6811\u6728\u5728\u539f\u751f\u5883\u80fd\u591f\u8fbe\u5230\u8fd9\u4e9b\u9608\u503c\u7684\u571f\u5730\u3002AFi \u5c06\u5929\u7136\u6797\u5b9a\u4e49\u4e3a\u5728\u7269\u79cd\u7ec4\u6210\u3001\u7ed3\u6784\u548c\u751f\u6001\u529f\u80fd\u65b9\u9762\u4e0e\u5728\u6ca1\u6709\u91cd\u5927\u4eba\u7c7b\u5f71\u54cd\u7684\u7279\u5b9a\u533a\u57df\u5185\u53d1\u73b0\u7684\u68ee\u6797\u7c7b\u4f3c\u7684\u68ee\u6797\u3002\u7531\u4e8e\u7269\u79cd\u7ec4\u6210\u548c\u751f\u6001\u529f\u80fd\u65e0\u6cd5\u76f4\u63a5\u7528\u5730\u7403\u89c2\u6d4b\u6570\u636e\u7ed8\u5236\uff0c\u56e0\u6b64\u6211\u4eec\u4f7f\u7528\u4ee3\u7406\u6570\u636e\u5bf9 AFi \u548c FAO \u7684\u5b9a\u4e49\u8fdb\u884c\u4e86\u53ef\u64cd\u4f5c\u5316\u5904\u7406\uff0c\u4ee5\u6392\u9664\u4e0d\u7b26\u5408\u5929\u7136\u6797\u5b9a\u4e49\u7684\u690d\u88ab\u3002AFi \u6307\u5357\u8fd8\u6307\u51fa\uff0c\u56fd\u5bb6\u548c\u6b21\u56fd\u5bb6\u68ee\u6797\u5b9a\u4e49\u6240\u8bbe\u5b9a\u7684\u9608\u503c\u53ef\u80fd\u9700\u8981\u4f18\u5148\u5f97\u5230\u8003\u8651\uff0c\u56e0\u6b64\u5728\u7279\u5b9a\u533a\u57df\uff0c\u533a\u57df\u571f\u5730\u8986\u76d6\u5730\u56fe\u7684\u4f18\u5148\u6743\u8981\u9ad8\u4e8e\u5168\u7403\u6570\u636e\u3002<br>\u975e\u5929\u7136\u6811\u6728\u8986\u76d6\u53ef\u80fd\u5305\u62ec\u6728\u672c\u4f5c\u7269\u3001\u4eba\u5de5\u6797\u3001\u9762\u79ef\u5c0f\u4e8e 0.5 \u516c\u9877\u7684\u6811\u4e1b\u6216\u4e3b\u8981\u4e3a\u519c\u4e1a\u6216\u57ce\u5e02\u7528\u5730\u5185\u7684\u6811\u6728\u3002<br>\u7528\u6237\u5e94\u53c2\u9605<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6280\u672f\u6587\u6863</a>\uff0c\u4ee5\u8fdb\u4e00\u6b65\u4e86\u89e3\u7528\u4e8e\u5f00\u53d1\u5730\u56fe\u7684\u8f93\u5165\u6570\u636e\u53ca\u5176\u5c40\u9650\u6027\u3002<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">SBTN \u81ea\u7136\u571f\u5730\u5730\u56fe v1</a> \u7684\u66f4\u65b0\u7248\u672c\u73b0\u5df2\u53d1\u5e03\uff0c\u5e76\u5c06\u5f88\u5feb\u5728 GFW \u4e0a\u66f4\u65b0\u3002", "c7bb49ea3e273710ab9a308ee0d7efc7": "{location} \u7684\u5929\u7136\u6797", "9fdfb4e812f6376bcc436e8b605b27fc": "\u6bcf\u50cf\u7d20 CO<sub>2</sub>e \u5146\u514b\u6570\uff1a\u9002\u7528\u4e8e\u8ba1\u7b97\u611f\u5174\u8da3\u533a\u57df\u7684\u603b\u901a\u91cf\uff0c\u56e0\u4e3a\u53ef\u4ee5\u5c06\u50cf\u7d20\u503c\u76f8\u52a0\u4ee5\u83b7\u5f97\u8be5\u533a\u57df\u7684\u603b\u78b3\u901a\u91cf\u3002&nbsp;", "2f69512fdef551f203664c4e0f1ffcbe": "<strong>MapBuilder\uff1a</strong>WRI \u5f00\u53d1\u7684\u4e00\u6b3e\u5de5\u5177\uff0c\u7528\u4e8e\u7ed3\u5408 GFW \u548c\u5176\u4ed6\u7a7a\u95f4\u6570\u636e\u4ee5\u53ca\u7528\u6237\u81ea\u5df1\u7684\u6570\u636e\u6765\u521b\u5efa\u5b9a\u5236\u7684\u4ea4\u4e92\u5f0f\u5730\u56fe\u3002", "d09d2a6e2d11ad4f048405e917b3204e": "<strong>\u706b\u707e\u5929\u6c14\u6307\u6570\uff1a</strong>\u4e00\u79cd\u7528\u4e8e\u4f30\u8ba1\u706b\u707e\u98ce\u9669\u7684\u6570\u5b57\u8bc4\u7ea7\u3002&nbsp;", "cd4985bbf4c4471f7aad3e981cc7c295": "\u68ee\u6797\u6570\u636e\u5982\u4f55\u5bf9\u60a8\u6700\u6709\u7528\uff1f", "5f21d7611edf5806f43089ab48fb4e31": "\u6211\u4eec\u6b63\u4e0e\u7231\u4e01\u5821\u5927\u5b66\u53ef\u6301\u7eed\u68ee\u6797\u548c\u666f\u89c2\u4e2d\u5fc3\u5408\u4f5c\uff0c\u6536\u96c6\u53cd\u9988\u610f\u89c1\uff0c\u4ee5\u5e2e\u52a9\u6539\u8fdbGFW\u3002\u65e0\u8bba\u60a8\u662f\u5e73\u53f0\u7684\u8001\u7528\u6237\u8fd8\u662f\u65b0\u7528\u6237\uff0c\u60a8\u7684\u89c1\u89e3\u90fd\u5c06\u6709\u52a9\u4e8e\u6211\u4eec\u4f7f\u68ee\u6797\u6570\u636e\u66f4\u6613\u83b7\u53d6\u3001\u66f4\u6709\u7528\u3002\u6b22\u8fce\u53c2\u4e0e\u6211\u4eec\u7684<a href=\"{{0}}\">\u7b80\u77ed\u8c03\u67e5</a>\uff0c\u5206\u4eab\u60a8\u7684\u60f3\u6cd5\uff01", "2bec73cfa405de45294ee71af56eacce": "<strong>\u96c6\u6210\u68ee\u6797\u780d\u4f10\u8b66\u62a5\uff1a</strong>\u6307 GFW \u4e0a\u7684\u8fd9\u4e2a\u8b66\u62a5\u5c42\uff0c\u5b83\u663e\u793a\u70ed\u5e26\u5730\u533a\u68ee\u6797\u6270\u52a8\u7684\u8fd1\u5b9e\u65f6\u4fe1\u606f\u3002&nbsp;&nbsp;", "22bf2514b7099d0b45a16692eb09b61d": "<strong>\u5b8c\u6574\u68ee\u6797\u666f\u89c2\uff1a</strong>\u6307\u901a\u8fc7\u536b\u661f\u56fe\u50cf\u786e\u5b9a\u6ca1\u6709\u4eba\u7c7b\u6d3b\u52a8\u6216\u6816\u606f\u5730\u7834\u788e\u5316\u8ff9\u8c61\uff0c\u5e76\u4e14\u9762\u79ef\u8db3\u4ee5\u7ef4\u6301\u6240\u6709\u672c\u5730\u751f\u7269\u591a\u6837\u6027\u7684\u68ee\u6797\u533a\u57df\u3002&nbsp; &nbsp;", "d67db72f58b0f476aa6d3c1ce41c98ab": "\u6570\u636e\u96c6", "70791538ba6475e6b679fa59e2e4bae9": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a\u5229\u7528 GFW \u6570\u636e\u76d1\u6d4b\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u7684\u6392\u653e\u4e0e\u5438\u6536", "65b2f932a0105e3ffeddf916111ad813": "\u89e3\u91ca\u4e86\u68ee\u6797\u78b3\u901a\u91cf\u6570\u636e", "28371e80afc7fd795cdb8a4097ce8e85": "\u63a2\u7d22\u6709\u5173\u68ee\u6797\u53d8\u5316\u7684\u5173\u952e\u6570\u636e\uff0c\u5305\u62ec\u968f\u65f6\u95f4\u7684\u53d8\u5316\u3001\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u4ee5\u53ca\u706b\u707e\u60c5\u51b5\u3002", "7cf395303ce3665a9834721d4b748e4b": "\u9891\u7387", "b75c310b2f5cf870612e7ff8fe2819e0": "\u66f4\u65b0", "b513a1aa242a1de8b664fdf9c933e562": "30 X 30 \u7c73&nbsp;", "0fee58a9e6b073d60f622019aae45539": "10 \u516c\u91cc \u00d7 10 \u516c\u91cc&nbsp;", "f66f8d5399ad920287d3d532399334cc": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a\u68ee\u6797\u76d1\u6d4b\u9884\u8b66\u7cfb\u7edf\u7684\u53d1\u5c55", "a94d483db18fc18d48b64a8211006681": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a\u5229\u7528 GFW \u4e0a\u7684\u536b\u661f\u56fe\u50cf\u8c03\u67e5\u68ee\u6797\u780d\u4f10\u60c5\u51b5", "6e57d46a7c8ae4260a0201e68011362e": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a\u53ef\u89c6\u5316\u4e0e\u5206\u6790\u7efc\u5408\u68ee\u6797\u780d\u4f10\u8b66\u62a5", "d33fd557be4dd6881a56c10c3ecd8c34": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a\u52a0\u5f3a\u539f\u4f4f\u6c11\u9752\u5e74\u5728\u68ee\u6797\u4fdd\u62a4\u4e2d\u7684\u4f5c\u7528\uff1a\u62c9\u4e01\u7f8e\u6d32\u7684\u89c2\u70b9", "2a41890054b09ff2d98309ce60494484": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a\u8d85\u8d8a\u536b\u661f\u76d1\u6d4b\uff1a\u5bf9\u79d8\u9c81\u4e9a\u9a6c\u900a\u5730\u533a\u539f\u4f4f\u6c11\u793e\u533a\u751f\u6d3b\u7684\u5f71\u54cd", "57dc96b1a123da8f0a210159a0fd8d4a": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a2020 \u5e74\u5168\u7403\u68ee\u6797\u72b6\u51b5\u7efc\u8ff0", "3429a153eba49f6c61e773e377554b8b": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a2021 \u5e74\u5168\u7403\u68ee\u6797\u72b6\u51b5\u7efc\u8ff0", "b2edaa5d59edbabb06dff7217ced7b59": "Global Forest Watch (GFW) \u63d0\u4f9b\u6700\u65b0\u6570\u636e\uff0c\u5e2e\u52a9\u4e16\u754c\u5404\u5730\u7684\u4eba\u4eec\u66f4\u6709\u6548\u5730\u7ba1\u7406\u548c\u4fdd\u62a4\u4e0d\u540c\u7c7b\u578b\u7684\u571f\u5730\u8986\u76d6\u3002\u6211\u4eec\u7684<a href=\"{{0}}\">\u571f\u5730\u8986\u76d6</a>\u6570\u636e\u96c6\u4e3b\u8981\u663e\u793a\u4e0d\u540c\u7684\u68ee\u6797\u7c7b\u578b\uff0c\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\uff1a\u5c55\u793a\u5168\u7403\u53ca\u70ed\u5e26\u5730\u533a\u6811\u6728\u8986\u76d6\u8303\u56f4\u7684\u6811\u6728\u8986\u76d6\u6570\u636e\u96c6\uff1b\u4eba\u5de5\u6797\u548c\u6728\u672c\u7ecf\u6d4e\u4f5c\u7269\u5206\u5e03\uff1b\u4ee5\u53ca\u68ee\u6797\u8d28\u91cf\u8bc4\u4f30\uff0c\u6db5\u76d6\u539f\u59cb\u68ee\u6797\u3001\u5b8c\u6574\u68ee\u6797\u548c\u68ee\u6797\u5b8c\u6574\u6027\u7b49\u3002\u6b64\u5916\uff0c\u5229\u7528\u6765\u81ea <a href=\"{{2}}\">Global Mangrove Watch</a> \u7684\u6570\u636e\u7f16\u5236\u7684 <a href=\"{{1}}\">Mangrove</a> \u6570\u636e\u96c6\u5c55\u793a\u4e86\u7279\u5b9a\u5e74\u4efd\u7684\u7ea2\u6811\u6797\u5206\u5e03\u8303\u56f4\uff0c\u800c<a href=\"{{3}}\">\u5168\u7403\u6ce5\u70ad\u5730</a>\u56fe\u5c42\u5219\u5c55\u793a\u4e86\u6ce5\u70ad\u5730\u548c\u5176\u4ed6\u6709\u673a\u571f\u58e4\u7684\u5206\u5e03\u8303\u56f4\u3002\u8fd9\u4e9b\u6570\u636e\u96c6\u4e3a\u7814\u7a76\u4eba\u5458\u3001\u653f\u7b56\u5236\u5b9a\u8005\u3001\u73af\u4fdd\u4eba\u58eb\u4ee5\u53ca\u5176\u4ed6\u5173\u6ce8\u5168\u7403\u68ee\u6797\u7ba1\u7406\u4e0e\u4fdd\u62a4\u7684\u4eba\u58eb\u63d0\u4f9b\u4e86\u91cd\u8981\u7684\u4fe1\u606f\u652f\u6301\u3002\u6d4f\u89c8\u4e0b\u65b9\u6211\u4eec\u6700\u53d7\u6b22\u8fce\u7684\u6570\u636e\u96c6\uff0c\u5f00\u542f\u63a2\u7d22\u4e4b\u65c5\u3002&nbsp;&nbsp;", "bcc9ac09de9069e56fed2a0276435cbc": "\u5168\u7403\u9646\u5730\uff08\u4e0d\u5305\u62ec\u5357\u6781\u6d32\u548c\u5317\u6781\u5c9b\u5c7f\uff09&nbsp;", "a00be5869d788596157b4f298f63c3f2": "43 \u4ebf\u516c\u9877\u70ed\u5e26\u5730\u533a\uff08\u5357\u7eac 23.44 \u5ea6\u81f3\u5317\u7eac 23.44 \u5ea6\uff09&nbsp;", "df1aaccb3f8bd12bdd17b368d5b87eac": "\u6211\u4eec\u8fd8\u6709\u63cf\u8ff0<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6811\u6728\u8986\u76d6\u635f\u5931</a>\u7684\u6570\u636e\uff0c\u8fd9\u4e9b\u6570\u636e\u53ef\u7528\u4e8e\u63a2\u7a76\u5e74\u5ea6\u8d8b\u52bf\u3001<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6811\u6728\u8986\u76d6\u589e\u52a0</a>\u548c\u51c0\u53d8\u5316\u3002\u8fd9\u4e9b\u6570\u636e\u96c6\u88ab\u7814\u7a76\u4eba\u5458\u3001\u653f\u7b56\u5236\u5b9a\u8005\u3001\u73af\u4fdd\u4eba\u58eb\u4ee5\u53ca\u5404\u79cd\u5173\u6ce8\u68ee\u6797\u53ef\u6301\u7eed\u7ba1\u7406\u548c\u4fdd\u62a4\u7684\u5229\u76ca\u76f8\u5173\u8005\u5e7f\u6cdb\u5e94\u7528\u4e8e\u65e5\u5e38\u5de5\u4f5c\u4e2d\u3002\u67e5\u770b\u4e0b\u65b9\u7684\u68ee\u6797\u53d8\u5316\u6570\u636e\u96c6\uff0c\u5f00\u59cb\u63a2\u7d22\u4e4b\u65c5\u3002&nbsp;", "5a0dbb12de6d8c163befc0b80478e53d": "\u6570\u636e\u96c6\u7c7b\u578b", "d2a3ad3144fe8d0a19c0918af494e052": "\u7efc\u5408\u68ee\u6797\u780d\u4f10\u8b66\u62a5", "6ee6e047ef82eb09be6f190697e97ceb": "\u5e2e\u52a9\u4e2d\u5fc3\u8865\u5145\u8d44\u6599", "1698123c633c7a099ad581213a6ed099": "\u6700\u65b0\u6570\u636e\u8bc1\u5b9e\uff1a\u68ee\u6797\u706b\u707e\u6108\u53d1\u4e25\u91cd", "1745cc69897a6cb8eab95defd5d911e9": "\u7f51\u7edc\u7814\u8ba8\u4f1a&nbsp;", "2f88adce58372ace1c08c200eb996532": "\u4fdd\u80b2\u6570\u636e", "baf1122e3336a0c16a71185fa5679a2a": "\u5927\u578b\u6c34\u575d", "471766a973ec767e3b201ea740a4e817": "\u663e\u793a\u4e86\u653f\u5e9c\u4e3a\u4f01\u4e1a\u5212\u5b9a\u7684\u91c7\u4f10\u6728\u6750\u548c\u5176\u4ed6\u6728\u5236\u54c1\u7684\u68ee\u6797\u533a\u57df\u7684\u8fb9\u754c&nbsp;", "1334323febe000ad348932bd8f4302cf": "\u76ee\u524d\u9002\u7528\u4e8e\u5580\u9ea6\u9686\u3001\u52a0\u62ff\u5927\u3001\u4e2d\u975e\u5171\u548c\u56fd\u3001\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd (DRC)\u3001\u8d64\u9053\u51e0\u5185\u4e9a\u3001\u52a0\u84ec\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u3001\u5229\u6bd4\u91cc\u4e9a\u3001\u82cf\u91cc\u5357\u548c\u521a\u679c\u5171\u548c\u56fd", "1da58e027459010ea689babc98132bd9": "\u663e\u793a\u4e86\u653f\u5e9c\u4e3a\u4f01\u4e1a\u5212\u5b9a\u7684\u5f00\u91c7\u77ff\u7269\u7684\u533a\u57df\u8fb9\u754c&nbsp;", "1ea621c4c2246e6fd2da0ef4c05f3f81": "\u76ee\u524d\u9002\u7528\u4e8e\u5580\u9ea6\u9686\u3001\u67ec\u57d4\u5be8\u3001\u52a0\u62ff\u5927\u3001\u54e5\u4f26\u6bd4\u4e9a\u3001\u521a\u679c\u5171\u548c\u56fd\u3001\u52a0\u84ec\u3001\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd (DRC)\u3001\u79d8\u9c81\u3001\u5df4\u897f\u3001\u82cf\u91cc\u5357\u548c\u58a8\u897f\u54e5&nbsp;", "e0abc46a978a6acbee718ebafbdb71be": "\u6bcf\u5e73\u65b9\u516c\u91cc\u6d4b\u7ed8\u7684\u53ef\u53ef\u79cd\u690d\u56ed&nbsp;", "c04d55e30732ba306af93050a5a30fe6": "\u79d1\u7279\u8fea\u74e6\u548c\u52a0\u7eb3&nbsp;", "175884b77b5833888c85d05f710a2b43": "\u5df4\u897f\u548c\u5df4\u62c9\u572d&nbsp;", "6bf5d23aa02a853c742259fb906bb5ec": "\u5168\u7403\u9646\u5730\u9762\u79ef\uff08\u4e0d\u5305\u62ec\u5357\u6781\u6d32\u548c\u5176\u4ed6\u5317\u6781\u5c9b\u5c7f\uff09&nbsp;", "4ecca2bd6ad57dada62c85df4d819b4f": "\u5168\u7403\u7a7a\u6c14\u8d28\u91cf\u6307\u6570&nbsp;", "fe8290a466681f52e166dd6a1559e9f7": "30 \u7c73", "f804286c60514a9cebfbba2601bf9a11": "1996 \u5e74\u81f3 2020 \u5e74\u95f4\u7279\u5b9a\u5e74\u4efd\u7684\u5168\u7403\u7ea2\u6811\u6797\u8986\u76d6\u60c5\u51b5&nbsp;", "e3498dcff89090e50faa14ec20e44b76": "30 \u00d7 30 \u7c73&nbsp;", "c3c4677b4c0caa9a6be072ed8fbc83d4": "\u4ee5\u9ad8\u7a7a\u95f4\u5206\u8fa8\u7387\u63d0\u4f9b\u957f\u671f\u3001\u5927\u9646\u89c6\u89d2\u4e0b\u7684\u5927\u8c46\u5206\u5e03\u6269\u5f20\u60c5\u51b5&nbsp;", "605fabc593a7629e754802c56e7358a5": "\u4eba\u5de5\u6797&nbsp;", "333a2fdd4ed65d9fc6f7e77bb15642be": "\u89c4\u6a21\u56e0\u56fd\u5bb6/\u5730\u533a\u800c\u5f02&nbsp;", "2ded288167ce8685847923b6e02e97d9": "82 \u4e2a\u56fd\u5bb6/\u5730\u533a&nbsp;", "9eec163aca85c99b858702e40445e5aa": "\u6839\u636e\u65b0\u6570\u636e\u7684\u83b7\u53d6\u60c5\u51b5\u5b9a\u671f\u66f4\u65b0&nbsp;", "2d97431c15d2b904644c27d2a399980e": "\u663e\u793a\u4e86 2021 \u5e74\u79d1\u7279\u8fea\u74e6\u548c\u52a0\u7eb3\u5df2\u6d4b\u7ed8\u53ef\u53ef\u79cd\u690d\u56ed\u7684\u5206\u5e03\u5bc6\u5ea6\u3002&nbsp;", "cc64f8fad3489fd8a2e314e55ab168af": "\u68d5\u6988\u6cb9\u52a0\u5de5\u5382&nbsp;", "1de3fd50f1aa3e756dbb7dcd67b61232": "RSPO \u6cb9\u68d5\u6988\u79cd\u690d\u7279\u8bb8\u533a&nbsp;", "b986e837bcffbccfe356fa4317c4cda9": "60 \u7c73\uff08\u5f00\u653e\u6570\u636e\u95e8\u6237\u4e2d\u8fd8\u63d0\u4f9b\u5206\u8fa8\u7387\u4e3a 3700 \u00d7 3700 \u7c73\u7684\u4f4e\u5206\u8fa8\u7387\u5730\u56fe\uff09&nbsp;", "d9ea4fa388dfa946d7d51f9741cb59fa": "\u63a2\u7d22\u5168\u7403\u68ee\u6797\u7528\u5730\u7684\u4f7f\u7528\u60c5\u51b5\uff0c\u5305\u62ec\u4e0e\u5546\u54c1\u3001\u4fdd\u80b2\u3001\u57fa\u7840\u8bbe\u65bd\u548c\u4eba\u53e3\u76f8\u5173\u7684\u6570\u636e\u96c6\u3002", "aed8babb5cc9cd01218792b6799de6e7": "\u63a2\u7d22\u5404\u7c7b\u571f\u5730\u8986\u76d6\u7684\u4f4d\u7f6e\u548c\u8303\u56f4\uff0c\u5305\u62ec\u4e0d\u540c\u7c7b\u578b\u7684\u6811\u6728\u8986\u76d6\uff0c\u5982\u539f\u59cb\u68ee\u6797\u548c\u70ed\u5e26\u5730\u533a\u6811\u6728\u8986\u76d6\uff0c\u4ee5\u53ca\u4eba\u7c7b\u6d3b\u52a8\u7684\u5f71\u54cd\u8303\u56f4\uff0c\u5982\u5927\u8c46\u79cd\u690d\u533a\u548c\u4eba\u5de5\u6797\u7684\u5206\u5e03\u3002&nbsp;&nbsp;", "ab05368f265e24d390889767e22d4ec9": "\u5f00\u59cb\u4f7f\u7528 GFW \u5de5\u5177\u548c\u6570\u636e\uff1a", "a36e07e1b3d123673cb2420dafd17abe": "\u901a\u8fc7\u5f00\u653e\u6570\u636e\u95e8\u6237\u8bbf\u95ee\u652f\u6301 GFW \u53ef\u89c6\u5316\u7684\u6e90\u6570\u636e\u3002\u4e0b\u8f7d\u9009\u5b9a\u6570\u636e\u7684\u5b50\u96c6\uff0c\u4ee5\u4fbf\u4e0e GFW \u6570\u636e\u6216\u5176\u4ed6\u5e73\u53f0\u7684\u6570\u636e\u4e00\u8d77\u8fdb\u884c\u53ef\u89c6\u5316\u548c\u5206\u6790\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5728\u6b64\u5904\u8bbf\u95ee GFW \u5f00\u653e\u6570\u636e\u95e8\u6237</a>&nbsp;", "25c524298d7fc29a2730a34247e83b16": "\u8fd9\u4e9b\u8b66\u62a5\u7cfb\u7edf\u63d0\u4f9b\u4e86\u8fd1\u4e4e\u5b9e\u65f6\u7684\u901a\u77e5\uff0c\u53ef\u6307\u793a\u6811\u6728\u8986\u76d6\u635f\u5931\u7684\u5177\u4f53\u4f4d\u7f6e\u3002\u8fd9\u4e9b\u8b66\u62a5\u5bf9\u4e8e\u53ca\u65f6\u5f00\u5c55\u68ee\u6797\u7ba1\u7406\u6d3b\u52a8\u548c\u6267\u6cd5\u81f3\u5173\u91cd\u8981\u3002\u5b83\u4eec\u4f1a\u4ee5\u4e0d\u540c\u5206\u8fa8\u7387\u76d1\u6d4b\u4e16\u754c\u5404\u5730\u7684\u68ee\u6797\u53d8\u5316\uff0c\u5e76\u6309\u4e0d\u540c\u9891\u7387\u8fdb\u884c\u66f4\u65b0\u3002\u5728\u4e0b\u65b9\u4e86\u89e3\u6bcf\u4e2a\u8b66\u62a5\u7cfb\u7edf\u7684\u8be6\u7ec6\u4fe1\u606f\u3002&nbsp;&nbsp;", "ff949c03e9ebdc62163939b046a138fe": "\u663e\u793a\u4e86 2001 \u5e74\u81f3 2023 \u5e74\u671f\u95f4\uff0c\u6bcf\u4e2a 10 \u516c\u91cc\u7f51\u683c\u5355\u5143\u5185\u5bfc\u81f4\u6811\u6728\u8986\u76d6\u635f\u5931\u7684\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\uff0c\u4ee5\u53ca\u6811\u6728\u8986\u76d6\u635f\u5931\u7684\u4e25\u91cd\u7a0b\u5ea6&nbsp;", "1c99f462ac6b3317c2b980e9fd10e3ab": "\u663e\u793a\u4e86 2000 \u5e74\u548c 2020 \u5e74\u5168\u7403\u68ee\u6797\u51a0\u5c42\u9ad8\u5ea6", "8b00442adf3562a69b2d727bcee834cd": "\u68ee\u6797\u666f\u89c2\u5b8c\u6574\u6027\u6307\u6570&nbsp;", "704bb61e3c1b8403fcd90c16ad8160bc": "\u786e\u5b9a\u4e86\u622a\u81f3 2020 \u5e74\u5168\u7403\u4ec5\u5b58\u7684\u3001\u5927\u9762\u79ef\u4e14\u8db3\u4ee5\u7ef4\u6301\u6240\u6709\u672c\u571f\u751f\u7269\u591a\u6837\u6027\u7684\u672a\u5206\u5272\u68ee\u6797\u666f\u89c2\uff0c\u8fd9\u4e9b\u666f\u89c2\u672a\u663e\u793a\u51fa\u4efb\u4f55\u4eba\u7c7b\u6d3b\u52a8\u7684\u5f71\u54cd\u3002\u8be5\u56fe\u5c42\u8fd8\u5c55\u793a\u4e86 2000 \u5e74\u81f3 2020 \u5e74\u671f\u95f4\u5b8c\u6574\u68ee\u6797\u666f\u89c2\u8303\u56f4\u7684\u7f29\u51cf\u60c5\u51b5\u3002&nbsp;", "704bfaf5869fd33ba1a199fd04a0fc17": "\u4f10\u6728\u7279\u8bb8\u533a", "6ccfbe9cce45db171d37f15e3e02812f": "\u91c7\u77ff\u7279\u8bb8\u533a", "70490c989b87da6742d3264aa7126981": "\u6cb9\u68d5\u6988\u79cd\u690d\u7279\u8bb8\u533a&nbsp;", "fa3da2aa581833102a5087be084a8f79": "\u663e\u793a\u4e86\u653f\u5e9c\u4e3a\u4f01\u4e1a\u5212\u5b9a\u7684\u79cd\u690d\u6cb9\u68d5\u6988\u7684\u533a\u57df\u8fb9\u754c&nbsp;", "5734d1100bcd122567cf49612b7a36c3": "\u76ee\u524d\u9002\u7528\u4e8e\u5580\u9ea6\u9686\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u3001\u5229\u6bd4\u91cc\u4e9a\u3001\u9a6c\u6765\u897f\u4e9a\uff08\u7802\u62c9\u8d8a\uff09\u548c\u521a\u679c\u5171\u548c\u56fd&nbsp;", "615b254cf4e2e0d1ebaf03018f82d4c9": "\u4e3a\u8d1f\u8d23\u4efb\u5927\u8c46\u751f\u4ea7\u7684\u6269\u5f20\u63d0\u4f9b\u6307\u5bfc\uff0c\u5e76\u6839\u636e <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">RTRS \u6807\u51c6</a>\u5bf9\u539f\u4f4d HCVA \u8fdb\u884c\u8bc4\u4f30&nbsp;", "86408593c34af77fdd90df932f8b5261": "\u529f\u80fd", "b5a4b64b2aa505bd7c11f79b8a9f458d": "\u5206\u8fa8\u7387", "18206c5add24b8898426959c811b779b": "\u66f4\u591a\u4fe1\u606f", "8cf6764cf94183775d0109871420efc9": "\u7efc\u5408\u68ee\u6797\u780d\u4f10\u8b66\u62a5&nbsp;", "e4fb87df39f3282a6bbcbd450bee8df5": "10 X 10 \u7c73&nbsp;", "b7af3eed140c02b7be49ddfd0ea1c964": "\u4e3a\u4e86\u76d1\u6d4b\u6811\u6728\u8986\u76d6\u968f\u65f6\u95f4\u7684\u53d8\u5316\u4ee5\u53ca\u5386\u53f2\u8d8b\u52bf\uff0cGFW \u63d0\u4f9b\u4e86\u635f\u5931\u3001\u589e\u957f\u548c\u51c0\u53d8\u5316\u7684\u6570\u636e\u3002<a href=\"{{0}}\">\u6811\u6728\u8986\u76d6\u635f\u5931</a>\u663e\u793a\u4e86\u56e0\u4efb\u4f55\u539f\u56e0\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u5b8c\u5168\u6d88\u5931\u7684\u5e74\u5ea6\u6570\u636e\uff0c\u6db5\u76d6\u4eba\u4e3a\u56e0\u7d20\u548c\u81ea\u7136\u5e72\u6270\u9020\u6210\u7684\u635f\u5931\uff0c\u4ee5\u53ca\u6c38\u4e45\u6027/\u6682\u65f6\u6027\u635f\u5931\u3002\u6811\u6728\u8986\u76d6\u589e\u52a0\u5219\u663e\u793a\u4e86\u5728 2020 \u5e74\u6811\u6728\u8986\u76d6\u9ad8\u5ea6\u81f3\u5c11\u4e3a 5 \u7c73\uff0c\u4f46\u5728 2000 \u5e74\u5c1a\u65e0\u6b64\u7c7b\u6811\u6728\u8986\u76d6\u7684\u5730\u533a\u3002\u51c0\u53d8\u5316\u663e\u793a\u4e86 2000 \u5e74\u81f3 2020 \u5e74\u4e4b\u95f4\u7684\u635f\u5931\u548c\u589e\u52a0\u60c5\u51b5\u3002\u9664\u4e86\u6811\u6728\u8986\u76d6\u53d8\u5316\u6570\u636e\u5916\uff0cGFW \u8fd8\u63d0\u4f9b\u4e86\u80cc\u666f\u6570\u636e\u96c6\uff0c\u5e2e\u52a9\u7528\u6237\u8bc6\u522b\u68ee\u6797\u53d8\u5316\u7684\u6f5c\u5728\u9a71\u52a8\u56e0\u7d20\u3002&nbsp;", "c93935079cec213077db6dc7a38f59e9": "\u786e\u5b9a 2000 \u5e74\u81f3 2020 \u5e74\u8fd9\u4e00\u65f6\u671f\u5185\u6811\u6728\u8986\u76d6\u589e\u52a0\u7684\u533a\u57df&nbsp;", "3c9390ce689c5cc797bee08a92f65e2c": "\u4ece\u56fd\u5bb6\u5c42\u9762\u786e\u5b9a 2002 \u5e74\u81f3 2023 \u5e74\u8fd9\u4e00\u65f6\u671f\u5185\u539f\u59cb\u68ee\u6797\u635f\u5931\u7684\u663e\u8457\u533a\u57df\u3002&nbsp;", "e49af10677b90a4a742864359200d99a": "\u786e\u5b9a 2000 \u5e74\u81f3 2020 \u5e74\u8fd9\u4e00\u65f6\u671f\u5185\u7684\u6811\u6728\u8986\u76d6\u51c0\u53d8\u5316&nbsp;", "f8319e853574244aa75c73a5ecd43786": "\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u635f\u5931&nbsp;", "f29707435b92f168c2bebfbfd11bd458": "\u5143\u7d20\u636e", "4c74b0d53e7091280d00b5c786ac06a4": "\u4ee5\u4e0b\u6570\u636e\u96c6\u4ece\u5168\u7403\u89c6\u89d2\u63d0\u4f9b\u4e86\u5bf9\u90e8\u5206\u5173\u952e\u68ee\u6797\u7c7b\u578b\u548c\u571f\u5730\u8986\u76d6\u72b6\u51b5\u7684\u6df1\u5165\u5206\u6790\uff0c\u6709\u52a9\u4e8e\u8bc6\u522b\u68ee\u6797\u53d8\u5316\u548c\u9762\u4e34\u68ee\u6797\u780d\u4f10\u98ce\u9669\u7684\u5730\u533a\u3002\u8bf8\u5982\u201c\u6811\u6728\u8986\u76d6\u201d\u3001\u201c\u70ed\u5e26\u6811\u6728\u8986\u76d6\u201d\u548c\u201c\u6811\u6728\u8986\u76d6\u9ad8\u5ea6\u201d\u7b49\u56fe\u5c42\u4e3a\u7528\u6237\u63d0\u4f9b\u4e86\u4e0d\u540c\u65f6\u95f4\u6bb5\u548c\u4e0d\u540c\u5206\u8fa8\u7387\u4e0b\u7684\u6811\u6728\u8986\u76d6\u8303\u56f4\u3002<a href=\"{{0}}\">\u672c\u535a\u5ba2</a>\u8fdb\u4e00\u6b65\u63a2\u8ba8\u4e86\u6811\u6728\u8986\u76d6\u6570\u636e\u96c6\u7684\u5dee\u5f02\u3002\u5176\u4ed6\u56fe\u5c42\uff0c\u5982\u201c\u539f\u59cb\u68ee\u6797\u201d\u3001\u201c\u68ee\u6797\u666f\u89c2\u5b8c\u6574\u6027\u6307\u6570\u201d\u548c\u201c\u5b8c\u6574\u68ee\u6797\u666f\u89c2\u201d\u5219\u63d0\u4f9b\u4e86\u6709\u5173\u8fd9\u4e9b\u68ee\u6797\u8d28\u91cf\u7684\u4fe1\u606f\u3002 &nbsp;", "51cea50e24a83141cd32ae05f0b3cf1b": "\u8bc6\u522b\u6811\u6728\u8986\u76d6\u533a\u57df&nbsp;", "eaccba58fa18425f944f4a643b023863": "\u63cf\u7ed8\u6ce5\u70ad\u5730\u7684\u5206\u5e03\u8303\u56f4&nbsp;", "5af8b06a3965cc5a684cc6423f1d75f2": "\u6bcf\u5929&nbsp;", "ce21470ab49d1d1976bc3dc72438c183": "\u5143\u6570\u636e", "0abd2eece242be2569926abef48313f1": "\u6bcf\u65e5\u66f4\u65b0\uff0c\u91cd\u8bbf\u5468\u671f\u4e3a 8 \u5929\u4e00\u6b21&nbsp;&nbsp;", "312a7baa0c1d8958d28ca8d4afd1b100": "\u4f7f\u7528 Sentinel-2 \u56fe\u50cf\u8fd1\u4e4e\u5b9e\u65f6\u5730\u8bc6\u522b\u539f\u59cb\u68ee\u6797\u635f\u5931\u7684\u533a\u57df\u3002", "87d590a63fbf276da433fe7aecf900a8": "10 x 10 \u7c73&nbsp;", "eec597cebc0099bc3e3f90a4de8edd27": "\u6bcf\u65e5\u66f4\u65b0\uff0c\u56fe\u50cf\u91cd\u8bbf\u5468\u671f\u4e3a 5 \u5929\u4e00\u6b21&nbsp;&nbsp;", "38f33e4e8d5cfb9fbe1141f156dbe912": "\u5229\u7528 Sentinel-1 \u53ef\u7a7f\u900f\u4e91\u5c42\u7684\u96f7\u8fbe\u4f20\u611f\u5668\uff0c\u8fd1\u4e4e\u5b9e\u65f6\u5730\u8bc6\u522b\u539f\u59cb\u6e7f\u6da6\u70ed\u5e26\u68ee\u6797\u4e2d\u7684\u68ee\u6797\u5e72\u6270\u8b66\u62a5\u3002", "629fb965681a71e53dff8bf8bfc2a8ac": "10 x 10 \u7c73\uff0c\u6700\u5c0f\u6d4b\u7ed8\u5355\u4f4d\u4e3a 0.1 \u516c\u9877&nbsp;", "7b12cfd843f671230bcdbbbbbcc14c72": "\u6bcf\u5468\u66f4\u65b0\uff0c\u56fe\u50cf\u91cd\u8bbf\u5468\u671f\u4e3a 6-12 \u5929&nbsp;", "39c0cb268b9b9a40bbd64a870899557b": "\u6bcf\u5b63\u5ea6\u786e\u5b9a\u9ad8\u4f18\u5148\u7ea7\u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u533a\u57df\u3002\u5728\u6b64\u5904\u6ce8\u518c\u65b0\u95fb\u901a\u8baf\u3002&nbsp;", "3225935c5899d9adf4d9222858753d84": "\u5168\u7403&nbsp;", "fc674f1ef17a156e7c092051fb081ce3": "\u4e00\u5929\u4e24\u6b21&nbsp;", "a0794704b0eb7d3db3e4f7330e76e93f": "\u6811\u6728\u8986\u76d6\u589e\u52a0&nbsp;", "bc4bb8d6c0deff6c365984e2f0bb03c3": "2020 \u5e74\uff0c30 \u7c73\uff0c\u5168\u7403\uff0cSBTN", "dc736984e30908f454f5cb054bb463ab": "\u5929\u7136\u6797", "11ce4f9bafef9a7a4f362f07ebe255e3": "30\u00d730 \u7c73", "470486afed39a0d5567219f059cb6632": "\u65b0\u7684\u5929\u7136\u6797\u6570\u636e\u53ef\u4f9b\u67e5\u9605", "00eed0943297125c4e7dbabcaedfc1c0": "\u65b0\u7684\u5929\u7136\u6797\u6570\u636e\u53ef\u4ee5\u5728<a href=\"{{0}}\">\u5730\u56fe</a>\u548c<a href=\"{{1}}\">\u4eea\u8868\u677f</a>\u4e0a\u67e5\u770b\u3002\u656c\u8bf7\u7559\u610f\u66f4\u591a\u4fe1\u606f\uff01", "b4194ecc5e46f7ec26298f645127330b": "\u622a\u81f3 2020 \u5e74\uff0c<b>\u5168\u7403</b>\u571f\u5730\u8986\u76d6\u533a\u7684 {naturalForestPercentage} \u4e3a\u5929\u7136\u6797\uff0c{nonNaturalForestPercentage} \u4e3a\u975e\u5929\u7136\u690d\u88ab\u3002", "163b1c0b23eb1de09689e09aed8dd688": "\u622a\u81f3 2020 \u5e74\uff0c{location} \u7684\u571f\u5730\u8986\u76d6\u533a\u7684 {naturalForestPercentage} \u4e3a\u5929\u7136\u6797\uff0c{nonNaturalForestPercentage} \u4e3a\u975e\u5929\u7136\u690d\u88ab\u3002", "28fb7be5ac0fd9d8b9b8e72825188539": "2020 \u5e74\uff0c{location} \u7684\u5929\u7136\u6797\u9762\u79ef\u4e3a {extent}\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684 {percentage}\u3002{year} \u5e74\uff0c\u8be5\u5730\u5931\u53bb\u4e86 {loss} \u7684\u5929\u7136\u6797\uff0c\u76f8\u5f53\u4e8e {emissionsTreeCover} \u7684\u4e8c\u6c27\u5316\u78b3\u6392\u653e\u91cf\u3002", "1492ba891b81060841d99d85807cf2f8": "\u975e\u5929\u7136\u690d\u88ab", "961d4d58e9627c6df5109ef7327767a4": "\u5df4\u897f\u7684\u5929\u7136\u6797", "8c8ea40bd0ddfea3e16ce4649f9ef18f": "\u5168\u7403\u5929\u7136\u6797", "3d591dad1af1ff54afb9c9616356ec41": "\u5176\u4ed6\u571f\u5730\u8986\u76d6\u533a", "e03dac0384294cbca3ba6410c0e10d2b": "2020 \u5e74\uff0c{location} \u62e5\u6709 {naturalForest} \u7684\u5929\u7136\u6797\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684 {percentage}\u3002{year} \u5e74\uff0c\u8be5\u5730\u5931\u53bb\u4e86 {naturalLoss} \u7684\u5929\u7136\u6797\uff0c\u76f8\u5f53\u4e8e {emissionsTreeCover} \u7684\u4e8c\u6c27\u5316\u78b3\u6392\u653e\u91cf\u3002", "2936b295ac3c2b6482fade2108e0cfa3": "\u65b0\u51fa\u73b0\u7684\u591a\u53d1\u5730\u533a&nbsp;", "d6c6b52cc99dda14cf91b675d3302e24": "\u6811\u6728\u8986\u76d6\u51c0\u53d8\u5316&nbsp;", "a2cc2cd37b75ccfd550a8452f0ab337c": "\u63a2\u7d22\u7ecf\u8fc7\u7cbe\u5fc3\u6574\u7406\u5e76\u5206\u6210\u4e94\u5927\u7c7b\u522b\u7684\u6570\u636e\u96c6\uff0c\u4ece\u800c\u4e86\u89e3\u68ee\u6797\u53d8\u5316\u7684\u65f6\u95f4\u3001\u5730\u70b9\u53ca\u5176\u9a71\u52a8\u56e0\u7d20\u548c\u5f71\u54cd\u3002\u8fd9\u4e9b\u6570\u636e\u4e0d\u4ec5\u53ef\u4ee5\u5728\u5730\u56fe\u4e0a\u8fdb\u884c\u53ef\u89c6\u5316\u548c\u5206\u6790\uff0c\u8fd8\u53ef\u4ee5\u4e0b\u8f7d\uff08\u9700\u5728\u6570\u636e\u63d0\u4f9b\u8005\u8bb8\u53ef\u7684\u60c5\u51b5\u4e0b\uff09\u3002&nbsp;&nbsp;", "6d24f11babafe3b5b0365ff6744981ec": "\u6570\u636e\u5206\u7c7b", "d5b55af4803d4c40c2f13c1d4b48b7f2": "\u5229\u7528\u78b3\u901a\u91cf\u3001\u78b3\u5bc6\u5ea6\u548c\u6f5c\u5728\u78b3\u589e\u76ca\u7684\u6570\u636e\u96c6\uff0c\u63a2\u7a76\u68ee\u6797\u5bf9\u5927\u6c14\u4e2d\u6e29\u5ba4\u6c14\u4f53\u6d53\u5ea6\u53ca\u6c14\u5019\u53d8\u5316\u7684\u5f71\u54cd\u673a\u5236\u3002&nbsp;", "1ec184080dd590a50fd4696d715dba8f": "\u5229\u7528\u6709\u5173\u751f\u7269\u591a\u6837\u6027\u73b0\u72b6\u548c\u5173\u952e\u751f\u7269\u591a\u6837\u6027\u533a\u57df\u7684\u6570\u636e\u96c6\uff0c\u63a2\u7a76\u68ee\u6797\u5bf9\u4e8e\u751f\u7269\u591a\u6837\u6027\u7684\u91cd\u8981\u6027\u3002&nbsp;", "fdc489aa96f5de5532bbb4a1325400b8": "\u4e86\u89e3\u5982\u4f55\u4f7f\u7528 GFW \u5de5\u5177\uff0c\u5982\u5730\u56fe\u3001\u4fe1\u606f\u9762\u677f\u3001Forest Watcher \u7b49\u6765\u76d1\u6d4b\u68ee\u6797\u780d\u4f10\u60c5\u51b5\u5e76\u53ef\u6301\u7eed\u5730\u7ba1\u7406\u68ee\u6797\u3002\u5728\u6b64\u5904\u4e86\u89e3\u6709\u5173 GFW \u5de5\u5177\u7684\u66f4\u591a\u4fe1\u606f\u3002&nbsp;", "4eec2cdad7efd2b6865fbd1996ff9232": "\u4e0b\u8f7d\u6570\u636e", "b1ce775217bdba2f08f73d3ba142250b": "\u901a\u8fc7 API \u8bbf\u95ee\u6570\u636e", "f0d3bb2de671babe8aabf7119c157708": "<strong>&nbsp;</strong>\u901a\u8fc7 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">GFW \u6570\u636e API</a> \u8bbf\u95ee\u6570\u636e&nbsp;\u4ee5\u67e5\u770b\u53ef\u7528\u6570\u636e\u548c\u76f8\u5173\u5143\u6570\u636e\u3002WRI \u7684<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8d44\u6e90\u89c2\u5bdf API</a> \u4e3a\u6765\u81ea\u8d44\u6e90\u89c2\u5bdf\u3001GFW \u548c\u6c34\u9053\u5168\u7403\u98ce\u9669\u5730\u56fe\u7684\u5730\u7406\u7a7a\u95f4\u5e94\u7528\u7a0b\u5e8f\u63d0\u4f9b\u4e86\u989d\u5916\u7684\u540e\u7aef\u8bbf\u95ee\u6743\u9650\u3002<a href=\"{{2}}\">\u5728\u6b64\u5904\u4e86\u89e3\u6709\u5173\u4f7f\u7528 GFW \u6570\u636e\u8fdb\u884c\u5f00\u53d1\u7684\u66f4\u591a\u4fe1\u606f</a>\u3002&nbsp;", "5efdfdb6ffea5100a7c284ba31e7e295": "Global Forest Watch (GFW) \u63d0\u4f9b\u4e86\u6700\u65b0\u7684\u6570\u636e\u3001\u6280\u672f\u548c\u5de5\u5177\uff0c\u5e2e\u52a9\u4e16\u754c\u5404\u5730\u7684\u4eba\u4eec\u66f4\u597d\u5730\u7ba1\u7406\u548c\u4fdd\u62a4\u68ee\u6797\u666f\u89c2\u3002\u6211\u4eec\u63d0\u4f9b\u4e86\u4e00\u7cfb\u5217\u72ec\u6709\u7684\u68ee\u6797\u53d8\u5316\u6570\u636e\u96c6\uff0c\u6db5\u76d6\u4ece\u8fd1\u4e4e\u5b9e\u65f6\u7684\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u8b66\u62a5\u5230\u968f\u65f6\u95f4\u63a8\u79fb\u7684\u6811\u6728\u8986\u76d6\u53d8\u5316\u3002\u8fd9\u4e9b\u6570\u636e\u96c6\u5177\u6709\u4e0d\u540c\u7684\u7279\u70b9\u3001\u4f18\u52bf\u548c\u52a3\u52bf\uff0c\u9002\u7528\u4e8e\u4e0d\u540c\u7684\u7528\u6237\u4efb\u52a1\u3002\u8fd1\u4e4e\u5b9e\u65f6\u7684<strong>\u68ee\u6797\u780d\u4f10\u8b66\u62a5</strong>\uff0c\u4f8b\u5982<a href=\"{{0}}\">\u7efc\u5408\u68ee\u6797\u780d\u4f10\u8b66\u62a5</a>\uff0c\u7ed3\u5408\u4e86\u6765\u81ea\u591a\u4e2a\u536b\u661f\u6e90\u7684\u6570\u636e\uff0c\u4ee5\u652f\u6301\u5bf9\u68ee\u6797\u5e72\u6270\u7684\u5feb\u901f\u54cd\u5e94\u3002\u5bf9\u4e8e<strong>\u706b\u707e\u9020\u6210\u7684\u68ee\u6797\u635f\u5931</strong>\u7684\u4fe1\u606f\uff0c<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u706b\u707e\u5bfc\u81f4\u7684\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u635f\u5931</a>\u6570\u636e\u7a81\u51fa\u4e86<a href=\"{{2}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u706b\u707e\u5bfc\u81f4\u7684\u635f\u5931\u8d8b\u52bf</a>\uff0c\u800c<a href=\"{{3}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u706b\u707e\u8b66\u62a5</a> (VIIRS) \u5219\u53ef\u4ee5\u8fd1\u4e4e\u5b9e\u65f6\u5730\u8bc6\u522b\u5168\u7403\u706b\u707e\u4f4d\u7f6e\u3002&nbsp;&nbsp;", "61eb3299248ead9cf33155e8c545d79f": "\u663e\u793a\u5168\u7403 PM2.5 \u7a7a\u6c14\u8d28\u91cf&nbsp;", "f23ac9320246904416e31ec21056906b": "\u8fd1\u4e4e\u5b9e\u65f6&nbsp;", "b9fe3de5e03dcc4ade533899145e3262": "\u5168\u7403\u9646\u5730\u9762\u79ef\uff08\u4e0d\u5305\u62ec\u5357\u6781\u6d32\u548c\u5176\u4ed6\u5317\u6781\u5c9b\u5c7f\uff09", "639aec83f2f49f35653c9be6d70d097d": "\u571f\u5730\u8986\u76d6&nbsp;", "7df1f06dd0be3b04c609fec14989f63e": "\u5c55\u793a\u4e86 2015 \u5e74\u5168\u7403\u571f\u5730\u8986\u76d6\u5206\u5e03\u60c5\u51b5&nbsp;", "931fd223b590e1d5ba3ce685b4446c3c": "300 \u00d7 300 \u7c73&nbsp;", "261affef4de866e1cba69acb3a78bdb8": "\u5168\u7403\u706b\u9669\u5929\u6c14\u6307\u6570&nbsp;", "575af69f80ae622d292c98e3cae7e829": "\u663e\u793a\u706b\u9669\u5929\u6c14\u6307\u6570\uff0c\u8fd9\u662f\u4e00\u79cd\u706b\u707e\u5371\u9669\u7b49\u7ea7\u7cfb\u7edf&nbsp;", "a7ba36809dc92591a0d0f260fcb137b3": "\u5168\u7403\u8303\u56f4\uff0c\u539f\u578b\u6570\u636e\u5728\u5317\u7eac 52 \u5ea6\u4ee5\u4e0a&nbsp;", "8f103c203348dba42522cfaf0047800d": "\u4ee5\u4eba\u7c7b\u6d3b\u52a8\u5f71\u54cd\u7a0b\u5ea6\u4e3a\u4f9d\u636e\uff0c\u7528\u8fde\u7eed\u6307\u6570\u7684\u5f62\u5f0f\u5448\u73b0\u68ee\u6797\u72b6\u51b5&nbsp;", "d2ac2298e8e6a13172c43cc25f978c05": "300 x 300 \u7c73&nbsp;", "fbe609726db0f798943bb6b50647060d": "\u5b8c\u6574\u68ee\u6797\u666f\u89c2&nbsp;", "f37b56cb0af516d30acc74849934ff5c": "\u7ea6 1:1,000,000&nbsp;", "d3cce34c7cced96f4ac3ea17376c558e": "\u7ea2\u6811\u6797&nbsp;", "633f904be89b5826691aa185bf419a68": "\u786e\u5b9a\u7279\u5b9a\u56fd\u5bb6\u7684\u4eba\u5de5\u6797\u548c\u6728\u672c\u7ecf\u6d4e\u4f5c\u7269&nbsp;", "eca7230e1f7958118a925f7650a8a205": "RTRS \u8d1f\u8d23\u4efb\u5927\u8c46\u79cd\u690d\u6269\u5f20\u6307\u5357&nbsp;", "f5763402dc2169515b931716b89bc097": "\u663e\u793a\u4e86 RSPO \u6210\u5458\u516c\u53f8\u7684\u7279\u8bb8\u533a\u8fb9\u754c\uff0c\u5305\u62ec\u5df2\u8ba4\u8bc1\u548c\u672a\u8ba4\u8bc1\u7684\u7279\u8bb8\u533a\u3002&nbsp;", "6fea71e0cb5db9d2e4da001e14f31fa2": "\u8986\u76d6\u5168\u7403\u8303\u56f4\u5185\u6240\u6709 RSPO \u6210\u5458\u516c\u53f8\u7684\u7279\u8bb8\u7ecf\u8425\u70b9\u533a\u57df\u3002\u76ee\u524d\uff0c\u5df2\u8ba4\u8bc1\u7684\u7279\u8bb8\u533a\u57df\u5206\u5e03\u5728\u4ee5\u4e0b\u56fd\u5bb6\uff1a\u5df4\u897f\u3001\u79d1\u7279\u8fea\u74e6\u3001\u67ec\u57d4\u5be8\u3001\u54e5\u4f26\u6bd4\u4e9a\u3001\u54e5\u65af\u8fbe\u9ece\u52a0\u3001\u591a\u7c73\u5c3c\u52a0\u5171\u548c\u56fd\u3001\u5384\u74dc\u591a\u5c14\u3001\u52a0\u84ec\u3001\u52a0\u7eb3\u3001\u5371\u5730\u9a6c\u62c9\u3001\u6d2a\u90fd\u62c9\u65af\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u3001\u5229\u6bd4\u91cc\u4e9a\u3001\u9a6c\u6765\u897f\u4e9a\u3001\u58a8\u897f\u54e5\u3001\u5c3c\u52a0\u62c9\u74dc\u3001\u5df4\u5e03\u4e9a\u65b0\u51e0\u5185\u4e9a\u3001\u79d8\u9c81\u3001\u585e\u62c9\u5229\u6602\u3001\u6240\u7f57\u95e8\u7fa4\u5c9b\u3001\u6cf0\u56fd\u548c\u591a\u54e5\u3002&nbsp;", "cecac92c3dee7c8b532847f6bd353c54": "\u77f3\u6cb9\u548c\u5929\u7136\u6c14\u7279\u8bb8\u533a&nbsp;", "54b159c37f60c5eb606d910e71d1b547": "\u663e\u793a\u4e86\u653f\u5e9c\u4e3a\u4f01\u4e1a\u5212\u5b9a\u7684\u52d8\u63a2\u78b3\u6c22\u5316\u5408\u7269\u3001\u77f3\u6cb9\u548c\u5929\u7136\u6c14\u7684\u533a\u57df\u8fb9\u754c\u3002&nbsp;", "aed351911ff1a41c72c8a5b7a84d515d": "\u963f\u6839\u5ef7\u3001\u5df4\u897f\u3001\u54e5\u4f26\u6bd4\u4e9a\u3001\u5384\u74dc\u591a\u5c14\u548c\u79d8\u9c81&nbsp;", "90a520ff08054d89fe4fd0ea36cac10f": "\u901a\u8fc7\u6765\u81ea\u4e09\u4e2a\u8b66\u62a5\u7cfb\u7edf\u7684\u7efc\u5408\u8b66\u62a5\uff0c\u5bf9\u68ee\u6797\u5e72\u6270\u60c5\u51b5\u8fdb\u884c\u8fd1\u4e4e\u5b9e\u65f6\u7684\u76d1\u6d4b\u3002", "6f533d2a30f38147f96cc86db08e03cc": "\u8fd1\u4e4e\u5b9e\u65f6\u5730\u8bc6\u522b\u51fa\u53ef\u80fd\u51fa\u73b0\u6811\u6728\u8986\u76d6\u635f\u5931\u7684\u533a\u57df\u3002&nbsp;", "d9eb9da413615486f66a5f9b78cd092e": "\u4e9a\u9a6c\u900a\u76c6\u5730&nbsp;", "6e38b182f7b9fdb7c4ff8d184319a6ce": "\u5357\u7f8e\u6d32\u3001\u4e2d\u7f8e\u6d32\u3001\u6492\u54c8\u62c9\u4ee5\u5357\u975e\u6d32\u4ee5\u53ca\u4e1c\u5357\u4e9a\u5c9b\u5c7f\u4e0a\u7684\u6e7f\u6da6\u70ed\u5e26\u68ee\u6797&nbsp;", "50073e8b1652c81e3fbba68ea13e9021": "\u503c\u5f97\u5173\u6ce8\u7684\u5730\u65b9&nbsp;", "4f596759c2c2d902b3195162511cdcff": "10 x 10 \u516c\u91cc&nbsp;", "ad67188f6c6ce5d080bcef64a02192c3": "\u706b\u707e&nbsp;", "de999d3dbf1ca77188be6177677da8ce": "\u5c3d\u7ba1\u5728\u67d0\u4e9b\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u4e2d\uff0c\u68ee\u6797\u5927\u706b\u7684\u53d1\u751f\u5c5e\u4e8e\u81ea\u7136\u73b0\u8c61\uff0c\u4f46\u8fd1\u5e74\u6765\u706b\u707e\u7684\u5f3a\u5ea6\u8d8a\u6765\u8d8a\u5927\uff0c\u5f71\u54cd\u8303\u56f4\u4e5f\u8d8a\u6765\u8d8a\u5e7f\u3002\u6c14\u5019\u53d8\u5316\u5bfc\u81f4\u7684\u9ad8\u6e29\u548c\u5e72\u65f1\u5929\u6c14\uff0c\u4ee5\u53ca\u4e0d\u5f53\u7684\u571f\u5730\u7ba1\u7406\uff0c\u4e3a\u66f4\u9891\u7e41\u3001\u66f4\u5927\u89c4\u6a21\u548c\u66f4\u9ad8\u5f3a\u5ea6\u7684\u68ee\u6797\u5927\u706b\u521b\u9020\u4e86\u6709\u5229\u6761\u4ef6\u3002\u4e3a\u4e86\u76d1\u63a7\u548c\u7ba1\u7406\u8fd9\u4e9b\u5a01\u80c1\uff0cGFW \u4e0a\u63d0\u4f9b\u7684\u706b\u707e\u6570\u636e\u5206\u6210\u4e86\u4e24\u7c7b\uff1a<strong>\u706b\u707e\u6d3b\u52a8\u6570\u636e</strong>\uff08\u7528\u4e8e\u67e5\u770b\u6b63\u5728\u8fdb\u884c\u7684\u706b\u707e\u5e76\u5206\u6790\u706b\u707e\u5f71\u54cd\u8303\u56f4\uff09\u548c<strong>\u80cc\u666f\u6570\u636e</strong>\uff08\u63d0\u4f9b\u6709\u5173\u706b\u707e\u98ce\u9669\u533a\u57df\u53ca\u5176\u5f71\u54cd\u7684\u8865\u5145\u4fe1\u606f\uff09\u3002&nbsp;", "9841bdc50c4226cb6ec5db76494249e6": "\u8986\u76d6\u8303\u56f4", "2cd633da4777c7e187890ff3c914dd7d": "\u5730\u7406", "cebb06fce9f859185fc681e5d00b707b": "\u663e\u793a\u8fc7\u53bb 24 \u5c0f\u65f6\u300148 \u5c0f\u65f6\u300172 \u5c0f\u65f6\u6216 7 \u5929\u7684\u706b\u707e\u8b66\u62a5\u6570\u636e&nbsp;", "a46b55528b6101236d88b4e8c8382199": "\u706b\u707e\u9020\u6210\u7684\u6811\u6728\u8986\u76d6\u635f\u5931&nbsp;", "5f47a1ff2bb5c0404e0f44ea1411a8cb": "\u5bf9\u6bd4\u6240\u6709\u5176\u4ed6\u5bfc\u81f4\u6811\u6728\u8986\u76d6\u635f\u5931\u7684\u56e0\u7d20\uff0c\u786e\u5b9a 2001 \u5e74\u81f3 2023 \u5e74\u671f\u95f4\u56e0\u706b\u707e\u5bfc\u81f4\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u533a\u57df&nbsp;", "55337d3af8724986d889b2628c3bf856": "Global Forest Watch (GFW) \u63d0\u4f9b\u6700\u65b0\u6570\u636e\uff0c\u8ba9\u4e16\u754c\u5404\u5730\u7684\u4eba\u4eec\u80fd\u591f\u8bc6\u522b\u4e0d\u540c\u7c7b\u578b\u7684\u571f\u5730\u5229\u7528\u60c5\u51b5\u3002\u6211\u4eec\u63d0\u4f9b\u4e86\u4e00\u7cfb\u5217\u72ec\u6709\u7684\u6570\u636e\u96c6\uff0c\u6db5\u76d6\u5546\u54c1\u3001\u4fdd\u80b2\u3001\u57fa\u7840\u8bbe\u65bd\u548c\u4eba\u53e3\u7b49\u65b9\u9762\uff0c\u6709\u52a9\u4e8e\u660e\u786e\u68ee\u6797\u635f\u5931\u7684\u5408\u6cd5\u6027\u548c\u9a71\u52a8\u56e0\u7d20\u3002\u5546\u54c1\u6570\u636e\u6db5\u76d6\u4e86\u91c7\u77ff\u3001\u4f10\u6728\u3001\u90e8\u5206\u6728\u672c\u7ecf\u6d4e\u4f5c\u7269\u4ee5\u53ca\u77f3\u6cb9/\u5929\u7136\u6c14\u7279\u8bb8\u533a\uff0c\u8fd9\u4e9b\u6570\u636e\u662f\u6839\u636e\u653f\u5e9c\u673a\u6784\u3001\u975e\u653f\u5e9c\u7ec4\u7ec7\u53ca\u5176\u4ed6\u76f8\u5173\u673a\u6784\u63d0\u4f9b\u7684\u4fe1\u606f\u6c47\u7f16\u800c\u6210\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u4fdd\u80b2\u6570\u636e</a>\u5c55\u793a\u4e86\u7531\u4e16\u754c\u4fdd\u62a4\u533a\u6570\u636e\u5e93\u7f16\u5236\u7684\u4fdd\u62a4\u533a\u5206\u5e03\u3002\u57fa\u7840\u8bbe\u65bd\u6570\u636e\u5c55\u793a\u4e86<a href=\"{{1}}\" class=\"\" target=\"_blank\" rel=\"noreferrer noopener\">\u521a\u679c\u76c6\u5730\u4f10\u6728\u9053\u8def</a>\u548c<a href=\"{{2}}\">\u5927\u578b\u6c34\u575d</a>\u5206\u5e03\uff0c\u5e2e\u52a9\u7528\u6237\u76f4\u89c2\u4e86\u89e3\u53ef\u80fd\u5f15\u53d1\u68ee\u6797\u780d\u4f10\u7684\u57fa\u7840\u8bbe\u65bd\u9879\u76ee\u6240\u5728\u4f4d\u7f6e\u3002\u6700\u540e\uff0c\u4eba\u53e3\u6570\u636e\u5305\u62ec<a href=\"{{3}}\" class=\"\" target=\"_blank\" rel=\"noreferrer noopener\">\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730</a>\uff0c\u7528\u4e8e\u8bc6\u522b\u7531\u539f\u4f4f\u6c11\u548c\u5f53\u5730\u793e\u533a\u6309\u7167\u60ef\u4f8b\u7ba1\u7406\u7684\u571f\u5730\u3002\u6d4f\u89c8\u4e0b\u65b9\u6700\u53d7\u6b22\u8fce\u7684\u6570\u636e\u96c6\uff0c\u5f00\u59cb\u63a2\u7d22\u4e4b\u65c5\u3002&nbsp;&nbsp;", "aab51c285ee18a2a1e528d591fc10057": "\u8fd9\u4e9b\u6570\u636e\u96c6\u6c47\u96c6\u4e86\u653f\u5e9c\u673a\u6784\u3001\u975e\u653f\u5e9c\u7ec4\u7ec7\u548c\u5176\u4ed6\u7ec4\u7ec7\u6536\u96c6\u7684\u4fe1\u606f\uff0c\u4ee5\u786e\u5b9a\u7279\u8bb8\u533a\uff08\u7279\u5b9a\u5546\u54c1\u6216\u5f00\u91c7\u6d3b\u52a8\u53ef\u5408\u6cd5\u8fdb\u884c\u7684\u5730\u70b9\uff09\u4ee5\u53ca\u5176\u4ed6\u6709\u5173\u5546\u54c1\u751f\u4ea7\u7684\u4fe1\u606f\uff0c\u4f8b\u5982\u53ef\u53ef\u79cd\u690d\u56ed\u7684\u5bc6\u5ea6\u548c\u68d5\u6988\u6cb9\u52a0\u5de5\u5382\u7684\u4f4d\u7f6e\u3002\u53c2\u9605\u4e0b\u65b9\u5185\u5bb9\uff0c\u4e86\u89e3\u6bcf\u4e2a\u6570\u636e\u96c6\u7684\u8be6\u7ec6\u4fe1\u606f\u3002", "13ad74d585674bab067a94b2c92175db": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a\u68ee\u6797\u780d\u4f10\u8b66\u62a5\uff1a\u536b\u661f\u76d1\u6d4b\u4e9a\u9a6c\u900a\u9762\u4e34\u7684\u5a01\u80c1", "5d12d13252c1e16da99af12423594735": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a\u5f00\u53d1\u6570\u636e\u6545\u4e8b\uff1a\u5229\u7528 Global Forest Watch \u8fdb\u884c\u65b0\u95fb\u62a5\u9053", "d638a3a88701865085e01668f4d3f84b": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a\u68ee\u6797\u780d\u4f10\u5927\u66dd\u5149\uff1a\u5229\u7528\u9ad8\u5206\u8fa8\u7387\u536b\u661f\u56fe\u50cf\u8c03\u67e5\u68ee\u6797\u780d\u4f10\u60c5\u51b5", "0db140a9c05d34626340b71c30142fdc": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a\u5229\u7528 Global Forest Watch \u63a2\u7a76\u6d3b\u8dc3\u706b\u707e\u52a8\u6001\u53ca\u5176\u53d1\u5c55\u8d8b\u52bf", "cede3374a18ca597461c5a65fbdabef6": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a\u8ffd\u8e2a\u6811\u6728\u8986\u76d6\u60c5\u51b5\uff1a\u5229\u7528 Global Forest Watch \u6570\u636e\u96c6\u8fdb\u884c\u590d\u539f", "2a6987f8cef167844e8045b436a5c76a": "\u68ee\u6797\u8109\u640f\uff1a\u4e16\u754c\u68ee\u6797\u6700\u65b0\u52a8\u6001", "e0496b8d38976c7e364fd8095dfb57d3": "\u8865\u5145\u8d44\u6599&nbsp;", "8751b317dab69623f4ff19bc05964bc5": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a2023 \u5e74\u68ee\u6797\u635f\u5931\uff1a\u533a\u57df\u80cc\u666f\u548c\u5168\u7403\u8d8b\u52bf", "f56829511c9ab68b68a69b9ad5fabae7": "GFW \u5de5\u5177", "f3c0500f3db257a386c5d79bf6ad39eb": "30 X 30 \u7c73&nbsp;", "0e285cfaf8f62bb9f8c1f8a4752f844e": "\u4ee5 10 \u7c73\u7684\u7a7a\u95f4\u5206\u8fa8\u7387\u663e\u793a\u6811\u6728\u5206\u5e03\u8303\u56f4\uff0c\u5e76\u4ee5\u534a\u516c\u9877\u4e3a\u5355\u4f4d\u5c55\u793a\u6811\u6728\u8986\u76d6\u60c5\u51b5\uff0c\u4ee5\u4fbf\u51c6\u786e\u76d1\u6d4b\u57ce\u5e02\u5730\u533a\u3001\u519c\u4e1a\u7528\u5730\u4ee5\u53ca\u5f00\u9614\u6797\u51a0\u548c\u5e72\u71e5\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u4e2d\u7684\u6811\u6728&nbsp;", "293abfb1f47ef78de10c0775372686f6": "10 X 10\u7c73\uff0c\u534a\u516c\u9877 &nbsp;", "c0e10373460433ac301627083a7e17c3": "\u68ee\u6797\u662f\u5168\u7403 80% \u9646\u751f\u52a8\u690d\u7269\u7684\u5bb6\u56ed\uff0c\u800c\u751f\u7269\u591a\u6837\u6027\u53cd\u8fc7\u6765\u5bf9\u4e8e\u7ef4\u6301\u68ee\u6797\u5065\u5eb7\u4e5f\u81f3\u5173\u91cd\u8981\uff08<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5728\u6b64\u5904\u4e86\u89e3\u66f4\u591a\u5173\u4e8e\u68ee\u6797\u4e0e\u751f\u7269\u591a\u6837\u6027\u7684\u4fe1\u606f</a>\uff09\u3002&nbsp;", "1b055a9ceffdcd421c64d74b73a448b9": "Global Forest Watch (GFW) \u63d0\u4f9b\u4e86\u51e0\u4e2a\u5173\u952e\u6570\u636e\u96c6\uff0c\u5e2e\u52a9\u53ef\u89c6\u5316\u548c\u7406\u89e3\u8fd9\u4e9b\u590d\u6742\u7684\u52a8\u6001\u3002<strong>\u5168\u7403\u751f\u7269\u591a\u6837\u6027\u5b8c\u6574\u6027</strong>\u6570\u636e\u96c6\u663e\u793a\u7269\u79cd\u7fa4\u843d\u6700\u5b8c\u6574\u7684\u533a\u57df\uff0c\u800c<strong>\u5168\u7403\u751f\u7269\u591a\u6837\u6027\u91cd\u8981\u6027</strong>\u6570\u636e\u96c6\u5219\u57fa\u4e8e\u7269\u79cd\u4e30\u5bcc\u5ea6\u548c\u7279\u6709\u6027\uff0c\u7a81\u51fa\u4e86\u5bf9\u4fdd\u62a4\u751f\u7269\u591a\u6837\u6027\u81f3\u5173\u91cd\u8981\u7684\u533a\u57df\u3002<strong>\u751f\u7269\u591a\u6837\u6027\u5173\u952e\u533a</strong>\u6570\u636e\u96c6\u8bc6\u522b\u4e86\u5bf9\u5168\u7403\u751f\u7269\u591a\u6837\u6027\u5b58\u7eed\u81f3\u5173\u91cd\u8981\u7684\u5730\u533a\uff0c\u800c<strong>\u751f\u7269\u591a\u6837\u6027\u70ed\u70b9</strong>\u6570\u636e\u96c6\u5219\u91cd\u70b9\u5173\u6ce8\u90a3\u4e9b\u751f\u7269\u591a\u6837\u6027\u9ad8\u4e14\u53d7\u5230\u4e25\u91cd\u5a01\u80c1\u7684\u533a\u57df\u3002\u5728\u4e0b\u9762\u4e86\u89e3\u6709\u5173\u6bcf\u4e2a\u6570\u636e\u96c6\u7684\u66f4\u591a\u4fe1\u606f&nbsp;", "8d20601998e8f84080b960fddc01bdea": "1 X 1 \u5343\u7c73&nbsp;", "d0c9a1e7c8777649d58265ec29f6d206": "\u5168\u7403\u751f\u7269\u591a\u6837\u6027\u91cd\u8981\u6027&nbsp;", "a5dd5b3b6dfd46afeb7d21c3021e8603": "\u663e\u793a\u5173\u952e\u4fdd\u62a4\u5730\u70b9\uff0c\u8fd9\u4e9b\u5730\u70b9\u5305\u542b\u5206\u5e03\u8303\u56f4\u6709\u9650\u4e14\u4ec5\u5b58\u5728\u4e8e\u8be5\u5730\u7684\u6fd2\u5371\u7269\u79cd\u3002&nbsp;", "f8dc2c8d9ab9ae23451c0fec4d6a0987": "\u663e\u793a\u751f\u7269\u591a\u6837\u6027\u5173\u952e\u533a\uff0c\u5176\u5b9a\u4e49\u4e3a\u201c\u5bf9\u5168\u7403\u751f\u7269\u591a\u6837\u6027\u5b58\u7eed\u6709\u91cd\u5927\u8d21\u732e\u7684\u5730\u70b9\u201d\u3002", "7edc702eb7ca0a4ea8cc49ec8caa9d08": "\u5168\u7403\uff08\u4ec5\u9650\u9646\u5730\uff09&nbsp;", "e137861f53dcd334d04e1adbc066cd44": "\u7279\u6709\u9e1f\u533a&nbsp;", "1608b960f4332a893985fa1bc5ae10d1": "\u8865\u5145\u6750\u6599", "96e7c00a75f17f82d805ab4332ee7e67": "Global Forest Review \u751f\u7269\u591a\u6837\u6027\u4fdd\u62a4\u6307\u6807", "a60ab5533a3d8594a50bbaf1fcc09836": "<strong>\u96f6\u706d\u7edd\u8054\u76df\u5730\u70b9\uff1a</strong>\u4e00\u4e2a\u7531\u4fdd\u62a4\u7ec4\u7ec7\u7ec4\u6210\u7684\u8054\u76df\uff0c\u65e8\u5728\u901a\u8fc7\u8bc6\u522b\u548c\u4fdd\u62a4\u5173\u952e\u5730\u70b9\u6765\u9632\u6b62\u751f\u7269\u591a\u6837\u6027\u7684\u706d\u7edd\uff0c\u8fd9\u4e9b\u5730\u70b9\u662f\u4e00\u4e2a\u6216\u591a\u4e2a\u6fd2\u5371\u6216\u6781\u5ea6\u6fd2\u5371\u7269\u79cd\u7684\u6700\u540e\u6816\u606f\u5730\u3002&nbsp;", "11bc76c8d2bc07a69f46c1113852dbc9": "<strong>\u751f\u7269\u591a\u6837\u6027\u70ed\u70b9\uff1a</strong>\u88ab\u8ba4\u4e3a\u751f\u7269\u591a\u6837\u6027\u4e30\u5bcc\u3001\u62e5\u6709\u5927\u91cf\u7279\u6709\u7269\u79cd\u3001\u5e76\u53d7\u5230\u6816\u606f\u5730\u4e27\u5931\u548c\u4eba\u7c7b\u6d3b\u52a8\u4e25\u91cd\u5a01\u80c1\u7684\u5730\u533a\u3002&nbsp;", "a3d73e97fcf8b4dcd4447350ffcbe80e": "<strong>\u751f\u7269\u591a\u6837\u6027\u91cd\u8981\u6027\uff1a</strong>\u6839\u636e\u7269\u79cd\u5206\u5e03\u8303\u56f4\u7684\u7a00\u6709\u6027\uff0c\u4e00\u4e2a\u5730\u533a\u5bf9\u4e8e\u7269\u79cd\u5b58\u7eed\u7684\u91cd\u8981\u6027\u3002&nbsp;", "a033798984f46fcbc6ca5d5b71051853": "<strong>\u78b3\u5bc6\u5ea6\uff1a</strong>\u67d0\u4e00\u5730\u533a\u5355\u4f4d\u9762\u79ef\uff08\u901a\u5e38\u4e3a\u516c\u9877\uff09\u7684\u78b3\u50a8\u91cf\u3002&nbsp; ", "78b97329804ef1280d715eec8e50e289": "<strong>\u78b3\u901a\u91cf\uff1a</strong>\u78b3\u5728\u5730\u7403\u78b3\u5e93\uff08\u5982\u6d77\u6d0b\u3001\u5927\u6c14\u3001\u9646\u5730\u548c\u5176\u4ed6\u751f\u7269\u4f53\uff09\u4e4b\u95f4\u7684\u8f6c\u79fb\u6216\u6d41\u52a8\u7684\u65b9\u5411\u548c\u901f\u7387\u3002\u78b3\u901a\u91cf\u53ef\u4ee5\u662f\u81ea\u7136\u4ea4\u6362\uff0c\u5982\u9646\u5730-\u5927\u6c14\u548c\u6d77\u6d0b-\u5927\u6c14\u901a\u91cf\uff0c\u4e5f\u53ef\u4ee5\u662f\u4eba\u4e3a\u4ea4\u6362\uff0c\u5982\u57ce\u5e02\u78b3\u901a\u91cf\u3002&nbsp;", "34fe5d4ddfd0dd1cff53c9a2c7522e90": "\u68ee\u6797\u5728\u5168\u7403\u78b3\u5faa\u73af\u548c\u51cf\u7f13\u6c14\u5019\u53d8\u5316\u65b9\u9762\u53d1\u6325\u7740\u91cd\u8981\u4f5c\u7528\uff0c\u901a\u8fc7\u78b3\u5c01\u5b58\u6210\u4e3a\u78b3\u6c47\uff0c\u6216\u5728\u68ee\u6797\u6d88\u5931\u6216\u9000\u5316\u65f6\u6210\u4e3a\u78b3\u6e90\u3002Global Forest Watch (GFW) \u63d0\u4f9b\u5404\u79cd\u5730\u7406\u7a7a\u95f4\u6570\u636e\u548c\u5de5\u5177\uff0c\u4f7f\u7528\u6237\u80fd\u591f\u4ee5 30 \u7c73\u7684\u5206\u8fa8\u7387\u76d1\u6d4b\u68ee\u6797\u78b3\u52a8\u6001\u7684\u65f6\u95f4\u548c\u7a7a\u95f4\u53d8\u5316\u3002\u6c14\u5019\u6570\u636e\u53ef\u5206\u4e3a\u4e09\u7c7b\uff1a&nbsp;&nbsp;", "05d0fbc960a23fb6ea01dcf73d78f128": "\u6bcf\u516c\u9877 CO<sub>2</sub>e \u5146\u514b\u6570\uff1a\u9002\u7528\u4e8e\u53ef\u89c6\u5316\u8868\u793a\u6bcf\u516c\u9877\u78b3\u901a\u91cf\u5bc6\u5ea6\u7684\u901a\u91cf\u3002&nbsp;  ", "886fd49dc5ded78b46711b69774eedad": "GFW \u63d0\u4f9b 2000 \u5e74\u5168\u7403 30 \u7c73\u5206\u8fa8\u7387\u7684\u6728\u8d28\u5730\u4e0a\u751f\u7269\u91cf (AGB) \u5730\u56fe\u3002\u8be5\u5730\u56fe\u7ed3\u5408\u68ee\u6797\u6837\u5730\u6570\u636e\u3001\u6fc0\u5149\u96f7\u8fbe\u6570\u636e\u548c\u536b\u661f\u56fe\u50cf\u521b\u5efa\u800c\u6210\u3002\u7531\u4e8e\u5b83\u4ee3\u8868\u4e86 20 \u591a\u5e74\u524d\u7684\u68ee\u6797\u751f\u7269\u91cf\uff0c\u56e0\u6b64\u4e0d\u4e00\u5b9a\u80fd\u53cd\u6620\u5f53\u524d\u7684\u68ee\u6797\u751f\u7269\u91cf\u3002\u7136\u800c\uff0c\u4f5c\u4e3a\u672c\u4e16\u7eaa\u521d\u5386\u53f2\u751f\u7269\u91cf\u7684\u53c2\u8003\u70b9\uff0c\u5b83\u975e\u5e38\u6709\u7528\u3002\u5730\u4e0a\u78b3\u5bc6\u5ea6\u53ef\u4ee5\u901a\u8fc7\u5c06 AGB \u503c\u4e58\u4ee5\u751f\u7269\u91cf\u5230\u78b3\u7684\u8f6c\u6362\u7cfb\u6570 0.47 \u6765\u8fd1\u4f3c\u4f30\u7b97\u3002&nbsp;", "9707a655833952469eb2580115ef00db": "\u6bcf\u50cf\u7d20\u7684\u5730\u4e0a\u751f\u7269\u91cf\uff08AGB\uff09\u5146\u514b\u6570\uff1a\u9002\u7528\u4e8e\u8ba1\u7b97\u611f\u5174\u8da3\u533a\u57df\u7684 AGB \u603b\u91cf\u3002&nbsp;", "c8ced7184e88541db830defb10cafcf0": "\u6f5c\u5728\u78b3\u5c01\u5b58\u901f\u7387&nbsp;", "6874d765809383fe7a3d58330e453b6b": "\u4f30\u7b97\u4e86\u6f5c\u5728\u53ef\u91cd\u65b0\u9020\u6797\u7684\u533a\u57df\u5185\uff0c\u81ea\u7136\u518d\u751f\u68ee\u6797\u5728\u524d 30 \u5e74\u5185\uff0c\u5730\u4e0a\u6d3b\u751f\u7269\u91cf\u4e2d\u7684\u78b3\u6c47\u901f\u7387\uff08\u5355\u4f4d\uff1a\u5146\u514b\u78b3/\u516c\u9877/\u5e74\uff09\u3002", "b485a1ad8d975905aee13ceebad0ad18": "\u5168\u7403\uff0c\u6839\u636e Griscom et al. 2017 \u5e74\u7684\u7814\u7a76\u786e\u5b9a\u7684\u68ee\u6797\u6062\u590d\u8303\u56f4\u5185\uff08\u4e0d\u5305\u62ec\u5317\u65b9\u9488\u53f6\u6797\u3001\u8349\u5730\u751f\u7269\u7fa4\u843d\u548c\u519c\u7530\uff09&nbsp;", "c808cf4d31a349fda6e11bf77ca1ba21": "\u4e86\u89e3\u6709\u5173 GFW \u68ee\u6797\u78b3\u901a\u91cf\u76d1\u6d4b\u6846\u67b6\u7684\u66f4\u591a\u4fe1\u606f\uff1a&nbsp;&nbsp;", "827c8eb3d788ef1f81c8d0d3ba80633e": "GFW \u68ee\u6797\u78b3\u76d1\u6d4b\u7684\u65b0\u529f\u80fd", "65330b6f25fea9e69c568089d5d087c0": "\u4ece GFW \u5168\u7403\u6c14\u5019\u6570\u636e\u4e2d\u83b7\u5f97\u7684\u89c1\u89e3\uff1a&nbsp;", "fa0ba7063a98d422eae060797f093e13": "\u68ee\u6797\u6bcf\u5e74\u5438\u6536\u7684\u78b3\u91cf\u662f\u5176\u6392\u653e\u91cf\u7684\u4e24\u500d&nbsp;", "45d10f730cd84ff1c6fe73ac5a78c0e9": "\u5e74\u8f7b\u68ee\u6797\u6355\u83b7\u78b3\u7684\u901f\u5ea6\u6bd4\u4e4b\u524d\u8ba4\u4e3a\u7684\u66f4\u5feb&nbsp;", "00ae590ba505a8684a84af7d0b7aa701": "\u6c14\u5019\u53d8\u5316\u5c06\u6539\u53d8\u6211\u4eec\u6240\u77e5\u9053\u7684\u68ee\u6797", "bcecb6290f6afaa3331199ef3d5fcd68": "\u751f\u7269\u591a\u6837\u6027\u5bf9\u4e8e\u5730\u7403\u7684\u5065\u5eb7\u548c\u53ef\u6301\u7eed\u53d1\u5c55\u81f3\u5173\u91cd\u8981\uff0c\u800c\u5730\u7406\u7a7a\u95f4\u6570\u636e\u53ef\u4ee5\u5e2e\u52a9\u6211\u4eec\u66f4\u597d\u5730\u7406\u89e3\u5b83\u3002&nbsp;Global Forest Watch (GFW)&nbsp;\u63d0\u4f9b\u4e86\u591a\u4e2a\u751f\u7269\u591a\u6837\u6027\u6570\u636e\u96c6\uff0c\u5e2e\u52a9\u7528\u6237\u5b9a\u4f4d\u751f\u7269\u591a\u6837\u6027\u7684\u5173\u952e\u5730\u70b9\u5e76\u53ef\u89c6\u5316\u76f8\u5173\u7684\u5168\u7403\u751f\u7269\u591a\u6837\u6027\u6a21\u5f0f\u3002\u8fd9\u4e9b\u6570\u636e\u96c6\u6839\u636e\u7269\u79cd\u4e30\u5bcc\u5ea6\u3001\u7279\u6709\u6027\u3001\u5b8c\u6574\u6027\u548c\u5bf9\u6fd2\u5371\u7269\u79cd\u4fdd\u62a4\u81f3\u5173\u91cd\u8981\u7684\u6816\u606f\u5730\u7b49\u56e0\u7d20\uff0c\u7a81\u51fa\u4e86\u751f\u7269\u591a\u6837\u6027\u4fdd\u62a4\u7684\u5173\u952e\u533a\u57df\uff0c\u540c\u65f6\u8fd8\u6db5\u76d6\u90a3\u4e9b\u751f\u7269\u591a\u6837\u6027\u4e30\u5bcc\u4f46\u53d7\u5230\u5a01\u80c1\u4e14\u53d7\u68ee\u6797\u7684\u4eba\u7c7b\u6d3b\u52a8\u538b\u529b\u5f71\u54cd\u6700\u5927\u7684\u5730\u533a\u3002\u8fd9\u4e9b\u6570\u636e\u96c6\u5171\u540c\u4e3a\u751f\u7269\u591a\u6837\u6027\u72b6\u51b5\u4ee5\u53ca\u68ee\u6797\u6816\u606f\u5730\u5728\u4fdd\u62a4\u9646\u5730\u7269\u79cd\u4e2d\u7684\u91cd\u8981\u6027\u63d0\u4f9b\u4e86\u5173\u952e\u89c1\u89e3\u3002", "ac0f8583c1843936fb9e7befc89f5e5e": "\u663e\u793a\u539f\u4f4f\u6c11\u6216\u5f53\u5730\u793e\u533a\u5bf9\u67d0\u4e9b\u8d44\u6e90\u62e5\u6709\u6743\u5229\u7684\u533a\u57df\u7684\u8fb9\u754c &nbsp;", "b1a6fc86b76f555e6e781eb51a46ca90": "250 \u7c73", "22e8a8667c89e0c5add9960eb551c200": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1aGFW \u5982\u4f55\u5e2e\u52a9\u975e\u653f\u5e9c\u7ec4\u7ec7\u66f4\u597d\u5730\u4fdd\u62a4\u68ee\u6797", "6124aa01fcdef30d82ac076a7b1a68ef": "\u57fa\u4e8e\u5730\u7406\u7a7a\u95f4\u68ee\u6797\u78b3\u901a\u91cf\u76d1\u6d4b\u6846\u67b6\u7684 GFW \u6570\u636e\uff0c\u7ed8\u5236\u4e86\u68ee\u6797\u7684\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u603b\u91cf\u3001\u78b3\u6e05\u9664\u603b\u91cf\uff08\u5c01\u5b58\u91cf\uff09\u4ee5\u53ca\u5b83\u4eec\u4e4b\u95f4\u7684\u5dee\u503c\u6216\u51c0\u901a\u91cf\u3002\u5b83\u7ed3\u5408\u4e86\u4f7f\u7528 IPCC \u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355\u6307\u5357\u7684\u5168\u7403\u5730\u7406\u7a7a\u95f4\u6570\u636e\u96c6\uff0c\u5206\u522b\u4f30\u7b97\u6392\u653e\u91cf\u548c\u6e05\u9664\u91cf\uff1a&nbsp;", "fc446d7dfc13bbb08b8e5ec65b092e91": "<strong>\u6392\u653e\u91cf</strong>\u662f\u901a\u8fc7\u5c06\u6797\u5206\u66ff\u4ee3\u68ee\u6797\u5e72\u6270\u3001\u78b3\u5bc6\u5ea6\u548c\u5176\u4ed6\u76f8\u5173\u5730\u7406\u7a7a\u95f4\u6570\u636e\u53e0\u52a0\u5f97\u51fa\u7684\u3002&nbsp;", "1a907376de73277ac8b476a0ce2474ed": "\u5f53\u603b\u6392\u653e\u91cf\u8d85\u8fc7\u603b\u6e05\u9664\u91cf\u65f6\uff0c\u6e29\u5ba4\u6c14\u4f53\u51c0\u901a\u91cf\u503c\u4e3a\u6b63\uff0c\u68ee\u6797\u88ab\u79f0\u4e3a<em>\u51c0\u6e90</em>\u3002\u5f53\u6e05\u9664\u91cf\u8d85\u8fc7\u6392\u653e\u91cf\u65f6\uff0c\u6e29\u5ba4\u6c14\u4f53\u51c0\u901a\u91cf\u503c\u4e3a\u8d1f\uff0c\u68ee\u6797\u88ab\u89c6\u4e3a<em>\u51c0\u6c47</em>\u3002", "7349228afea41502d6043ce139cd5f9a": "\u6240\u6709\u4e09\u4e2a\u6570\u636e\u96c6\u5747\u4ee5 2001 \u5e74\u81f3 2023 \u5e74\u7684\u7d2f\u8ba1\u503c\u62a5\u544a\u3002\u6392\u653e\u91cf\u6570\u636e\u53ef\u4ee5\u901a\u8fc7<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6811\u6728\u8986\u76d6\u635f\u5931\u5e74\u4efd</a>\u7684\u4fe1\u606f\u9010\u5e74\u8ffd\u8e2a\u3002\u6e05\u9664\u91cf\u548c\u51c0\u901a\u91cf\u65e0\u6cd5\u5206\u914d\u5230\u5177\u4f53\u5e74\u4efd\uff0c\u4f46\u53ef\u4ee5\u901a\u8fc7\u9664\u4ee5\u5e74\u6570\u6765\u8ba1\u7b97\u5e74\u5ea6\u5e73\u5747\u503c\u3002\u60a8\u53ef\u4ee5\u5728<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\"> GFW \u5730\u56fe</a>\u548c<a href=\"{{2}}\" target=\"_blank\" rel=\"noreferrer noopener\">GFW \u9762\u677f</a>\u4e0a\u63a2\u7d22\u8fd9\u4e9b\u6570\u636e\u96c6\uff0c\u4ee5\u76d1\u6d4b\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u52a8\u6001\u3002<a href=\"{{3}}\">\u6392\u653e\u91cf</a>\u3001<a href=\"{{4}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6e05\u9664\u91cf</a>\u548c<a href=\"{{5}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u51c0\u901a\u91cf</a>\u7684\u6805\u683c\u6570\u636e\u4e5f\u53ef\u5728 GFW \u5f00\u653e\u6570\u636e\u95e8\u6237\u4e0a\u4e0b\u8f7d\uff0c\u63d0\u4f9b\u4e24\u79cd\u5355\u4f4d\uff1a&nbsp;", "22f8fe1b4034ec22cdcc3c775f2fdfd0": "\u663e\u793a\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u9020\u6210\u7684\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u6392\u653e&nbsp;", "d3e5065b2342167568454b9f46e4def9": "\u66f4\u65b0\u9891\u7387", "a82be0f551b8708bc08eb33cd9ded0cf": "\u4fe1\u606f", "1d92bf04f224ce866d938629e5de826b": "\u663e\u793a\u6797\u5206\u548c\u65b0\u68ee\u6797\u7684\u68ee\u6797\u78b3\u6e05\u9664\u91cf &nbsp;", "d5227f6644949395f136ceb3c2740801": "<strong>\u6811\u6728\u751f\u7269\u91cf\u5bc6\u5ea6\uff1a</strong>\u6811\u6728\u5730\u4e0a\u90e8\u5206\u7684\u6d3b\u6709\u673a\u7269\u8d28\u7684\u91cf\u3002&nbsp;", "8ee7ca4eb3e9024dd8c99e1d40ec7ad6": "<strong>\u6811\u6728\u8986\u76d6\uff1a</strong> \u6240\u6709\u9ad8\u5ea6\u8d85\u8fc7 5 \u7c73\u7684\u690d\u88ab\uff0c\u53ef\u4ee5\u662f\u5929\u7136\u6797\u6216\u4eba\u5de5\u6797\u7684\u5f62\u5f0f\uff0c\u5177\u6709\u4e0d\u540c\u7684\u6811\u51a0\u5bc6\u5ea6\u3002&nbsp;", "a0af29ae9d68c3be98ae1a0941c6cad0": "<strong>\u706b\u707e\u9020\u6210\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\uff1a</strong>\u6307 GFW \u4e0a\u7684<a href=\"{{0}}\">\u6b64\u6570\u636e\u5c42</a>\uff0c\u5b83\u8bc6\u522b\u706b\u707e\u9020\u6210\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u533a\u57df\u3002&nbsp;", "19ee4b944f59ea727ee7b3ab32bb3b83": "<strong>\u70ed\u5e26\u6811\u6728\u8986\u76d6\uff1a</strong>\u6307 GFW \u4e0a\u7684<a href=\"{{0}}\">\u6b64\u6570\u636e\u5c42</a>\uff0c\u5b83\u4ee5 10 \u7c73\u7684\u5206\u8fa8\u7387\u663e\u793a\u70ed\u5e26\u5730\u533a\uff08\u7eac\u5ea6 -23.44 \u81f3 23.44\uff09\u7684\u6811\u6728\u8303\u56f4\u3002&nbsp;&nbsp;", "9cd593dd7ed895709564a2da94bf7dff": "\u5168\u7403\u4eba\u53e3\u5bc6\u5ea6\u548c\u5206\u5e03\u4f30\u8ba1&nbsp;", "6144f9a4613d02f73e3aec406780f506": "1 X1 \u5343\u7c73&nbsp;", "97cc2e11d9cc8f4032383cfbff8befae": "<strong>\u8fd1\u5b9e\u65f6 (NRT) \u76d1\u6d4b\uff1a</strong>\u6570\u636e\u5728\u6781\u77ed\u7684\u5ef6\u8fdf\u5185\u8fdb\u884c\u5904\u7406\uff0c\u901a\u5e38\u662f\u51e0\u5929\u6216\u66f4\u77ed\u7684\u65f6\u95f4\u8303\u56f4\u3002&nbsp;", "bbd95ef34e01d882262ccde0ee73f448": "<strong>\u6811\u6728\u8986\u76d6\u7684\u51c0\u53d8\u5316\uff1a</strong>\u6811\u6728\u8986\u76d6\u589e\u52a0\u548c\u51cf\u5c11\u4e4b\u95f4\u7684\u5dee\u5f02\u3002\u6b64\u6570\u636e\u663e\u793a\u5728\u4e24\u4e2a\u611f\u5174\u8da3\u7684\u65f6\u95f4\u6bb5\u5185\u6811\u6728\u8986\u76d6\u589e\u52a0\u6216\u51cf\u5c11\u7684\u60c5\u51b5\u3002&nbsp;", "452335d8e774e924fab5b6de8d699183": "<strong>\u68d5\u6988\u6cb9\u52a0\u5de5\u5382\uff1a</strong>\u52a0\u5de5\u7c97\u68d5\u6988\u6cb9\u548c\u68d5\u6988\u4ec1\u7684\u5730\u70b9\u3002&nbsp;&nbsp;", "b7b224a217b7e52175b93760b48f91c3": "<strong>\u4eba\u53e3\u5bc6\u5ea6\uff1a</strong>\u6307 GFW \u4e0a\u7684<a href=\"{{0}}\">\u8fd9\u4e2a\u6570\u636e\u5c42</a>\uff0c\u5b83\u4f7f\u7528 Global Human Settlement Layer (GHSL) \u4eba\u53e3\u7f51\u683c\u63cf\u7ed8\u4eba\u53e3\u7684\u5206\u5e03\u548c\u5bc6\u5ea6\u3002&nbsp;&nbsp;", "125769c95ada6e6c7564c97a3b616cc0": "<strong>\u539f\u59cb\u68ee\u6797\uff1a</strong>\u901a\u5e38\u5177\u6709\u9ad8\u78b3\u50a8\u91cf\u548c\u4e30\u5bcc\u751f\u7269\u591a\u6837\u6027\u7684\u53e4\u8001\u68ee\u6797\u3002&nbsp;", "5539036bc6f112c80042b17ba03a0639": "<strong>\u4fdd\u62a4\u533a\uff1a</strong>\u6307 GFW \u4e0a\u7684<a href=\"{{0}}\">\u8fd9\u4e2a\u6570\u636e\u5c42</a>\uff0c\u5b83\u663e\u793a\u6839\u636e\u5404\u79cd\u6307\u5b9a\u4fdd\u62a4\u72b6\u6001\uff08\u4f8b\u5982\u56fd\u5bb6\u516c\u56ed\u3001\u5dde\u7acb\u4fdd\u62a4\u533a\u548c\u91ce\u751f\u52a8\u7269\u4fdd\u62a4\u533a\uff09\u800c\u53d7\u5230\u6cd5\u5f8b\u4fdd\u62a4\u5e76\u4e14\u5176\u7ba1\u7406\u65b9\u5f0f\u80fd\u591f\u5b9e\u73b0\u4fdd\u62a4\u76ee\u6807\u7684\u533a\u57df\u3002&nbsp;", "9ae609f24661af06ec82105c639db086": "<strong>\u8d44\u6e90\u6743\u5229\uff1a</strong>\u6307 GFW \u4e0a\u7684<a href=\"{{0}}\">\u8fd9\u4e2a\u6570\u636e\u5c42</a>\uff0c\u5b83\u663e\u793a\u539f\u4f4f\u6c11\u6216\u5f53\u5730\u793e\u533a\u62e5\u6709\u67d0\u4e9b\u8d44\u6e90\u6743\u5229\u4ee5\u53ca\u6709\u9650\u571f\u5730\u4f7f\u7528\u6743\u7684\u533a\u57df\u8fb9\u754c\u3002&nbsp;&nbsp;", "4c3d1b6dff6c27d2ce97e0e4c45aff96": "<strong>RSPO \u68d5\u6988\u6cb9\u7279\u8bb8\u7ecf\u8425\u533a\uff1a</strong>\u6307 GFW \u4e0a\u7684<a href=\"{{0}}\">\u8fd9\u4e2a\u6570\u636e\u5c42</a>\uff0c\u663e\u793a\u622a\u81f3 2017 \u5e74 12 \u6708\u53ef\u6301\u7eed\u68d5\u6988\u6cb9\u5706\u684c\u4f1a\u8bae (RSPO) \u6210\u5458\u516c\u53f8\u7684\u7279\u8bb8\u7ecf\u8425\u533a\u8fb9\u754c\uff0c\u5305\u62ec\u5df2\u8ba4\u8bc1\u3001\u672a\u8ba4\u8bc1\u4ee5\u53ca\u8ba4\u8bc1\u72b6\u6001\u672a\u77e5\u7684\u7684\u7279\u8bb8\u7ecf\u8425\u533a\u3002&nbsp;", "5d01051b48857173756de626e715d996": "<strong>\u6811\u6728\u8986\u76d6\u51a0\u5c42\u5bc6\u5ea6\uff1a</strong>\u4ece\u4e0a\u65b9\u770b\u5230\u7684\u690d\u88ab\u4e0e\u5730\u9762\u7684\u6bd4\u7387\u3002&nbsp;&nbsp;", "3733a446c1ec3faa17649b44c50f597c": "<strong>\u5927\u8c46\u79cd\u690d\u9762\u79ef\uff1a</strong> \u6307 GFW \u4e0a\u7684<a href=\"{{0}}\">\u6b64\u6570\u636e\u5c42</a>\uff0c\u5b83\u63d0\u4f9b\u4e86\u5357\u7f8e\u6d32\u519c\u4e1a\u524d\u6cbf\u5730\u533a\u5927\u8c46\u6bcf\u5e74\u79cd\u690d\u9762\u79ef\u7684\u7a7a\u95f4\u6e05\u6670\u6982\u89c8\u3002&nbsp;", "cac3920ba6d3d677ab7e239025a05bff": "<strong>\u6811\u6728\u8986\u76d6\u589e\u52a0\uff1a</strong>\u5728\u4e4b\u524d\u6ca1\u6709\u6811\u6728\u8986\u76d6\u7684\u533a\u57df\uff0c\u6811\u6728\u51a0\u5c42\u7684\u5f62\u6210\u3002\u6811\u6728\u8986\u76d6\u7684\u589e\u52a0\u53ef\u80fd\u8868\u660e\u8bb8\u591a\u6f5c\u5728\u7684\u6d3b\u52a8\uff0c\u5305\u62ec\u5929\u7136\u6797\u751f\u957f\u6216\u4eba\u5de5\u6797\u7684\u4f5c\u7269\u8f6e\u4f5c\u5468\u671f\u3002\u56e0\u6b64\uff0c\u6811\u6728\u8986\u76d6\u7684\u589e\u52a0\u5e76\u4e0d\u7b49\u540c\u4e8e\u6062\u590d\u3002&nbsp; &nbsp;", "89676ef3eea8972b75e456ff31543925": "<strong>\u4eba\u5de5\u6797\uff1a</strong>\u4e3a\u751f\u4ea7\u6728\u6750\u548c\u6728\u7ea4\u7ef4\u800c\u79cd\u690d\u7684\u6811\u6728\u7fa4\u4f53\u3002&nbsp;&nbsp;", "fb786aff5b845f08fd62f59889a163aa": "<strong>\u521a\u679c\u76c6\u5730\u4f10\u6728\u9053\u8def\uff1a</strong>\u7528\u4e8e\u4fc3\u8fdb\u521a\u679c\u76c6\u5730\u4f10\u6728\u4f5c\u4e1a\u7684\u9053\u8def\u7f51\u3002&nbsp;&nbsp;", "01cdb24f4931d51738cb2f6ffda121ef": "<strong>\u68ee\u6797\u780d\u4f10\uff1a</strong>\u4ece\u68ee\u6797\u5230\u53e6\u4e00\u79cd\u571f\u5730\u8986\u76d6\u6216\u571f\u5730\u5229\u7528\u7c7b\u578b\u7684\u8f6c\u53d8\uff0c\u4f8b\u5982\u68ee\u6797\u8f6c\u53d8\u4e3a\u79cd\u690d\u56ed\u6216\u68ee\u6797\u8f6c\u53d8\u4e3a\u57ce\u5e02\u533a\u57df\u3002&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;", "d6b80ce7e1de1c6fb0d0b99fbd7753c0": "<strong>DIST-ALERT\uff08\u6270\u52a8\u8b66\u62a5\uff09\uff1a</strong>\u6307 GFW \u4e0a\u7684\u8fd9\u4e2a\u8b66\u62a5\u5c42\uff0c\u5b83\u663e\u793a\u5168\u7403\u6240\u6709\u690d\u88ab\u6270\u52a8\u7684\u8fd1\u65f6\u4fe1\u606f\u3002&nbsp;", "e41977d8ba0838d7d8d8b08b00e683e1": "<strong>\u7279\u6709\u9e1f\u533a\uff1a</strong>\u6307 GFW \u4e0a\u7684<a href=\"{{0}}\">\u8fd9\u4e2a\u6570\u636e\u5c42</a>\uff0c\u5b83\u663e\u793a\u4e24\u79cd\u6216\u4e24\u79cd\u4ee5\u4e0a\u7279\u6709\u9e1f\u7c7b\u7684\u5730\u7406\u5206\u5e03\u8303\u56f4\u3002&nbsp;&nbsp;", "a8ecd9386495d2abea41fe413665b89a": "<strong>\u65b0\u5174\u70ed\u70b9\uff1a</strong>\u6307 GFW \u4e0a\u7684<a href=\"{{0}}\">\u8fd9\u4e2a\u6570\u636e\u5c42</a>\uff0c\u5b83\u8bc6\u522b\u56fd\u5bb6\u5c42\u9762\u57fa\u7840\u4e0a\u7684\u663e\u8457\u68ee\u6797\u635f\u5931\u805a\u96c6\u533a\u57df\u3002&nbsp;&nbsp;", "712fce674e70ef5094536acaf8c5172b": "<strong>\u68ee\u6797\u53d8\u5316\uff1a</strong>\u68ee\u6797\u8986\u76d6\u968f\u65f6\u95f4\u7684\u53d8\u5316\uff0c\u5305\u62ec\u635f\u5931\uff08\u53ef\u80fd\u5305\u62ec\u6c38\u4e45\u6027\u6216\u6682\u65f6\u6027\u635f\u5931\uff09\u548c\u589e\u957f\u3002&nbsp;", "84bbf8a469aabf2b19751c89a1c7aa5d": "<strong>\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\uff1a</strong>\u7531\u6797\u5206\u66ff\u4ee3\u68ee\u6797\u5e72\u6270\u4ea7\u751f\u7684\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u3002&nbsp;&nbsp;", "4cbfccd875e4f5757749de367cc53997": "<strong>\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u51c0\u901a\u91cf</strong>\uff1a\u68ee\u6797\u91ca\u653e\u7684\u6e29\u5ba4\u6c14\u4f53\u4e0e\u5438\u6536\u7684\u4e8c\u6c27\u5316\u78b3\u4e4b\u95f4\u7684\u5dee\u503c\u3002\u51c0\u901a\u91cf\u53ef\u4ee5\u662f\u6b63\u503c\uff08\u51c0\u6e90\uff0c\u5411\u5927\u6c14\u4e2d\u589e\u52a0\u6e29\u5ba4\u6c14\u4f53\uff09\u6216\u8d1f\u503c\uff08\u51c0\u6c47\uff0c\u4ece\u5927\u6c14\u4e2d\u5438\u6536\u4e8c\u6c27\u5316\u78b3\uff09\u3002&nbsp;", "4cc2ce8eced122df14680e1376b099cc": "<strong>Forest Watcher\uff1a</strong>\u4e00\u4e2a\u79fb\u52a8\u548c\u7f51\u9875\u5e94\u7528\u7a0b\u5e8f\uff0c\u65e8\u5728\u5c06 GFW \u7684\u5728\u7ebf\u68ee\u6797\u76d1\u6d4b\u548c\u8b66\u62a5\u7cfb\u7edf\u5e26\u5230\u79bb\u7ebf\u73af\u5883\u4e2d\u5e76\u5e94\u7528\u4e8e\u5b9e\u5730\u3002&nbsp;", "2b31827b7248665945b34daa67b0e99c": "<strong>\u516c\u9877 (Ha)\uff1a</strong>\u4e00\u516c\u9877\u7b49\u4e8e 10000 \u5e73\u65b9\u7c73\u30012.47 \u82f1\u4ea9\u6216 0.01 \u5e73\u65b9\u516c\u91cc\u3002&nbsp; \u68ee\u6797\u76d1\u6d4b\u4e2d\u5e38\u7528\u7684\u5355\u4f4d\u5305\u62ec\u5343\u516c\u9877 (Kha) &nbsp; \u6216\u767e\u4e07\u516c\u9877 (Mha)\u3002&nbsp;", "dcaf62fdd7d85e86a30f49ecaf5b2af0": "<strong>\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730\uff1a</strong>\u539f\u4f4f\u6c11\u571f\u5730\u6307\u7531\u539f\u4f4f\u6c11\u96c6\u4f53\u62e5\u6709\u548c\u7ba1\u7406\u7684\u571f\u5730\u3002\u65e0\u8bba\u8fd9\u79cd\u7ba1\u8f96\u6743\u662f\u5426\u5f97\u5230\u56fd\u5bb6\u6cd5\u5f8b\u7684\u8ba4\u53ef\u3002GFW \u663e\u793a<a href=\"{{0}}\">LandMark \u7684\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730\u6570\u636e\u96c6\u3002</a>&nbsp;", "26eba5bfa3c9dd1e4c666f198b7fdcce": "<strong>\u5173\u952e\u751f\u7269\u591a\u6837\u6027\u533a\u57df\uff1a</strong>\u6839\u636e\u4e16\u754c\u81ea\u7136\u4fdd\u62a4\u8054\u76df (IUCN) \u53d1\u5e03\u7684\u5168\u7403\u6807\u51c6\u5316\u6807\u51c6\uff0c\u88ab\u786e\u5b9a\u4e3a\u5728\u751f\u7269\u591a\u6837\u6027\u4fdd\u62a4\u65b9\u9762\u5177\u6709\u56fd\u9645\u91cd\u8981\u6027\u7684\u5730\u7406\u533a\u57df\u3002&nbsp;", "4c9e779a30f4bb0434679703464a38dd": "<strong>\u4e3b\u8981\u6c34\u575d\uff1a</strong>\u6307 GFW \u4e0a\u7684<a href=\"{{0}}\">\u8fd9\u4e2a\u6570\u636e\u5c42</a>\uff0c\u663e\u793a\u5168\u7403 50 \u4e2a\u4e3b\u8981\u6cb3\u6d41\u6d41\u57df\u4e2d\u6c34\u575d\u7684\u4f4d\u7f6e\u3002&nbsp;", "9b562535d33f1e1256f3507beccf4f90": "<strong>\u7ea2\u6811\u6797\uff1a</strong>\u7ea2\u6811\u6797\u662f\u4e00\u79cd\u72ec\u7279\u7684\u751f\u6001\u7cfb\u7edf\uff0c\u5b83\u5728\u9646\u5730\u4e0e\u6d77\u6d0b\u7684\u4ea4\u754c\u5904\u7e41\u8302\u751f\u957f\u3002\u7ea2\u6811\u6797\u7279\u522b\u9002\u5e94\u76d0\u6c34\u548c\u534a\u54b8\u6c34\u73af\u5883\uff0c\u5206\u5e03\u5728\u70ed\u5e26\u548c\u4e9a\u70ed\u5e26 123 \u4e2a\u56fd\u5bb6\u7684\u6d77\u5cb8\u548c\u6cb3\u53e3\u3002&nbsp;&nbsp; &nbsp;", "608e46347e307268c8f50dc1f9dde82f": "\u663e\u793a\u7531\u653f\u5e9c\u5212\u62e8\u7ed9\u79c1\u8425\u516c\u53f8\u7528\u4e8e\u79cd\u690d\u4eba\u5de5\u6797\u7684\u533a\u57df\u8fb9\u754c\uff0c\u8fd9\u4e9b\u4eba\u5de5\u6797\u7528\u4e8e\u751f\u4ea7\u6728\u6750\u548c\u7eb8\u6d46\uff0c\u4ee5\u5236\u9020\u7eb8\u5f20\u548c\u7eb8\u5236\u54c1", "a90481c55e66e90017637f662f048c4b": "\u6728\u6750\u7ea4\u7ef4\u7279\u8bb8\u7ecf\u8425\u533a&nbsp;", "4944969076118f221dfa319a3ba7fde0": "\u76ee\u524d\u9002\u7528\u4e8e\u5370\u5ea6\u5c3c\u897f\u4e9a\u3001\u521a\u679c\u5171\u548c\u56fd\u548c\u7802\u62c9\u8d8a\uff08\u9a6c\u6765\u897f\u4e9a\uff09&nbsp;", "e42b9604c5a2cc876853870f5eb4efc6": "\u4fdd\u62a4\u533a\u4fdd\u62a4\u662f\u4fdd\u62a4\u68ee\u6797\u3001\u963b\u6b62\u68ee\u6797\u780d\u4f10\u7684\u91cd\u8981\u6218\u7565\u3002\u4fdd\u62a4\u533a\u6570\u636e\u96c6\u663e\u793a\u4e86\u6839\u636e\u56fd\u5bb6\u3001\u5dde\u6216\u4fdd\u62a4\u533a\u5212\u5b9a\u800c\u88ab\u5f52\u7c7b\u4e3a\u53d7\u6cd5\u5f8b\u4fdd\u62a4\u7684\u533a\u57df\u3002\u6570\u636e\u6536\u96c6\u81ea\u4e16\u754c\u4fdd\u62a4\u533a\u6570\u636e\u5e93\uff0c\u6765\u6e90\u5305\u62ec\u653f\u5e9c\u3001\u975e\u653f\u5e9c\u7ec4\u7ec7\u548c\u56fd\u9645\u79d8\u4e66\u5904\u3002&nbsp;", "4059b0251f66a18cb56f544728796875": "\u4fe1\u606f", "8564fa258c94ee5262c0b74ff0685cb5": "\u4f10\u6728\u9053\u8def\u548c\u5927\u578b\u6c34\u575d\u9879\u76ee\u7b49\u57fa\u7840\u8bbe\u65bd\u9879\u76ee\u6709\u65f6\u662f\u780d\u68ee\u6797\u4f10\u7684\u7b2c\u4e00\u6b65\u3002\u8fd9\u4e9b\u9879\u76ee\u53ef\u80fd\u4f4d\u4e8e\u504f\u8fdc\u5730\u533a\uff0c\u56e0\u6b64\u96be\u4ee5\u76d1\u6d4b\u3002\u57fa\u7840\u8bbe\u65bd\u6570\u636e\u96c6\u63d0\u4f9b\u4e86\u57fa\u7840\u8bbe\u65bd\u9879\u76ee\u7684\u4f4d\u7f6e\uff0c\u4ee5\u4fbf\u9884\u6d4b\u548c\u76d1\u6d4b\u9644\u8fd1\u68ee\u6797\u7684\u53d8\u5316&nbsp;", "197af6190310024ae7a0190abd47baf6": "\u4e3b\u8981\u6c34\u575d", "f34d302b2422fd2f4f42dd4ee06456ac": "\u8bb8\u591a\u539f\u4f4f\u6c11\u548c\u5176\u4ed6\u5f53\u5730\u793e\u533a\u662f\u68ee\u6797\u53ef\u6301\u7eed\u7ba1\u7406\u7684\u5173\u952e\uff0c\u4f46\u4ed6\u4eec\u5f88\u96be\u5f97\u5230\u6cd5\u5f8b\u627f\u8ba4\u4ed6\u4eec\u62e5\u6709\u548c\u4f7f\u7528\u8fd9\u4e9b\u571f\u5730\u7684\u6743\u5229\u3002\u4eba\u7c7b\u6570\u636e\u96c6\u53ef\u8ba9\u4eba\u4eec\u4e86\u89e3\u539f\u4f4f\u6c11\u5c45\u6c11\u548c\u5f53\u5730\u793e\u533a\u62e5\u6709\u548c\u4f7f\u7528\u7684\u571f\u5730\uff0c\u4ee5\u53ca\u4ed6\u4eec\u5728\u54ea\u4e9b\u5730\u65b9\u6709\u6743\u4f7f\u7528\u67d0\u4e9b\u7c7b\u578b\u7684\u81ea\u7136\u8d44\u6e90\u3002\u6211\u4eec\u8fd8\u5305\u62ec\u4e86\u4e00\u4e2a\u4eba\u53e3\u6570\u636e\u5c42\uff0c\u8ba9\u7528\u6237\u4e86\u89e3\u5168\u7403\u4eba\u53e3\u7684\u5206\u5e03\u548c\u5bc6\u5ea6\u3002&nbsp;", "aa06860007cf0ae01b62d884a4d1a10a": "\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730&nbsp;", "790af2ed34195f63299e66f046e153ff": "\u63cf\u7ed8\u4e16\u754c\u5404\u5730\u9009\u5b9a\u56fd\u5bb6\u7684\u539f\u4f4f\u6c11\u548c\u793e\u533a\u571f\u5730\uff0c\u5e76\u6309\u6cd5\u5f8b\u8ba4\u53ef\u72b6\u6001\u5206\u7c7b&nbsp;", "153fbc1f7bd65d6d333c5ad5541aeceb": "\u76ee\u524d\u53ef\u7528\u4e8e\u963f\u5bcc\u6c57\u3001\u5b89\u63d0\u74dc\u548c\u5df4\u5e03\u8fbe\u3001\u963f\u6839\u5ef7\u3001\u6fb3\u5927\u5229\u4e9a\u3001\u4f2f\u5229\u5179\u3001\u54e5\u65af\u8fbe\u9ece\u52a0\u3001\u8428\u5c14\u74e6\u591a\u3001\u5371\u5730\u9a6c\u62c9\u3001\u6d2a\u90fd\u62c9\u65af\u3001\u58a8\u897f\u54e5\u3001\u5c3c\u52a0\u62c9\u74dc\u3001\u5df4\u62ff\u9a6c\u3001\u73bb\u5229\u7ef4\u4e9a\u3001\u535a\u8328\u74e6\u7eb3\u3001\u5df4\u897f\u3001\u67ec\u57d4\u5be8\u3001\u52a0\u62ff\u5927\u3001\u667a\u5229\u3001\u54e5\u4f26\u6bd4\u4e9a\u3001\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u3001\u5384\u74dc\u591a\u5c14\u3001\u6cd5\u5c5e\u572d\u4e9a\u90a3\u3001\u683c\u9675\u5170\u3001\u572d\u4e9a\u90a3\u3001\u5370\u5ea6\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u3001\u4f0a\u6717\u3001\u7231\u5c14\u5170\u3001\u80af\u5c3c\u4e9a\u3001\u9a6c\u6765\u897f\u4e9a\u3001\u58a8\u897f\u54e5\u3001\u83ab\u6851\u6bd4\u514b\u3001\u7eb3\u7c73\u6bd4\u4e9a\u3001\u5c3c\u6cca\u5c14\u3001\u65b0\u897f\u5170\u3001\u5c3c\u52a0\u62c9\u74dc\u3001\u5df4\u62c9\u572d\u3001\u79d8\u9c81\u3001\u83f2\u5f8b\u5bbe\u3001\u5357\u975e\u3001\u897f\u73ed\u7259\u3001\u82cf\u91cc\u5357\u3001\u53f0\u6e7e\u3001\u5766\u6851\u5c3c\u4e9a\u3001\u82f1\u56fd\u3001\u7f8e\u56fd\u3001\u59d4\u5185\u745e\u62c9\u3001\u8d5e\u6bd4\u4e9a\u548c\u6d25\u5df4\u5e03\u97e6", "0e751d556b7cf8fe39c6e4c072c28af0": "\u76ee\u524d\u9002\u7528\u4e8e\u5580\u9ea6\u9686\u3001\u8d64\u9053\u51e0\u5185\u4e9a\u3001\u5229\u6bd4\u91cc\u4e9a\u548c\u7eb3\u7c73\u6bd4\u4e9a&nbsp;", "ad8ac74246e80fa89efcb05c666991da": "\u4eba\u53e3\u5bc6\u5ea6-2015&nbsp;", "b20c3e2c4d14d95a2b3eec5f54797505": "\u663e\u793a\u68ee\u6797\u53d8\u5316\u5bf9\u5f53\u5730\u751f\u7269\u591a\u6837\u6027\u5b8c\u6574\u6027\u7684\u5f71\u54cd&nbsp;\n", "9af8e644ff65f81f9ed619aecb3c95bb": "<strong>\u7279\u8bb8\u7ecf\u8425\u533a\uff1a</strong>\u653f\u5e9c\u5206\u914d\u7ed9\u516c\u53f8\u7528\u4e8e\u7279\u5b9a\u7528\u9014\u7684\u533a\u57df\u3002\u4f8b\u5982\u4f10\u6728\u7279\u8bb8\u7ecf\u8425\u533a\u3001\u77f3\u6cb9\u548c\u5929\u7136\u6c14\u7279\u8bb8\u7ecf\u8425\u533a\u4ee5\u53ca\u91c7\u77ff\u7279\u8bb8\u7ecf\u8425\u533a\u3002", "1a4d5c031ab437fec809262cb452ae2c": "\u521a\u679c\u76c6\u5730\u4f10\u6728\u9053\u8def&nbsp;", "46acc0c90e3fbda86511db4b2a43d8ae": "\u663e\u793a\u521a\u679c\u76c6\u5730\u4f10\u6728\u9053\u8def\u7684\u5206\u5e03\u60c5\u51b5&nbsp;", "756274b30a650aa372cf759bade5ad04": "\u786e\u5b9a\u4e16\u754c 50 \u4e2a\u4e3b\u8981\u6cb3\u6d41\u6d41\u57df\u7684\u6c34\u575d\u4f4d\u7f6e&nbsp;", "ce2009da1811962e2ccbcdcd6c5de472": "\u8be5\u6570\u636e\u4ec5\u9650\u4e8e\u4e16\u754c 50 \u4e2a\u4e3b\u8981\u6cb3\u6d41\u6d41\u57df\uff0c\u5e76\u975e\u5168\u7403\u6027\u6570\u636e\u3002", "3822b9287de8895033f4a0e99beb9496": "\u968f\u7740\u65b0\u6570\u636e\u7684\u53ef\u7528&nbsp;", "54b236d347d4fc45cc70c17121f05289": "\u751f\u7269\u591a\u6837\u6027\u70ed\u70b9&nbsp;", "bf9535e472c51e09eefad727efb8c2d4": "<strong>\u706b\u707e\u8b66\u62a5\uff1a</strong>\u6307 GFW \u4e0a\u7684<a href=\"{{0}}\">\u8fd9\u4e2a\u8b66\u62a5\u56fe\u5c42</a>\uff0c\u5b83\u663e\u793a\u8fc7\u53bb 24 \u5c0f\u65f6\u300148 \u5c0f\u65f6\u300172 \u5c0f\u65f6\u6216 7 \u5929\u7684 VIIRS \u6d3b\u8dc3\u706b\u707e\u6570\u636e\u3002&nbsp;&nbsp;", "c73e70c6720829a40ecf54306d51b4f5": "<strong>\u68ee\u6797\uff1a</strong>\u6811\u51a0\u5bc6\u5ea6\u5927\u4e8e 30% \u4e14\u6811\u9ad8\u8d85\u8fc7 5 \u7c73\u7684\u6811\u6728\u8986\u76d6\u533a\u57df\uff0c\u57fa\u4e8e 30 \u7c73\u5206\u8fa8\u7387\u7684 Landsat \u536b\u661f\u5f71\u50cf\u7ed8\u5236\u3002&nbsp; &nbsp;", "53bfa73654b789eb5edb7bc8cd19ce72": "<strong>\u68ee\u6797\u78b3\u6e05\u9664\u91cf</strong>\uff1a\u68ee\u6797\u5728\u4e00\u6bb5\u65f6\u95f4\u5185\u4ece\u5927\u6c14\u4e2d\u6e05\u9664\u7684\u78b3\u91cf\u3002&nbsp;", "5f9e1afb4900f08d108593828478313c": "<strong>\u68ee\u6797\u666f\u89c2\u5b8c\u6574\u6027\u6307\u6570</strong>\uff1a\u4ee5\u4eba\u7c7b\u6d3b\u52a8\u5bf9\u68ee\u6797\u7684\u6539\u53d8\u7a0b\u5ea6\u6765\u8861\u91cf\u68ee\u6797\u72b6\u51b5\u7684\u4e00\u4e2a\u5e74\u5ea6\u5168\u7403\u6027\u6307\u6570\u3002&nbsp;", "79081c910bd9f0ce6422471b02da6304": "<strong>GIS\uff1a</strong>\u5730\u7406\u4fe1\u606f\u7cfb\u7edf\uff08GIS\uff09\uff0c\u4e00\u79cd\u5b58\u50a8\u3001\u7ba1\u7406\u3001\u5206\u6790\u548c\u663e\u793a\u5730\u7406\u6570\u636e\u7684\u8ba1\u7b97\u673a\u7cfb\u7edf\u3002\u5e38\u7528\u4e8e GIS \u5206\u6790\u7684\u8f6f\u4ef6\u5305\u62ec Esri \u7684 ArcGIS \u5957\u4ef6\u548c\u5f00\u6e90 GIS \u8f6f\u4ef6 QGIS\u3002&nbsp;&nbsp;", "70859a465e98e6fa3e9d0166cb12f85f": "<strong>Global Forest Review (GFR)\uff1a</strong>\u7531\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240 (WRI) \u5236\u4f5c\u7684\u4e00\u4efd\u52a8\u6001\u62a5\u544a\uff0c\u63d0\u4f9b\u7ecf\u8fc7\u540c\u884c\u8bc4\u5ba1\u7684\u5206\u6790\u548c\u89c1\u89e3\uff0c\u57fa\u4e8e\u6709\u5173\u4e16\u754c\u68ee\u6797\u72b6\u51b5\u7684\u6700\u4f73\u53ef\u7528\u5730\u7406\u7a7a\u95f4\u6570\u636e\u751f\u6210\uff0c\u4ee5\u4fbf\u4e3a\u5168\u7403\u81f4\u529b\u4e8e\u4fdd\u62a4\u548c\u6062\u590d\u4e16\u754c\u5404\u5730\u68ee\u6797\u7684\u793e\u533a\u63d0\u4f9b\u652f\u6301\u3002&nbsp;&nbsp;&nbsp;", "2ba27fddfa179d5482c1b60def542280": "<strong>\u5730\u56fe\u4e0e\u9762\u677f\uff1a</strong>GFW \u7684\u5730\u56fe\u548c\u9762\u677f\u5141\u8bb8\u7528\u6237\u901a\u8fc7\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u56fe\u5f62\u53ef\u89c6\u5316\u7a7a\u95f4\u6570\u636e\u96c6\u3001\u8fdb\u884c\u5206\u6790\u5e76\u67e5\u770b\u7edf\u8ba1\u6570\u636e\u3002&nbsp;&nbsp;", "fab05e2db73a4828d7663d58a57c07b0": "<strong>\u6f5c\u5728\u78b3\u589e\u91cf</strong>\uff1a\u6b64\u6570\u636e\u4f30\u7b97\u4e86\u81ea\u7136\u518d\u751f\u7684\u5e74\u8f7b\u68ee\u6797\u5728\u91cd\u65b0\u751f\u957f\u7684\u524d 30 \u5e74\u5185\u4ece\u5927\u6c14\u4e2d\u6355\u83b7\u78b3\u5e76\u4ee5\u5730\u4e0a\u6d3b\u751f\u7269\u91cf\u7684\u5f62\u5f0f\u50a8\u5b58\u78b3\u7684\u901f\u7387\u3002&nbsp;&nbsp;", "35baf3c7e8d1e22a81cdb510396d1504": "\u7814\u7a76\u4eba\u5458\u3001\u653f\u7b56\u5236\u5b9a\u8005\u3001\u975e\u8425\u5229\u7ec4\u7ec7\u3001\u5730\u65b9\u4fdd\u62a4\u7ec4\u7ec7\u3001\u516c\u53f8\u4ee5\u53ca\u5176\u4ed6\u5bf9\u76d1\u6d4b\u5168\u7403\u68ee\u6797\u78b3\u52a8\u6001\u611f\u5174\u8da3\u7684\u4eba\u58eb\u90fd\u5728\u4f7f\u7528 GFW \u7684\u6c14\u5019\u6570\u636e\u3002\u6c14\u5019\u6570\u636e\u53ef\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\"> GFW \u5730\u56fe</a>\u4e0a\u5728\u7ebf\u67e5\u770b\uff0c\u4e5f\u53ef\u5728<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\"> GFW \u5f00\u653e\u6570\u636e\u95e8\u6237</a>\u4e0a\u4e0b\u8f7d\u3002\u8bf7\u63a2\u7d22\u4ee5\u4e0b\u6211\u4eec\u6700\u53d7\u6b22\u8fce\u7684\u6570\u636e\u96c6\uff0c\u4ee5\u4fbf\u5f00\u59cb\u4f7f\u7528\u3002&nbsp;", "da1639359a16cd1ac4621a07521e9816": "\u78b3\u901a\u91cf\uff1a\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u3001\u78b3\u6e05\u9664\u91cf\u3001\u6e29\u5ba4\u6c14\u4f53\u51c0\u901a\u91cf", "4e70906be64e3b898d2ca91d0d17a240": "\u8981\u5f00\u59cb\uff0c\u60a8\u53ef\u4ee5\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\"> GFW \u5730\u56fe</a>\u6216<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\"> GFW \u9762\u677f</a>\u4e0a\u63a2\u7d22\u6b64\u6570\u636e\u96c6\uff0c\u4ee5\u67e5\u770b 2000 \u5e74\u5168\u7403\u4ee5\u6811\u6728\u751f\u7269\u91cf\u5f62\u5f0f\u50a8\u5b58\u7684\u78b3\u5206\u5e03\u60c5\u51b5\u3002\u6b64\u6570\u636e\u96c6\u4e5f\u53ef\u5728<a href=\"{{2}}\" target=\"_blank\" rel=\"noreferrer noopener\"> GFW \u5f00\u653e\u6570\u636e\u95e8\u6237</a>\u4e0a\u4e0b\u8f7d\uff0c\u63d0\u4f9b\u4e24\u79cd\u4e0d\u540c\u7684\u5355\u4f4d\uff1a&nbsp;&nbsp;  ", "b4e1e070832ff77ce8c3d9b71008488f": "\u6bcf\u516c\u9877\u7684\u5730\u4e0a\u751f\u7269\u91cf\uff08AGB\uff09\u5146\u514b\u6570\uff1a\u9002\u7528\u4e8e\u53ef\u89c6\u5316 AGB \u5bc6\u5ea6\u5e76\u8ba1\u7b97\u611f\u5174\u8da3\u533a\u57df\u7684\u5e73\u5747 AGB \u5bc6\u5ea6\u3002&nbsp;", "4ae5c9e0cdeb15800c2f93e7bf3aeb36": "\u68ee\u6797\u5728\u751f\u957f\u8fc7\u7a0b\u4e2d\u5c06\u5927\u6c14\u4e2d\u7684\u4e8c\u6c27\u5316\u78b3\u8f6c\u5316\u4e3a\u5730\u4e0a\u751f\u7269\u91cf\u7684\u901f\u7387\u88ab\u79f0\u4e3a<em>\u78b3\u5c01\u5b58\u901f\u7387</em>\u6216<em>\u79fb\u9664\u56e0\u5b50</em>\uff0c\u5355\u4f4d\u4e3a\u5146\u514b\u78b3/\u516c\u9877/\u5e74\u3002\u68ee\u6797\u7684\u78b3\u5438\u6536\u7387\u53d6\u51b3\u4e8e\u591a\u79cd\u56e0\u7d20\uff0c\u5982\u7269\u79cd\u3001\u5730\u533a\u3001\u6c14\u5019\u3001\u4e4b\u524d\u7684\u571f\u5730\u5229\u7528\u3001\u7ba1\u7406\u548c\u6797\u9f84\u3002&nbsp;", "fe5b8fc71c344ec94c19a28412db20a4": "\u6bcf\u5e74\u4e24\u6b21&nbsp;", "614afb4d9af3d7c5247b23442ae258ba": "<strong>\u6ce5\u70ad\u5730\uff1a</strong>\u4e00\u79cd\u72ec\u7279\u7684\u6e7f\u5730\u7c7b\u578b\uff0c\u5176\u7279\u5f81\u662f\u90e8\u5206\u8150\u70c2\u7684\u6709\u673a\u7269\u79ef\u7d2f\u5f62\u6210\u6ce5\u70ad\u5c42\u3002\u4ece\u67d0\u79cd\u610f\u4e49\u4e0a\u8bf4\uff0c\u6ce5\u70ad\u5730\u4ecb\u4e8e\u6e7f\u5730\u548c\u5b8c\u5168\u9646\u5730\u6816\u606f\u5730\u4e4b\u95f4\uff0c\u56e0\u4e3a\u5b83\u4eec\u901a\u5e38\u53ea\u6709\u6709\u9650\u7684\u79ef\u6c34\uff0c\u4f46\u5176\u8868\u9762\u5728\u5927\u90e8\u5206\u65f6\u95f4\u5185\u4e5f\u5904\u4e8e\u9971\u548c\u72b6\u6001\u3002&nbsp;&nbsp;&nbsp;", "c6784bb4fa8fb090fd25fa3e58988330": "<strong>\u5173\u6ce8\u5730\u70b9\uff1a</strong>\u6307 GFW \u4e0a\u7684<a href=\"{{0}}\">\u8fd9\u4e2a\u6570\u636e\u5c42</a>\uff0c\u5b83\u8bc6\u522b\u6307\u793a\u4e0a\u4e2a\u6708\u53ef\u80fd\u53d1\u751f\u68ee\u6797\u780d\u4f10\u4f4d\u7f6e\u7684\u9ad8\u4f18\u5148\u7ea7\u8b66\u62a5\u3002&nbsp;", "4cc1c0132885491ace68780cfbb8ecbe": "<strong>\u9065\u611f\uff1a</strong>\u9065\u611f\u662f\u6307\u4ece\u8fdc\u8ddd\u79bb\uff08\u901a\u5e38\u662f\u4ece\u98de\u673a\u6216\u536b\u661f\uff09\u83b7\u53d6\u7269\u4f53\u6216\u533a\u57df\u4fe1\u606f\u7684\u79d1\u5b66\u3002&nbsp;", "b4307ce2d8246e13eaec8fa07ef6980f": "<strong>\u6062\u590d\uff1a</strong>\u65e8\u5728\u6539\u5584\u9000\u5316\u666f\u89c2\u7684\u751f\u6001\u529f\u80fd\u5e76\u63d0\u5347\u4eba\u7c7b\u798f\u7949\u7684\u5e72\u9884\u63aa\u65bd\u3002\u666f\u89c2\u53ef\u4ee5\u662f\u68ee\u6797\u6216\u975e\u68ee\u6797\u533a\u57df\u3002&nbsp; &nbsp;", "3c38be034b029575b40b22115e6c1c90": "<strong>\u536b\u661f\u56fe\u50cf\uff1a</strong>\u5730\u7403\u8868\u9762\u7684\u53ef\u89c6\u5316\u6570\u636e\uff0c\u6765\u81ea\u73af\u7ed5\u5730\u7403\u8fd0\u884c\u7684\u536b\u661f\u3002&nbsp;", "25f5728c162f4b019162f3c964216a3a": "<strong>\u6811\u6728\u8986\u76d6\u635f\u5931\uff1a</strong> \u6811\u6728\u8986\u76d6\u7684\u79fb\u9664\u6216\u6b7b\u4ea1\uff0c\u8fd9\u53ef\u80fd\u662f\u7531\u4e8e\u591a\u79cd\u56e0\u7d20\u9020\u6210\u7684\uff0c\u5305\u62ec\u673a\u68b0\u91c7\u4f10\u3001\u706b\u707e\u3001\u75be\u75c5\u6216\u98ce\u66b4\u7834\u574f\u3002\u56e0\u6b64\uff0c\u635f\u5931\u5e76\u4e0d\u7b49\u540c\u4e8e\u68ee\u6797\u780d\u4f10\u3002&nbsp;&nbsp;&nbsp;&nbsp;", "9e8d00f19f9a8e04e999fa995208b6ac": "<strong>\u6309\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\u5212\u5206\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\uff1a</strong>\u6307 GFW \u4e0a\u7684\u8fd9\u4e2a\u6570\u636e\u5c42\uff0c\u5b83\u4f7f\u7528\u4ee5\u4e0b\u7c7b\u522b\u663e\u793a\u6bcf\u4e2a 10 \u516c\u91cc\u7f51\u683c\u5355\u5143\u5185\u5bfc\u81f4\u6811\u6728\u8986\u76d6\u635f\u5931\u7684\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\uff1a\u5546\u54c1\u9a71\u52a8\u7684\u68ee\u6797\u780d\u4f10\u3001\u519c\u4e1a\u3001\u6797\u4e1a\u3001\u91ce\u706b\u548c\u57ce\u5e02\u5316\u3002&nbsp;&nbsp;", "979d4609cd87f9847888d8ce92b36c6f": "<strong>\u6728\u7ea4\u7ef4\u7279\u8bb8\u7ecf\u8425\u533a\uff1a</strong> \u6307 <a href=\"{{0}}\">GFW \u4e0a\u7684\u6b64\u6570\u636e\u5c42</a>\uff0c\u5b83\u663e\u793a\u653f\u5e9c\u5206\u914d\u7ed9\u79c1\u8425\u516c\u53f8\u7528\u4e8e\u4eba\u5de5\u6797\u7684\u533a\u57df\u8fb9\u754c\uff0c\u8fd9\u4e9b\u4eba\u5de5\u6797\u4e3b\u8981\u7528\u4e8e\u751f\u4ea7\u7eb8\u53ca\u7eb8\u5236\u54c1\u6240\u4f7f\u7528\u7684\u6728\u6750\u548c\u6728\u6d46\u3002&nbsp;", "e6f32ff0e416cbe5b018c0c2b78d27ed": "\u663e\u793a\u6839\u636e\u5404\u79cd\u5212\u5b9a<br>(\u5982\u56fd\u5bb6\u516c\u56ed\u3001\u5dde\u7ea7\u4fdd\u62a4\u533a\u3001\u91ce\u751f\u52a8\u7269\u4fdd\u62a4\u533a\u7b49)\u800c\u53d7\u6cd5\u5f8b\u4fdd\u62a4\u7684\u533a\u57df\uff0c\u5e76\u5bf9\u5176\u8fdb\u884c\u7ba1\u7406\u4ee5\u5b9e\u73b0\u4fdd\u62a4\u76ee\u6807&nbsp;", "427fb2c23377de0555781c52dd121df7": "<strong>\u78b3\u901a\u91cf</strong>\uff1a\u5229\u7528\u6211\u4eec\u7684\u5730\u7406\u7a7a\u95f4\u68ee\u6797\u78b3\u901a\u91cf\u76d1\u6d4b\u6846\u67b6 (Harris et al. 2021) \u751f\u6210\u7684\u6570\u636e\u96c6\uff0c\u8ddf\u8e2a\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\uff08GHG\uff09\u7684\u6392\u653e\u3001\u6e05\u9664\uff08\u5c01\u5b58\uff09\u548c\u51c0\u901a\u91cf\u3002\u8be5\u6570\u636e\u81ea 2001 \u5e74\u8d77\u4ee5\u7ea6 30 \u7c73\u7684\u5206\u8fa8\u7387\u8ddf\u8e2a\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf\uff0c\u5e76\u6bcf\u5e74\u66f4\u65b0\u3002 &nbsp;", "4f9a8310ee48cd60e1899bb7bda77224": "<strong>\u78b3\u5bc6\u5ea6</strong>\uff1a\u6b64\u6570\u636e\u663e\u793a 2000 \u5e74\u5730\u4e0a\u6d3b\u6728\u8d28\u751f\u7269\u91cf\u7684\u5bc6\u5ea6\uff0c\u53ef\u7528\u4e8e\u63a8\u7b97\u78b3\u50a8\u91cf\u3002\u5b83\u662f\u672c\u4e16\u7eaa\u521d\u78b3\u50a8\u5b58\u7684\u4e00\u4e2a\u6709\u7528\u57fa\u51c6\u3002&nbsp;&nbsp;", "44997b8fa82ef513a80b55398f4f9a17": "<strong>\u6e05\u9664\u91cf</strong>\u662f\u901a\u8fc7\u5c06\u68ee\u6797\u8986\u76d6\u8303\u56f4\u548c\u68ee\u6797\u589e\u957f\u6570\u636e\u4e0e\u4e0d\u540c\u68ee\u6797\u7c7b\u578b\u7684\u78b3\u79ef\u7d2f\u901f\u7387\u53e0\u52a0\u5f97\u51fa\u7684\u3002&nbsp; ", "c814a0cd734a19e3d04b2dd7dbc51b60": "\u8fd9\u5f20<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5168\u7403\u5730\u56fe</a>\u4f30\u7b97\u4e86\u81ea\u7136\u518d\u751f\u68ee\u6797\u5728\u524d 30 \u5e74\u5185\u5730\u4e0a\u6d3b\u751f\u7269\u91cf\u4e2d\u78b3\u7684\u5c01\u5b58\u901f\u7387\uff0c\u4ee5\u8ba1\u7b97\u5e74\u8f7b\u6b21\u751f\u6797\u7684\u603b\u6e05\u9664\u91cf\u3002\u5b83\u662f\u901a\u8fc7\u6c47\u603b\u4e0d\u540c\u6797\u9f84\u7684\u5730\u4e0a\u751f\u7269\u91cf\u68ee\u6797\u6837\u5730\u6570\u636e\uff0c\u5e76\u5229\u7528\u673a\u5668\u5b66\u4e60\u5728\u5168\u7403\u8303\u56f4\u5185\u63d2\u503c\u751f\u957f\u901f\u7387\u800c\u5236\u4f5c\u7684\u3002\u5728<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\"> GFW \u5730\u56fe</a>\u4e0a\u63a2\u7d22\u6b64\u6570\u636e\u96c6\uff0c\u6216\u4ece<a href=\"{{2}}\" target=\"_blank\" rel=\"noreferrer noopener\">GFW \u5f00\u653e\u6570\u636e\u95e8\u6237</a>\u4e0b\u8f7d\u3002&nbsp;", "89bb5915431ec0253a06c10c2757c46f": "\u52a0\u62ff\u5927 2023 \u5e74\u7834\u7eaa\u5f55\u7684\u91ce\u706b\u91ca\u653e\u7684\u78b3\u91cf\u51e0\u4e4e\u662f\u5168\u7403\u822a\u7a7a\u4e1a\u7684 4 \u500d", "4f9dd040fcc696f34eff34c88b698432": "\u539f\u4f4f\u6c11\u68ee\u6797\u662f\u4e9a\u9a6c\u900a\u5730\u533a\u6700\u540e\u7684\u78b3\u6c47\u4e4b\u4e00", "ba66f76e10959d67d5848e886a3b21ad": "\u8fd9\u4e9b\u6570\u636e\u96c6\u5177\u6709\u4e0d\u540c\u7684\u7279\u70b9\u3001\u4f18\u52bf\u548c\u52a3\u52bf\uff0c\u53ef\u80fd\u5bf9\u4e0d\u540c\u7684\u7528\u6237\u4efb\u52a1\u5177\u6709\u4e0d\u540c\u7684\u9002\u7528\u6027\u3002\u7814\u7a76\u4eba\u5458\u3001\u653f\u7b56\u5236\u5b9a\u8005\u3001\u4fdd\u62a4\u4e3b\u4e49\u8005\u548c\u5176\u4ed6\u5229\u76ca\u76f8\u5173\u8005\u53ef\u4ee5\u4f7f\u7528\u8fd9\u4e9b\u6570\u636e\u96c6\uff0c\u505a\u51fa\u7b26\u5408\u4fdd\u62a4\u76ee\u6807\u7684\u660e\u667a\u51b3\u7b56\uff0c\u4e0e<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5168\u7403\u751f\u7269\u591a\u6837\u6027\u6846\u67b6</a>\u7684\u4fdd\u62a4\u76ee\u6807\u4e00\u81f4\uff0c\u8be5\u6846\u67b6\u65e8\u5728\u5230 2030 \u5e74\u904f\u5236\u5e76\u626d\u8f6c\u751f\u7269\u591a\u6837\u6027\u4e27\u5931\u7684\u8d8b\u52bf\u3002\u8bf7\u4ece\u63a2\u7d22\u4ee5\u4e0b\u6211\u4eec\u7684\u751f\u7269\u591a\u6837\u6027\u6570\u636e\u96c6\u6765\u5f00\u59cb\u5427\u3002&nbsp;&nbsp;&nbsp;", "c71b65d3fbb89d6a265344a7e915c732": "\u5168\u7403\u68ee\u6797\u751f\u7269\u7fa4\u843d&nbsp;", "fb02880d518429a88c3d43c22247b730": "\u96f6\u706d\u7edd\u8054\u76df\u5730\u70b9&nbsp;", "b9023ff47ca6fa49809acb2e0f68793d": "\u5168\u7403\uff0c\u6240\u6709\u56fd\u5bb6\uff0c\u9646\u5730\u3001\u6de1\u6c34\u548c\u6d77\u6d0b\u3002&nbsp;", "72ac45db30a829022265333499de7cff": "\u540c\u4e8b", "658f3f8ab5702cb07bfa9c0ca70581ab": "\u975e\u6d32\u6c34\u5229\u8bb0\u8005 (Water Journalists Africa) \u5f00\u5c55\u7684 InfoNile \u8ba1\u5212\u5c06\u5bf9\u6765\u81ea InfoNile/WJA \u7684\u8bb0\u8005\u5f00\u5c55\u57f9\u8bad\uff0c\u63d0\u4f9b\u652f\u6301\u2026\u2026", "cafc1f9807ac9278903ec63339e3fff6": "\u4e16\u754c\u81ea\u7136\u4fdd\u62a4\u77e5\u8bc6\u5e93 (Knowledge for World Conservation, KWC) \u5c06\u81f4\u529b\u4e8e\u63d0\u9ad8\u68ee\u6797\u548c\u793e\u533a\u2026\u2026", "301ee977a11854c2f8fb6763e0774f4a": "\u9ea6\u5fb7\u6797\u690d\u7269\u56ed (Medellin Botanical Garden) \u5c06\u7ee7\u7eed\u81f4\u529b\u4e8e\u89e3\u51b3\u54e5\u4f26\u6bd4\u4e9a\u67d0\u5730\u533a\u7684\u68ee\u6797\u6ee5\u4f10\u95ee\u9898\u2026\u2026", "6025b89ec3cd330aae958c9eb8b5836d": "\u68ee\u6797\u8d8b\u52bf (Forest Trend) \u4e0e\u81ea\u7136\u8d44\u6e90\u548c\u73af\u5883\u90e8\u5408\u4f5c (MO\u2026\u2026", "08b031aca82b66337ba71851930134f7": "\u73bb\u5229\u7ef4\u4e9a\u68ee\u6797\u8c03\u67e5\u7814\u7a76\u6240 (Instituto Boliviano de Investigacion Forestal, IBIF) \u5c06\u4e0e\u74dc\u62c9\u7ea6\u65af\u539f\u4f4f\u6c11\u5408\u4f5c\u2026\u2026", "3612faef5c369e588cf4bc8d3b99333e": "\u5728\u79d8\u9c81\uff0c\u5171\u540c\u5229\u76ca\u7814\u7a76\u6240 (Instituto del Bien Comun, IBC) \u5c06\u4e0e\u4e24\u6240\u539f\u4f4f\u6c11\u8054\u76df\u548c\u56fd\u5bb6\u2026\u2026", "d0e49d48c831b1e7d6f71e6d08caec9f": "Fundaci\u00f3n para la Conservaci\u00f3n de los Andes Tropicales (FCAT) \u65e8\u5728\u5f7b\u5e95\u53d8\u9769\u68ee\u6797\u6ee5\u4f10\u2026\u2026", "89b02b459e9c5868f8b9dc459ed37da8": "\u8be5\u9879\u76ee\u5c06\u81f4\u529b\u4e8e\u63d0\u9ad8\u516c\u4f17\u610f\u8bc6\uff0c\u589e\u5f3a\u5f53\u5730\u7ec4\u7ec7\u7684\u80fd\u529b\u2026\u2026", "87830068d6e2261a8dd9140abe4aa94d": "\u8fd9\u9879\u7531\u793e\u533a\u4e3b\u5bfc\u7684\u96e8\u6797\u76d1\u6d4b\u9879\u76ee\u5c06 Indigenous Peoples \u4e0e\u9065\u8fdc\u7684\u2026\u2026", "32768fbd5dda3f9c740f6848987057ff": "OGF \u5c06\u4e0e\u521a\u679c\u5171\u548c\u56fd\u5408\u4f5c\uff0c\u963b\u65ad\u975e\u6cd5\u4f10\u6728\uff0c\u5176\u65b9\u5f0f\u662f\u5efa\u7acb\u2026\u2026", "2a7dd7ccae60f435d715aabee4d8d528": "Asociacion Bosques del Mundo\uff0c\u53c8\u79f0 Forests of the World (FoW)\uff0c\u5c06\u4e0e\u4e24\u4e2a\u2026\u2026", "7a7e8921df75a3959b120ef900c9540f": "HAkA \u5c06\u8fc7\u53bb 6 \u5e74\u57f9\u8bad\u6d3b\u52a8\u7684\u57fa\u7840\u4e0a\uff0c\u4e13\u6ce8\u4e8e\u5bc6\u96c6\u5e94\u7528\u2026\u2026", "419693a232ae0e01a6ad14db1c14e6e3": "\u8be5\u9879\u76ee\u5c06\u4ee5 Hen Mpoano \u6b63\u5728\u8fdb\u884c\u7684 GFW \u8ba1\u5212\u4e3a\u57fa\u7840\uff0c\u8be5\u8ba1\u5212\u5df2\u6210\u529f\u5efa\u8bbe\u4e86\u2026\u2026", "5f7b7840a82a8de17d05d906ae83ce03": "Forest Watch \u5370\u5ea6\u5c3c\u897f\u4e9a\u7ad9\u7684\u76ee\u6807\u662f\u8ba9\u963f\u9c81\u7fa4\u5c9b\u81f3\u5c11 70% \u7684\u9762\u79ef\u6709\u690d\u88ab\u8986\u76d6\u2026\u2026", "dcbefae813ded6320f8e7e8ca1816e75": "\u751f\u6001\u53d1\u5c55\u57fa\u91d1 (EcoLogic Development Fund) \u5c06\u5728\u58a8\u897f\u54e5\u3001\u5371\u5730\u9a6c\u62c9\u548c\u6d2a\u90fd\u62c9\u65af\u57f9\u8bad\u5e76\u63d0\u9ad8\u2026\u2026", "75987c43345450dd71798f16b24aa260": "\u516c\u6c11\u54cd\u5e94 (Civic Response) \u6b63\u5728\u52a0\u7eb3\u7684\u82cf\u4f0a\u68ee\u6797\u4fdd\u62a4\u533a\u5f00\u5c55\u5de5\u4f5c\uff0c\u8fd9\u662f\u4e00\u4e2a\u751f\u7269\u591a\u6837\u6027\u7684\u70ed\u70b9\u5730\u533a\uff0c\u4ee5\u51cf\u5c11\u2026\u2026", "328d9770511c1a1cfae08311d1cc2100": "\u53ef\u6301\u7eed\u53d1\u5c55\u884c\u52a8\u7ec4\u7ec7 (Action for Sustainable Development) \u5c06\u5728 Mengam\u00e9 \u5927\u7329\u7329\u4fdd\u62a4\u533a\u5f00\u5c55\u5de5\u4f5c\u2026\u2026", "c3b7b73ba7b6420a3c78204dccfefa08": "COCOMASUR \u5c06\u5728\u54e5\u4f26\u6bd4\u4e9a\u7684 39,000 \u516c\u9877\u96c6\u4f53\u571f\u5730\u4e0a\u5f00\u5c55\u5de5\u4f5c\uff0c\u4ee5\u63d0\u9ad8\u6280\u672f\u2026\u2026", "2163f02cf238b2cfc488c0a5b7f2da06": "\u5728\u8be5\u9879\u76ee\u4e2d\uff0c\u81ea\u7136\u4fdd\u62a4\u4e0e\u53d1\u5c55\u4e2d\u5fc3 (Center for Nature Conservation and Development) \u5c06\u652f\u6301\u6797\u4e1a\u90e8\u95e8\u2026\u2026", "50a1057c942631d32df6cd58cb884145": "Ajemalebu\u81ea\u52a9\u7ec4\u7ec7 (Ajemalebu Self Help, AJESH) \u5c06\u5efa\u8bbe\u57f9\u517b\u793e\u533a\u7684\u68ee\u6797\u76d1\u6d4b\u80fd\u529b\u2026\u2026", "a086f4eec1adcc5eb190700d32c54bcc": "\u72ec\u7acb\u68ee\u6797\u76d1\u6d4b\u57fa\u91d1\u4f1a - \u5370\u5ea6\u5c3c\u897f\u4e9a\u72ec\u7acb\u6797\u4e1a\u76d1\u6d4b\u57fa\u91d1\u4f1a (YPIKI-IFMF) \u5c06\u81f4\u529b\u4e8e\u5efa\u8bbe\u68ee\u6797\u76d1\u6d4b\u7ad9\u548c\u516c\u6c11\u793e\u4f1a\u4e3b\u5bfc\u7684\u72ec\u7acb\u2026\u2026", "05c71b193a0fa11e2ed0eb0cfb52779d": "\u5370\u5c3c\u56fd\u9645\u52a8\u7269\u6551\u63f4\u57fa\u91d1\u4f1a (Yayasan IAR Indonesia, YIARI) \u5c06\u81f4\u529b\u4e8e\u52a0\u5f3a\u6960\u699c\u7701\u3001\u82cf\u95e8\u7b54\u814a\u4ee5\u53ca\u897f\u2026\u2026", "1c03b49aa89b083220538e8b0ce843df": "ORPIO \u5c06\u4e0e\u5f53\u5730\u539f\u4f4f\u6c11\u8054\u76df FECONATIYA \u5408\u4f5c\u5efa\u8bbe\u4ed6\u4eec\u7684\u2026\u2026", "86801e52709fe96944a630416b7d6338": "IKIAM \u5c06\u53d1\u5c55\u68ee\u6797\u76d1\u6d4b\u80fd\u529b\u5e76\u5efa\u7acb\u5feb\u901f\u54cd\u5e94\u7a0b\u5e8f\uff0c\u4ee5\u2026\u2026", "830f4e882aa4a54f595eae9af1eb31b4": "Iniciativa Clim\u00e1tica de M\u00e9xico \u5c06\u5f00\u53d1\u4e00\u6b3e\u6570\u5b57\u5e73\u53f0\uff0c\u7528\u4ee5\u5206\u6790\u548c\u4f20\u64ad\u2026\u2026", "1e45168224b85eb291a37f8f7d4fa644": "OGF \u5c06\u4e0e GFW \u5e73\u53f0\u7684\u4fe1\u606f\u548c\u53ef\u7528\u6570\u636e\u534f\u540c\u548c\u4e92\u8865\u2026\u2026", "e481be2f0e4056298e5071999fa30ffb": "MNS \u5c06\u4e0e\u4ed6\u4eec\u7684\u516c\u6c11\u79d1\u5b66\u7f51\u7edc\u5408\u4f5c\uff0c\u5c06 Forest Watcher \u7528\u4f5c\u4e00\u6b3e\u4e3b\u8981\u7684\u5b9e\u5730\u8003\u5bdf\u2026\u2026", "217f36a151315e9a0b7141e64e4e97d0": "FOCEN \u5c06\u57f9\u8bad\u5f53\u5730\u793e\u533a\u76d1\u6d4b\u5e76\u4f7f\u7528\u6536\u96c6\u7684\u4fe1\u606f\u2026\u2026", "114383992ff70387b60e2fd97dd93513": "HAkA \u5c06\u4e0e\u5370\u5c3c\u4e9a\u9f50\u7701\u5f53\u5730\u53ca\u5730\u533a\u73af\u4fdd\u673a\u6784\u5408\u4f5c\uff0c\u4ee5\u2026\u2026", "766cad9d47a17a16fd753e3e794c97d2": "Hen Mpoano \u5c06\u57f9\u517b\u5efa\u8bbe\u793e\u533a\u548c\u68ee\u6797\u7ba1\u7406\u5458\u7684\u68ee\u6797\u76d1\u6d4b\u80fd\u529b\u2026\u2026", "e11eb3290bfc16a505635cbbe37dbed4": "Aves y Conservaci\u00f3n \u5c06\u52a0\u5f3a ACUSMIT \u7684\u68ee\u6797\u76d1\u6d4b\u5de5\u4f5c\u529b\u5ea6\uff0c\u5e76\u2026\u2026", "da42e962126718c7301eb82fd1d01407": "Asociaci\u00f3n ProPur\u00fas \u5c06\u4e0e\u4e4c\u5361\u5229\u4e9a\u5730\u533a\u4e3b\u8981\u7684\u539f\u4f4f\u6c11\u8054\u76df\u5bc6\u5207\u5408\u4f5c\u2026\u2026", "79eb02ebc799c977f20ffd38fcce7cd2": "AMPA \u5c06\u4e0e\u79d8\u9c81\u5723\u9a6c\u4e01\u7684\u79c1\u8425\u7279\u8bb8\u7ecf\u8425\u7f51\u7edc\u5408\u4f5c\uff0c\u76d1\u6d4b\u8fdd\u6cd5\u6d3b\u52a8\u2026\u2026", "63ad5b3e3f67038eca46abea9f603702": "JPIK \u7684\u9879\u76ee\u5c06\u81f4\u529b\u4e8e\u63d0\u9ad8 JPIK \u4f1a\u5458 Indigenous Peoples \u7684\u76d1\u6d4b\u80fd\u529b\u2026\u2026", "1c7f5d1cf2f9028f6b40d5d92aaa0796": "\u8be5\u9879\u76ee\u5c06\u81f4\u529b\u4e8e\u5229\u7528\u6709\u6548\u76d1\u6d4b\u4fc3\u8fdb\u53ef\u6301\u7eed\u7684\u68ee\u6797\u7ba1\u7406\u2026\u2026", "0bf8bb7dbdde3b804c7f27fcdb78d0d9": "Alliance GSAC \u5c06\u52a0\u5f3a\u5f53\u5730\u793e\u533a\u7684\u68ee\u6797\u76d1\u6d4b\u80fd\u529b\uff0c\u4ee5\u51cf\u5c11\u6ee5\u4f10\u2026\u2026", "da8556d3140358699c89bb49d80b3084": "The Association of Samaaka Communities (VSG) \u5c06\u5efa\u7acb\u4e00\u4e2a\u57fa\u4e8e\u793e\u533a\u7684\u76d1\u6d4b\u7cfb\u7edf\u2026\u2026", "9c67e724deae01e378732319e7c0268a": "\u65b0\u95fb", "83cc39e3fea8b4d76cb494002f0cabdc": "\u793e\u533a\u53c2\u4e0e", "de7a22a0c94aa64ba2449e520aa20c99": "\u6559\u80b2", "be7e9a146028da16fc90c9687c1c1a67": "Publish What You Pay Indonesia \u8fd0\u7528 GFW \u6765\u589e\u5f3a\u793e\u533a\u53c2\u4e0e\u5ea6\u2026\u2026", "aec06e27291ad0ffaf295a5c1532f173": "Titian Lestari Foundation \u57fa\u91d1\u4f1a\u5c06\u4e0e\u9a6c\u54c8\u574e\u6cb3\u4e09\u89d2\u6d32\u68ee\u6797\u7684\u7ba1\u7406\u5458\u4ee5\u53ca\u5f53\u5730\u793e\u533a\u5c55\u5f00\u5408\u4f5c\u2026\u2026", "746c8ac04a29dfcee33c6de400fe7dbb": "\u96e8\u6797\u8054\u76df (Rainforest Alliance) \u5c06\u63d0\u4f9b\u652f\u6301\uff0c\u4ee5\u5efa\u8bbe\u548c\u57f9\u8bad\u96e8\u6797\u62a4\u7406\u5458\u548c\u793e\u4f1a\u6797\u4e1a\u2026\u2026", "76e82ad09b7ca6a1dc12cd79bf02caf5": "Pledge Ghana \u5c06\u63d0\u4f9b\u652f\u6301\uff0c\u589e\u5f3a\u5c0f\u519c\u53ef\u53ef\u79cd\u690d\u8005\u53ca\u5176\u751f\u4ea7\u8005\u5408\u4f5c\u793e\u7684\u80fd\u529b\uff0c\u4ee5\u2026\u2026", "3398b91ba2aa788a47498627c8d4bdf1": "ProCAT Colombia \u81f4\u529b\u4e8e\u4f7f\u7528 GFW \u7684\u6ee5\u4f10\u8b66\u62a5\u6765\u51cf\u8f7b\u3001\u63a7\u5236\u548c\u76d1\u6d4b\u2026\u2026", "93deffd4db1a5ec67a4f206ade1ee252": "<strong>\u5546\u54c1\uff1a</strong>\u519c\u4e1a\u6216\u77ff\u4e1a\u7684\u521d\u7ea7\u4ea7\u54c1\u6216\u539f\u6750\u6599\u3002&nbsp;", "899767b889b16b8b4e4d2171bbe46a2e": "\u65e0\u8ba1\u5212&nbsp;", "ab32323473c74510ce5a7712f1d7e04a": "<strong>\u7a7a\u6c14\u8d28\u91cf\u6307\u6570\uff08AQI\uff09\uff1a</strong>\u653f\u5e9c\u673a\u6784\u7528\u4e8e\u4f20\u8fbe\u7a7a\u6c14\u8d28\u91cf\u7684\u6307\u6807\uff0c\u5373\u7a7a\u6c14\u7684\u6e05\u6d01\u5ea6\u6216\u6c61\u67d3\u7a0b\u5ea6\u3002&nbsp;", "8cd6c7789e48d82c5dec38918985336c": "<strong>API\uff1a</strong>\u5e94\u7528\u7a0b\u5e8f\u7f16\u7a0b\u63a5\u53e3\uff0c\u4e00\u7ec4\u4f7f\u8f6f\u4ef6\u5e94\u7528\u7a0b\u5e8f\u80fd\u591f\u76f8\u4e92\u901a\u4fe1\u4ee5\u4ea4\u6362\u6570\u636e\u3001\u7279\u6027\u548c\u529f\u80fd\u7684\u89c4\u5219\u6216\u534f\u8bae\u3002&nbsp;", "5632380f05bd6efe0b0904929601f4f7": "<strong>\u751f\u7269\u591a\u6837\u6027\u5b8c\u6574\u6027\uff1a</strong>\u4e00\u4e2a\u5730\u70b9\u4ecd\u7136\u5b58\u5728\u7684\u539f\u59cb\u7269\u79cd\u548c\u4e2a\u4f53\u6570\u91cf\u7684\u6bd4\u4f8b\u548c\u4e30\u5bcc\u5ea6\u3002&nbsp;", "ad921d60486366258809553a3db49a4a": "\u672a\u77e5", "acd479fd64c0bc9982dc2ae7b70e0a90": "\u4ece {startYear} \u5230 {endYear}\uff0c{percentage} \u7684<b>\u5168\u7403</b>\u6811\u6728\u8986\u76d6\u635f\u5931\u53d1\u751f\u5728 {lossPhrase}\u3002\u5929\u7136\u6797\u5185\u7684\u603b\u635f\u5931\u4e3a {totalLoss}\uff0c\u76f8\u5f53\u4e8e {value} \u7684\u4e8c\u6c27\u5316\u78b3\u6392\u653e\u91cf\u3002", "afdb63b78730fe5d519ad7311513554a": "\u4ece {baselineYear} \u5230 2020 \u5e74\uff0c{location} \u7684\u6811\u6728\u8986\u76d6\u589e\u52a0\u4e86 {gain}\uff0c\u76f8\u5f53\u4e8e\u8be5\u65f6\u6bb5\u603b\u8303\u56f4\u7684 {gainPercent}\u3002", "d79620d54128042719aaa047c1ba001e": "\u6d4f\u89c8\u4e92\u52a8\u56fe\u8868\u548c\u5730\u56fe\uff0c\u4e86\u89e3 {area} \u7684\u68ee\u6797\u53d8\u5316\u7387\u6982\u8ff0\u3002\u7edf\u8ba1\u6570\u636e - \u5305\u62ec\u68ee\u6797\u635f\u5931\u548c\u589e\u52a0\u6700\u591a\u7684\u5730\u533a\u6392\u540d\uff0c\u53ef\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u5e76\u4e0b\u8f7d\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "3b8d9f7a355a6310a79af22f939801b6": "\u6d4f\u89c8\u4e92\u52a8\u56fe\u8868\u548c\u5730\u56fe\uff0c\u4e86\u89e3 {area} \u7684\u68ee\u6797\u8986\u76d6\u8303\u56f4\u6982\u8ff0\u3002\u7edf\u8ba1\u6570\u636e - \u5305\u62ec\u68ee\u6797\u8986\u76d6\u7c7b\u578b\uff0c\u53ef\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u5e76\u4e0b\u8f7d\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "875080cf1fe1e2c8c846ff9a38a0c03d": "\u6728\u7ea4\u7ef4\u6216\u6728\u6750\u79cd\u690d\u56ed", "936e18b41d36227b2536688b000750d2": "2001 \u5e74\uff0c\u5370\u5ea6\u5c3c\u897f\u4e9a\u62e5\u6709 93.8 Mha \u7684\u539f\u59cb\u68ee\u6797*\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684 50% \u4ee5\u4e0a\u3002\u5230 {year} \u5e74\uff0c\u8be5\u56fd\u635f\u5931\u4e86 292 kha \u7684\u539f\u59cb\u68ee\u6797*\uff0c\u76f8\u5f53\u4e8e 221 Mt \u4e8c\u6c27\u5316\u78b3\u6392\u653e\u91cf\u3002", "0eb09cefe92976350e93414f15bca955": "\u6c34\u679c\u6df7\u5408", "31ff330a29afabc5402b3e28f06b3832": "\u6cb9\u68d5\u79cd\u690d\u56ed", "45d665db7cc4843ef1d7e1337a775838": "\u6a61\u80f6\u6df7\u5408", "d7c32e092f96987ade7a0cd88d774816": "\u6728\u7ea4\u7ef4\u6216\u6728\u6750\u6df7\u5408", "2ea1b2447e369c82edfc95c350ea8062": "\u672a\u77e5\u6df7\u5408", "7a2461aceb99adc41a8d2d612eb2c4bf": "\u6d4f\u89c8\u4e92\u52a8\u56fe\u8868\u548c\u5730\u56fe\uff0c\u4e86\u89e3 {area} \u7684\u68ee\u6797\u706b\u707e\u60c5\u51b5\u6982\u8ff0\u3002\u7edf\u8ba1\u6570\u636e \u2013 \u5305\u62ec\u5f53\u524d\u706b\u707e\u4e0e\u5386\u53f2\u8d8b\u52bf\u7684\u6bd4\u8f83\uff0c\u53ef\u81ea\u5b9a\u4e49\u3001\u8f7b\u677e\u5171\u4eab\u5e76\u4e0b\u8f7d\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "0edf92874b0d1d67ac7a422381b2f5a0": "\u663e\u793a\u4e86\u68d5\u6988\u6cb9\u5382\u7684\u4f4d\u7f6e", "9f5225aa62ce2be50cb2c3e2730d1a95": "\u884c\u653f\u533a&nbsp;", "96d6352f2336020c3b1a40a74d49d045": "\u539f\u59cb\u68ee\u6797&nbsp;", "e33eb4724b135097944bbcc321d69348": "\u8be5\u6570\u636e\u96c6\u63cf\u7ed8\u4e86 2001 \u5e74\u5168\u7403\u6cdb\u70ed\u5e26\u5730\u533a\u539f\u59cb\u68ee\u6797\u7684\u5206\u5e03\u8303\u56f4", "bb22a0b0bf1ff88b9bf57c448105cc71": "\u6bcf 6 \u4e2a\u6708&nbsp;", "b366a8fa219270f5f85d97968c35c65f": "\u58a8\u897f\u54e5\u5927\u578b\u201c\u739b\u96c5\u5217\u8f66\u201d\u9879\u76ee\u65e8\u5728\u6269\u5efa\u548c\u5b8c\u5584\u8be5\u56fd\u4ea4\u901a\u57fa\u7840\u8bbe\u65bd\uff0c\u4f46\u8be5\u9879\u76ee\u5bf9\u68ee\u6797\u690d\u88ab\u7684\u76f4\u63a5\u548c\u95f4\u63a5\u5f71\u54cd\u4ecd\u672a\u53ef\u77e5\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Iniciativa Clim\u00e1tica de M\u00e9xico</a> \u5c06\u901a\u8fc7\u5efa\u8bbe Net Zero Deforestation Observatory \u6570\u5b57\u5e73\u53f0\uff0c\u5206\u6790\u5e76\u53d1\u5e03\u6709\u5173\u201c\u739b\u96c5\u5217\u8f66\u201d\u6cbf\u7ebf\u5730\u533a\u6ee5\u4f10\u4e8b\u4ef6\u7684\u5206\u6790\u3001\u62a5\u544a\u548c\u6570\u636e\uff0c\u6765\u586b\u8865\u8fd9\u4e00\u8ba4\u77e5\u7a7a\u767d\u3002\u5176\u76ee\u7684\u662f\u5728\u58a8\u897f\u54e5\u653f\u5e9c\u627f\u8bfa\u5c06\u5b9e\u73b0\u68ee\u6797\u780d\u4f10\u7387\u4e3a\u96f6\u7684\u80cc\u666f\u4e0b\uff0c\u63d0\u9ad8\u516c\u4f17\u5bf9\u201c\u739b\u96c5\u5217\u8f66\u201d\u7684\u8ba4\u8bc6\uff0c\u786e\u4fdd\u4eba\u4eec\u80fd\u591f\u83b7\u53d6\u76f8\u5173\u6280\u672f\u4fe1\u606f\u3002\uff08\u56fe\u7247\u7531 Iniciativa Clim\u00e1tica de M\u00e9xico \u63d0\u4f9b\uff09\u3002", "2889bc03565482d826b85a6cca793d80": "\u5728\u54e5\u4f26\u6bd4\u4e9a\u5317\u90e8\uff0c\u70ed\u5e26\u5e72\u65f1\u68ee\u6797\u662f\u54e5\u4f26\u6bd4\u4e9a\u7279\u6709\u7684\u8c98\u7684\u91cd\u8981\u6816\u606f\u5730\u3002\u4f46\u4e0d\u5e78\u7684\u662f\uff0c\u8fd9\u7247\u68ee\u6797\u76ee\u524d\u662f\u54e5\u4f26\u6bd4\u4e9a\u53d7\u5a01\u80c1\u6700\u4e25\u91cd\u7684\u68ee\u6797\u751f\u6001\u7cfb\u7edf\uff0c\u539f\u6709\u9762\u79ef\u7684 98% \u90fd\u5df2\u906d\u5230\u780d\u4f10\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">ProCAT Colombia</a> \u4e0e\u56fd\u9645\u81ea\u7136\u4fdd\u62a4\u8054\u76df\u7269\u79cd\u5b58\u7eed\u59d4\u5458\u4f1a (IUCN SSC) \u8c98\u5c5e\u4e13\u5bb6\u5c0f\u7ec4\u5bc6\u5207\u5408\u4f5c\uff0c\u8fd0\u7528 GFW \u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\uff0c\u5728 IUCN\u3001ProCAT\u3001\u4fdd\u62a4\u533a\u3001\u5730\u65b9\u548c\u73af\u5883\u90e8\u95e8\u4e4b\u95f4\u53ca\u65e9\u5f00\u5c55\u8054\u5408\u884c\u52a8\uff0c\u4ee5\u51cf\u5c11\u3001\u7ba1\u63a7\u548c\u76d1\u6d4b\u54e5\u4f26\u6bd4\u4e9a\u70ed\u5e26\u5e72\u65f1\u68ee\u6797\u7684\u6ee5\u4f10\u73b0\u8c61\uff0c\u4ece\u800c\u4e3a\u54e5\u4f26\u6bd4\u4e9a\u8c98\u63d0\u4f9b\u957f\u671f\u4fdd\u62a4\u3002\uff08\u7167\u7247\u7531 Juliana Velez \u63d0\u4f9b\uff09\u3002", "0a5f5955bb56bdf4dba49d84064cf90e": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Instituto del Bien Comun (IBC)</a> \u5c06\u4e0e<span data-contrast=\"none\">\u79d8\u9c81\u7684\u4e24\u5bb6\u539f\u4f4f\u6c11\u8054\u5408\u4f1a\u2014\u2014National Federation of Kakataibo Communities \u548c Federation of Native Communities of Puerto Inca and Tributaries \u5408\u4f5c\uff0c\u5229\u7528\u6570\u5b57\u6280\u672f\u5f00\u53d1\u5e76\u5b9e\u65bd\u4e00\u5957\u5728 Kakataibo \u548c Pachitea \u5730\u533a\u539f\u4f4f\u6c11\u9886\u5730\u4f7f\u7528\u7684\u76d1\u6d4b\u7cfb\u7edf\u3002 </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335557856&quot;:16777215,&quot;335559739&quot;:0,&quot;335559740&quot;:279}\">&nbsp;</span><span data-contrast=\"none\">\u8be5\u5730\u533a\u7684\u539f\u4f4f\u6c11\u9886\u5730\u6b63\u53d7\u5230\u571f\u5730\u5165\u4fb5\u548c\u5f00\u53d1\u7684\u5a01\u80c1\uff0c\u4f46\u76ee\u524d\uff0c\u53d7\u5f71\u54cd\u793e\u533a\u7f3a\u4e4f\u76f8\u5e94\u7684\u5de5\u5177\u548c\u8d44\u6e90\u5411\u8d1f\u8d23\u5904\u7406\u8fdd\u6cd5\u8005\u7684\u56fd\u5bb6\u673a\u5173\u63d0\u4f9b\u5145\u5206\u4e14\u53ca\u65f6\u7684\u4fe1\u606f\u3002IBC \u5c06\u4e0e\u4e00\u652f\u8bd5\u70b9\u91cd\u70b9\u5c0f\u7ec4\u5408\u4f5c\uff0c\u8be5\u5c0f\u7ec4\u5305\u62ec\u4e24\u5bb6\u539f\u4f4f\u6c11\u8054\u5408\u4f1a\u7684\u9886\u5bfc\u4eba\u5458\u53ca\u5b89\u4fdd\u6210\u5458\uff0cIBC \u5c06\u57f9\u8bad\u4ed6\u4eec\u4f7f\u7528 GFW \u5de5\u5177\u8fdb\u884c\u68ee\u6797\u76d1\u6d4b\uff0c\u5e76\u5f00\u53d1\u76d1\u6d4b\u7cfb\u7edf\u3002\u4e4b\u540e\uff0c\u793e\u533a\u5de1\u903b\u5458\u5c06\u53ef\u4ee5\u4f7f\u7528 Forest Watcher \u548c\u793e\u533a\u7ed8\u5236\u7684\u5730\u56fe\u4e0a\u62a5\uff0c\u4ee5\u4fbf\u56fd\u5bb6\u673a\u6784\u91c7\u53d6\u9884\u9632\u63aa\u65bd\u3002&nbsp;</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335557856&quot;:16777215,&quot;335559739&quot;:0,&quot;335559740&quot;:279}\">&nbsp;</span>", "5351becdd2669d24c732ad4546e3b73e": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Instituto Araguaia</a> \u7684\u76ee\u6807\u662f\u901a\u8fc7\u5b9e\u65f6\u536b\u661f\u6570\u636e\u76d1\u6d4b\u68ee\u6797\u635f\u5931\uff0c\u4ece\u800c\u51cf\u5c11\u4f4d\u4e8e\u5df4\u897f\u963f\u62c9\u74dc\u4e9a\u56fd\u5bb6\u516c\u56ed (Araguaia National Park) \u548c Cantao \u5dde\u7acb\u516c\u56ed\u7684\u585e\u62c9\u591a\u4f4e\u5730\u7f13\u51b2\u533a\u7684\u68ee\u6797\u6ee5\u4f10\u73b0\u8c61\u3002\u585e\u62c9\u591a\u4f4e\u5730\u662f\u4e00\u4e2a\u751f\u7269\u591a\u6837\u6027\u533a\u57df\uff0c\u5728\u56fd\u5bb6\u516c\u56ed\u548c\u5dde\u7acb\u516c\u56ed\u6bcf\u5e74\u906d\u5230\u6d2a\u6c34\u51b2\u51fb\u65f6\uff0c\u8fd9\u91cc\u5c31\u662f\u9646\u751f\u52a8\u7269\u7684\u907f\u96be\u6240\u3002\u7136\u800c\uff0c\u5de5\u4e1a\u5927\u8c46\u516c\u53f8\u6b63\u5728\u8be5\u5730\u533a\u5927\u8086\u6ee5\u4f10\uff0c\u8fd9\u79cd\u884c\u4e3a\u5f80\u5f80\u8fd8\u662f\u975e\u6cd5\u8fdb\u884c\u7684\u3002Instituto Araguaia \u8fd0\u7528 GFW \u548c\u5176\u4ed6\u9ad8\u5206\u8fa8\u7387\u536b\u661f\u6570\u636e\u7ed8\u5236\u5e76\u91cf\u5316\u4e86\u585e\u62c9\u591a\u5730\u533a\u5728 2013-2015 \u5e74\u7684\u68ee\u6797\u635f\u5931\u60c5\u51b5\u3002\u4ed6\u4eec\u5bf9\u6570\u636e\u8fdb\u884c\u5b9e\u5730\u6838\u67e5\u6765\u9a8c\u8bc1\u5176\u53d1\u73b0\uff0c\u7136\u540e\u5c06\u7ed3\u679c\u53d1\u9001\u7ed9\u5408\u4f5c\u7684 NGO \u548c\u73af\u5883\u673a\u6784\uff0c\u6700\u7ec8\u5728\u516c\u56ed\u7684\u8fb9\u754c\u5408\u6cd5\u5efa\u7acb\u4e86\u4e00\u4e2a\u65b0\u7684\u7f13\u51b2\u533a\u3002\uff08\u56fe\u7247\u7531 Instituto Araguaia \u63d0\u4f9b\u3002\uff09", "b707bf780f54954e5a5bcdf2c719bebc": "\u4e2d\u7f8e\u6d32\u751f\u6001\u5eca\u9053 (The Mesoamerican Biological Corridor) \u751f\u7269\u591a\u6837\u6027\u4e30\u5bcc\uff0c\u4f46\u7531\u4e8e\u6709 335,886 \u4eba\u5728\u6b63\u5f0f\u4fdd\u62a4\u533a\u548c\u975e\u6b63\u5f0f\u4fdd\u62a4\u533a\u5185\u53ca\u5176\u5468\u8fb9\u5b9a\u5c45\uff0c\u52a0\u4e4b\u755c\u7267\u548c\u5200\u8015\u706b\u79cd\u5f0f\u519c\u4e1a\u5927\u9762\u79ef\u6269\u5f20\uff0c\u8fd9\u4e9b\u91cd\u8981\u7684\u68ee\u6797\u9762\u4e34\u7740\u5de8\u5927\u7684\u538b\u529b\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">EcoLogic Development Fund</a> \u5c06\u4e0e\u58a8\u897f\u54e5\u3001\u5371\u5730\u9a6c\u62c9\u548c\u6d2a\u90fd\u62c9\u65af\u5408\u4f5c\uff0c\u57f9\u8bad\u5f53\u5730\u793e\u533a\u76d1\u6d4b\u961f\u4f7f\u7528 GPS\u3001\u65e0\u4eba\u673a\u62cd\u6444\u548c GFW \u7684 GLAD \u53ca VIIRS \u8b66\u62a5\u7b49\u76d1\u6d4b\u5de5\u5177\uff0c\u4ee5\u5b9e\u73b0\u66f4\u6709\u6548\u7684\u68ee\u6797\u76d1\u6d4b\u548c\u7ba1\u7406\u3002\u5f53\u5730\u7684\u5229\u76ca\u76f8\u5173\u65b9\u53ca\u653f\u5e9c\u90e8\u95e8\u5c06\u53c2\u4e0e\u5408\u4f5c\uff0c\u6839\u636e\u76d1\u6d4b\u961f\u63d0\u4f9b\u7684\u6570\u636e\u5bf9\u4fdd\u62a4\u5de5\u4f5c\u505a\u51fa\u6539\u8fdb\u3002", "959637b7eb276dd60985552c5a7c88e0": "\u5728\u5370\u5ea6\u5c3c\u897f\u4e9a\u4e1c\u52a0\u91cc\u66fc\u4e39\u7684 Mahakam \u4e09\u89d2\u6d32\u5730\u533a\uff0c47.8% \u7684\u7ea2\u6811\u6797\u751f\u6001\u7cfb\u7edf\u90fd\u7531\u4e8e\u6c34\u4ea7\u517b\u6b96\u800c\u9000\u5316\uff0c\u800c\u6c34\u4ea7\u517b\u6b96\u662f\u5f53\u5730 90% \u4eba\u53e3\u7684\u91cd\u8981\u751f\u8ba1\u6765\u6e90\u3002\u8be5\u5730\u533a\u7684\u7ea2\u6811\u6797\u9664\u4e86\u662f\u91cd\u8981\u7684\u751f\u8ba1\u6d3b\u52a8\u573a\u6240\uff0c\u8fd8\u6781\u5177\u751f\u7269\u591a\u6837\u6027\u4ef7\u503c\uff0c\u8fd8\u662f\u6d2a\u6c34\u3001\u98ce\u66b4\u7b49\u6781\u7aef\u6c14\u5019\u65f6\u95f4\u7684\u5929\u7136\u5c4f\u969c\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Titian Lestari Foundation</a> \u4e0e Mahakam \u4e09\u89d2\u6d32\u68ee\u6797\u7ba1\u7406\u5458\u548c\u5f53\u5730\u793e\u533a\u5408\u4f5c\uff0c\u65e8\u5728\u901a\u8fc7\u5efa\u8bbe\u68ee\u6797\u76d1\u6d4b\u80fd\u529b\u548c\u9f13\u52b1\u68ee\u6797\u7ba1\u7406\u5458\u548c\u5f53\u5730\u793e\u533a\u4e4b\u95f4\u7684\u5408\u4f5c\u6765\u51cf\u7f13\u7ea2\u6811\u6797\u9000\u5316\uff0c\u4ece\u800c\u4f7f\u7ea2\u6811\u6797\u5e74\u5747\u68ee\u6797\u635f\u5931\u51cf\u5c11 50%\u3002\uff08\u56fe\u7247\u7531 Titian Lestari Foundation \u63d0\u4f9b\uff09\u3002", "92a877aa535150a942754ef42ddae420": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Yayasan Ekosistem Lestari (YEL)</a> \u5c06\u4e0e\u5370\u5ea6\u5c3c\u897f\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf\u548c\u5df4\u4e39\u6258\u9c81\u751f\u6001\u7cfb\u7edf\u5408\u4f5c\uff0c\u57f9\u8bad\u56fd\u5bb6\u516c\u56ed\u548c\u68ee\u6797\u7ba1\u7406\u56e2\u961f\u4f7f\u7528 GFW \u5de5\u5177\uff08\u5305\u62ec Forest Watcher \u4ee5\u53ca\u5982\u4f55\u5206\u6790 GLAD \u548c RADD \u6ee5\u4f10\u8b66\u62a5\uff09\uff0c\u4ece\u800c\u63d0\u9ad8\u53ef\u6301\u7eed\u68ee\u6797\u7ba1\u7406\u7684\u6709\u6548\u76d1\u6d4b\u3002\u516c\u56ed\u5de5\u4f5c\u4eba\u5458\u5c06\u63a5\u53d7\u57f9\u8bad\uff0c\u4e86\u89e3\u5982\u4f55\u8fdb\u884c\u68ee\u6797\u76d1\u6d4b\uff0c\u5e76\u5c06\u5b9e\u5730\u8003\u5bdf\u4fe1\u606f\u4e0a\u4f20\u5230 Forest Watcher \u5e94\u7528\u4e2d\u3002\u6b64\u5916\uff0cYEL \u8fd8\u5c06\u4e3a\u793e\u533a\u751f\u6001\u65c5\u6e38\u56e2\u4f53\u5c55\u5f00\u57f9\u8bad\u8ba1\u5212\uff0c\u544a\u8bc9\u4ed6\u4eec\u5982\u4f55\u901a\u8fc7\u667a\u80fd\u624b\u673a\u4e0a\u7684 Forest Watcher \u5e94\u7528\u91c7\u96c6\u6570\u636e\uff0c\u5411\u76f8\u5173\u653f\u5e9c\u90e8\u95e8\u4e3e\u62a5\u68ee\u6797\u6ee5\u4f10\u4e8b\u4ef6\u3002\u5229\u7528\u65e0\u4eba\u673a\u6280\u672f\u5bf9\u91cd\u70b9\u76ee\u6807\u533a\u57df\u8fdb\u884c\u5b9e\u5730\u8c03\u67e5\uff0c\u5e76\u53d1\u5e03\u6708\u5ea6\u62a5\u544a\uff0c\u8bb0\u5f55\u68ee\u6797\u8986\u76d6\u548c\u91ce\u751f\u52a8\u7269\u6816\u606f\u5730\u6570\u636e\u7684\u53d8\u5316\u539f\u56e0\u3002\u968f\u540e\uff0c\u6bcf\u4e2a\u56fd\u5bb6\u516c\u56ed\u548c\u68ee\u6797\u7ba1\u7406\u673a\u6784\u90fd\u5c06\u5236\u5b9a\u300a\u6816\u606f\u5730\u7ba1\u7406\u8ba1\u5212\u300b(Habitat Management Plan)\uff0c\u4e3a\u653f\u7b56\u5236\u5b9a\u63d0\u4f9b\u4f9d\u636e\uff0c\u5e76\u4e3a\u6bcf\u4e2a\u6797\u533a\u7684\u957f\u671f\u7ba1\u7406\u5236\u5b9a\u53ef\u6301\u7eed\u8ba1\u5212\u3002", "f1c37f272b2a4330ba30e6e25b33452d": "\u4eca\u5e74\u662f <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Asociaci\u00f3n Amaz\u00f3nicos por la Amazon\u00eda</a> (AMPA) \u7b2c\u56db\u5e74\u83b7\u5f97\u5c0f\u989d\u8d44\u52a9\u91d1\uff0c\u4ed6\u4eec\u5c06\u7ee7\u7eed\u4e0e\u79d8\u9c81\u5723\u9a6c\u4e01\u7684\u79c1\u8425\u7279\u8bb8\u7ecf\u8425\u7f51\u7edc\u5408\u4f5c\uff0c\u76d1\u6d4b\u79c1\u4eba\u53d7\u4fdd\u62a4\u571f\u5730\u4e0a\u7684\u975e\u6cd5\u6d3b\u52a8\uff0c\u81ea\u65b0\u51a0\u75ab\u60c5\u4ee5\u6765\uff0c\u8fd9\u4e9b\u975e\u6cd5\u6d3b\u52a8\u65e5\u76ca\u7316\u7357\u3002\u4e3a\u89e3\u51b3\u8fd9\u4e00\u95ee\u9898\uff0cAMPA \u5c06\u534f\u540c\u5176\u4ed6 GIS \u6280\u672f\u90e8\u95e8\u3001\u5730\u65b9\u884c\u52a8\u8005\u548c\u76f8\u5173\u73af\u5883\u90e8\u95e8\u5f00\u5c55\u76d1\u6d4b\u548c\u5e94\u5bf9\u884c\u52a8\uff0c\u4ee5\u8c03\u67e5\u548c\u5e94\u5bf9\u5723\u9a6c\u4e01\u7684\u73af\u5883\u72af\u7f6a\u3002\u4ed6\u4eec\u65e8\u5728\u901a\u8fc7\u534f\u8c03\u4e3b\u7ba1\u90e8\u95e8\u548c\u5730\u65b9\u884c\u52a8\u8005\u4e4b\u95f4\u7684\u52aa\u529b\uff0c\u52a0\u5f3a\u5e94\u5bf9\u884c\u52a8\uff0c\u4ece\u800c\u66f4\u6709\u6548\u5730\u89e3\u51b3\u8be5\u5730\u533a\u7684\u68ee\u6797\u6ee5\u4f10\u5a01\u80c1\u3002\uff08\u56fe\u7247\u7531 AMPA \u63d0\u4f9b\uff09\u3002", "d787dbe2fb123bca4c4eb77a693110ed": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Women Research Institute</a> \u8fd0\u7528 GFW \u4e3a\u6c11\u95f4\u793e\u4f1a\u7ec4\u7ec7\u4e2d\u7684\u5973\u6027\u8d4b\u80fd\uff0c\u8ba9\u5979\u4eec\u53ef\u4ee5\u5c55\u5f00\u5faa\u8bc1\u5ba3\u4f20\uff0c\u4fc3\u8fdb\u63d0\u9ad8\u68ee\u6797\u7279\u8bb8\u7ecf\u8425\u5730\u7684\u900f\u660e\u5ea6\u3002WRI \u5c06\u805a\u7126\u706b\u707e\u548c\u95ee\u9898\u6838\u5fc3\u4f5c\u4e3a\u4e3b\u8981\u5ba3\u4f20\u8bae\u9898\uff0c\u5229\u7528 GFW \u4e3b\u7f51\u7ad9\u4ee5\u53ca GFW Fires \u57f9\u8bad\u5987\u5973\u4e86\u89e3\u68d5\u6988\u6cb9\u7279\u8bb8\u7ecf\u8425\u5730\u7684\u73b0\u72b6\u53ca\u706b\u707e\u5bf9\u5f53\u5730\u7684\u5f71\u54cd\u3002\u5177\u4f53\u800c\u8a00\uff0cWRI \u5c06\u5bf9\u4e24\u4e2a\u793e\u533a\u4e2d\u7684\u5987\u5973\u8fdb\u884c\u57f9\u8bad\uff0c\u4ece\u800c\u5bf9\u5730\u533a\u548c\u7701\u7ea7\u51b3\u7b56\u4ea7\u751f\u5f71\u54cd\u3002\u4ed6\u4eec\u521b\u5efa\u4e86\u4e00\u4e2a\u53ef\u7528\u5728\u5176\u4ed6\u5730\u65b9\u7684\u57f9\u8bad\u6a21\u5757\uff0c\u4fc3\u8fdb\u5987\u5973\u53c2\u4e0e\u4fdd\u62a4\u5ba3\u4f20\u5de5\u4f5c\u3002\u6700\u7ec8\uff0c\u653f\u5e9c\u3001\u5987\u5973\u6c11\u95f4\u793e\u4f1a\u7ec4\u7ec7\u548c\u5987\u5973\u4ee3\u8868\u7b49\u591a\u4e2a\u5229\u76ca\u76f8\u5173\u65b9\u4e3e\u529e\u4e86\u8bba\u575b\uff0c\u4ee5\u4fc3\u8fdb\u5408\u4f5c\u3002\uff08\u7167\u7247\u7531 Women Research Institute \u63d0\u4f9b\u3002)", "52a1ee127d73b0ab1abe37cd91350b4b": "\u8be5\u9879\u76ee\u65e8\u5728\u901a\u8fc7\u5f3a\u5316 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Ny Tanintsika</a> \u548c 10 \u4e2a\u793e\u533a\u68ee\u6797\u7ba1\u7406\u534f\u4f1a\u7684\u5f53\u5730\u5de1\u62a4\u5458\u4f7f\u7528 Global Forest Watch \u5e73\u53f0\u3001Forest Watcher \u5e94\u7528\u7a0b\u5e8f\u548c\u5206\u6790 GLAD \u8b66\u62a5\u7684\u80fd\u529b\uff0c\u66f4\u6709\u6548\u5730\u76d1\u6d4b\u548c\u5b89\u5e03\u897f\u7279\u62c9-\u7fc1\u5fb7\u9c81\u7956\u5eca\u9053 (COFAV) \u4fdd\u62a4\u533a\u5b89\u5e03\u5e0c\u9a6c\u54c8\u9a6c\u897f\u7eb3\u5730\u533a\u7684\u68ee\u6797\u6ee5\u4f10\u4e8b\u4ef6\u548c\u5a01\u80c1\uff0c\u4ece\u800c\u6cbb\u7406\u68ee\u6797\u6ee5\u4f10\u73b0\u8c61\u3002\u6570\u636e\u5c06\u7528\u4e8e\u5feb\u901f\u91c7\u53d6\u884c\u52a8\u3001\u5ba3\u4f20\u548c\u63d0\u9ad8\u516c\u4f17\u610f\u8bc6\uff0c\u4ee5\u53ca\u4fc3\u8fdb\u5229\u76ca\u76f8\u5173\u65b9\u7684\u6c9f\u901a\u4e0e\u5408\u4f5c\u3002\uff08\u56fe\u7247\u6765\u81ea Ny Tanintsika \u5de5\u4f5c\u4eba\u5458\uff1aRAHERIVELO Maminirina Lucien\u3001CAMERON Samantha\u3001SOAMANDIMBY Olivier\uff09\u3002", "a81ad80e1903607921317f20230a96d7": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Sociedad Peruana de Derecho Ambiental</a> (SPDA) \u5728\u5176\u8fc7\u5f80\u4f7f\u7528 GFW \u7684\u7ecf\u9a8c\u4e0a\uff0c\u8fdb\u4e00\u6b65\u6539\u8fdb\u4e86 GFW \u5de5\u5177\u5728\u5b9e\u5730\u6253\u51fb\u68ee\u6797\u6ee5\u4f10\u4e8b\u4ef6\u4e2d\u7684\u5e94\u7528\u3002\u5728\u5176\u9879\u76ee\u4e2d\uff0cSPDA \u652f\u6301\u4e9a\u9a6c\u5b59\u5730\u533a\u7684\u79c1\u4eba\u4fdd\u62a4\u533a\u5229\u7528 My GFW \u8bbe\u7f6e\u81ea\u5df1\u7684\u8fdc\u7a0b\u76d1\u6d4b\u7cfb\u7edf\uff0c\u540c\u65f6\u5728\u53d7\u68ee\u6797\u6ee5\u4f10\u4e8b\u4ef6\u5f71\u54cd\u4e25\u91cd\u7684\u5730\u533a\u5229\u7528 Forest Watcher \u8bd5\u70b9\u201c\u793e\u533a\u6ee5\u4f10\u4e8b\u4ef6\u76d1\u6d4b\u201d\u8ba1\u5212\u3002SPDA \u8fd8\u5229\u7528 GFW \u706b\u707e\u6570\u636e\u5c42 (VIIRS) \u589e\u5f3a\u4e86\u9879\u76ee\u533a\u57df\u7684\u5730\u65b9\u8fd0\u52a8\uff0c\u4ee5\u6253\u51fb\u5c06\u68ee\u6797\u706b\u707e\u7528\u5728\u571f\u5730\u5f00\u57a6\u53ca\u7c7b\u4f3c\u76ee\u7684\u7684\u884c\u4e3a\u3002SPDA \u7684\u9879\u76ee\u589e\u5f3a\u4e86\u5f53\u5730\u76d1\u6d4b\u5458\u5e94\u5bf9\u68ee\u6797\u6ee5\u4f10\u5a01\u80c1\u7684\u80fd\u529b\uff0c\u540c\u65f6\u4e5f\u4fc3\u8fdb\u4e86\u4e9a\u9a6c\u5b59\u5730\u533a\u5730\u65b9\u76f8\u5173\u90e8\u95e8\u5f7c\u6b64\u5efa\u7acb\u8d77\u66f4\u4e3a\u7262\u56fa\u7684\u4f19\u4f34\u5173\u7cfb\u3002\uff08\u56fe\u7247\u6765\u81ea SPDA\uff1b\u5730\u56fe\u6765\u81ea SPDA\uff0c\u663e\u793a\u4e86 Palmeras \u68ee\u6797\u7684\u6ee5\u4f10\u72b6\u51b5\u3002\uff09", "d9c49620ff3fa646c66de2f4ca630d11": "Community Commons \u5f00\u53d1\u4e86 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Global Forest Link</a>\uff0c\u8fd9\u4e2a\u5728\u7ebf\u5b66\u4e60\u73af\u5883\u57fa\u4e8e GFW \u5e73\u53f0\u5236\u4f5c\uff0c\u65e8\u5728\u52a0\u5f3a\u68ee\u6797\u76d1\u6d4b\u65b9\u9762\u7684\u6559\u80b2\u548c\u57f9\u8bad\uff0c\u5e76\u4fc3\u8fdb\u6709\u5173\u5f53\u5730\u73af\u5883\u95ee\u9898\u7684\u8de8\u6587\u5316\u6c9f\u901a\u3002\u4fc4\u7f57\u65af\u548c\u7f8e\u56fd\u7684\u9ad8\u4e2d\u751f\u5229\u7528 Global Forest Watch \u6df1\u5165\u4e86\u89e3\u68ee\u6797\u635f\u5931\u7684\u52a8\u56e0\uff0c\u4e86\u89e3\u76d1\u6d4b\u6280\u672f\u7684\u8fd0\u7528\uff0c\u5e76\u4e0e\u56fd\u9645\u540c\u9f84\u4eba\u5206\u4eab\u6709\u5173\u5f53\u5730\u571f\u5730\u5229\u7528\u548c\u68ee\u6797\u53d8\u5316\u7684\u4fe1\u606f\u3002\u8be5\u5b66\u4e60\u73af\u5883\u5305\u62ec\u8fd0\u7528\u4f17\u5305\u6280\u672f\u8fdb\u884c\u5f71\u50cf\u89e3\u8bd1\uff0c\u6559\u6388\u5b66\u751f\u4e86\u89e3\u9065\u611f\u6280\u672f\u5e76\u4f7f\u7528 GFW \u5e73\u53f0\u8fdb\u884c\u73af\u5883\u5206\u6790\uff0c\u4ee5\u53ca\u52a0\u5f3a\u73af\u5883\u8bae\u9898\u5bf9\u8bdd\u3002\u5728\u7f8e\u56fd\u5723\u8fed\u6208\u548c\u4fc4\u7f57\u65af\u8d1d\u52a0\u5c14\u6e56\u5468\u8fb9\u5730\u533a\u7684 GFW \u5730\u56fe\u4e0a\u53ef\u770b\u5230\u5b66\u751f\u63d0\u4ea4\u7684\u7528\u6237\u6545\u4e8b\u3002\uff08\u56fe\u50cf\u6765\u81ea Community Commons\u3002\uff09", "0223eae72089104fed62aaee274ccd6c": "\u6709\u5173\u8d44\u683c\u8981\u6c42\u548c\u63d0\u6848\u9884\u671f\u7684\u5176\u4ed6\u91cd\u8981\u4fe1\u606f\uff0c\u8bf7\u89c2\u770b<strong><a href=\"{{0}}\">\u7533\u8bf7\u8005\u7f51\u7edc\u7814\u8ba8\u4f1a\u5f55\u5c4f</a></strong>\uff0c\u6709\u82f1\u8bed\u3001\u6cd5\u8bed\u548c\u897f\u73ed\u7259\u8bed\u7248\u672c\u53ef\u7528\u3002\u60a8\u4e5f\u53ef\u4ee5<a href=\"{{1}}\">\u5728\u6b64\u67e5\u770b\u5e7b\u706f\u7247</a>\u3002", "11bd108f3603e3d8dce33b7d4b93d0a8": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Yayasan Pemantau Independen Kehutanan Indonesia\uff0c\u53c8\u79f0 Independent Forest Monitoring Fund (YPIKI-IFMF)</a>\uff0c\u5c06\u81f4\u529b\u4e8e\u6784\u5efa\u7531\u653f\u5e9c\u7ba1\u7406\u7684\u68ee\u6797\u7ba1\u7406\u5355\u4f4d (Forest Management Units, FMUs) \u548c\u6c11\u95f4\u793e\u4f1a\u4e3b\u5bfc\u7684\u72ec\u7acb\u76d1\u7763\u5458 (Independent Monitors, IMs) \u4f53\u7cfb\u3002\u5176\u4e2d\uff0cIMs \u7531\u5728\u5408\u6cd5 NGO \u5de5\u4f5c\u7684\u4e2a\u4eba\u548c\u68ee\u6797\u9644\u8fd1\u793e\u533a\u7ec4\u6210\u3002\u8be5\u4f53\u7cfb\u5c06\u52a0\u5f3a\u73af\u5883\u548c\u6797\u4e1a\u90e8\u5236\u5b9a\u7684\u5f3a\u5236\u6027\u5236\u5ea6\u6728\u6750\u5408\u6cd5\u6027\u4fdd\u8bc1\u5236\u5ea6 (Timber Legality Assurance System)\uff0c\u4ee5\u786e\u4fdd\u5370\u5c3c\u51fa\u53e3\u7684\u6728\u6750\u53ca\u6728\u6750\u4ea7\u54c1\u80fd\u6ee1\u8db3\u5408\u6cd5\u6027\u6807\u51c6\uff0c\u5e76\u786e\u4fdd\u6797\u4e1a\u6cd5\u5f8b\u6cd5\u89c4\u5f97\u5230\u6267\u884c\u3002", "a3c0dec5d2bc0efc27f89af48a5c6072": "GFW \u5de5\u5177\u6765", "db0d98fd6cfb071953a5c0c823b2230e": "Observatoire de la gouvernance Foresti\u00e8re en RDC <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">(OGF)</a> \u5c06\u81f4\u529b\u4e8e\u63d0\u9ad8\u5730\u65b9\u53c2\u4e0e\u8005\u7684\u80fd\u529b\uff0c\u4ee5\u963b\u65ad\u521a\u679c\u5171\u548c\u56fd\u5883\u5185\u975e\u6cd5\u6728\u6750\u7684\u6d41\u901a\u3002OGF \u5c06\u57f9\u8bad\u4e3b\u8981\u7684\u5229\u76ca\u76f8\u5173\u65b9\u4f7f\u7528 GFW \u5de5\u5177\uff0c\u4ee5\u5bf9\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u8fdb\u884c\u5b9e\u5730\u6838\u67e5\uff0c\u5e76\u5c06\u4e0e\u5f53\u5730\u7684 REDD+ \u9879\u76ee\u5408\u4f5c\u5f00\u5c55\u5b9e\u5730\u4efb\u52a1\uff0c\u5e76\u6839\u636e\u5b9e\u5730\u8c03\u67e5\u7ed3\u679c\u7f16\u5199\u62a5\u544a\u3002OGF \u5c06\u8fd0\u7528 WRI \u7684<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u516c\u5f00\u6728\u6750\u4fe1\u606f\u5e73\u53f0 (Open Timber Portal)</a> \u53d1\u5e03\u4ed6\u4eec\u7684\u8c03\u67e5\u7ed3\u679c\uff0c\u4ee5\u671f\u63d0\u9ad8\u4f10\u6728\u4e1a\u7684\u900f\u660e\u5ea6\uff0c\u5e76\u6fc0\u52b1\u4eba\u4eec\u91c7\u53d6\u53ef\u6301\u7eed\u7684\u5408\u6cd5\u4f10\u6728\u65b9\u5f0f\u3002\u6700\u7ec8\uff0cOGF \u5c06\u4e0e National Network of Independent Observers \u5408\u4f5c\uff0c\u6839\u636e\u76d1\u6d4b\u5de1\u903b\u961f\u63d0\u51fa\u7684\u5efa\u8bae\u7f16\u5199\u4e00\u4efd\u5021\u5bfc\u5efa\u8bae\u4e66\uff0c\u5b8c\u5584\u7701\u4e00\u7ea7\u7684\u68ee\u6797\u6cbb\u7406\u5de5\u4f5c\u3002\u5e76\u4ee5\u591a\u79cd\u5f62\u5f0f\u63a8\u5e7f\u8be5\u5efa\u8bae\u4e66\uff0c\u5982\u5728\u7f51\u7ad9\u3001\u65b0\u95fb\u7b80\u62a5\u4f1a\u4ee5\u53ca\u4e0e\u884c\u653f\u673a\u5173\u6216\u653f\u6cbb\u673a\u5173\u4e3e\u884c\u7684\u540e\u7eed\u4f1a\u8bae\u4e0a\u3002", "9ba8b449bf590df2e8b6dde83b03fe0d": "\u5e1d\u738b\u8776\u751f\u7269\u5708\u4fdd\u62a4\u533a (Monarch Butterfly Biosphere Reserve) \u662f\u5e1d\u738b\u8776\u8fc1\u5f99\u5468\u671f\u7684\u4f18\u5148\u91cd\u70b9\u533a\u57df\uff0c\u4e5f\u662f\u58a8\u897f\u54e5\u4e24\u5927\u6700\u91cd\u8981\u6d41\u57df\u7684\u7ec4\u6210\u90e8\u5206\u3002\u4f46\u4e0d\u5e78\u7684\u662f\uff0c\u8be5\u4fdd\u62a4\u533a\u6b63\u9762\u4e34\u4e00\u7cfb\u5217\u7684\u5a01\u80c1\uff0c\u5982\u975e\u6cd5\u4f10\u6728\u3001\u68ee\u6797\u5927\u706b\u548c\u5c71\u4f53\u6ed1\u5761\uff0c\u81f4\u4f7f\u68ee\u6797\u6ee5\u4f10\u548c\u9000\u5316\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Fondo de Conservaci\u00f3n del Eje Neovolc\u00e1nico A.C (FOCEN)</a> \u81f4\u529b\u4e8e\u901a\u8fc7\u63d0\u9ad8\u5f53\u5730\u793e\u533a\u7684\u68ee\u6797\u76d1\u6d4b\u80fd\u529b\u6765\u4fdd\u62a4\u8be5\u4fdd\u62a4\u533a\u3002\u4ed6\u4eec\u5c06\u91c7\u7528\u53c2\u4e0e\u5f0f\u65b9\u6cd5\uff0c\u9f13\u52b1\u5408\u4f5c\u519c\u573a\u3001\u793e\u533a\u548c\u6280\u672f\u987e\u95ee\u53c2\u4e0e\u68ee\u6797\u76d1\u6d4b\u6d3b\u52a8\uff0c\u5e76\u4f7f\u7528\u6536\u96c6\u5230\u7684\u4fe1\u606f\u8ba9\u4eba\u4eec\u8fdb\u4e00\u6b65\u4e86\u89e3\u4fdd\u62a4\u533a\u6240\u9762\u4e34\u7684\u5a01\u80c1\uff0c\u5e76\u63a8\u5e7f\u4fdd\u62a4\u81ea\u7136\u8d44\u6e90\u7684\u7ba1\u7406\u65b9\u6cd5\u3002\uff08\u56fe\u7247\u7531 FOCEN \u63d0\u4f9b\uff09\u3002", "11705a28364875dddbdb2dbfb266561c": "2017 \u5e74\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Malaysian Nature Society</a> (MNS) \u542f\u52a8\u4e86 \u201cMY Forest\u201d \u9879\u76ee\uff0c\u8fd9\u662f\u4e00\u4e2a\u6b27\u76df\u9879\u76ee\u7684\u5b50\u9879\u76ee\uff0c\u65e8\u5728\u63d0\u9ad8\u975e\u56fd\u5bb6\u4e3b\u4f53\u5bf9\u9a6c\u6765\u897f\u4e9a\u68ee\u6797\u6cbb\u7406\u7684\u53c2\u4e0e\u5ea6\u3002\u201cMY Forest\u201d \u7684\u4e00\u4e2a\u91cd\u8981\u7ec4\u6210\u90e8\u5206\u5373\u4e3a \u201cMalaysia Forest Watch\u201d\uff0c\u8fd9\u662f\u4e00\u4e2a\u57fa\u4e8e\u7f51\u9875\u548c\u5a92\u4f53\u7684\u5e73\u53f0\uff0c\u7528\u4ee5\u8bbf\u95ee\u548c\u5206\u4eab\u9a6c\u6765\u897f\u4e9a\u7684\u68ee\u6797\u6ee5\u4f10\u548c\u68ee\u6797\u4fdd\u62a4\u6570\u636e\u3002\u5728\u5176 SGF \u9879\u76ee\u4e2d\uff0cMNS \u5c06\u4e0e\u5176\u516c\u4f17\u79d1\u5b66\u7f51\u7edc\u5408\u4f5c\uff0c\u5c06 Forest Watcher \u4f5c\u4e3a Malaysian Forest Watch \u8ba1\u5212\u7684\u4e3b\u8981\u5b9e\u5730\u7814\u7a76\u5de5\u5177\u3002\u5176\u76ee\u7684\u662f\u63d0\u9ad8\u6c11\u95f4\u79d1\u5b66\u5bb6\u5728\u68ee\u6797\u76d1\u6d4b\u65b9\u9762\u7684\u80fd\u529b\uff0c\u4ee5\u66f4\u597d\u5730\u4fdd\u62a4\u9a6c\u6765\u897f\u4e9a\u534a\u5c9b\u7684\u91cd\u8981\u68ee\u6797\u666f\u89c2\u3002\uff08\u7167\u7247\u7531 MNS \u63d0\u4f9b\uff09\u3002", "5aa0eb4f0cfa07da7a43a5f91899701d": "\u76ee\u524d\uff0c\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u904f\u5236\u68ee\u6797\u6ee5\u4f10\u7684\u52aa\u529b\u56e0\u8d44\u91d1\u532e\u4e4f\u53ca\u5e94\u5bf9\u80fd\u529b\u4e0d\u8db3\u800c\u53d7\u9650\uff0c\u6240\u9762\u4e34\u7684\u68ee\u6797\u5a01\u80c1\u5305\u62ec\u91c7\u77ff\u3001\u975e\u6cd5\u6728\u6750\u91c7\u4f10\u548c\u5200\u8015\u706b\u79cd\u5f0f\u519c\u4e1a\u3002\u4e3a\u5e94\u5bf9\u8fd9\u4e9b\u5a01\u80c1\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Observatoire de la Gouvernance Foresti\u00e8re\u2019s</a> (OGF) \u9879\u76ee\u8ba1\u5212\u63d0\u9ad8\u73af\u5883\u90e8\u95e8\u548c\u6c11\u95f4\u793e\u56e2\u7684\u68ee\u6797\u76d1\u6d4b\u80fd\u529b\uff0c\u4ee5\u5e94\u5bf9\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u5883\u5185\u7684\u975e\u6cd5\u6797\u4e1a\u6d3b\u52a8\u3002OGF \u5df2\u4e0e WRI \u7684\u516c\u5f00\u6728\u6750\u4fe1\u606f\u5e73\u53f0\u5f00\u5c55\u5408\u4f5c\uff0c\u672a\u6765\uff0cOGF \u4f1a\u5c06 GFW \u5e73\u53f0\u7684\u4fe1\u606f\u4e0e\u516c\u5f00\u6728\u6750\u4fe1\u606f\u5e73\u53f0\u4e0a\u7684\u6570\u636e\u534f\u540c\u4e92\u8865\uff0c\u4ee5\u671f\u63d0\u9ad8\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u6728\u6750\u4ea7\u54c1\u7684\u900f\u660e\u5ea6\u548c\u53ef\u8ffd\u6eaf\u6027\u3002\uff08\u7167\u7247\u7531 OGF \u63d0\u4f9b\uff09\u3002", "78964c2f48b6d9885a5e54faa6ed3a2e": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Rep\u00f3rter Brasil</a> \u5c06\u63d0\u9ad8\u4eba\u4eec\u5bf9\u62df\u8bae\u6cd5\u6848\u98ce\u9669\u7684\u8ba4\u8bc6\uff0c\u8fd9\u4e9b\u6cd5\u6848\u610f\u56fe\u5f00\u653e\u5df4\u897f\u539f\u4f4f\u6c11\u571f\u5730\u7528\u4e8e\u91c7\u77ff\u3001\u5927\u89c4\u6a21\u519c\u4e1a\u3001\u77f3\u6cb9\u548c\u5929\u7136\u6c14\u52d8\u63a2\u3001\u755c\u7267\u4e1a\u548c\u6c34\u7535\u5927\u575d\u5efa\u8bbe\u3002\u8fd9\u4e9b\u81ea\u7136\u8d44\u6e90\u5f00\u91c7\u884c\u4e3a\u53ef\u4ee5\u7531\u975e\u539f\u4f4f\u6c11\u4e3b\u4f53\u8fdb\u884c\uff0c\u5728\u67d0\u4e9b\u60c5\u51b5\u4e0b\uff0c\u5373\u4f7f\u53d7\u5f71\u54cd\u7684\u539f\u4f4f\u6c11\u793e\u533a\u53cd\u5bf9\u4e5f\u53ef\u4ee5\u7ee7\u7eed\u63a8\u8fdb\u3002\u8fd9\u662f\u73b0\u884c\u6cd5\u5f8b\u6240\u7981\u6b62\u7684\u60c5\u5f62\u3002Reporter Brazil \u5c06\u4f7f\u7528\u4ece GFW \u6536\u96c6\u5230\u7684\u8bc1\u636e\uff0c\u53d1\u5e03 3 \u7bc7\u62a5\u9053\uff0c\u7a81\u51fa\u8bf4\u660e\u73b0\u884c\u653f\u7b56\u548c\u62df\u8bae\u653f\u7b56\u5c06\u5982\u4f55\u52a0\u5267\u539f\u4f4f\u6c11\u5730\u533a\u4e2d\u4e9a\u9a6c\u5b59\u6d41\u57df\u53d7\u5230\u7684\u7834\u574f\u3002\uff08\u56fe\u7247\u7531\u6765\u81ea Reporter Brasil \u7684 Avener Prado \u63d0\u4f9b\uff09\u3002", "4ffdb4c7fe5baf3d0680ad2062c0ce01": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Amazon Conservation Association</a> (ACA) \u5728\u5176\u8fc7\u5f80 SGF \u9879\u76ee\u7684\u57fa\u7840\u4e0a\uff0c\u96c6\u4e2d\u7cbe\u529b\u5728\u4e9a\u9a6c\u5b59\u897f\u90e8\uff08\u73bb\u5229\u7ef4\u4e9a\u3001\u54e5\u4f26\u6bd4\u4e9a\u3001\u5384\u74dc\u591a\u5c14\u3001\u79d8\u9c81\u548c\u5df4\u897f\u897f\u90e8\uff09\u63a8\u5e7f\u5176 MAAP \u5206\u6790\uff0c\u4ee5\u5e94\u5bf9\u8be5\u5730\u533a\u65e5\u76ca\u4e25\u5cfb\u7684\u5a01\u80c1\u3002\u5728\u9879\u76ee\u4e2d\uff0cACA \u8fdb\u884c\u4e86\u5bf9 GLAD \u8b66\u62a5\u7cfb\u7edf\u7684\u9488\u5bf9\u6027\u5206\u6790\uff0c\u5feb\u901f\u786e\u5b9a\u6574\u4e2a\u4e9a\u9a6c\u5b59\u897f\u90e8\u68ee\u6797\u6ee5\u4f10\u4e8b\u4ef6\u7684\u7d27\u6025\u6848\u4f8b\u548c\u70ed\u70b9\uff0c \u8986\u76d6\u4e86\u9762\u79ef\u7ea6 580,000,000 \u516c\u9877\u7684\u4e9a\u9a6c\u5b59\u70ed\u5e26\u96e8\u6797\u3002\u7ecf\u8fc7\u4e0d\u65ad\u52aa\u529b\uff0c\u4ed6\u4eec\u53d1\u8868\u4e86 21 \u4efd\u9ad8\u5f71\u54cd\u529b\u7684 MAAP \u62a5\u544a\uff0c23 \u4efd\u63d0\u4ea4\u7ed9\u79d8\u9c81\u653f\u5e9c\u7684\u673a\u5bc6\u653f\u7b56\u7b80\u62a5\uff0c\u4ee5\u53ca 2 \u4efd\u91cd\u5927\u62a5\u544a\uff0c\u5305\u542b\u4e86\u65b0\u7f16\u5236\u7684\u4e9a\u9a6c\u5b59\u6d41\u57df\u68ee\u6797\u6ee5\u4f10\u548c\u539f\u59cb\u68ee\u6797\u635f\u5931\u70ed\u70b9\u5730\u56fe\u3002\uff08\u7167\u7247\u7531 ACA \u63d0\u4f9b\uff09", "2e8875020f5e11149e23fef875f97cf6": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">SAILD</a> \u4e13\u6ce8\u4e8e\u4fdd\u62a4\u5580\u9ea6\u9686 Deng Deng \u56fd\u5bb6\u516c\u56ed\u5185\u7684\u68ee\u6797\uff0c\u540c\u65f6\u52aa\u529b\u634d\u536b\u5f53\u5730\u539f\u4f4f\u6c11\u793e\u533a\u7684\u6743\u5229\u3002SAILD \u8fd0\u7528 GFW \u8bb0\u5f55\u4e86\u7531\u4e8e\u9686\u6f58\u5361\u5c14 (Lom Pangar) \u5927\u575d\u6d2a\u6c34\u9020\u6210\u7684\u8d85\u8fc7 36,000 \u516c\u9877\u7684\u68ee\u6797\u635f\u5931\uff0c\u5e76\u8c03\u67e5\u4e86\u4e0e\u571f\u5730\u51b2\u7a81\u3001\u6587\u5316\u8ba4\u540c\u4e27\u5931\u548c\u81ea\u7136\u8d44\u6e90\u7a00\u7f3a\u6709\u5173\u7684\u4e00\u7cfb\u5217\u793e\u4f1a\u95ee\u9898\u3002SAILD \u53d1\u5e03\u4e86\u5176\u9879\u76ee\u7eaa\u5f55\u7247 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Impacts of Lom Pangar Dam</a>\uff0c\u5e76\u57f9\u8bad\u4e86\u516b\u4f4d\u793e\u533a\u89c2\u5bdf\u5458\u548c\u516d\u540d\u65b0\u95fb\u8bb0\u8005\u4f7f\u7528 GFW\uff0c\u5c06\u5176\u4f5c\u4e3a\u76d1\u6d4b\u548c\u62a5\u9053\u5de5\u5177\u3002\u901a\u8fc7\u5ba3\u4f20\u5de5\u4f5c\uff0cSAILD \u5411\u5580\u9ea6\u9686\u5e7f\u5927\u516c\u4f17\u4ecb\u7ecd\u4e86\u5927\u575d\u5e26\u6765\u7684\u73af\u5883\u548c\u793e\u4f1a\u538b\u529b\uff0c\u4fc3\u4f7f\u5927\u575d\u7ba1\u7406\u516c\u53f8\u51fa\u9762\u516c\u5f00\u56de\u5e94\u3002\uff08\u56fe\u7247\u7531 SAILD \u63d0\u4f9b\uff09", "2e114908e803f0e1f5f58df3df2d51b5": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Amazonicos por la Amazonia</a> (AMPA) \u5c06\u8fd0\u7528 Global Forest Watch \u6570\u636e\u548c\u5de5\u5177\uff0c\u5728\u5723\u9a6c\u4e01\u5730\u533a\u5fd7\u613f\u548c\u793e\u533a\u4fdd\u62a4\u7f51\u7edc\u4e2d\u7684\u4fdd\u62a4\u884c\u52a8\u4e2d\u90e8\u7f72\u4e00\u4e2a\u7ba1\u63a7\u548c\u76d1\u7763\u7cfb\u7edf\u3002\u8be5\u7f51\u7edc\u7684\u6210\u5458\u5c06\u638c\u63e1\u5982\u4f55\u91c7\u96c6\u5b9e\u5730\u6570\u636e\uff0c\u5e76\u91c7\u53d6\u884c\u52a8\u5e94\u5bf9\u68ee\u6797\u635f\u5931\uff0c\u63d0\u9ad8\u4ed6\u4eec\u7ba1\u63a7\u548c\u76d1\u7763\u884c\u52a8\u7684\u6548\u7387\u3002\u9009\u5b9a\u6210\u5458\u5c06\u63a5\u53d7 GFW \u5e73\u53f0\u57f9\u8bad\uff0c\u9010\u6b65\u638c\u63e1\u81ea\u884c\u8bc6\u522b\u8b66\u62a5\u5e76\u4e3a\u6240\u5728\u7701\u4efd\u7684\u5176\u4ed6\u6210\u5458\u63d0\u4f9b\u534f\u52a9\u3002\u6b64\u5916\uff0c\u5730\u65b9\u3001\u533a\u57df\u548c\u56fd\u5bb6\u673a\u5173\u4e5f\u5c06\u4f7f\u7528\u68ee\u6797\u76d1\u6d4b\u548c\u8b66\u62a5\u7cfb\u7edf\u7684\u7ed3\u679c\u5c55\u5f00\u5ba3\u4f20\u3002\uff08\u56fe\u7247\u7531 AMPA \u63d0\u4f9b\uff09", "bf5d946261bac13b3ffbd25ae8481550": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Ambio</a> \u5c06\u4e0e\u81ea\u7136\u4fdd\u62a4\u5730\u59d4\u5458\u4f1a (Commission of Natural Protected Areas, CONANP) \u5408\u4f5c\uff0c\u57f9\u8bad 45 \u540d\u793e\u533a\u76d1\u6d4b\u5458\u4f7f\u7528\u548c\u7ba1\u7406 GFW \u5de5\u5177\u548c\u6570\u636e\uff0c\u4ece\u800c\u52a0\u5f3a\u5bf9\u6070\u5e15\u65af\u5dde 11 \u4e2a\u81ea\u7136\u4fdd\u62a4\u5730\u5171\u8ba1 845,942 \u516c\u9877\u7684\u571f\u5730\u4e0a\u68ee\u6797\u6ee5\u4f10\u4e8b\u4ef6\u7684\u9884\u9632\u3002Ambio \u5c06\u4e0e CONANP \u6574\u5408\u793e\u533a\u76d1\u6d4b\u5458\u6536\u96c6\u5230\u7684\u6570\u636e\uff0c\u4e3a\u9884\u9632\u68ee\u6797\u84dd\u5e06\u7684\u516c\u5171\u653f\u7b56\u63d0\u4f9b\u4fe1\u606f\u3002\uff08\u56fe\u7247\u7531 Ambio \u63d0\u4f9b\uff09\u3002", "e83b8343e8bffc51a21fefda41c6bcd1": "\u6b64\u5916\uff0cKWC \u8fd8\u5c06\u53c2\u4e0e\u793e\u533a\u675c\u5c14\u5df4\uff08\u4f20\u7edf\u793e\u533a\u96c6\u4f1a\uff09\uff0c\u4ee5\u63d0\u9ad8\u4eba\u4eec\u7684\u68ee\u6797\u4fdd\u62a4\u610f\u8bc6\uff0c\u5e76\u4e0e\u793e\u533a\u548c\u5176\u4ed6\u5229\u76ca\u76f8\u5173\u65b9\u5408\u4f5c\uff0c\u5229\u7528\u5730\u7406\u7a7a\u95f4\u6280\u672f\u4fdd\u62a4\u68ee\u6797\u8d44\u6e90\u3002&nbsp;", "cce019239898476e0db14e2e349100bb": "\u9ea6\u5fb7\u6797\u690d\u7269\u56ed\u5c06\u4e0e Institute of Hydrology, Meteorology and Environmental Studies (IDEAM) \u5c55\u5f00\u5408\u4f5c\uff0c\u90e8\u7f72\u4e00\u4e2a\u5f3a\u5927\u7684\u62a5\u544a\u7cfb\u7edf\uff0c\u80fd\u591f\u5229\u7528 IDEAM \u548c GFW \u7684\u4fe1\u606f\u81ea\u52a8\u751f\u6210\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\uff0c\u5e76\u5c06\u8fd9\u4e9b\u4fe1\u606f\u53d1\u9001\u81f3\u76f8\u5173\u73af\u5883\u90e8\u95e8\u3001\u8b66\u5bdf\u3001\u519b\u961f\u548c\u5a92\u4f53\u3002\u8fd0\u7528", "2659c9a9ca77c9854580d2c776762af1": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5370\u5c3c\u56fd\u9645\u52a8\u7269\u6551\u63f4\u57fa\u91d1\u4f1a (Yayasan IAR Indonesia, YIARI)</a> \u5c06\u81f4\u529b\u4e8e\u901a\u8fc7\u5f00\u53d1\u4e00\u5957\u8fd1\u5b9e\u65f6\u7efc\u5408\u68ee\u6797\u72af\u7f6a\u8b66\u62a5\u7cfb\u7edf (IFCAS)\uff0c\u52a0\u5f3a\u5bf9\u82cf\u95e8\u7b54\u814a\u5c9b\u6960\u699c\u7701\u548c\u5a46\u7f57\u6d32\u897f\u52a0\u91cc\u66fc\u4e39\u7701\u7684\u68ee\u6797\u4fdd\u62a4\u3002\u8be5\u9879\u76ee\u5c06\u5728 Batutegi \u4fdd\u62a4\u6797\u8bd5\u70b9\u4f7f\u7528\u8be5\u7cfb\u7edf\uff0c\u8be5\u5730\u533a\u5177\u6709\u91cd\u8981\u751f\u6001\u4ef7\u503c\uff0c\u662f\u82cf\u95e8\u7b54\u814a\u864e\u3001\u7a7f\u5c71\u7532\u548c\u8c98\u7b49\u4f17\u591a\u6fd2\u5371\u7269\u79cd\u548c\u65d7\u8230\u7269\u79cd\u7684\u6816\u606f\u5730\u3002\u6700\u7ec8\u76ee\u6807\u662f\u5c06\u8be5\u7cfb\u7edf\u63a8\u5e7f\u5230\u5370\u5ea6\u5c3c\u897f\u4e9a\u7684\u5176\u4ed6\u4fdd\u62a4\u533a\u3002", "a97756722efa264d9c3ccc36f5b6c9b9": "\u54e5\u4f26\u6bd4\u4e9a\u662f\u7f8e\u6d32\u70ed\u5e26\u5730\u533a\u68ee\u6797\u6ee5\u4f10\u7387\u6700\u9ad8\u7684\u56fd\u5bb6\u4e4b\u4e00\u3002\u6b64\u5916\uff0c\u54e5\u4f26\u6bd4\u4e9a\u4e5f\u662f\u73af\u4fdd\u6d3b\u52a8\u5bb6\u6b7b\u4ea1\u7387\u6700\u9ad8\u7684\u56fd\u5bb6\u4e4b\u4e00\u3002\u5b89\u8482\u5965\u57fa\u4e9a\u7701\u7684\u5e74\u5747\u68ee\u6797\u6ee5\u4f10\u7387\u4e3a", "91551fdbe4cd42e1769d1e808bbf3d46": "\u6d2a\u90fd\u62c9\u65af\u5883\u5185\u7684\u76ae\u79d1\u535a\u5c3c\u6258\u56fd\u5bb6\u516c\u56ed (Pico Bonito National Park, PBNP) \u662f\u62e5\u6709\u91cd\u8981\u7684\u68ee\u6797\u8d44\u6e90\u548c\u4e30\u5bcc\u7684\u751f\u7269\u591a\u6837\u6027\uff0c\u9700\u8981\u4eba\u4eec\u5bf9\u8fd9\u4e9b\u81ea\u7136\u8d44\u6e90\u8fdb\u884c\u6709\u6548\u7684\u68ee\u6797\u4fdd\u62a4\u548c\u53ef\u6301\u7eed\u7684\u8d44\u6e90\u5229\u7528\u3002\u7531\u4e8e\u8fd9\u4e9b\u68ee\u6797\u4e2d\u5b58\u5728\u7684\u975e\u6cd5\u6d3b\u52a8\u65e5\u76ca\u7316\u7357\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Forests of the World</a> \u6b63\u5728\u7ec4\u5efa\u4e00\u4e2a\u7531\u9752\u5e74\u73af\u4fdd\u8005\u6784\u6210\u7684\u7f51\u7edc\uff0c\u8ba9\u4ed6\u4eec\u53c2\u4e0e\u5bf9 PBNP \u4e24\u4e2a\u975e\u6cd5\u6ee5\u4f10\u6d3b\u52a8\u70ed\u70b9\u533a\u7684\u68ee\u6797\u76d1\u6d4b\u5de5\u4f5c\uff0c\u4ece\u800c\u6539\u5584\u68ee\u6797\u76d1\u6d4b\u548c\u7ba1\u7406\u5de5\u4f5c\uff0c\u589e\u5f3a\u5bf9\u8fd9\u4e9b\u91cd\u8981\u751f\u6001\u7cfb\u7edf\u7684\u4fdd\u62a4\u3002\u8fd9\u4e9b\u9752\u5e74\u5c06\u8fdb\u884c\u5b9e\u5730\u8003\u5bdf\uff0c\u6838\u5b9e GFW \u96c6\u6210\u7684\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u3002\u540c\u65f6\uff0c\u5730\u65b9\u548c\u533a\u57df\u76f8\u5173\u90e8\u95e8\u4e5f\u5c06\u63a5\u53d7\u57f9\u8bad\uff0c\u4e86\u89e3\u5982\u4f55\u4f7f\u7528 GFW \u5de5\u5177\uff0c\u52a0\u5f3a\u81ea\u8eab\u80fd\u529b\u5efa\u8bbe\uff0c\u5e76\u63a8\u52a8\u8fbe\u6210\u534f\u4f5c\u534f\u8bae\uff0c\u786e\u4fdd\u76f8\u5173\u90e8\u95e8\u5207\u5b9e\u53d7\u7406\u5e76\u67e5\u5904\u9752\u5e74\u7f51\u7edc\u4e3e\u62a5\u7684\u975e\u6cd5\u6ee5\u4f10\u6848\u4ef6\u3002", "6d2789a039e890bf7cf5669d48964c52": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Sarstoon Temash Institute for Indigenous Management</a> (SATIIM) \u4f7f\u7528 GFW \u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u4e3a\u4f2f\u5229\u5179\u548c\u5371\u5730\u9a6c\u62c9\u8fb9\u5883\u7684\u793e\u533a\u5b9a\u671f\u68ee\u6797\u5de1\u62a4\u63d0\u4f9b\u4fe1\u606f\u548c\u6307\u5bfc\u3002GFW \u6570\u636e\u548c\u5730\u56fe\u52a0\u4e4b\u5de1\u62a4\u671f\u95f4\u6536\u96c6\u7684\u6570\u636e\uff0c\u5171\u540c\u4f5c\u7528\uff0c\u4f7f\u6885\u65af\u8482\u7d22 (Mestizo)\u3001\u739b\u96c5 (Mayan) \u548c\u52a0\u91cc\u5bcc\u7eb3 (Garifuna) \u793e\u533a\u80fd\u66f4\u597d\u5730\u4e86\u89e3\u5176\u68ee\u6797\u4e2d\u9762\u4e34\u5a01\u80c1\u7684\u8303\u56f4\uff0c\u5e76\u66f4\u6709\u6548\u5730\u5021\u5bfc\u4fdd\u62a4\u5176\u571f\u5730\u6743\u5229\u3002\u8fd9\u4e9b\u5de5\u4f5c\u8fd8\u6709\u52a9\u4e8e\u52a0\u5f3a\u8fd9\u4e9b\u8de8\u56fd\u5883\u5b64\u7acb\u793e\u533a\u4e4b\u95f4\u7684\u5408\u4f5c\u5173\u7cfb\uff0c\u5e76\u6709\u52a9\u4e8e\u4ed6\u4eec\u4ee5\u96c6\u4f53\u6d3b\u52a8\uff0c\u53cd\u9a73\u67d0\u4e9b\u4eba\u8ba4\u4e3a\u739b\u96c5\u4eba\u5e94\u5bf9\u68ee\u6797\u780d\u4f10\u8d1f\u8d23\u7684\u89c2\u70b9\u3002\uff08\u56fe\u7247\u7531 SATIIM \u63d0\u4f9b\u3002\uff09", "b0afadb05a28bfd4d3e581ec13bb0659": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Center for Sustainable Economy</a> \u4f7f\u7528\u6765\u81ea GFW \u6811\u6728\u8986\u76d6\u635f\u5931\u5206\u6790\u7684\u8bc1\u636e\uff0c\u5f71\u54cd\u996e\u7528\u6c34\u548c\u91ce\u751f\u52a8\u7269\u6816\u606f\u5730\u4fdd\u62a4\u653f\u7b56\uff0c\u5e76\u5ba3\u4f20\u68ee\u6797\u5728\u51cf\u7f13\u6c14\u5019\u53d8\u5316\u65b9\u9762\u7684\u4f5c\u7528\u3002\u8be5\u7ec4\u7ec7\u8fd8\u63d0\u9ad8\u4e86\u516c\u6c11\u68ee\u6797\u76d1\u7763\u5458\u7684\u80fd\u529b\u5efa\u8bbe\uff0c\u4f7f\u4ed6\u4eec\u80fd\u591f\u8fd0\u7528 GFW \u4f5c\u4e3a\u76d1\u7763\u5de5\u5177\uff0c\u6267\u884c\u73b0\u6709\u6cd5\u5f8b\uff0c\u547c\u5401\u6539\u9769\uff0c\u5e76\u4fc3\u4f7f\u6728\u6750\u516c\u53f8\u5bf9\u6d88\u8d39\u8005\u548c\u6295\u8d44\u8005\u8d1f\u8d23\u3002\u8be5\u7ec4\u7ec7\u7684\u5de5\u4f5c\u6210\u679c\u5f97\u5230\u4e86\u5f53\u5730\u5a92\u4f53\u7684\u62a5\u9053\uff0c\u5176\u4e2d\u5c31\u5305\u62ec The Oregonian \u4e0a\u7684<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8fd9\u7bc7\u6587\u7ae0</a>\u3002\uff08\u56fe\u7247\u7531 Center for Sustainable Economy \u63d0\u4f9b\u3002\uff09", "eb7767caaad60be0713ae144eb23be94": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Reporter Brasil</a> \u6839\u636e GFW \u6570\u636e\u64b0\u5199\u4e86\u4e00\u7cfb\u5217\u8c03\u67e5\u6587\u7ae0\uff0c\u89e3\u91ca\u4e86\u4e9a\u9a6c\u5b59\u5730\u533a\u6c34\u7535\u7ad9\u7684\u5b9e\u9645\u6210\u672c\u3002\u5df4\u897f\u6b63\u5728\u4e9a\u9a6c\u5b59\u6d41\u57df\u5efa\u8bbe\u6570\u5341\u5ea7\u5927\u578b\u6c34\u7535\u7ad9\uff0c\u5176\u4e2d\u6700\u8457\u540d\u7684\u5c31\u662f\u6717\u591a\u5c3c\u4e9a\u5dde\u7684\u5409\u62c9\u4e4c (Jirau) \u5927\u575d\u548c\u5723\u5b89\u4e1c\u5c3c\u5965 (Santo Antonio) \u5927\u575d\uff0c\u4ee5\u53ca\u5e15\u62c9\u5dde\u7684\u8d1d\u9c81\u8499\u8482 (Belo Monte) \u5927\u575d\u3001\u7279\u5229\u65af\u76ae\u91cc\u65af (Teles Pires) \u5927\u575d\u548c\u5723\u66fc\u52aa\u57c3\u5c14 (Sao Manoel) \u5927\u575d\u3002\u8fd9\u4e9b\u53d1\u5c55\u603b\u662f\u4f34\u968f\u7740\u68ee\u6797\u6ee5\u4f10\u548c\u5bf9\u539f\u4f4f\u6c11\u571f\u5730\u6743\u5229\u7684\u4fb5\u72af\u3002Reporter Brasil \u5236\u4f5c\u5e76\u53d1\u884c\u4e86\u6df1\u5ea6\u65b0\u95fb\u8c03\u67e5\u62a5\u9053\uff0c\u5305\u62ec\u6263\u4eba\u5fc3\u5f26\u7684\u7f51\u7edc\u7eaa\u5f55\u7247\u3001\u52a8\u753b\u3001\u6587\u7ae0\u548c\u7167\u7247\u62a5\u9053\u3002\u90e8\u5206\u6587\u7ae0\u5df2\u88ab\u7ffb\u8bd1\u6210\u5176\u4ed6\u6587\u5b57\u5e76\u5728\u56fd\u9645\u4e0a\u5e7f\u6cdb\u4f20\u64ad\uff0c\u5176\u4e2d\u4e00\u7bc7\u6587\u7ae0\u5728\u793e\u4ea4\u5a92\u4f53\u4e0a\u5df2\u83b7\u5f97\u4e86\u8d85\u8fc7 300 \u4e07\u7684\u9605\u8bfb\u91cf\u3002\u67e5\u9605<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u94fe\u63a5</a>\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002\u7531\u6b64\u4ea7\u751f\u7684\u516c\u4f17\u538b\u529b\u6700\u7ec8\u5bfc\u81f4\u5df4\u897f\u653f\u5e9c\u542f\u52a8\u8c03\u67e5\uff0c\u5e76\u5bf9\u8d1d\u9c81\u8499\u8482\u5927\u575d\u627f\u5efa\u5546\u5904\u4ee5 300,000 \u7f8e\u5143\u7684\u7f5a\u6b3e\u3002\uff08\u56fe\u7247\u7531 Reporter Brasil \u63d0\u4f9b\u3002\uff09", "e6f4ce6710b7cf6c8873546f893a090d": "\u5728 1986 \u5e74\u5bf9 Panshet \u5927\u575d\u8fdb\u884c\u7684\u571f\u5730\u5229\u7528\u548c\u751f\u7269\u591a\u6837\u6027\u7814\u7a76\u7684\u57fa\u7840\u4e0a\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">The Ecological Society</a> \u91cd\u65b0\u8bc4\u4f30\u4e86\u5f53\u5730\u7684\u571f\u5730\u5229\u7528\uff0c\u5e76\u8bc4\u4f30\u4e86 Panshet \u5927\u575d\u6c47\u6c34\u533a\u7684\u751f\u6001\u72b6\u51b5\uff0c\u4ee5\u4fbf\u4e3a\u897f\u9ad8\u6b62\u5c71\u8109\u5317\u4fa7 (North-Western Ghats) \u7684\u4fdd\u62a4\u8ba1\u5212\u521b\u5efa\u4e00\u4e2a\u4fee\u590d\u6a21\u7248\u3002\u5229\u7528\u536b\u661f\u56fe\u50cf\u3001\u964d\u96e8\u91cf\u6570\u636e\u548c\u5730\u9762\u5b9e\u51b5\u8fdb\u884c\u7684\u7814\u7a76\u53d1\u73b0\uff0c\u4e0e 1986 \u5e74\u7814\u7a76\u7ed3\u679c\u76f8\u6bd4\uff0c\u53ea\u6709\u51e0\u4e2a\u5730\u5757\u4ecd\u5177\u5907\u201c\u7279\u6709\u548c\u7279\u6b8a\u7684\u751f\u7269\u591a\u6837\u6027\u201d\u3002\u8fd9\u8868\u660e\uff0c\u5176\u4f59\u5730\u5757\u4e9f\u9700\u4fdd\u62a4\u3002\u5229\u7528\u6536\u96c6\u5230\u7684\u6570\u636e\uff0cEcological Society \u5236\u5b9a\u4e86\u897f\u9ad8\u6b62\u5c71\u8109\u5317\u4fa7\u68ee\u6797\u4fee\u590d\u7684\u6a21\u677f\uff0c\u5e76\u5236\u4f5c\u4e86\u4e00\u6bb5<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u89c6\u9891</a>\u6765\u9610\u91ca\u4ed6\u4eec\u7684\u53d1\u73b0\u3002\uff08\u56fe\u7247\u6765\u81ea Ecological Society\uff0c\u5c55\u793a\u4e86\u4ed6\u4eec\u4e3a\u897f\u9ad8\u6b62\u5c71\u8109\u5317\u4fa7\u4fee\u590d\u9879\u76ee\u5236\u4f5c\u7684\u89c6\u9891\u3002\uff09", "2c802b7c6e88f9b40bb02e5f034d9446": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Amazonicos por la Amazonia</a> (AMPA) \u8fd0\u7528 Global Forest Watch \u6570\u636e\u548c\u5de5\u5177\uff0c\u5728\u5723\u9a6c\u4e01\u5730\u533a\u5fd7\u613f\u548c\u793e\u533a\u4fdd\u62a4\u7f51\u7edc\u4e2d\u7684\u4fdd\u62a4\u884c\u52a8\u4e2d\u90e8\u7f72\u4e86\u4e00\u4e2a\u7ba1\u63a7\u548c\u76d1\u7763\u7cfb\u7edf\u3002AMPA \u5efa\u8bbe\u4e86\u8be5\u7f51\u7edc\u7684\u80fd\u529b\uff0c\u4f7f\u5176\u80fd\u591f\u8fd0\u7528 GFW \u68ee\u6797\u6ee5\u4f10\u548c\u706b\u707e\u8b66\u62a5\u4ee5\u53ca\u5b9e\u5730\u6570\u636e\u76d1\u6d4b\u4fb5\u5360\u79c1\u4eba\u4fdd\u62a4\u533a\u73b0\u72b6\u3002\u8be5\u9879\u76ee\u6210\u529f\u5efa\u8bbe\u4e86\u4e00\u4e2a\u7ecf\u8fc7\u9a8c\u8bc1\u7684\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u6570\u636e\u5e93\uff0c\u7f51\u7edc\u6210\u5458\u53ef\u4f7f\u7528\u8be5\u6570\u636e\u5e93\u5411\u76f8\u5173\u90e8\u95e8\u63d0\u4ea4\u5faa\u8bc1\u7533\u8bc9\u3002AMPA \u53d1\u73b0\uff0c\u5c06\u8be5\u6280\u672f\u6574\u5408\u8fdb\u4ed6\u4eec\u7684\u76d1\u6d4b\u7cfb\u7edf\u53ef\u4ee5\u964d\u4f4e\u6210\u672c\uff0c\u4f7f\u76d1\u6d4b\u66f4\u5b89\u5168\u3001\u66f4\u9ad8\u6548\uff0c\u8fd8\u80fd\u6fc0\u53d1\u9752\u5e74\u53c2\u4e0e\u5176\u4e2d\u3002\uff08\u56fe\u7247\u7531 AMPA \u63d0\u4f9b\uff09", "837bd78aa6929a00b7f2a259ace9b9a4": "\u5728\u4e3e\u529e\u4e86\u5173\u4e8e GFW \u7684\u57f9\u8bad\u7814\u8ba8\u4f1a\u540e\uff0c\u9a6c\u6258\u683c\u7f57\u7d22\u5dde\u7684\u6728\u6750\u8054\u76df\u6210\u7acb\u4e86\u4e00\u4e2a\u76d1\u6d4b\u5de5\u4f5c\u7ec4\uff0c\u4ee5\u66f4\u597d\u5730\u8ffd\u8e2a\u975e\u6cd5\u4f10\u6728\u6d3b\u52a8\u3002\u6b64\u5916\uff0c\u56fd\u5bb6\u73af\u5883\u673a\u6784\u4e5f\u5f00\u59cb\u5bf9\u975e\u6cd5\u68ee\u6797\u7ecf\u8425\u8fdb\u884c\u6478\u5e95\u3002\uff08\u7167\u7247\u6765\u81ea ICV\uff1b\u5730\u56fe\u6765\u81ea ICV\uff0c\u5fc3\u4e8b\u4e86\u9a6c\u6258\u683c\u7f57\u7d22\u5dde\u7684\u4f10\u6728\u72b6\u51b5\u3002\uff09", "a06136b5f7f96a4eb1ce3cdb26b7b3bc": "Maya Leaders Alliance (MLA) \u4e0e <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Julian Cho Society</a> \u5408\u4f5c\uff0c\u5bf9\u6765\u81ea 39 \u4e2a\u6751\u5e84\u7684 69 \u540d\u9886\u5bfc\u4eba\u8fdb\u884c\u4e86\u57f9\u8bad\uff0c\u4f20\u6388\u4ed6\u4eec\u4f7f\u7528 Global Forest Watch \u548c\u5176\u4ed6\u6570\u5b57\u6d4b\u7ed8\u6280\u672f\u8fdb\u884c\u68ee\u6797\u76d1\u6d4b\u3002MLA \u4e0e\u5f53\u5730\u793e\u533a\u5408\u4f5c\uff0c\u7ed8\u5236\u4e86\u6570\u5e45\u63cf\u7ed8\u793e\u533a\u571f\u5730\u8fb9\u754c\u7684\u5730\u56fe\uff0c\u5e76\u5236\u5b9a\u4e86\u627f\u8ba4\u8fd9\u4e9b\u8fb9\u754c\u7684\u534f\u8bae\u6a21\u677f\uff0c\u4ee5\u4f9b\u76f8\u90bb\u793e\u533a\u7b7e\u7f72\uff0c\u4ece\u800c\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u51b2\u7a81\u53ef\u80fd\u3002", "23ac7a60c54e8ebf21905c825de3c379": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Perkumpulan Rincong</a> \u7684\u76ee\u6807\u662f\u8ba9\u5370\u5ea6\u5c3c\u897f\u4e9a\u4e9a\u9f50\u7701\u4e4c\u9c81\u9a6c\u68ee\u68ee\u6797 (Ulu Masen Forest) \u5468\u8fb9\u4f9d\u9760\u68ee\u6797\u4e3a\u751f\u7684\u793e\u533a\u80fd\u591f\u4f7f\u7528 GFW \u4e86\u89e3\u3001\u4fdd\u62a4\u548c\u6539\u5584\u4ed6\u4eec\u7684\u81ea\u7136\u8d44\u6e90\uff0c\u5bf9\u4ed6\u4eec\u7684\u4f20\u7edf\u68ee\u6797\u8fdb\u884c\u53ef\u6301\u7eed\u7684\u7ba1\u7406\u3002\u8be5\u9879\u76ee\u5305\u62ec\u57f9\u8bad\u539f\u4f4f\u6c11\u5de1\u6797\u5458\u5229\u7528 GFW \u6570\u636e\u8fdb\u884c\u6709\u9488\u5bf9\u6027\u7684\u5de1\u903b\uff0c\u5e76\u5236\u5b9a\u68ee\u6797\u7ba1\u7406\u8ba1\u5212\u3002\u5728\u4e00\u4e2a\u793e\u533a\uff0cPerkumpulan Rincong \u6210\u529f\u5f00\u59cb\u4e86\u793e\u533a\u571f\u5730\u5229\u7528\u5206\u533a\u8fdb\u7a0b\uff0c\u5e2e\u52a9\u793e\u533a\u6210\u5458\u786e\u5b9a\u9700\u8981\u4fdd\u62a4\u7684\u533a\u57df\uff08\u5982\u539f\u59cb\u68ee\u6797\uff0c\u4ee5\u53ca\u6b21\u751f\u6797\u7684\u7279\u5b9a\u533a\u57df\uff09\uff0c\u4ee5\u53ca\u9002\u5408\u6e38\u8015\u519c\u4e1a\u7684\u533a\u57df\u3002\uff08\u7167\u7247\u6765\u81ea Perkumpulan Rincong\u3002\uff09", "2c690c61c137142a97537518028c426e": "\u5021\u5bfc\uff0c\u68ee\u6797\u76d1\u6d4b\u548c\u6267\u6cd5", "c20bf5ab456626e2c78208bd4b2799f3": "\u52a0\u7eb3\u897f\u90e8\u7684\u5854\u79d1\u62c9\u8fea\u6797\u533a\u6709\u4e24\u5ea7\u4e3b\u8981\u7684\u68ee\u6797\uff1a\u4e09\u5cac\u89d2\u68ee\u6797\u4fdd\u62a4\u533a (Cape Three Points Forest Reserve, CTPFR) \u548c\u82cf\u5e03\u91cc\u6cb3\u68ee\u6797\u4fdd\u62a4\u533a (Subri River Forest Reserve, SRFR)\u3002\u5c3d\u7ba1\u8fd9\u4e24\u5ea7\u4fdd\u62a4\u533a\u751f\u7269\u591a\u6837\u6027\u6781\u4e3a\u4e30\u5bcc\uff0c\u4f46\u7531\u4e8e\u975e\u6cd5\u91c7\u77ff\u6d3b\u52a8\u548c\u4f10\u6728\uff0c\u5176\u751f\u6001\u5b8c\u6574\u6027\u6b63\u5728\u9762\u4e34\u4e0e\u65e5\u4ff1\u589e\u7684\u5a01\u80c1\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hen Mpoano</a> \u5c06\u57f9\u517b\u793e\u533a\u548c\u68ee\u6797\u7ba1\u7406\u5458\u5728\u68ee\u6797\u76d1\u6d4b\u65b9\u9762\u7684\u80fd\u529b\uff0c\u901a\u8fc7\u52a0\u5f3a\u793e\u533a\u76d1\u6d4b\u548c\u5bf9\u68ee\u6797\u4fdd\u62a4\u6cd5\u89c4\u7684\u6709\u6548\u6267\u884c\uff0c\u51cf\u5c11\u5854\u79d1\u62c9\u8fea\u6797\u533a\u7684\u6ee5\u4f10\u73b0\u8c61\u3002\uff08\u56fe\u7247\u7531 Hen Mpoano \u63d0\u4f9b\uff09", "dcc9a84d062bae8fe7366a9360d31978": "\u65b0\u95fb\uff0c\u5021\u5bfc", "48d773558c111e2e562401ccc720c55a": "Christel Scheske \u662f\u79d8\u9c81\u73af\u5883\u6cd5\u534f\u4f1a (SPDA)  Conservamos por Naturaleza \u5021\u8bae\u7684\u9879\u76ee\u534f\u8c03\u5458\u3002\u5728\u83b7\u5f97 GFW \u6280\u672f\u7814\u7a76\u91d1\u671f\u95f4\uff0cChristel \u4e0e\u79d1\u5361\u94a6\u74e6\u793e\u533a\u5408\u4f5c\uff0c\u652f\u6301\u4e86\u4e00\u9879\u751f\u6001\u7cfb\u7edf\u670d\u52a1\u4ed8\u8d39\u8ba1\u5212\uff0c\u4ee5\u4fdd\u62a4\u79d8\u9c81\u4e9a\u9a6c\u5b59\u5730\u533a\u7684\u6208\u514b\u5854\u7011\u5e03\u3002\u6208\u514b\u5854\u7011\u5e03\u9ad8 771 \u7c73\uff0c\u662f\u4e16\u754c\u4e0a\u7b2c 16 \u9ad8\u7684\u7011\u5e03\uff0c\u5df2\u6210\u4e3a\u79d1\u5361\u94a6\u74e6\u4e3b\u8981\u7684\u65c5\u6e38\u666f\u70b9\u548c\u91cd\u8981\u7684\u6536\u5165\u6765\u6e90\u3002Christel \u8fd0\u7528 GFW \u5de5\u5177\u5e2e\u52a9\u7ed8\u5236\u4e86\u6208\u514b\u5854\u7011\u5e03\u7684\u6c47\u6c34\u7cfb\u7edf\uff0c\u63d0\u4f9b\u4e86\u57fa\u7ebf\u73af\u5883\u6570\u636e\uff0c\u52a0\u6df1\u4e86\u5bf9\u8be5\u5730\u533a\u571f\u5730\u4f7f\u7528\u6743\u7684\u4e86\u89e3\u3002\u6b64\u5916\uff0c\u5979\u7684\u5de5\u4f5c\u8fd8\u63d0\u9ad8\u4e86\u79d1\u5361\u94a6\u74e6\u793e\u533a\u76d1\u6d4b\u6208\u514b\u5854\u7011\u5e03\u5468\u8fb9\u6e7f\u5730\u548c\u539f\u59cb\u68ee\u6797\u7684\u6280\u672f\u80fd\u529b\u3002\uff08\u7167\u7247\u7531 Christel Scheske \u63d0\u4f9b\uff09", "4e7ce82336057681404be565b788a276": "Johan Hardjopawiro \u662f\u82cf\u91cc\u5357\u4e9a\u9a6c\u5b59\u4fdd\u62a4\u56e2\u961f (ACT-S) \u7684\u4e00\u540d\u62a4\u6797\u4eba\u3002Johan \u5728\u6797\u4e1a\u9886\u57df\u5de5\u4f5c\u4e86 20 \u4f59\u5e74\uff0c\u81f4\u529b\u4e8e\u5efa\u8bbe\u5f53\u5730\u519c\u6751\u793e\u533a\u4fdd\u62a4\u68ee\u6797\u7684\u80fd\u529b\u3002\u5728 GFW \u6280\u672f\u7814\u7a76\u91d1\u9879\u76ee\u671f\u95f4\uff0cJohan \u4e0e\u5c45\u4f4f\u5728\u82cf\u91cc\u5357\u4e2d\u90e8\u70ed\u5e26\u96e8\u6797\u7684\u539f\u4f4f\u6c11\u793e\u533a Matawai \u5408\u4f5c\uff0c\u5efa\u7acb\u4e86\u4e00\u4e2a\u53ef\u6301\u7eed\u68ee\u6797\u7ba1\u7406\u76d1\u6d4b\u9879\u76ee\u3002Johan \u5bf9 Matawai \u5f00\u5c55\u4e86\u5173\u952e\u68ee\u6797\u76d1\u6d4b\u6d3b\u52a8\u65b9\u9762\u7684\u57f9\u8bad\uff0c\u5982 GPS \u6d4b\u7ed8\uff0c\u4e86\u89e3\u82cf\u91cc\u5357\u4f10\u6728\u627f\u5305\u5546\u5fc5\u987b\u9075\u5b88\u7684\u5b9e\u8df5\u51c6\u5219\u3002Johan \u4ecd\u5728\u5efa\u8bbe\u53ef\u6301\u7eed\u7684\u68ee\u6797\u7ba1\u7406\u9879\u76ee\uff0c\u5e76\u8ba1\u5212\u4f7f\u7528 Global Forest Watch \u548c Forest Watcher \u5e94\u7528\u4f5c\u4e3a\u8be5\u9879\u76ee\u7684\u5173\u952e\u5de5\u5177\u3002\uff08\u7167\u7247\u7531 Johan Hardjopawiro \u63d0\u4f9b\uff09\u3002", "b0c72f4a25d65695c2e4a282c47fd315": "Tatiana NGANGOUM NANA \u662f\u5580\u9ea6\u9686\u51cf\u5c11\u53d1\u5c55\u4e2d\u56fd\u5bb6\u6bc1\u6797\u548c\u68ee\u6797\u9000\u5316\u6392\u653e (REDD+) \u6280\u672f\u79d8\u4e66\u5904\u76d1\u6d4b\u3001\u62a5\u544a\u548c\u6838\u67e5\u90e8\u95e8\u7684 GIS \u548c\u9065\u611f\u4e13\u5bb6\u3002\u5728\u83b7\u5f97 GFW \u6280\u672f\u7814\u7a76\u91d1\u671f\u95f4\uff0cTatiana \u5c06 GFW \u5de5\u5177\u7eb3\u5165\u4e86\u5979\u5728\u5580\u9ea6\u9686 REDD+ \u51cf\u6392\u8ba1\u5212 (ERP) \u5730\u533a\u7684\u68ee\u6797\u76d1\u6d4b\u548c GIS \u5de5\u4f5c\u3002Tatiana \u8fd0\u7528 GLAD \u8b66\u62a5\u548c GFW \u5e73\u53f0\u76d1\u6d4b ERP \u5730\u533a\u7684\u68ee\u6797\u8986\u76d6\u635f\u5931\uff0c\u5e76\u7528\u4ee5\u533a\u5206\u4e86\u690d\u88ab\u635f\u5931\u4e2d\u68ee\u6797\u6ee5\u4f10\u548c\u68ee\u6797\u9000\u5316\u8fd9\u4e24\u79cd\u4e0d\u540c\u7279\u5f81\u3002\u57fa\u4e8e\u8be5\u7814\u7a76\uff0cTatiana \u5411\u653f\u5e9c\u548c\u975e\u653f\u5e9c\u4e3b\u4f53\u5c55\u793a\u4e86\u9488\u5bf9\u5580\u9ea6\u9686\u4f10\u6728\u548c\u519c\u4e1a\u6d3b\u52a8\u8fd9\u4e24\u79cd\u68ee\u6797\u6ee5\u4f10\u4e3b\u8981\u52a8\u56e0\u91c7\u53d6\u884c\u52a8\u7684\u5fc5\u8981\u6027\u3002\u5979\u8fd8\u4e3a\u5404\u79cd\u6c11\u95f4\u793e\u4f1a\u56e2\u4f53\u4e3e\u529e\u4e86\u591a\u6b21\u5173\u4e8e\u4f7f\u7528 GFW \u548c GLAD \u8b66\u62a5\u7684\u57f9\u8bad\u3002\uff08\u7167\u7247\u7531 Tatiana NGANGOUM NANA \u63d0\u4f9b\uff09\u3002", "ef219a286c2cf851d0ac8cc019e80a0e": "\u8bb8\u591a\u8de8\u56fd\u516c\u53f8\u90fd\u5df2\u627f\u8bfa\u4e0d\u6ee5\u4f10\u68ee\u6797\uff0c\u5305\u62ec\u627f\u8bfa\u4f1a\u4fdd\u62a4\u519c\u4e1a\u548c\u6797\u4e1a\u751f\u4ea7\u533a\u7684\u9ad8\u4fdd\u62a4\u4ef7\u503c (High Conservation Value, HCV) \u548c\u9ad8\u78b3\u50a8\u91cf (High Carbon Stock, HCS) \u68ee\u6797\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">HCV Resource Network</a> \u8fd0\u7528 Global Forest Watch (GFW)\uff0c\u7ed8\u5236\u4e86\u5728 HCV-HCS \u7efc\u5408\u8bc4\u4f30\u4e2d\u786e\u5b9a\u7684 HCV \u533a\u57df\u548c HCS \u68ee\u6797\u3002\u4ed6\u4eec\u7684\u5de5\u4f5c\u4fc3\u6210\u4e86\u5feb\u901f\u54cd\u5e94\u534f\u8bae (Rapid Response Protocol) \u7684\u5236\u5b9a\uff0c\u8be5\u534f\u8bae\u6574\u5408\u4e86 GFW \u7684 GLAD \u548c VIIRS \u6d3b\u8dc3\u706b\u707e\u8b66\u62a5\uff0c\u4ee5\u4fbf\u79cd\u690d\u8005\u3001\u6c11\u95f4\u793e\u4f1a\u7ec4\u7ec7\u3001\u8ba4\u8bc1\u673a\u6784\u6216\u5176\u4ed6\u5229\u76ca\u76f8\u5173\u65b9\u53ef\u5bf9 HCV \u533a\u57df\u548c HCS \u68ee\u6797\u4e2d\u63a2\u6d4b\u5230\u7684\u68ee\u6797\u5a01\u80c1\u8fdb\u884c\u76d1\u6d4b\u5e76\u4f5c\u51fa\u54cd\u5e94\u3002HCVRN \u8fd8\u4e0e Roundtable on Sustainable Palm Oil (RSPO) \u5408\u4f5c\uff0c\u4f7f\u7528 Global Forest Watch Pro \u5728 RSPO \u8ba4\u8bc1\u7684\u79cd\u690d\u56ed\u91cc\u90e8\u7f72\u76d1\u6d4b\u534f\u8bae\u3002\uff08\u7167\u7247\u7531\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240\u63d0\u4f9b\u3002\uff09", "31ce5f901fc032e96b9dbb2701d68ee6": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Rainforest Foundation US</a>\uff0c\u4e0e\u79d8\u9c81\u56fd\u5bb6\u4fdd\u62a4\u533a\u7ba1\u7406\u5c40 (Peru National Protected Area Service, SERNANP) \u548c\u5f53\u5730\u539f\u4f4f\u6c11\u793e\u533a\u76f4\u63a5\u5408\u4f5c\uff0c\u901a\u8fc7\u73af\u5883\u90e8\u7684 Geobosques \u7cfb\u7edf\u8bbf\u95ee GLAD \u8b66\u62a5\uff0c\u786e\u5b9a\u62e5\u6709\u9886\u5730\u7684\u539f\u4f4f\u6c11\u793e\u533a\u548c\u8fea\u7ef4\u7d22\u5c14\u5c71\u8109\u56fd\u5bb6\u516c\u56ed (Sierra del Divisor National Park) \u4e2d\u53d1\u751f\u7684\u68ee\u6797\u6ee5\u4f10\u4e8b\u4ef6\u3002Rainforest Foundation US \u4e3a SERNANP \u63d0\u4f9b\u652f\u6301\uff0c\u5e76\u57f9\u8bad\u793e\u533a\u76d1\u6d4b\u5458\u767b\u5f55 Forest Watcher \u624b\u673a\u5e94\u7528\u7a0b\u5e8f\u3001\u4f7f\u7528\u65e0\u4eba\u673a\u5bf9\u8b66\u62a5\u8fdb\u884c\u6838\u67e5\uff0c\u5e76\u7f16\u5236\u62a5\u544a\u3002\u8fd9\u4e9b\u62a5\u544a\u5df2\u4f5c\u4e3a\u7533\u8bc9\u6210\u529f\u63d0\u4ea4\u81f3\u5730\u533a\u73af\u5883\u68c0\u5bdf\u5b98\uff0c\u4ee5\u4fbf\u91c7\u53d6\u6267\u6cd5\u884c\u52a8\uff0c\u6216\u5728\u539f\u4f4f\u6c11\u7ba1\u7406\u533a\u8fdb\u884c\u5185\u90e8\u5904\u7406\u3002\u7ecf\u8fc7\u52aa\u529b\uff0c\u4ed6\u4eec\u8fd8\u5728\u539f\u4f4f\u6c11\u793e\u533a\u9886\u5730\u4ea4\u754c\u5904\u53d1\u73b0\u4e86\u51e0\u5904\u975e\u6cd5\u53e4\u67ef\u79cd\u690d\u70b9\uff0c\u5728\u4e0e\u76f8\u5173\u90e8\u95e8\u7684\u914d\u5408\u4e0b\uff0c\u8fd9\u4e9b\u79cd\u690d\u70b9\u5747\u5df2\u88ab\u6363\u6bc1\u6216\u5728\u8c03\u67e5\u4e2d\u3002RFUS \u8fd8\u652f\u6301\u6587\u5316\u90e8\u8fd0\u7528\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u66f4\u597d\u5730\u7406\u89e3\u539f\u4f4f\u6c11\u5bf9\u68ee\u6797\u7684\u4f20\u7edf\u5229\u7528\u65b9\u5f0f\uff0c\u5e76\u63d0\u5021\u5728\u5408\u6cd5\u8303\u56f4\u5185\u6269\u5927\u539f\u4f4f\u6c11\u9886\u5730\u3002\uff08\u56fe\u7247\u6765\u81eaRainforest Foundation US\uff09", "a18dd0e9c0847d422b24292852c46d8e": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Organizaci\u00f3n Regional de Pueblos Ind\u00edgenas del Oriente</a> (ORPIO) \u662f\u4e00\u4e2a\u4ee3\u8868\u79d8\u9c81\u897f\u90e8\u539f\u4f4f\u6c11\u7684\u7ec4\u7ec7\uff0cORPIO \u5c06\u4e0e\u5f53\u5730\u7684\u539f\u4f4f\u6c11\u8054\u5408\u4f1a FECONATIYA \u5408\u4f5c\u5efa\u8bbe\u5176\u793e\u533a\u7684\u68ee\u6797\u76d1\u6d4b\u80fd\u529b\uff0c\u4ee5\u5e94\u5bf9\u6d1b\u96f7\u6258\u5927\u533a\u4e0a\u9a6c\u7ea6\u9c81\u7eb3\u548c\u8482\u683c\u96f7\u6cb3\u6d41\u57df\u975e\u6cd5\u4f10\u6728\u8005\u7684\u5165\u4fb5\u548c\u6ee5\u4f10\u6d3b\u52a8\u3002\u901a\u8fc7\u4e3a\u539f\u4f4f\u6c11\u793e\u533a\u914d\u5907 GFW \u5de5\u5177\uff0cORPIO \u5c06\u51cf\u7f13\u68ee\u6797\u6ee5\u4f10\u548c\u975e\u6cd5\u5165\u4fb5\u7684\u901f\u5ea6\uff0c\u5e76\u786e\u4fdd\u4e3a\u8be5\u5730\u533a\u5236\u5b9a\u957f\u671f\u7684\u76d1\u6d4b\u548c\u54cd\u5e94\u7b56\u7565\u3002\uff08\u56fe\u7247\u7531 ORPIO \u63d0\u4f9b\uff09\u3002", "506604431b838956a5021f97d0800ed6": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Pledge Ghana</a> \u5c06\u63d0\u9ad8\u52a0\u7eb3\u7684 5,000 \u540d\u5c0f\u519c\u53ef\u53ef\u79cd\u690d\u8005\u53ca\u5176\u751f\u4ea7\u8005\u5408\u4f5c\u793e\u7684\u80fd\u529b\uff0c\u8ba9\u4ed6\u4eec\u80fd\u591f\u5229\u7528 GFW \u5de5\u5177\u6765\u68c0\u6d4b\u548c\u7ba1\u7406\u53ef\u53ef\u751f\u4ea7\u533a\u7684\u519c\u573a\u548c\u4fdd\u62a4\u533a\u7f13\u51b2\u533a\uff0c\u5e76\u91c7\u53d6\u884c\u52a8\u963b\u6b62\u6ee5\u4f10\u884c\u4e3a\u3002\u8fd9\u5c06\u63d0\u9ad8\u53ef\u53ef\u751f\u4ea7\u529b\uff0c\u51cf\u5c11\u571f\u5730\u8fc7\u5ea6\u6269\u5f20\uff0c\u4ece\u800c\u786e\u4fdd\u91cd\u8981\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u5f97\u5230\u4fdd\u62a4\u3002\u5176\u76ee\u6807\u662f\u51cf\u5c11\u52a0\u7eb3\u53ef\u53ef\u751f\u4ea7\u884c\u4e1a\u5bfc\u81f4\u7684\u68ee\u6797\u6ee5\u4f10\u3002\uff08\u56fe\u7247\u7531 Pledge Ghana \u63d0\u4f9b\uff09\u3002", "fd1042682224213a2b96e694eb380712": "\u5370\u5c3c\u6960\u699c\u7701\u7684 Kotaagung Utara \u68ee\u6797\u7ba1\u7406\u5355\u4f4d (FMU) \u6b63\u9762\u4e34\u591a\u79cd\u5a01\u80c1\uff0c\u5305\u62ec\u68ee\u6797\u6ee5\u4f10\u3001\u975e\u6cd5\u4f10\u6728\u548c\u4e0d\u53ef\u6301\u7eed\u7684\u8015\u4f5c\u65b9\u5f0f\u7b49\u3002\u4e3a\u5e2e\u52a9\u5e94\u5bf9\u8fd9\u4e9b\u5a01\u80c1\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Rainforest Alliance</a> \u5c06\u4e3a\u6765\u81ea FMU \u548c\u793e\u4f1a\u6797\u4e1a\u56e2\u4f53\u7684\u62a4\u6797\u5458\u63d0\u4f9b\u80fd\u529b\u5efa\u8bbe\u548c\u57f9\u8bad\uff0c\u8ba9\u4ed6\u4eec\u80fd\u591f\u76d1\u6d4b\u5e76\u5e94\u5bf9 Kotaagung Utara FMU \u6240\u9762\u4e34\u7684\u68ee\u6797\u5e72\u6270\u6d3b\u52a8\u3002\u5176\u76ee\u6807\u662f\u5728\u9879\u76ee\u7ed3\u675f\u65f6\uff0c\u5c06 Kotaagung Utara FMU \u7ba1\u8f96\u7684\u539f\u59cb\u6797\u548c\u6b21\u751f\u6797\u7684 GLAD \u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u6570\u91cf\u51cf\u5c11 50%\u3002\uff08\u56fe\u7247\u7531 Rainforest Alliance \u63d0\u4f9b\uff09\u3002", "e374debcd9af9c9746dbac8c95e2cf7d": "\u901a\u8fc7\u4e0e\u73af\u5883\u65b0\u95fb\u8c03\u67e5\u673a\u6784 Oxpeckers \u5408\u4f5c\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Code for Africa</a> \u5c06\u57f9\u8bad 8-10 \u540d\u4e2d\u975e\u6570\u636e\u65b0\u95fb\u8bb0\u8005\u4f7f\u7528 GLAD &amp; VIIRS \u8b66\u62a5\u3001GFW \u5de5\u5177\u53ca\u5176\u4ed6\u80cc\u666f\u6570\u636e\u96c6\uff0c\u7528\u4ee5\u8c03\u67e5\u3001\u7f16\u5199\u5e76\u53d1\u5e03\u4e00\u7cfb\u5217\u5173\u4e8e\u5580\u9ea6\u9686\u3001\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u53ca\u4e4c\u5e72\u8fbe\u5883\u5185\u68ee\u6797\u6ee5\u4f10\u7684\u6570\u636e\u65b0\u95fb\u9879\u76ee\u3002\uff08\u7167\u7247\u7531 Code for Africa \u63d0\u4f9b\uff09", "cf480b60dfadbfa77d9fe6e5e3f5ad78": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">EII</a> \u5c06\u652f\u6301\u5723\u7ef4\u68ee\u7279\u5fb7\u5c14\u5361\u53e4\u5b89\u5e02\u653f\u5e9c\u6709\u6548\u5b9e\u65bd\u4e00\u9879\u6587\u4ef6\uff0c\u8be5\u6587\u4ef6\u8981\u6c42\u5f53\u5730\u7684\u201c\u793e\u533a\u884c\u52a8\u59d4\u5458\u4f1a\u201d\u4e0e\u5e02\u653f\u5e9c\u548c\u5730\u533a\u653f\u5e9c\u534f\u4f5c\u4fdd\u62a4\u56fd\u5bb6\u4fdd\u62a4\u5730\uff0c\u5236\u6b62\u68ee\u6797\u6ee5\u4f10\u3002EII \u5c06\u57f9\u8bad Pato River Municipal Settlers Association (AMCOP) \u7684 50 \u540d\u6210\u5458\u4f7f\u7528 GFW \u7684\u9884\u8b66\u5de5\u5177\uff0c\u76d1\u6d4b\u68ee\u6797\u6ee5\u4f10\u4e8b\u4ef6\u5e76\u6536\u96c6\u8bc1\u636e\uff0c\u5e76\u534f\u540c\u5723\u7ef4\u68ee\u7279\u5fb7\u5c14\u5361\u53e4\u5b89\u5e02\u653f\u5e9c\u91c7\u53d6\u5e94\u5bf9\u884c\u52a8\u3002\uff08\u56fe\u7247\u7531 EII \u63d0\u4f9b\uff09\u3002", "12647f47418971de6228da31ce038ec3": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">HAkA</a> \u5c06\u7ee7\u7eed\u5b8c\u6210\u4ed6\u4eec\u5728\u7b2c\u4e00\u4e2a SGF \u9879\u76ee\u4e2d\u7684\u5de5\u4f5c\uff0c\u652f\u6301\u5e76\u5efa\u8bbe\u4e9a\u9f50\u7701\u6797\u4e1a\u653f\u5e9c\u673a\u6784\u7684\u76d1\u6d4b\u80fd\u529b\uff0c\u5c24\u5176\u662f\u68ee\u6797\u7ba1\u7406\u5355\u4f4d (Forest Management Unit, KPH) \u548c\u56fd\u5bb6\u516c\u56ed\u7ba1\u7406\u5c40 (National Park Agency, BPTN)\u3002\u901a\u8fc7\u8be5\u9879\u76ee\uff0c\u4ed6\u4eec\u5c06\u7ec4\u5efa\u8054\u5408\u4f8b\u884c\u76d1\u6d4b\u5de1\u903b\u961f\uff0c\u5e76\u65bd\u884c GLAD \u4f18\u5148\u6392\u5e8f\u6cd5\uff0c\u4ee5\u786e\u5b9a\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf\u6700\u4e25\u91cd\u7684\u6ee5\u4f10\u70ed\u70b9\u3002\u6b64\u5916\uff0cHAkA \u5c06\u57f9\u8bad\u65b0\u95fb\u8bb0\u8005\u548c\u533a\u7ea7\u3001\u7701\u7ea7\u8b66\u5bdf\u4f7f\u7528 GFW\uff0c\u63d0\u9ad8\u4eba\u4eec\u5bf9\u8be5\u666f\u89c2\u5b58\u5728\u7684\u6ee5\u4f10\u4e8b\u4ef6\u7684\u5173\u6ce8\u5ea6\u3002\uff08\u56fe\u7247\u7531 HAKA \u63d0\u4f9b\uff09\u3002", "f8ffd84a396b881a5697b85952273e3f": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">KUASA</a> \u5c06\u5efa\u8bbe\u534a\u5c9b\u539f\u4f4f\u6c11\u793e\u533a\u7684\u68ee\u6797\u76d1\u6d4b\u80fd\u529b\uff0c\u4ee5\u589e\u5f3a\u961f\u9a6c\u6765\u897f\u4e9a\u8482\u8482\u65fa\u6c99\u4e2d\u592e\u68ee\u6797\u810a\u7ebf\u7684\u68ee\u6797\u7ba1\u7406\u3002\u5176\u76ee\u6807\u662f\u4e3a\u534a\u5c9b\u539f\u4f4f\u6c11\u8d4b\u80fd\uff0c\u4f7f\u4ed6\u4eec\u80fd\u79ef\u6781\u4e3b\u52a8\u5730\u4fdd\u62a4\u4ed6\u4eec\u7684\u68ee\u6797\u8d44\u6e90\u548c\u793e\u533a\u9886\u5730\uff0c\u907f\u514d\u5b83\u4eec\u906d\u5230\u4e0d\u53ef\u6301\u7eed\u7684\u5f00\u53d1\u3002\u8be5\u9879\u76ee\u8fd8\u6d89\u53ca\u534a\u5c9b\u539f\u4f4f\u6c11\u4e0e\u8054\u90a6\u548c\u5dde\u653f\u5e9c\u90e8\u95e8\u3001\u5730\u65b9\u8bae\u4f1a\u548c\u5176\u4ed6\u76f8\u5173\u673a\u6784\u8fdb\u884c\u4e00\u7cfb\u5217\u78cb\u5546\u548c\u5ba3\u4f20\u4f1a\u8bae\u3002\uff08\u56fe\u7247\u7531\u6765\u81ea KUASA \u7684 Persatuan Aktivis Sahabat Alam \u63d0\u4f9b\uff09", "54e3aa66a187695ea19ddc730e704cda": "\u82cf\u91cc\u5357\u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Amazon Conservation Team</a> (ACT-Suriname) \u8fd0\u7528 GFW Forest Watcher \u548c Map Builder \u4e3a\u82cf\u91cc\u5357\u7684\u4e00\u4e2a\u8fb9\u5883\u793e\u533a\u2014\u2014\u4f4d\u4e8e\u4e0a\u8428\u62c9\u9a6c\u5361\u5730\u533a\u7684 Matawai Maroon \u7684\u4e9a\u9a6c\u5b59\u4fdd\u62a4\u5de1\u6797\u5458 (ACRs) \u5f00\u5c55\u57f9\u8bad\uff0c\u4ee5\u4fdd\u62a4\u548c\u76d1\u6d4b\u4ed6\u4eec\u7684\u9886\u5730\uff0c\u907f\u514d\u9886\u5730\u906d\u5230\u91c7\u77ff\u6d3b\u52a8\u548c\u8fc7\u5ea6\u91c7\u4f10\u7684\u4fb5\u6270\u3002\u4ed6\u4eec\u8fd8\u4e3a\u82cf\u91cc\u5357\u5357\u90e8\u4ecd\u5904\u4e8e\u539f\u59cb\u72b6\u6001\u7684 Sipaliwini \u548c Apetina \u793e\u533a\u7684\u539f\u4f4f\u6c11 ACR \u4eec\u63d0\u4f9b\u4e86\u80fd\u529b\u5efa\u8bbe\u57f9\u8bad\uff0c\u4f20\u6388\u4ed6\u4eec\u5982\u4f55\u4f7f\u7528\u8fd9\u4e9b\u5de5\u5177\u6765\u5e94\u5bf9\u68ee\u6797\u9762\u4e34\u7684\u6f5c\u5728\u5a01\u80c1\u3002ACT \u6210\u529f\u5e2e\u52a9\u8fd9\u4e09\u4e2a\u539f\u4f4f\u6c11\u793e\u533a\u4e86\u89e3\u4e86\u5176\u9886\u5730\u5185\u7684\u68ee\u6797\u6ee5\u4f10\u73b0\u72b6\uff0c\u5e76\u4e3a\u5176\u63d0\u4f9b\u4e86\u79ef\u6781\u76d1\u6d4b\u6240\u9700\u7684\u5de5\u5177\uff0c\u7528\u4ee5\u5e94\u5bf9\u8fd9\u4e9b\u5a01\u80c1\u3002\uff08\u56fe\u7247\u6765\u81ea\u82cf\u91cc\u5357 ACT\uff09", "c87b4b927896106bc74e2132b6f29275": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Pronatura</a> \u5c06 GLAD \u68ee\u6797\u6ee5\u4f10\u548c VIIRS \u6d3b\u8dc3\u706b\u707e\u8b66\u62a5\u7eb3\u5165\u4e86\u4ed6\u4eec\u5728\u9996\u4e2a SGF \u9879\u76ee\u4e2d\u521b\u5efa\u7684\u5728\u7ebf\u68ee\u6797\u5e73\u53f0 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Maya Forest Watch</a>\u3002\u901a\u8fc7\u66f4\u65b0\u540e\u7684 Maya Forest Watch\uff0cPronatura \u81f4\u529b\u4e8e\u63d0\u9ad8\u5f53\u5730\u7684\u80fd\u529b\uff0c\u4f7f\u5176\u80fd\u591f\u4fdd\u62a4\u58a8\u897f\u54e5\u5c24\u5361\u5766\u534a\u5c9b\u5177\u6709\u91cd\u5927\u751f\u6001\u548c\u793e\u4f1a\u610f\u4e49\u7684\u5927\u578b\u751f\u7269\u5708\u4fdd\u62a4\u533a\u3002Pronatura \u5bf9\u58a8\u897f\u54e5\u574e\u4f69\u5207\u5dde\u548c\u5c24\u5361\u5766\u5dde\u7684\u653f\u5e9c\u6280\u672f\u4eba\u5458\u548c\u793e\u533a\u5ba3\u4f20\u4eba\u5458\u8fdb\u884c\u4e86\u57f9\u8bad\uff0c\u6559\u6388\u4ed6\u4eec\u5982\u4f55\u4f7f\u7528 Maya Forest Watch \u548c Forest Watcher\uff0c\u4ece\u800c\u5236\u5b9a\u4e86\u4e00\u7cfb\u5217\u884c\u52a8\u534f\u8bae\uff0c\u4ee5\u5e94\u5bf9\u5c24\u5361\u5766\u534a\u5c9b\u9762\u4e34\u7684\u706b\u707e\u548c\u68ee\u6797\u6ee5\u4f10\u5a01\u80c1\u3002\uff08\u56fe\u7247\u7531 Pronatura \u63d0\u4f9b\uff09", "5f2202e4b0449289c25c74a522b4d994": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Publish What You Pay Indonesia</a> (PWYP-Indonesia) \u4e0e\u5f53\u5730\u5408\u4f5c\u4f19\u4f34 Mnukawar \u5408\u4f5c\u5efa\u8bbe\u4e86\u5370\u5c3c\u897f\u5df4\u5e03\u4e9a\u7701\u5f53\u5730\u793e\u533a\u7684\u68ee\u6797\u76d1\u6d4b\u80fd\u529b\uff0c\u8fd9\u4e9b\u793e\u533a\u5c45\u4f4f\u5728\u6613\u53d7\u91c7\u77ff\u4f5c\u4e1a\u5f71\u54cd\u7684\u68ee\u6797\u5468\u8fb9\u3002PWYP-Indonesia \u548c Mnukwar \u643a\u624b\u5f53\u5730\u5408\u4f5c\u4f19\u4f34\u4e3e\u529e\u4e86\u4e00\u7cfb\u5217\u5ba3\u4f20\u548c\u57f9\u8bad\u8bfe\u7a0b\uff0c\u91cd\u70b9\u4f20\u6388\u5229\u76ca\u76f8\u5173\u65b9\u4e86\u89e3\u77ff\u4ea7\u4ef7\u503c\u94fe\u3001\u5f53\u5730\u91c7\u77ff\u6cd5\u5f8b\u548c\u8bb8\u53ef\u8bc1\u5ba1\u67e5\u76f8\u5173\u77e5\u8bc6\uff0c\u4ee5\u53ca\u5982\u4f55\u4f7f\u7528 GFW \u76d1\u6d4b\u5176\u571f\u5730\u3002\u4ed6\u4eec\u5728\u4e03\u4e2a\u6751\u5e84\u4e2d\u6210\u529f\u8bbe\u7acb\u4e86\u91c7\u77ff\u548c\u68ee\u6797\u76d1\u6d4b\u56e2\u961f\uff0c\u5b9a\u671f\u8fdb\u884c\u5b9e\u5730\u76d1\u6d4b\u3002\uff08\u56fe\u7247\u7531 PWYP-Indonesia \u63d0\u4f9b\uff09", "03cbf81180da65c49a46b266a4aa1288": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Rainforest Foundation</a> US (RFUS) \u643a\u624b\u79d8\u9c81\u4e9a\u9a6c\u5b59\u5730\u533a\u7684\u539f\u4f4f\u6c11\u5408\u4f5c\u4f19\u4f34\uff0c\u6210\u529f\u6574\u5408\u4e86 GFW \u5de5\u5177\u7528\u4e8e\u8fdc\u7a0b\u68ee\u6797\u76d1\u6d4b\u3002\u8fd9\u4e9b\u5de5\u5177\uff08\u5c24\u5176\u662f GLAD \u8b66\u62a5\u548c Forest Watcher\uff09\u4e3a\u539f\u4f4f\u6c11\u5408\u4f5c\u4f19\u4f34\u63d0\u4f9b\u4e86\u7b80\u5355\u6613\u884c\u7684\u571f\u5730\u76d1\u6d4b\u624b\u6bb5\u3002RFUS \u8fd8\u81f4\u529b\u4e8e\u6b63\u5f0f\u534f\u8c03\u539f\u4f4f\u6c11\u793e\u533a\u4e0e\u8d1f\u8d23\u9632\u8303\u548c\u8c03\u67e5\u975e\u6cd5\u4f10\u6728\u7684\u653f\u5e9c\u673a\u5173\uff0c\u6210\u529f\u534f\u52a9\u79d8\u9c81\u73af\u5883\u68c0\u5bdf\u673a\u5173 (FEMA) \u5e72\u9884\u4e86\u4e09\u8d77\u6848\u4ef6\u3002\uff08\u56fe\u7247\u7531 RFUS \u63d0\u4f9b\uff09", "c851d1b36d712efb2c864f09b802e215": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Fondation Camerounaise de la Terre Vivante</a> (FCTV) \u521b\u5efa\u4e86\u4e00\u4e2a<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5730\u7406\u95e8\u6237\u7f51\u7ad9</a>\uff0c\u91cd\u70b9\u4ecb\u7ecd\u5fb7\u8d3e\u751f\u7269\u5708\u4fdd\u62a4\u533a (Biosphere Reserve of Dja) \u7684\u68ee\u6797\u6ee5\u4f10\u73b0\u72b6\uff0c\u8be5\u4fdd\u62a4\u533a\u6b63\u5728\u906d\u53d7\u6765\u81ea\u975e\u6cd5\u4f10\u6728\u3001\u519c\u7528\u5de5\u4e1a\u548c\u9ed8\u574e (Hydromekin) \u5927\u575d\u7684\u5a01\u80c1\u3002FCTV \u534f\u52a9\u5f53\u5730\u793e\u533a\u548c\u6c11\u95f4\u793e\u4f1a\u7ec4\u7ec7\u8fd0\u7528 Forest Watcher \u79fb\u52a8\u5e94\u7528\u548c GLAD \u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\uff0c\u9ad8\u6548\u4fdd\u62a4\u533a\u5185\u53ca\u5468\u8fb9\u7684\u76d1\u6d4b\u975e\u6cd5\u6d3b\u52a8\u548c\u6ee5\u4f10\u4e8b\u4ef6\uff0c\u5e76\u5728\u5730\u7406\u95e8\u6237\u7f51\u7ad9\u4e0a\u516c\u5e03\u4e86\u8fd9\u4e9b\u76d1\u6d4b\u5de5\u4f5c\u7684\u6210\u679c\u3002\u8fd9\u79cd\u5b9e\u65f6\u76d1\u6d4b\u65b9\u6cd5\u6240\u53d6\u5f97\u7684\u8bc1\u636e\uff0c\u4e3a\u5730\u65b9\u673a\u5173\u7684\u5ba3\u4f20\u884c\u52a8\u63d0\u4f9b\u4e86\u4f9d\u636e\u3002\uff08\u56fe\u7247\u6765\u81ea FCTV\uff1b\u5730\u56fe\u6765\u81ea FCTV\uff0c\u663e\u793a\u4e86\u5fb7\u8d3e\u751f\u7269\u5708\u4fdd\u62a4\u533a\u3002\uff09", "eddf4e11ef71328311773858f1063b23": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">The ProForest Initiative</a> \u5229\u7528\u78b3\u4ef7\u503c\u548c\u571f\u5730\u5229\u7528\u6570\u636e\u521b\u5efa\u4e86\u4e00\u4e2a\u63a7\u5236\u9762\u677f\uff0c\u7528\u4ee5\u6307\u5bfc\u6cf0\u56fd\u3001\u6d2a\u90fd\u62c9\u65af\u7b49\u56fd\u5bb6\u505a\u51fa\u66f4\u5177\u53ef\u6301\u7eed\u6027\u7684\u519c\u573a\u7ba1\u7406\u571f\u5730\u5229\u7528\u51b3\u7b56\u3002\u5c0f\u519c\u6237\u548c\u519c\u4e1a\u516c\u53f8\u7ba1\u7406\u8005\u90fd\u80fd\u4f7f\u7528\u8fd9\u6b3e\u5728\u7ebf\u63a7\u5236\u9762\u677f\uff0cProForest Initiative \u56e0\u6b64\u4fdd\u8bc1\u4e86\u6240\u6709\u5229\u76ca\u76f8\u5173\u65b9\u90fd\u80fd\u83b7\u5f97\u53ef\u9760\u6570\u636e\u6765\u6307\u5bfc\u571f\u5730\u5229\u7528\u8f6c\u578b\u51b3\u7b56\u3002\u8be5\u63a7\u5236\u9762\u677f\u8fd8\u6709\u52a9\u4e8e\u5c0f\u519c\u6237\u786e\u5b9a\u5e76\u5212\u5b9a\u5176\u519c\u573a\u7684\u9ad8\u4fdd\u62a4\u4ef7\u503c (HCV) \u533a\u57df\uff0c\u8fd9\u662f\u67d0\u4e9b\u8ba4\u8bc1\u8ba1\u5212\u7684\u8981\u6c42\u3002\u519c\u4e1a\u516c\u53f8\u5229\u7528\u8be5\u63a7\u5236\u9762\u677f\u76d1\u6d4b\u68ee\u6797\u6ee5\u4f10\u73b0\u72b6\uff0c\u5e76\u8bc4\u4f30\u6574\u4e2a\u4f9b\u5e94\u94fe\u7684\u98ce\u9669\u3002\uff08\u56fe\u7247\u7531 ProForest Initiative \u63d0\u4f9b\u3002\uff09", "d24934a56328e596baf2320a2f1be2f8": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Working Group on Forest Certification Ghana</a> \u8fd0\u7528\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u6307\u5bfc\u5de1\u903b\u961f\u66f4\u6709\u6548\u5730\u6253\u51fb\u52a0\u7eb3\u5883\u5185\u975e\u6cd5\u4f10\u6728\u548c\u68ee\u6797\u76f8\u5173\u72af\u7f6a\u884c\u4e3a\u3002\u5f53\u5730\u6267\u6cd5\u673a\u5173\u8fd0\u7528 GFW \u8b66\u62a5\u660e\u786e\u6f5c\u5728\u975e\u6cd5\u68ee\u6797\u6ee5\u4f10\u4e8b\u4ef6\u7684\u8c03\u67e5\u5730\u70b9\u3002\u6b64\u5916\uff0cGlobal Forest Watch \u6570\u636e\u8fd8\u88ab\u7528\u4e8e\u57f9\u8bad\u519c\u6237\u548c\u5229\u76ca\u76f8\u5173\u65b9\uff0c\u4f7f\u5176\u4e86\u89e3\u68ee\u6797\u5a01\u80c1\u7684\u7a0b\u5ea6\u548c\u8303\u56f4\u3002Working Group on Forest Certification Ghana \u62a5\u544a\u79f0\uff0c\u5728\u8be5\u9879\u76ee\u5b9e\u65bd\u540e\uff0c\u793e\u533a\u548c\u6728\u6750\u516c\u53f8\u4e4b\u95f4\u7684\u7d27\u5f20\u5173\u7cfb\u6709\u6240\u7f13\u548c\uff0c\u8fd9\u8868\u660e\u53ef\u9760\u6570\u636e\u548c\u66f4\u9ad8\u7684\u900f\u660e\u5ea6\u6709\u52a9\u4e8e\u653f\u5e9c\u3001\u4f01\u4e1a\u548c\u793e\u533a\u4e4b\u95f4\u7684\u6c9f\u901a\u548c\u4fe1\u4efb\u5efa\u7acb\u3002\uff08\u7167\u7247\u7531 Working Group on Forest Certification Ghana \u63d0\u4f9b\u3002\uff09", "ed76503b0e4be3cdc03afac24718536a": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Bruno Manser Fonds</a> \u901a\u8fc7 Global Forest Watch \u7684 FORMA \u8b66\u62a5\u548c NASA \u6d3b\u8dc3\u706b\u707e\u8b66\u62a5\uff0c\u5728\u9a6c\u6765\u897f\u4e9a\u5a46\u7f57\u5c9b\u7802\u62c9\u8d8a\u5dde\u8fd0\u7528\u65e0\u4eba\u673a\u8fdb\u884c\u6d4b\u7ed8\uff0c\u51c6\u786e\u3001\u72ec\u7acb\u5730\u8bb0\u5f55\u4e86\u68ee\u6797\u53d8\u5316\u3002\u8be5\u5730\u533a\u662f\u751f\u7269\u591a\u6837\u6027\u70ed\u70b9\u533a\uff0c\u96e8\u6797\u4e3a\u5f53\u5730\u7279\u6709\u7684\u52a8\u690d\u7269\u7fa4\u63d0\u4f9b\u4e86\u6816\u606f\u5730\uff0c\u540c\u65f6\u4e5f\u662f\u539f\u4f4f\u6c11\u7684\u91cd\u8981\u8d44\u6e90\u3002\u7136\u800c\uff0c\u6cb9\u68d5\u79cd\u690d\u56ed\u5df2\u4fb5\u5360\u7802\u62c9\u8d8a\u5dde\u7684\u7edd\u5927\u90e8\u5206\u539f\u59cb\u68ee\u6797\uff0c\u800c\u4e14\u8fd9\u4e00\u8d8b\u52bf\u4ecd\u5728\u7ee7\u7eed\u3002\u65e0\u4eba\u673a\u6d4b\u7ed8\u5f97\u5230\u7684\u9ad8\u5206\u8fa8\u7387\u7167\u7247\u88ab\u7528\u4f5c\u6253\u51fb\u975e\u6cd5\u6ee5\u4f10\u3001\u8ffd\u7a76\u76f8\u5173\u65b9\u8d23\u4efb\u7684\u6709\u529b\u8bc1\u636e\u3002\uff08\u56fe\u7247\u7531 Bruno Manser Fonds \u63d0\u4f9b\u3002\uff09", "b99f98c8d7db63e30090d907ea5d8a15": "\u793e\u533a\u53c2\u4e0e\uff0c\u5021\u5bfc", "47f572b8f3d38cc29802b69b727d7853": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Environmental Rights Action /Friends of the Earth Nigeria</a> (ERAFOEN) \u81f4\u529b\u4e8e\u4e3a\u5c3c\u65e5\u5229\u4e9a\u5357\u90e8\u57c3\u591a\u5dde\u7684\u504f\u8fdc\u5730\u65b9\u793e\u533a\u8d4b\u80fd\uff0c\u901a\u8fc7\u4f7f\u7528 GFW \u6d4b\u7ed8\u3001\u76d1\u6d4b\u548c\u901a\u62a5\u571f\u5730\u63a0\u593a\u548c\u68ee\u6797\u6ee5\u4f10\u4e8b\u4ef6\uff0c\u547c\u5401\u53cd\u5bf9\u4e3a\u5927\u89c4\u6a21\u79cd\u690d\u56ed\u800c\u63a0\u593a\u571f\u5730\uff0c\u6ee5\u4f10\u68ee\u6797\u3002\u7531\u6b64\uff0cERA/FoE \u548c\u793e\u533a\u8054\u5408\u5411\u57c3\u591a\u5dde\u653f\u5e9c\u63d0\u4ea4\u8bf7\u613f\uff0c\u4e0e\u5f53\u5730\u653f\u5e9c\u5b98\u5458\u4f1a\u9762\uff0c\u6700\u7ec8\u6210\u529f\u593a\u56de\u4e86\u4e00\u5bb6\u79cd\u690d\u56ed\u516c\u53f8\u63a0\u593a\u7684 13,750 \u516c\u9877\u571f\u5730\u3002\uff08\u56fe\u7247\u7531 ERAFOEN \u63d0\u4f9b\u3002\uff09", "7e27a070abe1cf262a0cecc26c384cd0": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">FUNDEPS</a> (Fundaci\u00f3n para el Desarrollo de Pol\u00edticas Sostenibles) \u8fd0\u7528 GFW \u6570\u636e\u52a0\u5f3a\u4e86\u963f\u6839\u5ef7\u56fd\u5bb6\u548c\u5730\u65b9\u4fdd\u62a4\u539f\u751f\u6797\u6cd5\u5f8b\u7684\u5b9e\u65bd\uff0c\u63d0\u9ad8\u4e86\u653f\u5e9c\u53d1\u73b0\u975e\u6cd5\u68ee\u6797\u6ee5\u4f10\u7684\u80fd\u529b\uff0c\u8ba9\u5a92\u4f53\u4e86\u89e3\u5230\u68ee\u6797\u6ee5\u4f10\u76f8\u5173\u4fe1\u606f\uff0c\u5e76\u5bf9\u79d1\u5c14\u591a\u74e6\u8d1f\u8d23\u68ee\u6797\u4fdd\u62a4\u6cd5\u7684\u653f\u5e9c\u673a\u5173\u63d0\u8d77\u4e86\u8bc9\u8bbc\u3002\u5177\u4f53\u800c\u8a00\uff0cFUNDEPS \u8fd0\u7528 GFW \u6570\u636e\uff0c\u4f18\u5316\u4e86\u63d0\u4ea4\u7ed9 Forest Provincial Commission \u7684\u62a5\u544a\uff08FUNDEPS \u662f\u8be5\u59d4\u5458\u4f1a\u7684\u6210\u5458\uff09\uff0c\u652f\u6301\u653f\u5e9c\u673a\u5173\u63d0\u8bf7\u516c\u5f00\u4fe1\u606f\uff0c\u5e76\u589e\u52a0\u4e86\u5a92\u4f53\u5bf9\u68ee\u6797\u6ee5\u4f10\u4e8b\u4ef6\u7684\u62a5\u9053\u3002\uff08\u56fe\u7247\u7531 FUNDEPS \u63d0\u4f9b\u3002\uff09", "72c835811017773887959278e39c71af": "\u901a\u8fc7\u4e00\u7cfb\u5217\u7684\u7814\u8ba8\u4f1a\u548c\u57f9\u8bad\uff0cICC \u53d1\u73b0\uff0c\u56fd\u5bb6\u653f\u5e9c\u6570\u636e\u548c GFW \u6570\u636e\u4e4b\u95f4\u7684\u663e\u8457\u5dee\u5f02\uff0c\u8fd9\u5728\u5f88\u5927\u7a0b\u5ea6\u4e0a\u662f\u7531\u4e8e\u68ee\u6797\u8986\u76d6\u5b9a\u4e49\u4e0d\u540c\u548c\u5236\u56fe\u65b9\u5f0f\u4e0d\u540c\u800c\u5bfc\u81f4\u7684\u3002\u7136\u800c\uff0c\u4e8b\u5b9e\u8bc1\u660e\uff0cGFW \u5728\u5bf9\u68ee\u6797\u7279\u8bb8\u7ecf\u8425\u5730\u548c\u4fdd\u62a4\u533a\u57df\u8fdb\u884c\u68ee\u6797\u8986\u76d6\u76d1\u6d4b\u65f6\u5341\u5206\u6709\u6548\u3002\u7531\u4e8e\u8be5\u9879\u76ee\u662f\u56fd\u5bb6\u7ea7\u91cd\u70b9\u9879\u76ee\uff0cICC \u5f97\u4ee5\u5728\u6bd4\u8fc7\u53bb\u66f4\u5e7f\u6cdb\u7684\u8303\u56f4\u5185\u5f00\u5c55\u5de5\u4f5c\u3002\uff08\u5730\u56fe\u6765\u81ea ICC\uff0c\u663e\u793a\u4e86 GFW \u6570\u636e\u548c\u56fd\u5bb6\u653f\u5e9c\u6570\u636e\u4e4b\u95f4\u7684\u5dee\u5f02\uff1b\u7167\u7247\u6765\u81ea ICC\u3002\uff09", "1026eb07b93dee1e25b608d3c08f16c1": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Instituto Centro de Vida</a> (ICV) \u65e8\u5728\u4e3a\u660e\u786e\u9a6c\u6258\u683c\u7f57\u7d22\u5dde\u7684\u975e\u6cd5\u4f10\u6728\u7684\u7a0b\u5ea6\u548c\u4ee3\u4ef7\u63d0\u4f9b\u6218\u7565\u60c5\u62a5\u3002\u4ed6\u4eec\u7684\u7814\u7a76\u53d1\u73b0\uff0c2011 \u5e74 8 \u6708\u81f3 2012 \u5e74 7 \u6708\uff0c\u9a6c\u6258\u683c\u7f57\u7d22\u5dde 50% \u4ee5\u4e0a\u7684\u4f10\u6728\u6d3b\u52a8\u5747\u672a\u53d6\u5f97\u9a6c\u6258\u683c\u7f57\u7d22\u5dde\u73af\u5883\u79d8\u4e66\u5904 (State Secretariat for the Mato Grosso Environment, Sema/Mato Grosso) \u7684\u6388\u6743\u3002", "6cd779d82725806106561f73365b5b79": "\u8fdb\u884c\u76d1\u6d4b\u548c\u6267\u6cd5\u5de5\u4f5c\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Fundaci\u00f3n para la Conservaci\u00f3n de los Andes Tropicales (FCAT)</a>", "f8d791ef2810960941b760440d58b25a": "\u5728\u7f05\u7538\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Forest Trends</a>", "25c8f76873348f89aa086502690507e4": "Forest Trends \u5c06\u57f9\u8bad\u68ee\u6797\u7ba1\u7406\u5458\u56e2\u961f\u4f7f\u7528 GFW \u76d1\u6d4b\u68ee\u6797\u6ee5\u4f10\u70ed\u70b9\u5730\u533a\uff0c\u5e76\u4f7f\u7528 Forest Watcher \u8fdb\u884c\u6838\u67e5\u3002\u6bcf\u4e2a\u5b63\u5ea6\uff0c\u68ee\u6797\u7ba1\u7406\u5458\u4f1a\u5c06\u4e24\u4e2a\u76ee\u6807\u5730\u533a\u7684\u8c03\u67e5\u62a5\u544a\u548c\u68ee\u6797\u6ee5\u4f10\u73b0\u72b6\u5206\u4eab\u7ed9 MONREC \u5b98\u5458\uff0c\u5e76\u6839\u636e\u8c03\u67e5\u7ed3\u679c\u52aa\u529b\u6539\u5584\u68ee\u6797\u7ba1\u7406\u5b9e\u8df5\u548c\u6cbb\u7406\u3002&nbsp;", "474c51048d4bec3c9bf3d87f247278a6": "\u6574\u4e2a\u5730\u533a", "1516a4d1fb0f9eb605b1959c00e5c54b": "\u663e\u793a\u5929\u7136\u68ee\u6797\u548c\u975e\u5929\u7136\u6797\u6728\u8986\u76d6\u533a\u57df\u5185\u9010\u5e74\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u60c5\u51b5\u3002", "aff5dd41d1ed0d6b58d5e23f8a48545b": "\u4ece{startYear}\u5e74\u5230{endYear}\u5e74\uff0c{location}\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u4e2d\u6709{percentage}\u53d1\u751f\u5728{lossPhrase}\u5185\u3002\u5929\u7136\u68ee\u6797\u5185\u7684\u603b\u635f\u5931\u4e3a{totalLoss}\uff0c\u76f8\u5f53\u4e8e{value}\u7684\u4e8c\u6c27\u5316\u78b3\u5f53\u91cf\u6392\u653e\u3002", "b65e25a862021d1c69bf43ca194835fa": "\u5f00\u53d1\u6b64\u5730\u56fe\u65f6\u53c2\u8003\u4e86Accountability Framework Initiative\uff08AFi\uff09\u548c\u8054\u5408\u56fd\u7cae\u98df\u53ca\u519c\u4e1a\u7ec4\u7ec7\uff08FAO\uff09\u53d1\u5e03\u7684\u81ea\u7136\u751f\u6001\u7cfb\u7edf\u548c\u68ee\u6797\u5b9a\u4e49\u3002AFi\u548cFAO\u5c06\u68ee\u6797\u5b9a\u4e49\u4e3a\u9762\u79ef\u8d85\u8fc70.5\u516c\u9877\u3001\u5176\u4e0a\u4ee5\u9ad8\u5ea6\u8d85\u8fc75\u7c73\u3001\u6811\u51a0\u8986\u76d6\u7387\u8d85\u8fc710%\u7684\u6811\u6728\u4e3a\u4e3b\u7684\u571f\u5730\uff0c\u6216\u6811\u6728\u80fd\u591f\u5c31\u5730\u8fbe\u5230\u8fd9\u4e9b\u9608\u503c\u7684\u533a\u57df\u3002AFi\u5c06\u5929\u7136\u68ee\u6797\u5b9a\u4e49\u4e3a\u5728\u7269\u79cd\u7ec4\u6210\u3001\u7ed3\u6784\u548c\u751f\u6001\u529f\u80fd\u65b9\u9762\uff0c\u4e0e\u65e0\u91cd\u5927\u4eba\u4e3a\u5f71\u54cd\u7684\u7279\u5b9a\u533a\u57df\u6240\u80fd\u627e\u5230\u7684\u68ee\u6797\u76f8\u4f3c\u7684\u68ee\u6797\u3002\u7531\u4e8e\u65e0\u6cd5\u901a\u8fc7\u5730\u7403\u89c2\u6d4b\u6570\u636e\u76f4\u63a5\u7ed8\u5236\u7269\u79cd\u7ec4\u6210\u548c\u751f\u6001\u529f\u80fd\uff0c\u56e0\u6b64\u4f7f\u7528\u4ee3\u7406\u6570\u636e\u6765\u843d\u5b9eAFi\u548cFAO\u7684\u5b9a\u4e49\uff0c\u4ee5\u6392\u9664\u4e0d\u7b26\u5408\u5929\u7136\u68ee\u6797\u5b9a\u4e49\u7684\u6797\u6728\u8986\u76d6\u3002AFi\u6307\u5357\u8fd8\u6307\u51fa\uff0c\u56fd\u5bb6\u548c\u6b21\u56fd\u5bb6\u7ea7\u68ee\u6797\u5b9a\u4e49\u6240\u8bbe\u5b9a\u7684\u9608\u503c\u53ef\u80fd\u4f18\u5148\u9002\u7528\uff0c\u56e0\u6b64\u5728\u7279\u5b9a\u5730\u533a\uff0c\u5730\u533a\u571f\u5730\u8986\u76d6\u5730\u56fe\u4f18\u5148\u4e8e\u5168\u7403\u6570\u636e\u3002", "017bd87ad803dc397022da786d718508": "\u663e\u793a\u6240\u9009\u533a\u57df\u5185\u81ea2021\u5e74\u8d77\u5929\u7136\u68ee\u6797\u548c\u975e\u5929\u7136\u6797\u6728\u8986\u76d6\u7684\u5e74\u5ea6\u6797\u6728\u8986\u76d6\u635f\u5931\u60c5\u51b5\u3002\u5929\u7136\u68ee\u6797\u548c\u975e\u5929\u7136\u6797\u6728\u8986\u76d6\u6570\u636e\u63d0\u53d6\u81eaScience Based Targets Network\uff08STBN\uff092020\u5e74\u5929\u7136\u571f\u5730\u5730\u56fe\u4e2d\u5212\u5b9a\u7684\u76f8\u5173\u7c7b\u522b\u3002\u8fd9\u4e9b\u6570\u636e\u6765\u81ea\u591a\u4e2a\u6765\u6e90\uff0c\u5f00\u53d1\u4e86\u5177\u6709\u5168\u7403\u7edf\u4e00\u5206\u7c7b\u65b9\u6848\u7684\u5929\u7136\u4e0e\u975e\u5929\u7136\u571f\u5730\u8986\u76d6\u5168\u7403\u5730\u56fe\u3002", "b17347774c968a328df180a2055af2a9": "\u975e\u5929\u7136\u6797\u6728\u8986\u76d6\u53ef\u80fd\u5305\u62ec\u6811\u6728\u4f5c\u7269\u3001\u4eba\u5de5\u6797\u3001\u9762\u79ef\u5c0f\u4e8e0.5\u516c\u9877\u7684\u6811\u4e1b\uff0c\u6216\u4e3b\u8981\u4e3a\u519c\u4e1a\u6216\u57ce\u5e02\u7528\u5730\u7684\u533a\u57df\u5185\u7684\u6811\u6728\u3002\u7528\u6237\u5e94\u53c2\u8003<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6280\u672f\u6587\u6863</a>\uff0c\u4e86\u89e3\u7528\u4e8e\u5f00\u53d1\u5730\u56fe\u7684\u8f93\u5165\u6570\u636e\u53ca\u5176\u5c40\u9650\u6027\u7684\u66f4\u591a\u8be6\u7ec6\u4fe1\u606f\u3002", "99f6a5fe0fd8bd0fca689a9608a728e7": "\u5728{location}\u5185\u672a\u53d1\u73b0\u76f8\u5bf9\u6797\u6728\u8986\u76d6\u635f\u5931\u3002", "ea28eaeffb687e936bd46a165278aed2": "\u4ece{startYear}\u5e74\u5230{endYear}\u5e74\uff0c{location}\u56e0\u706b\u707e\u635f\u5931\u4e86{treeCoverLossFires}\u7684\u6797\u6728\u8986\u76d6\u3002", "81836d7bcf76d589200df4154a729a1b": "UTT \u5c06\u8d1f\u8d23\u76d1\u6d4b\u975e\u6cd5\u6ee5\u4f10\u548c\u91ce\u706b\u7b49\u68ee\u6797\u5a01\u80c1\u4e8b\u4ef6\u3002IBIF \u5c06\u5bf9\u9886\u5730\u76d1\u6d4b\u5355\u4f4d\u56e2\u961f\u8fdb\u884c\u57f9\u8bad\uff0c\u4f7f\u5176\u638c\u63e1 GFW \u96c6\u6210\u7684\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u548c VIIRS \u706b\u8b66\u8b66\u62a5\u7684\u7528\u6cd5\uff0c\u5e76\u4f7f\u7528\u5176\u81ea\u6709\u76d1\u6d4b\u7cfb\u7edf\u7ec4\u5efa\u4e00\u4e2a\u76d1\u6d4b\u4e2d\u5fc3\uff0c\u4ee5\u52a0\u5f3a\u9886\u5730\u7ba1\u7406\u80fd\u529b\u3002IBIF \u8fd8\u5c06\u534f\u52a9 AFIG \u4e0e\u73bb\u5229\u7ef4\u4e9a\u6797\u4e1a\u7ba1\u7406\u5c40\u7b7e\u8ba2\u534f\u8bae\uff0c\u4f7f\u8be5\u76d1\u6d4b\u7cfb\u7edf\u5f97\u5230\u5408\u6cd5\u8ba4\u8bc1\uff0c\u53ef\u4e0a\u62a5\u5176\u9886\u5730\u5185\u7684\u8fdd\u89c4\u884c\u4e3a\u3002", "bc4eb93244f44b465812d61202ab6c1c": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Knowledge for World Conservation (KWC) </a>\u5c06\u52aa\u529b\u63d0\u9ad8\u52a0\u7eb3\u5965\u82ac\u7d22\u6797\u533a\u68ee\u6797\u548c\u793e\u533a\u8b66\u536b\u529b\u91cf\uff0c\u8ba9\u591a\u4e2a\u5229\u76ca\u76f8\u5173\u65b9\u5171\u540c\u53c2\u4e0e\uff0c\u51cf\u5c11\u975e\u6cd5\u6797\u4e1a\u6d3b\u52a8\uff0c\u66f4\u597d\u5730\u5e94\u5bf9\u6b63\u5728\u8fdb\u884c\u6216\u65b0\u51fa\u73b0\u7684\u6797\u4e1a\u72af\u7f6a\u3002&nbsp;", "45271eec4615010cf99cd73744975fc5": "\u5c06\u7ee7\u7eed\u81f4\u529b\u4e8e\u89e3\u51b3\u54e5\u4f26\u6bd4\u4e9a\u5b89\u8fea\u5965\u57fa\u5730\u533a\u7684\u68ee\u6797\u6ee5\u4f10\u95ee\u9898\u3002\u8fd9\u6b21\uff0c\u4ed6\u4eec\u5c06\u4f7f\u7528\u65b0\u6280\u672f\u5b9e\u73b0\u76d1\u6d4b\u548c\u901a\u4fe1\u81ea\u52a8\u5316\u3002&nbsp;", "4be9cca5c3e3ca3895aa6ea20348747d": "\u7528\u4ee5", "28b884e36e66bf3ab392502ec87c22d2": "&nbsp;\u6d88\u9664\u975e\u6cd5\u4f10\u6728\u73b0\u8c61\u3002", "ef5e67ffc3475f929eca9cb80b9fe7fc": "Global Forest Watch (GFW) \u63d0\u4f9b\u6700\u65b0\u6570\u636e\uff0c\u5e2e\u52a9\u4e16\u754c\u5404\u5730\u7684\u4eba\u4eec\u8bc6\u522b\u4e0d\u540c\u7c7b\u578b\u7684\u571f\u5730\u7528\u9014\u3002\u6211\u4eec\u63d0\u4f9b\u4e00\u5957\u72ec\u7279\u7684\u6570\u636e\u96c6\uff0c\u6db5\u76d6\u5927\u5b97\u5546\u54c1\u3001\u81ea\u7136\u4fdd\u62a4\u3001\u57fa\u7840\u8bbe\u65bd\u548c\u4eba\u53e3\uff0c\u6709\u52a9\u4e8e\u5224\u65ad\u68ee\u6797\u635f\u5931\u662f\u5426\u7531\u975e\u6cd5\u884c\u4e3a\u9020\u6210\u4ee5\u53ca\u80cc\u540e\u7684\u9a71\u52a8\u56e0\u7d20\u3002\u5927\u5b97\u5546\u54c1\u6570\u636e\u5305\u62ec\u91c7\u77ff\u3001\u4f10\u6728\u3001\u90e8\u5206\u6728\u672c\u4f5c\u7269\u4ee5\u53ca\u77f3\u6cb9/\u5929\u7136\u6c14\u7279\u8bb8\u6743\uff0c\u8fd9\u4e9b\u6570\u636e\u7531\u653f\u5e9c\u673a\u6784\u3001\u975e\u653f\u5e9c\u7ec4\u7ec7\u548c\u5176\u4ed6\u7ec4\u7ec7\u6536\u96c6\u6c47\u7f16\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u81ea\u7136\u4fdd\u62a4\u6570\u636e</a>\u663e\u793a\u4e86\u4fdd\u62a4\u533a\u7684\u60c5\u51b5\uff0c\u7531\u4e16\u754c\u4fdd\u62a4\u533a\u6570\u636e\u5e93\u6c47\u7f16\u3002\u57fa\u7840\u8bbe\u65bd\u6570\u636e\u663e\u793a\u4e86<a href=\"{{1}}\" class=\"\" target=\"_blank\" rel=\"noreferrer noopener\">\u521a\u679c\u76c6\u5730\u4f10\u6728\u7528\u9053\u8def</a>\u548c<a href=\"{{2}}\">\u4e3b\u8981\u6c34\u575d</a>\uff0c\u5e2e\u52a9\u7528\u6237\u76f4\u89c2\u5730\u4e86\u89e3\u54ea\u91cc\u7684\u57fa\u7840\u8bbe\u65bd\u9879\u76ee\u53ef\u80fd\u5bfc\u81f4\u68ee\u6797\u7834\u574f\u3002\u6700\u540e\uff0c\u4eba\u53e3\u6570\u636e\u5305\u62ec<a href=\"{{3}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u539f\u4f4f\u6c11\u548c\u793e\u533a\u5171\u6709\u571f\u5730</a>\uff0c\u7528\u4e8e\u8bc6\u522b\u7531\u539f\u4f4f\u6c11\u548c\u5f53\u5730\u793e\u533a\u6309\u7167\u4f20\u7edf\u6cbb\u7406\u65b9\u5f0f\u6301\u6709\u7684\u571f\u5730\u3002\u6d4f\u89c8\u4e0b\u65b9\u6700\u6d41\u884c\u7684\u6570\u636e\u96c6\u5e76\u7740\u624b\u4f7f\u7528\u3002&nbsp;&nbsp;", "58ac07e6d52694700d5cfe16dd11c86d": "\u6bcf\u5468\u66f4\u65b0\u4e00\u6b21\uff0c\u56fe\u50cf\u62cd\u6444\u5468\u671f\u4e3a\u6bcf 2-3 \u5929\u4e00\u6b21&nbsp;", "47c71674fdd97cb6b38e8430611112fe": "<strong> </strong>\u901a\u8fc7 <a href=\"{{0}}\">GFW Data API</a>&nbsp;\u8bbf\u95ee\u6570\u636e\uff0c\u67e5\u770b\u53ef\u7528\u6570\u636e\u548c\u76f8\u5173\u5143\u6570\u636e\u3002&nbsp;\u5229\u7528 WRI \u7684 <a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">Resource Watch AP</a>I\uff0c\u7528\u6237\u53ef\u4ee5\u5bf9 Resource Watch\u3001GFW \u548c Aqueduct \u7684\u5730\u7406\u7a7a\u95f4\u5e94\u7528\u7a0b\u5e8f\u8fdb\u884c\u989d\u5916\u7684\u540e\u7aef\u8bbf\u95ee\u3002<a href=\"{{2}}\">\u5728\u8fd9\u91cc\u8fdb\u4e00\u6b65\u4e86\u89e3\u5982\u4f55\u4f7f\u7528 GFW \u6570\u636e\u8fdb\u884c\u5f00\u53d1</a>\u3002&nbsp;", "5ca8296c6ba5e20b778f910d57423d05": "\u4f7f\u7528\u534f\u8c03 Landsat-Sentinel-2 (HLS) \u5f71\u50cf\u8fd1\u4e4e\u5b9e\u65f6\u5730\u76d1\u6d4b\u5168\u7403\u690d\u88ab\u6270\u52a8", "725b1a3a62c243da7a5e31fa2d44210a": "\u5370\u5ea6\u5c3c\u897f\u4e9a\u7684\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf (Leuser Ecosystem) \u662f\u82cf\u95e8\u7b54\u814a\u7280\u3001\u82cf\u95e8\u7b54\u814a\u7329\u7329\u3001\u82cf\u95e8\u7b54\u814a\u8c61\u548c\u82cf\u95e8\u7b54\u814a\u864e\u5728\u8fd9\u9897\u661f\u7403\u4e0a\u6700\u540e\u4e00\u7247\u91ce\u5916\u5171\u6816\u5730\u30022016 \u5e74\u4ee5\u6765\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">HAkA</a> \u4e00\u76f4\u81f4\u529b\u4e8e\u53d1\u5e03\u4e9a\u9f50\u7701\u68ee\u6797\u72b6\u51b5\u7684\u6700\u65b0\u6570\u636e\uff0c\u5e76\u5bf9\u6765\u81ea\u653f\u5e9c\u90e8\u95e8\u3001NGO\u3001\u5b66\u751f\u3001\u8b66\u5bdf\u3001\u65b0\u95fb\u8bb0\u8005\u548c\u5f53\u5730\u793e\u533a\u7684\u5171\u8ba1\u8d85\u8fc7 1600 \u4eba\u8fdb\u884c\u4e86 GFW \u5de5\u5177\u4f7f\u7528\u57f9\u8bad\u3002\u73b0\u5728\uff0c\u4ed6\u4eec\u5c06\u9879\u76ee\u91cd\u70b9\u8f6c\u5411\u52a0\u6df1 3 \u4e2a\u68ee\u6797\u7ba1\u7406\u5355\u4f4d\u548c 1 \u4e2a\u56fd\u5bb6\u516c\u56ed\u7ba1\u7406\u5355\u4f4d\u5bf9 GFW \u5de5\u5177\u7406\u89e3\u548c\u4f7f\u7528\u4e0a\u3002\u5728\u8fd9\u4e9b\u5355\u4f4d\u8fdb\u884c\u5bc6\u96c6\u6307\u5bfc\u8bbf\u95ee\uff0c\u6709\u52a9\u4e8e\u63d0\u9ad8\u4ed6\u4eec\u5bf9 GFW \u5de5\u5177\u7684\u638c\u63e1\uff0c\u5e76\u9f13\u52b1\u4ed6\u4eec\u66f4\u9891\u7e41\u5730\u8fdb\u884c\u5b9e\u5730\u8054\u5408\u5de1\u903b\uff0c\u6838\u5b9e\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u3002&nbsp;", "88e363cd276b564314b50942fe7e3dd1": "\u8be5\u5730\u533a\u7684\u5927\u90e8\u5206\u6816\u606f\u5730\u7531{eco_0}\u7ec4\u6210\uff0c\u540c\u65f6\u4e5f\u5305\u62ec{eco_1}\u533a\u57df\u3002\u8be5\u5730\u533a\u5305\u542b\u672a\u53d7\u4fb5\u6270\u7684\u539f\u59cb\u68ee\u6797\u3002\u8be5\u533a\u57df\u4e3b\u8981\u4e3a{kop_0}\uff0c\u5c5e\u4e8e{bio_0}\u751f\u7269\u7fa4\u7cfb\u3002\u8be5\u4f4d\u7f6e\u4e3b\u8981\u4e3a{lsf_0}\u3002{area_0}\u533a\u57df\u4f4d\u4e8e{area_1}\u3002", "5add63388704c97e97f2307d66bb8782": "\u5e76\u975e\u6240\u6709\u5929\u7136\u68ee\u6797\u533a\u57df\u90fd\u80fd\u901a\u8fc7\u73b0\u6709\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u8fdb\u884c\u76d1\u6d4b\u3002\u66f4\u591a\u4fe1\u606f\u8bf7\u53c2\u89c1\u5143\u6570\u636e\u3002", "738a819365be4306cf068b8ecfeb0c50": "\u6cb9\u68d5", "e2179aa7abf4cb229c4d558661cf654f": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5929\u7136\u68ee\u6797\uff1a</a>Science Based Targets Network\uff0c\u5929\u7136\u571f\u5730\u5730\u56fe\uff0c\u7248\u672c0.3\u3002<br><a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6797\u6728\u8986\u76d6\u635f\u5931\uff1a</a>Hansen/UMD/Google/USGS/NASA<br><a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u884c\u653f\u8fb9\u754c\uff1a</a>Global Administrative Areas database\uff08GADM\uff09\uff0c\u7248\u672c3.6\u3002", "0672fbaaa06a9faf8f704d148d778744": "<span data-contrast=\"auto\"></span>\u52a0\u5f3a\u6797\u4e1a\u72af\u7f6a\u7684\u73af\u5883\u6cd5\u6267\u6cd5\u529b\u5ea6 (Strengthening Environmental Law Enforcement in Forestry Crime) <span data-contrast=\"auto\">\u9879\u76ee\u7684\u603b\u4f53\u76ee\u6807\u662f\uff0c\u5c06\u5211\u4e8b\u53f8\u6cd5\u7eb3\u5165\u52a0\u7eb3\u897f\u5357\u90e8\u5854\u79d1\u62c9\u8fea\u6797\u533a\u7684\u68ee\u6797\u76d1\u6d4b\u548c\u6267\u6cd5\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hen Mpoano</a> \u5c06\u52aa\u529b\u63d0\u5347\u6267\u6cd5\u4eba\u5458\u80fd\u529b\uff0c\u786e\u4fdd\u4ed6\u4eec\u8ba4\u771f\u5b88\u6cd5\u3001\u4e25\u683c\u6267\u6cd5\uff1b\u6536\u96c6\u5bf9\u6267\u6cd5\u884c\u52a8\u6709\u7528\u7684\u7a7a\u95f4\u6570\u636e\u8bc1\u636e\uff1b\u4fc3\u8fdb\u63d0\u5021\u6797\u533a\u5468\u8fb9\u793e\u533a\u79ef\u6781\u4fdd\u62a4\u68ee\u6797\uff0c\u4ece\u800c\u8d44\u6e90\u9075\u5b88\u68ee\u6797\u6cd5\u3002</span><span data-contrast=\"auto\">\u8be5\u9879\u76ee\u5c06\u4ee5\u5f80\u671f GFW \u9879\u76ee\u4e3a\u57fa\u7840\u3002\u5f80\u671f\u9879\u76ee\u5df2\u6210\u529f\u63d0\u9ad8\u4e86\u793e\u533a\u548c\u68ee\u6797\u7ba1\u7406\u5458\u7684\u68ee\u6797\u76d1\u6d4b\u80fd\u529b\uff0c\u901a\u8fc7\u52a0\u5f3a\u793e\u533a\u76d1\u6d4b\u51cf\u5c11\u4e86\u5854\u79d1\u62c9\u8fea\u6797\u533a\u7684\u6ee5\u4f10\u73b0\u8c61\u3002\u8be5\u9879\u76ee\u5c06\u901a\u8fc7\u66f4\u6709\u6548\u5730\u8fd0\u7528\u5211\u4e8b\u53f8\u6cd5\u7cfb\u7edf\uff0c\u628a\u6b63\u5728\u8fdb\u884c\u7684\u68c0\u6d4b\u6d3b\u52a8\u4e0e\u66f4\u6709\u9488\u5bf9\u6027\u7684\u60e9\u7f5a\u63aa\u65bd\u7ed3\u5408\u8d77\u6765\uff0c\u540c\u65f6\u5229\u7528\u547c\u5401\u4eba\u4eec\u6539\u53d8\u884c\u4e3a\u7684\u5ba3\u4f20\u6750\u6599\u548c\u6e20\u9053\uff0c\u63a8\u5e7f\u6709\u5229\u4e8e\u4fdd\u62a4\u7684\u884c\u4e3a\u3002</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\">&nbsp;</span>", "997d32750c926d2252e7e7a7c38fd4cf": "/\u5e74\uff0c\u662f\u54e5\u4f26\u6bd4\u4e9a\u68ee\u6797\u5f00\u4f10\u91cf\u7b2c\u4e94\u5927\u7684\u7701\u3002\u63d0\u9ad8\u516c\u4f17\u548c\u96c6\u4f53\u5bf9\u68ee\u6797\u635f\u5931\u7684\u8ba4\u8bc6\uff0c\u5e76\u4f20\u64ad\u76f8\u5173\u77e5\u8bc6\uff0c\u53ef\u6700\u5927\u7a0b\u5ea6\u5730\u964d\u4f4e\u5f53\u5730\u6d3b\u52a8\u5bb6\u4e3e\u62a5\u68ee\u6797\u6ee5\u4f10\u884c\u4e3a\u7684\u98ce\u9669\u3002\u56e0\u6b64\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u9ea6\u5fb7\u6797\u690d\u7269\u56ed</a>\u5c06\u63a8\u5e7f", "b6ec47a9b342f76910565bcfd32b29ab": "\u3002<span class=\"NormalTextRun SCXW41981321 BCX0\">\u8fd9\u5c06\u901a\u8fc7\u4e00\u9879\u6709\u8d85\u8fc7 125 \u540d\u73af\u5883\u5b98\u5458\u53c2\u4e0e\u7684\u6559\u80b2\u9879\u76ee\u5f97\u4ee5\u5b9e\u73b0\uff0c\u9879\u76ee\u6db5\u76d6\u7ebf\u4e0a\u548c\u7ebf\u4e0b\u7684\u7814\u8ba8\u73ed\u3002\u6b64\u5916\uff0cMBG \u5c06\u8bbe\u8ba1\u5e76</span><span class=\"NormalTextRun SCXW41981321 BCX0\">\u5efa\u8bbe</span><span class=\"NormalTextRun SCXW41981321 BCX0\">\u4e00\u4e2a\u57fa\u4e8e\u5a92\u4f53\u7684\u5b66\u4e60\u9879\u76ee\uff0c\u975e\u4e13\u4e1a\u4eba\u58eb\u4e5f\u53ef\u901a\u8fc7\u8be5\u9879\u76ee\u63a5\u53d7\u57f9\u8bad\uff0c\u4e86\u89e3\u5982\u4f55\u4f7f\u7528 GFW \u5de5\u5177\u8fdb\u884c\u68ee\u6797\u76d1\u6d4b\u3002</span>", "c5cead51cc7cfba43e6afe066c48e1bb": "\u548c\u62a5\u544a\u5b89\u8482\u5965\u57fa\u4e9a\u7701\u4e5d\u4e2a\u5730\u533a\u7684\u68ee\u6797\u6ee5\u4f10\u4e8b\u4ef6\uff0c\u5f53\u5730\u5229\u76ca\u76f8\u5173\u65b9\u5305\u62ec\uff1a\u516c\u6c11\u3001\u793e\u533a\u3001\u65b0\u95fb\u8bb0\u8005\u548c\u73af\u4fdd\u90e8\u95e8", "39f2ac1cf48923df1d1ffd31789d0131": "\u5728\u79d8\u9c81\u4e4c\u5361\u4e9a\u5229\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Asociaci\u00f3n ProPur\u00fas</a> \u5c06\u4e0e\u8be5\u5730\u533a\u4e3b\u8981\u7684\u539f\u4f4f\u6c11\u8054\u5408\u4f1a ORAU \u5bc6\u5207\u5408\u4f5c\uff0c\u63d0\u9ad8 ORAU \u539f\u4f4f\u6c11\u68ee\u6797\u76d1\u6d4b\u5355\u4f4d\u7684\u6280\u672f\u6c34\u5e73\u3002ProPur\u00fas \u4f1a\u5c06 GFW \u5de5\u5177\u4e0e ORAU \u76ee\u524d\u4f7f\u7528\u7684\u76d1\u6d4b\u534f\u8bae\u76f8\u5173\u8054\uff0c\u5e76\u5728\u4e4c\u5361\u4e9a\u5229 ACONADYSH (Yur\u00faa) \u548c FECONALICM (Imir\u00eda) \u4e24\u4e2a\u9886\u5730\u4e2d\u4e0e\u4e24\u5bb6\u539f\u4f4f\u6c11\u8054\u5408\u4f1a\u8bd5\u884c\u9879\u76ee\u3002\u5176\u76ee\u6807\u662f\u52a0\u5f3a\u5bf9\u539f\u4f4f\u6c11\u68ee\u6797\u7684\u76d1\u6d4b\uff0c\u5e76\u5c06\u8fd9\u4e9b\u76d1\u6d4b\u884c\u52a8\u4e0e\u8d1f\u8d23\u5904\u7406\u8be5\u5730\u533a\u68ee\u6797\u6ee5\u4f10\u4e8b\u4ef6\u7684\u6cbb\u7406\u673a\u6784\u2014\u2014\u4e4c\u5361\u4e9a\u5229\u5730\u533a\u68ee\u6797\u7ba1\u63a7\u76d1\u7763\u59d4\u5458\u4f1a (Ucayali Regional Forest Control and Surveillance Board) \u7684\u5de5\u4f5c\u76f8\u8854\u63a5\u3002\uff08\u56fe\u7247\u7531 Asociaci\u00f3n ProPur\u00fas\u63d0\u4f9b\uff09\u3002", "3f4311646e62ad7db8702c24f14a168a": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">The Independent Forestry Monitoring Network (JPIK)</a>&nbsp; \u5c06\u5411\u8be5\u5730\u533a\u7684\u539f\u4f4f\u6c11\u548c\u5f53\u5730\u793e\u533a (IPLCs) \u63d0\u4f9b\u6709\u5173 Global Forest Watch \u7684\u7814\u8ba8\u73ed\u548c\u57f9\u8bad\uff0c\u7528\u4e8e\u68c0\u6d4b\u5370\u5ea6\u5c3c\u897f\u4e9a\u845b\u6797\u829d\u585e\u5e03\u62c9\u56fd\u5bb6\u516c\u56ed (Kerinci Seblat National Park, TNKS) \u5730\u533a\u7684\u6811\u6728\u8986\u76d6\u7387\u635f\u5931\u3002TNKS \u5730\u533a\u662f\u4e16\u754c\u9057\u4ea7\u4e4b\u4e00\uff0c\u4f46\u81ea 2011 \u5e74\u4ee5\u6765\uff0c\u7531\u4e8e\u7316\u7357\u7684\u6797\u5730\u4fb5\u5360\u548c\u975e\u6cd5\u4f10\u6728\uff0c\u8be5\u5730\u533a\u7684\u9762\u79ef\u5728\u4e0d\u65ad\u7f29\u5c0f\u3002\u9ad8\u4ef7\u503c\u7684\u6811\u6728\u5bb9\u6613\u6210\u4e3a\u4f10\u6728\u8005\u7684\u76ee\u6807\uff0c\u4e0e\u6b64\u540c\u65f6\uff0c\u5df2\u5f00\u4f10\u571f\u5730\u88ab\u4ea4\u6613\uff0c\u6210\u4e3a\u975e\u6cd5\u79cd\u690d\u56ed\uff0c\u5bfc\u81f4\u8fd9\u7247\u91cd\u8981\u7684\u751f\u6001\u7cfb\u7edf\u65e5\u76ca\u67af\u7aed\u3002\u8be5\u9879\u76ee\u7684\u4e3b\u8981\u76ee\u6807\u662f\u63d0\u9ad8 TNKS \u5730\u533a\u7684 IPLCs \u548c\u62a4\u6797\u5458\u5728\u76d1\u6d4b\u68ee\u6797\u72af\u7f6a\u548c\u6ee5\u4f10\u4e8b\u4ef6\u7684\u53c2\u4e0e\u5ea6\u3002", "bf09a9151cc1cc32e39139c238313c60": "\u65b0\u6570\u636e\u7248\u5757\u548c GFW \u672f\u8bed\u8868", "a1198e25e6cb2a20bbbeef42626feb70": "<a href=\"{{0}}\">GFW \u5e2e\u52a9\u4e2d\u5fc3</a>\u6c47\u96c6\u4e86\u4e30\u5bcc\u7684\u8d44\u6e90\u6765\u6ee1\u8db3\u60a8\u7684\u9700\u6c42\uff0c\u540c\u65f6\u8fd8\u63d0\u4f9b\u4e86\u8be6\u5c3d\u7684\u6307\u5bfc\uff0c\u8ba9\u60a8\u53ef\u4ee5\u5145\u5206\u5229\u7528 GFW \u6240\u63d0\u4f9b\u7684\u68ee\u6797\u76d1\u6d4b\u6570\u636e\u3001\u6280\u672f\u53ca\u5de5\u5177\u3002\u6211\u4eec\u6700\u8fd1\u66f4\u65b0\u4e86\u5e2e\u52a9\u4e2d\u5fc3\uff0c\u4ee5\u4e3a\u60a8\u63d0\u4f9b\u6700\u65b0\u7684\u4fe1\u606f\u3002\u6b22\u8fce\u60a8\u6d4f\u89c8\u6211\u4eec\u7684\u65b0\u7248\u5757\uff0c\u6df1\u5165\u63a2\u7d22 GFW \u4e0a\u7684<a href=\"{{1}}\">\u6570\u636e\u96c6</a>\u4ee5\u53ca\u6211\u4eec<a href=\"{{2}}\">\u65b0\u7684\u672f\u8bed\u8868</a>\u3002", "27c018be20d9eedcdb0a155e319da7a9": "\u5728\u79d8\u9c81\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Rainforest Foundation US (RFUS)</a> \u4e0e Kichwas\u3001Ticunas \u548c Shipibos \u7684 32 \u4e2a\u539f\u4f4f\u6c11\u793e\u533a\u5408\u4f5c\uff0c\u4f7f\u7528\u80fd\u4e3a\u6267\u6cd5\u884c\u52a8\u63d0\u4f9b\u5e2e\u52a9\u7684\u7a7a\u95f4\u6570\u636e\u8bc1\u636e\u4fdd\u62a4\u6d1b\u96f7\u6258\u548c\u4e4c\u5361\u5229\u4e9a\u5730\u533a\u7684\u6570\u5343\u516c\u9877\u7684\u539f\u4f4f\u6c11\u68ee\u6797\u3002\u5728\u8be5\u9879\u76ee\u4e2d\uff0c<span class=\"NormalTextRun SCXW99260120 BCX0\">RFUS \u5c06\u4e0e 2020 \u5e74\u5ea6\u5c0f\u989d\u8d44\u52a9\u91d1\u83b7\u5f97\u8005\u3001\u79d8\u9c81\u7684\u5730\u533a\u539f\u4f4f\u6c11\u7ec4\u7ec7 ORPIO \u5408\u4f5c\uff0c\u7ee7\u7eed\u8bd5\u884c\u540d\u4e3a\u201c\u96e8\u6797\u8b66\u62a5\u201d (Rainforest Alert) \u7684\u76d1\u6d4b\u8ba1\u5212\uff0c\u5e76\u5c06\u65b0\u5efa\u4e24\u5ea7</span><span class=\"NormalTextRun SCXW99260120 BCX0\">\u6280\u672f</span><span class=\"NormalTextRun SCXW99260120 BCX0\">\u4e2d\u5fc3\u6765\u652f\u6301\u5176\u53d1\u5c55\u3002\u8fd9\u4e9b\u536b\u661f\u6280\u672f\u4e2d\u5fc3\u53ef\u4f5c\u4e3a\u5b9e\u5730\u76d1\u6d4b\u5458\u5904\u7406\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u548c\u5de1\u903b\u5458\u6536\u96c6\u7684\u8bc1\u636e\u7684\u5730\u70b9\uff0c\u4ee5\u652f\u6301\u5bf9\u6ee5\u4f10\u4e8b\u4ef6\u8fdb\u884c\u66f4\u9ad8\u6548\u7684\u5b9e\u5730\u6838\u67e5\u8bbf\u95ee\u3002\u6b64\u5916\uff0c\u8be5\u9879\u76ee\u8fd8\u5c06\u8fdb\u4e00\u6b65\u5b8c\u5584\u5df2\u5efa\u6210\u7684\u4e24\u5ea7\u6280\u672f\u4e2d\u5fc3\uff0c\u5177\u4f53\u4e3a\u63d0\u4f9b\u65b0\u8ba1\u7b97\u673a\u548c\u66f4\u597d\u7684\u4e92\u8054\u7f51\u63a5\u5165\uff0c\u4f7f\u5f97\u5b9e\u5730\u56e2\u961f\u80fd\u8fdb\u884c\u66f4\u5148\u8fdb\u7684\u5206\u6790\uff0c\u5c31\u5404\u793e\u533a\u7684\u8d8b\u52bf\u7f16\u5199\u51fa\u66f4\u4f18\u8d28\u7684\u62a5\u544a\u3002\u8fd9\u4e9b\u6d3b\u52a8\u5c06\u4ea7\u51fa\u6708\u5ea6\u68ee\u6797\u5229\u7528\u56fe\u548c\u901a\u8fc7 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">MapBuilder</a> \u5236\u4f5c\u7684\u5b9a\u5236\u5730\u56fe\uff0c\u5b9a\u5236\u5730\u56fe\u5c06\u8bb0\u5f55\u8be5\u5730\u533a\u4f5c\u4e3a\u96c6\u4f53\u53cd\u5bf9\u68ee\u6797\u6ee5\u4f10\u7684\u6d3b\u52a8\u3002&nbsp;</span>", "e73ddf5c1291d96e45ae16d9a9953f85": "\u68ee\u6797\u76d1\u6d4b\u548c\u6267\u6cd5\uff0c\u5021\u5bfc", "08b5411f848a2581a41672a759c87380": "\u8fdb\u884c\u76d1\u6d4b", "f7417707817871594c495ea70c9b590c": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Public Interest Law Foundation</a> (PILF) \u4e0e\u76f8\u5173\u56fd\u5bb6\u7ea7\u653f\u5e9c\u673a\u5173\u548c\u6c11\u95f4\u793e\u56e2\u5bc6\u5207\u5408\u4f5c\uff0c\u4f7f\u7528 GFW \u660e\u786e\u68ee\u6797\u6ee5\u4f10\u7684\u6f5c\u5728\u70ed\u70b9\u533a\uff0c\u5e76\u5728\u6b64\u8fc7\u7a0b\u4e2d\u63ed\u9732\u4e86\u6267\u6cd5\u7f3a\u5931\u7684\u95ee\u9898\u3002PILF \u8fd8\u5728 GFW \u7f51\u7ad9\u548c\u4f20\u7edf\u5a92\u4f53\u4e0a\u53d1\u8868\u4e86\u4e0e\u68ee\u6797\u7834\u574f\u76f8\u5173\u7684\u7cfb\u5217\u62a5\u9053\u3002", "7a5dc5205bbcab0693608a71172bcf16": "\u5728 GFW \u535a\u5ba2\u4e0a\u9605\u8bfb\u66f4\u591a\u5173\u4e8e  ProForest \u9879\u76ee\u7684\u4fe1\u606f", "830b4c9be0a32cb2543ed472566beb7a": "\u4fc4\u52d2\u5188\u5dde\u7684\u516c\u5171\u571f\u5730\u548c\u79c1\u4eba\u571f\u5730\u53d7\u5230\u7684\u76d1\u7ba1\u76f8\u5bf9\u8f83\u5c11\uff0c\u7531\u4e8e\u4f10\u6728\u5229\u76ca\u96c6\u56e2\u5bf9\u6700\u8fd1\u7684\u7acb\u6cd5\u65bd\u52a0\u5f71\u54cd\uff0c\u5927\u89c4\u6a21\u7684\u68ee\u6797\u7686\u4f10\u3001\u53e4\u6811\u780d\u4f10\u548c\u5176\u4ed6\u5bf9\u751f\u6001\u4e0d\u53cb\u597d\u7684\u505a\u6cd5\u53d8\u5f97\u8d8a\u6765\u8d8a\u666e\u904d\u3002", "2d779c3d78dfd4cbadccaa5539a2e08c": "\u6cb9\u68d5\u6811\u3001\u6a61\u80f6\u4ee5\u53ca\u8fd1\u671f\u5927\u89c4\u6a21\u79cd\u690d\u7684\u6850\u6cb9\u6811\u3001\u9999\u8549\u3001\u53ef\u53ef\u548c\u6c34\u7a3b\u79cd\u690d\u56ed\uff0c\u5df2\u7ecf\u6539\u53d8\u4e86\u5c3c\u65e5\u5229\u4e9a\u9762\u79ef\u5341\u51e0\u4e07\u516c\u9877\u7684\u68ee\u6797\u548c\u793e\u533a\u519c\u7530\u5229\u7528\u3002\u6765\u81ea\u6b27\u6d32\u3001\u7f8e\u6d32\u548c\u4e9a\u6d32\u7684\u516c\u53f8\u4e0d\u65ad\u6295\u8d44\u5927\u89c4\u6a21\u79cd\u690d\u56ed\u9879\u76ee\uff0c\u5f71\u54cd\u56fd\u5bb6\u548c\u5dde\u7ea7\u653f\u5e9c\u4ee5\u727a\u7272\u516c\u6c11\u7684\u571f\u5730\u6743\u548c\u98df\u7269\u6743\u4e3a\u4ee3\u4ef7\uff0c\u4e3a\u7279\u8bb8\u7ecf\u8425\u5730\u63d0\u4f9b\u4fbf\u5229\u3002\u800c\u5728\u5404\u9879\u6cd5\u5f8b\u548c\u7a0b\u5e8f\u5f97\u5230\u6279\u51c6\u3001\u9879\u76ee\u51c6\u5907\u5b9e\u65bd\u4e4b\u524d\uff0c\u4eba\u4eec\u9c9c\u6709\u6216\u4ece\u65e0\u9014\u5f84\u4e86\u89e3\u5230\u76f8\u5173\u4fe1\u606f\u3002", "09e9b6533f0b23e3c6247b67c18614a0": "\u5728 GFW \u535a\u5ba2\u4e0a\u9605\u8bfb\u66f4\u591a\u5173\u4e8e  Women Research Institute \u9879\u76ee\u7684\u4fe1\u606f", "72761365f2df600de0888185f4509649": "PILF \u4e0e\u793e\u533a\u56e2\u4f53\u5408\u4f5c\uff0c\u7740\u624b\u8c03\u67e5\u6709\u5173\u975e\u6cd5\u6ee5\u4f10\u7684\u7533\u8bc9\uff0c\u5e76\u672a\u53ef\u80fd\u7684\u8bc9\u8bbc\u505a\u51c6\u5907\u3002PILF \u9879\u76ee\u7684\u53e6\u4e00\u9879\u91cd\u8981\u5185\u5bb9\u662f\u63d0\u9ad8\u4e86\u65af\u91cc\u5170\u5361\u793e\u4f1a\u5bf9\u4e8e GFW \u6f5c\u5728\u5e94\u7528\u65b9\u5f0f\u7684\u8ba4\u8bc6\uff0c\u4ece\u800c\u6539\u5584\u68ee\u6797\u7ba1\u7406\u3002\u901a\u8fc7\u4e00\u7cfb\u5217\u7814\u8ba8\u4f1a\uff0cPILF \u5bf9\u65b0\u95fb\u8bb0\u8005\u3001NGO \u548c\u653f\u5e9c\u5b98\u5458\u8fdb\u884c\u4e86\u57f9\u8bad\uff0c\u4f20\u6388\u4ed6\u4eec\u5982\u4f55\u4f7f\u7528 GFW \u5e73\u53f0\u3002\uff08\u5730\u56fe\u6765\u81ea PILF\uff0c\u5c55\u793a\u4e86\u65af\u91cc\u5170\u5361\u7684\u68ee\u6797\u8986\u76d6\uff1b\u7167\u7247\u6765\u81ea PILF\u3002\uff09", "51c49a5175f2f02bcdc114dcabdf3b30": "\u5728 GFW \u535a\u5ba2\u4e0a\u9605\u8bfb\u66f4\u591a\u5173\u4e8e  Instituto Araguaia \u9879\u76ee\u7684\u4fe1\u606f\u3002", "b8e46d698fdecf9e79871f111f38bdf7": "\u5728 GFW \u535a\u5ba2\u4e0a\u9605\u8bfb\u66f4\u591a\u5173\u4e8e Reporter Brasil \u9879\u76ee\u7684\u4fe1\u606f\u3002", "c0b8f6ac8e84e5e83507e0e5fd444449": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Transparent World</a> \u6536\u96c6\u3001\u6c47\u7f16\u5e76\u63d0\u4f9b\u4e86\u6709\u5173\u4fc4\u7f57\u65af\u9ad8\u4fdd\u62a4\u4ef7\u503c\u68ee\u6797 (High Conservation Value Forests, HCVF) \u7684\u7a7a\u95f4\u6570\u636e\u3002\u8fd9\u4e9b HCVF \u6570\u636e\u96c6\u542b\u6709\u539f\u59cb\u68ee\u6797\u666f\u89c2\u3001\u91cd\u8981\u9e1f\u7c7b\u533a\u57df\u3001\u56fd\u5bb6/\u7701\u7ea7\u4fdd\u62a4\u533a\u7b49\u65b9\u9762\u7684\u7a7a\u95f4\u4fe1\u606f\uff0c\u5728\u81ea\u613f\u68ee\u6797\u8ba4\u8bc1\u7528\u9014\u65b9\u9762\u5f97\u5230\u4e86\u68ee\u6797\u4f01\u4e1a\u548c NGO \u4fdd\u62a4\u7ec4\u7ec7\u7684\u5e7f\u6cdb\u91c7\u7eb3\u548c\u9ad8\u5ea6\u80af\u5b9a\u3002Transparent World \u521b\u5efa\u4e86\u4ee5\u5730\u56fe\u4e3a\u57fa\u7840\u7684\u5168\u56fd\u6027\u4e92\u52a8\u95e8\u6237\u7f51\u7ad9\uff0c\u5e76\u8f85\u4ee5 GFW \u6570\u636e\uff0c\u4ee5\u4fbf\u66f4\u597d\u5730\u5411\u4e3b\u8981\u5229\u76ca\u76f8\u5173\u65b9\u4ecb\u7ecd\u9ad8\u4fdd\u62a4\u4ef7\u503c\u68ee\u6797\u3002\uff08\u7167\u7247\u7531 Transparent World \u63d0\u4f9b\u3002\uff09", "3c71b8e19c21a549b8934c039408539f": "\u5728 GFW \u535a\u5ba2\u4e0a\u9605\u8bfb\u66f4\u591a\u5173\u4e8e  Women Research Institute \u9879\u76ee\u7684\u4fe1\u606f\u3002", "459724ec6eedb7c961fb814107a829f5": "\u5021\u5bfc\uff0c\u65b0\u95fb", "c582506fc1bd4b8ebbdbeb28e8a61abd": "\u4e3a\u63d0\u9ad8\u6280\u672f\u5e94\u7528\u7387\u548c\u5b9e\u9645\u6548\u7528\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">The Center for People and Forests</a> \u548c Tempo Witness \u4ee5 Forest Watcher\u3001VIIRS \u6d3b\u8dc3\u706b\u707e\u8b66\u62a5\u548c Tempo Witness \u5e94\u7528\u4e3a\u57fa\u7840\uff0c\u5f00\u53d1\u4e86\u4e00\u6b3e\u516c\u4f17\u79d1\u5b66\u706b\u707e\u76d1\u6d4b\u7cfb\u7edf\u3002\u5176\u9879\u76ee\u5bf9\u5370\u5ea6\u5c3c\u897f\u4e9a\u5360\u7891\u7701\u897f\u4e39\u620e\u52a0\u90a6\u53bf\u4e09\u4e2a\u6751\u5e84\u7684\u5730\u65b9\u653f\u5e9c\u5b98\u5458\u548c\u793e\u533a\u6210\u5458\u8fdb\u884c\u4e86\u80fd\u529b\u5efa\u8bbe\uff0c\u4f20\u6388\u4ed6\u4eec\u4f7f\u7528\u8fd9\u4e9b\u5de5\u5177\uff0c\u4ee5\u52a0\u5f3a\u5f53\u5730\u5229\u76ca\u76f8\u5173\u65b9\u5728\u68ee\u6797\u706b\u707e\u76d1\u6d4b\u3001\u62a5\u544a\u548c\u9632\u63a7\u65b9\u9762\u7684\u5de5\u4f5c\u3002\uff08\u56fe\u7247\u7531 The Center for People and Forests \u63d0\u4f9b\uff09", "140c0cac35cab6ca159ee1dd0a425c2b": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u4e16\u754c\u81ea\u7136\u57fa\u91d1\u4f1a\u5df4\u62c9\u572d\u5206\u4f1a (WWF \u2013 Paraguay)</a> \u4e0e\u5df4\u62c9\u572d\u56fd\u5bb6\u68ee\u6797\u7814\u7a76\u6240 (INFONA) \u5408\u4f5c\uff0c\u57fa\u4e8e GLAD \u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u5f00\u53d1\u4e86\u4e00\u6b3e\u68ee\u6797\u6ee5\u4f10\u68c0\u6d4b\u548c\u4f18\u5148\u7ea7\u7ba1\u7406\u7684\u5b9e\u7528\u5de5\u5177\u3002WWF-Paraguay \u548c INFONA \u8fd0\u7528 GFW \u7684 Places to Watch \u65b9\u6cd5\u548c\u56fd\u5bb6\u6570\u636e\u96c6\uff0c\u5728 Google \u5730\u7403\u5f15\u64ce\u4e0a\u521b\u5efa\u4e86 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">GLAD \u8b66\u62a5\u4f18\u5148\u7ea7\u7ba1\u7406\u5de5\u5177</a>\uff0c\u4ee5\u786e\u5b9a\u5df4\u62c9\u572d\u5404\u5730\u68ee\u6797\u6ee5\u4f10\u70ed\u70b9\u7684\u4f18\u5148\u6b21\u5e8f\u3002\u8be5\u5de5\u5177\u53ef\u514d\u8d39\u4f7f\u7528\u548c\u8bbf\u95ee\uff0c\u5e76\u53ef\u6839\u636e\u7528\u6237\u9700\u6c42\u8fdb\u884c\u5b9a\u5236\u3002(\u56fe\u7247\u6765\u81ea WWF \u2013 Paraguay\uff09", "529179d0dfa68b4b0e976834c8081bbf": "Harry Surjadi \u662f\u4e00\u4f4d\u6765\u81ea\u5370\u5ea6\u5c3c\u897f\u4e9a\u7684\u73af\u5883\u65b0\u95fb\u8bb0\u8005\u3002\u8fc7\u53bb 25 \u5e74\u591a\u6765\uff0cHarry \u4e00\u76f4\u5728\u62a5\u9053\u5370\u5ea6\u5c3c\u897f\u4e9a\u5883\u5185\u7684\u4e3b\u8981\u73af\u5883\u548c\u79d1\u6280\u95ee\u9898\u30022011 \u5e74\uff0c\u5728\u83b7\u5f97 a Knight International Journalism Fellow \u671f\u95f4\uff0cHarry \u5f00\u53d1\u4e86\u4e00\u79cd\u540d\u4e3a\u201c\u4fe1\u606f\u7ecf\u7eaa\u5546\u201d(Information Broker) \u7684\u57fa\u5c42\u4f20\u64ad\u673a\u5236\uff0c\u4ee5\u62a5\u9053\u5370\u5c3c\u504f\u8fdc\u5730\u533a\u7684\u975e\u6cd5\u68ee\u6797\u6d3b\u52a8\u3002\u5728\u83b7\u5f97 GFW \u6280\u672f\u7814\u7a76\u91d1\u671f\u95f4\uff0cHarry \u4e0e\u5370\u5ea6\u5c3c\u897f\u4e9a\u56fd\u5185\u6742\u5fd7 Tempo \u5408\u4f5c\u5f00\u53d1\u4e86\u4e00\u6b3e\u5e94\u7528\uff0c\u4f9b\u519c\u6751\u793e\u533a\u76d1\u6d4b\u548c\u62a5\u544a\u6709\u5bb3\u7684\u68ee\u6797\u6d3b\u52a8\uff0c\u5e76\u5c1d\u8bd5\u5c06 GFW \u6570\u636e\u6574\u5408\u8fdb\u5e94\u7528\u7cfb\u7edf\u3002\u7ecf\u8fc7\u4e0e\u653f\u5e9c\u548c\u975e\u653f\u5e9c\u673a\u5173\u7684\u591a\u79cd\u5c1d\u8bd5\uff0cHarry \u83b7\u5f97\u4e86\u5404\u754c\u5bf9 New Information Broker \u5e94\u7528\u7684\u5927\u529b\u652f\u6301\uff0c\u5e76\u5c06\u5728 2019 \u5e74\u7ee7\u7eed\u5f00\u53d1\u8fd9\u4e00\u6a21\u578b\uff0c\u5e76\u57f9\u8bad\u8be5\u7f51\u7edc\u4e0a\u7684\u5176\u4ed6\u7528\u6237\u4f7f\u7528 GFW\u3002\uff08\u7167\u7247\u7531 Harry Surjadi \u63d0\u4f9b\uff09\u3002", "c6ceafd0e0d007708a22dfc84b24811a": "Robert Tumwesigye Baganda \u662f Pro-Biodiversity Conservationists in Uganda (PROBICOU) \u7684\u6267\u884c\u79d8\u4e66\u3002\u4ed6\u7684 GFW \u6280\u672f\u7814\u7a76\u91d1\u9879\u76ee\u4fa7\u91cd\u4e8e GFW \u5de5\u5177\u7684\u4f7f\u7528\uff0c\u4ee5\u76d1\u6d4b\u4e4c\u5e72\u8fbe Kalinzu \u4e2d\u592e\u68ee\u6797\u4fdd\u62a4\u533a\u3001he Kasyoha-Kitomi \u4e2d\u592e\u68ee\u6797\u4fdd\u62a4\u533a\u548c\u4f0a\u4e3d\u838e\u767d\u5973\u738b\u56fd\u5bb6\u516c\u56ed (Queen Elizabeth National Park) \u7684\u68ee\u6797\u6ee5\u4f10\u52a8\u56e0\u3002\u5728\u4e4c\u5e72\u8fbe\u91ce\u751f\u52a8\u7269\u7ba1\u7406\u5c40 (Uganda Wildlife Authority, UWA) \u7684\u652f\u6301\u4e0b\uff0cRobert \u76d1\u6d4b\u4e86\u4f0a\u4e3d\u838e\u767d\u5973\u738b\u56fd\u5bb6\u516c\u56ed\u4e2d\u7684 GLAD \u8b66\u62a5\uff0c\u5e76\u660e\u786e\u4e86\u68ee\u6797\u6ee5\u4f10\u7684\u539f\u56e0\u3002\u7531\u4e8e Robert \u7684\u7814\u7a76\uff0cUWA \u548c\u56fd\u5bb6\u6797\u4e1a\u5c40\u840c\u53d1\u4e86\u66f4\u5e7f\u6cdb\u5730\u91c7\u7eb3 GFW \u5de5\u5177\u652f\u6301\u68ee\u6797\u76d1\u6d4b\u5de5\u4f5c\u7684\u610f\u613f\u3002\uff08\u7167\u7247\u6765\u81ea Robert Tumwesigye Baganda\uff09", "00fa49d081629b4573b3589699a2fd0c": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Brazilian Team for the Conservation of the Amazon</a> (ECAM) \u4e0e <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Institute for Conservation and Sustainable Development of the Amazon</a> (IDESAM) \u5408\u4f5c\uff0c\u4e3a\u4fdd\u62a4\u56fe\u76ae-\u8499\u5fb7\u539f\u4f4f\u6c11\u5eca\u9053 (Tupi-Mond\u00e9 Indigenous Corridor)\u2014\u2014\u4e00\u4e2a\u6df1\u53d7\u519c\u4e1a\u751f\u4ea7\u6d3b\u52a8\u3001\u975e\u6cd5\u4f10\u6728\u548c\u5c0f\u89c4\u6a21\u91c7\u77ff\u5a01\u80c1\u7684\u4fdd\u62a4\u6797\u533a\u800c\u6253\u9020\u653f\u6cbb\u52a8\u80fd\u3002\u4e3a\u5b9e\u73b0\u8fd9\u4e00\u76ee\u6807\uff0c\u4ed6\u4eec\u7f16\u5236\u4e86 Deforestation Bulletins \u5b63\u520a\uff0c\u8be5\u520a\u7269\u7ed3\u5408\u4e86 GFW \u548c\u56fd\u5bb6\u6765\u6e90\u7684\u6570\u636e\uff0c\u4ee5\u53ca\u53cd\u6620\u68ee\u6797\u6ee5\u4f10\u5bf9\u539f\u4f4f\u6c11\u751f\u6d3b\u548c\u4f20\u7edf\u6587\u5316\u9020\u6210\u7684\u5f71\u54cd\u7684\u8be6\u5b9e\u8bc1\u636e\u548c\u8bc1\u8bcd\u3002\u8fd9\u4e9b\u516c\u544a\u968f\u540e\u4f20\u64ad\u81f3\u4e3b\u8981\u7684\u5730\u65b9\u548c\u56fd\u5bb6\u4e3b\u4f53\u4ee5\u53ca\u5a92\u4f53\uff0c\u4ea7\u751f\u4e86\u6570\u4e2a\u805a\u7126\u8fd9\u4e9b\u9886\u5730\u6240\u9762\u4e34\u5a01\u80c1\u7684\u65b0\u95fb\u62a5\u9053\u548c\u5e7f\u64ad\u8282\u76ee\uff0c\u5f15\u53d1\u4e86\u5e7f\u6cdb\u5173\u6ce8\u3002\u8be5\u9879\u76ee\u5229\u7528\u79d1\u5b66\u6570\u636e\u8bb2\u8ff0\u4eba\u7c7b\u6545\u4e8b\uff0c\u4fc3\u4f7f\u5f53\u5730\u8fc5\u901f\u91c7\u53d6\u884c\u52a8\uff0c\u4e3a 7 \u5757\u539f\u4f4f\u6c11\u9886\u5730\u4e0a\u7684\u5c45\u6c11\u63d0\u4f9b\u4e86\u5fc5\u8981\u7684\u4ea4\u6d41\u5de5\u5177\u548c\u7b56\u7565\uff0c\u4fdd\u62a4\u4e86\u4ed6\u4eec\u7684\u6c11\u65cf\u9057\u4ea7\u3002ECAM \u548c IDESAM \u4e5f\u6210\u529f\u7b79\u96c6\u5230\u4e86\u989d\u5916\u8d44\u91d1\uff0c\u4ece\u800c\u5c06\u516c\u544a\u7684\u62a5\u9053\u8303\u56f4\u6269\u5927\u81f3\u6717\u591a\u5c3c\u4e9a\u5dde\u7684\u6240\u6709\u539f\u4f4f\u6c11\u9886\u5730\u3002\uff08\u5730\u56fe\u6765\u81ea ECAM\uff0c\u663e\u793a\u4e86\u539f\u4f4f\u6c11\u9886\u5730\u548c\u6797\u5730\uff1b\u7167\u7247\u6765\u81ea ECAM\u3002\uff09", "53b2080e0960b2ca5a5225fb7410a236": "\u8be5\u9879\u76ee\u65e8\u5728\u63d0\u9ad8\u516c\u4f17\u8ba4\u8bc6\uff0c\u8ba9\u4eba\u4eec\u4e86\u89e3\u5df4\u897f\u4e9a\u9a6c\u5b59\u539f\u4f4f\u6c11\u571f\u5730\u4e0a\u7684\u68ee\u6797\u6ee5\u4f10\u73b0\u72b6\uff0c\u4ee5\u53ca\u539f\u4f4f\u6c11\u662f\u5982\u4f55\u4fdd\u62a4\u8fd9\u4e9b\u68ee\u6797\u7684\u3002\u7531\u4e8e\u5df4\u897f\u653f\u5e9c\u6253\u51fb\u68ee\u6797\u6ee5\u4f10\u7684\u529b\u5ea6\u5728\u51cf\u5f31\uff0c\u8fd9\u4e9b\u539f\u4f4f\u6c11\u5f00\u59cb\u81ea\u884c\u4fdd\u62a4\u68ee\u6797\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Reporter Brasil</a> \u6839\u636e GFW \u5730\u56fe\u4e0a\u663e\u793a\u7684\u539f\u4f4f\u6c11\u9886\u5730\u7684\u68ee\u6797\u6ee5\u4f10\u60c5\u51b5\uff0c\u5e7f\u6cdb\u62a5\u9053\u4e86\u4e00\u7cfb\u5217\u8c03\u67e5\u65b0\u95fb\u3002\u8fd9\u4e9b\u62a5\u9053\u51f8\u663e\u4e86\u5df4\u897f\u5404\u5730\u539f\u4f4f\u6c11\u571f\u5730\u4e0a\u65e5\u76ca\u4e25\u5cfb\u7684\u68ee\u6797\u635f\u5931\u73b0\u72b6\uff0c\u5e76\u5448\u73b0\u4e86\u539f\u4f4f\u6c11\u53cd\u51fb\u975e\u6cd5\u6d3b\u52a8\u7684\u79cd\u79cd\u52aa\u529b\u3002\uff08\u5730\u56fe\u6765\u81ea Reporter Brasil\uff0c\u5bf9\u6bd4\u4e86\u539f\u4f4f\u6c11\u571f\u5730\u5185\u5916\u7684\u6811\u6728\u635f\u5931\u72b6\u51b5\u3002\uff09", "7f405d7ae722e3b1920b0e752f8197ee": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Red Panda Network</a> (RPN) \u5f00\u53d1\u4e86\u4e00\u6b3e\u4ee5\u793e\u533a\u4e3a\u57fa\u7840\u7684\u91ce\u751f\u52a8\u7269\u7ba1\u7406\u7cfb\u7edf\uff0c\u4ee5\u4fdd\u62a4\u5c3c\u6cca\u5c14\u5883\u5185\u559c\u9a6c\u62c9\u96c5\u5c0f\u718a\u732b\u7684\u68ee\u6797\u6816\u606f\u5730\u3002RPN \u4e0e\u4ee3\u8868 30 \u4e2a\u793e\u533a\u68ee\u6797\u7684\u5f53\u5730\u793e\u533a\u5408\u4f5c\uff0c\u4ee5 GFW \u5de5\u5177\u4e3a\u57fa\u7840\uff0c\u6784\u5efa\u4e86\u4e00\u5957\u957f\u671f\u7684\u793e\u533a\u76d1\u6d4b\u7cfb\u7edf\u3002\u8fd9\u5305\u62ec\u5efa\u7acb\u4e86 20 \u4e2a\u4ee3\u8868\u559c\u9a6c\u62c9\u96c5\u5c0f\u718a\u732b\u91cd\u8981\u6816\u606f\u5730\u7684\u65b0\u76d1\u6d4b\u533a\u5757\uff0c\u57f9\u8bad\u4e86 35 \u4f4d\u793e\u533a\u62a4\u6797\u5458\u4f7f\u7528 GFW\uff0c\u4ee5\u53ca\u5236\u5b9a\u4e86\u68ee\u6797\u76d1\u6d4b\u548c\u5de1\u903b\u4f8b\u7a0b\u3002RPN \u901a\u8fc7\u79ef\u6781\u5efa\u8bbe\u519c\u6751\u793e\u533a\u7684\u76d1\u6d4b\u80fd\u529b\uff0c\u534f\u52a9\u6784\u5efa\u4e86\u4e00\u5957\u66f4\u7a33\u5065\u3001\u53ef\u6301\u7eed\u7684\u5305\u5bb9\u6027\u65b9\u6cd5\u6765\u4fdd\u62a4\u559c\u9a6c\u62c9\u96c5\u5c0f\u718a\u732b\u53ca\u5176\u68ee\u6797\u6816\u606f\u5730\u3002\uff08\u56fe\u7247\u7531 Red Panda Network \u63d0\u4f9b\uff09", "91eaa19d9a79cf22394e562a2400ccc5": "Society of Indonesian Environmental Journalists (SIEJ) \u5c06 Global Forest Watch \u7684\u529f\u80fd\u7eb3\u5165\u4e86\u5176\u7f51\u7ad9 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Ekuatorial.com</a> \u7684\u591a\u5a92\u4f53\u5305\uff0c\u901a\u8fc7\u65b0\u95fb\u5b9e\u8df5\u7684\u65b9\u5f0f\u6539\u8fdb\u6570\u636e\u91c7\u96c6\u548c\u9a8c\u8bc1\u3002\u73b0\u5728\uff0cSIEJ \u65b0\u95fb\u5b9e\u9a8c\u5ba4\u7684\u65b0\u95fb\u8bb0\u8005\u4eec\u53ef\u4ee5\u66f4\u597d\u5730\u7406\u89e3 GFW \u6570\u636e\u56fe\u5c42\u4e0e\u6240\u62a5\u9053\u5730\u533a\u4e4b\u95f4\u7684\u5173\u7cfb\uff0c\u5e76\u638c\u63e1\u5982\u4f55\u8fd0\u7528\u6b64\u7c7b\u4fe1\u606f\u66f4\u52a0\u751f\u52a8\u5730\u62a5\u9053\u5370\u5c3c\u68ee\u6797\u4e2d\u53d1\u751f\u7684\u6545\u4e8b\u3002\uff08\u7167\u7247\u7531 SIEJ \u63d0\u4f9b\u3002\uff09", "2ab0cdd78a699bf2d5d64bce0be86dcf": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Amaz\u00f3nicos por la Amazon\u00eda</a> (AMPA) \u81f4\u529b\u4e8e\u90e8\u7f72\u4ed6\u4eec\u5728\u7b2c\u4e00\u4e2a SGF \u9879\u76ee\u4e2d\u6784\u5efa\u7684\u7ba1\u63a7\u548c\u76d1\u7763\u7cfb\u7edf\uff0c\u8be5\u9879\u76ee\u4fa7\u91cd\u4e8e\u521b\u5efa\u4e00\u4e2a\u5f3a\u6548\u76d1\u6d4b\u7cfb\u7edf\uff0c\u4ee5\u4fdd\u62a4\u79d8\u9c81\u5723\u9a6c\u4e01\u5fd7\u613f\u548c\u793e\u533a\u4fdd\u62a4\u7f51\u7edc\u4e2d\u7684\u79c1\u4eba\u4fdd\u62a4\u5730\u3002\u901a\u8fc7\u4e00\u6574\u5957\u7814\u8ba8\u4f1a\u3001\u4f7f\u7528\u624b\u518c\u3001\u4fe1\u606f\u56fe\u8868\u548c\u57fa\u4e8e Global Forest Watch \u7684\u6570\u5b57\u5316\u5185\u5bb9\uff0cAMPA \u5bf9\u6765\u81ea\u8be5\u7f51\u7edc\u7684\u5fd7\u613f\u8005\u4eec\u8fdb\u884c\u4e86\u57f9\u8bad\uff0c\u8ba9\u4ed6\u4eec\u638c\u63e1\u4e86\u76d1\u6d4b\u7279\u8bb8\u7ecf\u8425\u533a\u8fb9\u754c\u6240\u9700\u7684\u5de5\u5177\u548c\u6280\u80fd\u3002AMPA \u8fd8\u534f\u52a9\u7f16\u5199\u4e86 GLAD \u68ee\u6797\u6ee5\u4f10\u548c\u5b9e\u5730\u6838\u67e5\u62a5\u544a\uff0c\u8be5\u62a5\u544a\u5df2\u4f5c\u4e3a\u6cd5\u5f8b\u7533\u8bc9\u63d0\u4ea4\u81f3\u79d8\u9c81\u73af\u5883\u4e8b\u52a1\u7279\u522b\u68c0\u5bdf\u5b98 (Specialized Prosecutors in Environmental Affairs, FEMA) \u8fdb\u884c\u8c03\u67e5\u3002FEMA \u5df2\u5c06\u6b63\u5f0f\u8ba4\u53ef\u8fd9\u4e9b\u62a5\u544a\u4e3a\u73af\u5883\u72af\u7f6a\u7684\u8bc1\u636e\u3002\uff08\u56fe\u7247\u7531 AMPA \u63d0\u4f9b\uff09", "4f7eb8f6331e45235896e824af72d18a": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Amaz\u00f3nicos por la Amazon\u00eda</a> (AMPA) \u5c06\u57fa\u4e8e\u4ed6\u4eec\u8fc7\u5f80\u7684\u5c0f\u989d\u8d44\u52a9\u91d1\u9879\u76ee\u6210\u679c\uff0c\u52a0\u5f3a\u5c5e\u4e8e\u5723\u9a6c\u4e01\u5fd7\u613f\u548c\u793e\u533a\u4fdd\u62a4\u7f51\u7edc (Volunteer and Communal Conservation Network in San Mart\u00edn) \u7684 43 \u4e2a\u4fdd\u62a4\u9879\u76ee\u7684\u7ba1\u63a7\u548c\u76d1\u7763\u7cfb\u7edf\u3002AMPA \u5c06\u7ee7\u7eed\u7740\u529b\u4e8e\u7f51\u7edc\u76d1\u6d4b\u5458\u7684\u80fd\u529b\u5efa\u8bbe\u548c\u4e3b\u52a8\u53c2\u4e0e\u5ea6\uff0c\u6307\u5bfc\u4ed6\u4eec\u8fd0\u7528 GFW \u6570\u636e\u548c\u5de5\u5177\uff0c\u4e3a\u63d0\u4ea4\u81f3\u73af\u5883\u4e8b\u52a1\u90e8\u95e8\u7279\u522b\u68c0\u5bdf\u5b98\u53ca\u76f8\u5173\u90e8\u95e8\u7684\u7533\u8bc9\u63d0\u4f9b\u8bc1\u636e\u3002\uff08\u56fe\u7247\u6765\u81ea AMPA \u5458\u5de5\uff1aVirginie Dezetter\u3001Lenin Quevedo \u548c Almendra Massiel\uff09\u3002", "750922b540b3a5682f9e1cac7493c67e": "\u5f80\u5c4a SGF \u83b7\u5f97\u8005 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">ICV</a> \u5c06\u652f\u6301\u9a6c\u6258\u683c\u7f57\u7d22\u5dde\u68c0\u5bdf\u5b98\u529e\u516c\u5ba4 (MPMT) \u8fdb\u4e00\u6b65\u638c\u63e1\u548c\u63a8\u5e7f GFW \u7684\u4f7f\u7528\uff0c\u4ee5\u52a0\u5927\u884c\u52a8\u529b\u5ea6\uff0c\u904f\u5236\u73af\u5883\u72af\u7f6a\u5e76\u8ffd\u7a76\u571f\u5730\u6240\u6709\u8005\u7684\u8d23\u4efb\u3002ICV \u5c06\u5bf9\u68c0\u5bdf\u5b98\u7684\u6280\u672f\u4eba\u5458\u8fdb\u884c GFW \u4f7f\u7528\u57f9\u8bad\uff0c\u652f\u6301\u5b9e\u65bd\u76d1\u6d4b\u548c\u6570\u636e\u4f7f\u7528\u4f8b\u7a0b\uff0c\u5e76\u4e3a\u9700\u8981\u901a\u77e5\u548c\u67e5\u8be2\u7684\u533a\u57df\u521b\u5efa\u7a7a\u95f4\u6570\u636e\u5e93\uff0c\u4ee5\u76d1\u6d4b\u6ee5\u4f10\u7ba1\u63a7\u884c\u52a8\u7684\u6210\u679c\u3002\uff08\u56fe\u7247\u7531 ICV \u63d0\u4f9b\uff09\u3002", "e3070c53c96b69023f47ca2e96f0a6a7": "\u5f80\u5c4a SGF \u83b7\u5f97\u8005 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">SAILD</a> \u5c06\u7ee7\u7eed\u5f00\u5c55\u5bf9 Deng Deng \u56fd\u5bb6\u516c\u56ed (DDNP) \u7684\u5ba3\u4f20\u548c\u76d1\u6d4b\u5de5\u4f5c\u3002\u901a\u8fc7\u8be5\u9879\u76ee\uff0cSAILD \u65e8\u5728\u52a0\u5f3a\u516c\u56ed\u4fdd\u62a4\u7ba1\u7406\u5355\u4f4d (CMU) \u548c DDNP \u5468\u8fb9\u5f53\u5730\u793e\u533a\u7684\u68ee\u6797\u76d1\u6d4b\u5de5\u4f5c\uff0c\u4ece\u800c\u51cf\u8f7b DDNP \u7684\u4fdd\u62a4\u538b\u529b\u3002SAILD \u5c06\u5efa\u8bbe CMU \u548c\u793e\u533a\u4f7f\u7528 GFW \u7684\u80fd\u529b\uff0c\u5c06\u8fd9\u4e9b\u5de5\u5177\u7eb3\u5165 DDNP \u7684\u76d1\u6d4b\u673a\u5236\uff0c\u5e76\u8bb0\u5f55\u548c\u5ba3\u4f20\u516c\u56ed\u6240\u9762\u4e34\u7684\u73af\u5883\u538b\u529b\u3002\uff08\u56fe\u7247\u6765\u81ea SAILD \u5de5\u4f5c\u4eba\u5458\uff1aRodrigue Kouang \u548c Phanuella Djanteng\uff09\u3002", "ed59a596e617dddf7ba7d821101b6d28": "Intag \u5c71\u8c37\u662f\u5384\u74dc\u591a\u5c14\u56e0\u5df4\u5e03\u62c9\u7701\u4e00\u4e2a\u751f\u7269\u70ed\u70b9\u30022019 \u5e74\u65f6\uff0cIntag \u5c71\u8c37 96% \u7684\u9762\u79ef\u90fd\u88ab\u8bbe\u7acb\u4e3a\u540d\u4e3a ACUSMIT \u7684\u5e02\u7ea7\u4fdd\u62a4\u533a\u3002\u5c3d\u7ba1 ACUSMIT \u5728\u751f\u7269\u591a\u6837\u6027\u65b9\u9762\u6781\u5177\u91cd\u8981\u6027\uff0c\u4f46\u4f9d\u7136\u9762\u4e34\u68ee\u6797\u6ee5\u4f10\u7684\u5404\u7c7b\u5a01\u80c1\uff0c\u7279\u522b\u662f\u975e\u6cd5\u91c7\u77ff\u7684\u5165\u4fb5\u3002<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Aves y Conservaci\u00f3n</a> \u5c06\u4e0e\u5730\u533a\u76f8\u5173\u90e8\u95e8\u548c\u5f53\u5730\u793e\u533a\u7d27\u5bc6\u534f\u4f5c\uff0c\u52a0\u5f3a\u5bf9 ACUSMIT \u7684\u68ee\u6797\u76d1\u6d4b\u5de5\u4f5c\uff0c\u5e76\u52aa\u529b\u4f9d\u6cd5\u62a5\u544a\u548c\u963b\u6b62\u91c7\u6398\u6d3b\u52a8\u548c\u6ee5\u4f10\u884c\u4e3a\u3002(\u56fe\u7247\u7531 Aves y Conservaci\u00f3n \u63d0\u4f9b\uff09\u3002", "7fd1bbda7da7fc6d268925808da6a087": "\u8fc7\u53bb\u4e09\u5e74\u95f4\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">HAkA</a> \u4e0e\u5370\u5c3c\u4e9a\u9f50\u7701\u7684\u6797\u4e1a\u90e8\u95e8\u548c\u6267\u6cd5\u5b98\u5458\u5f00\u5c55\u4e86\u5e7f\u6cdb\u5408\u4f5c\uff0c\u76d1\u6d4b\u548c\u9632\u8303\u8be5\u533a\u57df\u7684\u6ee5\u4f10\u4e8b\u4ef6\uff0c\u5e76\u91cd\u70b9\u5173\u6ce8\u52d2\u585e\u5c14\u751f\u6001\u7cfb\u7edf\u7684\u72b6\u51b5\u3002\u901a\u8fc7\u65b0\u7684 SGF \u9879\u76ee\uff0cHAkA \u5c06\u7ee7\u7eed\u4e0e\u5f53\u5730\u548c\u5730\u65b9\u73af\u5883\u90e8\u95e8\u5408\u4f5c\uff0c\u5f00\u5c55\u57f9\u8bad\u5e76\u63d0\u9ad8\u76f8\u5173\u90e8\u95e8\u4e4b\u95f4\u7684\u534f\u4f5c\u80fd\u529b\u3002HAkA \u8fd8\u4f1a\u5728\u4e9a\u9f50\u7701\u7684\u5927\u5b66\u6821\u56ed\u4e2d\u5f00\u5c55\u5de5\u4f5c\uff0c\u57f9\u8bad\u8bb2\u5e08\u548c\u5b66\u751f\u4e86\u89e3 GFW\uff0c\u6784\u5efa\u5e74\u8f7b\u4e00\u4ee3\u5bf9\u68ee\u6797\u76d1\u6d4b\u5de5\u4f5c\u7684\u77e5\u8bc6\u50a8\u5907\u548c\u4e13\u4e1a\u6280\u80fd\u3002\uff08\u56fe\u7247\u7531 HAKA \u63d0\u4f9b\uff09\u3002", "0a1d219c9bdf6103c208f0a7e741d59b": "\u793e\u533a\u53c2\u4e0e\uff0c\u65b0\u95fb", "462d24efdb4cfb39f8e3a00967ce43a4": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">IKIAM Foundation</a> \u662f\u4e00\u5bb6\u7531\u539f\u4f4f\u6c11\u9886\u5bfc\u7684 NGO\uff0c\u4ee3\u8868\u5384\u74dc\u591a\u5c14\u7684 Achuar \u6c11\u65cf\u3002\u8be5\u57fa\u91d1\u4f1a\u5c06\u521b\u5efa\u4e00\u4e2a\u53ef\u9760\u7684\u68ee\u6797\u6ee5\u4f10\u76d1\u6d4b\u7cfb\u7edf\uff0c\u5373 \u201cAchuar Forest Watch\u201d \u8ba1\u5212\uff0c\u4ee5\u6253\u51fb Achuar \u9886\u5730\u5df4\u6c99\u6728\u7684\u975e\u6cd5\u91c7\u4f10\u884c\u4e3a\u3002IKIAM \u5c06\u4e3a\u9886\u5730\u4e2d 89 \u4e2a Achuar \u793e\u533a\u63d0\u4f9b\u57f9\u8bad\uff0c\u57f9\u517b\u68ee\u6797\u76d1\u6d4b\u7684\u80fd\u529b\u5e76\u6784\u5efa\u5feb\u901f\u54cd\u5e94\u7a0b\u5e8f\u3002\u5176\u76ee\u6807\u662f\u5728\u8fd0\u8425\u7b2c\u4e00\u5e74\u51cf\u5c11 60% \u7684\u975e\u6cd5\u4f10\u6728\u884c\u4e3a\uff0c\u5e76\u4e3a Achuar \u9886\u5730\u6784\u5efa\u4e00\u5957\u53ef\u6301\u7eed\u7684\u76d1\u6d4b\u7cfb\u7edf\u3002\uff08\u56fe\u7247\u7531 IKIAM Foundation \u63d0\u4f9b\uff09\u3002", "041f7c6c8d4cfd56a3df18ff0a622afb": "\u68ee\u6797\u76d1\u6d4b\u548c\u6267\u6cd5\uff0c\u65b0\u95fb", "4dee078b0b58834e86894898eff0d8b6": "240 \u516c\u91cc", "78cdeac478e1ba62b564cfc57b945f87": "\u4f7f\u7528", "9a6875cb7163ef190d1a1e5d0dbeaafc": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Alliance for Conservation of Great Apes in Central Africa (Alliance GSAC)</a> \u7684\u5de5\u4f5c\u91cd\u70b9\u662f\u4fdd\u62a4\u5580\u9ea6\u9686 Ebo \u68ee\u6797\u548c\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u535a\u6d1b\u535a\u9886\u5730\uff0c\u8fd9\u4e9b\u5730\u533a\u906d\u53d7\u5230\u68ee\u6797\u6ee5\u4f10\u548c\u5927\u578b\u7c7b\u4eba\u733f\u6816\u606f\u5730\u9000\u5316\u7684\u4e25\u91cd\u5f71\u54cd\u3002Alliance GSAC \u65e8\u5728\u901a\u8fc7\u6784\u5efa\u4ee5\u793e\u533a\u4e3a\u57fa\u7840\u7684\u76d1\u6d4b\u7f51\u7edc\u6765\u8bc6\u522b\u3001\u8bb0\u5f55\u548c\u4e0a\u62a5\u975e\u6cd5\u6ee5\u4f10\u6d3b\u52a8\uff0c\u4ece\u800c\u52a0\u5f3a\u8fd9\u4e24\u4e2a\u5730\u533a\u5f53\u5730\u793e\u533a\u7684\u68ee\u6797\u76d1\u6d4b\u80fd\u529b\u3002\uff08\u56fe\u7247\u7531 Alliance GSAC \u63d0\u4f9b\uff09\u3002", "4a8ea375373f812d77e2567891eb8ead": "\u4ed6\u4eec\u5728 2023 \u5e74\u5ea6 SGF \u9879\u76ee\u4e2d\u521b\u5efa\u7684\u5185\u5bb9\uff0c\u4ed6\u4eec\u8fd8\u5c06\u4e3a\u76f8\u5173\u90e8\u95e8\u548c\u7ec4\u7ec7\u63d0\u4f9b\u4e13\u95e8\u57f9\u8bad\uff0c\u4f7f\u5176\u80fd\u591f\u4f7f\u7528\u62a5\u544a\u7cfb\u7edf\u548c GFW \u5de5\u5177\uff0c\u66f4\u597d\u5730\u5e94\u5bf9\u68ee\u6797\u6ee5\u4f10\u4e8b\u4ef6\u3002&nbsp;", "7df058a05c95fec44257a262fdf662c1": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">InfoNile</a> \u662f\u4e00\u5bb6\u5730\u7406\u65b0\u95fb\u5a92\u4f53\u5e73\u53f0\u548c\u8de8\u5883\u7f51\u7edc\uff0c\u7531\u6765\u81ea 10 \u4e2a\u5c3c\u7f57\u6cb3\u6d41\u57df\u56fd\u5bb6\u7684 800 \u591a\u540d\u73af\u5883\u65b0\u95fb\u8bb0\u8005\u7ec4\u6210\u3002Water Journalists Africa (WJA) \u662f\u4e00\u5bb6\u603b\u90e8\u4f4d\u4e8e\u4e4c\u5e72\u8fbe\u7684\u975e\u653f\u5e9c\u673a\u6784\uff0c\u65d7\u4e0b\u7684\u73af\u5883\u548c\u6c34\u6587\u65b0\u95fb\u8bb0\u8005\u904d\u5e03\u975e\u6d32\uff0cInfoNile \u5c31\u662f\u5176\u5206\u652f\u673a\u6784\u4e4b\u4e00\u3002InfoNile \u7684\u9879\u76ee\u5c06\u57f9\u8bad\u548c\u652f\u6301\u6765\u81ea InfoNile/WJA \u7f51\u7edc\u7684\u65b0\u95fb\u8bb0\u8005\u4f7f\u7528 GFW \u5de5\u5177\u548c\u6570\u636e\uff0c\u5bf9\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u4e1c\u90e8\u7684\u68ee\u6797\u6ee5\u4f10\u73b0\u72b6\u53ca\u4ece\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u8f93\u9001\u81f3\u975e\u6cd5\u6728\u6750\u5546\u8fc7\u5883\u56fd\u53ca\u76ee\u7684\u5730\u56fd\u7684\u8de8\u5883\u6728\u6750\u8d29\u8fd0\u5c55\u5f00\u8c03\u67e5\u62a5\u9053\u3002", "b2bed1c954f0d8462bf1d9b5a9b4502a": "\u968f\u540e\uff0c\u5c06\u5728\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u3001\u5357\u82cf\u4e39\u3001\u4e4c\u5e72\u8fbe\u3001\u5e03\u9686\u8fea\u3001\u5362\u65fa\u8fbe\u548c\u80af\u5c3c\u4e9a\u8fd9\u4e9b\u56fd\u5bb6\u4e2d\u9009\u62d4 10 \u540d\u65b0\u95fb\u8bb0\u8005\u5e76\u4e3a\u4ed6\u4eec\u63d0\u4f9b\u91cd\u70b9\u652f\u6301\uff0c\u534f\u52a9\u4ed6\u4eec\u9009\u5b9a\u3001\u8c03\u67e5\u5e76\u64b0\u5199\u8de8\u5883\u62a5\u9053\uff0c\u5728 InfoNile \u53ca\u5176\u4ed6\u4e3b\u6d41\u5a92\u4f53\u4e0a\u53d1\u8868\u3002", "8dbfd78f05f1c461d7209d549bd6101f": "InfoNile \u8fd8\u5c06\u5728\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u5883\u5185\u62a5\u9053\u5730\u9644\u8fd1\u7ec4\u7ec7\u793e\u533a\u653e\u6620\u548c\u5c55\u89c8\u6d3b\u52a8\uff0c\u9f13\u52b1\u516c\u4f17\u5173\u6ce8\u62a5\u9053\u7ed3\u679c\u5e76\u91c7\u53d6\u884c\u52a8\u3002", "96e823d2acaaa6038d324698b480f94c": "\u8be5\u9879\u76ee\u4f1a\u5c06 GFW \u8fd1\u5b9e\u65f6\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u7eb3\u5165 IFCAS\uff0c\u540c\u65f6\u534f\u540c\u68ee\u6797\u7ba1\u7406\u5355\u4f4d\uff08\u7ba1\u7406\u5404\u7701\u6797\u4e1a\u670d\u52a1\u533a\u7684\u653f\u5e9c\u7ba1\u7406\u5355\u4f4d\uff09\u52a0\u5f3a\u6267\u6cd5\u884c\u52a8\uff0c\u5e0c\u671b\u80fd\u51cf\u5c11\u5370\u5ea6\u5c3c\u897f\u4e9a\u4fdd\u62a4\u533a\u9762\u4e34\u7684\u68ee\u6797\u6ee5\u4f10\u548c\u5176\u4ed6\u5a01\u80c1\u3002&nbsp;", "8295fa4bfbb10dd856ecc21c6dbb8171": "\u4e3a\u63d0\u9ad8 IMs \u7684\u80fd\u529b\uff0c\u589e\u5f3a\u4ed6\u4eec\u5bf9\u68ee\u6797\u4ea7\u54c1\u91c7\u6536\u76f8\u5173\u6cd5\u5f8b\u7684\u4e86\u89e3\uff0cYPIKI-IFMF \u5c06\u4e0e\u539f\u4f4f\u6c11\u9752\u5e74\u5408\u4f5c\uff0c\u5bf9\u4ed6\u4eec\u8fdb\u884c\u57f9\u8bad\u5e76\u5e2e\u52a9\u4ed6\u4eec\u5c06\u77e5\u8bc6\u4f20\u6388\u7ed9\u5f53\u5730\u5176\u4ed6 IMs\u3002YPIKI-IFMF \u8fd8\u5c06\u81f4\u529b\u4e8e\u4fc3\u8fdb FMUs \u548c IMs \u4e4b\u95f4\u7684\u534f\u4f5c\uff0c\u5229\u7528 GFW \u5de5\u5177\u548c\u6570\u636e\u6539\u8fdb\u68ee\u6797\u76d1\u6d4b\u5de5\u4f5c\u3002&nbsp;&nbsp;", "a77a83229ea376cbe832be0eb72654b8": "2001-2021 \u5e74\u95f4\uff0c\u5370\u5ea6\u5c3c\u897f\u4e9a\u963f\u9c81\u7fa4\u5c9b\u7684\u68ee\u6797\u8986\u76d6\u9762\u79ef\u5171\u51cf\u5c11\u4e86 1.82 \u4e07\u516c\u9877\uff0c\u4e3b\u8981\u539f\u56e0\u662f\u975e\u6cd5\u4f10\u6728\u3002\u963f\u9c81\u7fa4\u5c9b\u7684\u539f\u59cb\u68ee\u6797\u662f\u539f\u4f4f\u6c11\u963f\u9c81\u4eba\u7684\u91cd\u8981\u751f\u6d3b\u8d44\u6599\uff0c<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Forest Watch \u5370\u5c3c\u5206\u90e8</a>\u5c06\u4e0e\u5f53\u5730\u793e\u533a\u5408\u4f5c\uff0c\u4f7f\u5176\u4e86\u89e3\u6728\u6750\u7ba1\u7406\u76f8\u5173\u6cd5\u89c4\uff0c\u5982\u53ef\u6301\u7eed\u6027\u5408\u6cd5\u9a8c\u8bc1\u5236\u5ea6 (Sustainability Legality Verification System, SVLK)\uff0c\u8be5\u5236\u5ea6\u80fd", "694f86966774981d041a6c76433357f4": "\u901a\u8fc7\u5bf9\u5f53\u5730\u793e\u533a\u6210\u5458\u8fdb\u884c\u4fe1\u606f\u80fd\u529b\u5efa\u8bbe\u57f9\u8bad\uff0c\u5982\u901a\u8fc7 GFW \u5e73\u53f0\u6536\u96c6\u548c\u5206\u6790\u6570\u636e\uff0c\u539f\u4f4f\u6c11\u548c\u5f53\u5730\u793e\u533a\u80fd\u63d0\u4f9b\u4fe1\u606f\uff0c\u8fdb\u800c\u4e3e\u62a5\u963f\u9c81\u7fa4\u5c9b\u5b58\u5728\u7684\u975e\u6cd5\u4f10\u6728\u884c\u4e3a\u3002&nbsp;", "f2085c86f56d64cdac39748d0c666c75": "<span class=\"TextRun SCXW217953447 BCX0\" lang=\"EN-US\" xml:lang=\"EN-US\" data-contrast=\"none\"><span class=\"FindHit SCXW217953447 BCX0\">FCA</span><span class=\"FindHit SCXW217953447 BCX0\">T</span><span class=\"NormalTextRun SCXW217953447 BCX0\"> \u5c06\u5f00\u53d1 Choc\u00f3 Forest Watch\uff0c\u8fd9\u6b3e\u65b0\u578b\u5e94\u7528\u8fd0\u7528\u536b\u661f\u548c\u9ad8\u5206\u8fa8\u7387\u65e0\u4eba\u673a\u56fe\u50cf\uff0c\u5e76\u5e94\u7528\u6df1\u5ea6\u5b66\u4e60\u6a21\u578b\uff0c\u9884\u6d4b\u68ee\u6797\u635f\u5931\u548c\u9000\u5316\u3002\u5176\u76ee\u6807\u662f\u5c06\u68c0\u6d4b\u7cbe\u5ea6\u63d0\u9ad8 25%\u3002Choc\u00f3 Forest Watch \u5c06\u5728</span><span class=\"NormalTextRun SCXW217953447 BCX0\"></span> <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">WRI \u7684 MapBuilder \u5e73\u53f0</a></span><span class=\"TextRun SCXW217953447 BCX0\" lang=\"EN-US\" xml:lang=\"EN-US\" data-contrast=\"none\"><span class=\"NormalTextRun SCXW217953447 BCX0\">\u4e0a\u8fd0\u884c\uff0c\u5bf9\u5f53\u5730\u68ee\u6797\u8986\u76d6\u5730\u56fe\u8fdb\u884c\u534a\u81ea\u52a8\u5316\u7684\u6301\u7eed\u66f4\u65b0\uff0c\u4ee5</span><span class=\"NormalTextRun SCXW217953447 BCX0\">\u51c6\u786e</span><span class=\"NormalTextRun SCXW217953447 BCX0\">\u4e14</span><span class=\"NormalTextRun SCXW217953447 BCX0\">\u53ca\u65f6\u5730</span><span class=\"NormalTextRun SCXW217953447 BCX0\">\u8ffd\u8e2a\u68ee\u6797\u6ee5\u4f10\u60c5\u51b5\u3002</span></span>", "4cebac541183929445d0e844c07758a0": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Instituto Boliviano de Investigacion Forestal (IBIF)</a> \u5c06\u4e0e Guarayo Indigenous Forestry Association (AFIG) \u5408\u4f5c\uff0c\u5e2e\u52a9\u5de9\u56fa\u9886\u5730\u76d1\u6d4b\u5355\u4f4d (UTT) \u7684\u5de5\u4f5c\u3002AFIG \u8d1f\u8d23\u76d1\u5bdf Gwarayu \u539f\u4f4f\u6c11\u6c11\u65cf\u9886\u5730\u7684\u6240\u6709\u68ee\u6797\u7ba1\u7406\u65b9\u6848\uff0c\u8be5\u9886\u5730\u4f4d\u4e8e\u73bb\u5229\u7ef4\u4e9a\u4e1c\u90e8\uff0c\u8986\u76d6\u7ea6\u4e3a 130 \u4e07\u516c\u9877\u7684\u68ee\u6797\u9762\u79ef\u3002", "4e1994359bd21c14c373bc8e7b891a0c": "\u5176\u9879\u76ee\u5c06\u57f9\u8bad\u62a4\u6797\u5458\u548c\u793e\u533a\u8b66\u536b\u4f7f\u7528\u914d\u5907\u5730\u7406\u7a7a\u95f4\u529f\u80fd\u7684\u6280\u672f\u578b\u7a7a\u95f4\u76d1\u6d4b\u7cfb\u7edf\uff08\u5982 GFW \u5e73\u53f0\u548c Forest Watcher\uff09\uff0c\u5305\u62ec\u5982\u4f55\u4e0a\u4f20\u3001\u5206\u6790\u5b9e\u5730\u62a5\u544a\u5e76\u5c06\u5176\u7eb3\u5165\u76d1\u6d4b\u6d3b\u52a8\u3002\u4ed6\u4eec\u5c06\u4e3a\u5de1\u6797\u5458\u914d\u5907\u667a\u80fd\u624b\u673a\uff0c\u4ee5\u4f7f\u7528 GFW \u5e73\u53f0\u4e0a\u8fd1\u5b9e\u65f6\u7684\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u3002&nbsp;", "acc6c0f3bfbd02632d563ca896f98c5e": "Samaaka \u9886\u5730\u662f\u4e9a\u9a6c\u5b59\u6d41\u57df\u68ee\u6797\u8986\u76d6\u7387\u6781\u9ad8\u7684\u5730\u533a\uff0c\u4f46\u4f10\u6728\u548c\u91c7\u77ff\u6d3b\u52a8\u6b63\u5728\u5bf9\u5176\u68ee\u6797\u8d44\u6e90\u9020\u6210\u65e5\u76ca\u5267\u70c8\u7684\u7834\u574f\u3002\u7136\u800c\uff0cSamaaka \u9886\u5730\u7684\u5c45\u6c11\u76ee\u524d\u7f3a\u4e4f\u5de5\u5177\u548c\u65b9\u5f0f\u6765\u68c0\u6d4b\u548c\u62a5\u544a\u8fd9\u4e9b\u5a01\u80c1\u53ca\u5176\u5bf9\u68ee\u6797\u548c\u751f\u8ba1\u7684\u5f71\u54cd\u3002<span class=\"TextRun SCXW196261371 BCX0\" lang=\"EN-US\" xml:lang=\"EN-US\" data-contrast=\"none\"><span class=\"NormalTextRun SCXW196261371 BCX0\">The<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\"> Association of Samaaka Communities (VSG) </a></span></span> <span class=\"TextRun SCXW196261371 BCX0\" lang=\"EN-US\" xml:lang=\"EN-US\" data-contrast=\"none\"><span class=\"NormalTextRun SCXW196261371 BCX0\">\u5c06\u5728 </span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW196261371 BCX0\">Sam</span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW196261371 BCX0\">a</span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW196261371 BCX0\">aka</span><span class=\"NormalTextRun SCXW196261371 BCX0\"> \u9886\u5730\u6253\u9020\u4e00\u4e2a\u4ee5\u793e\u533a\u4e3a\u57fa\u7840\u7684\u76d1\u6d4b\u4f53\u7cfb\uff0c</span><span class=\"NormalTextRun SCXW196261371 BCX0\">\u57f9\u517b</span><span class=\"NormalTextRun SCXW196261371 BCX0\"></span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW196261371 BCX0\"> Sam</span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW196261371 BCX0\">a</span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW196261371 BCX0\">aka</span><span class=\"NormalTextRun SCXW196261371 BCX0\"> \u5c45\u6c11</span><span class=\"NormalTextRun SCXW196261371 BCX0\">\u53c2\u4e0e</span><span class=\"NormalTextRun SCXW196261371 BCX0\">\u68ee\u6797\u76d1\u6d4b\u7684\u80fd\u529b\uff0c\u5982\u5411\u5f53\u5730 </span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW196261371 BCX0\">Sam</span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW196261371 BCX0\">a</span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW196261371 BCX0\">aka</span><span class=\"NormalTextRun SCXW196261371 BCX0\"> \u9752\u5e74\u666e\u53ca GFW \u5de5\u5177\u76f8\u5173\u77e5\u8bc6\uff0c\u7ec4\u7ec7\u5b9e\u5730\u6838\u67e5\u5de1\u903b\u7b49\u3002</span><span class=\"NormalTextRun SCXW196261371 BCX0\">&nbsp;</span></span><span class=\"TextRun SCXW32972670 BCX0\" lang=\"EN-US\" xml:lang=\"EN-US\" data-contrast=\"none\"><span class=\"NormalTextRun SCXW32972670 BCX0\">VSG \u65e8\u5728\u5e2e\u52a9\u793e\u533a\u8fd0\u7528\u6536\u96c6\u5230\u7684\u4fe1\u606f\uff0c\u5bf9\u571f\u5730\u5229\u7528\u653f\u7b56\u65bd\u52a0\u5f71\u54cd\uff0c\u5e94\u5bf9\u68ee\u6797\u5a01\u80c1\uff0c</span><span class=\"NormalTextRun AdvancedProofingIssueV2Themed SCXW32972670 BCX0\">\u540c\u65f6</span><span class=\"NormalTextRun SCXW32972670 BCX0\">\u5e0c\u671b\u63a8\u52a8\u653f\u5e9c\u4efb\u4f55\u8fd9\u5957 </span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW32972670 BCX0\">Sam</span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW32972670 BCX0\">a</span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW32972670 BCX0\">aka</span><span class=\"NormalTextRun SCXW32972670 BCX0\"> \u76d1\u6d4b\u4f53\u7cfb\uff0c\u4ece\u800c\u52a0\u5f3a\u9886\u5730\u5185\u7684</span><span class=\"NormalTextRun SCXW32972670 BCX0\">\u6267\u6cd5</span><span class=\"NormalTextRun SCXW32972670 BCX0\">\u6548\u529b\u3002&nbsp;</span></span><span class=\"EOP SCXW32972670 BCX0\" data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335557856&quot;:16777215,&quot;335559739&quot;:0,&quot;335559740&quot;:279}\">&nbsp;</span>", "a2a5e357df3b59952ea7381b17d4740b": "\u5384\u74dc\u591a\u5c14 Choc\u00f3 \u5730\u533a\u7684\u68ee\u6797\u6ee5\u4f10\u73b0\u8c61\u4e00\u76f4\u5b58\u5728\uff0c\u5373\u4f7f\u662f\u5728\u8054\u90a6\u4fdd\u62a4\u533a\u5185\u4e5f\u662f\u5982\u6b64\uff08\u5982 Mache-", "3666132067fde4fbade930a5df29489a": "\u68ee\u6797\u76d1\u6d4b\u548c\u6267\u6cd5\uff0c\u793e\u533a\u53c2\u4e0e", "2418128783d8973e2d9b07de03fc1bda": "2023 \u5e74\u5ea6 SGF \u83b7\u5f97\u8005 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Ajemalebu Self Help (AJESH)</a> \u5c06\u52a0\u5165 2024 \u5e74\u9879\u76ee\u7fa4\uff0c\u5176\u9879\u76ee\u91cd\u70b9\u4e3a Yabassi \u548c Nlonako \u5173\u952e\u751f\u7269\u591a\u6837\u6027\u4fdd\u62a4\u533a (Key Biodiversity Areas, KBAs)\uff0c\u8fd9\u4e9b\u533a\u57df\u65e2\u662f\u91cd\u8981\u7684\u78b3\u6c47\u57fa\u5730\uff0c\u4e5f\u662f\u6fd2\u5371\u7075\u957f\u7c7b\u53ca\u9e1f\u7c7b\u7684\u6816\u606f\u5730\u3002AJESH \u5c06\u91c7\u53d6\u591a\u7ba1\u9f50\u4e0b\u7684\u65b9\u6cd5\uff0c\u52a9\u529b\u653f\u5e9c\u4fdd\u62a4\u8fd9\u4e24\u4e2a\u533a\u57df\u3002\u4ed6\u4eec\u5c06\u5bf9\u6797\u4e1a\u90e8\u5b98\u5458\u5c55\u5f00\u57f9\u8bad\uff0c\u5e76\u4e0e\u4e4b\u5408\u4f5c\uff0c\u91c7\u7528\u4e00\u5957\u8fd0\u7528\u4e86 GFW \u5de5\u5177\u548c\u6570\u636e\u4ee5\u53ca\u65e0\u4eba\u673a\u7684\u68ee\u6797\u6ee5\u4f10\u7a7a\u95f4\u76d1\u6d4b\u7cfb\u7edf\u3002\u540c\u65f6\uff0c\u7ee7\u7eed\u52a0\u5f3a\u5229\u76ca\u76f8\u5173\u65b9\u53c2\u4e0e\u5ea6\uff0c\u5e76\u7ee7\u7eed\u53bb\u5e74\u5408\u4f5c\u5468\u671f\u542f\u52a8\u7684\u57f9\u8bad\uff0c\u8bad\u7ec3\u793e\u533a\u6210\u5458\u4f7f\u7528 GFW \u53ca\u65e0\u4eba\u673a\u3002\u968f\u540e\uff0cAJESH \u5c06\u5bf9\u4e3a\u671f\u4e5d\u4e2a\u6708\u7684\u6574\u4e2a\u9879\u76ee\u5468\u671f\u7684\u76d1\u6d4b\u6570\u636e\u8fdb\u884c\u8bc4\u4f30\uff0c\u4ee5\u4e86\u89e3\u5580\u9ea6\u9686\u5728\u5b9e\u8df5\u5176\u56fd\u9645\u73af\u5883\u627f\u8bfa\u65b9\u9762\u53d6\u5f97\u7684\u8fdb\u5c55\u3002", "2156d285c419f3047237db51d35769f9": "\u793e\u533a\u53c2\u4e0e\uff0c\u68ee\u6797\u76d1\u6d4b\u548c\u6267\u6cd5", "473f488fb7efd03ee150f4d39eb91df7": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Blue Ventures</a> \u81f4\u529b\u4e8e\u6539\u8fdb\u9a6c\u8fbe\u52a0\u65af\u52a0\u6d77\u5cb8\u7ea2\u6811\u6797\u7684\u793e\u533a\u7ba1\u7406\uff0c\u5176\u65b9\u6cd5\u662f\u5bf9\u68ee\u6797\u6ee5\u4f10\u7684\u901f\u5ea6\u548c\u8303\u56f4\u5efa\u6a21\uff0c\u5e76\u5e2e\u52a9\u793e\u533a\u5efa\u8bbe\u53d7\u6cd5\u5f8b\u8ba4\u53ef\u7684\u5bf9\u7ea2\u6811\u6797\u7684\u76f8\u5173\u6743\u5229\u3002Blue Ventures \u6536\u96c6\u548c\u9a8c\u8bc1\u7684\u6570\u636e\u663e\u793a\u4e86\u54ea\u4e9b\u793e\u533a\u6709\u6743\u7ba1\u7406\u5176\u7ea2\u6811\u6797\u3002\u8fd9\u4e9b\u6570\u636e\u88ab\u5448\u4ea4\u7ed9\u653f\u5e9c\u5b98\u5458\uff0c\u5e2e\u52a9\u4ed6\u4eec\u4e86\u89e3\u8be5\u5730\u533a\u7ea2\u6811\u6797\u6ee5\u4f10\u7684\u6025\u901f\u6076\u5316\u6001\u52bf\u3002\u8fd9\u4e3a\u793e\u533a\u4e3b\u5bfc\u7684\u7ea2\u6811\u6797\u7ba1\u7406\u63d0\u4f9b\u4e86\u653f\u6cbb\u652f\u6301\uff0c\u4e5f\u7ed9\u8d1f\u8d23\u76d1\u6d4b\u548c\u6267\u884c\u7ba1\u7406\u8ba1\u5212\u7684\u793e\u533a\u59d4\u5458\u4f1a\u63d0\u4f9b\u4e86\u63f4\u52a9\u3002\uff08\u5730\u56fe\u6765\u81ea Blue Ventures\uff0c\u663e\u793a\u4e86\u793e\u533a\u7ba1\u7406\u7ea2\u6811\u6797\u7684\u6743\u5229\uff1b\u7167\u7247\u6765\u81ea Blue Ventures\u3002\uff09", "871de4be6eae2c398d6a7cde21977902": "\u4ed6\u4eec\u5f97\u51fa\u7ed3\u8bba\uff0c\u968f\u7740\u65f6\u95f4\u63a8\u79fb\uff0c\u6728\u70ad\u751f\u4ea7\u5bf9\u68ee\u6797\u7684\u5f71\u54cd\u4e5f\u4f1a\u5f71\u54cd\u66f4\u5b8f\u89c2\u7684\u666f\u89c2\u53d8\u8fc1\uff0c\u4e14\u8fd9\u79cd\u5f71\u54cd\u4e0d\u80fd\u4e0e\u519c\u4e1a\u6216\u5176\u4ed6\u5bfc\u81f4\u68ee\u6797\u9000\u5316\u6216\u6bc1\u6797\u7684\u9a71\u52a8\u56e0\u7d20\u9694\u7edd\u800c\u5355\u72ec\u8bc4\u4f30\u3002\u4ed6\u4eec\u8fd8\u53d1\u73b0\uff0c\u6728\u70ad\u751f\u4ea7\u5546\u662f\u7531\u56fd\u9645\u548c\u56fd\u5bb6\u4e3b\u4f53\u6784\u6210\u7684\u590d\u6742\u4f53\u7cfb\u7684\u4e00\u4efd\u5b50\uff0c\u8fd9\u4e2a\u590d\u6742\u4f53\u7cfb\u5171\u540c\u9a71\u52a8\u4e86\u571f\u5730\u5229\u7528\u51b3\u7b56\u3002GERES \u8fd0\u7528\u5176\u8c03\u67e5\u7ed3\u679c\u7f16\u5199\u4e86\u4e00\u4efd\u4e0e\u67ec\u57d4\u5be8\u5f53\u524d\u653f\u7b56\u8ba8\u8bba\u76f8\u5173\u7684\u62a5\u544a\u3002\uff08\u7167\u7247\u7531 GERES \u63d0\u4f9b\u3002\uff09", "2b563166026304e82276589e63a2a9cb": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Group for Environment, Renewable Energy, and Solidarity</a> (GERES) \u4e0e\u5f53\u5730\u4e00\u5bb6\u540d\u4e3a Mlup Baitong \u7684 NGO \u5408\u4f5c\uff0c\u4f30\u7b97\u6728\u70ad\u751f\u4ea7\u5546\u5bf9\u8c46\u853b\u5c71\u8109\u5317\u4fa7 (Northern Cardamom Mountains) \u68ee\u6797\u6ee5\u4f10\u4e8b\u4ef6\u7684\u76f8\u5173\u5f71\u54cd\u3002GERES \u91c7\u7528\u4e86\u53c2\u4e0e\u5f0f\u65b9\u6cd5\uff0c\u5c06 GFW \u6570\u636e\u4e0e\u8c03\u67e5\u95ee\u5377\u548c\u793e\u533a\u7814\u8ba8\u4f1a\u76f8\u7ed3\u5408\u3002", "19dcc5d1822ddd03b23ced1f40e35691": "\u8fd9\u4fc3\u4f7f\u5f53\u5730\u4f7f\u7528\u65b0\u6280\u672f\u7ba1\u7406\u68ee\u6797\u7684\u610f\u613f\u589e\u957f\uff0c\u540c\u65f6\u4e5f\u63a8\u52a8\u4e86\u89c2\u5ff5\u8f6c\u53d8\u2014\u2014\u793e\u533a\u6108\u53d1\u8ba4\u8bc6\u5230\u6709\u4fdd\u969c\u7684\u571f\u5730\u6743\u5c5e\u53ef\u80fd\u591f\u4fc3\u8fdb\u53ef\u6301\u7eed\u68ee\u6797\u7ba1\u7406\uff0c\u7ebe\u56f0\u8131\u8d2b\uff0c\u5e76\u63d0\u9ad8\u793e\u533a\u798f\u7949\u3002MLA \u76f8\u4fe1\uff0c\u4ed6\u4eec\u80fd\u8fd0\u7528\u8fd9\u4e9b\u5730\u56fe\u548c\u6280\u672f\u5f71\u54cd\u653f\u5e9c\u7acb\u573a\u548c\u653f\u7b56\uff0c\u652f\u6301\u4fdd\u969c\u571f\u5730\u6743\u5c5e\u548c\u53ef\u6301\u7eed\u68ee\u6797\u7ba1\u7406\u3002\uff08\u5730\u56fe\u6765\u81ea MLA\uff0c\u663e\u793a\u4e86\u793e\u533a\u571f\u5730\u8fb9\u754c\uff1b\u7167\u7247\u6765\u81ea MLA\u3002\uff09", "87494397f31ff98d78363c982268fb9b": "2016 \u5e74\uff0cRAN\u3001TuK \u548c Profundo \u63a8\u51fa\u4e86 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">ForestsAndFinance.org</a> \u7f51\u7ad9\uff0c\u8054\u901a\u4e86\u91d1\u878d\u673a\u6784\u4e0e\u4e1c\u5357\u4e9a\u5730\u533a\u6d89\u53ca\u68ee\u6797\u98ce\u9669\u884c\u4e1a\uff08\u68d5\u6988\u6cb9\u3001\u7eb8\u6d46\u548c\u9020\u7eb8\u3001\u6a61\u80f6\u548c\u6728\u6750\uff09\u7684\u516c\u53f8\u3002\u5728\u9879\u76ee\u4e2d\uff0cTuK \u5c06\u81ea\u5df1\u7684\u6570\u636e\u5e93\u4e0e GFW \u5e73\u53f0\u94fe\u63a5\u8d77\u6765\uff0c\u4ee5\u786e\u5b9a\u54ea\u4e9b\u91d1\u878d\u673a\u6784\u6b63\u5728\u4e3a\u6301\u6709\u68ee\u6797\u706b\u707e\u53d1\u751f\u5730\u7279\u8bb8\u7ecf\u8425\u6743\u7684\u516c\u53f8\u63d0\u4f9b\u8d44\u91d1\u3002\u9879\u76ee\u6210\u679c <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">FiresAndFinance.org</a> \u6210\u4e3a\u4e86 TuK \u8981\u6c42\u94f6\u884c\u91c7\u53d6\u201c\u65e0\u706b\u707e\u201d\u653f\u7b56\u7684\u4e00\u9879\u6709\u529b\u5de5\u5177\u3002\u7531\u4e8e TuK \u7684\u9879\u76ee\u52aa\u529b\uff0c\u5df2\u6709\u4e24\u5bb6\u94f6\u884c\u627f\u8bfa\u5c06\u201c\u65e0\u706b\u707e\u201d\u89c4\u5b9a\u7eb3\u5165\u5176\u884c\u52a8\u8ba1\u5212\u3002\uff08\u5730\u56fe\u6765\u81ea TuK Indonesia\uff0c\u663e\u793a\u4e86\u6765\u81ea\u5176\u68ee\u6797\u4e0e\u91d1\u878d\u6570\u636e\u5e93\u548c\u6765\u81ea GFW \u7684\u68d5\u6988\u6cb9\u7279\u8bb8\u7ecf\u8425\u5730\u3002\uff09", "fe49a9c4d2c1d2c13ca96a6e7d1c137e": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Women Research Institute</a> (WRI) \u5229\u7528 Global Forest Watch \u5e73\u53f0\u652f\u6301\u5f00\u53d1\u57fa\u4e8e\u793e\u533a\u7684\u9884\u8b66\u7cfb\u7edf\uff0c\u4ee5\u51cf\u8f7b\u5ed6\u5185\u7701\uff08\u5370\u5c3c\u6700\u5bb9\u6613\u53d1\u751f\u706b\u707e\u7684\u7701\u4efd\u4e4b\u4e00\uff09\u56e0\u571f\u5730\u548c\u68ee\u6797\u706b\u707e\u9020\u6210\u7684\u70df\u973e\u3002\u5728\u8fd9\u9879\u5de5\u4f5c\u4e2d\uff0cWRI \u57fa\u4e8e GFW VIIRS \u706b\u707e\u8b66\u62a5\u521b\u4f5c\u4e86\u4e00\u7cfb\u5217\u6f2b\u753b\u548c\u89c6\u9891\uff0c\u4ee5\u6559\u80b2\u5ed6\u5185\u7701\u7684\u5404\u793e\u533a\u4e86\u89e3\u68ee\u6797\u706b\u707e\u5e26\u6765\u7684\u5065\u5eb7\u5371\u5bb3\u3002WRI \u53d1\u73b0\uff0c\u8bb8\u591a\u793e\u533a\u5c45\u6c11\u6ca1\u6709\u610f\u8bc6\u5230\u6216\u538b\u6839\u4e0d\u4e86\u89e3\u70df\u973e\u548c\u706b\u707e\u6240\u5e26\u6765\u7684\u8d1f\u9762\u5f71\u54cd\u3002\u7ecf\u8fc7\u52aa\u529b\uff0cWRI \u6210\u529f\u63d0\u9ad8\u4e86\u793e\u533a\u8ba4\u8bc6\uff0c\u540c\u65f6\u4e5f\u9f13\u52b1\u4eba\u4eec\u53c2\u4e0e\u89c4\u5212\u4e2d\u7684\u9884\u8b66\u7cfb\u7edf\u3002\u6b64\u5916\uff0cWRI \u8fd8\u5f3a\u8c03\u4e86\u5973\u6027\u548c\u5176\u4ed6\u5f31\u52bf\u7fa4\u4f53\u53c2\u4e0e\u9884\u8b66\u7cfb\u7edf\u89c4\u5212\u548c\u90e8\u7f72\u7684\u91cd\u8981\u6027\u3002\u8fd9\u4f7f\u5f97\u5ed6\u5185\u7701\u91c7\u53d6\u4e86\u4e00\u79cd\u66f4\u5177\u5305\u5bb9\u6027\u548c\u53c2\u4e0e\u6027\u7684\u65b9\u6cd5\u6765\u63d0\u9ad8\u6297\u973e\u548c\u9632\u706b\u80fd\u529b\u3002\uff08\u56fe\u7247\u7531 Women Research Institute \u63d0\u4f9b\u3002", "38bfead127678813b409ba4901005612": "\u751f\u6001\u4fdd\u62a4\u533a\u662f\u5168\u56fd\u68ee\u6797\u6ee5\u4f10\u7387\u6700\u9ad8\u7684\u4fdd\u62a4\u533a\uff0c\u90e8\u5206\u539f\u56e0\u662f\u4fdd\u62a4\u533a\u5185\u7684", "d8b9ac8cad69e831121c8428fb2ff655": "Chindul", "7bd14a231864e618e1840c7e117e59c1": "\u80fd\u529b\u6709\u9650\uff0c\u96be\u4ee5", "62ec6ed46f894d7c987e3e1285daa236": "\u5982\u679c\u60f3\u8981\u76d1\u6d4b\u68ee\u6797\u53d8\u5316\u3001\u751f\u7269\u591a\u6837\u6027\u548c\u571f\u5730\u5229\u7528\uff0c\u53ef\u4ee5\u8bbf\u95ee\u5173\u952e\u6570\u636e\u96c6\u4ee5\u5206\u6790\u5168\u7403\u68ee\u6797\u8d8b\u52bf\uff0c\u5e76\u91c7\u53d6\u660e\u667a\u7684\u884c\u52a8\u3002", "f150012bdc383823ec8257cceaad8714": "\u4e86\u89e3\u4e0e\u68ee\u6797\u3001\u68ee\u6797\u7834\u574f\u548c GFW \u6570\u636e\u76f8\u5173\u7684\u5173\u952e\u672f\u8bed\u548c\u5b9a\u4e49\u3002", "91c5e3abf6adb6368a5a75a01a77b4cb": "Global Forest Watch (GFW) \u63d0\u4f9b\u6700\u65b0\u7684\u6570\u636e\u3001\u6280\u672f\u548c\u5de5\u5177\uff0c\u5e2e\u52a9\u4e16\u754c\u5404\u5730\u7684\u4eba\u4eec\u66f4\u597d\u5730\u7ba1\u7406\u548c\u4fdd\u62a4\u68ee\u6797\u666f\u89c2\u3002\u6211\u4eec\u63d0\u4f9b\u4e00\u7cfb\u5217\u72ec\u7279\u7684\u68ee\u6797\u53d8\u5316\u6570\u636e\u96c6\uff0c\u6db5\u76d6\u8fd1\u4e4e\u5b9e\u65f6\u7684\u68ee\u6797\u7834\u574f\u548c\u706b\u707e\u8b66\u62a5\u548c\u4e00\u5b9a\u65f6\u95f4\u5185\u6811\u6728\u8986\u76d6\u7387\u7684\u53d8\u5316\u3002\u8fd9\u4e9b\u6570\u636e\u96c6\u6709\u4e0d\u540c\u7684\u7279\u70b9\u548c\u4f18\u7f3a\u70b9\uff0c\u9002\u5408\u4e0d\u540c\u7684\u7528\u6237\u4efb\u52a1\u3002\u8fd1\u4e4e\u5b9e\u65f6\u7684<strong>\u68ee\u6797\u7834\u574f\u8b66\u62a5</strong>\uff08\u4f8b\u5982<a href=\"{{0}}\">\u7efc\u5408\u68ee\u6797\u7834\u574f\u8b66\u62a5</a>\uff09\u6574\u5408\u4e86\u591a\u4e2a\u536b\u661f\u6765\u6e90\u7684\u6570\u636e\uff0c\u5e2e\u52a9\u4eba\u4eec\u5bf9\u68ee\u6797\u6270\u52a8\u505a\u51fa\u5feb\u901f\u54cd\u5e94\u3002\u5168\u7403\u5404\u4e2a\u751f\u6001\u7cfb\u7edf\u6270\u52a8\u8b66\u62a5 (<strong>DIST</strong>-<strong>ALERT</strong>) \u4e0d\u4ec5\u5305\u62ec\u5168\u7403\u68ee\u6797\u8b66\u62a5\uff0c\u8fd8\u5305\u62ec\u5176\u4ed6\u751f\u6001\u7cfb\u7edf\u7684\u6270\u52a8\u8b66\u62a5\uff0c\u4f8b\u5982\u8349\u5730\u3001\u7a00\u6811\u8349\u539f\u3001\u704c\u6728\u4e1b\u3001\u6e7f\u5730\u548c\u519c\u4f5c\u7269\u3002\u5982\u9700\u4e86\u89e3<strong>\u706b\u707e\u5bfc\u81f4\u7684\u68ee\u6797\u635f\u5931</strong>\uff0c<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u706b\u707e\u9020\u6210\u7684\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u635f\u5931</a>\u6570\u636e\u4f1a\u7a81\u51fa\u663e\u793a<a href=\"{{2}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u706b\u707e\u5bfc\u81f4\u7684\u635f\u5931\u8d8b\u52bf</a>\uff0c\u800c<a href=\"{{3}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u706b\u707e\u8b66\u62a5</a> (VIIRS) \u53ef\u8fd1\u4e4e\u5b9e\u65f6\u5730\u786e\u5b9a\u5168\u7403\u706b\u707e\u4f4d\u7f6e\u3002", "31d109d162629f8d0cfc8ce8316c0567": "\u8bcd\u6c47\u8868", "19584f669e6dbb012cda3c71cef04fd3": "<strong>\u516c\u9877 (Ha)</strong>\uff1a1 \u516c\u9877\u7b49\u4e8e 10,000 \u5e73\u65b9\u7c73\u30012.47 \u82f1\u4ea9\u6216 0.01 \u5e73\u65b9\u516c\u91cc\u3002&nbsp;\u68ee\u6797\u76d1\u6d4b\u4e2d\u7684\u5e38\u7528\u5355\u4f4d\u5305\u62ec\u5343\u516c\u9877 (Kha)&nbsp;\u548c&nbsp;\u767e\u4e07\u516c\u9877 (Mha)\u3002&nbsp;", "3108d43c76b74a82e7b2786bdcfed9de": "\u6211\u4eec\u6539\u8fdb\u4e86\u60a8\u7684My GFW\u4e2a\u4eba\u8d44\u6599\u8bbe\u7f6e\uff0c\u5305\u62ec\u6dfb\u52a0\u4e86\u8ba2\u9605\u76f8\u5173\u65b0\u95fb\u548c\u6d3b\u52a8\u66f4\u65b0\u7684\u529f\u80fd\u3002<a href=\"{{0}}\">\u767b\u5f55\u60a8\u7684\u8d26\u53f7</a>\uff0c\u66f4\u65b0\u9996\u9009\u9879\uff0c\u786e\u4fdd\u60a8\u7684\u4fe1\u606f\u6b63\u786e\u3002", "221fa40e1d93d5de0ddca01309e8dd91": "\u66f4\u65b0\u60a8\u7684My GFW\u8d26\u53f7", "324e2084f7e20ae633083d3680912d6b": "2025 \u5e74 4 \u6708 1 \u65e5\u8d77\uff0cPlanet \u5f71\u50cf\u5c06\u544a\u522b GFW\u3002\u8fd9\u610f\u5473\u7740\u81ea 4 \u6708 1 \u65e5\u8d77\uff0c\u65b0\u7684 Planet \u9576\u5d4c\u56fe\u548c\u5386\u53f2\u9576\u5d4c\u56fe\u5c06\u65e0\u6cd5\u4ece GFW \u83b7\u53d6\u3002\u5982\u9700\u4e86\u89e3\u6709\u5173\u8fd9\u4e00\u53d8\u5316\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u5e76\u4e86\u89e3 GFW \u5176\u4ed6\u53ef\u7528\u7684\u536b\u661f\u5f71\u50cf\uff0c\u8bf7<a href=\"{{0}}\">\u9605\u8bfb\u6211\u4eec\u7684\u535a\u5ba2</a>\u3002", "daeec8bf07febac6863385b96eb5cf9d": "\u6709\u5173 GFW \u4e0a Planet Imagery \u7684\u91cd\u8981\u66f4\u65b0", "e65619eaef253ecf05dfd72ef17d1acc": "\u81ea 2025 \u5e74 4 \u6708 1 \u65e5\u8d77\uff0cPlanet \u56fe\u50cf\uff08\u5305\u62ec\u6240\u6709\u65b0\u7684\u548c\u65e7\u7684\u9576\u5d4c\u56fe\uff09\u5c06\u65e0\u6cd5\u5728 GFW \u4e0a\u83b7\u53d6\u3002\u5982\u9700\u8be6\u7ec6\u4e86\u89e3\u8fd9\u4e00\u53d8\u5316\uff0c\u5e76\u5927\u81f4\u4e86\u89e3 GFW \u4e0a\u5df2\u6709\u7684\u5176\u4ed6\u536b\u661f\u56fe\u50cf\uff0c\u8bf7<a href=\"{{0}}\">\u9605\u8bfb\u6211\u4eec\u7684\u535a\u5ba2</a>\u3002", "5c1449c909fe2f62f42701c7fbe59a1d": "\u4eba\u5de5\u6797\u7a7a\u95f4\u6570\u636e\u5e93 (SDPT) \u662f\u4e00\u4e2a\u5168\u7403\u4eba\u5de5\u6797\u548c\u6728\u672c\u4f5c\u7269\u8fb9\u754c\u5b9e\u65f6\u6570\u636e\u5e93\uff0c\u65e8\u5728\u5c06\u4eba\u5de5\u6797\u548c\u5929\u7136\u6797\u533a\u5206\u5f00\u3002\u6211\u4eec\u6b63\u5728\u5f00\u53d1\u4e0b\u4e00\u4e2a\u7248\u672c\uff0c\u5e76\u4e14\u6b63\u5728\u5bfb\u6c42\u5173\u4e8e\u4eba\u5de5\u6797\u6216\u6728\u672c\u4f5c\u7269\u6570\u636e\u96c6\u7684\u5efa\u8bae\uff0c\u4ee5\u4fbf\u6539\u8fdb\u6570\u636e\u5e93\u2014\u2014<a href=\"{{0}}\">\u586b\u5199\u6b64\u8868\u5355</a>\u5206\u4eab\u60a8\u7684\u610f\u89c1\u3002\u60a8\u7684\u53cd\u9988\u5c06\u6709\u52a9\u4e8e\u6539\u8fdb GFW \u4e0a\u7684\u6570\u636e\u5e93\uff0c\u5e76\u786e\u4fdd\u5b83\u5305\u542b\u80fd\u591f\u83b7\u53d6\u7684\u6700\u4f73\u6570\u636e\u3002", "66625ad44beaf4fb3b1cb1a014d73f45": "\u6211\u4eec\u6b63\u5728\u5bfb\u6c42\u5173\u4e8e SDPT \u6570\u636e\u7684\u5efa\u8bae", "afb87455e2812d45cafbdaee4f329508": "Planet \u56fe\u50cf\u5df2\u65e0\u6cd5\u5728 GFW \u4e0a\u83b7\u53d6", "260690f3e679acc9f169e84437d63c51": "\u81ea 2025 \u5e74 4 \u6708 1 \u65e5\u8d77\uff0cPlanet \u56fe\u50cf\uff08\u5305\u62ec\u6240\u6709\u65b0\u7684\u548c\u65e7\u7684\u9576\u5d4c\u56fe\uff09\u5c06\u65e0\u6cd5\u5728 GFW \u4e0a\u83b7\u53d6\u3002\u5982\u9700\u8be6\u7ec6\u4e86\u89e3\u8fd9\u4e00\u53d8\u5316\uff0c\u5e76\u5927\u81f4\u4e86\u89e3 GFW \u4e0a\u5df2\u6709\u7684\u5176\u4ed6\u536b\u661f\u56fe\u50cf\uff0c\u8bf7<a href=\"{{0}}\">\u9605\u8bfb\u6211\u4eec\u7684\u535a\u5ba2</a>\u3002\u6211\u4eec\u8fd8\u5e0c\u671b\u8fdb\u4e00\u6b65\u4e86\u89e3\u60a8\u5982\u4f55\u4f7f\u7528\u56fe\u50cf\u2014\u2014<a href=\"{{1}}\">\u8bf7\u5b8c\u6210\u7b80\u77ed\u7684\u8c03\u67e5</a>\u3002", "477c195c0d9881304161073f7e0a9a3a": "\u8be5\u9879\u76ee\u5c06\u9762\u5411\u6570\u636e\u65b0\u95fb\u8bb0\u8005\u5c31 GFW \u8fd0\u7528\u5f00\u5c55\u5168\u9762\u57f9\u8bad", "6ec70a4d4445a8459afba1c6850b8a73": "Knowledge for World Conservation (KWC) \u5c06\u52aa\u529b\u63d0\u9ad8\u52a0\u7eb3\u5965\u82ac\u7d22\u6797\u533a\u68ee\u6797\u548c\u793e\u533a\u8b66\u536b\u529b\u91cf\uff0c\u8ba9\u591a\u4e2a\u5229\u76ca\u76f8\u5173\u65b9\u5171\u540c\u53c2\u4e0e\uff0c\u51cf\u5c11\u975e\u6cd5\u6797\u4e1a\u6d3b\u52a8\uff0c\u66f4\u597d\u5730\u5e94\u5bf9\u6b63\u5728\u8fdb\u884c\u6216\u65b0\u51fa\u73b0\u7684\u6797\u4e1a\u72af\u7f6a\u3002", "291f476a4c91a3d7b6e344b43cd6cf7f": "The Friends of Siberian Forests \u53ec\u96c6\u4e86\u6765\u81ea\u897f\u4f2f\u5229\u4e9a\u514b\u62c9\u65af\u8bfa\u4e9a\u5c14\u65af\u514b\u3001\u4f0a\u5c14\u5e93\u8328\u514b\u3001\u5e03\u91cc\u4e9a\u7279\u548c\u540e\u8d1d\u52a0\u5c14\u65af\u514b\u9886\u5730\u7684\u68ee\u6797\u5021\u5bfc\u8005\uff0c\u901a\u8fc7\u6280\u672f\u57f9\u8bad\u7ec4\u5efa\u4e86\u4e00\u4e2a \u201cForest Watchers\u201d \u7f51\u7edc\u3002\u4ed6\u4eec\u5f00\u59cb\u5171\u540c\u63a2\u8ba8\u5982\u4f55\u5728\u5de5\u4f5c\u4e2d\u4f7f\u7528 GFW\uff0c\u5176\u91cd\u70b9\u662f\u76d1\u6d4b\u7eb8\u6d46\u548c\u9020\u7eb8\u5382\u3002\uff08\u7167\u7247\u6765\u81ea Friends of Siberian Forests\u3002\uff09", "3d4faecc5f64ec8ea9b0146b58098b2d": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Private Institute for Climate Change Research</a> (ICC) \u53ec\u96c6\u4e86\u653f\u5e9c\u3001\u5b66\u754c\u3001\u6c11\u95f4\u793e\u4f1a\u548c\u79c1\u8425\u90e8\u95e8\u7684\u5229\u76ca\u76f8\u5173\u65b9\uff0c\u5171\u540c\u7814\u7a76 GFW \u80fd\u5982\u4f55\u52a9\u76ca\u5371\u5730\u9a6c\u62c9\u7684\u68ee\u6797\u7ba1\u7406\uff0c\u5e76\u5c06\u91cd\u70b9\u653e\u5728\u4e86\u56fd\u5bb6\u68ee\u6797\u8986\u76d6\u6570\u636e\u4e0e GFW \u6570\u636e\u7684\u5bf9\u6bd4\u4e0a\u3002", "c9606a8a0e3e9e6daa138eddb732795b": "Forest Trends \u4e0e\u7f05\u7538\u81ea\u7136\u8d44\u6e90\u548c\u73af\u5883\u90e8 (Ministry of Natural Resources and Environmental Conservation, MONREC) \u7ba1\u7406\u4eba\u5458\u5408\u4f5c\uff0c\u4ee5\u76d1\u6d4b\u3001\u8bb0\u5f55\u5e76\u7f13\u89e3\u68ee\u6797\u8d44\u6e90\u538b\u529b\u3002", "9ffb4c0ce3e9dd93e70ec89a71a785d1": "\u793e\u533a\u53c2\u4e0e\uff0c\u6559\u80b2", "6e5fca767d98ffa56aead7b565c926ec": "\u5728 GFW \u535a\u5ba2\u4e0a\u9605\u8bfb\u66f4\u591a\u5173\u4e8e Reporter Brasil \u9879\u76ee\u7684\u4fe1\u606f", "147d898689f38beb0381cb8fa0133566": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Genesis \u660e\u53e4\u9c81\u57fa\u91d1\u4f1a</a>\u5c06\u5f00\u53d1\u4e00\u6b3e\u57fa\u4e8e GFW \u7684\u53c2\u4e0e\u5f0f\u68ee\u6797\u76d1\u6d4b\u7cfb\u7edf\uff0c\u4fdd\u62a4\u585e\u5e03\u62c9\u68ee\u6797\u666f\u89c2\u9762\u79ef 74,777 \u516c\u9877\u7684\u68ee\u6797\u3002Genesis \u5c06\u4e0e\u76f8\u5173\u73af\u5883\u90e8\u95e8\uff08\u5982\u751f\u4ea7\u6797\u7ba1\u7406\u5355\u4f4d (KPHP) \u548c\u81ea\u7136\u8d44\u6e90\u5c40 (BKSDA)\uff09\u5171\u540c\u5efa\u8bbe\u585e\u5e03\u62c9\u666f\u89c2\u6797\u533a\u9644\u8fd1\u793e\u533a\u7684\u76d1\u6d4b\u80fd\u529b\u3002\uff08\u56fe\u7247\u7531 Genesis \u660e\u53e4\u9c81\u57fa\u91d1\u4f1a\u63d0\u4f9b\uff09\u3002", "a0e91e9f2d04700883bbcc38f9e262c4": "\u65e8\u5728\u901a\u8fc7\u6574\u5408 AI \u9a71\u52a8\u7684\u6d1e\u5bdf\u5206\u6790\u4e0e GFW \u6570\u636e\uff0c\u6df1\u5165\u5efa\u8bbe\u5f53\u5730\u80fd\u529b\uff0c\u5f7b\u5e95\u9769\u65b0\u5384\u74dc\u591a\u5c14 Choc\u00f3 \u5730\u533a\u7684\u68ee\u6797\u6ee5\u4f10\u76d1\u6d4b\u5de5\u4f5c\u3002", "a42ae0b56a82529e9d6a187291a20abd": "\u5c06\u4e0e\u7f05\u7538\u81ea\u7136\u8d44\u6e90\u548c\u73af\u5883\u90e8 (Ministry of Natural Resources and Environmental Conservation, MONREC) \u7684\u68ee\u6797\u7ba1\u7406\u5458\u548c\u6c11\u65cf\u56e2\u7ed3\u653f\u5e9c\u7684\u884c\u653f\u4eba\u5458\u5408\u4f5c\uff0c\u4f7f\u7528 GFW \u5de5\u5177\u76d1\u6d4b\u3001\u8bb0\u5f55\u5e76\u7f13\u89e3\u56e0\u653f\u6cbb\u5371\u673a\u9020\u6210\u7684\u68ee\u6797\u8d44\u6e90\u538b\u529b\u3002\u81ea 2021 \u5e74\u519b\u4e8b\u653f\u53d8\u4ee5\u6765\uff0c\u7f05\u7538\u653f\u5c40\u52a8\u8361\uff0c\u5bf9\u68ee\u6797\u4fdd\u62a4\u5de5\u4f5c\u4e5f\u5e26\u6765\u4e86\u5404\u79cd\u6311\u6218\u3002&nbsp;", "7473e64fdd7a5c30e7ecffbeeec99e35": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u9ea6\u5fb7\u6797\u690d\u7269\u56ed (Medellin Botanical Garden)</a>\uff0c\u8be5\u673a\u6784\u4e24\u6b21\u83b7\u5f97\u4e86 SGF \u8865\u52a9", "cb8c6d21c672b4e10e3612dfb237a785": "2024\u5e74\u7684\u68ee\u6797\u635f\u5931\u8d8b\u52bf\u662f\u4ec0\u4e48\uff1f\u8fd9\u4e9b\u8d8b\u52bf\u8bf4\u660e\u6211\u4eec\u57282025\u5e7411\u6708\u7684\u8054\u5408\u56fd\u6c14\u5019\u53d8\u5316\u5927\u4f1a\uff08COP30\uff09\u4e0a\u9700\u8981\u505a\u4ec0\u4e48\uff1f\u672c\u5c4a\u5927\u4f1a\u5c06\u4e8e\u5df4\u897f\u8d1d\u4f26\u4e3e\u884c\uff0c\u8fd9\u5ea7\u57ce\u5e02\u6240\u5728\u7684\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u662f\u4e16\u754c\u4e0a\u6700\u91cd\u8981\u7684\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u4e4b\u4e00\u3002\u6b22\u8fce\u52a0\u5165\u6211\u4eec\u4e8e5\u670828\u65e5\u4e3e\u884c\u7684\u5e74\u5ea6\u6d3b\u52a8\uff0c\u4e86\u89e3\u6765\u81eaUniversity of Maryland\u7684GLAD\u5b9e\u9a8c\u5ba4\u7684\u6700\u65b0\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u3002<a href=\"{{0}}\">\u5728\u6b64\u5904\u6ce8\u518c</a>\u3002", "4e328f71ec976708f87424a69c6c1b12": "\u52a0\u5165\u6211\u4eec\u76842024\u5e74\u68ee\u6797\u635f\u5931\u7f51\u7edc\u7814\u8ba8\u4f1a", "3e72d01c6f0a87c398baa0240e5ecd8d": "\u6240\u6709\u690d\u88ab", "da31135fa2d000d782804bf230ccad77": "2025 \u5e74\u5ea6\u5c0f\u989d\u8d44\u52a9\u91d1\u7533\u8bf7\u5f81\u96c6\u73b0\u5df2\u7ed3\u675f\u3002&nbsp;", "a4018e891652675c8a98a79382974fc7": "\u5982\u679c\u60a8\u5e0c\u671b\u5728\u4e0b\u4e00\u8f6e\u63d0\u6848\u5f81\u96c6\u65f6\u6536\u5230\u901a\u77e5\uff0c\u8bf7<a href=\"{{0}}\">\u5728\u6b64\u8ba2\u9605</a>\uff0c\u8bf7\u52a1\u5fc5\u5c06\u201c\u5c0f\u989d\u8d44\u52a9\u91d1\u548c\u6280\u672f\u7814\u7a76\u91d1\u201d\u9009\u4e3a\u611f\u5174\u8da3\u3002", "023e3f29f38de2e62cfad986421c6156": "\u6709\u5173\u8d44\u683c\u8981\u6c42\u548c\u63d0\u6848\u6807\u51c6\u7684\u91cd\u8981\u8865\u5145\u4fe1\u606f\uff0c\u60a8\u53ef\u89c2\u770b 2025 \u5e74\u5ea6<strong><a href=\"{{0}}\">\u7533\u8bf7\u8005\u7f51\u7edc\u7814\u8ba8\u4f1a\u5f55\u50cf</a></strong>\uff0c\u6709\u82f1\u8bed\u3001\u6cd5\u8bed\u548c\u897f\u73ed\u7259\u8bed\u53ef\u4f9b\u9009\u62e9\u3002\u60a8\u4e5f\u53ef\u4ee5<a href=\"{{1}}\">\u5728\u6b64\u67e5\u770b\u4f1a\u8bae\u5e7b\u706f\u7247</a>\u3002", "fa62d6ca6f69462b9b45d86e7da1a52a": "\u60a8\u53ef\u53c2\u9605\u4ee5\u4e0b\u8d44\u6e90\uff0c\u4e3a\u4e0b\u4e00\u4e2a\u5468\u671f\u505a\u51c6\u5907\uff1a", "7776e0ebef3c64f9df549c3b4538b967": "GFW Pro \u901a\u8baf\u548c\u8d44\u6e90\u4e2d\u5e38\u89c1\u7684\u94fe\u63a5 URL", "95c986ec530c488e470317067e381fb9": "\u4ee5\u4e0b\u6307\u5357\u8be6\u7ec6\u8bf4\u660e\u4e86\u5982\u4f55\u4f7f\u7528\u6587\u672c\u7f16\u8f91\u5668\u6253\u5f00 GeoJSON \u6587\u4ef6\u5e76\u6574\u7406\u5176\u683c\u5f0f\uff0c\u4ee5\u4fbf\u4e0a\u4f20\u81f3 GFW Pro\u3002&nbsp;&nbsp;", "d9c44d1092b10213482e2f4f2c0aaa2b": "\u8bf7\u786e\u4fdd\u201c\u5df2\u6295\u5f71\u201d\u56fe\u5c42\u4e3a\u53e0\u52a0\u56fe\u5c42 &gt; \u9009\u62e9&nbsp;", "53d908f9e5dafebb9f9056e01c22c446": "\u70b9\u51fb\u201c\u8fd0\u884c\u201d&nbsp;&nbsp;", "c85a3e979dba15f31dcef1711dc4d5c2": "\u70b9\u51fb\u201c\u5173\u95ed\u201d&nbsp;", "7903d5186426984caa9647620bdf6529": "\u70b9\u51fb\u201c\u597d\u7684\u201d&nbsp;", "c5980c82c795a62a83ae84702c73edea": "\u5982\u679c\u60a8\u7684\u300a\u6b27\u76df\u96f6\u6bc1\u6797\u6cd5\u6848\u300b\u5c3d\u804c\u8c03\u67e5\u6d41\u7a0b\u9700\u8981\u5bf9\u6bd7\u90bb\u68ee\u6797\u7684\u68ee\u6797\u6ee5\u4f10\u60c5\u51b5\u4f5c\u51fa\u8bc4\u4f30\uff0c\u60a8\u53ef\u80fd\u8fd8\u9700\u8981\u5173\u6ce8\u201c2020 \u5e74\u4ee5\u540e\u7684\u98ce\u9669\u8bc4\u4f30\u201d\u3002\u8bf7\u6ce8\u610f\uff0c\u8be5\u62a5\u544a\u73b0\u5df2\u80fd\u8bc6\u522b\u51fa\u6240\u6709\u4e0e\u7f13\u51b2\u533a\u6709\u91cd\u53e0\u7684\u4fdd\u62a4\u533a\u6216\u539f\u4f4f\u6c11\u9886\u5730\uff08\u5728\u9884\u89c8\u6a21\u5f0f\u4e2d\u53ef\u89c1\uff09\u3002&nbsp;", "a3e06743e65db3e03526872a34a67486": "\u4e3a\u786e\u4fdd\u60a8\u80fd\u6536\u5230 GFW Pro \u53d1\u9001\u7684\u6240\u6709\u91cd\u8981\u901a\u8baf\uff0c\u6211\u4eec\u5efa\u8bae\u60a8\u5c06\u4ee5\u4e0b\u7535\u5b50\u90ae\u7bb1\u5730\u5740\u548c\u57df\u540d\u6dfb\u52a0\u81f3\u8d35\u7ec4\u7ec7\u7684\u767d\u540d\u5355\u4e2d\u3002\u8fd9\u6709\u52a9\u4e8e\u9632\u6b62\u7535\u5b50\u90ae\u4ef6\u88ab\u62e6\u622a\u6216\u88ab\u5f52\u7c7b\u81f3\u5783\u573e\u90ae\u4ef6\u6587\u4ef6\u5939\uff0c\u5e76\u786e\u4fdd\u4fe1\u606f\u4e2d\u7684\u94fe\u63a5\u548c\u8d44\u6e90\u80fd\u591f\u6b63\u5e38\u4f7f\u7528\u3002", "f2d031f7836e8d918918c9de317bffdc": "GFW Pro URL \u767d\u540d\u5355", "55c302f0fda0868030831e2b9ce5445e": "GFW Pro \u901a\u77e5\u548c\u66f4\u65b0\u4f7f\u7528\u7684\u7535\u5b50\u90ae\u7bb1\u57df\u540d", "af1eb883714ba0c0a2c43f0f16f5e7d5": "\u6570\u636e\u96c6", "616e471ebeab6b7890cd3966599c0de7": "<em>\u8f7b\u677e\u8fdb\u884c\u5206\u6790\uff1a</em>\u5206\u6790\u5168\u7403\u4efb\u610f\u5730\u70b9\u7684\u68ee\u6797\u53d8\u5316\u5e76\u8c03\u67e5\u5176\u8d8b\u52bf\uff1b\u751f\u6210\u6570\u636e\u53ef\u89c6\u5316\u53ca\u56fe\u8868\u3002\u53ef\u5bf9\u5730\u56fe\u4e0a\u7684\u5df2\u6709\u533a\u57df\uff08\u5982\u4fdd\u62a4\u533a\u3001\u7279\u8bb8\u7ecf\u8425\u533a\u3001\u539f\u4f4f\u6c11\u9886\u5730\u548c\u793e\u533a\u571f\u5730\uff09\u8fdb\u884c\u5206\u6790\uff0c\u4e5f\u53ef\u4ee5\u5bf9\u81ea\u5b9a\u4e49\u611f\u5174\u8da3\u533a\uff08\u5982\u524d\u6240\u8ff0\uff09\u8fdb\u884c\u5206\u6790\u3002&nbsp;", "f61f68e5961b7a44985c7ecb6499dd7a": "\u9ad8\u5206\u8fa8\u7387\u5f71\u50cf", "c01ea8f3bdcfd2a2d5da3b74879243f1": "Google \u536b\u661f\u5f71\u50cf\uff0c\u8fc7\u53bb 1-3 \u5e74\u95f4\u5168\u7403\u5404\u5730\u7684\u536b\u661f\u5f71\u50cf\u5747\u53ef\u83b7\u53d6\uff0c\u6839\u636e\u4f4d\u7f6e\u4e0d\u540c\uff0c\u5206\u8fa8\u7387\u4ece 15 \u7c73\u5230 15 \u5398\u7c73\u4e0d\u7b49\u3002&nbsp;&nbsp;<br>\u63d0\u4f9b\u6765\u81ea Sentinel-2\uff0810 \u7c73\u5206\u8fa8\u7387\uff09\u548c Landsat 8\uff0830 \u7c73\u5206\u8fa8\u7387\uff09\u7684\u6bcf\u65e5\u5168\u7403\u66f4\u65b0\u3002&nbsp;", "1a6661b41d1dd66ccf50f9f19518cb06": "\u53ef\u83b7\u5f97\u6765\u81ea Planet \u7684 5 \u7c73\u5206\u8fa8\u7387\u5168\u7403\u5f71\u50cf\uff0c\u5f71\u50cf\u6bcf\u6708\u66f4\u65b0\uff0c\u8fd8\u6709 Google \u536b\u661f\u5f71\u50cf\u53ef\u4f9b\u4f7f\u7528\u3002&nbsp;", "8417b71446050bf25269da0b4f1f90e6": "\u8f93\u51fa\u7ed3\u679c\u7684\u5546\u4e1a\u4f7f\u7528\u548c/\u6216\u5206\u53d1", "516be214503835a32b6793300e8efd70": "\u53d7\u9650\u5236\uff0c\u8bf7\u53c2\u9605<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u670d\u52a1\u6761\u6b3e</a>\u3002&nbsp;", "0e93df0cb8eed62ee35222cf5f1af5ee": "GFW Pro \u63d0\u4f9b\u6570\u636e\u7684\u5546\u4e1a\u4f7f\u7528\u8bb8\u53ef\uff0c\u5e76\u4e3a\u4f1a\u5458\u63d0\u4f9b\u62a5\u544a\u7684\u5546\u4e1a\u5171\u4eab\u548c\u5206\u53d1\u6743\u9650\u3002&nbsp;", "88010a9c4a421515d46cdb00a7fc117f": "\u521b\u5efa &amp; \u5206\u6790\u7f13\u51b2\u533a&nbsp;", "9f8a5ab498b9332f7d9be9ef8366213a": "\u9664\u519c\u4e1a\u7528\u5730\u4ee5\u5916\uff0c\u5bf9\u6240\u6709\u5730\u4ea7\u8fdb\u884c\u76d1\u6d4b\u662f\u4e00\u9879\u91cd\u8981\u4e3e\u63aa\uff0c\u56e0\u4e3a\u4e0d\u65ad\u52a0\u5267\u7684\u68ee\u6797\u9000\u5316\u6216\u780d\u4f10\u53ef\u80fd\u9884\u793a\u7740\u5408\u89c4\u6027\u98ce\u9669\u7684\u589e\u52a0\u3002&nbsp;\u519c\u4e1a\u6797\u4e1a\u3001\u6797\u7267\u590d\u5408\u7cfb\u7edf\u6216\u4e2d\u8015\u4f5c\u7269\u7b49\u571f\u5730\u5229\u7528\u884c\u4e3a\u5411\u90bb\u8fd1\u5929\u7136\u6797\u4fb5\u5360\uff0c\u53ef\u80fd\u4f1a\u5bfc\u81f4\u4e0e\u68ee\u6797\u6ee5\u4f10\u76f8\u5173\u8054\u7684\u4ea7\u54c1\u201c\u6e17\u6f0f\u201d\u8fdb\u539f\u672c\u65e0\u68ee\u6797\u6ee5\u4f10\u60c5\u51b5\u7684\u4f9b\u5e94\u94fe\u3002&nbsp;\u5728\u8bb8\u591a\u5730\u533a\uff0c\u571f\u5730\u6240\u6709\u6743\u548c\u5730\u4ea7\u8fb9\u754c\u5b9a\u4e49\u5e76\u4e0d\u6e05\u6670\uff0c\u751f\u4ea7\u8005\u53ef\u80fd\u4f1a\u53d1\u73b0\uff0c\u4ece\u6bd7\u90bb\u571f\u5730\u6240\u6709\u8005\u624b\u4e2d\u79df\u8d41\u571f\u5730\u6765\u589e\u52a0\u4ea7\u91cf\uff0c\u8fd9\u79cd\u505a\u6cd5\u66f4\u4e3a\u7ecf\u6d4e\u5b9e\u60e0\u3002\u51fa\u4e8e\u8fd9\u4e00\u539f\u56e0\uff0c\u5bf9\u4e0e\u4e00\u7ec4\u6e90\u5730\u5757\u6bd7\u90bb\u7684\u68ee\u6797\u8fdb\u884c\u6bc1\u6797\u60c5\u51b5\u76d1\u6d4b\uff0c\u53ef\u63d0\u9ad8\u98ce\u9669\u8bc6\u522b\u6c34\u5e73\uff0c\u5e76\u53ef\u4ee5\u79ef\u6781\u4e3b\u52a8\u5730\u4e0e\u571f\u5730\u5229\u7528\u8005\u8fdb\u884c\u6c9f\u901a\uff0c\u4ee5\u8bc4\u4f30\u5176\u610f\u56fe\uff0c\u63d0\u51fa\u7f13\u89e3\u63aa\u65bd\uff0c\u8fd8\u53ef\u80fd\u6709\u52a9\u4e8e\u6062\u590d\u53d7\u5f71\u54cd\u7684\u571f\u5730\u3002\u5728\u5c3d\u804c\u8c03\u67e5\u6d41\u7a0b\u53ca\u672a\u6765\u7684\u5408\u89c4\u7ba1\u7406\u8fc7\u7a0b\u4e2d\uff0c\u4ee5\u4e0a\u6240\u6709\u56e0\u7d20\u5747\u9700\u4e88\u4ee5\u5145\u5206\u8003\u8651\u3002&nbsp;&nbsp;", "ff70dd71d95e549d0becc11a71a9269b": "\u672c\u300a\u64cd\u4f5c\u6307\u5357\u300b\u63d0\u4f9b\u4e86\u5173\u4e8e\u5728\u5df2\u77e5\u519c\u4e1a\u7528\u5730\u5468\u8fb9\u521b\u5efa\u548c\u5206\u6790\u201c\u7f13\u51b2\u533a\u201d\u7684\u8be6\u7ec6\u6b65\u9aa4\u6307\u5357\uff0c\u65e8\u5728\u5b9e\u73b0\u98ce\u9669\u7684\u72ec\u7acb\u8bc6\u522b\u4ee5\u53ca\u5bf9\u68ee\u6797\u5e72\u6270\u7684\u6301\u7eed\u76d1\u6d4b\u3002\u8bf7\u6ce8\u610f\uff0c\u7f13\u51b2\u533a\u5bbd\u5ea6\u5e94\u6839\u636e\u5927\u5b97\u5546\u54c1\u7c7b\u578b\u3001\u751f\u5382\u5546\u7684\u5b9e\u9645\u8fd0\u8425\u80fd\u529b\u548c\u4e0e\u5177\u4f53\u60c5\u51b5\u9ad8\u5ea6\u76f8\u5173\u7684\u5176\u4ed6\u56e0\u7d20\u800c\u8fdb\u884c\u5fc5\u8981\u8c03\u6574\u3002\u56e0\u6b64\uff0c\u6211\u4eec\u5efa\u8bae\u60a8\u5728\u9009\u62e9\u7f13\u51b2\u533a\u65f6\uff0c\u5e94\u6839\u636e\u4f9b\u5e94\u94fe\u52a8\u6001\u5206\u6790\u7684\u5177\u4f53\u6d1e\u5bdf\u548c\u5df2\u5546\u5b9a\u7684\u5c3d\u804c\u8c03\u67e5\u6d41\u7a0b\u6765\u786e\u5b9a\u3002&nbsp;", "64e9d42024a1252e8185a9225e20efa8": "\u8bf7\u5c06\u6b64\u4fe1\u606f\u544a\u77e5\u60a8\u7684\u4fe1\u606f\u6280\u672f\u6216\u7f51\u7edc\u7ba1\u7406\u5458\uff0c\u4ee5\u514d\u5728\u63a5\u6536\u6765\u81ea GFW Pro \u7684\u91cd\u8981\u4fe1\u606f\u65f6\u51fa\u73b0\u4e2d\u65ad\u3002", "c5bb92d8e0f478b379173c8bc153fd16": "\u5982\u9700\u83b7\u53d6 GFW Pro \u4f7f\u7528\u652f\u6301\uff0c\u8bf7\u5bfc\u822a\u81f3&nbsp;<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">GFW Pro \u5e2e\u52a9\u4e2d\u5fc3</a>&nbsp;\u7684&nbsp;<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8be6\u7ec6\u6b65\u9aa4\u6307\u5357\u3002</a>&nbsp; &nbsp;", "b6e605be0004e81f41806cef4f7266e2": "\u5982\u679c\u60a8\u672a\u627e\u5230\u6240\u9700\u5185\u5bb9\uff0c\u6216\u9700\u8981\u66f4\u591a\u652f\u6301\uff0c\u8bf7\u586b\u5199&nbsp;<a rel=\"noreferrer noopener\" target=\"_blank\" href=\"{{0}}\">\u6b64\u8868\u5355\u3002</a>&nbsp;", "1826e02825de035cdfeef93d0dda9535": "\u5982\u9700\u54a8\u8be2\u4f7f\u7528\u3001\u5b9a\u4ef7\u3001\u8bb8\u53ef\u8bc1\u6216\u57fa\u4e8e API \u8bbf\u95ee\u76f8\u5173\u4e8b\u5b9c\uff0c\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3&nbsp;<a href=\"{{0}}\">gfwprosales@wri.org</a>\u3002&nbsp;", "94cf24e4a34e607cc623852d069de3e5": "GFW \u548c GFW Pro\uff1a\u6709\u4f55\u4e0d\u540c\uff1f&nbsp;", "623f8d854a35e33efab1f2479d516d24": "\u4ee5\u4e0b\u662f Global Forest Watch (GFW) \u4e0e GFW Pro \u7684\u7b80\u8981\u5bf9\u6bd4\uff0c\u53ef\u5e2e\u52a9\u60a8\u4e86\u89e3\u8fd9\u4e24\u4e2a\u5de5\u5177\u5728\u68ee\u6797\u76d1\u6d4b\u548c\u51b3\u7b56\u5236\u5b9a\u4e2d\u5404\u81ea\u7684\u4f5c\u7528\u3002", "261addf78c7b2c961032b3dd08ba0b1f": "\u7528\u9014", "429f6851c7cea2c1e3c4643a918927d7": "<em>\u4e3a\u5168\u7403\u5404\u5730\u7684\u4eba\u4eec\u8d4b\u80fd\uff0c\u4f7f\u4eba\u4eec\u80fd\u66f4\u597d\u5730\u4fdd\u62a4\u548c\u7ba1\u7406\u5168\u7403\u68ee\u6797\uff1a</em>\u8fd9\u662f\u4e00\u4e2a\u5f00\u653e\u5e73\u53f0\uff0c\u5411\u6240\u6709\u4eba\u63d0\u4f9b\u4efb\u610f\u5730\u70b9\u7684\u5b9e\u65f6\u3001\u53ef\u9760\u4fe1\u606f\uff0c\u7528\u4ee5\u76d1\u6d4b\u68ee\u6797\u5e76\u4e86\u89e3\u68ee\u6797\u8fd1\u5b9e\u65f6\u7684\u52a8\u6001\u53d8\u5316\u3002&nbsp;", "f9aae5fda8d810a29f12d1e61b4ab25f": "\u7528\u6237", "3ed214c5ded80b81c354df2d2a980ffc": "<em>\u5b9e\u73b0\u53ef\u6301\u7eed\u4f9b\u5e94\u94fe\uff1a</em>\u8fd9\u662f\u4e00\u4e2a\u5b89\u5168\u53ef\u9760\u7684\u5e73\u53f0\uff0c\u7528\u4ee5\u8bc4\u4f30\u5927\u5b97\u5546\u54c1\u4f9b\u5e94\u94fe\u7684\u68ee\u6797\u6ee5\u4f10\u98ce\u9669\u548c\u5176\u4ed6\u571f\u5730\u5229\u7528\u5f71\u54cd\uff0c\u786e\u4fdd\u62a5\u544a\u7fd4\u5b9e\u53ef\u9760\uff0c\u5e76\u7b26\u5408\u5404\u9879\u81ea\u613f\u627f\u8bfa\u548c\u6cd5\u89c4\uff0c\u5982\u300a\u6b27\u76df\u96f6\u6bc1\u6797\u6cd5\u6848\u300b(EUDR)\u3002&nbsp;&nbsp;&nbsp;", "b2ca4d5713902e8afecc096f39b8eb06": "<em>\u5bf9\u6240\u6709\u4eba\u5f00\u653e\uff0c\u65e8\u5728\u4e3a\u5404\u7c7b\u7528\u6237\u63d0\u4f9b\u652f\u6301\uff1a</em>\u653f\u5e9c\u3001\u79c1\u8425\u90e8\u95e8\u3001\u975e\u653f\u5e9c\u7ec4\u7ec7\u3001\u65b0\u95fb\u8bb0\u8005\u3001\u7814\u7a76\u4eba\u5458\u3001\u6559\u80b2\u5de5\u4f5c\u8005\u3001\u6c11\u95f4\u56e2\u4f53\u3001\u539f\u4f4f\u6c11\u53ca\u5176\u4ed6\u5f53\u5730\u793e\u533a\u3002&nbsp;", "e22ac25b066b201473de7aa700ef5d92": "\u5b9a\u4ef7", "87b8c403e9aaa67264b6b7ee6c2f3890": "<em>\u6709\u9488\u5bf9\u6027\u7684\u5de5\u5177\uff1a</em>\u5927\u5b97\u5546\u54c1\u751f\u4ea7\u5546\u3001\u8d38\u6613\u5546\u53ca\u5408\u4f5c\u793e\uff1b\u6d88\u8d39\u54c1\u5236\u9020\u5546\u3001\u8ffd\u6eaf\u670d\u52a1\u63d0\u4f9b\u5546\u53ca\u54a8\u8be2\u673a\u6784\uff1b\u4ee5\u53ca&nbsp;<s> </s>\u4f1a\u5458\u534f\u4f1a\u3001\u8ba4\u8bc1\u673a\u6784\u53ca\u91d1\u878d\u673a\u6784\u3002&nbsp;", "1b7f2ff6d266f20fa27e42b0c61a4cb0": "\u514d\u8d39\u3002&nbsp;", "fcae03bdc19a34d5a162f76aa77c9967": "<em>\u5728\u5e74\u5ea6\u4f7f\u7528\u9650\u989d\u5185\u514d\u8d39\u4f7f\u7528</em>\uff0c\u5bf9\u4e8e\u9ad8\u4f7f\u7528\u91cf\u3001API \u8bbf\u95ee\u548c\u5185\u5bb9\u5206\u53d1\u5b50\u8bb8\u53ef\uff0c\u63d0\u4f9b\u4ed8\u8d39\u53ca\u4f1a\u5458\u9009\u9879\u3002", "d2e76f1ff706e2068c74fe0f1413a8ed": "<em>\u5168\u9762\uff1a</em>\u5173\u4e8e\u68ee\u6797\u53d8\u5316\u3001\u571f\u5730\u5229\u7528\u3001\u81ea\u7136\u4fdd\u62a4\u3001\u6c14\u5019\u3001\u571f\u5730\u6743\u5c5e\u7b49\u591a\u4e2a\u65b9\u9762\u7684\u8d85\u8fc7 65 \u4e2a\u5168\u7403\u53ca\u672c\u5730\u6570\u636e\u96c6\u3002&nbsp;", "070b02d6594358e9acbc9a7cf7bea046": "<em>\u4e13\u4e3a\u8f7b\u677e\u4f7f\u7528\u8bbe\u8ba1\uff1a</em>\u5728\u5730\u56fe\u4e0a\u5206\u6790\u548c\u4fdd\u5b58\u611f\u5174\u8da3\u533a\uff0c\u5e76\u8ba2\u9605\u4ee5\u63a5\u6536\u68ee\u6797\u53d8\u5316\u901a\u77e5\u3002\u5982\u9700\u4fdd\u5b58\u81ea\u5b9a\u4e49\u533a\u57df\uff0c\u8bf7\u4f7f\u7528\u5206\u6790\u5de5\u5177\u7ed8\u5236\u5f62\u72b6\u6216\u4e0a\u4f20 shapfile \u6587\u4ef6\u3002&nbsp;&nbsp;", "f442f274b88706b27c1360aa6c3ad92e": "<em>\u4e13\u4e3a\u5927\u89c4\u6a21\u4f7f\u7528\u8bbe\u8ba1\uff1a</em>\u652f\u6301\u4e0a\u4f20\u591a\u8fbe 150,000 \u4e2a\u6e90\u4f4d\u7f6e\u70b9\u6216\u591a\u8fb9\u5f62\u7684\u5217\u8868\uff0c\u5e76\u53ef\u8de8\u5217\u8868\u7ba1\u7406\u6570\u767e\u4e07\u4e2a\u4f4d\u7f6e\u3002\u53ea\u9700\u8f93\u5165\u4f4d\u7f6e\u5750\u6807\u7cfb\u6216\u7ed8\u5236\u5f62\u72b6\uff0c\u5373\u53ef\u624b\u52a8\u521b\u5efa\u5355\u72ec\u7684\u591a\u8fb9\u5f62\u51e0\u4f55\u5174\u8da3\u70b9\u3002&nbsp;", "86859fcda51349e2a327f5d0d7d8f772": "\u5206\u6790", "5b3e837c591b887c1526dd5070945a1a": "<em>\u4e13\u4e3a\u4f01\u4e1a\u62a5\u544a\u4e0e\u5408\u89c4\u91cf\u8eab\u5b9a\u5236\uff1a</em>\u5f00\u5c55\u98ce\u9669\u8bc4\u4f30\uff0c\u4ee5\u6ee1\u8db3\u300a\u6b27\u76df\u96f6\u6bc1\u6797\u6cd5\u6848\u300b(EUDR) \u7b49\u6cd5\u89c4\u7684\u62a5\u544a\u4e0e\u5408\u89c4\uff0c\u5e76\u8bc6\u522b\u68ee\u6797\u6ee5\u4f10\u3001\u4fb5\u5360\u4fdd\u62a4\u533a\u548c\u539f\u4f4f\u6c11\u9886\u5730\u7b49\u884c\u4e3a\u7684\u98ce\u9669\u3002&nbsp;", "6db6c6580271231a5244db93f72ebead": "\u786e\u8ba4\u6240\u6709\u4f4d\u7f6e\u5747\u5df2\u6b63\u786e\u4e0a\u4f20 &gt; \u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\u201d&nbsp;", "13fba4bae961c636e2dc0a4093b52bc2": "<strong>\u4fdd\u5b58</strong>\u60a8\u5bf9 GeoJSON \u6587\u4ef6\u7684\u6240\u6709\u66f4\u6539\uff0c\u5e76\u5c06\u6587\u4ef6\u4e0a\u4f20\u81f3 GFW Pro\u3002&nbsp;", "be9ef2a69281a82f1caa35477c09a92e": "\u5728\u6587\u672c\u7f16\u8f91\u5668\u4e2d\u7f16\u8f91 GeoJSON \u6587\u4ef6\u65e0\u6cd5\u5b8c\u6574\u5b9e\u73b0\u6587\u4ef6\u7684\u53ef\u89c6\u5316\u3002\u56e0\u6b64\uff0c\u4f7f\u7528 GIS \u8f6f\u4ef6\u8bbf\u95ee\u6587\u4ef6\u53ef\u80fd\u66f4\u6709\u610f\u4e49\uff0c\u5c24\u5176\u662f\u5728\u5904\u7406\u8d85\u5927\u6587\u4ef6\u6216\u62c5\u5fc3\u6570\u636e\u8d28\u91cf\u65f6\u3002\u5728 GIS \u8f6f\u4ef6\u4e2d\u6253\u5f00 GeoJSON \u6587\u4ef6\uff0c\u60a8\u53ef\u4ee5\u76f4\u89c2\u5730\u67e5\u770b\u6570\u636e\u7684\u51e0\u4f55\u56fe\u5f62\uff0c\u4ece\u800c\u68c0\u67e5\u662f\u5426\u5b58\u5728\u65e0\u6548\u51e0\u4f55\uff0c\u8fd8\u80fd\u5bf9\u5c5e\u6027\u8981\u7d20\u5217\u7684\u540d\u79f0\u548c\u503c\u8fdb\u884c\u6279\u91cf\u6821\u6b63\u3002&nbsp;&nbsp;", "88c0d7997a2fa662f5c58eb9823ca33c": "\u4ee5\u4e0b\u662f\u5728 QGIS \u4e2d\u6253\u5f00 GeoJSON \u6587\u4ef6\u5e76\u6574\u7406\u5176\u683c\u5f0f\u7684\u8be6\u7ec6\u6b65\u9aa4\uff1a", "28fc71a7582ff0ec0d8c694316ae548b": "\u5982\u4f55\u5728 QGIS \u4e2d\u6253\u5f00\u6570\u636e\u56fe\u5c42\u3002", "817adf97334a154d71dc05d54449052d": "\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5e0c\u671b\u4e3a\u6240\u6709\u4f4d\u7f6e\u6279\u91cf\u5206\u914d\u5206\u6790\u534a\u5f84\uff0c\u90a3\u4e48\uff0c\u8bf7\u6253\u5f00<em>\u5b57\u6bb5\u8ba1\u7b97\u5668</em>\uff0c\u9009\u62e9\u201c\u66f4\u65b0\u5df2\u6709\u5b57\u6bb5\u201d\uff0c\u7136\u540e\u5728\u4e0b\u62c9\u83dc\u5355\u4e2d\u9009\u62e9\u201c\u5206\u6790\u534a\u5f84\u201d\u5b57\u6bb5\uff0c\u5728\u6587\u672c\u6846\u4e2d\u8f93\u5165\u6240\u9700\u5b57\u6bb5\u503c\uff0c\u7136\u540e\u70b9\u51fb\u201c\u597d\u7684\u201d\u3002&nbsp;", "57eb0f6cf02f0b3269709a9b650536c4": "\u5982\u679c\u60a8\u5e0c\u671b\u5c06\u67d0\u4e00\u5217\u7684\u503c\u8f6c\u79fb\u81f3\u53e6\u4e00\u5217\uff0c\u4f8b\u5982\uff0c\u5c06\u201c\u540d\u79f0\u201d\u5217\u4e2d\u7684\u503c\u8f6c\u79fb\u81f3\u201c\u4f4d\u7f6e\u540d\u79f0\u201d\u5217\uff0c\u90a3\u4e48\uff0c\u8bf7\u6253\u5f00<em>\u5b57\u6bb5\u8ba1\u7b97\u5668</em>\uff0c\u9009\u62e9\u201c\u66f4\u65b0\u5df2\u6709\u5b57\u6bb5\u201d\uff0c\u7136\u540e\u5728\u4e0b\u62c9\u83dc\u5355\u4e2d\u9009\u62e9\u60a8\u5e0c\u671b\u66f4\u65b0\u7684\u5b57\u6bb5\uff0c\u5728<em>\u5b57\u6bb5\u548c\u503c</em>\u4e0b\uff0c\u9009\u62e9\u8981\u63d0\u53d6\u6570\u636e\u7684\u5b57\u6bb5\uff0c\u7136\u540e\u70b9\u51fb\u201c\u597d\u7684\u201d\u3002&nbsp;", "7ac4e8690f47c66fdd9b4a36a1813a26": "\u5982\u4f55\u4f7f\u7528\u5b57\u6bb5\u8ba1\u7b97\u5668\u5c06\u4e00\u5217\u7684\u503c\u6279\u91cf\u5206\u914d\u5230\u53e6\u4e00\u5217\u3002", "fac42a7154560a21402103b96953a11f": "\u5728\u5c5e\u6027\u8868\u6240\u6709\u5fc5\u586b\u5217\u5747\u5df2\u586b\u5199\uff0c\u4e14\u60a8\u6240\u9700\u7684\u5176\u4ed6\u5217\u4e5f\u5df2\u6dfb\u52a0\u540e\uff0c\u53f3\u952e\u5355\u51fb\u5408\u5e76\u56fe\u5c42\uff0c\u9009\u62e9\u201c\u5bfc\u51fa &gt; \u5c06\u8981\u7d20\u4fdd\u5b58\u4e3a\u201d\uff0c\u5c06\u5408\u5e76\u56fe\u5c42\u5bfc\u51fa\u4e3a\u65b0\u6570\u636e\u56fe\u5c42\u3002\u4e3a\u6587\u4ef6\u547d\u540d\uff0c\u52a1\u5fc5\u5bfc\u51fa\u4e3a GeoJSON \u6587\u4ef6\u3002\u73b0\u5728\uff0c\u60a8\u7684\u6587\u4ef6\u5df2\u51c6\u5907\u5c31\u7eea\uff0c\u53ef\u4e0a\u4f20\u81f3 GFW Pro \u5e73\u53f0\u4e86\u3002&nbsp;&nbsp;", "2a928d8f7d070d33c03999dd8b2a261e": "\u5982\u9700\u83b7\u53d6 GFW Pro \u4f7f\u7528\u652f\u6301\uff0c\u8bf7\u5bfc\u822a\u81f3 <a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">GFW Pro \u5e2e\u52a9\u4e2d\u5fc3</a>\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8be6\u7ec6\u6b65\u9aa4\u6307\u5357\u3002</a>&nbsp; &nbsp;&nbsp;", "c1feb722532c5fd2aa81c4beeeae28af": "\u8be5\u5217\u8868\u5305\u62ec\uff1a", "a9d125d024439525066a73db5646ed09": "\u9009\u4e2d\u65b0\u591a\u8fb9\u5f62\u5217\u8868\u540e\uff0c\u5bfc\u822a\u81f3\u201c\u5904\u7406\u5de5\u5177\u7bb1\u201d\uff08\u5982\u9700\u627e\u5230\u6b64\u5de5\u5177\u7bb1\uff0c\u8bf7\u5728\u5de5\u5177\u680f\u4e2d\u9009\u62e9\u8bbe\u7f6e\u9f7f\u8f6e\uff09 &gt; \u641c\u7d22\u201c\u91cd\u6295\u5f71\u56fe\u5c42\u201d &gt; \u53cc\u51fb&nbsp;", "e9c85897e14467cd14832eea5db10877": "\u5728 CRS\uff08\u5750\u6807\u53c2\u8003\u7cfb\uff09\u4e0b\uff0c\u9009\u62e9\u4e0e \u201cWeb Mercator Auxiliary Sphere\u201d\u5750\u6807\u7cfb\u517c\u5bb9\u7684\u683c\u5f0f\uff08\u5982 EPSG:3857 \u2013 WGS 84 / \u4f2a\u58a8\u5361\u6258\u6295\u5f71\uff09&nbsp;", "308a1029e931283764408e36f1b576b6": "\u8bf7\u6ce8\u610f\uff0c\u8bf7\u9009\u62e9\u6b63\u786e\u7684\u5750\u6807\u53c2\u8003\u7cfb\uff0c\u4ee5\u4fbf\u540e\u7eed\u80fd\u6b63\u786e\u5206\u914d\u6307\u6807\u3002&nbsp;", "78d53751efd0c9a23d871a526d9429fb": "\u60a8\u5c06\u5728\u56fe\u5c42\u9762\u677f\u770b\u5230\u65b0\u7684\u6295\u5f71\u56fe\u5c42\u3002&nbsp;", "39f5505055b615d59bc99c139fc51939": "\u5c06\u7f13\u51b2\u533a\u8303\u56f4\u8c03\u6574\u5230\u60a8\u671f\u671b\u7684\u503c\uff08\u8bf7\u6ce8\u610f\uff0c\u5982\u679c\u201c\u7c73\u201d\u4e0d\u662f\u9ed8\u8ba4\u5355\u4f4d\u6216\u53ef\u9009\u5355\u4f4d\uff0c\u5219\u60a8\u7684\u5750\u6807\u53c2\u8003\u7cfb\u53ef\u80fd\u4e0d\u652f\u6301\u7c73\u5236\uff0c\u8bf7\u8fd4\u56de\u7b2c 6 \u6b65 &amp; \u7b2c 7 \u6b65\uff09 &gt; \u70b9\u51fb\u201c\u8fd0\u884c\u201d&nbsp;", "b849dc70bacbd6e3b3c8811864229176": "\u9009\u62e9\u65b0\u7684\u91cd\u6295\u5f71\u56fe\u5c42 &gt; \u5728\u201c\u5904\u7406\u5de5\u5177\u7bb1\u201d\u4e2d\u641c\u7d22\u201c\u7f13\u51b2\u533a\u201d &gt; \u53cc\u51fb &nbsp;", "8da34d0206fb7ab821eb10ed27708813": "\u9009\u62e9\u65b0\u7684\u201c\u5df2\u7f13\u51b2\u201d\u56fe\u5c42\uff0c\u5728\u5de5\u5177\u7bb1\u9762\u677f\u4e2d\u641c\u7d22\u201c\u5dee\u96c6\u201d &gt; \u53cc\u51fb&nbsp;", "772c837adb0c064972ba023df006c40a": "\u8bf7\u786e\u4fdd\u65b0\u7684\u201c\u5df2\u7f13\u51b2\u201d\u56fe\u5c42\u4e3a\u8f93\u5165\u56fe\u5c42&nbsp;", "7926fd0b29cc603d0982a1409319e0b1": "\u5173\u95ed\u8868\u683c&nbsp;", "e794cff4f0a8fefc71f6207117d4277a": "\u6307\u5b9a\u7528\u4ee5\u4fdd\u5b58\u5df2\u7f13\u51b2\u591a\u8fb9\u5f62\u7684\u6587\u4ef6\u540d &gt; \u70b9\u51fb\u201c\u4fdd\u5b58\u201d&nbsp;", "b1b65306b2b34f01a466c7df5e1a514c": "\u73b0\u5728\uff0c\u60a8\u4f1a\u5728\u56fe\u5c42\u9762\u677f\u4e2d\u770b\u5230\u6700\u7ec8\u7684\u7f13\u51b2\u533a\u56fe\u5c42 &gt; \u4fdd\u5b58\u5e76\u9000\u51fa\u9879\u76ee\u548c/\u6216 QGIS &gt; \u7136\u540e\u5bfc\u822a\u81f3\u60a8\u4fdd\u5b58\u65b0\u56fe\u5c42\u7684\u6587\u4ef6\u5939&nbsp;", "52f44221756246f068d330d1a9cb8c09": "\u9009\u62e9\u6240\u6709\u5df2\u4e0b\u8f7d\u6587\u4ef6\uff08\u5171 6 \u4e2a\uff09 &gt; \u53f3\u952e\u5355\u51fb &gt; \u538b\u7f29\u4e3a\u2026\u2026 &gt; ZIP \u6587\u4ef6 &nbsp;", "e47d3b5ffd88d90b59ca65100bc3252c": "\u8fd4\u56de GFW Pro \u4f4d\u7f6e\u9875\u9762 &gt; \u9009\u62e9\u201c\u2018+ \u6dfb\u52a0\u4f4d\u7f6e\u201d &gt; \u6309\u7167\u6d41\u7a0b\u64cd\u4f5c\uff0c\u8bf7\u52a1\u5fc5\u9009\u62e9\u4e0e\u539f\u59cb\u6e90\u4f4d\u7f6e\u591a\u8fb9\u5f62\u76f8\u540c\u7684\u6a21\u677f\u7c7b\u578b\uff08\u4e3a\u786e\u4fdd API \u517c\u5bb9\u6027\uff0c\u672c\u793a\u4f8b\u7684\u6e90\u591a\u8fb9\u5f62\u548c\u7f13\u51b2\u533a\u591a\u8fb9\u5f62\u5747\u4f7f\u7528\u4e86\u201cCocoa Generic\u201d\uff08\u53ef\u53ef\u901a\u7528\uff09\u6a21\u677f\u3002&nbsp;", "5af259f634a230d7df868a2bdbb77e50": "\u5728 QGIS \u4e2d\u6253\u5f00\u60a8\u7684 GeoJSON \u6587\u4ef6\uff0c\u65b9\u6cd5\u4e4b\u4e00\u662f\u5bfc\u822a\u81f3\u56fe\u5c42<add vector=\"\" layer=\"\" and=\"\" selecting=\"\" your=\"\" file=\"\" in=\"\" the=\"\" pop-up=\"\" module=\"\" clicking=\"\" or=\"\" simply=\"\" dragging=\"\" dropping=\"\" into=\"\" qgis=\"\" from=\"\" explorer.=\"\" addition=\"\" to=\"\" data=\"\" open=\"\" gfw=\"\" pro=\"\" geojson=\"\" example=\"\" template=\"\" as=\"\" li=\"\"></add>", "8d1c717b6a9df10f0021e9f5400b0bd1": "\u60a8\u4f1a\u53d1\u73b0\uff0c\u73b0\u5728\uff0c\u60a8\u6709\u4e86\u4e00\u4e2a\u65b0\u7684\u201c\u5dee\u96c6\u201d\u56fe\u5c42&nbsp;", "1e156d237b54b943d9603ab00d2baa21": "\u9009\u62e9\u65b0\u7684\u201c\u5dee\u96c6\u201d\u56fe\u5c42 &gt; \u5728\u5de5\u5177\u7bb1\u4e2d\u641c\u7d22\u201c\u91cd\u6295\u5f71\u56fe\u5c42\u201d &gt; \u53cc\u51fb&nbsp;", "4c87df191f546a314dc36c51db677232": "\u786e\u4fdd\u60a8\u7684\u76ee\u6807\u5750\u6807\u53c2\u8003\u7cfb\u662f \u201cEPSG:4326 \u2013 WGS 84\u201d\uff08\u89c1\u4e0b\u56fe\uff09 &gt; \u70b9\u51fb\u201c\u8fd0\u884c\u201d&nbsp;", "6924055e59dc1c4c3039353219d3c48b": "\u8bf7\u786e\u4fdd\u65b0\u7684\u201c\u5dee\u96c6\u201d\u56fe\u5c42\u4e3a\u8f93\u5165\u56fe\u5c42&nbsp;&nbsp;", "c43faeca78851fd3b2dcd5df62797221": "\u60a8\u4f1a\u53d1\u73b0\uff0c\u73b0\u5728\uff0c\u60a8\u6709\u4e86\u4e00\u4e2a\u65b0\u7684\u201c\u91cd\u6295\u5f71\u201d\u56fe\u5c42 &gt; \u70b9\u51fb\u201c\u5173\u95ed\u201d&nbsp;", "54a611add1b9673bcd9a00f6747b7196": "\u53f3\u952e\u5355\u51fb\u65b0\u7684\u201c\u91cd\u6295\u5f71\u201d\u56fe\u5c42 &gt; \u9009\u62e9\u201c\u6253\u5f00\u5c5e\u6027\u8868\u201d&nbsp;", "31dcf9941668a7f11728b21a9f5fbf17": "\u8bf7\u52a1\u5fc5\u5728\u5c5e\u6027\u9762\u677f\u7684\u53f3\u4e0a\u65b9\u9009\u62e9\u201c\u5207\u6362\u7f16\u8f91\u5de5\u5177\u201d&nbsp;&nbsp;", "1c6eaa5c85f7bf39ca1b943dc79e641e": "\u5728 Location_N \u5217\u4e2d\uff0c\u6dfb\u52a0\u201c\u7f13\u51b2\u533a\u201d\u6807\u8bc6\uff0c\u4ee5\u4fbf\u540e\u7eed\u533a\u5206\u7f13\u51b2\u533a\u4e0e\u5730\u5757\u5750\u6807&nbsp;", "c6fa7cc625fe28032cea86ec5d2ba93a": "\u8bf7\u52a1\u5fc5\u5c06\u7f16\u8f91\u5185\u5bb9\u4fdd\u5b58\u81f3\u60a8\u7684\u5217\u8868&nbsp;", "71d760cc6ed79e376fde7d6c52b75247": "\u53f3\u952e\u5355\u51fb\u65b0\u7684\u201c\u91cd\u6295\u5f71\u201d\u56fe\u5c42\uff0c\u5e76\u9009\u62e9\u201c\u5bfc\u51fa\u201d &gt; \u201c\u5c06\u8981\u7d20\u4fdd\u5b58\u4e3a\u2026\u2026\u201d&nbsp;", "fbadea091b180998768ccb3c252d03ad": "\u7136\u540e\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u201c\u4fdd\u5b58\u4e3a\u8349\u7a3f\u201d\u6216\u201c\u63d0\u4ea4\u8fdb\u884c\u5206\u6790\u201d &gt; \u70b9\u51fb\u201c\u597d\u7684\u201d&nbsp;&nbsp;", "d3770e08b6bf649bb2ff979cdfe12c4e": "\u5bfc\u822a\u81f3\u4f4d\u7f6e\u5730\u56fe&nbsp;", "9c1bbf574a4c7b849851808470451ae8": "\u5728\u8fd9\u91cc\uff0c\u60a8\u53ef\u4ee5\u5728\u5730\u56fe\u4e0a\u53ef\u89c6\u5316\u67e5\u770b\u7f13\u51b2\u533a\uff0c\u5e76\u53c2\u7167\u5df2\u751f\u6210\u7684\u5730\u5757\u62a5\u544a\uff0c\u6838\u67e5\u9700\u8981\u5728\u5c3d\u804c\u8c03\u67e5\u6d41\u7a0b\u4e2d\u8bc4\u4f30\u7684\u68ee\u6797\u6ee5\u4f10\u6216\u98ce\u9669\u91cd\u53e0\u533a\u57df\u3002&nbsp;", "4315556d65a3c80e1f1ceaf676f137f2": "\u51c6\u5907 GeoJSON \u6587\u4ef6\u4ee5\u4f9b\u4e0a\u4f20&nbsp;&nbsp;", "b439a7d1fe269919b41322558947b66c": "\u4f7f\u7528\u6587\u672c\u7f16\u8f91\u5668\u6253\u5f00\u5e76\u7f16\u8f91 GeoJSON \u6587\u4ef6\uff1a", "de6ee6c53860770c5f09459882a2f6a4": "\u60a8\u5c06\u5728\u6587\u4ef6\u5939\u4e2d\u770b\u5230\u4e00\u4e2a\u65b0\u7684 ZIP \u6587\u4ef6 &nbsp;", "08cec23918d645b4c549f87a86a62a4e": "\u9009\u62e9\u201c\u4e0a\u4f20\u6587\u4ef6\u201d\uff0c\u7136\u540e\u901a\u8fc7\u62d6\u653e\u6216\u6d4f\u89c8\u9009\u62e9\u65b0\u7f13\u51b2\u533a\u538b\u7f29\u6587\u4ef6\u5939\u4e0a\u4f20\uff0c\u7136\u540e\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\u3002 &nbsp;", "cce3c1c203829e8d90e184e77fa9dda8": "\u9009\u62e9\u9002\u7528\u7684\u5927\u5b97\u5546\u54c1\uff0c\u7136\u540e\u4e3a\u65b0\u7f13\u51b2\u533a\u5217\u8868\u521b\u5efa\u65b0\u6587\u4ef6\uff0c\u9009\u62e9\u60a8\u5e0c\u671b\u5728\u7f13\u51b2\u533a\u4e0a\u8fd0\u884c\u7684\u62a5\u544a > \u4e0b\u4e00\u6b65&nbsp;", "81d6303fc3ca8c99edfb850bcf3cf966": "\u5982\u679c\u60a8\u4ec5\u5e0c\u671b\u76d1\u6d4b\u7f13\u51b2\u533a\u5185\u8fd1\u671f\u7684\u68ee\u6797\u7834\u574f\u60c5\u51b5\uff0c\u53ea\u9700\u5173\u6ce8\u8fd1\u671f\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u5373\u53ef\u3002&nbsp;", "7ecb195f04163716593ec8b36ca366d4": "<strong>\u5750\u6807\u53c2\u8003\u7cfb</strong>\uff1a\u8fd9\u662f\u60a8\u7684\u6570\u636e\u6587\u4ef6\u6240\u4f7f\u7528\u7684\u5750\u6807\u53c2\u8003\u7cfb\u7edf\u3002GFW Pro \u8981\u6c42\u6240\u6709\u4e0a\u4f20\u81f3\u5176\u7cfb\u7edf\u7684\u6570\u636e\u5747\u91c7\u7528 WGS84 \u6295\u5f71\u3002\u5728 GeoJSON \u6587\u4ef6\u4e2d\uff0c\u8fd9\u4ee5 \u201cOGC:1.3:CRS84\u201d \u8868\u793a\u3002\u8bf7\u786e\u4fdd\u60a8\u7684\u6587\u4ef6\u4f7f\u7528\u4e86\u6b63\u786e\u7684\u53c2\u8003\u7cfb\u3002\u5982\u679c\u6587\u4ef6\u4f7f\u7528\u7684\u4e0d\u662f WGS84 \u6295\u5f71\u5750\u6807\u53c2\u8003\u7cfb\uff0c\u60a8\u9700\u8981\u4f7f\u7528 GIS \u8f6f\u4ef6\uff08\u5982 QGIS \u6216 ArcGIS\u2014\u2014\u89c1\u4e0b\u6587\uff09\u5bf9\u60a8\u7684\u6587\u4ef6\u8fdb\u884c\u91cd\u6295\u5f71\uff0c\u7136\u540e\u518d\u8fdb\u884c\u4e0a\u4f20\u3002&nbsp;&nbsp;", "f180cd1ca09db44d73ce8a5fa4fae6d4": "\u4f4d\u7f6e\u540d\u79f0\uff08\u5b57\u7b26\uff09\u2014\u2014\u60a8\u7684\u4f4d\u7f6e\u540d\u79f0\uff0c\u8be5\u540d\u79f0\u5c06\u5728\u60a8\u7684 GFW Pro \u8d26\u6237\u4e2d\u663e\u793a\u3002&nbsp;", "7f762eab9518e7458fc233810c5372e3": "GeoJSON \u591a\u8fb9\u5f62\u6587\u4ef6\uff1a&nbsp;&nbsp;", "cc5a7f1b57654871cd0e9c3cd0119c6b": "<strong>\u5c5e\u6027</strong>\uff1a\u5c5e\u6027\u5217\u662f\u6307\u4e0e\u7a7a\u95f4\u8981\u7d20\u76f8\u5173\u7684\u6240\u6709\u6570\u636e\uff0c\u5982\u4f4d\u7f6e\u540d\u79f0\u3002\u6839\u636e\u60a8\u5904\u7406\u7684\u51e0\u4f55\u56fe\u5f62\u7c7b\u578b\uff0cGFW Pro \u6709\u4e0d\u540c\u7684\u5c5e\u6027\u5217\u8981\u6c42\u5fc5\u987b\u6ee1\u8db3\uff1a:&nbsp;", "9c3f5d0e6d2447eefb61ffdb8f721aa1": "\u5206\u6790\u534a\u5f84\uff08\u6570\u5b57\uff09\u2014\u2014\u534a\u5f84\uff08\u4ee5 KM \u4e3a\u5355\u4f4d\uff09\uff0c\u7528\u4e8e\u56f4\u7ed5\u5750\u6807\u5b9a\u4e49\u5206\u6790\u7f13\u51b2\u533a\u3002\u53ea\u6709\u5728\u672a\u5b9a\u4e49\u5206\u6790\u9762\u79ef\u65f6\u624d\u9700\u8981\u63d0\u4f9b\u3002&nbsp;", "b5bb4a66e78b76a38e40d90a336da8b6": "\u5206\u6790\u9762\u79ef\uff08\u6570\u5b57\uff09\u2014\u2014\u56f4\u7ed5\u5750\u6807\u7684\u5206\u6790\u7f13\u51b2\u533a\u9762\u79ef\uff08\u4ee5 HA \u4e3a\u5355\u4f4d\uff09\u3002\u53ea\u6709\u5728\u672a\u5b9a\u4e49\u5206\u6790\u534a\u5f84\u65f6\u624d\u9700\u8981\u63d0\u4f9b\u3002", "dee9289750769929b4d4f0a25535b4ab": "\u786e\u4fdd\u6587\u4ef6\u7c7b\u578b\u7684\u6240\u6709\u5fc5\u586b\u5c5e\u6027\u5217\u5747\u5df2\u9648\u5217\uff0c\u4e14\u5177\u6709\u6709\u6548\u503c\u3002\u60a8\u53ef\u4ee5\u50cf\u7f16\u8f91\u4efb\u610f\u6587\u672c\u4e00\u6837\uff0c\u7f16\u8f91\u5c5e\u6027\u5217\u7684\u540d\u79f0\u548c\u503c\u3002\u4e0d\u8fc7\uff0c\u60a8\u5fc5\u987b\u5bf9\u6587\u4ef6\u4e2d\u7684\u6bcf\u4e2a\u8981\u7d20\u90fd\u8fdb\u884c\u8be5\u64cd\u4f5c\u3002&nbsp;&nbsp;", "e465db9703060b0a392ffa220e8b61fd": "GeoJSON \u70b9\u6587\u4ef6\uff1a&nbsp;", "19e23de383315bbb58708c574e6d2fae": "<strong>\u51e0\u4f55\u56fe\u5f62</strong>\uff1a\u6bcf\u4e2a\u8981\u7d20\u90fd\u5305\u542b\u5176\u51e0\u4f55\u4fe1\u606f\u3002\u5bf9\u4e8e\u70b9\u72b6\u51e0\u4f55\uff0c\u8fd9\u5c31\u662f\u4e00\u7ec4\u5750\u6807\u503c\u3002\u5bf9\u4e8e\u591a\u8fb9\u5f62\u51e0\u4f55\u56fe\u5f62\uff0c\u8fd9\u662f\u6bcf\u4e2a\u591a\u8fb9\u5f62\u9876\u70b9\u7684\u5750\u6807\u503c\u3002\u8bf7\u786e\u4fdd\u60a8\u7684\u51e0\u4f55\u56fe\u5f62\u662f\u6709\u6548\u7684\u3002\u5bf9\u4e8e\u70b9\u72b6\u51e0\u4f55\uff0c\u8fd9\u610f\u5473\u7740\u5fc5\u987b\u5177\u6709\u4f4d\u4e8e\u9646\u5730\u4e0a\u7684\u6709\u6548\u5750\u6807\u503c\u3002\u5bf9\u4e8e\u591a\u8fb9\u5f62\u6570\u636e\uff0c\u8fd9\u610f\u5473\u7740\u8981\u907f\u514d\u4ea7\u751f\u81ea\u76f8\u4ea4\u7684\u591a\u8fb9\u5f62\uff0c\u4e14\u51e0\u4f55\u56fe\u5f62\u8981\u4f4d\u4e8e\u9646\u5730\u4e0a\u3002&nbsp;&nbsp;", "aebe3fb639e8a3ab0c427ad7940954b9": "\u5728 Notepad+ \u4e2d\u6253\u5f00\u7684\u793a\u4f8b GeoJSON \u6587\u4ef6\u3002\u9ad8\u4eae\u90e8\u5206\u4e3a GeoJSON \u7684\u91cd\u8981\u7ec4\u6210\u90e8\u5206\uff0c\u6bcf\u4e2a\u7ec4\u6210\u90e8\u5206\u65c1\u8fb9\u7684\u5b57\u6bcd\u5bf9\u5e94\u5176\u524d\u6587\u63cf\u8ff0\u3002", "f1ce92c59e1b20e2daf456145595a8dd": "\u5728 GIS \u8f6f\u4ef6\u4e2d\u6253\u5f00\u548c\u7f16\u8f91 GeoJSON \u6587\u4ef6\uff1a", "19150ac142926502a9851e3417164314": "Piost-2000 \u68ee\u6797\u53d8\u5316\u62a5\u544a\u53ef\u7528\u4e8e\u5206\u6790\u81ea 2000 \u5e74\u4ee5\u6765\u7684\u5386\u53f2\u6027\u68ee\u6797\u635f\u5931\u60c5\u51b5\uff0c\u5c24\u5176\u9002\u7528\u4e8e\u4ee5\u4e0b\u60c5\u51b5\uff1a\u90bb\u8fd1\u571f\u5730\u5b58\u5728\u975e\u6cd5\u5f00\u57a6\u6216\u8fdd\u53cd\u81ea\u613f\u627f\u8bfa\u7684\u884c\u4e3a\uff0c\u5bfc\u81f4\u4ea7\u54c1\u6e17\u6f0f\u81f3\u4f9b\u5e94\u94fe\u4e2d\u3002&nbsp;", "5c4c491410adbfaecd1e438267a7b6e1": "\u9009\u62e9\u4f4d\u7f6e\uff0c\u5bfc\u822a\u81f3\u8be5\u4f4d\u7f6e\u7684\u5730\u56fe &nbsp;", "e3522423ce3e456702b7bd0486e8b0f2": "\u5df2\u5b8c\u6210\uff01&nbsp;&nbsp;", "ecee148c092b68a43aa935d789285bfc": "\u4ee5\u4e0b\u662f\u4e0a\u4f20 GeoJSON \u6587\u4ef6\u81f3 GFW Pro \u7684\u4e24\u79cd\u5efa\u8bae\u7684\u524d\u671f\u51c6\u5907\u5de5\u4f5c\u6d41\u7a0b\uff1a\u4e00\u79cd\u57fa\u4e8e\u6587\u672c\u7f16\u8f91\u5668\u64cd\u4f5c\uff0c\u53e6\u4e00\u79cd\u57fa\u4e8e GIS \u8f6f\u4ef6\u64cd\u4f5c\u3002\u60a8\u53ef\u4ee5<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5728\u6b64</a>\u4e0b\u8f7d\u793a\u4f8b GFW Pro GeoJSON \u6a21\u677f\u3002&nbsp;", "9e75a7e261744dbecc7886788f9d84cd": "GeoJSON \u6587\u4ef6\u662f\u57fa\u4e8e\u6587\u672c\u7684\u6570\u636e\u683c\u5f0f\uff0c\u53ef\u901a\u8fc7\u6587\u672c\u6216\u4ee3\u7801\u7f16\u8f91\u5668\u8bbf\u95ee (Notepad+, VisualStudio Code)\u3002\u901a\u8fc7\u6587\u672c\u6216\u4ee3\u7801\u7f16\u8f91\u5668\u8bbf\u95ee\u65f6\uff0c\u60a8\u53ef\u4ee5\u67e5\u770b\u5e76\u4fee\u6539\u7a7a\u95f4\u6587\u4ef6\u7684\u5e95\u5c42\u5750\u6807\u6570\u636e\uff0c\u4e5f\u80fd\u66f4\u6539\u6570\u636e\u5217\u540d\u79f0\u53ca\u6570\u636e\u503c\u3002\u8bf7\u6ce8\u610f\uff0c\u5982\u679c\u60a8\u9700\u8981\u5904\u7406\u5305\u542b\u591a\u4e2a\u4f4d\u7f6e\u7684\u6587\u4ef6\uff0c\u76f4\u63a5\u5728\u6587\u672c\u6587\u4ef6\u4e2d\u7f16\u8f91\u8fd9\u4e9b\u6587\u4ef6\u53ef\u80fd\u4f1a\u8f83\u4e3a\u7e41\u7410\uff0c\u901a\u8fc7 GIS \u8f6f\u4ef6\u64cd\u4f5c\uff08\u8be6\u89c1\u4e0b\u6587\uff09\u53ef\u80fd\u66f4\u52a0\u5408\u9002\u3002&nbsp;", "db1f109c89c3aaf4b7dd3b3faa5bbeb7": "\u5728\u60a8\u9996\u9009\u7684\u6587\u672c\u7f16\u8f91\u5668\u4e2d\u6253\u5f00 GeoJSON \u6587\u4ef6\u3002\u5efa\u8bae\u4f7f\u7528 Notepad \u6216 Visual Studio Code\u3002&nbsp;&nbsp;", "362fed2bb61335c557e18602e1485771": "\u60a8\u7684 GeoJSON \u6587\u4ef6\u5c06\u663e\u793a\u4e3a\u4e00\u7cfb\u5217\u6587\u672c\u884c\u3002\u4ee5\u4e0b\u662f\u6587\u4ef6\u4e2d\u60a8\u9700\u8981\u6ce8\u610f\u7684\u5173\u952e\u90e8\u5206\uff1a&nbsp;", "901d85b6520e80c20cb79459d7b21f15": "<strong>\u8981\u7d20</strong>\uff1a\u6587\u4ef6\u4e2d\u7684\u6240\u6709\u7a7a\u95f4\u8981\u7d20\u5747\u5c06\u5728 GeoJSON \u6587\u4ef6\u4e2d\u7684\u201c\u8981\u7d20\u201d\u90e8\u5206\u5217\u51fa\uff0c\u7a7a\u95f4\u6570\u636e\u5728\u5706\u62ec\u53f7\u4e2d\uff0c\u5c5e\u6027\u6570\u636e\u5728\u65b9\u62ec\u53f7\u4e2d\u3002\u8bf7\u786e\u4fdd\u6587\u4ef6\u5305\u542b\u6240\u6709\u6240\u9700\u8981\u7d20\uff0c\u5e76\u4e14\u8fd9\u4e9b\u8981\u7d20\u90fd\u5177\u6709\u6709\u6548\u7684\u51e0\u4f55\u56fe\u5f62\uff08\u8be6\u89c1\u4e0b\u6587 d. \u90e8\u5206\uff09\u3002&nbsp;&nbsp;", "c20dfc81dc8e0da45c65d7121d6210db": "\u786e\u4fdd\u60a8\u7684 GeoJSON \u6587\u4ef6\u91c7\u7528\u7684\u662f WGS:84 \u6295\u5f71\u3002\u4e3a\u786e\u8ba4\u8fd9\u4e00\u70b9\uff0c\u8bf7\u5728\u56fe\u5c42\u7a97\u53e3\u4e2d\u53f3\u952e\u5355\u51fb\u56fe\u5c42\uff0c\u6253\u5f00\u56fe\u5c42\u5c5e\u6027\u3002\u8fd9\u4f1a\u6253\u5f00\u56fe\u5c42\u7684\u8be6\u7ec6\u4fe1\u606f\uff0c\u60a8\u53ef\u4ee5\u5728\u201c\u8303\u56f4\u201d\u4e0b\u7684\u201c\u4fe1\u606f\u201d\u9009\u9879\u5361\u4e2d\u67e5\u770b\u5176\u6295\u5f71\u7cfb\u7edf\u3002&nbsp;", "a245031998e20b95caf52893e9d0e8c5": "\u5728 QGIS \u4e2d\u67e5\u770b\u6570\u636e\u6587\u4ef6\u3002\u8bf7\u786e\u4fdd\u60a8\u7684\u51e0\u4f55\u56fe\u5f62\u6309\u9884\u671f\u663e\u793a\uff0c\u4e14\u7b26\u5408 GFW Pro \u7684\u6807\u51c6\u3002\u5982\u679c\u60a8\u5904\u7406\u7684\u662f\u591a\u8fb9\u5f62\u51e0\u4f55\uff0c\u8bf7\u68c0\u67e5\u662f\u5426\u5b58\u5728\u81ea\u76f8\u4ea4\u591a\u8fb9\u5f62\u3002&nbsp;", "97e651b9e6bb61ff2acaeefc717946eb": "\u5de5\u4f5c\u6d41\u7a0b\uff1a\u5982\u4f55\u5728 QGIS \u4e2d\u5408\u5e76\u4e24\u4e2a\u6570\u636e\u56fe\u5c42\u3002", "8abe642cdff0c56590733c853bfcc9e4": "\u8981\u6309\u7167 GFW Pro \u7684\u8981\u6c42\u6574\u7406 GeoJSON \u6587\u4ef6\u683c\u5f0f\uff0c\u8bf7\u5c06\u5176\u4e0e GFW Pro \u7684\u793a\u4f8b GeoJSON \u6a21\u677f\u201c\u5408\u5e76\u201d\u3002\u8f6c\u5230\u77e2\u91cf &gt; \u6570\u636e\u7ba1\u7406\u5de5\u5177 &gt; \u5408\u5e76\u77e2\u91cf\u56fe\u5c42\u3002\u5728\u5f39\u51fa\u7684\u7a97\u53e3\u4e2d\u9009\u62e9\u60a8\u7684 GeoJSON \u6587\u4ef6\u548c GFW Pro \u6a21\u677f\u4f5c\u4e3a\u8f93\u5165\u6587\u4ef6\uff0c\u7136\u540e\u70b9\u51fb\u201c\u8fd0\u884c\u201d&nbsp;", "83811766cc3d39a31fe1bfe8530bda27": "\u5408\u5e76\u540e\u7684\u56fe\u5c42\u5c06\u5728\u56fe\u5c42\u83dc\u5355\u4e2d\u51fa\u73b0\u3002\u53f3\u952e\u5355\u51fb\u5408\u5e76\u56fe\u5c42\uff0c\u9009\u62e9\u201c\u5c5e\u6027\u8868\u201d\uff0c\u6253\u5f00\u5408\u5e76\u56fe\u5c42\u7684\u5c5e\u6027\u8868\u3002\u8be5\u64cd\u4f5c\u4f1a\u6253\u5f00\u4e0e\u5408\u5e76\u56fe\u5c42\u76f8\u5173\u7684\u6240\u6709\u5c5e\u6027\u5217\uff0c\u5305\u62ec GFW Pro \u793a\u4f8b\u6a21\u677f\u4e2d\u5305\u542b\u7684\u5c5e\u6027\u5217\u3002&nbsp;", "b1ffddf53c68a8d878aacd062ebf3c8d": "\u70b9\u51fb\u94c5\u7b14\u56fe\u6807\uff0c\u7f16\u8f91\u5408\u5e76\u6587\u4ef6\u7684\u6570\u636e\u3002\u9009\u62e9\u4f4d\u7f6e\u5e76\u70b9\u51fb<em>\u5783\u573e\u6876\u56fe\u6807</em>\uff0c\u4ece GFW Pro \u6587\u4ef6\u5220\u9664\u8be5\u4f4d\u7f6e\u3002\u60a8\u53ef\u4ee5\u901a\u8fc7\u7f16\u8f91\u5c5e\u6027\u8868\u4e3a\u6bcf\u4e2a\u4f4d\u7f6e\u8d4b\u503c\u3002\u60a8\u53ef\u4ee5\u4e3a\u6bcf\u4e2a\u8981\u7d20\u8f93\u5165\u503c\uff0c\u6216\u4f7f\u7528<em>\u5b57\u6bb5\u8ba1\u7b97\u5668</em>\uff08\u901a\u8fc7\u7b97\u76d8\u56fe\u6807\u8bbf\u95ee\uff09\u6279\u91cf\u5206\u914d\u503c\uff1a&nbsp;", "4c9d6e7bf590f6893ab18e0dbd3c147d": "<em>\u7cbe\u9009\uff1a</em>\u7cbe\u9009\u4e86\u4e0e\u8f6f\u6027\u5927\u5b97\u5546\u54c1\u4f9b\u5e94\u94fe\u53c2\u4e0e\u65b9\u76f8\u5173\u7684\u8d85\u8fc7 35 \u4e2a\u5168\u7403\u53ca\u672c\u5730\u6570\u636e\u96c6\u3002&nbsp;", "c0a048e685eee040c3fb2395d1a8ff6b": "\u60a8\u53ef\u4ee5\u4f7f\u7528\u514d\u8d39\u5de5\u5177\uff08\u5982 QGIS\uff09\u6216\u4ed8\u8d39\u5de5\u5177\uff08\u5982 ArcGIS\uff09\u6765\u521b\u5efa\u7f13\u51b2\u533a\u3002GFW Pro \u5c06\u5bf9\u7f13\u51b2\u533a\u8fdb\u884c\u5206\u6790\uff0c\u5176\u65b9\u5f0f\u4e0e\u5206\u6790\u6574\u4e2a\u591a\u8fb9\u5f62\u7684\u65b9\u5f0f\u5b8c\u5168\u4e00\u81f4\u3002\u4ee5\u4e0b\u662f\u4f7f\u7528\u4e86 shapefile \u6a21\u677f\u7684\u793a\u4f8b\u3002&nbsp;", "f3175011214d148338b85a92fc2f9ac5": "\u767b\u5f55 GFW Pro &gt; \u5bfc\u822a\u81f3\u60a8\u8981\u4f7f\u7528\u7684\u5217\u8868\u9875&nbsp;", "a810562ff5ef037b4914117ad37243c3": "\u786e\u8ba4\u60a8\u7684\u5730\u5757\u591a\u8fb9\u5f62\u5728 GWF Pro \u4e2d\u53ef\u89c1\u3002&nbsp;", "27cf9b3bf7017e5af5752d2a01c40c3a": "\u5c06\u540c\u4e00\u4e2a\u591a\u8fb9\u5f62\u5217\u8868\u4f5c\u4e3a\u77e2\u91cf\u56fe\u5c42\u4e0a\u4f20\u81f3 QGIS\uff1a\u56fe\u5c42 &gt; \u6dfb\u52a0\u56fe\u5c42 &gt; \u77e2\u91cf\u56fe\u5c42 &gt; \u9009\u62e9\u6587\u4ef6\uff08\u53cc\u51fb\u4e0a\u4f20\uff09&nbsp;", "34c3e211cd10972f71c8ada5db88a938": "\u5728 QGIS \u56fe\u5c42\u9762\u677f\u4e2d\u9009\u4e2d\u65b0\u56fe\u5c42\uff0c\u5e76\u786e\u8ba4\u60a8\u6240\u9700\u7684\u591a\u8fb9\u5f62\u662f\u5426\u5b58\u5728\u3002\uff08\u8bf7\u6ce8\u610f\uff1a\u60a8\u53ef\u4ee5\u6dfb\u52a0 ESRI \u6216 Google \u5e95\u56fe\u4f5c\u4e3a\u53c2\u8003\uff09\u3002", "ca0fe8ddfadde85aa83b4267dd7628e9": "\u8bf7\u52a1\u5fc5\u9009\u62e9 \u201cWeb Mercator\u201d \u4f5c\u4e3a\u7b5b\u9009\u6761\u4ef6\uff0c\u5e76\u7b5b\u9009\u81f3 \u201cWGS_1984_WEB_MERCATOR Auxiliary_Sphere\u201d&nbsp;", "d02b5c8f17a3e74e511e4f523e6b7e3b": "\u70b9\u51fb\u201c\u8fd0\u884c\u201d > \u5b8c\u6210\u540e\u70b9\u51fb\u201c\u5173\u95ed\u201d&nbsp;", "cf4948128722b591604569e57ccdb346": "\u70b9\u51fb\u201c\u5173\u95ed\u201d&nbsp;", "eb77cbb5fa3cf4d012ebf35bacba93f2": "\u60a8\u5c06\u770b\u5230\u65b0\u7684\u201c\u5df2\u7f13\u51b2\u201d\u56fe\u5c42&nbsp;", "1c0ef6c58a63dce1f7508e5637a36afe": "\u5f88\u9057\u61be\uff0c\u6211\u4eec\u65e0\u6cd5\u63a5\u53d7\u4e0b\u5217\u7533\u8bf7\u4eba\uff1a&nbsp;", "ad3bcb2cc6ec9ad0d9b13e832a210b4b": "\u7533\u8bf7\u6307\u5357\u63d0\u4f9b<a href=\"{{0}}\">\u82f1\u8bed</a>\u3001<a href=\"{{1}}\">\u897f\u73ed\u7259\u8bed</a>\u548c<a href=\"{{2}}\">\u6cd5\u8bed</a>\u7248\u672c\u3002\u8bf7\u6ce8\u610f\u54ea\u4e9b\u9879\u76ee\u6240\u5728\u56fd\u7b26\u5408\u6761\u4ef6\u3002\u4e0d\u8fc7\u60a8\u7684\u7ec4\u7ec7\u7684\u6ce8\u518c\u5730\u53ef\u4f4d\u4e8e\u9879\u76ee\u6240\u5728\u56fd\u4e4b\u5916\u3002", "5ede4b4bed126d53bd36d89a73e3ddae": "\u5982\u9700\u83b7\u53d6\u5404\u79cd\u8d44\u52a9\u673a\u4f1a\u7684\u6700\u65b0\u63d0\u6848\u5f81\u96c6\u4fe1\u606f\uff0c\u8bf7\u8bbf\u95ee<a href=\"{{0}}\">\u7533\u8bf7\u9875\u9762</a>\u3002", "c5741a980ed75be1b5c9ff41619c9480": "\u53ea\u6709\u4f9d\u6cd5\u6ce8\u518c\u4e3a\u975e\u8425\u5229\u3001\u975e\u653f\u5e9c\u7ec4\u7ec7\u7684\u673a\u6784\u624d\u6709\u8d44\u683c\u7533\u8bf7\u5c0f\u989d\u8d44\u52a9\u57fa\u91d1\u3002\u5177\u4f53\u8d44\u683c\u6807\u51c6\u8bf7\u53c2\u9605\u7533\u8bf7\u6307\u5357\u3002", "33e9282dea194468fba3e46aa5a24d18": "\uff08\u53e6\u5916\u63d0\u4f9b<a href=\"{{0}}\">\u897f\u73ed\u7259\u8bed</a>\u548c<a href=\"{{1}}\">\u6cd5\u8bed</a>\u7248\u672c\uff09\uff0c\u4e4b\u524d\u7684\u7533\u8bf7\u4eba\u6709\u8d44\u683c\u518d\u6b21\u7533\u8bf7\u5c0f\u989d\u8d44\u52a9\u57fa\u91d1\u3002\u4f46\u4e3a\u4e86\u7ed9\u65b0\u7684\u53d7\u8d44\u52a9\u8005\u7559\u51fa\u66f4\u591a\u673a\u4f1a\u5e76\u6269\u5927\u8d44\u52a9\u8303\u56f4\uff0c\u8bc4\u9009\u59d4\u5458\u4f1a\u5728\u8003\u8651\u662f\u5426\u7ee7\u7eed\u8d44\u52a9\u4e4b\u524d\u7684\u53d7\u8d44\u52a9\u8005\u65f6\uff0c\u4f1a\u8003\u5bdf\u4ed6\u4eec\u80fd\u5426\u5728\u4e4b\u524d\u8d44\u52a9\u7684\u57fa\u7840\u4e0a\u6269\u5927\u5f71\u54cd\u529b\u5e76\u505a\u51fa\u6539\u8fdb\u3002", "a9163c1cde6b28ee0a0ccc44d65d3847": "\u8bf7\u6ce8\u610f\uff0c\u60a8\u7684\u56e2\u961f\u4e2d\u4ecd\u9700\u81f3\u5c11\u4e00\u540d\u6210\u5458\u5177\u5907\u4e13\u4e1a\u82f1\u8bed\u5de5\u4f5c\u80fd\u529b\uff0c\u4ee5\u4fbf\u63d0\u4ea4\u6240\u9700\u7684\u5c3d\u804c\u8c03\u67e5\u8868\u683c\u3002", "8198d39bde004c7927f537e498ad392d": "\u662f\u7684\u3002\u5047\u8bbe\u4ed6\u4eec\u6ee1\u8db3\u6240\u6709\u5176\u4ed6", "cb5480c32e71778852b08ae1e8712775": "\u897f\u73ed\u7259\u8bed", "ad225f707802ba118c22987186dd38e8": "\u6cd5\u8bed", "3d596ea7f6ff3633c8d526e1c25fabe1": "\u662f\u7684\u3002\u6211\u4eec\u5f88\u9ad8\u5174\u5730\u544a\u8bc9\u5927\u5bb6\uff0c\u4eca\u5e74\u6211\u4eec\u63a5\u53d7\u4ee5\u4e0b\u8bed\u8a00\u7684\u7533\u8bf7\u6750\u6599\uff1a", "5fa6f2a4c51421fc0f269fcfe6354773": "\u4e3a\u4ec0\u4e48\u6211\u7684\u76ee\u6807\u56fd\u5bb6\u672a\u5305\u542b\u5728\u9879\u76ee\u7684\u5730\u7406\u8d44\u683c\u8303\u56f4\u5185\uff1f", "eecbc01d077b81dc4054378e780deb0c": "\u867d\u7136\u6211\u4eec\u8ba4\u8bc6\u5230\u8bb8\u591a\u56fd\u5bb6\u7684\u68ee\u6797\u90fd\u9762\u4e34\u4e25\u91cd\u5a01\u80c1\uff0c\u4f46\u7531\u4e8e\u8d44\u52a9\u65b9\u548c\u673a\u6784\u6709\u4f18\u5148\u5904\u7406\u4e8b\u9879\uff0c\u7b26\u5408\u6761\u4ef6\u7684\u56fd\u5bb6\u6570\u91cf\u4e0d\u591a\u3002\u6211\u4eec\u9f13\u52b1\u60a8\u4ee5\u5176\u4ed6\u6709\u610f\u4e49\u7684\u65b9\u5f0f\u53c2\u4e0e GFW \u7684\u5de5\u4f5c\uff0c\u56e0\u4e3a\u8fd9\u4e9b\u5de5\u5177\u548c\u6570\u636e\u662f\u514d\u8d39\u7684\uff0c\u4efb\u4f55\u4eba\u90fd\u53ef\u4ee5\u4f7f\u7528\u3002", "4e32499b6d8c0b937c213f5f49c71fa8": "\u6211\u4f1a\u6536\u5230\u9488\u5bf9\u7533\u8bf7\u7684\u53cd\u9988\u610f\u89c1\u5417\uff1f", "2dc3a4c2c8b22770977c421bc0f1104d": "\u5f88\u9057\u61be\uff0c\u7531\u4e8e\u4eba\u529b\u6709\u9650\uff0c\u6211\u4eec\u65e0\u6cd5\u4fdd\u8bc1\u5bf9\u7533\u8bf7\u63d0\u51fa\u53cd\u9988\u610f\u89c1\u3002\u611f\u8c22\u60a8\u7684\u7406\u89e3\u3002", "b42e346b10f3879064af4adddf062f64": "GFW \u5c0f\u989d\u8d44\u52a9\u57fa\u91d1\u65e8\u5728\u63d0\u5347\u6c11\u95f4\u793e\u4f1a\u7ec4\u7ec7\u7684\u80fd\u529b\uff0c\u4f7f\u5176\u80fd\u591f\u6709\u6548\u5229\u7528 GFW \u5de5\u5177\u548c\u6570\u636e\uff0c\u6765\u51cf\u5c11\u975e\u6cd5\u6216\u65e0\u8ba1\u5212\u7684\u6bc1\u6797\uff0c\u5e76\u5b9e\u73b0\u68ee\u6797\u7684\u53ef\u6301\u7eed\u7ba1\u7406\u3002\u5728\u672c\u6b21\u7f51\u7edc\u7814\u8ba8\u4f1a\u4e0a\uff0c\u6211\u4eec\u7b80\u5355\u4ecb\u7ecd\u4e86 2024 \u5e74\u7684\u7533\u8bf7\u6d41\u7a0b\uff0c\u5e76\u6f14\u793a\u4e86 GFW \u5e73\u53f0\u548c\u4e0a\u9762\u7684\u8fd1\u5b9e\u65f6\u6570\u636e\u3002", "32dd791e429b137a44f14de97a84ba25": "\u4e0d\u662f\u3002\u4e3a\u6c42\u516c\u6b63\uff0c\u6240\u6709\u7533\u8bf7\u90fd\u5c06\u6309\u7167\u76f8\u540c\u7684\u6807\u51c6\u8fdb\u884c\u5ba1\u6838\u3002\u4e0d\u8fc7\u6211\u4eec\u9f13\u52b1\u4e4b\u524d\u7684\u7533\u8bf7\u8005\u518d\u6b21\u7533\u8bf7\u3002", "030baa990b7e6db2dbfb558a0abebba4": "\u5c0f\u989d\u8d44\u52a9\u57fa\u91d1 2025 \u5e74\u8d44\u52a9\u5468\u671f\u7684\u6700\u7ec8\u5165\u56f4\u8005\u5c06\u4e8e 2025 \u5e74 7 \u6708\u5de6\u53f3\u6536\u5230\u901a\u77e5\u3002", "a1122fadddf40ef6a89f315badc94cc3": "2024 \u5e74\u5c0f\u989d\u8d44\u52a9\u57fa\u91d1\u7533\u8bf7\u4eba\u7f51\u7edc\u7814\u8ba8\u4f1a", "26b673c285d5c4244c767965b1229f96": "GFW \u5c0f\u989d\u8d44\u52a9\u57fa\u91d1\u65e8\u5728\u63d0\u5347\u6c11\u95f4\u793e\u4f1a\u7ec4\u7ec7\u7684\u80fd\u529b\uff0c\u4f7f\u5176\u80fd\u591f\u6709\u6548\u5229\u7528 GFW \u5de5\u5177\u548c\u6570\u636e\uff0c\u6765\u51cf\u5c11\u975e\u6cd5\u6216\u65e0\u8ba1\u5212\u7684\u6bc1\u6797\uff0c\u5e76\u5b9e\u73b0\u68ee\u6797\u7684\u53ef\u6301\u7eed\u7ba1\u7406\u3002\u5728\u672c\u6b21\u7f51\u7edc\u7814\u8ba8\u4f1a\u4e0a\uff0c\u6211\u4eec\u7b80\u5355\u4ecb\u7ecd\u4e86 2024 \u5e74\u7684\u7533\u8bf7\u6d41\u7a0b\uff0c\u5e76\u6f14\u793a\u4e86 GFW \u5e73\u53f0\u548c\u4e0a\u9762\u7684\u8fd1\u5b9e\u65f6\u6570\u636e\u3002[\u2026]", "1c0dc31b5ebc30aa27c2494b33c6fcdd": "\u66f4\u591a\u4fe1\u606f\u8bf7\u8bbf\u95ee\u5c0f\u989d\u8d44\u52a9\u57fa\u91d1\u7f51\u9875\uff1a<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">https://gfw.global/3HmszCN</a>\uff1b\u5982\u679c\u5728\u7f51\u7edc\u7814\u8ba8\u4f1a\u5f00\u59cb\u524d\u6709\u4efb\u4f55\u95ee\u9898\u6216\u53cd\u9988\uff0c\u8bf7\u901a\u8fc7\u90ae\u7bb1 gfwfund@wri.org \u8054\u7cfb\u6211\u4eec\u3002", "9489014982984344d855b0967dcb6be5": "\u70b9\u51fb\u8fd9\u91cc\u89c2\u770b\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a<a href=\"{{0