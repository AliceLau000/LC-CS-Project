516c\u5f00\u201d\uff0c\u5219\u4efb\u4f55\u6709\u6743\u8bbf\u95ee\u8fd9\u4e9b\u94fe\u63a5\u7684\u4eba\u90fd\u53ef\u4ee5\u5bf9\u5176\u8fdb\u884c\u8bbf\u95ee\u3002\u60a8\u53ef\u4ee5\u968f\u65f6\u5c06\u94fe\u63a5\u518d\u6b21\u8bbe\u7f6e\u4e3a\u201c\u79c1\u5bc6\u201d\uff0c\u8fd9\u6837\u5176\u4ed6\u4eba\u5c31\u65e0\u6cd5\u8bbf\u95ee\u8fd9\u4e9b\u94fe\u63a5\u3002", "09b880268f3e98d67c2193a080c18a76": "\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\uff1a&nbsp; \u5982\u8981\u5f00\u59cb\u672c\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a\u7b80\u4ecb \u5bf9\u4e8e\u4f7f\u7528 FW Mobile 3.3 \u6216\u66f4\u9ad8\u7248\u672c\u521b\u5efa\u7684\u62a5\u544a\uff0c\u5176\u4e2d\u7684\u56fe\u7247\u548c\u5f55\u97f3\u94fe\u63a5\u9ed8\u8ba4\u8bbe\u7f6e\u4e3a\u79c1\u5bc6\uff0c\u53ea\u6709\u767b\u5f55\u60a8\u7684\u8d26\u6237\u540e\u624d\u80fd\u8bbf\u95ee\u3002\u56e0\u6b64\uff0c\u5982\u679c\u60a8\u5206\u4eab [\u2026] \u7684 URL", "d790068ad5f2135cb954a1e263a12276": "\u5728 Forest Watcher Web \u4e0a\u7ba1\u7406\u5bf9\u62a5\u544a\u4e2d\u7684\u5f55\u97f3\u548c\u56fe\u7247\u7684\u8bbf\u95ee\u6743\u9650", "ff68633ea0a84fcf460e35d615ecf8c0": "\u5982\u4f55\u5206\u4eab\u8fd9\u4e9b\u6587\u4ef6\u3002", "c14fd9f46f7e3982f79f15ad91e0a2ec": "\u5728 FW Web \u4e0a\u5229\u7528\u4e00\u4e2a\u5f55\u97f3\u6216\u56fe\u7247\u7c7b\u578b\u521b\u5efa\u81f3\u5c11\u4e00\u4e2a<a href=\"{{0}}\">\u81ea\u5b9a\u4e49\u62a5\u544a\u6a21\u677f</a>\u3002\u5c06\u8fd9\u4e2a\u81ea\u5b9a\u4e49\u62a5\u544a\u6a21\u677f\u5173\u8054\u5230\u67d0\u4e2a\u533a\u57df\u3002", "ed0b026330dd48fbe0a5b4fcfe522301": "\u4f7f\u7528\u4e0a\u4e00\u6b65\u521b\u5efa\u7684\u81ea\u5b9a\u4e49\u62a5\u544a\u6a21\u677f\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a<a href=\"{{0}}\">\u521b\u5efa\u5e76\u5b8c\u6210\u62a5\u544a</a>\u3002", "1e039167f445b86ac91bd247e067e905": "\u6ce8\u610f\uff1a\u6b64\u529f\u80fd\u4ec5\u9002\u7528\u4e8e\u901a\u8fc7\u6700\u65b0\u7248\u672c\uff083.3 \u6216\u66f4\u9ad8\u7248\u672c\uff09\u7684 FW\uff08\u4e8e 2024 \u5e74 7 \u6708 28 \u65e5\u53d1\u5e03\uff09\u521b\u5efa\u7684\u62a5\u544a\u4e2d\u7684\u5a92\u4f53\u6587\u4ef6\u3002", "09e6ca2499a366b86f4e5e834f81e164": "\u5bf9\u4e8e\u4f7f\u7528 FW Mobile 3.3 \u6216\u66f4\u9ad8\u7248\u672c\u521b\u5efa\u7684\u62a5\u544a\uff0c\u5176\u4e2d\u7684\u56fe\u7247\u548c\u5f55\u97f3\u94fe\u63a5\u9ed8\u8ba4\u8bbe\u7f6e\u4e3a\u79c1\u5bc6\uff0c\u5e76\u4e14\u53ea\u6709\u5728\u767b\u5f55\u60a8\u7684\u8d26\u6237\u540e\u624d\u80fd\u8bbf\u95ee\u3002\u56e0\u6b64\uff0c\u5982\u679c\u60a8\u4e0e\u5176\u4ed6\u4eba\u5206\u4eab\u8fd9\u4e9b\u6587\u4ef6\u7684 URL\uff0c\u4ed6\u4eec\u5c06\u65e0\u6cd5\u8bbf\u95ee\u3002\u5982\u679c\u60a8\u60f3\u4e0e\u5176\u4ed6\u4eba\u5206\u4eab\u5f55\u97f3\u548c\u56fe\u7247\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528 FW Web \u4e2d\u65b0\u7684\u9690\u79c1\u5207\u6362\u6309\u94ae\uff0c\u5c06\u8fd9\u4e9b\u94fe\u63a5\u8bbe\u7f6e\u4e3a\u516c\u5f00\u3002", "9682329d1144b240eef032d7ca6d1c7d": "\u5982\u8981\u5f00\u59cb\u672c\u6559\u7a0b\uff0c\u60a8\u9700\u8981\uff1a", "69f2620ab3a5974ef91d3886c2820f1b": "\u5bf9\u4e8e\u4f7f\u7528\u6700\u65b0\u7248\u672c\u7684 Forest Watcher\uff08FW 3.3 \u6216\u66f4\u9ad8\u7248\u672c\uff09\u521b\u5efa\u7684\u62a5\u544a\uff0c\u5982\u4f55\u66f4\u6539\u5176\u4e2d\u7684\u5f55\u97f3\u6216\u56fe\u7247\u6587\u4ef6\u94fe\u63a5\u7684\u9690\u79c1\u8bbe\u7f6e\u3002", "8459d0fb81d42a712267778d8778694d": "\u5f02\u5e38\u5730\u4f4e", "dda29f37e11612c107aab1d0201adc65": "\u60a8\u5e0c\u671b\u5728 GFW \u4e0a\u770b\u5230\u54ea\u4e9b\u5176\u5b83\u706b\u707e\u6570\u636e\u548c\u5206\u6790\uff1f", "6a03d07c60c7ffd19860e6f518f2d8e4": "\u660e\u767d\u4e86\uff01", "60b4147cb4c5a618c214cd6a9ad5fca5": "\u6211\u4eec\u6b63\u5728\u4e3a\u60a8\u6700\u8fd1\u521b\u5efa\u7684\u5173\u6ce8\u533a\u57df\u63d0\u53d6\u5e76\u5206\u6790\u53ef\u7528\u6570\u636e\uff0c\u8fd9\u9700\u8981\u6211\u4eec\u7684\u670d\u52a1\u5668\u82b1\u8d39\u51e0\u5c0f\u65f6\uff08\u6240\u6709\u4fe1\u606f\u901a\u5e38\u5728\u6b21\u65e5\u53ef\u7528\uff09\u3002", "44e27b259abd552a1ca888169b0060dc": "\u60a8\u7684\u81ea\u5b9a\u4e49\u64cd\u4f5c\u9762\u677f\u5373\u5c06\u51c6\u5907\u5c31\u7eea\uff01", "2c0a7b8bd47fbe2de852d46838c1b71b": "<span>\u5728\u60a8\u7684\u64cd\u4f5c\u9762\u677f\u5b8c\u6210\u540e\uff0c</span>\u6211\u4eec\u5c06\u5411\u60a8\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u3002", "4f4896921c15d0ea6da58720e75813a6": "\u8c01\u662f\u65b0\u7248 GFW Pro \u5206\u6790\u7684\u76ee\u6807\u7528\u6237\uff1f", "91cfd4906ae04c603f7cca1a5e7b9a94": "\u81ea 2014 \u5e74\u63a8\u51fa\u4ee5\u6765\uff0c\u6709\u6765\u81ea\u5168\u4e16\u754c\u6bcf\u4e2a\u56fd\u5bb6/\u5730\u533a\u7684 400 \u591a\u4e07\u4eba\u8bbf\u95ee\u4e86 Global Forest Watch\u3002", "2c8ebacfe02b49da3b32a96b4671087e": "\u6700\u540e\u66f4\u65b0\u4e8e\uff1a2024 \u5e74 5 \u6708&nbsp;24 \u65e5&nbsp;", "d0fbfbd43507f6818ea3ef8aa9065271": "<strong>*</strong>\u6211\u4eec\u8ba1\u5212\u5728\u540e\u7eed\u6539\u8fdb\u4e2d\u5bf9\u8fd9\u4e00\u56fe\u5c42\u8fdb\u884c\u4fee\u6b63\u3002&nbsp;", "39e84f537c38a0ce1caf55a0b4ad1d1b": "GFW Pro\u63d0\u4f9b\u4ec0\u4e48\u6570\u636e\uff1f\u8fd9\u4e9b\u6570\u636e\u6765\u81ea\u54ea\u91cc\uff1f", "0eab900563005f664e8643387078834b": "\u5bf9VIIRS\u706b\u707e\u8b66\u62a5\u7684\u8bc4\u4f30\u53d1\u73b0\uff0c\u5927\u591a\u6570\u5730\u533a\u7684\u8bef\u62a5\u7387\u63a5\u8fd10\uff0c\u63a5\u53d7\u8bc4\u4f30\u7684\u5730\u533a\u4e2d\u6700\u9ad8\u4e3a1.2%\uff0c\u4e3b\u8981\u4e0e\u53cd\u5149\u5c4b\u9876\u4e0a\u7684\u592a\u9633\u5149\u6709\u5173\u3002", "2c04204a244337d4cbfb577652a01fd3": "\u5168\u7403\u68ee\u6797\u53d8\u5316", "4c56157fcc3d8b993b845821dff9bf70": "\u81ea2014\u5e74\u4ee5\u6765\uff0c", "77ca6f8372f31634bfdc6c37893b7daf": "\u672c\u5206\u6790\u5bf9\u51cf\u5c11\u6bc1\u6797\u653f\u7b56\u4e2d\u6700\u5e38\u63d0\u53ca\u7684\u4e00\u4e9b\u654f\u611f\u6797\u533a\uff08<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u539f\u59cb\u68ee\u6797</a>\u3001<a href=\"{{2}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u4fdd\u62a4\u533a</a>\u3001<a href=\"{{3}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6ce5\u70ad\u5730</a>\u3001<a href=\"{{4}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5b8c\u597d\u65e0\u635f\u7684\u68ee\u6797\u666f\u89c2</a>\uff09\u5185\u7528\u6237\u6240\u9009\u5730\u70b9\u7684\u5e74\u5ea6<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6797\u6728\u690d\u88ab\u635f\u5931</a>\uff08TCL\uff09\u8fdb\u884c\u4e86\u7ec6\u5206\u3002\u6839\u636e\u6240\u9009\u5730\u70b9\u7684\u4e0d\u540c\uff0c\u672c\u5206\u6790\u8fd8\u53ef\u80fd\u5305\u62ec\u5357\u7f8e\u6d32\u548c\u4e1c\u5357\u4e9a\u7684\u76f8\u5173\u5730\u533a\u4fe1\u606f\uff0c\u5176\u4e2d\u5305\u62ec\u5404\u79cd\u56fd\u5bb6\u6570\u636e\u548c\u4f5c\u7269\u9762\u79ef\u6570\u636e\uff0c\u53ef\u4ee5\u66f4\u597d\u5730\u8bf4\u660eTCL\u5728\u9ad8\u5ea6\u4f18\u5148\u5730\u57df\u7684\u5f71\u54cd\u3002\u5bf9\u4e8e\u9009\u5b9a\u56fd\u5bb6\uff0c\u8f93\u51fa\u7ed3\u679c\u8fd8\u53ef\u80fd\u5305\u542b\u6709\u52a9\u4e8e\u8bc4\u4f30\u8be5\u53f8\u6cd5\u7ba1\u8f96\u533a\u4e2d\u4e0e\u68ee\u6797\u6cd5\u89c4\u6216\u5176\u4ed6\u6cd5\u89c4\u76f8\u5173\u7684\u5408\u89c4\u98ce\u9669\u7684\u5206\u6790\u3002&nbsp;", "f483b4105cb22c9305c56b84bb402961": "Olam\u73b0\u5728\u4f7f\u7528GFW Pro\u6bcf\u6708\u5ba1\u67e5\u6240\u6709\u5730\u70b9\u7684\u98ce\u9669\uff0c\u53d1\u5e03\u5b63\u5ea6\u53ef\u8ffd\u6eaf\u6027\u63a7\u5236\u9762\u677f\uff0c\u76f4\u63a5\u4e0e\u4f9b\u5e94\u5546\u5c31\u4f9b\u5e94\u94fe\u76d1\u63a7\u8fdb\u884c\u4e92\u52a8\u3002", "f3498cc7ee66871a52843570fd78cae5": "\u4ec0\u4e48\u662fGFW Pro\uff1f", "79de29bf562537df7c532a4fd264fc93": "\u5904\u7406\u516c\u9877\u6570\uff08HOP\uff09", "ba6ebf05f86d0fbc11a40d7dfe1e4df8": "\u5e74\u5ea6\u514d\u8d39\u4f7f\u7528\u989d\u5ea6", "470c6876cd226dd4ad55a29b7a5fe114": "\u6211\u4eec\u7684\u76ee\u7684\u662f\u5c06GFW Pro\u4f5c\u4e3a\u516c\u5171\u4ea7\u54c1\u63d0\u4f9b\u7ed9\u7edd\u5927\u90e8\u5206\u4f9b\u5e94\u94fe\u53c2\u4e0e\u65b9\uff0c\u4ece\u800c\u4fc3\u8fdb\u66f4\u53ef\u6301\u7eed\u7684\u5927\u5b97\u5546\u54c1\u91c7\u8d2d\u51b3\u7b56\u3002\u5176\u4ed6\u81f4\u529b\u4e8e\u63a8\u52a8\u8fd9\u4e00\u76ee\u6807\u7684\u5404\u65b9\u4e5f\u53ef\u4ee5\u4f7f\u7528GFW Pro\u3002\u8d22\u529b\u6709\u9650\u4e0d\u5e94\u6210\u4e3a\u505a\u51fa\u66f4\u660e\u667a\u51b3\u7b56\u7684\u969c\u788d\uff0c\u7279\u522b\u662f\u5bf9\u4e8e\u5168\u7403\u519c\u4e1a\u4f9b\u5e94\u94fe\u4e2d\u8f83\u5c0f\u89c4\u6a21\u7684\u53c2\u4e0e\u65b9\uff08\u5982\u672c\u5730\u751f\u4ea7\u5408\u4f5c\u793e\u548c\u5c0f\u519c\u6237\uff09\u800c\u8a00\u3002\u56e0\u6b64\uff0cGFW Pro\u4ecd\u53ef\u514d\u8d39\u7528\u4e8e\u5185\u90e8\u548c\u76f4\u63a5\u5408\u89c4\u62a5\u544a\uff0c\u5176\u6d88\u8017\u91cf\u4e5f\u7b26\u5408\u5927\u591a\u6570\u4e2d\u5c0f\u578b\u4f01\u4e1a\u7684\u9884\u671f\u3002\u6211\u4eec\u8ba1\u5212\u7ee7\u7eed\u5411\u4f01\u4e1a\uff08\u5305\u62ec\u8425\u5229\u548c\u975e\u8425\u5229\u7ec4\u7ec7\uff09\u63d0\u4f9b\u5e74\u5ea6\u514d\u8d39\u4f7f\u7528\u989d\u5ea6\u3002&nbsp;", "6591fb4be0c9eca9f382deeaf8ea2aea": "\u8fd9\u4e9b\u989d\u5ea6\u5bf9\u4e8e\u4f01\u4e1a\u521b\u5efa\u548c\u4f7f\u7528\u7684\u5355\u4e2a\u8d26\u53f7\u5b8c\u5168\u514d\u8d39\u3002\u5982\u679c\u67d0\u4e2a\u4f01\u4e1a\u6709\u76f8\u5173\u5b9e\u4f53\u6216\u9644\u5c5e\u673a\u6784\u6301\u6709\u548c\u4f7f\u7528\u591a\u4e2aGFW Pro\u8d26\u53f7\uff0c\u6211\u4eec\u4fdd\u7559\u8981\u6c42\u8fd9\u4e9b\u5b9e\u4f53\u5171\u4eab\u4e00\u4efd\u5e74\u5ea6\u514d\u8d39\u989d\u5ea6\u7684\u6743\u5229\uff0c\u4ee5\u53ca\u4ec5\u5411\u4e00\u4e2a\u4f01\u4e1a\u6307\u5b9a\u8d26\u53f7\u53d1\u653e\u514d\u8d39\u989d\u5ea6\u7684\u6743\u5229\u3002&nbsp;", "775c27108b65d43ac7b743aca79d5e8f": "\u7ba1\u7406\u5458\u53ef\u8bbf\u95ee\u201c\u6211\u7684\u4e2a\u4eba\u8d44\u6599\u201d\uff0c\u7136\u540e\u6253\u5f00\u201d\u4f7f\u7528\u91cf\u201d\u9875\u9762\uff0c\u67e5\u770b\u8d26\u53f7\u66f4\u65b0\u65e5\u671f\u3002\u8bf7\u6ce8\u610f\uff0c\u539f\u6709\u7684GFW Pro\u8d26\u53f7\u66f4\u65b0\u65e5\u671f\u5c06\u8bbe\u7f6e\u4e3a\u201c\u57fa\u4e8e\u6d88\u8017\u7684\u8d39\u7528\u6a21\u5f0f\u201d\u751f\u6548\u65f6\u7684\u6fc0\u6d3b\u65e5\u671f\u3002&nbsp;", "17c33a466c27ad4e52cc9d7887562b34": "\u4e0e\u4fdd\u62a4\u533a\u91cd\u53e0\u7684\u516c\u9877\u6570\u4ee5\u53ca\u5176\u4e2d\u6797\u6728\u690d\u88ab\u635f\u5931\u7684\u516c\u9877\u6570\uff08\u6765\u81ea\u5168\u7403\u68ee\u6797\u53d8\u5316\u5206\u6790\uff09\uff1b&nbsp;", "69086923eb6b603b7f0a7e2528e3ceb4": "\u81ea\u4e0a\u6b21\u5168\u7403\u6797\u6728\u690d\u88ab\u635f\u5931\u62a5\u544a\u4ee5\u6765\u7684\u8b66\u62a5\u6b21\u6570\uff08\u6765\u81ea\u6bc1\u6797\u7efc\u5408\u8b66\u62a5\u5206\u6790\uff09\u3002&nbsp;", "bc3eef81b5f441fd92d8363903587ec9": "\u5728\u4e0e\u4fdd\u62a4\u533a\u91cd\u53e0\u7684\u533a\u57df\u5185\u53d1\u73b0\u6797\u6728\u690d\u88ab\u635f\u5931\uff08\u662f/\u5426\uff09\uff1b&nbsp;", "4950e3fce9c68a02b91e328c73ce222a": "\u622a\u81f32020\u5e74\u5e95\u53d1\u73b0\u81ea\u7136\u68ee\u6797\uff08\u662f/\u5426\uff09\uff1b&nbsp;", "4f651cd9adae2e8236a1f8e3dbe6d315": "VIIRS\u706b\u707e\u8b66\u62a5\u65e0\u6cd5\u68c0\u6d4b\u5230\u89c4\u6a21\u592a\u5c0f\u6216\u6e29\u5ea6\u592a\u4f4e\u7684\u706b\u707e\uff08\u4e00\u822c\u5c0f\u4e8e100\u5e73\u65b9\u7c73\u6216\u6e29\u5ea6\u4f4e\u4e8e700\u5f00\u5c14\u6587\uff09\u3002&nbsp;", "9b27a493f1940644a7ecff2379741105": "GFW Pro\u63d0\u4f9b\u54ea\u4e9b\u8bed\u8a00\u7248\u672c\uff1f", "76c37199444f016caaa5e0066c07dd0e": "\u521b\u5efa \u00b7 1/4", "692841cf1861740771389086d1272ad1": "\u9664\u6e7f\u6da6\u539f\u751f\u6797\u635f\u5931\u5916\uff0c\u603b\u6797\u6728\u8986\u76d6\u635f\u5931\u8fd8\u5305\u62ec\u5e72\u65f1\u548c\u975e\u70ed\u5e26\u539f\u751f\u6797\u3001\u6b21\u751f\u6797\u548c\u4eba\u5de5\u6797\u7684\u635f\u5931\u3002", "72e41b3b6612a68e28de4f337f766163": "\u5730\u56fe\u5bfc\u89c8 \u00b7 3/9", "1dd26f1f1790f0b56d5752fb0fbecef0": "\u8fd4\u56de", "389ec3c8a6d62298cbd9c4b1dc7fc7b2": "\u70b9\u51fb\u5206\u6790\u9009\u9879\u5361\uff0c\u5728\u8fd9\u91cc\u60a8\u53ef\u4ee5\u4e0a\u4f20\u6216\u5728\u5730\u56fe\u4e0a\u7ed8\u5236\u81ea\u5b9a\u4e49\u56fe\u5f62\u3002", "fe69fd0a878b10d190c924b2398bad9c": "\u52a8\u56e0", "504285b80bc64ee975f73798a5e1740c": "\u5e74\u4efd\u8303\u56f4", "503986b075953e1434bc2c7274d24e15": "\u5168\u4e16\u754c\u524d 5 \u540d\u56fd\u5bb6\u5305\u63fd\u4e86 {value} \u7684 {label}\u3002", "64c866fe92d0b76172026dd3187ee570": "\u8981\u7ed8\u5236\u56fe\u5f62\uff0c\u8bf7\u70b9\u51fb\u201c\u7ed8\u5236\u6216\u4e0a\u4f20\u56fe\u5f62\u201d\u9009\u9879\u5361\u5e76\u70b9\u51fb\u201c\u5f00\u59cb\u7ed8\u5236\u201d\u3002\u5728\u5730\u56fe\u4e0a\u70b9\u51fb\uff0c\u79fb\u52a8\u9f20\u6807\uff0c\u7136\u540e\u518d\u6b21\u70b9\u51fb\uff0c\u76f4\u5230\u5f62\u6210\u60a8\u60f3\u8981\u7684\u56fe\u5f62\u3002\u4e00\u65e6\u8fde\u6210\u56fe\u5f62\uff0c\u5c31\u4f1a\u6267\u884c\u5206\u6790\u3002", "ddf9b07b0d951d6c40f8e01993f8eb44": "\u5730\u56fe\u5bfc\u89c8 \u00b7 1/9", "dc550285f0481ff3425a3ca4a26cefc8": "\u5206\u6790\u4e00\u4e2a\u533a\u57df \u00b7 3/3", "6763ec40446319edbbcb2ea06ae969f9": "\u8981\u4e0a\u4f20\u4e00\u4e2a\u56fe\u5f62\uff0c\u70b9\u51fb\u201c\u9009\u62e9\u6587\u4ef6\u201d\u6216\u201c\u5c06\u6587\u4ef6\u62d6\u653e\u81f3\u6b64\u201d\uff0c\u7136\u540e\u9009\u62e9\u60a8\u60f3\u8981\u7684\u56fe\u5f62\u6587\u4ef6\u3002\u4e00\u65e6\u4e0a\u4f20\uff0c\u8be5\u56fe\u5f62\u5c31\u4f1a\u51fa\u73b0\u5728\u5730\u56fe\u4e0a\uff0c\u968f\u4e4b\u5c31\u4f1a\u6267\u884c\u5206\u6790\u3002", "7e5db72d88c367e2caee3677c123b48c": "GFW Pro \u6e90\u81ea\u6211\u4eec\u4e0e\u9886\u5148\u7684\u91d1\u878d\u548c\u5927\u5b97\u5546\u54c1\u516c\u53f8\u7684\u5408\u4f5c\uff0c \u4e8e 2019 \u5e74\u53d1\u5e03\u4e0a\u7ebf\uff0c\u65e8\u5728\u5e2e\u52a9\u4f01\u4e1a\u7ba1\u7406\u5176\u4f9b\u5e94\u94fe\u4e2d\u5b58\u5728\u7684\u68ee\u6797\u780d\u4f10\u98ce\u9669\u3002\u540c\u65f6\u8fd8\u52a0\u5165\u4e86\u9ad8\u5206\u8fa8\u7387\u7684 Planet \u57fa\u51c6\u5730\u56fe\u300182 \u4e2a\u56fd\u5bb6\u7684\u4eba\u5de5\u6797\u6570\u636e\u548c\u6cdb\u70ed\u5e26\u539f\u751f\u6797\u6570\u636e\uff0c\u4e3a\u7528\u6237\u901a\u8fc7 GFW \u5730\u56fe\u4e86\u89e3\u68ee\u6797\u53d8\u5316\u63d0\u4f9b\u4e86\u65b0\u7684\u9014\u5f84\u3002", "ba8aa91070aa258b6aecd6c308cc0ec3": "\u5206\u6790\u4e00\u4e2a\u533a\u57df \u00b7 1/3", "0bc12a6054183a578e376ca86afc47ce": "\u5bf9\u4e8e\u4e00\u952e\u5f0f\u5206\u6790\uff0c\u9996\u5148\u9009\u62e9\u60a8\u60f3\u8981\u7684\u5730\u56fe\u8fb9\u754c\uff08\u653f\u6cbb\u8fb9\u754c\u3001\u6cb3\u6d41\u6d41\u57df\u3001\u751f\u6001\u533a\u57df\uff09\u3002\u7136\u540e\u70b9\u51fb\u5730\u56fe\u4e0a\u7684\u4e00\u4e2a\u56fe\u5f62\uff0c\u968f\u4e4b\u5c31\u4f1a\u6267\u884c\u5206\u6790\u3002", "9882c4a0b2db47c676cf01657053a13d": "\u4e3a\u4e86\u5e94\u5bf9\u4e0e\u68ee\u6797\u780d\u4f10\u76f8\u5173\u7684\u8bf8\u591a\u6311\u6218\uff0cGlobal Forest Watch \u5f00\u59cb\u6269\u5c55\u5f00\u53d1\u4e86\u51e0\u4e2a\u65b0\u7684\u7f51\u9875\u5e94\u7528\uff1aGFW Commodities\uff0c\u7528\u4e8e\u8bc4\u4f30\u5546\u54c1\u4f9b\u5e94\u94fe\u7684\u53ef\u6301\u7eed\u6027\uff1bGFW Fires\uff0c\u7528\u4e8e\u76d1\u63a7\u4e1c\u5357\u4e9a\u7684\u68ee\u6797\u548c\u571f\u5730\u706b\u707e\u548c\u70df\u96fe", "66d161dfb14712e2972fa83bcb0ce3a4": "\u521b\u5efa\u4e00\u4e2a\u5173\u6ce8\u533a\u57df \u00b7 3/4", "7c31940f2000580a03e484128ee36b5e": "\u65e0\u641c\u7d22\u7ed3\u679c\u3002", "33f0bc56aaa9c705a4e4c9c087b849d1": "\u5728 {location}\uff0c{latestYear} \u5230\u76ee\u524d\u4e3a\u6b62\u5171\u6709 {count} \u6b21 {dataset} \u706b\u707e\u8b66\u62a5\uff08\u4ec5\u8003\u8651<b>high confidence alerts</b>\uff09\u3002\u76f8\u8f83\u81ea {dataset_start_year} \u4ee5\u6765\u7684\u8fd9\u4e9b\u5e74\uff0c\u8fd9\u4e2a\u603b\u6570\u76f8\u5bf9\u504f {status}\u3002\u706b\u707e\u8bb0\u5f55\u6700\u591a\u7684\u4e00\u5e74\u662f {maxYear}\uff0c\u5171\u8ba1 {maxTotal} \u6b21\u3002", "1038af83c180a8a16996511f83ee077d": "Global Forest Watch Climate \u7f51\u7ad9\u4e0d\u518d\u53ef\u7528\u3002\u6211\u4eec\u5e0c\u671b\u60a8\u80fd\u591f\u5728\u8fd9\u91cc\u627e\u5230\u60a8\u8981\u627e\u7684\u6570\u636e\u548c\u4fe1\u606f\u3002\u5982\u679c\u6ca1\u627e\u5230\uff0c\u8bf7<a href=\"{{0}}\">\u8054\u7cfb\u6211\u4eec</a>\uff0c\u6211\u4eec\u4e50\u4e8e\u4e3a\u60a8\u63d0\u4f9b\u5e2e\u52a9