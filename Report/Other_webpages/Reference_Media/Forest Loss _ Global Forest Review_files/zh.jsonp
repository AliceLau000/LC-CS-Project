u3002&nbsp;", "d6e56a2bf44b83fc4e8597970de5dd2f": "2026\u5e74\u5ea6\u8d44\u52a9\u5468\u671f\u7684\u7533\u8bf7\u53d7\u7406\u65f6\u95f4\u4e3a2026\u5e741\u670819\u65e5\u81f32\u67086\u65e5\u3002 <a href=\"{{0}}\">\u5728\u6b64\u7533\u8bf7</a>\u3002", "23ccf666bd81c93a152b685b37ff5af2": "\u67e5\u770b\u3001\u6fc0\u6d3b\u548c\u505c\u7528\u8d35\u7ec4\u7ec7\u8d26\u53f7\u4e2d\u7684\u7528\u6237\u3002&nbsp;", "c62e66a0ab48fbf17268b94d9555c8a6": "\u4fee\u590d\u51e0\u4f55\u56fe\u5f62\u9519\u8bef&nbsp;", "4c07bd9eeadaabe0926a2eec18b5eeb0": "Analysis_R\uff08\u534a\u5f84\u503c\uff0c\u5355\u4f4d\u4e3aKM\uff09*&nbsp;", "d81b03c9ccf85f83f69987b2b2e10c94": "\u9075\u7167GFW Pro\u6a21\u677f&nbsp;", "6d504c97ba6a8baba4145231fed9b37f": "\u60a8\u53ef\u901a\u8fc7\u4ee5\u4e0b\u94fe\u63a5\u4e0b\u8f7dPDF\u7533\u8bf7\u8868\u8fdb\u884c\u586b\u5199\u3002<strong>\u8bf7\u6ce8\u610f\uff0c\u60a8\u5fc5\u987b\u901a\u8fc7\u4e0a\u8ff0\u94fe\u63a5\u63d0\u4f9b\u7684\u5b98\u65b9\u5728\u7ebf\u95e8\u6237\u63d0\u4ea4\u7533\u8bf7\u3002\u6211\u4eec\u4e0d\u63a5\u53d7\u901a\u8fc7\u7535\u5b50\u90ae\u4ef6\u6216\u9644\u4ef6\u63d0\u4ea4\u7684\u7533\u8bf7\u3002</strong>", "ecd3b8046f4509564d92c079b83c78eb": "\u201c\u6dfb\u52a0\u4f4d\u7f6e\u201d\u6309\u94ae\u4f4d\u4e8e\u53f3\u4e0a\u89d2\uff0c\u4e2a\u4eba\u8d44\u6599\u56fe\u6807\u4e0b\u65b9\u3002", "54efc4c80062cbdb4a2b4d688c7b786d": "\u9009\u62e9\u4e0a\u4f20\u60a8\u7684\u6587\u4ef6\u3001\u70b9\u6216\u591a\u8fb9\u5f62\u4f4d\u7f6e\u4ee5\u4f9b\u5206\u6790\u3002", "6efb1ff8b83667e1a37b7837ee3a2658": "\u5728\u65b0\u754c\u9762\u4e2d\uff0c\u60a8\u5c06\u770b\u5230\u7eff\u8272\u7684\u201c\u6570\u636e\u6a21\u677f\u201d\u6309\u94ae\u3002&nbsp;", "7f08f94f211d64c30b1c5cab45f3e659": "\u70b9\u51fb\u6309\u94ae\u540e\uff0c\u5c06\u6253\u5f00\u5f39\u51fa\u5f0f\u7a97\u53e3\uff0c\u663e\u793a\u60a8\u53ef\u4ee5\u4e0b\u8f7d\u7684\u4e0d\u540c\u6a21\u677f\u3002\u6b64\u5916\uff0c\u5728\u6bcf\u4e2a\u9009\u9879\u4e2d\uff0c\u60a8\u90fd\u5c06\u770b\u5230\u7b80\u77ed\u8bf4\u660e\uff0c\u4ecb\u7ecd\u6a21\u677f\u7684\u6700\u4f73\u7528\u9014\u53ca\u6a21\u677f\u4e2d\u7684\u6240\u9700\u5b57\u6bb5\u3002\u60a8\u53ef\u4ee5\u4f7f\u7528\u8fd9\u4e9b\u4fe1\u606f\u786e\u5b9a\u8981\u4e0b\u8f7d\u7684\u6a21\u677f\uff1b\u7136\u540e\uff0c\u8bf7\u70b9\u51fb\u60a8\u6240\u9009\u6a21\u677f\u7c7b\u578b\u65c1\u8fb9\u7684\u201c\u4e0b\u8f7d\u201d\u6309\u94ae\u3002&nbsp;", "3e915582ad8fd139a6ba5e20570c8a8d": "\u5982\u9700\u66f4\u591a\u5173\u4e8e\u9009\u62e9\u6a21\u677f\u7684\u4fe1\u606f\uff0c\u8bf7\u8bbf\u95ee\u4ee5\u4e0b<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u94fe\u63a5</a>\u3002&nbsp;", "493b9ae092b484b05258069c1958b16b": "<em>\u793a\u4f8b\uff1a</em><em>\u591a\u8fb9\u5f62shapefile\u6a21\u677f\u4fe1\u606f\u5f39\u7a97\u548c\u4e0b\u8f7d\u6309\u94ae</em>\u7684\u9884\u89c8\u3002&nbsp;", "a8fe6b3cd5709e3b34422ec18e5ab016": "\u5b8c\u6210\u7535\u5b50\u8868\u683c\u6a21\u677f", "9a7893f40f955138cf219c76e1457fb4": "\u6253\u5f00\u5df2\u4e0b\u8f7d\u7684Excel\u7535\u5b50\u8868\u683c\u6a21\u677f\u3002", "2a882c9e88edd44ad78b4cc0f52d65c7": "\u60a8\u53ef\u4ee5\u5728\u201c\u6dfb\u52a0\u4f4d\u7f6e\u201d\u5de5\u4f5c\u6d41\u4e2d\u6d4f\u89c8\u548c\u4e0b\u8f7dGFW Pro\u6570\u636e\u6a21\u677f\u3002\u5982\u9700\u8bbf\u95eeGFW Pro\u6a21\u677f\uff1a&nbsp;", "eb6f2802dab0e55ee954b5ceeb85c840": "\u70b9\u51fb\u201c+\u6dfb\u52a0\u4f4d\u7f6e\u201d\u6309\u94ae&nbsp;", "4c54d32a5ad65e13d6dee8e617ff41f2": "\u9605\u8bfb2026\u5e74\u7533\u8bf7\u4eba\u6307\u5357", "8d415094d490d214ffd1ed3079c42cc4": "\u60a8\u8981\u5904\u7406\u54ea\u7c7b\u7a7a\u95f4\u6570\u636e\uff1f \u9700\u8981\u8003\u8651\u7684\u4e3b\u8981\u533a\u522b\u662f\uff0c\u60a8\u662f\u5728\u5904\u7406\u591a\u8fb9\u51e0\u4f55\u56fe\u5f62\uff0c\u8fd8\u662f\u5728\u5904\u7406\u5750\u6807\u70b9\u548c\u534a\u5f84\u3002&nbsp;", "b9f7b8238635d3e45256878e6c419c6c": "\u5c06GFW Pro\u7684\u5206\u6790\u7ed3\u679c\uff0c\u76f4\u63a5\u6574\u5408\u5230\u4e13\u6709\u7684\u4f9b\u5e94\u94fe\u53ef\u8ffd\u6eaf\u6027\u548c\u98ce\u9669\u91cf\u5316\u5e73\u53f0\u4e0e\u670d\u52a1\u4e2d\u3002", "6a5ed839cf8fbb6b4a8b88dcacb75657": "\u6211\u53ef\u4ee5\u5220\u9664\u7ec4\u7ec7\u8d26\u6237\u4e2d\u7684\u4eba\u5458\u5417\uff1f", "099af53f601532dbd31e0ea99ffdeb64": "\u5220\u9664", "3dbcfed4859082dc9efc868db9537f04": "\u8be5\u7528\u6237\uff0c\u8bf7\u4f7f\u7528\u6b64\u8868\u683c", "fe50b2ac1f5416eec871e9b6d4f9ea07": "\u6709\u51732026\u5e74\u8d44\u52a9\u5468\u671f\u7684\u4fe1\u606f\uff0c <span class=\"TextRun Highlight SCXW8393622 BCX0\" lang=\"EN-US\" xml:lang=\"EN-US\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW8393622 BCX0\">\u8bf7 </span><span class=\"NormalTextRun SCXW8393622 BCX0\">\u8bf7\u5ba1\u9605\u4ee5\u4e0b\u6750\u6599\u5e76 </span><span class=\"NormalTextRun SCXW8393622 BCX0\">\u786e\u5b9a</span><span class=\"NormalTextRun SCXW8393622 BCX0\"> \u60a8\u7684\u8d44\u683c</span><span class=\"NormalTextRun SCXW8393622 BCX0\">.</span><span class=\"NormalTextRun SCXW8393622 BCX0\"> \u51c6\u5907\u5c31\u7eea\u540e\uff0c\u60a8\u5c31\u53ef\u4ee5 <a href=\"{{0}}\">\u5728\u6b64\u7533\u8bf7</a>.</span></span>", "9e2e9cee7b8c5ea7372acc2338e2a027": "\u6ce8\u518c<span class=\"TextRun Highlight SCXW209807347 BCX0\" lang=\"EN-US\" xml:lang=\"EN-US\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW209807347 BCX0\"> </span><span class=\"NormalTextRun SCXW209807347 BCX0\">202</span><span class=\"NormalTextRun SCXW209807347 BCX0\">6</span><span class=\"NormalTextRun SCXW209807347 BCX0\"> \u5c0f\u989d\u8d44\u52a9\u57fa\u91d1\u7533\u8bf7\u4eba\u7f51\u7edc\u7814\u8ba8\u4f1a\u5c06\u4e8e </span></span><strong><span class=\"TextRun Highlight SCXW209807347 BCX0\" lang=\"EN-US\" xml:lang=\"EN-US\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW209807347 BCX0\">1\u670827\u65e5</span><span class=\"NormalTextRun SCXW209807347 BCX0\"> \u7f8e\u56fd\u4e1c\u90e8\u65f6\u95f4\u4e0a\u53489:00</span></span></strong>", "566878ef9bed0f1c6712538f5059c87b": "GFW Pro 2020 \u5e74\u540e\u98ce\u9669\u8bc4\u4f30\u7535\u5b50\u7b7e\u540d\uff08\u4ec5\u9650 API\uff09\u3002", "0a2bd2b2c25da77c09bf92d888d3af34": "\u4e3a\u516c\u5f00\u62a5\u9053\u3001\u76d1\u7ba1\u5408\u89c4\u3001\u6eaf\u6e90\u4f53\u7cfb\u548c\u6295\u8d44\u8005\u98ce\u9669\u8bc4\u4f30\u7b49\u6d3b\u52a8\u63d0\u4f9b\u4e86\u53ef\u9760\u53ef\u4fe1\u7684\u8bc1\u636e\u6765\u6e90\u3002", "3c0816607f824b4e08933940af1f6741": "GFW Pro \u652f\u6301\u5f3a\u5236\u6027\u62ab\u9732\u548c\u81ea\u613f\u62ab\u9732\uff0c\u91c7\u7528\u7684\u540c\u884c\u8bc4\u5ba1\u65b9\u6cd5\u53ca\u6307\u6807\u7b26\u5408\u73b0\u6709\u6846\u67b6\u3001\u56fd\u9645\u6807\u51c6\u548c\u300a\u6b27\u76df\u96f6\u6bc1\u6797\u6cd5\u6848\u300b(EUDR) \u7b49\u5173\u952e\u6cd5\u89c4\u8981\u6c42&nbsp;", "6c720125d1f882e03f5b1751b24e781d": "(WRI) \u5df2\u4e0e\u5904\u5728\u53ef\u6301\u7eed\u53d1\u5c55\u524d\u6cbf\u7684\u516c\u53f8\u548c\u91d1\u878d\u673a\u6784\u5408\u4f5c\uff0c\u65e8\u5728\u7814\u7a76 GFW \u53ef\u5982\u4f55\u652f\u6301\u96f6\u6bc1\u6797\u627f\u8bfa\u7684\u843d\u5730\u5b9e\u65bd\uff0c\u5e76\u63a8\u52a8\u5927\u5b97\u5546\u54c1\u7684\u53ef\u6301\u7eed\u751f\u4ea7\u548c\u8d38\u6613\u3002", "0fc28fa9eb41b5b9cbff13f0a666f7fa": "\u5982\u679c\u60a8\u7684\u7a7a\u95f4\u6570\u636e\u5b58\u50a8\u5728\u6587\u4ef6\u4e2d\uff0c\u6211\u4eec\u5efa\u8bae\u60a8\u91c7\u7528\u57fa\u4e8e\u6587\u4ef6\u7684\u4e0a\u4f20\u5de5\u4f5c\u6d41\u5b8c\u6210\u6570\u636e\u4e0a\u4f20\u3002\u652f\u6301\u7684\u6587\u4ef6\u5927\u5c0f\u53ef\u6db5\u76d6\u4ece\u5355\u4e00\u4f4d\u7f6e\u81f3\u5230 150,000 \u4e2a\u4f4d\u7f6e\u7684\u6570\u636e\u91cf\uff0c\u5e76\u4e14\u5e73\u53f0\u53ef\u4ee5\u5904\u7406\u7535\u5b50\u8868\u683c\u3001shapefile \u548c KML \u6587\u4ef6\u3002\u8981\u4ee5\u6587\u4ef6\u5f62\u5f0f\u4e0a\u4f20\u6570\u636e\uff0c\u8bf7\u6309\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a&nbsp;", "fe0cb2b34f8df924edf24b0b272af916": "3. \u5728\u6b64\u89c6\u56fe\u4e2d\uff0c\u60a8\u5c06\u770b\u5230\u5f53\u524d\u7ec4\u7ec7\u7684\u8d26\u6237\u4f7f\u7528\u60c5\u51b5\u6458\u8981\uff0c\u5305\u62ec\u5206\u6790\u6b21\u6570\u548c\u6bcf\u516c\u9877\u5206\u6790\u9762\u79ef<a>\u3002&nbsp;</a>\u6b64\u5916\uff0c\u60a8\u8fd8\u53ef\u4ee5\u67e5\u770b\u6309\u7528\u6237\u5212\u5206\u7684\u8d26\u6237\u4f7f\u7528\u60c5\u51b5\u660e\u7ec6\uff0c\u4ece\u800c\u4e86\u89e3\u6bcf\u4f4d\u7528\u6237\u5bf9\u7ec4\u7ec7\u603b\u4f7f\u7528\u91cf\u7684\u6570\u503c\u8d21\u732e\u548c\u5360\u6bd4\u3002\u5982\u9700<a>\u8be6\u7ec6\u4e86\u89e3</a><a href=\"{{0}}\">\u4f7f\u7528\u91cf\u9650\u5236\u548c\u8d39\u7528\uff0c\u8bf7\u70b9\u51fb\u6b64\u5904</a>\u3002\u5982\u9700\u7533\u8bf7\u66f4\u591a\u4f7f\u7528\u91cf\u5e76\u8be6\u7ec6\u4e86\u89e3\u6211\u4eec\u63d0\u4f9b\u7684\u5957\u9910\uff0c\u8bf7\u8054\u7cfb <a href=\"{{1}}\">gfwsales@wri.org</a>\u3002", "9c822b40907c16f9649ff2d729337b7d": "\u8981\u7ba1\u7406\u4f4d\u7f6e\u548c\u5217\u8868\uff0c\u8bf7\u70b9\u51fb\u9876\u90e8\u83dc\u5355\u4e0a\u7684\u201c\u4f4d\u7f6e\u201d\u9009\u9879\u5361\u3002\u201c\u4f4d\u7f6e\u201d\u9875\u9762\u4f1a\u663e\u793a GFW \u7ba1\u7406\u7684\u4f4d\u7f6e\u5217\u8868\u4ee5\u53ca\u60a8\u4e0a\u4f20\u7684\u6240\u6709\u5217\u8868\uff0c\u5305\u62ec\u5c1a\u672a\u63d0\u4ea4\u8fdb\u884c\u5206\u6790\u7684\u5217\u8868\u3002\u5728\u5de6\u4fa7\uff0c\u60a8\u53ef\u4ee5\u4e0a\u4f20\u65b0\u4f4d\u7f6e\u5e76\u521b\u5efa\u5217\u8868\u3002\u5982\u679c\u60a8\u6253\u7b97\u6dfb\u52a0\u3001\u5220\u9664\u6216\u79fb\u52a8\u4e00\u4e2a\u6216\u591a\u4e2a\u4f4d\u7f6e\uff0c\u8bf7\u4fdd\u5b58\u539f\u59cb\u5217\u8868\u7684\u526f\u672c\u4ee5\u4f5c\u8bb0\u5f55\u3002&nbsp;", "37b33d072626f9ba7e9a898a5335c070": "\u901a\u8fc7\u6587\u4ef6\u4e0a\u4f20\u6dfb\u52a0\u4e00\u4e2a\u6216\u591a\u4e2a\u4f4d\u7f6e&nbsp;", "86996111a814542bfce00546d6851851": "\u82e5\u8be5\u7ec4\u7ec7\u6ca1\u6709\u5176\u4ed6\u6d3b\u8dc3\u7684\u8d26\u6237\u7ba1\u7406\u5458\uff0c\u5219\u5728\u65b0\u589e\u4e00\u540d\u7ba1\u7406\u5458\u4e4b\u524d\uff0c\u65e0\u6cd5\u7ee7\u7eed\u6267\u884c\u8d26\u6237\u505c\u7528\u64cd\u4f5c\u3002", "d122585d4c2c3170e4a1f903f29bddc3": "\u5728 GFW Pro\uff08\u4e13\u4e1a\u7248\uff09\u4e2d\uff0c\u60a8\u53ef\u4ee5\u6dfb\u52a0\u548c\u521b\u5efa\u60a8\u60f3\u8981\u6301\u7eed\u76d1\u63a7\u6216\u5206\u6790\u7684\u4f4d\u7f6e\u5217\u8868\u3002\u60a8\u53ef\u4ee5\u901a\u8fc7\u591a\u79cd\u65b9\u5f0f\u6dfb\u52a0\u4f4d\u7f6e\u3002\u8bf7\u53c2\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff0c\u5b66\u4e60\u5982\u4f55\u501f\u52a9\u6211\u4eec\u7684\u4ea4\u4e92\u5f0f\u5de5\u4f5c\u6d41\u7a0b\u5728 GFW Pro \u5e73\u53f0\u4e0a\u521b\u5efa\u4f4d\u7f6e\uff0c\u6216\u8005\u5c06\u5305\u542b\u4f4d\u7f6e\u4fe1\u606f\u7684\u6587\u4ef6\u4e0a\u4f20\u81f3\u7cfb\u7edf\u3002&nbsp;", "d1691b557924dabb62a5007065a062f0": "\u60a8\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u201c\u6570\u636e\u6a21\u677f\u201d\u6309\u94ae\u6765\u63a2\u7d22 GFW Pro \u53ef\u5904\u7406\u7684\u4e0d\u540c\u6587\u4ef6\u7c7b\u578b\uff0c\u5e76\u67e5\u770b\u6bcf\u79cd\u7c7b\u578b\u7684\u683c\u5f0f\u8981\u6c42\u3002\u51c6\u5907\u4e0a\u4f20\u6587\u4ef6\u65f6\uff0c\u70b9\u51fb\u6587\u4ef6\u5939\u56fe\u6807\u5373\u53ef\u8bbf\u95ee\u60a8\u7535\u8111\u7684\u6587\u4ef6\u8d44\u6e90\u7ba1\u7406\u5668\uff0c\u60a8\u4e5f\u53ef\u4ee5\u76f4\u63a5\u5c06\u6240\u9700\u6587\u4ef6\u62d6\u653e\u5230\u6846\u4e2d\u3002\u4e0a\u4f20\u540e\uff0c\u5e73\u53f0\u5c06\u9a8c\u8bc1\u60a8\u7684\u6587\u4ef6\u7c7b\u578b\u662f\u5426\u6709\u6548\uff0c\u5e76\u5728\u51fa\u73b0\u9519\u8bef\u65f6\u63d0\u9192\u60a8\u3002\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\u6309\u94ae\u7ee7\u7eed\u9884\u89c8\u6570\u636e\u3002&nbsp;&nbsp;", "c30dfa8668d44a40e4625baae6ef4752": "GFW Pro \u5c06\u751f\u6210\u6570\u636e\u6587\u4ef6\u524d\u5341\u884c\u7684\u9884\u89c8\uff0c\u4ee5\u4fbf\u60a8\u786e\u8ba4\u6240\u6709\u9644\u52a0\u5c5e\u6027\u5217\u5747\u5df2\u6b63\u786e\u5b9a\u4e49\u3002\u9884\u89c8\u671f\u95f4\uff0c\u5e73\u53f0\u8fd8\u4f1a\u9a8c\u8bc1\u60a8\u7684\u6587\u4ef6\u662f\u5426\u5305\u542b\u6240\u6709\u6b64\u6587\u4ef6\u7c7b\u578b\u89c4\u5b9a\u7684\u5fc5\u586b\u5217\uff0c\u5e76\u5728\u7f3a\u5c11\u5fc5\u586b\u5217\u65f6\u901a\u77e5\u60a8\u3002\u5982\u679c\u7f3a\u5c11\u5fc5\u586b\u5b57\u6bb5\uff0c\u8bf7\u79bb\u7ebf\u66f4\u6b63\u6587\u4ef6\uff0c\u7136\u540e\u518d\u91cd\u65b0\u4e0a\u4f20\u3002&nbsp;", "e3da064291e43f470829d1cfd7a89936": "\u4e0a\u4f20\u5217\u8868\u7684\u65b0\u89c6\u56fe\u9884\u89c8\uff08\u6700\u591a\u9884\u89c8 10 \u884c\uff09\u3002", "4155a83efe9a00fb3880ec540fa0831b": "\u5bfc\u822a\u5230\u201c\u4f4d\u7f6e\u201d\u9875\u9762\uff0c\u7136\u540e\u70b9\u51fb\u5de6\u4fa7\u7684\u201c+ \u6dfb\u52a0\u4f4d\u7f6e\u201d\u3002\u968f\u5373\u6253\u5f00\u7684\u4e0a\u4f20\u6a21\u5757\u4e2d\u5305\u542b\u4e09\u4e2a\u4e0a\u4f20\u9009\u9879\uff1a\u6587\u4ef6\u4e0a\u4f20\u3001\u70b9\u4e0a\u4f20\u548c\u591a\u8fb9\u5f62\u533a\u57df\u4e0a\u4f20\u3002\u5728\u672c\u4f8b\u4e2d\uff0c\u8bf7\u9009\u62e9\u201c\u6587\u4ef6\u4e0a\u4f20\u201d\uff0c\u7cfb\u7edf\u5c06\u5f15\u5bfc\u60a8\u8fdb\u5165\u57fa\u4e8e\u6587\u4ef6\u7684\u4e0a\u4f20\u5de5\u4f5c\u6d41\u3002&nbsp;", "31d9655aeb8f9675c1471b828b89c003": "<img src=\"{{0}}\" class=\"css-4g6ai3 e1i5xcrv0\"><em>\u4f4d\u7f6e\u4e0a\u4f20\u65b9\u5f0f\u9009\u62e9\u754c\u9762\u3002\u9009\u62e9\u201c\u6587\u4ef6\u4e0a\u4f20\u201d</em>\u3002&nbsp;", "6a94e89416817aa9fe8b629a3fa4a6e2": "\u63d0\u4ea4\u5206\u6790\u4e4b\u524d\u914d\u7f6e\u4e0a\u4f20\u5217\u8868\u7684\u754c\u9762\u3002", "5719d7575986935f11d6328e29437027": "<em>\u9009\u62e9\u201c\u8f93\u5165\u5730\u5740\u201d\u65f6\u9700\u8981\u586b\u5199\u7684\u5b57\u6bb5</em>\u3002&nbsp;", "cd4fa2c8d723860c484073552dc814ca": "\u8981\u5728\u60a8\u7684\u8d26\u6237\u4e2d\u542f\u7528 API \u8bbf\u95ee\u6743\u9650\uff0c\u9700\u8981\u83b7\u5f97 GFW Pro \u56e2\u961f\u7684\u6279\u51c6\u3002\u6388\u4e88\u8bbf\u95ee\u6743\u9650\u540e\uff0c\u7ec4\u7ec7\u7684\u8d26\u6237\u7ba1\u7406\u5458\u5c06\u5728\u4e2a\u4eba\u8d44\u6599\u4e2d\u770b\u5230\u4e24\u4e2a\u65b0\u677f\u5757\uff1a\u201cAPI \u5bc6\u94a5\u201d\u548c\u201cAPI \u6587\u6863\u201d\u3002", "602c610c87680ae26c364d01f74e1822": "API \u6587\u6863\u9875\u9762\u5305\u542b OpenAPI \u89c4\u8303 (OAS) \u548c Swagger API \u6587\u6863\u3002\u6b64\u8d44\u6e90\u63d0\u4f9b\u4e86\u6709\u5173 API \u7aef\u70b9\u4ee5\u53ca\u60a8\u5728\u4e0d\u540c\u573a\u666f\u4e0b\u53ef\u80fd\u6536\u5230\u7684\u54cd\u5e94\uff08\u5305\u62ec\u9519\u8bef\uff09\u7684\u66f4\u8be6\u7ec6\u6587\u6863\u3002\u8fd9\u65e8\u5728\u4f5c\u4e3a\u6211\u4eec\u4e3b\u8981 <a href=\"{{0}}\">API \u6587\u6863</a>\u7684\u8865\u5145\u3002", "3410035ad4473fa57730643d6a55a5ca": "\u5982\u9700\u54a8\u8be2\u6709\u5173\u4f7f\u7528\u3001\u5b9a\u4ef7\u3001\u8bb8\u53ef\u6216\u57fa\u4e8e API \u7684\u8bbf\u95ee\u6743\u9650\u7b49\u95ee\u9898\uff0c\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3 <a href=\"{{0}}\">gfwprosales@wri.org</a>\u3002", "1810b0419836f23d295a9a1d99dcd7d5": "\u5728 GFW Pro \u4e2d\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u5b9a\u4e49\u4e00\u4e2a\u70b9\u53ca\u5176\u5468\u8fb9\u7684\u5206\u6790\u534a\u5f84\u6765\u521b\u5efa\u8981\u5206\u6790\u7684\u4f4d\u7f6e\u3002", "2094e191cf8e90e625afdc51e61bf882": "\u7cfb\u7edf\u5c06\u63d0\u793a\u60a8\u4e3a\u8981\u4e0a\u4f20\u7684\u4f4d\u7f6e\u6307\u5b9a\u540d\u79f0\u3002\u8f93\u5165\u5185\u5bb9\u4ec5\u53ef\u5305\u542b\u5b57\u6bcd\u3001\u6570\u5b57\u4ee5\u53ca\u4ee5\u4e0b\u7279\u6b8a\u5b57\u7b26\uff1a[]().-_\u3002\u82e5\u540d\u79f0\u4e2d\u542b\u6709\u5176\u4ed6\u7279\u6b8a\u5b57\u7b26\uff0c\u8fd9\u4e9b\u5b57\u7b26\u4f1a\u5728\u5904\u7406\u8fc7\u7a0b\u4e2d\u88ab\u81ea\u52a8\u79fb\u9664\u3002&nbsp;\u53e6\u5916\uff0c\u8bf7\u6ce8\u610f\uff0c\u8f93\u5165\u5185\u5bb9\u957f\u5ea6\u5fc5\u987b\u5c0f\u4e8e 63 \u4e2a\u5b57\u7b26\u3002\u82e5\u5b57\u7b26\u4e32\u957f\u5ea6\u8d85\u51fa\u9650\u5236\uff0c\u5219\u5c06\u88ab\u622a\u65ad\u4ee5\u7b26\u5408\u89c4\u5b9a\u3002&nbsp;", "74b54b21439c0f8eb3cd76170194e408": "\u70b9\u5de5\u4f5c\u6d41\u4e3a\u7528\u6237\u63d0\u4f9b\u4e86\u4e24\u79cd\u65b9\u5f0f\u6765\u5b9a\u4e49\u70b9\u548c\u534a\u5f84\uff1a&nbsp;", "68a3ae2a5baabef03cdeb8e630e1097a": "a. \u8f93\u5165\u5750\u6807&nbsp;", "97bf0cd02c50f23316c471d510fca5a8": "\u4ee5\u5341\u8fdb\u5236\u5f62\u5f0f\u8f93\u5165\u70b9\u7684\u7eac\u5ea6\u548c\u7ecf\u5ea6\u503c&nbsp;", "f68d6562dfce90ce13f01b0cb095b888": "\u7136\u540e\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\u201d&nbsp;", "3ca10e0dcb5f7429425d643362669b98": "b. \u8f93\u5165\u5730\u5740&nbsp;", "b45259f3c0047dde140cc67d62b1b802": "\u663e\u793a\u56e0\u7f3a\u5c11\u5fc5\u586b\u5b57\u6bb5\u800c\u63d0\u793a\u6587\u4ef6\u9519\u8bef\u7684\u754c\u9762", "086af475363fe924e1f0416731de1e55": "\u9009\u62e9\u201c\u4e0a\u4f20\u6587\u4ef6\u201d\u540e\uff0c\u4f1a\u663e\u793a\u4e00\u4e2a\u65b0\u7a97\u53e3\u3002\u9009\u62e9\u6216\u62d6\u653e\u683c\u5f0f\u5316\u7684\u6587\u4ef6\u8fdb\u884c\u4e0a\u4f20\u3002", "1a1f83cb45e5c5b4f0dafd697f119409": "\u4e0a\u4f20\u6210\u529f\u540e\uff0c\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\uff0c\u7cfb\u7edf\u5c06\u5f15\u5bfc\u60a8\u6765\u5230\u7b2c\u4e09\u6b65\u201c\u914d\u7f6e\u5217\u8868\u201d\u3002&nbsp;&nbsp;", "f088ef5dd4e9c87a52baf79a262dfb6e": "\u5728\u6b64\u90e8\u5206\uff0c\u8bf7\u9009\u62e9\u6700\u9002\u7528\u4e8e\u60a8\u6570\u636e\u7684\u201c\u5546\u54c1\u201d\u503c\u3002\u60a8\u4e5f\u53ef\u4ee5\u901a\u8fc7\u9009\u62e9\u201c\u5176\u4ed6\u201d\u9009\u9879\u5e76\u8f93\u5165\u6587\u672c\u503c\u6765\u6307\u5b9a\u81ea\u5b9a\u4e49\u5546\u54c1\u503c\u3002&nbsp;", "2325147a296bb16a6b26cf667d56ad00": "\u60a8\u53ef\u4ee5\u8f93\u5165\u5217\u8868\u540d\u79f0\u6765\u4e3a\u4e0a\u4f20\u7684\u6570\u636e\u521b\u5efa\u65b0\u5217\u8868\uff0c\u6216\u8005\uff0c\u60a8\u4e5f\u53ef\u4ee5\u5c06\u4e0a\u4f20\u7684\u4f4d\u7f6e\u6dfb\u52a0\u5230\u60a8\u8d26\u6237\u4e2d\u73b0\u6709\u7684\u5217\u8868\u4e2d\uff0c\u53ea\u9700\u4ece\u4e0b\u62c9\u83dc\u5355\u4e2d\u9009\u62e9\u5373\u53ef\u3002\u8bf7\u6ce8\u610f\uff0c\u60a8\u53ea\u80fd\u5c06\u4f4d\u7f6e\u6dfb\u52a0\u5230\u4e0e\u60a8\u5b9a\u4e49\u7684\u5546\u54c1\u76f8\u5339\u914d\u7684\u5217\u8868\u4e2d\u3002&nbsp;", "3e42f18f3a220eb572009f2e63c95df5": "\u9009\u62e9\u60a8\u60f3\u8981\u5e94\u7528\u5230\u5217\u8868\u7684\u5206\u6790\uff0c\u7136\u540e\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\u3002&nbsp;", "df462b0f247eeadc8d9d9113b4177737": "\u5728\u7b2c\u56db\u6b65\u4e2d\uff0c\u7cfb\u7edf\u4f1a\u663e\u793a\u4e00\u4e2a\u65b0\u754c\u9762\uff0c\u60a8\u53ef\u4ee5\u6838\u5bf9\u5df2\u8f93\u5165\u7684\u5217\u8868\u540d\u79f0\u548c\u6240\u9009\u7684\u5206\u6790\u7c7b\u578b\u3002\u60a8\u53ef\u4ee5\u70b9\u51fb\u201c\u53d6\u6d88\u201d\u6309\u94ae\u53d6\u6d88\u4e0a\u4f20\uff0c\u6216\u70b9\u51fb\u201c\u8fd4\u56de\u201d\u4fee\u6539\u63d0\u4f9b\u7684\u4fe1\u606f\u3002\u5982\u679c\u60a8\u786e\u8ba4\u663e\u793a\u7684\u4fe1\u606f\u65e0\u8bef\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u201c\u4fdd\u5b58\u4e3a\u8349\u7a3f\u201d\u6216\u201c\u63d0\u4ea4\u8fdb\u884c\u5206\u6790\u201d\u3002\u5728\u7ee7\u7eed\u64cd\u4f5c\u524d\uff0c\u7cfb\u7edf\u4f1a\u63d0\u793a\u60a8&nbsp;\u786e\u8ba4\u60a8\u7684\u9009\u62e9\u3002<img src=\"{{0}}\" class=\"css-4g6ai3 e1i5xcrv0\">&nbsp;", "85ca75b5a3abde5bc084c58310d8d2d3": "\u63d0\u4ea4\u524d\u914d\u7f6e\u6458\u8981\u754c\u9762", "cf13f72dfe03c535c2486fbdc0e6f42c": "<em>\u9009\u62e9\u201c\u4fdd\u5b58\u4e3a\u8349\u7a3f\u201d\u65f6\u5f39\u51fa</em>\u3002&nbsp;", "b959b070bbb5690fe9a834e7a2e3e304": "\u5728\u6b64\u90e8\u5206\u4e2d\uff0c\u60a8\u53ef\u4ee5\u4ece\u60a8\u7684\u4fbf\u6377\u9009\u9879\u4e2d\u9009\u62e9\u201c\u5546\u54c1\u201d\uff0c\u4e5f\u53ef\u4ee5\u9009\u62e9\u201c\u5176\u4ed6\u201d\u9009\u9879\u6765\u521b\u5efa\u4e00\u4e2a\u65b0\u7684\u5546\u54c1\u3002&nbsp;", "926b0395df2b8c235641de136138ebc4": "\u901a\u8fc7\u5b9a\u4e49\u70b9\u548c\u5206\u6790\u533a\u57df\u6765\u6dfb\u52a0\u4f4d\u7f6e", "276460913ffa98514b64adbcc1c04b6b": "\u70b9\u51fb\u201c\u4f4d\u7f6e\u201d\u9009\u9879\u5361\uff0c\u7136\u540e\u70b9\u51fb\u5de6\u4fa7\u7684\u201c+\u6dfb\u52a0\u4f4d\u7f6e\u201d\u3002\u968f\u5373\u6253\u5f00\u7684\u7a97\u53e3\u4e2d\u5305\u542b\u4e09\u4e2a\u4e0a\u4f20\u9009\u9879\uff1a\u6587\u4ef6\u4e0a\u4f20\u3001\u70b9\u4e0a\u4f20\u548c\u591a\u8fb9\u5f62\u533a\u57df\u4e0a\u4f20\u3002\u5728\u672c\u4f8b\u4e2d\uff0c\u9009\u62e9\u201c\u70b9\u201d\uff0c\u7cfb\u7edf\u5c06\u5f15\u5bfc\u60a8\u8fdb\u5165\u201c\u70b9\u201d\u5de5\u4f5c\u6d41\u3002&nbsp;", "dc0a16c0e2deab84b39773722b85b8e8": "<em>\u9009\u62e9\u201c\u70b9\u201d\u540e\u65b0\u51fa\u73b0\u7684\u6dfb\u52a0\u4f4d\u7f6e\u754c\u9762</em>\u3002&nbsp;", "b5ad65d70d4c7f9c65b8ffd878ae8064": "\u5b9a\u4e49\u60a8\u60f3\u8981\u5e94\u7528\u4e8e\u60a8\u7684\u4f4d\u7f6e\u7684\u5206\u6790\u534a\u5f84\uff08\u4ee5\u5343\u7c73\u4e3a\u5355\u4f4d\uff09\u6216\u9762\u79ef\uff08\u4ee5\u516c\u9877\u4e3a\u5355\u4f4d\uff09\u3002&nbsp;", "a747aa3c958bda243d159bf558f91902": "<em>\u9009\u62e9\u201c\u8f93\u5165\u5750\u6807\u201d\u65f6\u9700\u8981\u586b\u5199\u7684\u5b57\u6bb5</em>\u3002&nbsp;", "a277712d06be5649050b1d3598ae8e41": "\u9009\u62e9\u201c\u63d0\u4ea4\u5206\u6790\u201d\u65f6\u5f39\u51fa", "b29562df7047dda7a1c470eb8b2a58c3": "\u9009\u62e9\u201c\u4fdd\u5b58\u4e3a\u8349\u7a3f\u201d\u65f6\u5f39\u51fa", "eea797e91ccc7cead1e4c04f4817c113": "\u70b9\u51fb\u201c\u4f4d\u7f6e\u201d\u9009\u9879\u5361\uff0c\u7136\u540e\u70b9\u51fb\u5de6\u4fa7\u7684\u201c+\u6dfb\u52a0\u4f4d\u7f6e\u201d\u3002\u968f\u5373\u6253\u5f00\u7684\u7a97\u53e3\u4e2d\u5305\u542b\u4e09\u4e2a\u4e0a\u4f20\u9009\u9879\uff1a\u6587\u4ef6\u4e0a\u4f20\u3001\u70b9\u4e0a\u4f20\u548c\u591a\u8fb9\u5f62\u533a\u57df\u4e0a\u4f20\u3002\u5728\u672c\u4f8b\u4e2d\uff0c\u8bf7\u9009\u62e9\u201c\u591a\u8fb9\u5f62\u533a\u57df\u201d\uff0c\u7cfb\u7edf\u5c06\u5f15\u5bfc\u60a8\u8fdb\u5165\u57fa\u4e8e\u591a\u8fb9\u5f62\u533a\u57df\u7684\u4e0a\u4f20\u5de5\u4f5c\u6d41\u3002&nbsp;", "fc78af37bf49520c51f50d2055d2acad": "\u901a\u8fc7\u5b9a\u4e49\u591a\u8fb9\u5f62\u51e0\u4f55\u5f62\u72b6\u6765\u521b\u5efa\u4f4d\u7f6e&nbsp;", "2310a9ab5f15369901d743f355f8fac5": "<em>\u4f4d\u7f6e\u6dfb\u52a0\u5f62\u5f0f\u9009\u62e9\u754c\u9762\u3002\u9009\u62e9\u201c\u591a\u8fb9\u5f62\u533a\u57df</em>\u201d\u3002&nbsp;", "41fa7154c9a022109cb04856a914fddd": "\u7cfb\u7edf\u5c06\u63d0\u793a\u60a8\u4e3a\u8981\u4e0a\u4f20\u7684\u4f4d\u7f6e\u6307\u5b9a\u540d\u79f0\u3002\u8f93\u5165\u5185\u5bb9\u4ec5\u53ef\u5305\u542b\u5b57\u6bcd\u3001\u6570\u5b57\u4ee5\u53ca\u4ee5\u4e0b\u7279\u6b8a\u5b57\u7b26\uff1a[]().-_\u3002\u82e5\u540d\u79f0\u4e2d\u542b\u6709\u5176\u4ed6\u7279\u6b8a\u5b57\u7b26\uff0c\u8fd9\u4e9b\u5b57\u7b26\u4f1a\u5728\u5904\u7406\u8fc7\u7a0b\u4e2d\u88ab\u81ea\u52a8\u79fb\u9664\u3002&nbsp;\u53e6\u5916\uff0c\u8bf7\u6ce8\u610f\uff0c\u8f93\u5165\u5185\u5bb9\u957f\u5ea6\u5fc5\u987b\u5c0f\u4e8e 63 \u4e2a\u5b57\u7b26\u3002\u82e5\u5b57\u7b26\u4e32\u957f\u5ea6\u8d85\u51fa\u9650\u5236\uff0c\u5219\u5c06\u88ab\u622a\u65ad\u4ee5\u7b26\u5408\u89c4\u5b9a\u3002&nbsp;&nbsp;", "b381c802a45f4645e768ba4169fe6c83": "\u6839\u636e\u4f4d\u7f6e\u7c7b\u578b\u6dfb\u52a0\u5fc5\u8981\u5b57\u6bb5\u7684\u754c\u9762\u3002", "cafe5486ba410bfb051d1e642cce88ef": "a. \u7ed8\u5236\u5f62\u72b6&nbsp;", "48e3594d94b780d36910446c94fef78c": "\u9009\u62e9\u6b64\u9009\u9879\u540e\uff0c\u5c06\u663e\u793a\u4e00\u5f20\u5730\u56fe\u3002\u60a8\u53ef\u4ee5\u653e\u5927\u60a8\u60f3\u8981\u5b9a\u4e49\u4f4d\u7f6e\u7684\u533a\u57df\u3002&nbsp;", "a94666182c048bbbc8159f60d27cc843": "\u51c6\u5907\u7ed8\u5236\u591a\u8fb9\u5f62\u65f6\uff0c\u9009\u62e9\u5730\u56fe\u5de6\u4fa7\u89d2\u843d\u7684\u94c5\u7b14\u56fe\u6807\uff0c\u7136\u540e\u70b9\u51fb\u201c\u5f00\u59cb\u7ed8\u5236\u201d&nbsp;", "28f05e44c6e8c69986af6eedcd1b6539": "\u901a\u8fc7\u5c06\u5176\u547d\u540d\u4e3a\u4e00\u4e2a\u65b0\u7684\u5217\u8868\uff0c\u6216\u8005\u4ece\u60a8\u7684\u79ef\u538b\u5217\u8868\u4e2d\u9009\u62e9\u4e00\u4e2a\u4e0e\u4e0a\u4e00\u6b65\u6240\u9009\u5546\u54c1\u4e00\u81f4\u7684\u5217\u8868\uff0c\u4ece\u800c\u5b9a\u4e49\u201c\u5217\u8868\u540d\u79f0\u201d\u3002&nbsp;", "8a7db81d9b5d079a7ce4161e9e071fa0": "\u9009\u62e9\u60a8\u7684\u5217\u8868\u5c06\u8981\u8fdb\u884c\u7684\u201c\u5206\u6790\u7c7b\u578b\u201d\uff0c\u7136\u540e\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\u3002&nbsp;", "5b7f78542df88d54a577a731dea5c405": "\u5728\u7b2c\u56db\u6b65\u4e2d\uff0c\u7cfb\u7edf\u4f1a\u663e\u793a\u4e00\u4e2a\u65b0\u754c\u9762\uff0c\u60a8\u53ef\u4ee5\u6838\u5bf9\u5df2\u8f93\u5165\u7684\u5217\u8868\u540d\u79f0\u548c\u6240\u9009\u7684\u5206\u6790\u7c7b\u578b\u3002\u60a8\u53ef\u4ee5\u70b9\u51fb\u201c\u53d6\u6d88\u201d\u6309\u94ae\u53d6\u6d88\u4e0a\u4f20\uff0c\u6216\u70b9\u51fb\u201c\u8fd4\u56de\u201d\u6309\u94ae\u4fee\u6539\u63d0\u4f9b\u7684\u4fe1\u606f\u3002&nbsp;", "ace50103965d95a4f34dd6c4c89dea8f": "\u5982\u679c\u60a8\u786e\u8ba4\u8fd9\u4e9b\u4fe1\u606f\u548c\u5206\u6790\u7c7b\u578b\u65e0\u8bef\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u201c\u4fdd\u5b58\u4e3a\u8349\u7a3f\u201d\u6216\u201c\u63d0\u4ea4\u8fdb\u884c\u5206\u6790\u201d\u3002\u65e0\u8bba\u9009\u62e9\u54ea\u4e00\u9879\uff0c\u7cfb\u7edf\u90fd\u4f1a\u8981\u6c42\u60a8\u518d\u6b21\u786e\u8ba4\u60a8\u7684\u9009\u62e9\uff0c\u7136\u540e\u624d\u80fd\u7ee7\u7eed\u3002&nbsp;", "925e0d0e2185da6c5cb4dd8780a59307": "\u63d0\u4ea4\u524d\u914d\u7f6e\u5217\u8868\u6458\u8981\u754c\u9762", "a5272dad98ef314dad0a13c4d935d4e3": "\u9009\u62e9\u6b64\u9009\u9879\u65f6\uff0c\u8bf7\u4ee5\u5341\u8fdb\u5236\u5f62\u5f0f\u8f93\u5165\u7eac\u5ea6\u548c\u7ecf\u5ea6\u5750\u6807\uff08\u521b\u5efa\u591a\u8fb9\u5f62\u533a\u57df\u81f3\u5c11\u9700\u8981\u8f93\u5165 3 \u4e2a\u5750\u6807\uff09\u3002", "8fc63dabd7b7769caecd8866eaed8ad5": "\u8f93\u5165\u6240\u6709\u5750\u6807\u540e\uff0c\u56fe\u50cf\u5c06\u663e\u793a\u5728\u5730\u56fe\u4e2d\u3002", "efdc6008f26cdb212289762a8586cdd1": "\u5982\u679c\u60a8\u786e\u8ba4\u8fd9\u4e9b\u4fe1\u606f\u548c\u5206\u6790\u7c7b\u578b\u65e0\u8bef\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u201c\u4fdd\u5b58\u4e3a\u8349\u7a3f\u201d\u6216\u201c\u63d0\u4ea4\u8fdb\u884c\u5206\u6790\u201d\u3002\u65e0\u8bba\u9009\u62e9\u54ea\u4e00\u9879\uff0c\u7cfb\u7edf\u90fd\u4f1a\u8981\u6c42\u60a8\u518d\u6b21\u786e\u8ba4\u60a8\u7684\u9009\u62e9\uff0c\u7136\u540e\u624d\u80fd\u7ee7\u7eed\u3002&nbsp;", "7ce79a4adbb636f69a4d985becf06c0e": "\u7136\u540e\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\u7ee7\u7eed\u64cd\u4f5c\u3002&nbsp;", "37f83ceaf9c529132e7a62665bbb2c17": "\u63d0\u4ea4\u5206\u6790\u524d\u914d\u7f6e\u4e0a\u4f20\u5217\u8868\u7684\u754c\u9762\u3002", "1129164c48494b106ed3f6004d6a583e": "\u5982\u679c\u60a8\u6ca1\u6709\u627e\u5230\u6240\u9700\u5185\u5bb9\u6216\u9700\u8981\u5176\u4ed6\u652f\u6301\uff0c\u8bf7\u586b\u5199<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u6b64\u8868\u5355</a>\u3002&nbsp;&nbsp;", "fb5d9a3a035edd2b4f54d8835b733214": "\u60a8\u73b0\u5728\u5e94\u8be5\u5df2\u6210\u529f\u63d0\u4ea4\u5206\u6790\u3002\u5982\u679c\u60a8\u5728\u4e0a\u4f20\u4f4d\u7f6e\u4fe1\u606f\u65f6\u9047\u5230\u9519\u8bef\uff0c\u8bf7\u53c2\u9605\u6211\u4eec\u7684\u6307\u5357<a href=\"{{0}}\">\u5982\u4f55\u89e3\u51b3\u4e0a\u4f20\u9519\u8bef</a>\u3002&nbsp;", "9ad94e720b34911ae882c55e4ba32df5": "GFW Pro \u63d0\u4f9b\u514d\u8d39\u589e\u503c\u6a21\u5f0f\uff0c\u4e3a\u6240\u6709\u7ec4\u7ec7\u63d0\u4f9b\u4ec5\u9650\u5185\u90e8\u4f7f\u7528\u7684\u5e74\u5ea6\u514d\u8d39\u4f7f\u7528\u989d\u5ea6\u3002\u5982\u6709\u9700\u6c42\uff0c\u7528\u6237\u53ef\u8d2d\u4e70\u66f4\u591a\u4f7f\u7528\u989d\u5ea6\uff0c\u5e76\u53ef\u901a\u8fc7\u8054\u7cfb <a href=\"{{0}}\">gfwprosales@wri.org</a> \u83b7\u53d6\u5185\u5bb9\u8f6c\u6388\u8bb8\u53ef\u548c/\u6216API \u8bbf\u95ee\u6743\u9650\uff0c\u4ee5\u4fbf\u5c06 GFW Pro \u5185\u5bb9\u5206\u4eab\u6216\u5206\u53d1\u7ed9\u4e1a\u52a1\u5408\u4f5c\u4f19\u4f34\u3002\u4e3a\u5185\u90e8\u4f7f\u7528\u800c\u751f\u6210\u7684 GFW Pro \u5185\u5bb9\u53ef\u76f4\u63a5\u514d\u8d39\u53d1\u9001\u7ed9\u76d1\u7ba1\u673a\u6784\uff0c\u548c\u7528\u4e8e\u975e\u653f\u5e9c\u7ec4\u7ec7\u7ba1\u7406\u7684\u81ea\u613f\u6027\u53ef\u6301\u7eed\u53d1\u5c55\u62a5\u544a\u9879\u76ee\u3002", "b3493e287d38d4503d601719a88c7f98": "GFW Pro \u8fd8\u63d0\u4f9b\u5e74\u5ea6\u4f1a\u5458\u670d\u52a1\uff0c\u5176\u4e2d\u5305\u62ec\u4f7f\u7528\u5546\u4e1a API \u7684\u6743\u9650\uff08\u51e0\u4e4e\u53ef\u4ee5\u65e0\u9650\u5236\u4f7f\u7528\uff09\u3002\u4f1a\u5458\u8d2d\u4e70\u7528\u4e8e\u5546\u4e1a\u7528\u9014\u7684 GFW Pro \u62a5\u544a\u7684\u8f6c\u6388\u8bb8\u53ef\u6743\u65f6\uff0c\u8fd8\u53ef\u4eab\u53d7\u6298\u6263\u3002", "2388c45cd668