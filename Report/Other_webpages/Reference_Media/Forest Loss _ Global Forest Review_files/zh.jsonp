797\u8986\u76d6\u51cf\u5c11\u662f\u6307\u690d\u88ab\u7684\u6797\u5206\u7ea7\u522b\u66ff\u6362\u8d85\u8fc7 5 \u7c73\u3002", "721fd9a8ae5e1f342e9128dab201a8c7": "\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6570\u636e\u96c6\u662f\u9a6c\u91cc\u5170\u5927\u5b66\u3001Google\u3001USGS\uff08\u7f8e\u56fd\u5730\u8d28\u52d8\u63a2\u5c40\uff09\u548c NASA\uff08\u7f8e\u56fd\u822a\u5929\u5c40\uff09\u7684\u5408\u4f5c\u9879\u76ee\uff0c\u4f7f\u7528 Landsat \u536b\u661f\u56fe\u50cf\u4ee5 30\u00d730 \u7c73\u7684\u5206\u8fa8\u7387\u7ed8\u5236\u5e74\u5ea6\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u5730\u56fe\u3002", "319a38858236082ccea2a3c5ad040597": "\u6ce8\u610f\uff1a\u201c\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u201d\u4e0e\u201c\u6ee5\u4f10\u201d\u4e0d\u540c\u2014\u2014\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u5305\u62ec\u5929\u7136\u6797\u548c\u4eba\u5de5\u79cd\u690d\u6797\u7684\u53d8\u5316\u60c5\u51b5\uff0c\u4e0d\u4e00\u5b9a\u662f\u4eba\u4e3a\u9020\u6210\u30022011 \u5e74\u4ee5\u540e\u5f97\u5230\u7684\u6570\u636e\u91c7\u7528\u4e86\u4e00\u79cd\u65b0\u65b9\u6cd5\uff0c\u53ef\u4ee5\u83b7\u53d6\u5176\u4ed6\u51cf\u5c11\u60c5\u51b5\u3002\u5e94\u8be5\u8c28\u614e\u5730\u6bd4\u8f83 2001 - 2010 \u5e74\u7684\u539f\u59cb\u6570\u636e\u548c\u672a\u6765\u5e74\u4efd\u7684\u6570\u636e\u3002", "96b0141273eabab320119c467cdcaf17": "\u603b\u8ba1", "b2090bba81de29d2476e71b522e911b9": "\u8f6c\u79fb\u519c\u4e1a", "a1640720122061562159bc7d142d84cc": "\u6c38\u4e45\u6027\u6ee5\u4f10\u7684\u9a71\u52a8\u56e0\u7d20\uff1a", "8f965e8faa7eae8cfd86a3fa8a367282": "\u5546\u4e1a\u9a71\u52a8\u7684\u6bc1\u6797", "25e13635976128578d6c8d05869e251c": "\u6ee5\u4f10\uff08\u6bc1\u6797\uff09", "3e34bdebd9bd5edda27e8728904a2552": "\u5355\u4f4d", "c9357acf5618f7ba97fa82dbd94ba52a": "\u9762\u79ef\u767e\u5206\u6bd4 - \uff05", "8d892690698ef3ef830ac2e1aad5ebf2": "\u4e0e\u5176\u4ed6\u5730\u533a\u68ee\u6797\u8986\u76d6\u589e\u52a0\u7684\u6bd4\u8f83", "2228ecbe68f0ffc4db14efbb6ddc15be": "\u663e\u793a\u4e86\u6240\u9009\u533a\u57df\u5728 2001\u20132012 \u5e7