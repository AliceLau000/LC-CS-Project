70b Planet \u56fe\u50cf", "76d8fb769a7d20db11464442f9da1e93": "3. \u5982\u8981\u9009\u62e9\u522b\u7684\u56fe\u50cf\u7c7b\u578b\uff0c\u8bf7\u70b9\u51fb\u56fe\u50cf\u7c7b\u578b\u6807\u7b7e\u4e0b\u9762\u7684\u9009\u62e9\u6846\u3002\u4f60\u53ef\u4ee5\u9009\u62e9 (a) \u81ea\u7136\u8272\u6216 (b) \u8fd1\u7ea2\u5916\u3002&nbsp;&nbsp;", "67b440b0fa95ea670873c148bfc8ce6f": "1. \u5728\u63a7\u5236\u9762\u677f\u7684\u201c\u56fe\u5c42\u201d\u5206\u533a\uff0c\u201c\u8b66\u62a5\u201d\u56fe\u5c42\u5728\u9ed8\u8ba4\u60c5\u51b5\u4e0b\u5e94\u5f53\u662f\u6253\u5f00\u7684\u3002\u5982\u679c\u6ca1\u6709\u6253\u5f00\uff0c\u8bf7\u70b9\u51fb\u56fe\u5c42\u540d\u79f0\u65c1\u8fb9\u7684\u5207\u6362\u6309\u94ae\uff0c\u8fd9\u6837\u5b83\u5c31\u4f1a\u663e\u793a\u4e3a\u7eff\u8272\u3002\u5728\u56fe\u5c42\u7684\u540d\u79f0\u4e0b\u65b9\u5c06\u51fa\u73b0\u4e24\u4e2a\u9009\u62e9\u6846\u3002&nbsp;", "a04c01bbb86300d24142a52cb7bc1a73": "\u6bd4\u8f83\u4e24\u4e2a\u65e5\u671f\u7684 Planet \u56fe\u50cf", "2d95937e3f273b26deb4a131adde4a18": "<strong>\u201c\u6ed1\u52a8\u201d\u6761\uff1a</strong>\u4e00\u6839\u5c06\u5730\u56fe\u5206\u4e3a\u4e24\u534a\u7684\u7ad6\u6761\u3002\u5de6\u4fa7\u7531\u5728\u4e0a\u4e00\u6b65\u4e2d\u63cf\u8ff0\u7684\u9009\u9879\u63a7\u5236\u3002\u53f3\u4fa7\u7531\u4e00\u7ec4\u65b0\u7684\u56fe\u50cf\u63a7\u4ef6\u63a7\u5236\uff0c\u8fd9\u7ec4\u63a7\u4ef6\u5728\u63a7\u5236\u9762\u677f\u7684\u7b2c\u4e00\u7ec4\u63a7\u4ef6\u7684\u4e0b\u65b9\u3002&nbsp;", "be9873b8134cfc2866bcca6d311669bd": "<strong>\u4fe1\u606f\u6846</strong>\uff1a\u5728\u5730\u56fe\u7684\u53f3\u4e0b\u89d2\u6709\u4e00\u4e2a\u4fe1\u606f\u6846\uff0c\u5b83\u8868\u793a\u7528\u6237\u6b63\u5728\u8fdb\u884c\u6bd4\u8f83\uff0c\u5e76\u663e\u793a\u5730\u56fe\u5de6\u4fa7\u548c\u53f3\u4fa7\u7684\u65e5\u671f\u3002&nbsp;", "213b4cfdf46b3c9739865a9ed9aeb8c6": "3. \u5355\u51fb\u7ad6\u76f4\u6ed1\u52a8\u6761\u4e2d\u95f4\u7684\u5706\u5f62\u628a\u624b\u5e76\u524d\u540e\u62d6\u52a8\uff0c\u4ece\u800c\u5feb\u901f\u5730\u91cd\u590d\u6bd4\u8f83\u4e24\u4e2a\u