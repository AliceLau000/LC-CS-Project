fc\u9a71\u52a8\u56e0\u7d20\uff0c\u4ee5\u53ca 2001 \u5e74\u81f3 2022 \u5e74\u671f\u95f4\u8be5\u9879\u51cf\u5c11\u7684\u5f3a\u5ea6\u3002", "bd50a0197c107b207955b59adc813ba2": "\u8fd9\u7ec4\u6570\u636e\u96c6\u91c7\u7528\u4e86\u4e0b\u8ff0\u4e94\u4e2a\u7c7b\u522b\uff0c\u5c55\u793a\u4e86 2001 \u81f3 2022 \u5e74\u95f4<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6797\u6728\u8986\u76d6\u51cf\u5c11</a>\u7684\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\uff1a", "58d58a3fc284aca9bca9548deaca2ecd": "\u65b0\u5174\u7684\u70ed\u70b9\u5730\u533a- 2002-2022", "0bf25d20c6e61fc28c9c1c46013403a9": "\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u91cf - 2001-2022", "bf21ea3cf42e90698b7a3fa7c0e2113a": "\u51c0\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf - 2001-2022", "6092ac4025df68f0a6614ece2e0b3585": "\u6b64\u6570\u636e\u96c6\u5f97\u76ca\u4e8e\u4f4d\u4e8e\u9a6c\u91cc\u5170\u5927\u5b66\u3001Google\u3001USGS \u548c NASA \u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">GLAD</a>\uff08\u5168\u7403\u571f\u5730\u5206\u6790 &amp; \u63a2\u7d22) \u5b9e\u9a8c\u5ba4\u4e4b\u95f4\u7684\u5408\u4f5c\uff0c\u4ee5\u7ea6 30 \u00d7 30 \u7c73\u5206\u8fa8\u7387\u6d4b\u91cf\u5168\u7403\u571f\u5730\uff08\u9664\u4e86\u5357\u6781\u6d32\u548c\u5176\u4ed6\u5317\u6781\u5c9b\u5c7f\uff09\u7684\u6811\u6728\u8986\u76d6\u6d41\u5931\u9762\u79ef\u3002\u6570\u636e\u5229\u7528\u591a\u8c31\u536b\u661f\u56fe\u50cf\u751f\u6210\uff0c\u591a\u8c31\u536b\u661f\u56fe\u50cf\u6765\u81ea\u9646\u5730\u536b\u661f 5 \u53f7\u4e13\u9898\u5236\u56fe\u4eea (TM)\uff0c\u9646\u5730\u536b\u661f 7 \u53f7\u589e\u5f3a\u578b\u4e13\u9898\u5236\u56fe\u4eea (ETM+)\uff0c\u4ee5\u53ca\u9646\u5730\u536b\u661f 8 \u53f7\u9646\u5730\u6210\u50cf\u4eea (OLI) \u4f20\u611f\u5668\u3002\u8d85\u8fc7 100 \u4e07\u5f20\u536b\u661f\u56fe\u50cf\u88ab\u5904\u7406\u548c\u5206\u6790\uff0c\u5305\u62ec 2000-2012 \u5e74\u671f\u95f4 60 \u591a\u4e07\u5f20\u9646\u5730\u536b\u661f 7 \u53f7\u7684\u56fe\u50cf\uff0c40 \u591a\u4e07\u5f20 2011-2022 \u5e74\u671f\u95f4\u66f4\u65b0\u7684\u9646\u5730\u536b\u661f 5\u30017\u30018 \u53f7\u7684\u56fe\u50cf\u3002\u96c6\u5408\u536b\u661f\u56fe\u50cf\u4e2d\u6e05\u6670\u7684\u5730\u8868\u89c2\u6d4b\u6570\u636e\uff0c\u5e94\u7528\u76d1\u7763\u5b66\u4e60\u7b97\u6cd5\u8bc6\u522b\u6bcf\u50cf\u7d20\u6811\u6728\u8986\u76d6\u635f\u5931\u3002", "162c21b0cb31034f888767dfd651f681": "\u8be5\u6570\u636e\u96c6\u81ea\u521b\u5efa\u4ee5\u6765\u5df2\u7ecf\u66f4\u65b0\u4e86\u4e94\u6b21\uff0c\u73b0\u5728\u5305\u62ec\u4e86\u5230 2022 \u5e74\u7684\u635f\u5931\uff081.10 \u7248\u672c\uff09\u3002\u5206\u6790\u65b9\u6cd5\u5df2\u5728\u8bb8\u591a\u65b9\u9762\u8fdb\u884c\u4e86\u4fee\u6539\uff0c\u5305\u62ec\u76ee\u6807\u5e74\u4efd\u7684\u65b0\u6570\u636e\uff0c\u5bf9\u4e4b\u524d\u5e74\u4efd\u7684\u6570\u636e\u8fdb\u884c\u4e86\u91cd\u65b0\u5904\u7406\u5206\u6790\u65b9\u6cd5\u8fdb\u884c\u4e86\u591a\u65b9\u9762\u7684\u4fee\u6539\uff0c\u5305\u62ec\u76ee\u6807\u5e74\u4efd\u7684\u65b0\u6570\u636e\u3001\u524d\u51e0\u5e74\u7684\u91cd\u65b0\u5904\u7406\u6570\u636e\uff081.1 \u7248\u672c\u66f4\u65b0\u4e3a 2011 \u5e74\u548c 2012 \u5e74\uff0c1.2 \u7248\u672c\u66f4\u65b0\u4e3a 2012 \u5e74\u548c 2013 \u5e74\uff0c1.3 \u7248\u672c\u66f4\u65b0\u4e3a 2014 \u5e74\uff09\u4ee5\u53ca\u6539\u8fdb\u7684\u5efa\u6a21\u548c\u6821\u51c6\u3002\u8fd9\u4e9b\u4fee\u6539\u6539\u8fdb\u4e86 2011-2022 \u5e74\u7684\u53d8\u5316\u68c0\u6d4b\uff0c\u5305\u62ec\u66f4\u597d\u5730\u68c0\u6d4b\u706b\u707e\u9020\u6210\u7684\u5317\u65b9\u635f\u5931\u3001\u70ed\u5e26\u68ee\u6797\u4e2d\u7684\u5c0f\u519c\u8f6e\u4f5c\u519c\u4e1a\u3001\u9009\u62e9\u6027\u91c7\u4f10\u548c\u77ed\u5468\u671f\u4eba\u5de5\u6797\u3002\u6700\u7ec8\uff0c\u672a\u6765\u7684\u201c2.0 \u7248\u201d\u5c06\u5305\u62ec\u5bf9 2000-2010 \u5e74\u6570\u636e\u7684\u518d\u5904\u7406\uff0c\u4f46\u4e0e\u6b64\u540c\u65f6\uff0c\u5bf9\u539f\u59cb\u6570\u636e\u548c 1.7 \u7248\u672c\u7684\u96c6\u6210\u4f7f\u7528\u5e94\u8c28\u614e\u64cd\u4f5c\u3002\u53ef\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u8be6\u7ec6\u4e86\u89e3 1.7 \u7248\u672c\u66f4\u65b0\u3002", "59949f07651de6fb42235a626af5d68f": "2011-2022 \u5e74\u6570\u636e\u4f7f\u7528<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u66f4\u65b0\u7684\u65b9\u6cd5</a>\u751f\u6210\u3002\u5728\u5bf9\u6bd4\u539f\u6765\u7684 2001-2010 \u5e74\u6570\u636e\u548c 2011-2022 \u5e74\u66f4\u65b0\u540e\u7684\u6570\u636e\u7684\u65f6\u5019\u5e94\u8be5\u683c\u5916\u5c0f\u5fc3\u3002", "02b5362788cde7db7deab107cb41a0ef": "\u7531\u4e8e\u5168\u7403\u68ee\u6797\u76d1\u6d4b\u6570\u636e\u6765\u6e90\u7684\u89c4\u6a21\u548c\u590d\u6742\u6027\u63d0\u5347\uff0c\u6b64\u6570\u636e\u7684\u5206\u6790\u4e0e\u89e3\u91ca\u5de5\u5177\u5bf9\u5e72\u9884\u6548\u679c\u7684\u91cd\u8981\u6027\u4e5f\u589e\u52a0\u4e86\uff0c\u56e0\u4e3a\u9700\u8981\u80fd\u5feb\u901f\u786e\u5b9a\u548c\u89e3\u91ca\u663e\u8457\u7684\u68ee\u6797\u51cf\u5c11\u60c5\u51b5\u3002\u65b0\u5174\u70ed\u70b9\u6570\u636e\u96c6\u53ef\u5728\u56fd\u5bb6\u5c42\u9762\u786e\u5b9a\u70ed\u5e26\u8303\u56f4\u5728 2002 \u5e74\u81f3 2021 \u5e74\u539f\u59cb\u68ee\u6797\u51cf\u5c11\u7684\u6700\u663e\u8457\u7684\u7fa4\u96c6\u3002\u201c\u70ed\u70b9\u201d\u4e00\u8bcd\u662f\u6307\u4ece\u7edf\u8ba1\u4e0a\u770b\uff0c\u5728\u51cf\u5c11\u7684\u7a7a\u95f4\u6a21\u5f0f\u4e0a\u5c55\u73b0\u51fa\u663e\u8457\u7684\u805a\u96c6\u6027\u7684\u533a\u57df\u3002\u5728\u6b64\u5206\u6790\u4e2d\uff0c\u89c2\u5bdf\u5230\u7684\u539f\u59cb\u68ee\u6797\u51cf\u5c11\u6a21\u5f0f\u4e5f\u8bb8\u53ef\u5f52\u56e0\u4e8e\u6839\u672c\u7684\uff08\u800c\u4e0d\u662f\u968f\u673a\u7684\uff09\u7a7a\u95f4\u8fc7\u7a0b\u3002\u5404\u79cd\u4e0d\u540c\u70ed\u70b9\u7c7b\u522b\u5982\u4e0b\u6240\u8ff0\uff1a<br>\u2014\u2014<strong>\u65b0\u589e</strong>\uff1a\u4ece\u7edf\u8ba1\u4e0a\u770b\uff0c\u4ec5\u5728 2021 \u5e74\u662f\u663e\u8457\u70ed\u70b9\u7684\u5730\u65b9\uff0c\u4e4b\u524d\u4ece\u672a\u6210\u4e3a\u70ed\u70b9\u3002<br>\u2014\u2014<strong>\u6563\u53d1</strong>\uff1a\u518d\u6b21\u51fa\u73b0\u540e\u53c8\u518d\u6b21\u6d88\u5931\u7684\u70ed\u70b9\u5730\u65b9\u3002\u4ece\u7edf\u8ba1\u4e0a\u770b\uff0c19 \u5e74\u4e2d\u6210\u4e3a\u663e\u8457\u70ed\u70b9\u7684\u5e74\u6570\u4e0d\u8db3 18 \u5e74\u3002<br>\u2014\u2014<strong>\u52a0\u5267</strong>\uff1a\u4ece\u7edf\u8ba1\u4e0a\u770b\uff0c19 \u5e74\u4e2d\u6210\u4e3a\u663e\u8457\u70ed\u70b9\u7684\u5e74\u6570\u8d85\u8fc7 17 \u5e74\uff08\u5927\u4e8e 90%\uff09\u7684\u5730\u65b9\uff0c\u5176\u4e2d\u5305\u62ec\u6700\u8fd1\u7684\u5e74\u4efd\uff082022 \u5e74\uff09\u3002\u6b64\u5916\uff0c\u6bcf\u5e74\u5927\u6570\u91cf\u805a\u96c6\u7684\u5f3a\u5ea6\u4e5f\u5728\u63d0\u5347\u3002<br>\u2014\u2014<strong>\u6301\u7eed</strong>\uff1a\u4ece\u7edf\u8ba1\u4e0a\u770b\uff0c19 \u5e74\u4e2d\u6210\u4e3a\u663e\u8457\u70ed\u70b9\u7684\u5e74\u6570\u8d85\u8fc7 17 \u5e74\uff08\u5927\u4e8e 90%\uff09\u7684\u5730\u65b9\uff0c\u5e76\u4e14\u6ca1\u6709\u660e\u663e\u7684\u8d8b\u52bf\u8868\u660e\u805a\u96c6\u5f3a\u5ea6\u968f\u65f6\u95f4\u5347\u964d\u3002<br>\u2014\u2014<strong>\u51cf\u7f13</strong>\uff1a\u4ece\u7edf\u8ba1\u4e0a\u770b\uff0c19 \u5e74\u4e2d\u6210\u4e3a\u663e\u8457\u70ed\u70b9\u7684\u5e74\u6570\u8d85\u8fc7 17 \u5e74\uff08\u5927\u4e8e 90%\uff09\u7684\u5730\u65b9\u3002\u6b64\u5916\uff0c\u6bcf\u5e74\u7684\u5927\u6570\u91cf\u805a\u96c6\u5f3a\u5ea6\u4e5f\u5728\u4e0b\u964d\uff0c\u6216\u8005\u6700\u8fd1\u4e00\u5e74\uff082022 \u5e74\uff09\u4e0d\u662f\u70ed\u70b9\u3002<br>\u65b0\u5174\u70ed\u70b9\u5206\u6790\u91c7\u7528 2002 \u5e74\u81f3 2021 \u5e74\u95f4 Hansen et al 2013 \u7684\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u51cf\u5c11\u6570\u636e\u96c6\u30012001 \u5e74\u7684 Turubanova et al. 2018 \u539f\u59cb\u68ee\u6797\u8303\u56f4\u6570\u636e\u96c6\u4ee5\u53ca ESRI ArcGIS Emerging Hot Spot Analysis \u5730\u7406\u6570\u636e\u5904\u7406\u5de5\u5177\u3002\u5728\u6b64\u5206\u6790\u4e2d\uff0c\u539f\u59cb\u68ee\u6797\u662f\u6307\u5728\u6700\u8fd1\u7684\u5386\u53f2\u4e2d\u672a\u66fe\u5b8c\u5168\u6e05\u9664\u5e76\u518d\u751f\u7684\u6210\u719f\u5929\u7136\u6f6e\u6e7f\u70ed\u5e26\u68ee\u6797\u8986\u76d6\u3002\u68ee\u6797\u51cf\u5c11\u662f\u6307\u201c\u5730\u76ae\u66ff\u4ee3\u5e72\u6270\u201d\u6216\u8005 Landsat \u50cf\u7d20\u5c3a\u5ea6\u4e0a\u7684\u6811\u6728\u8986\u76d6\u6842\u51a0\u5b8c\u5168\u6d88\u5931\u3002\u65b0\u5174\u70ed\u70b9\u5206\u6790\u5de5\u5177\u7ed3\u5408\u4f7f\u7528\u4e24\u79cd\u7edf\u8ba1\u624b\u6bb5\uff0cGetis-Ord Gi* \u7edf\u8ba1\u7528\u4e8e\u786e\u5b9a\u68ee\u6797\u51cf\u5c11\u7684\u5730\u70b9\u4ee5\u53ca\u7a7a\u95f4\u805a\u96c6\u7a0b\u5ea6\uff0cMann-Kendall \u8d8b\u52bf\u6d4b\u8bd5\u7528\u4e8e\u8bc4\u4f30\u968f\u65f6\u95f4\u53d8\u5316\u7684\u65f6\u95f4\u8d8b\u52bf\u3002", "7114b83a8e4b396a94492504dafb9ee7": "\u4ee50.5\u516c\u9877\u5206\u8fa8\u7387\u548c {selector} \u7684\u6811\u6728\u8986\u76d6\u4e3a\u6807\u51c6\uff0c\u6765\u663e\u793a\u6811\u6728\u8986\u76d6", "59716c97497eb9694541f7c3d37b1a4d": "\u56fd\u5bb6", "b547fbcf1424f0cddd0e07f15a87c866": "\u68ee\u6797\u8986\u76d6", "77a212d4690ab71fb017ceb77a2897b0": "\u7528  \u663e\u793a\u68ee\u6797\u8986\u76d6\u51cf\u5c11", "8fbe15bb95fc52d372dea677b6742842": "\u663e\u793a {selector} \u4e2d\u7684\u5927\u8c46\u79cd\u690d\u533a\u57df", "142ed6f502c09cf990caaf3119f78359": "\u7701/\u5dde", "12bdf3e71e3f8128bfd1111958bec462": "\u6309\u767e\u5206\u6bd4\u663e\u793a\u6797\u6728\u8986\u76d6\u7684\u51c0\u53d8\u5316", "d5e467ac2e5e0ebf2d3d58329247007c": "\u533a/\u5e02", "4d4547743c1545232e8935643c6c7738": "\u5e74\u6570\u636e", "9820f632a9765e29644e09b19eb15241": "\u6811\u51a0\u9ad8\u5ea6", "5119c9436a39507ea1276498d3491bdf": "\u4fdd\u62a4\u533a\uff082022 \u5e74 8 \u6708\uff09", "314093ebf8be7f1022193e1cd18365d2": "\u663e\u793a\u6797\u6728\u751f\u7269\u91cf\u5bc6\u5ea6", "d52ab81446ca202e0b195cf353d12964": "\u4ece 2000 \u5e74\u5230 2020 \u5e74\uff0c\u5168\u4e16\u754c\u7684\u6811\u6728\u8986\u76d6\u7387\u7ecf\u5386\u4e86 {netChange} ({netChangePerc}) \u7684\u51c0\u53d8\u5316\u3002", "b04ffbe0de24515296d8f830329c8b4b": "\u627e\u4e0d\u5230\u60f3\u67e5\u627e\u7684\u4fe1\u606f\uff1f <button data-id=\"button\" id=\"button\" class=\"c-button theme-button-inline\"><div class=\"button-wrapper\">\u6d4f\u89c8\u5730\u56fe</div></button>\u6216<a href=\"{{0}}\">\u8bbf\u95ee\u5e2e\u52a9\u4e2d\u5fc3</a>\u83b7\u53d6\u6559\u7a0b\u3002", "b965fd7a291b35ff0362c7f0259a3e4b": "\u603b\u635f\u5931\u4e0d\u540c\u4e8e\u5e74\u5ea6\u6797\u6728\u8986\u76d6\u635f\u5931\uff0c\u56e0\u4e3a\u8be5\u6570\u636e\u662f\u4f7f\u7528\u4e0d\u540c\u7684\u65b9\u6cd5\u548c\u68ee\u6797\u5b9a\u4e49\u521b\u5efa\u7684\u3002\u6709\u5173\u603b\u635f\u5931\u6216\u5e74\u5ea6\u635f\u5931\u7684\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605\u6811\u6728\u8986\u76d6\u635f\u5931\u5c0f\u7ec4\u4ef6\u3002", "8052f4b168d810792d0cb01fbb26c2eb": "\u63a2\u7d22\u53ef\u4ea4\u4e92\u7684\u56fe\u8868\u548c\u5730\u56fe\uff0c\u603b\u7ed3\u68ee\u6797\u5728\u6c14\u5019\u53d8\u5316\u548c\u7ba1\u7406\u5168\u7403\u78b3\u9884\u7b97\u4e2d\u7684\u4f5c\u7528\u3002\u68ee\u6797\u78b3\u7edf\u8ba1\u6570\u636e\uff08\u5305\u62ec\u68ee\u6797\u50a8\u5b58\u3001\u6392\u653e\u548c\u5438\u6536\uff08\u79fb\u9664\uff09\u7684\u78b3\u91cf\uff09\u53ef\u4ee5\u5b9a\u5236\u3001\u8f7b\u677e\u5171\u4eab\uff0c\u8fd8\u53ef\u4ee5\u4e0b\u8f7d\u4e0b\u6765\u4ee5\u4fbf\u79bb\u7ebf\u4f7f\u7528\u3002", "2c2bcc229465d5cc39632719b1121c3a": "\u4ece {startYear} \u5e74\u5230 {endYear} \u5e74\uff0c<strong>\u5168\u7403</strong>\u68ee\u6797\u78b3\u6392\u653e\u91cf\u4e3a {totalEmissions}<b>/\u5e74</b>\uff0c\u78b3\u6e05\u9664\u91cf\u4e3a {totalRemovals}<b>/\u5e74</b>\u3002 \u8fd9\u8868\u793a {netCarbonFluxWording} \u4e3a {totalFlux}<b>/\u5e74</b>\u3002", "ff0091479902428cb1bfa4702af2ef56": "\u9020\u6210\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u539f\u56e0\u53ef\u80fd\u6709\u8bb8\u591a\uff0c\u5305\u62ec\u5728\u53ef\u6301\u7eed\u6797\u4e1a\u4f5c\u4e1a\u8fc7\u7a0b\u4e2d\u7684\u6bc1\u6797\u3001\u706b\u707e\u548c\u4f10\u6728\u3002\u5728\u53ef\u6301\u7eed\u7ba1\u7406\u7684\u68ee\u6797\u4e2d\uff0c\u968f\u7740\u5c0f\u6811\u957f\u5927\uff0c\u5927\u5230\u8db3\u4ee5\u5b9e\u73b0\u6811\u51a0\u95ed\u5408\uff0c\u201c\u635f\u5931\u201d\u6700\u7ec8\u4f1a\u663e\u793a\u4e3a\u201c\u6536\u83b7\u201d\u3002", "1e27e800a3460e8a52bffdc2bc70f65d": "\u68ee\u6797\u53d8\u5316", "661d7c70f4ce12204ad5181a6985c038": "\u6811\u51a0\u5bc6\u5ea6", "193f8122502892b5cd8625fd937198cf": "\u5168\u7403\u706b\u707e\u5929\u6c14\u6307\u6570\uff082023 \u5e74 7 \u6708 17 \u65e5\uff09", "44279b616bad7a856f75b1c747d45856": "\u663e\u793a\u56e0\u706b\u707e\u9020\u6210\u7684\u6797\u6728\u8986\u76d6\u635f\u5931", "8b5e5b359987e04f59712c10c5197651": "\u5173\u4e8e GFW", "130ddfce9c28453883ccfe2da8b6d5ac": "\u6559\u7a0b", "4451975687152825afbe024b50c59557": "\u793e\u533a\u8bba\u575b", "2aa18307ad44e9f362a73748096ae4c7": "\u5173\u4e8e<svg width=\"32\" height=\"32\" viewBox=\"0 0 32 32\" class=\"icon-arrow\"><path d=\"M31.68 8.593L30.077 6.99c-.214-.214-.46-.321-.738-.321s-.523.107-.737.321L16 19.591 3.399 6.99c-.214-.214-.46-.321-.738-.321s-.524.107-.738.321L.32 8.593c-.214.214-.321.46-.321.738s.107.524.321.737L15.262 25.01c.214.214.46.321.738.321s.523-.107.737-.321L31.68 10.068c.214-.214.32-.46.32-.737s-.106-.524-.32-.738z\"></path></svg>", "ad5f0c8cfa339b05e7901a55d9e7c189": "\u8d60\u6b3e &amp; \u673a\u4f1a", "d086a3e4fab4c28771a35415deaf9b07": "\u5e2e\u52a9<svg width=\"32\" height=\"32\" viewBox=\"0 0 32 32\" class=\"icon-arrow\"><path d=\"M31.68 8.593L30.077 6.99c-.214-.214-.46-.321-.738-.321s-.523.107-.737.321L16 19.591 3.399 6.99c-.214-.214-.46-.321-.738-.321s-.524.107-.738.321L.32 8.593c-.214.214-.321.46-.321.738s.107.524.321.737L15.262 25.01c.214.214.46.321.738.321s.523-.107.737-.321L31.68 10.068c.214-.214.32-.46.32-.737s-.106-.524-.32-.738z\"></path></svg>", "0d4764ffaefab0617e18b267e91aa1ff": "\u6797\u6728\u690d\u88ab<button data-id=\"button\" id=\"button\" class=\"c-button theme-button-small square info-button\"><div class=\"button-wrapper\"><svg class=\"c-icon info-icon\" viewBox=\"0 0 18 32\"><use xlink:href=\"#info-1622ac34--sprite\"></use></svg></div></button>", "ffd94a4937b0bd07bfb51190199042c4": "\u622a\u81f3 {year}\uff0c{location} {percentage} \u7684\u571f\u5730\u8986\u88ab\u662f {threshold} \u70ed\u5e26\u6811\u6728\u8986\u88ab\u3002", "6b63635837f6441827875241ce3079c7": "\u4e0d\u786e\u5b9a\uff1f\u5728\u6b64\u8fdb\u4e00\u6b65\u4e86\u89e3\u6211\u4eec\u7684\u5de5\u5177", "816f5a9b9596e49a2a4bc8dc9b6ec350": "\u5176\u4ed6\u5de5\u5177<svg width=\"32\" height=\"32\" viewBox=\"0 0 32 32\" class=\"icon-arrow\"><path d=\"M31.68 8.593L30.077 6.99c-.214-.214-.46-.321-.738-.321s-.523.107-.737.321L16 19.591 3.399 6.99c-.214-.214-.46-.321-.738-.321s-.524.107-.738.321L.32 8.593c-.214.214-.321.46-.321.738s.107.524.321.737L15.262 25.01c.214.214.46.321.738.321s.523-.107.737-.321L31.68 10.068c.214-.214.32-.46.32-.737s-.106-.524-.32-.738z\"></path></svg>", "d2cee1a540493b0c852ffa71917f56a1": "\u76f4\u63a5\u8bbf\u95ee GFW \u6570\u636e", "1af1ff244fa87490f1028cf25965be17": "\u4e3a\u4ec0\u4e48\u662f\u68ee\u6797", "9995cf98d14e3cdcec12dfd28e98876e": "\u5c06\u60a8\u81ea\u5df1\u7684\u6570\u636e\u4e0e GFW \u6570\u636e\u96c6\u76f8\u7ed3\u5408", "736783c44c97bea8aa5f061a55e93d9f": "\u6cb9\u68d5\u6811\u6df7\u5408\u6797 - 22.0kha", "40473ac67874f79704f71d8bdfda515d": "\u679c\u56ed\u6df7\u5408\u6797 - 113kha", "e2034c4e2afdef90bfdcb880e7cdd881": "\u679c\u56ed - 75.7kha", "a673eefc06f93bed04da53a1f279f9c3": "\u672a\u77e5 - 33.6kha", "f40b11e907e7c33c5003597f653910db": "\u6a61\u80f6\u6811\u6df7\u5408\u6797 - 24.3kha", "0680c8589ddac52394853d40c3384b93": "\u6a61\u80f6\u6811 - 17.8kha", "c3192572c92267f50a09b015420064fc": "\u6cb9\u68d5\u6811 - 387kha", "3bbcb5b45998d529022c999daca93335": "2001 \u5e74\uff0c{location} \u62e5\u6709 {primaryForest} \u539f\u59cb\u68ee\u6797*\uff0c\u8986\u76d6\u5176\u571f\u5730\u9762\u79ef\u7684 {percentagePrimaryForest}\u3002\u5728 {year}\uff0c\u8be5\u5730\u635f\u5931\u4e86{primaryLoss} \u539f\u59cb\u68ee\u6797*\uff0c\u76f8\u5f53\u4e8e {emissionsPrimary} \u7684\u4e8c\u6c27\u5316\u78b3\u6392\u653e\u91cf\u3002\u6839\u636e \u73af\u5883\u548c\u6797\u4e1a\u90e8 (MoEF) \u4e0e\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240 (WRI) \u7684\u5206\u6790\uff0c\u5728\u635f\u5931\u7684\u539f\u59cb\u68ee\u6797\u4e2d\u6709 <b>107 kha</b> \u5c5e\u4e8e\u5370\u5ea6\u5c3c\u897f\u4e9a\u5b98\u65b9\u68ee\u6797\u571f\u5730\u8986\u88ab\u7b49\u7ea7\uff0c\u4e14\u6591\u5757\u9762\u79ef\u8d85\u8fc7\u4e24\u516c\u9877\u3002", "0e7dd29e3c64d3a67956a996d33612f7": "*\u6839\u636e GFW \u5206\u6790\uff0c\u5370\u5ea6\u5c3c\u897f\u4e9a\u7684\u5927\u90e8\u5206\u539f\u59cb\u68ee\u6797\u635f\u5931\u53d1\u751f\u5728\u88ab\u5370\u5ea6\u5c3c\u897f\u4e9a\u5f52\u7c7b\u4e3a\u6b21\u751f\u6797\u548c\u5176\u4ed6\u571f\u5730\u8986\u88ab\uff08\u4f8b\u5982\u6df7\u5408\u65f1\u5730\u519c\u4e1a\u8015\u5730\u3001\u79cd\u690d\u56ed\u4f5c\u7269\u7528\u5730\u3001\u4eba\u5de5\u6797\u3001\u704c\u6728\u7b49\uff09\u7684\u5730\u533a\u3002\u8fd9\u662f\u56e0\u4e3a GFW \u5bf9\u539f\u59cb\u68ee\u6797\u7684\u5b9a\u4e49\u4e0e\u5370\u5ea6\u5c3c\u897f\u4e9a\u5b98\u65b9\u539f\u59cb\u68ee\u6797\u7684\u5b9a\u4e49\u548c\u5206\u7c7b\u4e0d\u540c\u3002\u56e0\u6b64\uff0cGFW \u5173\u4e8e\u5370\u5ea6\u5c3c\u897f\u4e9a\u539f\u59cb\u68ee\u6797\u635f\u5931\u7684\u7edf\u8ba1\u6570\u636e\u8fdc\u9ad8\u4e8e\u5370\u5ea6\u5c3c\u897f\u4e9a\u5b98\u65b9\u5173\u4e8e\u539f\u59cb\u68ee\u6797\u780d\u4f10\u7684\u7edf\u8ba1\u6570\u636e\u3002", "35dd0f218bf43e5e8bce98482721020a": "*\u5370\u5ea6\u5c3c\u897f\u4e9a 2016 \u5e74\u56e0\u706b\u707e\u9020\u6210\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u5b9e\u9645\u5927\u90e8\u5206\u662f\u7531\u4e8e 2015 \u5e74\u7684\u706b\u707e\u9020\u6210\u7684\u3002\u7531\u4e8e\u5e74\u5e95\u7684\u9646\u5730\u536b\u661f\u56fe\u50cf\u4e0d\u591f\u6e05\u6670\uff0c\u8f83\u665a\u624d\u53d1\u73b0\u70e7\u6bc1\u533a\u57df\uff082019 \u5e74\u548c 2020 \u5e74\u7684\u60c5\u51b5\u4e5f\u662f\u5982\u6b64\uff0c\u4f46\u7a0b\u5ea6\u8f83\u5c0f\uff09\u3002", "1a4a06b6aff78a6c7c817c3c1674268f": "\u8fd1\u5e74\u6765\uff082016 \u5e74-2021 \u5e74\uff09\uff0c\u5370\u5ea6\u5c3c\u897f\u4e9a\u7684\u68ee\u6797\u780d\u4f10\u901f\u5ea6\u5df2\u663e\u8457\u653e\u7f13\uff0c\u4e3b\u8981\u539f\u56e0\u662f\u5927\u5b97\u5546\u54c1\u9a71\u52a8\u7684\u6269\u5f20\u51cf\u5c11\u3002\u6839\u636e GFW \u7684\u6570\u636e\uff0c\u5370\u5ea6\u5c3c\u897f\u4e9a\u56e0\u5546\u54c1\u9a71\u52a8\u7684\u68ee\u6797\u780d\u4f10\u800c\u9020\u6210\u7684\u5927\u90e8\u5206\u539f\u59cb\u68ee\u6797\u635f\u5931\u5b9e\u9645\u53d1\u751f\u5728\u88ab\u6cd5\u5f8b\u5f52\u7c7b\u4e3a\u6b21\u751f\u6797\u7684\u5730\u533a\uff0c\u800c\u4e0d\u662f\u539f\u59cb\u68ee\u6797\u3002\u8bf7\u6ce8\u610f\uff0c\u5728\u5bf9 GFW \u5730\u56fe\u4e0a\u7279\u5b9a\u635f\u5931\u6591\u5757\u4e2d\u53d7\u5f71\u54cd\u7684\u68ee\u6797\u7c7b\u578b\u6216\u635f\u5931\u539f\u56e0\u4e0b\u5b9a\u8bba\u524d\uff0c\u5efa\u8bae\u8fdb\u884c\u5b9e\u5730\u6838\u9a8c\u3002", "b2a7aaf9c6c803d53762e18e1f818f36": "2001\u5e74\u52302012\u5e74\uff0c {location}\u7684\u6811\u6728\u8986\u76d6\u9762\u79ef\u589e\u52a0\u4e86{gain}\u3002", "bffa59ad2fbeb759e27017cc5e616089": "\u5bf9\u4e8e\u7528\u4f5c\u6b64\u6570\u636e\u96c6\u7684\u8f93\u5165\u7684 GFW \u4e0a\u7684\u57fa\u672c\u6811\u6728\u8986\u76d6\u51cf\u5c11\u5730\u56fe\uff0c\u5176\u5206\u6790\u65b9\u6cd5\u5df2\u901a\u8fc7\u591a\u79cd\u65b9\u5f0f\u8fdb\u884c\u4fee\u6539\uff0c\u76ee\u7684\u662f\u6539\u8fdb\u5bf9\u706b\u707e\u3001\u70ed\u5e26\u68ee\u6797\u7684\u5c0f\u5bb6\u8f6e\u4f5c\u519c\u4e1a\u3001\u9009\u62e9\u6027\u4f10\u6728\u4ee5\u53ca\u77ed\u5468\u671f\u4eba\u5de5\u6797\u5bfc\u81f4\u7684\u5317\u65b9\u68ee\u6797\u51cf\u5c11\u7684\u63a2\u6d4b\uff0c\u6570\u636e\u6db5\u76d6 2011 \u5e74\u81f3 2022 \u5e74\u8fd9\u6bb5\u65f6\u95f4\u3002\u7531\u4e8e\u5b58\u5728\u8fd9\u4e9b\u53d8\u5316\uff0c\u5728\u6bd4\u8f83 2000 \u5e74\u81f3 2010 \u4e0e 2011 \u5e74\u81f3 2022 \u5e74\u8fd9\u4e24\u4e2a\u65f6\u95f4\u6bb5\u7684\u8d8b\u52bf\u65f6\uff0c\u5e94\u5f53\u614e\u91cd\u3002\u60a8\u53ef\u4ee5<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5728\u6b64\u5904</a>\u8fdb\u4e00\u6b65\u4e86\u89e3\u5efa\u6a21\u8fc7\u7a0b\u7684\u65b0\u60c5\u51b5\u3002", "2d08d7fb1fe98a378588744413b60507": "2001 \u5e74\uff0c\u5370\u5ea6\u5c3c\u897f\u4e9a\u7684\u539f\u59cb\u6797\u9762\u79ef\u4e3a 93.8Mha*\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684 50%\u3002{year} \u5e74\uff0c\u5b83\u635f\u5931\u4e86 230kha \u7684\u539f\u59cb\u6797*\uff0c\u76f8\u5f53\u4e8e 177Mt \u7684 CO\u2082 \u6392\u653e\u91cf\u3002 ", "4ddb76b787e73a34a9a7de79233ea5c0": "\u4ece2001\u5e74\u52302012\u5e74\uff0c{location}\u83b7\u5f97\u7684\u6811\u6728\u8986\u76d6\u5ea6{indicator}\u7b49\u4e8e{parent}\u4e2d\u6240\u6709\u6811\u6728\u8986\u76d6\u5ea6\u589e\u76ca\u7684{gainPercent}\u3002", "10f4ad507be117f6bd499f11eac0ae8b": "\u4ece 2001 \u5e74\u5230 2012 \u5e74\uff0c{location} \u589e\u52a0\u4e86 {gain} \u7684\u6811\u6728\u8986\u76d6\uff0c\u76f8\u5f53\u4e8e\u5168\u7403\u603b\u91cf\u7684 {gainPercent}\u3002", "b1dfc09ac7abc749e577a43095bb8930": "<a href=\"https://trase.earth\" target=\"_blank\" rel=\"noopener noreferrer\">\u6839\u636eTRASE\u7684\u7edf\u8ba1</a>\uff0c\u4ece{startYear}\u5230{endYear}\uff0c\u5305\u62ec\u56fd\u5185\u5e02\u573a\u5728\u5185\uff0c{commodity}\u6700\u5927\u91c7\u8d2d\u56fd\u662f{source}\u3002\u603b\u4ea4\u6613\u91cf\u4e3a{volume}\uff0c\u5360{location}\u603b\u4ea4\u6613\u91cf\u7684{percentage}\u3002", "4f6e32972d699ad017c7382a40dd7e3e": "2023 - \u8d8a\u5357", "6e82d30e0275bfceca3af14292eb14c0": "\u706b\u707e\u786e\u5b9a\u6027\uff1ausers/sashatyu/2001-2023_fire_forest_loss", "0c62d65dadd944274fbc3ec4071840b4": "\u635f\u5931\u65e5\u671f\uff1ausers/sashatyu/2001-2023_fire_forest_loss_annual", "d137bf6e248839f0100c1b47974230b4": "2023 - \u52a0\u7eb3", "ca62407a65faa7d2b2d448182dcdde51": "\u6797\u6728\u8986\u76d6\u589e\u52a0\u7684\u5e74\u4efd\u3002\u6b64\u524d\u4f7f\u7528\u7684\u662f 2000 \u5e74-2012 \u5e74\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Potapov et al. 2022</a> \u4e2d\u63d0\u51fa\u7684 2000 \u5e74-2020 \u5e74\u3002", "0b0e4f760588769e42d637afc3b06216": "\u8981\u4e0b\u8f7d\u6a21\u578b\u6301\u7eed\u671f\u95f4\u7684\u79fb\u9664\u91cf\u6570\u636e\uff0c\u6709\u4e24\u79cd\u4e0d\u540c\u7684\u9762\u79ef\u5355\u4f4d\u53ef\u4f9b\u9009\u62e9\uff1a1) \u5146\u514b\u4e8c\u6c27\u5316\u78b3\u6e05\u9664\u91cf/ha\uff0c2) \u5146\u514b\u4e8c\u6c27\u5316\u78b3\u6e05\u9664\u91cf/\u50cf\u5143\u3002\u7b2c\u4e00\u79cd\u9002\u7528\u4e8e\u53ef\u89c6\u5316\uff08\u6620\u5c04\uff09\u6e05\u9664\u91cf\uff0c\u56e0\u4e3a\u5b83\u4ee3\u8868\u6bcf\u516c\u9877\u7684\u6e05\u9664\u5bc6\u5ea6\u3002\u7b2c\u4e8c\u79cd\u9002\u7528\u4e8e\u8ba1\u7b97\u611f\u5174\u8da3\u533a\u57df (AOI) \u4e2d\u7684\u6e05\u9664\u91cf\uff0c\u56e0\u4e3a AOI \u4e2d\u5404\u4e2a\u50cf\u5143\u7684\u503c\u53ef\u4ee5\u76f8\u52a0\u4ee5\u83b7\u5f97\u8be5\u533a\u57df\u7684\u603b\u6e05\u9664\u91cf\u3002\u540e\u8005\u7684\u503c\u662f\u901a\u8fc7\u6839\u636e\u6bcf\u4e2a\u50cf\u5143\u7684\u5927\u5c0f\u8c03\u6574\u6bcf\u516c\u9877\u7684\u6e05\u9664\u91cf\u6765\u8ba1\u7b97\u7684\uff0c\u6bcf\u4e2a\u50cf\u5143\u7684\u5927\u5c0f\u56e0\u7eac\u5ea6\u800c\u5f02\u3002\u5728\u4f30\u8ba1 2001 \u5e74\u81f3 2023 \u5e74\u671f\u95f4\u6307\u5b9a\u5e74\u9650\u5185\u7684\u6e05\u9664\u91cf\u65f6\uff0c\u9700\u5c06\u603b\u78b3\u6e05\u9664\u91cf\u9664\u4ee5\u6a21\u578b\u6301\u7eed\u671f\u9650\uff0c\u7136\u540e\u4e58\u4ee5\u76f8\u5173\u65f6\u6bb5\u7684\u5e74\u6570\u3002\u4e24\u4e2a\u6570\u636e\u96c6\u5982 Harris et al. (2021) \u7684\u65b9\u6cd5\u4e2d\u6240\u5b9a\u4e49\u7684\uff0c\u4ec5\u5305\u542b\u4e86\u68ee\u6797\u5185\u7684\u50cf\u5143\uff0c\u5e76\u4e14\u6839\u636e\u622a\u81f3 2020 \u5e74\u7684\u6797\u6728\u8986\u76d6\u589e\u91cf\u505a\u4e86\u66f4\u65b0\u3002", "0719c4758d8af0ce74b531b062f1a8ca": "<strong>\u51cf\u5f31</strong>\uff1a\u5728 22 \u5e74\u4e2d\u6709\u8d85\u8fc7 19 \u5e74 (> 90%) \u662f\u7edf\u8ba1\u610f\u4e49\u4e0a\u7684\u70ed\u70b9\u4f4d\u7f6e\u3002\u4e0d\u4ec5\u5982\u6b64\uff0c\u6bcf\u5e74\u9ad8\u8ba1\u6570\u7684\u805a\u96c6\u5f3a\u5ea6\u90fd\u5728\u51cf\u5f31\uff0c\u6216\u8005\u6700\u8fd1\u4e00\u5e74\uff082023 \u5e74\uff09\u4e0d\u662f\u70ed\u70b9\u4f4d\u7f6e\u3002", "e92485fc6e2ebb92ede2159e7e518738": "\u65b0\u5174\u70ed\u70b9\u5206\u6790\u4f7f\u7528\u4e86 2002 \u5e74\u81f3 2023 \u5e74\u95f4\u7684\u5e74\u5ea6\u6797\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u96c6 (Hansen et al. 2013)\u30012001 \u5e74\u539f\u59cb\u68ee\u6797\u8303\u56f4\u6570\u636e\u96c6 (Turubanova et al. 2018)\uff0c\u4ee5\u53ca ESRI ArcGIS \u65b0\u5174\u70ed\u70b9\u5206\u6790\u5730\u7406\u5904\u7406\u5de5\u5177\u3002\u5728\u672c\u5206\u6790\u4e2d\uff0c\u539f\u59cb\u68ee\u6797\u6307\u8fd1\u4ee3\u5386\u53f2\u4e0a\u5c1a\u672a\u88ab\u5b8c\u5168\u6bc1\u574f\u5e76\u518d\u751f\u7684\u6210\u719f\u7684\u5929\u7136\u6e7f\u6da6\u70ed\u5e26\u68ee\u6797\u8986\u76d6\u3002\u68ee\u6797\u635f\u5931\u6307\u201c\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u201d\uff0c\u6216\u9646\u5730\u536b\u661f\u50cf\u7d20\u5c3a\u5ea6\u4e0a\u6797\u6728\u8986\u76d6\u51a0\u5c42\u7684\u5b8c\u5168\u6d88\u9664\u3002\u65b0\u5174\u70ed\u70b9\u5206\u6790\u5de5\u5177\u7ed3\u5408\u4f7f\u7528\u4e24\u79cd\u7edf\u8ba1\u65b9\u6cd5\uff0c\u7528 Getis-Ord Gi* \u7edf\u8ba1\u6765\u786e\u5b9a\u68ee\u6797\u635f\u5931\u7684\u7a7a\u95f4\u805a\u96c6\u4f4d\u7f6e\u548c\u7a0b\u5ea6\uff0c\u7528 Mann-Kendall \u8d8b\u52bf\u68c0\u9a8c\u6765\u8bc4\u4f30\u968f\u65f6\u95f4\u53d8\u5316\u7684\u65f6\u95f4\u8d8b\u52bf\u3002", "7a281fe6771ff488c2147a56c87614e4": "\u6392\u653e\u91cf\u53cd\u6620\u7684\u662f\u4e00\u4e2a\u7c97\u7565\u7684\u4f30\u7b97\uff0c\u5373\u672a\u5305\u62ec\u53d1\u751f\u5e72\u6270\u540e\u68ee\u6797\u518d\u751f\u4ea7\u751f\u7684\u78b3\u6e05\u9664\u91cf\u3002\u800c\u603b\u78b3\u6e05\u9664\u91cf\u8ba1\u5165\u4e86\u9644\u5e26\u7684\u68ee\u6797\u78b3\u6e05\u9664\u56fe\u5c42\u548c\u51c0\u901a\u91cf\u56fe\u5c42\u4e2d\u3002", "c398e438bcfb74c5fb755582fdd91921": "\u8be5\u56fe\u8868\u663e\u793a\u4e86\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\u9020\u6210\u7684\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u6240\u4ea7\u751f\u7684\u5e74\u5ea6\u6e29\u5ba4\u6c14\u4f53<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6392\u653e\u91cf</a>\u3002\u6392\u653e\u91cf\u5305\u62ec\u4e86\u6240\u6709\u76f8\u5173\u7684\u751f\u6001\u7cfb\u7edf\u78b3\u5e93\uff08\u5730\u4e0a\u751f\u7269\u91cf\u3001\u5730\u4e0b\u751f\u7269\u91cf\u3001\u67af\u6728\u3001\u67af\u679d\u8d25\u53f6\u3001\u571f\u58e4\uff09\u548c\u6e29\u5ba4\u6c14\u4f53\uff08\u4e8c\u6c27\u5316\u78b3\u3001\u7532\u70f7\u3001\u4e00\u6c27\u5316\u4e8c\u6c2e\uff09\uff0c\u5e76\u4e14\u5047\u8bbe\u6392\u653e\u90fd\u53d1\u751f\u5728\u5e72\u6270\u5e74\u4efd\u3002<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a> \u4e2d\u63cf\u8ff0\u4e86\u7528\u4e8e\u8ba1\u7b97\u6392\u653e\u91cf\u7684\u65b9\u6cd5\uff0c\u5176\u4e2d\u5f15\u5165\u4e86\u7528\u4e8e\u4f30\u7b97\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u7684\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\u3002\u8fd9\u4e9b\u65b9\u6cd5\u9075\u5faa\u53d1\u751f\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u7684 IPCC <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u6307\u5357\uff0c\u5982 <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a> \u7684\u5168\u7403\u68ee\u6797\u53d8\u5316\u5e74\u5ea6\u6797\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u6240\u793a\u3002<br>\u6392\u653e\u91cf\u53cd\u6620\u7684\u662f\u4e00\u4e2a\u7c97\u7565\u7684\u4f30\u7b97\uff0c\u5373\u672a\u5305\u62ec\u968f\u540e\u68ee\u6797\u518d\u751f\u4ea7\u751f\u7684\u78b3\u6e05\u9664\u91cf\uff08\u5c01\u5b58\uff09\u3002\u6709\u5173\u6240\u9009\u533a\u57df\u7684\u6e05\u9664\u91cf\u548c\u51c0\u901a\u91cf\u7684\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605\u51c0\u901a\u91cf\u56fe\u3002\u6392\u653e\u91cf\u5305\u62ec\u9ad8\u4e8e\u6240\u9009\u6797\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u5730\u533a\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\uff0c\u4ee5\u53ca\u6797\u6728\u8986\u76d6\u867d\u589e\u52a0\u4f46\u672a\u8fbe\u5230\u6797\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u5730\u533a\u3002<br><br>\u6797\u6728\u8986\u76d6\u635f\u5931\u3001<a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u9a71\u52a8\u56e0\u7d20</a>\u548c\u70e7\u6bc1\u9762\u79ef\u6bcf\u5e74\u90fd\u4f1a\u66f4\u65b0\u3002\u5728 2023 \u5e74\u548c 2024 \u5e74\uff0c\u5176\u4e2d\u7684\u4e00\u4e9b\u6a21\u578b\u8f93\u5165\u6570\u636e\u96c6\u548c\u5e38\u91cf\u4e5f\u53d1\u751f\u4e86\u53d8\u5316\uff0c\u5177\u4f53\u5982\u4e0b\u3002\u8bf7\u53c2\u9605<a href=\"{{5}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8fd9\u7bc7\u535a\u6587</a>\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002<br><br>1. \u5730\u4e0b\u78b3\u4e0e\u5730\u4e0a\u78b3\u6bd4\u503c\u7684\u6765\u6e90\u3002\u6b64\u524d\u4f7f\u7528\u7684\u662f\u4e00\u4e2a\u5168\u5c40\u5e38\u91cf\uff1b\u73b0\u5728\u53c2\u7167<a href=\"{{6}}\" target=\"_blank\" rel=\"noopener noreferrer\">Huang et al. 2021</a> \u4e2d\u63d0\u4f9b\u7684\u5730\u56fe\u3002&nbsp;<br>2. \u6797\u6728\u8986\u76d6\u589e\u52a0\u7684\u5e74\u4efd\u3002\u6b64\u524d\u4f7f\u7528\u7684\u662f 2000 \u5e74-2012 \u5e74\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{7}}\" target=\"_blank\" rel=\"noopener noreferrer\">Potapov et al. 2022</a> \u4e2d\u63d0\u51fa\u7684 2000 \u5e74-2020 \u5e74\u3002&nbsp;<br>3. \u706b\u707e\u6570\u636e\u6765\u6e90\u3002\u6b64\u524d\u4f7f\u7528\u7684\u662f MODIS \u6d4b\u5f97\u7684\u70e7\u6bc1\u533a\u57df\uff1b\u73b0\u5728\u53c2\u7167 <a href=\"{{8}}\" target=\"_blank\" rel=\"noopener noreferrer\">Tyukavina et al. 2022</a> \u4e2d\u6d4b\u5f97\u7684\u706b\u707e\u9020\u6210\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u3002<br>4. \u6ce5\u70ad\u5730\u56fe\u7684\u6765\u6e90\u3002\u65b0\u589e\u4e86\u70ed\u5e26\u6570\u636e\u96c6\uff0c\u5e76\u66f4\u6539\u4e86\u5317\u7eac 40 \u5ea6\u4ee5\u4e0a\u7684\u6570\u636e\u96c6\u3002&nbsp;<br>5. CH4 \u548c N2O \u7684\u5168\u7403\u53d8\u6696\u6f5c\u52bf (GWP) \u5e38\u6570\u3002\u6b64\u524d\u4f7f\u7528\u7684 GWP \u6765\u81ea IPCC \u7b2c\u4e94\u6b21\u8bc4\u4f30\u62a5\u544a\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{9}}\" target=\"_blank\" rel=\"noopener noreferrer\">IPCC \u7b2c\u516d\u6b21\u8bc4\u4f30\u62a5\u544a</a>\u4e2d\u7684 GWP\u3002<br>6. \u8f83\u8001\u7684\uff0820 \u5e74\u4ee5\u4e0a\uff09\u6b21\u751f\u6e29\u5e26\u68ee\u6797\u7684\u6e05\u9664\u56e0\u5b50\u53ca\u5176\u76f8\u5173\u7684\u4e0d\u786e\u5b9a\u6027\u3002\u6b64\u524d\u4f7f\u7528\u7684\u6e05\u9664\u56e0\u5b50\u89c1 \u300a2006 \u5e74 IPCC \u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355\u6307\u5357 2019 \u4fee\u8ba2\u7248\u300b<a href=\"{{10}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8868 4.9</a>\uff1b\u73b0\u5728\u4f7f\u7528\u7684\u662f\u300a2006 \u5e74 IPCC \u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355\u6307\u5357 2019 \u4fee\u8ba2\u7248\u300b<a href=\"{{11}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u7b2c\u56db\u6b21\u66f4\u6b63</a>\u4e2d\u4fee\u6b63\u7684\u6e05\u9664\u56e0\u5b50\u548c\u4e0d\u786e\u5b9a\u6027\u3002<br>7. \u690d\u6811\u7684\u8303\u56f4\u548c\u6e05\u9664\u56e0\u5b50\u3002\u6b64\u524d\u4f7f\u7528\u690d\u6811\u7a7a\u95f4\u6570\u636e\u5e93 (SDPT) <a href=\"{{12}}\" target=\"_blank\" rel=\"noopener noreferrer\">1.0 \u7248</a>\uff1b\u73b0\u5728\u4f7f\u7528 SDPT<a href=\"{{13}}\" target=\"_blank\" rel=\"noopener noreferrer\"> 2.0 \u7248</a>\u548c\u76f8\u5173\u7684\u6e05\u9664\u56e0\u5b50\u3002", "2987ea5c524cadfbc238b72d2a439df0": "\u8be5\u56fe\u8868\u663e\u793a\u4e86 2001 \u5e74\u81f3 2023 \u5e74\u95f4\u68ee\u6797\u4e0e\u5927\u6c14\u4e4b\u95f4\u6e29\u5ba4\u6c14\u4f53\u7684\u5e73\u5747\u5e74<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6392\u653e\u91cf</a>\u3001<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6e05\u9664\u91cf</a>\uff08\u5c01\u5b58\uff09\u4ee5\u53ca<a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u51c0\u901a\u91cf</a>\u3002 2023\u3002<a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a> \u4e2d\u63cf\u8ff0\u4e86\u7528\u4e8e\u8ba1\u7b97\u6392\u653e\u91cf\u7684\u65b9\u6cd5\uff0c\u5176\u4e2d\u5f15\u5165\u4e86\u7528\u4e8e\u4f30\u7b97\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u7684\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\u3002\u8fd9\u4e9b\u65b9\u6cd5\u9075\u5faa IPCC <a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u6307\u5357\u3002\u6392\u653e\u662f\u7531\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u5f15\u8d77\u7684\uff0c\u800c\u6e05\u9664\u5219\u53d1\u751f\u5728\u68ee\u6797\u7ef4\u6301\u6216\u6269\u5f20\u7684\u5730\u65b9\u3002\u6392\u653e\u91cf\u5305\u62ec\u4e86\u6240\u6709\u76f8\u5173\u7684\u751f\u6001\u7cfb\u7edf\u78b3\u5e93\uff08\u5730\u4e0a\u751f\u7269\u91cf\u3001\u5730\u4e0b\u751f\u7269\u91cf\u3001\u67af\u6728\u3001\u67af\u679d\u8d25\u53f6\u3001\u571f\u58e4\uff09\u548c\u6e29\u5ba4\u6c14\u4f53\uff08\u4e8c\u6c27\u5316\u78b3\u3001\u7532\u70f7\u3001\u4e00\u6c27\u5316\u4e8c\u6c2e\uff09\uff0c\u800c\u6e05\u9664\u91cf\u5219\u5206\u4e3a\u5730\u4e0a\u548c\u5730\u4e0b\u751f\u7269\u91cf\u5e93\u3002", "64e44b8f994e6facdefb82746c4125e6": "\u6797\u6728\u8986\u76d6\u635f\u5931\u3001\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u9a71\u52a8\u56e0\u7d20\u548c\u70e7\u6bc1\u9762\u79ef\u6bcf\u5e74\u90fd\u4f1a\u66f4\u65b0\u3002\u5728 2023 \u5e74\u548c 2024 \u5e74\uff0c\u5176\u4e2d\u7684\u4e00\u4e9b\u6a21\u578b\u8f93\u5165\u6570\u636e\u96c6\u548c\u5e38\u91cf\u4e5f\u53d1\u751f\u4e86\u53d8\u5316\uff0c\u5177\u4f53\u5982\u4e0b\u3002\u8bf7\u53c2\u9605<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8fd9\u7bc7\u535a\u6587</a>\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002<br><br>1. \u5730\u4e0b\u78b3\u4e0e\u5730\u4e0a\u78b3\u6bd4\u503c\u7684\u6765\u6e90\u3002\u6b64\u524d\u4f7f\u7528\u7684\u662f\u4e00\u4e2a\u5168\u5c40\u5e38\u91cf\uff1b\u73b0\u5728\u53c2\u7167<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Huang et al. 2021</a> \u4e2d\u63d0\u4f9b\u7684\u5730\u56fe\u3002&nbsp;<br>2. \u6797\u6728\u8986\u76d6\u589e\u52a0\u7684\u5e74\u4efd\u3002\u6b64\u524d\u4f7f\u7528\u7684\u662f 2000 \u5e74-2012 \u5e74\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Potapov et al. 2022</a> \u4e2d\u63d0\u51fa\u7684 2000 \u5e74-2020 \u5e74\u3002&nbsp;<br>3. \u706b\u707e\u6570\u636e\u6765\u6e90\u3002\u6b64\u524d\u4f7f\u7528\u7684\u662f MODIS \u6d4b\u5f97\u7684\u70e7\u6bc1\u533a\u57df\uff1b\u73b0\u5728\u53c2\u7167 <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Tyukavina et al. 2022</a> \u4e2d\u6d4b\u5f97\u7684\u706b\u707e\u9020\u6210\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u3002<br>4. \u6ce5\u70ad\u5730\u56fe\u7684\u6765\u6e90\u3002\u65b0\u589e\u4e86\u70ed\u5e26\u6570\u636e\u96c6\uff0c\u5e76\u66f4\u6539\u4e86\u5317\u7eac 40 \u5ea6\u4ee5\u4e0a\u7684\u6570\u636e\u96c6\u3002&nbsp;<br>5. CH4 \u548c N2O \u7684\u5168\u7403\u53d8\u6696\u6f5c\u52bf (GWP) \u5e38\u6570\u3002\u6b64\u524d\u4f7f\u7528\u7684 GWP \u6765\u81ea IPCC \u7b2c\u4e94\u6b21\u8bc4\u4f30\u62a5\u544a\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">IPCC \u7b2c\u516d\u6b21\u8bc4\u4f30\u62a5\u544a</a>\u4e2d\u7684 GWP\u3002<br>6. \u8f83\u8001\u7684\uff0820 \u5e74\u4ee5\u4e0a\uff09\u6b21\u751f\u6e29\u5e26\u68ee\u6797\u7684\u6e05\u9664\u56e0\u5b50\u53ca\u5176\u76f8\u5173\u7684\u4e0d\u786e\u5b9a\u6027\u3002\u6b64\u524d\u4f7f\u7528\u7684\u6e05\u9664\u56e0\u5b50\u89c1 \u300a2006 \u5e74 IPCC \u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355\u6307\u5357 2019 \u4fee\u8ba2\u7248\u300b<a href=\"{{5}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8868 4.9</a>\uff1b\u73b0\u5728\u4f7f\u7528\u7684\u662f\u300a2006 \u5e74 IPCC \u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355\u6307\u5357 2019 \u4fee\u8ba2\u7248\u300b<a href=\"{{6}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u7b2c\u56db\u6b21\u66f4\u6b63</a>\u4e2d\u4fee\u6b63\u7684\u6e05\u9664\u56e0\u5b50\u548c\u4e0d\u786e\u5b9a\u6027\u3002<br>7. \u690d\u6811\u7684\u8303\u56f4\u548c\u6e05\u9664\u56e0\u5b50\u3002\u6b64\u524d\u4f7f\u7528\u690d\u6811\u7a7a\u95f4\u6570\u636e\u5e93 (SDPT) <a href=\"{{7}}\" target=\"_blank\" rel=\"noopener noreferrer\">1.0 \u7248</a>\uff1b\u73b0\u5728\u4f7f\u7528 SDPT<a href=\"{{8}}\" target=\"_blank\" rel=\"noopener noreferrer\"> 2.0 \u7248</a>\u548c\u76f8\u5173\u7684\u6e05\u9664\u56e0\u5b50\u3002", "e8effb5e720488df3d427f6918e626f6": "\u8be5\u6392\u653e\u56fe\u5c42\u662f <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a> \u4e2d\u63cf\u8ff0\u7684\u68ee\u6797\u78b3\u901a\u91cf\u6a21\u578b\u7684\u4e00\u90e8\u5206\u3002\u8fd9\u7bc7\u6587\u7ae0\u4ecb\u7ecd\u4e86\u4e00\u4e2a\u7528\u4e8e\u4f30\u7b97\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u7684\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u8be5\u6846\u67b6\u53ef\u4ee5\u5e2e\u52a9\u5404\u79cd\u53c2\u4e0e\u8005\u548c\u7ec4\u7ec7\u8ddf\u8e2a\u68ee\u6797\u7684\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf\u5e76\u636e\u6b64\u51cf\u5c11\u6392\u653e\u91cf\u6216\u589e\u52a0\u68ee\u6797\u7684\u78b3\u6e05\u9664\u91cf\u3002\u68ee\u6797\u78b3\u6392\u653e\u91cf\u4ee3\u8868\u6bcf\u4e2a\u6a21\u62df\u5e74\u4efd\u53d1\u751f\u7684\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u6240\u4ea7\u751f\u7684\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u91cf\uff082001 \u5e74\u81f3 2023 \u5e74\u7684\u4e8c\u6c27\u5316\u78b3\u6392\u653e\u91cf\uff0c\u5355\u4f4d\uff1a\u5146\u514b/ha\uff09\u3002\u6392\u653e\u91cf\u5305\u62ec\u4e86\u6240\u6709\u76f8\u5173\u7684\u751f\u6001\u7cfb\u7edf\u78b3\u5e93\uff08\u5730\u4e0a\u751f\u7269\u91cf\u3001\u5730\u4e0b\u751f\u7269\u91cf\u3001\u67af\u6728\u3001\u67af\u679d\u8d25\u53f6\u3001\u571f\u58e4\u6709\u673a\u78b3\uff09\u548c\u6e29\u5ba4\u6c14\u4f53\uff08\u4e8c\u6c27\u5316\u78b3\u3001\u7532\u70f7\u3001\u4e00\u6c27\u5316\u4e8c\u6c2e\uff09\u3002\u6bcf\u4e2a\u50cf\u5143\u7684\u6392\u653e\u4f30\u7b97\u503c\u662f\u6839\u636e\u53d1\u751f\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u7684 IPCC <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u6307\u5357\u8ba1\u7b97\u7684\uff0c\u5982 <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a> \u7684\u5168\u7403\u68ee\u6797\u53d8\u5316\u5e74\u5ea6\u6797\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u6240\u793a\u3002\u6bcf\u4e2a\u50cf\u5143\u7684\u78b3\u6392\u653e\u91cf\u57fa\u4e8e 2000 \u5e74\u7684\u78b3\u5bc6\u5ea6\uff0c\u5e76\u6839\u636e 2000 \u5e74\u81f3\u5e72\u6270\u5e74\u4efd\u671f\u95f4\u79ef\u7d2f\u7684\u78b3\u8fdb\u884c\u4e86\u8c03\u6574\u3002", "7c0f3e8225d1d1b9b000a5c20c1ebba5": "\u5730\u4e0b\u751f\u7269\u91cf\u78b3\u4e0e\u5730\u4e0a\u751f\u7269\u91cf\u78b3\u6bd4\u503c\u7684\u6765\u6e90\u3002\u6b64\u524d\u4f7f\u7528\u7684\u662f\u4e00\u4e2a\u5168\u5c40\u5e38\u91cf\uff1b\u73b0\u5728\u53c2\u7167 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Huang et al. 2021</a> \u4e2d\u63d0\u4f9b\u7684\u5730\u56fe", "7dabcef2b1b4e6c0cb2dcf51809373b3": "\u8f83\u8001\u7684\uff0820 \u5e74\u4ee5\u4e0a\uff09\u6b21\u751f\u6e29\u5e26\u68ee\u6797\u7684\u6e05\u9664\u56e0\u5b50\u53ca\u5176\u76f8\u5173\u7684\u4e0d\u786e\u5b9a\u6027\u3002\u6b64\u524d\u4f7f\u7528\u7684\u6e05\u9664\u56e0\u5b50\u89c1 \u300a2006 \u5e74 IPCC \u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355\u6307\u5357 2019 \u4fee\u8ba2\u7248\u300b<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8868 4.9</a>\uff1b\u73b0\u5728\u4f7f\u7528\u7684\u662f \u300a2006 \u5e74 IPCC \u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355\u6307\u5357 2019 \u4fee\u8ba2\u7248\u300b\u7b2c\u56db\u6b21\u66f4\u6b63\u4e2d\u4fee\u6b63\u7684\u6e05\u9664\u56e0\u5b50\u548c\u4e0d\u786e\u5b9a\u6027\u3002", "90371fdd4ea1f499b03f768c30d37672": "\u8981\u4e0b\u8f7d\u6392\u653e\u91cf\u6570\u636e\uff0c\u6709\u4e24\u79cd\u4e0d\u540c\u7684\u9762\u79ef\u5355\u4f4d\u53ef\u4f9b\u9009\u62e9\uff1a1) \u5146\u514b\u4e8c\u6c27\u5316\u78b3\u6392\u653e\u91cf/ha\uff0c2) \u5146\u514b\u4e8c\u6c27\u5316\u78b3\u6392\u653e\u91cf/\u50cf\u5143\u3002\u7b2c\u4e00\u79cd\u9002\u7528\u4e8e\u53ef\u89c6\u5316\uff08\u6620\u5c04\uff09\u6392\u653e\u91cf\uff0c\u56e0\u4e3a\u5b83\u4ee3\u8868\u6bcf\u516c\u9877\u7684\u6392\u653e\u5bc6\u5ea6\u3002\u7b2c\u4e8c\u79cd\u9002\u7528\u4e8e\u8ba1\u7b97\u611f\u5174\u8da3\u533a\u57df (AOI) \u4e2d\u7684\u6392\u653e\u91cf\uff0c\u56e0\u4e3a AOI \u4e2d\u5404\u4e2a\u50cf\u5143\u7684\u503c\u53ef\u4ee5\u76f8\u52a0\u4ee5\u83b7\u5f97\u8be5\u533a\u57df\u7684\u603b\u6392\u653e\u91cf\u3002\u540e\u8005\u7684\u503c\u662f\u901a\u8fc7\u6839\u636e\u6bcf\u4e2a\u50cf\u5143\u7684\u5927\u5c0f\u8c03\u6574\u6bcf\u516c\u9877\u7684\u6392\u653e\u91cf\u6765\u8ba1\u7b97\u7684\uff0c\u6bcf\u4e2a\u50cf\u5143\u7684\u5927\u5c0f\u56e0\u7eac\u5ea6\u800c\u5f02\u3002\u4e24\u4e2a\u6570\u636e\u96c6\u5982 Harris et al. (2021) \u7684\u65b9\u6cd5\u4e2d\u6240\u5b9a\u4e49\u7684\uff0c\u4ec5\u5305\u542b\u4e86\u68ee\u6797\u5185\u7684\u50cf\u5143\uff0c\u5e76\u4e14\u6839\u636e\u622a\u81f3 2020 \u5e74\u7684\u6797\u6728\u8986\u76d6\u589e\u91cf\u505a\u4e86\u66f4\u65b0\u3002", "880f5bdb7d5b96cd7a8dd151b2a2d973": "\u51c0\u901a\u91cf\u53cd\u6620\u4e86 2001-2023 \u5e74\u6a21\u578b\u6301\u7eed\u671f\u95f4\u7684\u603b\u91cf\uff0c\u800c\u4e0d\u662f\u53ef\u4ee5\u5f97\u51fa\u8d8b\u52bf\u7684\u5e74\u5ea6\u65f6\u95f4\u5e8f\u5217\u3002\u56e0\u6b64\uff0c\u503c\u5fc5\u987b\u9664\u4ee5 23 \u624d\u80fd\u8ba1\u7b97\u5e73\u5747\u5e74\u51c0\u901a\u91cf\u3002", "2fe0ba6b257e7e9fc3763b49af94a6b2": "\u76f8\u6bd4\u4e8e\u6392\u653e\u91cf\uff0c\u603b\u6e05\u9664\u91cf\u7684\u4e0d\u786e\u5b9a\u6027\u8981\u66f4\u9ad8\uff0c\u975e\u5e38\u53d7\u6e05\u9664\u56e0\u5b50\u7684\u4e0d\u786e\u5b9a\u6027\u5f71\u54cd\u3002\u8fd9\u4e9b\u4e0d\u786e\u5b9a\u6027\u4f1a\u52a0\u5267\u51c0\u901a\u91cf\u7684\u4e0d\u786e\u5b9a\u6027\u3002", "41df39957fabd85bf89a23ead6acb508": "\u6570\u503c\u9002\u7528\u4e8e\u68ee\u6797\u533a\u57df\uff08\u6811\u51a0\u8986\u76d6\u7387 > 30% \u4e14\u9ad8\u5ea6 > 5 \u7c73)\u3002\u6709\u5173\u5206\u6790\u4e2d\u4f7f\u7528\u7684\u68ee\u6797\u5b9a\u4e49\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605 Harris et al.(2021)\u3002", "b0cf779af7db9b217cddda1f529e0f97": "\u6e05\u9664\u6570\u636e\u5b58\u5728\u65f6\u95f4\u4e0a\u7684\u4e0d\u4e00\u81f4\uff0c\u56e0\u4e3a\u6797\u6728\u8986\u76d6\u589e\u91cf\u4ee3\u8868 2000 \u5e74\u81f3 2020 \u5e74\u7684\u7d2f\u79ef\u603b\u91cf\uff0c\u800c\u4e0d\u662f\u622a\u81f3 2023 \u5e74\u4f30\u8ba1\u7684\u5e74\u589e\u91cf\u3002", "3a81a5ee84354b03ee97f4dcef16691b": "\u6bcf 6-12  \u5929\uff0c10 m\uff0c \u6f6e\u6e7f\u70ed\u5e26\u5730\u533a\uff0c WUR", "c429e93faa985e6565df1c629b436102": "5 \u5929\uff0c10 m\uff0c\u4e9a\u9a6c\u900a\uff0cUMD/GLAD", "c155daebe9612f46d944172b0fa11c07": "8  \u5929\uff0c30 m\uff0c\u70ed\u5e26\u5730\u533a\uff0cUMD/GLAD", "b7f91c5d85ccb6d3c6359baa778f7c6d": "\u6574\u5408\u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5<span class=\"citation\">GLAD-L/GLAD-S2/RADD \u6574\u5408\u5c42\u3002\u6570\u636e\u6765\u81ea UMD \u548c WUR\u3002GLAD-L \u8b66\u62a5\u91cd\u65b0\u91c7\u6837\uff0c\u4ece 30 m \u5230 10 m\u3002</span><svg class=\"c-icon icon-arrow \" viewBox=\"0 0 32 32\"><use xlink:href=\"#arrow-down-394c3635--sprite\"></use></svg>", "315c4ce59d8d48fd73cad809a0cf6a3a": "GLAD-L/GLAD-S2/RADD \u7684\u6574\u5408\u5c42\u3002\u6570\u636e\u6765\u81ea UMD \u548c WUR\u3002GLAD-L \u8b66\u62a5\u91cd\u65b0\u91c7\u6837\uff0c\u4ece 30 m \u5230 10 m\u3002", "9f638ea5b05427be4f69d2df0ad5bf77": "GLAD-S2 \u8b66\u62a5<span class=\"citation\">5 \u5929\uff0c10 m\uff0c\u4e9a\u9a6c\u900a\uff0cUMD/GLAD</span><svg class=\"c-icon icon-arrow \" viewBox=\"0 0 32 32\"><use xlink:href=\"#arrow-down-394c3635--sprite\"></use></svg>", "865bbe19161e75d09819970521f84638": "RADD \u8b66\u62a5<span class=\"citation\">\u6bcf 6-12 \u5929\uff0c10 m\uff0c\u6f6e\u6e7f\u70ed\u5e26\u5730\u533a\uff0cWUR</span><svg class=\"c-icon icon-arrow \" viewBox=\"0 0 32 32\"><use xlink:href=\"#arrow-down-394c3635--sprite\"></use></svg>", "25cdf3e064dfd2b58425ffc70759dabd": "2020\u5e74\uff0c10 \u7c73/0.5 \u516c\u9877\uff0c\u70ed\u5e26\uff0c\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240", "ec53224f6f5e1fe6ea814b2213e093df": "GLAD-L \u8b66\u62a5<span class=\"citation\">8 \u5929\uff0c30 m\uff0c\u70ed\u5e26\u5730\u533a\uff0cUMD/GLAD</span><svg class=\"c-icon icon-arrow \" viewBox=\"0 0 32 32\"><use xlink:href=\"#arrow-down-394c3635--sprite\"></use></svg>", "cbcf55c0f8858458051fbd753ad4e8a8": "2001 \u5e74\uff0c30 m\uff0c\u6cdb\u70ed\u5e26\uff0cUMD", "f638dc42b90340025aeadd2b6c2bf593": "\u63a2\u7d22\u603b\u7ed3\u68ee\u6797\u5728 {area} \u6c14\u5019\u53d8\u5316\u4e2d\u6240\u8d77\u4f5c\u7528\u7684\u4ea4\u4e92\u5f0f\u56fe\u8868\u548c\u5730\u56fe\u3002\u68ee\u6797\u78b3\u7edf\u8ba1\u2014\u2014\u5305\u62ec\u68ee\u6797\u5982\u4f55\u50a8\u5b58\u3001\u6392\u653e\u548c\u5c01\u5b58\uff08\u6e05\u9664\uff09\u78b3\u2014\u2014\u53ef\u5b9a\u5236\u4e14\u6613\u4e8e\u5206\u4eab\u548c\u4e0b\u8f7d\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u3002", "80b787c4b44d40e2aa9b6d62b890be21": "2000/2020, 30 m, global, UMD/NASA GEDI", "ce49867d5290f2d02b9c3cf75afd4004": "\u6bcf\u5e74\uff0c300 m\uff0c\u5168\u7403\uff0cWCS", "18c1222c9028b6a42d03d2f940ad07d7": "\u8be5\u5730\u533a\u7684\u6816\u606f\u5730\u5305\u542b{eco_0}\u3002\u6b64\u533a\u57df\u6ca1\u6709\u672a\u53d7\u4fb5\u6270\u7684\u539f\u59cb\u6797\u3002\u8be5\u5730\u533a\u4e3b\u8981\u662f{kop_0}\u3002\u5b83\u662f{bio_0}\u751f\u7269\u7fa4\u843d\u7684\u4e00\u90e8\u5206\u3002\u8fd9\u4e2a\u5730\u70b9\u4e3b\u8981\u662f{lsf_0}\u3002{area_0}\u533a\u57df\u4f4d\u4e8e{area_1}\u3002", "446ca2a5124cd442a2b7cbaadffab328": "30 m\uff0c\u5168\u7403\uff0c\u591a\u4e2a\u6765\u6e90", "efa500dcfa36d5401e8e952ecb3b9170": "\u6bcf\u5e74\uff0c30 m\uff0c\u5168\u7403\uff0cHansen/UMD/Google/USGS/NASA", "ace6600ecbd4e033aa0ec879a0e8f497": "30 m\uff0c\u5168\u7403\uff0c2001-2022, Harris \u7b49\uff0c2021 \u5e74", "9e6f6df07f80f831e5390553c3b05c39": "\u6bcf\u5e74\uff0c30 m\uff0c\u5168\u7403\uff0cUMD/GLAD", "4bf2e546df152bd16c06e72e4f64a11a": "30 m, global, Harris et al. 2021", "dde97f5bc02730d9d5a081d9648cab50": "20 \u5e74\uff0c30 m\uff0c\u5168\u7403\uff0cHansen/UMD/Google/USGS/NASA", "fae1c169067a32f5aa6349b087eaa77c": "20 \u5e74\uff0c30 m\uff0c\u5168\u7403\uff0cHansen/UMD/Google/USGS/NASA", "aeec4f1cc2d54eb453a53e46d8462946": "2001-2022, 10 km, \u5168\u7403, Hansen/UMD/Google/USGS/NASA", "81f091d5695ea58a6e9f96a5f9a6400f": "\u5168\u7403\u706b\u707e\u8b66\u62a5\u6570\u91cf\u6700\u591a\u7684\u5730\u533a", "b9a1217e7a4a2d5cd0812a75c51e72af": "\u5728\u524d{timeframe}\u4e2d\uff0c<b>\u5168\u7403</b>{significant}\u706b\u707e\u8b66\u62a5\u6570\u91cf\u6700\u591a\u7684\u662f{topRegion}\uff0c\u5171\u6709{topRegionCount}\u6b21\u706b\u707e\u8b66\u62a5\u3002\u8fd9\u5360{location}\u4fa6\u6d4b\u5230\u7684\u6240\u6709\u8b66\u62a5\u7684{topRegionPerc}\uff0c\u76f8\u6bd4<b>2012\u5e74</b>\u540c\u671f\u706b\u707e\u6570\u91cf\u504f{status}\u3002", "85a1d51500376ac2a86e7fdca2ca6d6f": "2001 \u81f3 2020 \u5e74\u95f4\uff0c{location} \u7684\u6797\u6728\u8986\u76d6\u91cf\u589e\u52a0\u4e86 {gain}\uff0c\u8fd9\u76f8\u5f53\u4e8e\u5176\u603b\u91cf\u7684 {gainPercent}\u3002", "d56f624f52379e2788cadc3c74f8e627": "\u8be5\u51c0\u901a\u91cf\u56fe\u5c42\u662f Harris et al.(2021) \u4e2d\u63cf\u8ff0\u7684\u68ee\u6797\u78b3\u901a\u91cf\u6a21\u578b\u7684\u4e00\u90e8\u5206\u3002\u8fd9\u8fd9\u7bc7\u6587\u7ae0\u4ecb\u7ecd\u4e86\u4e00\u4e2a\u7528\u4e8e\u4f30\u7b97\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u7684\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u8be5\u6846\u67b6\u53ef\u4ee5\u5e2e\u52a9\u5404\u79cd\u53c2\u4e0e\u8005\u548c\u7ec4\u7ec7\u8ddf\u8e2a\u68ee\u6797\u7684\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf\u5e76\u636e\u6b64\u51cf\u5c11\u6392\u653e\u91cf\u6216\u589e\u52a0\u68ee\u6797\u7684\u78b3\u6e05\u9664\u91cf\u3002\u68ee\u6797\u51c0\u78b3\u901a\u91cf\u4ee3\u8868\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u78b3\u7684\u51c0\u635f\u5931\uff0c\u8ba1\u7b97\u4e3a\u6a21\u578b\u6301\u7eed\u671f\u95f4\u68ee\u6797\u6392\u653e\u7684\u78b3\u4e0e\u68ee\u6797\u6e05\u9664\uff08\u6216\u5c01\u5b58\uff09\u7684\u78b3\u4e4b\u95f4\u7684\u5dee\u503c\u3002\u51c0\u78b3\u901a\u91cf\u7684\u8ba1\u7b97\u65b9\u6cd5\u662f\u4ece\u6bcf\u4e2a\u68ee\u6797\u50cf\u5143\u7684\u5e74\u603b\u6392\u653e\u91cf\u4e2d\u51cf\u53bb\u5e73\u5747\u603b\u53bb\u9664\u91cf\uff1b\u8d1f\u503c\u8868\u793a\u68ee\u6797\u5728 2001 \u5e74\u81f3 2023 \u5e74\u671f\u95f4\u662f\u51c0\u78b3\u6c47\uff0c\u6b63\u503c\u8868\u793a\u68ee\u6797\u5728 2001 \u5e74\u81f3 2023 \u5e74\u671f\u95f4\u662f\u51c0\u78b3\u6e90\u3002\u6839\u636e <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Potapov et al. 2022</a> \u7684\u7814\u7a76\uff0c2000 \u5e74\u5c31\u5b58\u5728\u68ee\u6797\u6216 2000 \u5e74\u81f3 2020 \u5e74\u671f\u95f4\u5efa\u7acb\u68ee\u6797\u7684\u6bcf\u4e2a\u50cf\u5143\u7684\u51c0\u901a\u91cf\u662f\u6839\u636e IPCC \u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355\u6307\u5357\u6765\u8ba1\u7b97\u7684\u3002\u8be5\u56fe\u5c42\u53cd\u6620\u7684\u662f\u6a21\u578b\u6301\u7eed\u671f\u95f4\uff082001 \u5e74-2023 \u5e74\uff09\u7684\u7d2f\u79ef\u51c0\u901a\u91cf\uff0c\u5fc5\u987b\u9664\u4ee5 23 \u624d\u80fd\u83b7\u5f97\u5e73\u5747\u5e74\u51c0\u901a\u91cf\uff1b\u4e0d\u80fd\u5c06\u51c0\u901a\u91cf\u503c\u5206\u914d\u5230\u6a21\u578b\u4e2d\u7684\u5355\u4e2a\u5e74\u4efd\u3002\u6240\u6709\u8f93\u5165\u56fe\u5c42\u5747\u91cd\u65b0\u91c7\u6837\uff0c\u91c7\u7528\u4e0e Hansen et al. (2013) \u76f8\u540c\u7684\u5206\u8fa8\u7387\uff0c\u5373\u6bcf\u5c42 0.00025 \u00d7 0.00025 \u5ea6\u3002", "45e12504551b71ff37c7135c91c78ca7": "2001 \u5e74-2023 \u5e74\u68ee\u6797\u78b3\u6e05\u9664\u91cf", "700f2f232e65443596bf157be45e7ace": "\u8be5\u78b3\u6e05\u9664\u56fe\u5c42\u662f <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a> \u4e2d\u63cf\u8ff0\u7684\u68ee\u6797\u78b3\u901a\u91cf\u6a21\u578b\u7684\u4e00\u90e8\u5206\u3002\u8fd9\u8fd9\u7bc7\u6587\u7ae0\u4ecb\u7ecd\u4e86\u4e00\u4e2a\u7528\u4e8e\u4f30\u7b97\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u7684\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\uff0c\u8be5\u6846\u67b6\u53ef\u4ee5\u5e2e\u52a9\u5404\u79cd\u53c2\u4e0e\u8005\u548c\u7ec4\u7ec7\u8ddf\u8e2a\u68ee\u6797\u7684\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf\u5e76\u636e\u6b64\u51cf\u5c11\u6392\u653e\u91cf\u6216\u589e\u52a0\u68ee\u6797\u7684\u78b3\u6e05\u9664\u91cf\u3002\u68ee\u6797\u6c47\u4ece\u5927\u6c14\u4e2d\u6e05\u9664\u7684\u78b3\uff08\u5c01\u5b58\uff09\u4ee3\u8868 2001-2023 \u5e74\u6a21\u578b\u6301\u7eed\u671f\u95f4\u5df2\u5efa\u548c\u65b0\u518d\u690d\u68ee\u6797\u751f\u957f\u6240\u6355\u83b7\u7684\u7d2f\u79ef\u78b3\uff08\u5146\u514b\u4e8c\u6c27\u5316\u78b3/ha\uff09\u3002\u6e05\u9664\u91cf\u5305\u62ec\u5730\u4e0a\u548c\u5730\u4e0b\u6d3b\u4f53\u6811\u6728\u751f\u7269\u91cf\u4e2d\u7684\u78b3\u79ef\u7d2f\u3002\u6309\u7167 IPCC \u7b2c\u4e00\u7ea7\u5047\u8bbe\u7684\u6797\u5730\u4ecd\u4e3a\u6797\u5730\uff0c\u67af\u6728\u3001\u67af\u679d\u843d\u53f6\u548c\u571f\u58e4\u78b3\u5e93\u7684\u6e05\u9664\u91cf\u53ef\u5047\u8bbe\u4e3a\u96f6\u3002\u6839\u636e <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">Potapov et al. 2022</a> \u7684\u7814\u7a76\uff0c2000 \u5e74\u5c31\u5b58\u5728\u68ee\u6797\u6216 2000 \u5e74\u81f3 2020 \u5e74\u671f\u95f4\u5efa\u7acb\u68ee\u6797\u7684\u6bcf\u4e2a\u50cf\u5143\u7684\u78b3\u6e05\u9664\u91cf\u662f\u6839\u636e IPCC <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u6307\u5357\u6765\u8ba1\u7b97\u7684\u3002\u6bcf\u4e2a\u50cf\u5143\u4e2d\u7684\u5927\u6c14\u78b3\u6e05\u9664\u91cf\u90fd\u662f\u57fa\u4e8e\u68ee\u6797\u7c7b\u578b\uff08\u5982\u7ea2\u6811\u6797\u3001\u4eba\u5de5\u6797\uff09\u3001\u751f\u6001\u533a\uff08\u5982\u6f6e\u6e7f\u7684\u65b0\u70ed\u5e26\u5730\u533a\uff09\u3001\u68ee\u6797\u5e74\u9f84\uff08\u5982\u539f\u59cb\u68ee\u6797\u3001\u8001\u6b21\u751f\u6797\uff09\u4ee5\u53ca\u78b3\u6e05\u9664\u5e74\u6570\u7684\u5730\u56fe\u3002\u8be5\u56fe\u5c42\u53cd\u6620\u7684\u662f\u6a21\u578b\u6301\u7eed\u671f\u95f4\uff082001 \u5e74-2023 \u5e74\uff09\u7684\u7d2f\u79ef\u6e05\u9664\u91cf\uff0c\u5fc5\u987b\u9664\u4ee5 23 \u624d\u80fd\u83b7\u5f97\u6a21\u578b\u6301\u7eed\u671f\u95f4\u7684\u5e74\u5e73\u5747\u6e05\u9664\u91cf\uff1b\u6e05\u9664\u7387\u4e0d\u80fd\u5206\u914d\u7ed9\u6a21\u578b\u4e2d\u7684\u5355\u4e2a\u5e74\u4efd\u3002\u6240\u6709\u8f93\u5165\u56fe\u5c42\u5747\u91cd\u65b0\u91c7\u6837\uff0c\u91c7\u7528\u4e0e <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a> \u76f8\u540c\u7684\u5206\u8fa8\u7387\uff0c\u5373\u6bcf\u5c42 0.00025 \u00d7 0.00025 \u5ea6\u3002", "64c74e22a4d8059a311747487ad6f046": "\u70ed\u5e26\u6811\u6728\u8986\u76d6\u53d6\u4ee3\u9576\u5d4c\u666f\u89c2\u4e2d\u7684\u6811\u6728", "3a59ad267deeac27c66ec62d3573b371": "\u81ea\u5b9a\u4e49\u4eea\u8868\u76d8\u5373\u5c06\u5c31\u7eea\uff01", "13b29a84b38a4927f9f05144382dc2f3": "\u6211\u4eec\u6b63\u5728\u83b7\u53d6\u548c\u5206\u6790\u8fd9\u4e2a\u6700\u8fd1\u521b\u5efa\u7684\u5174\u8da3\u9762\u7684\u6240\u6709\u53ef\u7528\u6570\u636e\uff0c\u670d\u52a1\u5668\u9700\u8981\u7528\u51e0\u4e2a\u5c0f\u65f6\u6765\u5b8c\u6210\u8fd9\u4e00\u64cd\u4f5c\uff08\u901a\u5e38\u800c\u8a00\uff0c\u5168\u90e8\u4fe1\u606f\u5c06\u5728\u7b2c\u4e8c\u5929\u53ef\u7528\uff09\u3002", "9cf1d78ee4d7b8bcc0726732ee68c6b5": "\u9605\u8bfb\u6211\u4eec\u5173\u4e8e\u8fd9\u4e00\u65b0\u6570\u636e\u7684\u535a\u5ba2", "a9414819729ea45b8db7fe7c3aa7c45f": "{StartYear} \u81f3 {endYear}\uff0c{location} \u7684\u68ee\u6797\u6392\u653e\u4e86 {totalEmissions}<strong>/\u5e74</strong>\uff0c\u6e05\u9664\u4e86 {totalRemovals}<strong>/\u5e74</strong>\u3002\u8fd9\u610f\u5473\u7740 {netCarbonFluxWording} \u4e3a {totalFlux}<strong>/\u5e74</strong>\u3002", "969f99592d039045b8f2e09f8d3d2d4b": "\u51c0\u6e05\u9664", "03807bbdc60f7c4903c114bb07b97f19": "\u6211\u4eec\u6b63\u5728\u6536\u96c6\u7528\u6237\u53cd\u9988\uff0c\u4e86\u89e3\u6211\u4eec\u53ef\u5982\u4f55\u6539\u8fdb\u96c6\u6210\u7684\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u3002\u8bf7\u586b\u5199\u6b64<a href=\"{{0}}\" target=\"_blank\">\u8c03\u67e5\u95ee\u5377</a>\uff0c\u6216\u901a\u8fc7 <a href=\"{{1}}\" target=\"_blank\">gfw@wri.org</a> \u5411\u6211\u4eec\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\uff0c\u4ee5\u63d0\u4f9b\u60a8\u7684\u53cd\u9988\uff01", "1c5612abdd62aff290d86ccb899596ec": "\u6bcf\u5e74\uff0c30 m\uff0c\u5357\u7f8e\u6d32\uff0cSong et al. 2021", "7da07114ed9171046d273972bceca46a": "2023 - \u5370\u5ea6\u5c3c\u897f\u4e9a", "e21dfe5bbe828096ccde3d13d286d2b1": "\u662f\u7684\u3002\u6211\u4eec\u9f13\u52b1\u4f60\u63d0\u4ea4\u6ee1\u8db3\u4e0b\u5217\u6761\u4ef6\u7684\u7533\u8bf7\uff1a\u80fd\u591f\u6e05\u695a\u5730\u8868\u660e GFW \u5bf9\u5f53\u524d\u5de5\u4f5c\u6709\u4f55\u5e2e\u52a9\u3002", "51f8cb1473b58895a6570eca5c50a233": "\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u7684\u7535\u7b97\u5316\u8d22\u52a1\u7cfb\u7edf\u53ef\u4ee5\u662f Excel \u5417\uff1f\u8fd8\u662f\u8bf4\u5fc5\u987b\u662f\u4e00\u4e2a\u57fa\u4e8e\u4e92\u8054\u7f51\u7684\u8d22\u52a1\u7a0b\u5e8f\uff1f", "7b11ec911539bb9c104ea8eacca972de": "\u540c\u4e00\u7ec4\u7ec7\u53ef\u4ee5\u4e3a\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u63d0\u4ea4\u591a\u4e2a\u63d0\u8bae\u5417\uff1f", "6d5df01443cc0bab71cc32cd6574be43": "\u662f\u7684\u3002\u5982\u679c\u62df\u8bae\u9879\u76ee\u5c5e\u4e8e\u56fd\u5bb6\u7ea7\u6216\u66f4\u4f4e\u7ea7\u522b\uff0c\u56fd\u9645\u7ec4\u7ec7\u5c31\u6709\u8d44\u683c\u7533\u8bf7\u3002", "061ac8eb83913052c4bea47755a7b9ec": "\u6211\u6b63\u5728\u4e3a\u4e00\u4e2a\u8f83\u5927\u9879\u76ee\u7684\u5c0f\u7684\u7ec4\u6210\u90e8\u5206\u5bfb\u627e\u8d44\u91d1\u3002\u6211\u53ef\u4ee5\u7533\u8bf7\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u5417\uff1f", "1cb4548cf997525ff63bffbd25f84ea3": "\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u7533\u8bf7\u4eba\u5e94\u5f53\u8ba1\u5212\u548c\u73b0\u6709\u7684 WRI \u5408\u4f5c\u4f19\u4f34\u5efa\u7acb\u4f19\u4f34\u5173\u7cfb\uff0c\u8fd8\u662f\u53ef\u4ee5\u548c\u56fd\u5185\u7684\u5f53\u5730\u5408\u4f5c\u4f19\u4f34\uff08\u4f8b\u5982\u653f\u5e9c\u6797\u4e1a\u90e8\u95e8\u3001\u5f53\u5730 NGO\uff09\u5efa\u7acb\u4f19\u4f34\u5173\u7cfb\uff1f", "a8bc9a07025f1db96687715654b48202": "\u7533\u8bf7\u4eba\u4e0e WRI \u5408\u4f5c\u4f19\u4f34\u6216\u5f53\u5730\u5408\u4f5c\u4f19\u4f34\u5efa\u7acb\u4e86\u4f19\u4f34\u5173\u7cfb\u2014\u2014\u4e24\u4e2a\u90fd\u53ef\u4ee5\uff01", "1e08520bdb37f232d8ae7b4f264c76f7": "\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u548c\u6280\u672f\u7814\u7a76\u5458\u9879\u76ee\u7533\u8bf7\u4eba\u4f55\u65f6\u4f1a\u6536\u5230\u662f\u5426\u88ab\u5f55\u53d6\u7684\u901a\u77e5\uff1f", "25ea53f0726c59b986e2b5f3e2057af4": "\u53ea\u6709\u6765\u81ea\u7b26\u5408\u8d44\u683c\u7684\u56fd\u5bb6\u7684\u6280\u672f\u7814\u7a76\u5458\u624d\u80fd\u7533\u8bf7\u5417\uff1f", "fd241221db55fda480315e12cc9f70ec": "\u9879\u76ee\u671f\u7ed3\u675f\u540e\uff0c\u4f60\u4eec\u662f\u5426\u4f1a\u4e0e\u6280\u672f\u7814\u7a76\u5458\u548c\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u63a5\u53d7\u8005\u4fdd\u6301\u63a5\u89e6\uff1f", "188588c86869c9e578b1e492346cb6d5": "Asociaci\u00f3n Ambiente y Sociedad \u4f7f\u7528 MapBuilder \u5c06 GFW \u6570\u636e\u96c6\u6210\u5230<a href=\"{{0}}\" target=\"_blank\" aria-label=\"undefined (opens in a new tab)\" rel=\"noreferrer noopener\">\u9884\u8b66\u7cfb\u7edf\u5e73\u53f0</a>\u4e2d\uff0c\u8be5\u5e73\u53f0\u7279\u522b\u5f3a\u8c03\u4e86\u54e5\u4f26\u6bd4\u4e9a\u5927\u578b\u57fa\u7840\u8bbe\u65bd\u9879\u76ee\u9644\u8fd1\u7684\u4f18\u5148\u4fdd\u62a4\u533a\u57df\u3002", "344302a99f96f0bf5602e01da6c5e411": "\u5728\u7533\u8bf7\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u65f6\uff0c\u6211\u53ef\u4ee5\u63d0\u4ea4\u8d22\u52a1\u62a5\u8868\u6765\u4ee3\u66ff\u5ba1\u8ba1\u62a5\u544a\u5417\uff1f", "9f08594c81f9e0d603e9b330e7777f62": "\u4ee5\u4e0b\u6587\u4ef6\uff1a", "43fa041f9ba01a69782a5233c2eaf3d6": "\u6240\u6709\u4e09\u4e2a", "c0bfaeb6047d7ab6d54ed625f073efd1": "\u8fc7\u53bb\u4e24\u5e74\u7684\u635f\u76ca\u8868\u3002", "bd4e5092e71d48d5aa774e6bd14d44b0": "\u6211\u5728\u4e00\u5bb6\u5927\u578b\u56fd\u9645\u7ec4\u7ec7\u5de5\u4f5c\uff0c\u4f46\u6211\u4eec\u6b63\u5728\u4e0e\u5f53\u5730\u5408\u4f5c\u4f19\u4f34\u5b9e\u65bd\u4e00\u4e2a\u9879\u76ee\u3002\u90a3\u6211\u8fd8\u80fd\u7533\u8bf7\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u5417\uff1f", "e890276688a020a21edc6727e0ccaa79": "\u8fc7\u53bb\u4e24\u5e74\u7684\u8d44\u4ea7\u8d1f\u503a\u8868\u3002", "833ac46fc3b1ff0553ab8aae664c8309": "\u5bf9\u6280\u672f\u7814\u7a76\u5458\u7684\u671f\u671b\u662f\u4ec0\u4e48\uff1f", "19844d5a74acf1849d812a61498b33fd": "\u7814\u7a76\u5458\u5fc5\u987b\u53c2\u52a0\u6280\u672f\u8bad\u7ec3\u8425\u548c GFW \u7528\u6237\u5cf0\u4f1a\u3002\u5982\u679c\u4f60\u77e5\u9053\u81ea\u5df1\u5c06\u65e0\u6cd5\u53c2\u52a0\uff0c\u8bf7\u4e0d\u8981\u7533\u8bf7\u3002", "3ae4e723502e7ec3a959ca9c02d41c4d": "\u5728\u7814\u7a76\u5458\u9879\u76ee\u5f00\u59cb\u65f6\uff0c\u6280\u672f\u7814\u7a76\u5458\u5e94\u6839\u636e GFW \u987e\u95ee\u7684\u610f\u89c1\u5236\u5b9a\u5de5\u4f5c\u8ba1\u5212\u3002\u5de5\u4f5c\u8ba1\u5212\u5e94\u5305\u62ec\u4e0b\u5217\u5185\u5bb9\uff1a\u5728\u5404\u81ea\u7684\u56fd\u5bb6\u7ec4\u7ec7\u81f3\u5c11 2 \u6b21\u57f9\u8bad\u6d3b\u52a8\uff0c\u5236\u5b9a\u5411\u5176\u4ed6\u7814\u7a76\u5458\u4f20\u6388\u67d0\u9879\u6280\u80fd\u7684\u8ba1\u5212\uff0c\u5b9a\u671f\u53c2\u52a0\u6708\u5ea6\u4f1a\u8bae\u3001\u6280\u672f\u8bad\u7ec3\u8425\uff0c\u4e0e\u5176\u4ed6\u7814\u7a76\u5458\u4e00\u8d77\u52a0\u5165\u7535\u5b50\u90ae\u4ef6\u7fa4\u7ec4\u3002", "4855664f71117e13b8ee5a2e88cc9a6d": "\u6d4f\u89c8\u8d44\u6599\uff0c\u4e86\u89e3\u5982\u4f55\u5728 GFW \u4e0a\u67e5\u770b\u68ee\u6797\u8d8b\u52bf\u3002", "10d8f64d72aa624bef025c1d46f12e6e": "Hutanwatch \u5f15\u9886\u9a6c\u6765\u897f\u4e9a\u68ee\u6797\u6570\u636e\u900f\u660e\u5ea6", "82b3d5129ce521094a45a4c3f51949be": "\u82f1\u8bed\u7f51\u7edc\u7814\u8ba8\u4f1a\u5f55\u5236\u5185\u5bb9", "50a478afafaa34323067cc18bee2b62b": "WRI \u8fd8\u521b\u5efa\u4e86\u4e00\u4e2a\u57f9\u8bad\u6a21\u5757\uff0c\u53ef\u5728\u5176\u4ed6\u5730\u65b9\u4f7f\u7528\uff0c\u7528\u4e8e\u63a8\u52a8\u5987\u5973\u53c2\u4e0e\u4fdd\u62a4\u81ea\u7136\u5ba3\u4f20\u6d3b\u52a8\u3002", "0dafd711d0b67ceedf344ccee00787c9": "\u5728\u4e00\u4e2a\u6848\u4f8b\u4e2d\uff0cAmap\u00e1 \u68ee\u6797\u8b66\u5bdf\u5728\u6ce8\u610f\u5230\u8be5\u5730\u533a\u7684\u8b66\u62a5\u5e76\u6838\u5b9e\u4e86\u68ee\u6797\u635f\u5931\u540e\uff0c<a href=\"{{0}}\" target=\"_blank\" aria-label=\"undefined (opens in a new tab)\" rel=\"noreferrer noopener\">\u902e\u6355\u4e86\u4e00\u540d\u4ece\u4e8b\u975e\u6cd5\u6d3b\u52a8\u7684\u7537\u5b50</a>\u3002\u540e\u6765\u5728 Ariri \u7684\u4e00\u6b21\u884c\u52a8\u4e2d\uff0c\u9664\u4e86\u6293\u83b7 empresarios\u2014\u2014\u7ba1\u7406\u975e\u6cd5\u6bc1\u6797\u8ba1\u5212\u7684\u516c\u53f8\u7ecf\u8425\u8005\u5916\uff0c\u8fd8\u6293\u83b7\u4e86\u53e6\u5916\u4e03\u4eba\u3002", "a12c893433c6f11cb5288793d74a8490": "Amazon Conservation Team \u6b63\u5728\u4ece\u4e8b\u57fa\u7840\u6027\u5de5\u4f5c\uff0c\u4ee5\u4fbf\u5c06 Forest Watcher \u548c GFW \u9884\u8b66\u6570\u636e\u957f\u671f\u6574\u5408\u5230\u62a4\u6797\u5458\u7684\u68ee\u6797\u76d1\u6d4b\u6d3b\u52a8\u4e2d\u3002\u7ecf\u793e\u533a\u9a8c\u8bc1\u7684\u8b66\u62a5\u5c06\u6c47\u603b\u5728\u4e00\u7cfb\u5217\u62a5\u544a\u4e2d\uff0c\u5e76\u5206\u53d1\u7ed9\u539f\u4f4f\u6c11\u9886\u5bfc\u4eba\u548c\u666e\u901a\u4eba\uff0c\u4ee5\u4fbf\u8fdb\u884c\u540e\u7eed\u8c03\u67e5\u3002", "50abfecebf17706c1927d749529cb974": "\u5229\u7528\u8fd9\u4e9b\u4fe1\u606f\uff0c\u539f\u4f4f\u6c11\u793e\u533a\u53ef\u4ee5\u901a\u8fc7 Forest Watcher \u63d0\u4ea4\u6b63\u5f0f\u6295\u8bc9\uff0c\u5e76\u5728\u67d0\u4e9b\u60c5\u51b5\u4e0b<a aria-label=\"undefined (opens in a new tab)\" href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5236\u6b62\u4e86\u975e\u6cd5\u7834\u574f\u68ee\u6797\u7684\u884c\u4e3a</a>\u3002", "e0e1237eeebdd583685a43088287794d": "\u8bf7\u8bbf\u95ee\u65b0\u7f51\u7ad9\uff0c\u5f00\u59cb\u4f7f\u7528\u8d44\u6e90\u3001\u6559\u7a0b\u3001\u793a\u4f8b\u5730\u56fe\u7b49\u3002&nbsp;", "f825fe2c279c16a8ba13668cdad44c5f": "\u76f8\u5173\u4eba\u5458\u5c06\u6839\u636e\u4e0b\u5217\u6307\u6807\u5bf9\u7533\u8bf7\u4eba\u8fdb\u884c\u8bc4\u4f30\uff1a\u7533\u8bf7\u4eba\u4f7f\u7528\u6280\u672f\u4fdd\u62a4\u68ee\u6797\u7684\u521b\u65b0\u60f3\u6cd5\uff0c\u5bf9\u68ee\u6797\u76d1\u6d4b\u6280\u672f\u6f5c\u529b\u7684\u7406\u89e3\uff0c\u5e94\u5bf9\u73af\u5883\u6311\u6218\u7684\u70ed\u60c5\uff0c\u4ee5\u53ca\u4ed6\u4eec\u53ef\u4ee5\u4e0e\u4e4b\u5206\u4eab\u6280\u80fd\u548c\u7ecf\u9a8c\u6559\u8bad\u7684\u4eba\u9645\u7f51\u7edc\u3002GFW \u8fd8\u5728\u5bfb\u627e\u4ee3\u8868\u6027\u522b\u3001\u5730\u57df\u3001\u884c\u4e1a\u548c\u6559\u80b2\u80cc\u666f\u591a\u6837\u6027\u7684\u7533\u8bf7\u4eba\u3002", "3e6f2ed597610ff6751829741275a1c0": "\u7533\u8bf7\u6280\u672f\u7814\u7a76\u5458\u9879\u76ee\u9700\u8981\u4ec0\u4e48\uff1f", "e998f5e3cfe84fdf6c57f68c18f43ab9": "\u6211\u4eec\u5f3a\u70c8\u5efa\u8bae\u4f60\u63d0\u4ea4\u5ba1\u8ba1\u62a5\u544a\u3002\u4f46\u5982\u679c\u4f60\u7684\u7ec4\u7ec7\u6ca1\u6709\u8fdb\u884c\u5ba1\u8ba1\uff0c\u4f60\u9700\u8981\u63d0\u4f9b", "1b86513dbabd2a631cf853fa2ef978df": "\u8d44\u683c\u6807\u51c6", "ebcbafd3d5b9f39f4e0b628b18c5153b": "\uff0c\u4ee5\u524d\u7684\u7533\u8bf7\u4eba\u6709\u8d44\u683c\u91cd\u65b0\u7533\u8bf7\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u3002", "b127099c71415d532da3a26ed73eb041": "\u662f\u7684\u3002", "44a15d5822c246f3ecc72fa4bcaae4fd": "\u6211\u53bb\u5e74\u7533\u8bf7\u4e86\u4e00\u4e2a\u5956\u52b1\u8ba1\u5212\uff0c\u4f46\u6ca1\u6709\u88ab\u63a5\u53d7\u3002\u6211\u7684\u7533\u8bf7\u4f1a\u5f97\u5230\u4f18\u5148\u8003\u8651\u5417\uff1f", "52659d8265f95245fda5f31d44803152": "\u4e0d\u4f1a\u3002\u6211\u4eec\u4f1a\u6839\u636e\u76f8\u540c\u7684\u6807\u51c6\u5ba1\u6838\u6240\u6709\u7533\u8bf7\u3002\u4f46\u6211\u4eec\u9f13\u52b1\u4ee5\u524d\u7684\u7533\u8bf7\u4eba\u7ee7\u7eed\u63d0\u4ea4\u7533\u8bf7\u3002", "f12d8fff0bdc615e21ec60e484ddd280": "\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u662f\u5426\u5141\u8bb8\u6211\u4eec\u4e3a\u5458\u5de5\u53d1\u5de5\u8d44\uff1f\u6709\u4e0a\u9650\u5417\uff1f", "38abdba0a14c1514f89d2c28a7d9dab9": "\u5177\u4f53\u9884\u7b97\u7ec6\u76ee\u6ca1\u6709\u660e\u786e\u7684\u4e0a\u9650\uff0c\u4f46\u4f60\u5fc5\u987b\u5728\u7533\u8bf7\u8868\u4e2d\u9884\u7b97\u6a21\u677f\u7684\u9884\u7b97\u8be6\u60c5\u680f\u4e2d\uff0c\u5145\u5206\u8bf4\u660e\u6240\u6709\u8d39\u7528\u7684\u5408\u7406\u6027\u3002", "7bf65b85ec41ec9ef9d714a6c3f4734a": "\u6211\u600e\u6837\u624d\u80fd\u8fdb\u4e00\u6b65\u4e86\u89e3 GFW \u7684\u4f7f\u7528\u65b9\u6cd5\uff0c\u5e76\u786e\u5b9a\u8be5\u5e73\u53f0\u662f\u5426\u9002\u7528\u4e8e\u6211\u7684\u9879\u76ee\uff1f", "836ec4ab87399434e4634792a9938c03": "\u6240\u6709\u7533\u8bf7\u90fd\u5fc5\u987b\u6e05\u695a\u5730\u9610\u660e GFW \u5c06\u5982\u4f55\u5728\u9879\u76ee\u4e2d\u53d1\u6325\u5173\u952e\u4f5c\u7528\u3002\u5982\u9700\u8fdb\u4e00\u6b65\u4e86\u89e3\u5982\u4f55\u4f7f\u7528 GFW\uff0c\u4f60\u53ef\u4ee5\u6d4f\u89c8\u5e2e\u52a9\u4e2d\u5fc3\u7684\u76f8\u5173\u8d44\u6599\u3002", "586d8775464b6611cfc50d5762bb7d16": "\u6211\u6b63\u5728\u4e0e\u5408\u4f5c\u4f19\u4f34\u7ec4\u7ec7\u4e00\u8d77\u5b9e\u65bd\u4e00\u4e2a\u9879\u76ee\u3002\u6211\u53ef\u4ee5\u4ee3\u8868\u5408\u4f5c\u4f19\u4f34\u7533\u8bf7\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u5417\uff1f", "25a870218e3ad8ddcfda9f044e3fc049": "\u5728\u6bcf\u4e2a\u7533\u8bf7\u4e2d\uff0c\u8d44\u91d1\u53ea\u80fd\u63d0\u4f9b\u7ed9\u4e00\u4e2a\u7ec4\u7ec7\uff0c\u4f46\u4f60\u53ef\u4ee5\u5c06\u8d44\u91d1\u8f6c\u8d60\u7ed9\u5176\u4ed6\u5408\u4f5c\u4f19\u4f34\u6765\u5b9e\u65bd\u9879\u76ee\uff0c\u524d\u63d0\u662f\u4f60\u5728\u8be5\u9879\u76ee\u7684\u7ba1\u7406\u548c\u5b9e\u65bd\u4e2d\u90fd\u53d1\u6325\u7740\u79ef\u6781\u4f5c\u7528\u3002", "3f6241c95ca3432aaac81d592bd4b683": "\u5f88\u9057\u61be\uff0c\u6211\u4eec\u53ea\u63a5\u53d7\u82f1\u6587\u7533\u8bf7\u3002\u6839\u636e\u6bcf\u5e74\u8d60\u6b3e\u548c\u7814\u7a76\u5458\u9879\u76ee\u7533\u8bf7\u8303\u56f4\u7684\u4e0d\u540c\uff0c\u4e5f\u53ef\u80fd\u4f1a\u6709\u4e9b\u4f8b\u5916\u3002\u8bf7\u8bbf\u95ee", "166b5a2119d58b3c1ec858c5d9a8fce6": "\u5982\u679c\u7cfb\u7edf\u662f Excel\uff0c\u4f60\u4ecd\u7136\u53ef\u4ee5\u7533\u8bf7\uff0c\u4f46\u6211\u4eec\u4f1a\u4f18\u5148\u5f55\u53d6\u4f7f\u7528\u4e13\u4e1a\u4f1a\u8ba1\u8f6f\u4ef6\u6765\u7ba1\u7406\u8d39\u7528\u7684\u5019\u9009\u4eba\u3002", "b6ffeaec5382c7138ff8462e549bd3ab": "\u7533\u8bf7\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u6216\u6280\u672f\u7814\u7a76\u5458\u9879\u76ee\u9700\u8981\u82b1\u94b1\u5417\uff1f", "bd44141b7382749ea59e18e8a3911177": "\u4e0d\u9700\u8981\u3002\u7533\u8bf7\u65e0\u9700\u4efb\u4f55\u8d39\u7528\u3002", "fa0baceda878bf7631abefd61856232d": "\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1 2023 \u5e74\u8d60\u6b3e\u5468\u671f\u7684\u5165\u56f4\u8005\u5c06\u4e8e 2022 \u5e74 10 \u6708\u5de6\u53f3\u6536\u5230\u901a\u77e5\u3002", "1afbc2c0aa8ef6d6b5e3826681752221": "\u6280\u672f\u7814\u7a76\u5458\u9879\u76ee\u662f\u5982\u4f55\u7b79\u8d44\u7684\uff1f\u660e\u5e74\u8fd8\u4f1a\u6709\u4e00\u4e2a\u5468\u671f\u5417\uff1f", "e384d3e3c5136ebe05665efb9b7f825f": "\u4e0d\u662f\u3002\u6280\u672f\u7814\u7a76\u5458\u5fc5\u987b\u5728\u7b26\u5408\u6761\u4ef6\u7684\u56fd\u5bb6\u8fdb\u884c\u6d3b\u52a8\uff0c\u4f46\u4ed6\u4eec\u7684\u56fd\u7c4d\u4e0d\u9650\u4e8e\u8fd9\u4e9b\u56fd\u5bb6\u3002", "82f8c911c8865ed0ea94ad7e13477665": "\u6211\u4eec\u6b63\u5728\u79ef\u6781\u5bfb\u627e\u7b79\u8d44\u673a\u4f1a\uff0c\u4ee5\u786e\u4fdd\u6280\u672f\u7814\u7a76\u5458\u9879\u76ee\u5728\u672a\u6765\u51e0\u5e74\u80fd\u591f\u7ee7\u7eed\u7b79\u529e\u5e76\u6269\u5927\u89c4\u6a21\u3002\u5982\u679c\u4f60\u6709\u5174\u8da3\u652f\u6301\u8be5\u9879\u76ee\uff0c\u8bf7\u901a\u8fc7 <a href=\"{{0}}\">jessica.webb@wri.org</a> \u4e0e Jessica Webb \u8054\u7cfb", "f4c3f7ab44de77bd728dfc01c1c3ac22": "\u662f\u5426\u5e94\u8be5\u5c06\u6280\u672f\u7814\u7a76\u5458\u9879\u76ee\u89c6\u4e3a\u5168\u804c\u5de5\u4f5c\uff1f", "8742b6cfa7704ebf740de495cd7e6b8d": "\u4e0d\u3002\u9884\u8ba1\u5728\u7814\u7a76\u5458\u9879\u76ee\u671f\u95f4\uff0c\u6280\u672f\u7814\u7a76\u5458\u5c06\u4ece\u4e8b\u5176\u4ed6\u5de5\u4f5c\u6216\u8fdb\u884c\u5b66\u4e60\u3002\u7814\u7a76\u5458\u8fd8\u53ef\u4ee5\u63d0\u8bae\u5728\u5f53\u524d\u5de5\u4f5c\u5730\u70b9\u5f00\u5c55\u6d3b\u52a8\uff0c\u6216\u5728\u53e6\u4e00\u4e2a\u673a\u6784\u517c\u804c\u3002", "6de6ebd3c668e5ddf37fdfb9581d8d78": "\u6280\u672f\u7814\u7a76\u5458\u9879\u76ee\u7684\u8bc4\u5b9a\u6807\u51c6\u662f\u4ec0\u4e48\uff1f", "4da192af8080b5b420bd6ba37f12eeb4": "\u6280\u672f\u7814\u7a76\u5458\u9879\u76ee\u62a5\u9500\u5dee\u65c5\u8d39\u5417\uff1f", "c83992194029f95437e4970a529ea17f": "\u662f\u7684\u3002World Resources Institute \u5c06\u627f\u62c5\u6280\u672f\u7814\u7a76\u5458\u53c2\u52a0\u6280\u672f\u8bad\u7ec3\u8425\u548c GFW \u7528\u6237\u5cf0\u4f1a\u7684\u5dee\u65c5\u8d39\u3002", "d0977bbbb215f186dc4d005cff75b756": "\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u7684\u83b7\u5f97\u8005\u548c\u6210\u529f\u5b8c\u6210\u9879\u76ee\u7684\u6280\u672f\u7814\u7a76\u5458\u5c06\u4e00\u76f4\u662f\u6211\u4eec\u7684\u8d60\u6b3e&amp; \u7814\u7a76\u5458&nbsp; \u9879\u76ee\u7684\u6821\u53cb\uff0c\u5e76\u4fdd\u6301\u4e0e GFW \u7684\u4f19\u4f34\u5173\u7cfb\uff0c\u5305\u62ec\u53d7\u9080\u53c2\u52a0\u4e24\u5e74\u4e00\u5ea6\u7684 GFW \u5408\u4f5c\u4f19\u4f34\u4f1a\u8bae\u548c\u7528\u6237\u5cf0\u4f1a\u3002\u5728\u8d44\u91d1\u4e0d\u5230\u4f4d\u7684\u60c5\u51b5\u4e0b\uff0c\u6211\u4eec\u8fd8\u5e0c\u671b\u6821\u53cb\u80fd\u591f\u6307\u5bfc\u65b0\u4e00\u6279\u53d7\u8d44\u52a9\u8005\u6216\u7814\u7a76\u5458\uff0c\u5e76\u63d0\u4f9b\u5c0f\u989d\u8d60\u6b3e\uff0c\u4ee5\u4fbf\u8ba9\u4ed6\u4eec\u7684\u6d3b\u52a8\u80fd\u591f\u7ee7\u7eed\u4e0b\u53bb\u3002", "2d14df1c835a5c2690e4c5763466ea27": "\u8c01\u4f7f\u7528 GFW \u67e5\u770b\u68ee\u6797\u8d8b\u52bf\uff1f", "3579e41386c70610c7970f390ca57b97": "\u6280\u672f\u7814\u7a76\u5458\u9879\u76ee\u63d0\u4f9b\u4ec0\u4e48\uff1f", "ae3605767578a5098ec9ab34509b6958": "\u6280\u672f\u7814\u7a76\u5458\u9879\u76ee\u63d0\u4f9b\u6280\u80fd\u57f9\u517b\u3001\u4eba\u8109\u62d3\u5c55\u548c\u9879\u76ee\u5b9e\u65bd\u7684\u673a\u4f1a\u3002\u7814\u7a76\u5458\u5c06\u53c2\u52a0\u5bc6\u96c6\u7684\u6280\u672f\u8bad\u7ec3\u8425\uff0c\u5728\u90a3\u91cc\u4ed6\u4eec\u5c06\u63a5\u53d7 GFW \u548c\u5176\u4ed6\u5730\u56fe\u5de5\u5177\u7684\u76f8\u5173\u57f9\u8bad\uff0c\u4e0e GFW \u56e2\u961f\u548c GFW \u5408\u4f5c\u4f19\u4f34\u5efa\u7acb\u8054\u7cfb\uff0c\u5e76\u63a5\u53d7 GFW \u5458\u5de5\u7684\u6307\u5bfc\u3002\u7814\u7a76\u5458\u8fd8\u6709\u673a\u4f1a\u83b7\u5f97\u8d44\u6e90\uff08\u5305\u62ec\u9879\u76ee\u6d25\u8d34\uff09\uff0c\u5e76\u53ef\u4ee5\u901a\u8fc7 GFW \u7f51\u7ad9\u548c\u5176\u4ed6\u6e20\u9053\u5c55\u793a\u4ed6\u4eec\u7684\u5de5\u4f5c\u3002", "2a0012f81d89c50ba013e57074b2a421": "\u7533\u8bf7\u4eba\u5fc5\u987b\u586b\u5199\u4e00\u4efd\u8868\u683c\uff0c\u63cf\u8ff0\u4ed6\u4eec\u7684\u5174\u8da3\u3001\u76f8\u5173\u7ecf\u9a8c\u4ee5\u53ca\u5bf9\u7814\u7a76\u5458\u9879\u76ee\u671f\u95f4\u8981\u5f00\u5c55\u7684\u6d3b\u52a8\u7684\u63d0\u8bae\u3002\u4ed6\u4eec\u8fd8\u9700\u8981\u63d0\u4f9b\u6700\u8fd1\u7684\u7b80\u5386\uff0c\u4ee5\u53ca\u4e13\u4e1a\u6216\u5b66\u672f\u63a8\u8350\u4eba\u7684\u8054\u7cfb\u4fe1\u606f\u3002\u6211\u4eec\u4e0d\u5f3a\u5236\u8981\u6c42\u63d0\u4ea4\u63a8\u8350\u4fe1\u3002", "f54177ff75b45b5f6941e2110677915a": "GFW \u4f1a\u7ed9\u6280\u672f\u7814\u7a76\u5458\u53d1\u5de5\u8d44\u5417\uff1f", "e5acd5e8dc81d0ab9f8ddcb3f3fddbae": "GFW \u5c06\u7ed9\u6280\u672f\u7814\u7a76\u5458\u53d1\u653e\u6d25\u8d34\uff0c\u5e76\u63d0\u4f9b\u83b7\u53d6\u8d44\u91d1\u7684\u673a\u4f1a\uff0c\u4ee5\u652f\u6301\u5176\u9879\u76ee\u7684\u5b9e\u65bd\u3002", "2a8ea63d8500ea011ff2473780bc82ea": "\u6d4f\u89c8\u8d44\u6599\uff0c\u4e86\u89e3\u5982\u4f55\u4f7f\u7528 GFW \u6216 MapBuilder \u81ea\u5b9a\u4e49\u68ee\u6797\u5730\u56fe\u3002", "baed633e9efd0071ae4da4805eaf0f57": "\u5b83\u6700\u521d\u662f\u4f5c\u4e3a\u4e00\u4e2a\u4e1a\u4f59\u9879\u76ee\u5f00\u59cb\u7684\u3002Global Forest Watch (GFW) \u7528\u6237 JD* \u5f53\u65f6\u6709\u4e00\u4efd\u65e5\u5e38\u5de5\u4f5c\uff08\u73b0\u5728\u4ecd\u7136\u5982\u6b64\uff09\u2014\u2014\u4e0e NGO \u5408\u4f5c\u5e94\u5bf9\u9a6c\u6765\u897f\u4e9a\u7684\u68ee\u6797\u548c\u571f\u5730\u5229\u7528\u95ee\u9898\u3002JD \u56e0\u4e3a\u96be\u4ee5\u627e\u5230\u8be5\u56fd\u53ef\u9760\u7684\u68ee\u6797\u8986\u76d6\u5730\u56fe\u800c\u82e6\u607c\u3002\u5f88\u5927\u4e00\u90e8\u5206\u7684 [\u2026]", "d6cac6769049c1316b37a998e1c8238a": "\u5408\u4f5c\u4f19\u4f34\u5e16\u5b50\uff1aSur Verde \u81ea\u9002\u5e94\u76d1\u6d4b\uff1a\u53d1\u751f\u5728 Campeche \u7684 Calakmul \u7684\u51cf\u7f13\u548c\u9002\u5e94", "c9e47703f816c04e4e5747c64c6b65c6": "\u56e0\u4e3a\u5728\u5bfb\u627e\u793e\u4f1a\u73af\u5883\u95ee\u9898\u89e3\u51b3\u65b9\u6848\u65f6\uff0c\u521b\u9020\u6027\u5730\u4f7f\u7528\u4e86 Global Forest Watch \u5e73\u53f0\uff0cSur Verde \u5f97\u5230\u4e86 Reforestamos Mexico GFW \u7ade\u8d5b\u7684\u8ba4\u53ef\u3002\u5728\u8fd9\u91cc\u8fdb\u4e00\u6b65\u4e86\u89e3\u8fd9\u9879\u7ade\u8d5b\u3002&nbsp; \u8054\u5408\u56fd\u53ef\u6301\u7eed\u53d1\u5c55\u76ee\u6807 15 \u4e3a\u4e0b\u5217\u5de5\u4f5c\u63d0\u4f9b\u4e86\u6846\u67b6\uff1a\u53ef\u6301\u7eed\u7ba1\u7406\u68ee\u6797\uff0c\u9632\u6cbb\u8352\u6f20\u5316\uff0c\u5236\u6b62\u548c\u626d\u8f6c\u571f\u5730\u9000\u5316\uff0c\u904f\u5236 [...]", "6a360657f7babc5fce29f0e370ada868": "\u897f\u73ed\u7259\u8bed\u7f51\u7edc\u7814\u8ba8\u4f1a\u5f55\u5236\u5185\u5bb9", "76724da25924818763f0dd4b3d9c3c14": "\u4e00\u4e2a\u8c03\u67e5\u7cfb\u5217\u5229\u7528 GFW \u6570\u636e\u6765\u63cf\u8ff0\u4e9a\u9a6c\u900a\u5730\u533a\u68ee\u6797\u7834\u574f\u7684\u7a0b\u5ea6\uff0c\u5e76\u5229\u7528\u5730\u56fe\u5d4c\u5165\u63d0\u4f9b\u89c6\u89c9\u8bc1\u636e\uff0c\u63ed\u9732\u4e86\u56e0\u5efa\u8bbe\u6c34\u529b\u53d1\u7535\u5927\u575d\u800c\u4fb5\u72af\u539f\u4f4f\u6c11\u571f\u5730\u6743\u5229\u7684\u884c\u4e3a\u3002", "6670f14e2b029a217b87aa79e18e9511": "Mongabay&nbsp;\u662f Places to Watch \u5021\u8bae\u7684\u4e3b\u8981\u8d21\u732e\u8005\uff0c\u8be5\u5021\u8bae\u65e8\u5728\u5feb\u901f\u8bc6\u522b\u68ee\u6797\u635f\u5931\u8b66\u6212\u533a\u57df\uff0c\u5e76\u63a8\u52a8\u8fdb\u4e00\u6b65\u8c03\u67e5\u3002", "26c0a01512d7f4ffa6c963016a155d20": "Mongabay \u6307\u6d3e\u6765\u81ea\u5176\u5168\u7403\u62a5\u9053\u7f51\u7edc\u7684\u8bb0\u8005\u5bf9\u8b66\u62a5\u8fdb\u884c\u8ddf\u8fdb\uff0c\u5e76\u5236\u4f5c\u539f\u521b\u65b0\u95fb\u62a5\u9053\uff0c\u4e3a Places to Watch \u589e\u52a0\u89c1\u89e3\u3001\u7279\u8272\u548c\u80cc\u666f\u3002", "3d88b830e2e583796140f66548de498e": "\u6536\u5230\u6709\u5173\u68ee\u6797\u7834\u574f\u6216\u706b\u707e\u7684\u7535\u5b50\u90ae\u4ef6\u8b66\u62a5\u540e\uff0c\u9a6c\u6765\u897f\u4e9a Forest Monitoring Lab \u5c06 GFW \u6570\u636e\u4e0e\u81ea\u5df1\u7684\u68ee\u6797\u7ba1\u7406\u6570\u636e\u53e0\u7f6e\uff0c\u501f\u6b64\u5bfb\u627e\u8fdd\u89c4\u884c\u4e3a\uff0c\u5e76\u8fdb\u884c\u59a5\u5584\u5904\u7f6e\u3002", "9e3724927f1cc3d37a4916f0e86a7e43": "<a href=\"{{0}}\" target=\"_blank\" aria-label=\"undefined (opens in a new tab)\" rel=\"noreferrer noopener\">Hutan Watch</a> \u662f\u4e00\u4e2a\u4f7f\u7528 MapBuilder \u6784\u5efa\u7684\u5f00\u653e\u6570\u636e\u5e73\u53f0\uff0c\u80fd\u591f\u76f4\u89c2\u663e\u793a\u548c\u5206\u6790\u9a6c\u6765\u897f\u4e9a\u7684\u68ee\u6797\u548c\u571f\u5730\u5229\u7528\u6570\u636e\u3002\u9a6c\u6765\u897f\u4e9a\u7684\u6c11\u95f4\u793e\u4f1a\u7ec4\u7ec7\u79ef\u6781\u4f7f\u7528 Hutan Watch \u6765\u6838\u67e5\u68ee\u6797\u4fdd\u62a4\u533a\u8fb9\u754c\uff0c\u5e76\u786e\u5b9a\u53ef\u80fd\u53d1\u751f\u975e\u6cd5\u7834\u574f\u68ee\u6797\u884c\u4e3a\u7684\u533a\u57df\u3002", "b60352928fa2427c61ba13a8771496c2": "\u4f5c\u4e3a SAILD \u548c Madeleine Ngeunga \u5de5\u4f5c\u7684\u4e00\u90e8\u5206\uff0cForest Watcher \u5df2\u6210\u4e3a\u652f\u6301\u793e\u533a\u53d1\u73b0\u516c\u56ed\u5185\u6f5c\u5728\u68ee\u6797\u7834\u574f\u8b66\u62a5\u7684\u91cd\u8981\u5de5\u5177\uff0c\u4eba\u4eec\u8fd8\u901a\u8fc7\u5b9e\u5730\u8c03\u67e5\u6765\u9a8c\u8bc1\u548c\u8bb0\u5f55\u6f5c\u5728\u5a01\u80c1\u548c\u6811\u6728\u6e05\u9664\u6d3b\u52a8\u3002\u7136\u540e\uff0c\u8bb0\u8005\u53ef\u4ee5<a href=\"{{0}}\" target=\"_blank\" aria-label=\"undefined (opens in a new tab)\" rel=\"noreferrer noopener\">\u53d1\u5e03\u65b0\u95fb\u62a5\u9053</a>\uff0c\u91cd\u70b9\u63ed\u793a\u975e\u6cd5\u6d3b\u52a8\u548c\u5927\u578b\u5f00\u53d1\u9879\u76ee\u5bf9\u73af\u5883\u7684\u5404\u79cd\u5f71\u54cd\u3002", "580fdf9c6e0924970e84a37cc224210f": "<a href=\"{{0}}\">MapBuilder</a> \u662f\u4e00\u6b3e\u6613\u4e8e\u4f7f\u7528\u7684\u5de5\u5177\uff0c\u7528\u4e8e\u521b\u5efa\u81ea\u5b9a\u4e49\u4ea4\u4e92\u5f0f\u5730\u56fe\uff0c\u8fd9\u79cd\u5730\u56fe\u5c06\u6765\u81ea WRI \u7684 API \u7684\u524d\u6cbf\u5730\u7406\u7a7a\u95f4\u6570\u636e\u4e0e\u4f60\u81ea\u5df1\u7684\u6570\u636e\u7ed3\u5408\u4e86\u8d77\u6765\u3002&nbsp;", "fdc4b348c99f2124545fe5e6753ec5bc": "\u8be5\u5de5\u5177\u6709\u591a\u4e2a\u914d\u7f6e\u9009\u9879\uff0c\u53ef\u4f9b\u5177\u6709\u4e0d\u540c\u7684 GIS \u548c\u7f16\u7a0b\u7ecf\u9a8c\u6c34\u5e73\u7684\u7528\u6237\u4f7f\u7528\u3002\u53ea\u9700\u70b9\u51fb\u51e0\u4e0b\uff0c\u4f60\u5c31\u53ef\u4ee5\u521b\u5efa\u6570\u636e\u9a71\u52a8\u7684\u81ea\u5b9a\u4e49\u52a8\u6001\u76d1\u6d4b\u5730\u56fe\uff0c\u4f7f\u4f60\u53ef\u4ee5\u76f4\u89c2\u663e\u793a\u68ee\u6797\u3001\u571f\u5730\u5229\u7528\u60c5\u51b5\u3001\u6c14\u5019\u6570\u636e\u4ee5\u53ca\u4f60\u81ea\u5df1\u7684\u672c\u5730\u6570\u636e\u3002", "3b9fcf7f52e8fc08db7dd3a38a832d42": "MapBuilder \u73b0\u5df2\u79fb\u81f3\u4e0b\u5217\u7f51\u7ad9\uff1a", "969919f4468dd817f80ab5ddc9227245": "\u6709\u95ee\u9898\u5417\uff1f\u8bf7\u901a\u8fc7 <a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">mapbuilder@wri.org</a> \u8054\u7cfb MapBuilder \u56e2\u961f&nbsp;", "fb712bd5c3bbdba653da28acee95f2a1": "MapBuilder \u73b0\u5df2\u79fb\u81f3\u4e0b\u5217\u7f51\u7ad9\uff1amapbuilder.wri.org", "27102d81a9ca66784c19be0b91e1aa0f": "\u8bbf\u95ee Mapbuilder", "15ce1bf66e8c131972f44c992e70c66f": "BJF \u6b63\u5728 Araguaia Corridor \u5f00\u5c55\u91cd\u65b0\u9020\u6797\u9879\u76ee\uff0c\u5e76\u5236\u4f5c\u4e86<a href=\"{{0}}\" target=\"_blank\" aria-label=\"undefined (opens in a new tab)\" rel=\"noreferrer noopener\">\u7efc\u5408\u5730\u56fe</a>\u6765\u652f\u6301\u8fd9\u4e9b\u5de5\u4f5c\uff0c\u501f\u6b64\u786e\u5b9a Araguaia Corridor \u5185\u571f\u5730\u7684\u6240\u6709\u8005\u548c\u4f7f\u7528\u60c5\u51b5\u3002", "392813bec4baaa7aec5e285caf51236d": "Black Jaguar Foundation (BJF) \u4f7f\u7528 MapBuilder \u521b\u5efa\u4e86\u5df4\u897f Araguaia Corridor \u7684\u5730\u56fe\uff0c\u96c6\u6210\u4e86\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u635f\u5931\u3001GLAD \u68ee\u6797\u7834\u574f\u8b66\u62a5\u3001VIIRS \u706b\u707e\u8b66\u62a5\u548c\u6700\u65b0\u536b\u661f\u56fe\u50cf\u7b49\u5173\u952e\u6570\u636e\u96c6\u3002", "cc368d97f789260d8711cc8fb6b0b878": "\u901a\u8fc7\u5c06 GFW \u4e0a\u7684\u6570\u636e\u4e0e\u6c34\u575d\u548c\u77ff\u4e95\u5efa\u8bbe\u6570\u636e\u7ed3\u5408\u8d77\u6765\uff0c\u793e\u533a\u6210\u5458\u53ef\u4ee5\u8fd1\u4e4e\u5b9e\u65f6\u5730\u8ddf\u8e2a\u4e0e\u8fd9\u4e9b\u9879\u76ee\u76f8\u5173\u7684\u68ee\u6797\u635f\u5931\uff0c\u5e76\u80fd\u591f\u53ca\u65f6\u5e72\u9884\uff0c\u4ee5\u4fbf\u4fdd\u62a4\u4f18\u5148\u4fdd\u62a4\u533a\u57df\u3002", "8a619ee2acf4f543819b920388b09cbb": "\u6784\u5efa Hutan Watch \u6700\u521d\u7684\u76ee\u7684\u662f\u5728\u4e00\u4e2a\u5e73\u53f0\u4e0a\u76f4\u89c2\u663e\u793a\u9a6c\u6765\u897f\u4e9a\u534a\u5c9b\u7684\u591a\u4e2a\u6570\u636e\u96c6\uff0c\u4f46\u5728\u9a6c\u6765\u897f\u4e9a\u4fdd\u62a4\u533a\u57df\u53d7\u5230\u5173\u6ce8\u540e\uff0c\u5b83\u9010\u6e10\u6210\u4e3a\u63a8\u52a8\u653f\u5e9c\u63d0\u9ad8\u900f\u660e\u5ea6\u7684\u4e00\u4e2a\u9014\u5f84\u3002", "633e65cb3acb497bde2fe72c8c36ea58": "\u8fc7\u53bb\u4e24\u5e74\u7684\u73b0\u91d1\u6d41\u91cf\u8868\u3002", "5ecbb2f624820ed8912a591876035b2f": "\u5c0f\u989d\u8d60\u6b3e\u57fa\u91d1\u6216\u6280\u672f\u7814\u7a76\u5458\u9879\u76ee\u7533\u8bf7\u8868\u53ef\u4ee5\u7528\u82f1\u6587\u4ee5\u5916\u7684\u8bed\u8a00\u586b\u5199\u5417\uff1f", "50af11cc35702d715a14ff18a04873ae": "\u521b\u5efa\u5173\u6ce8\u533a\u57df\u3002", "8cfeebeaa13f57b7cb0c1402e911bb9f": "\u5728\u7ebf\u548c\u79bb\u7ebf\u90fd\u6709\u54ea\u4e9b\u529f\u80fd\uff1f", "6a20c08dc327ceeece9530ae25e81dc8": "\u4e0b\u8f7dForest Watcher\u79fb\u52a8\u7248\u5e76\u767b\u5f55\u3002", "2e7c153efac451ceeb61226ae3944f7b": "\u60a8\u53ef\u4ee5\u901a\u8fc7\u5bfc\u822a\u5230\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u7684\u201c\u533a\u57df\u201d\u9875\u9762\u5e76\u70b9\u51fb\u201c\u5206\u4eab\u533a\u57df\u201d\u6765\u5206\u4eab\u5173\u6ce8\u533a\u57df\u3002\u4ece\u8fd9\u91cc\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u8981\u5206\u4eab\u7684\u533a\u57df\uff0c\u5e76\u9009\u62e9\u5c06\u6346\u7ed1\u5305\u5bfc\u51fa\u5230\u8bbe\u5907\u4e0a\u7684\u4f4d\u7f6e\u3002\u7136\u540e\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u60a8\u9009\u62e9\u7684\u5206\u4eab\u9009\u9879\uff08\u4f8b\u5982\u7535\u5b50\u90ae\u4ef6\uff0c\u84dd\u7259\u6216WhatsApp\uff09\u5206\u4eab\u5173\u6ce8\u533a\u57df\u6346\u7ed1\u5305\u3002&nbsp;", "d11ac18d41afb8868c4935462475c8f6": "\u901a\u8fc7\u60a8\u504f\u597d\u7684\u5206\u4eab\u9009\u9879\u6536\u5230\u4e0a\u4e0b\u6587\u56fe\u5c42\u6346\u7ed1\u5305\u540e\uff0c\u60a8\u53ef\u4ee5\u5c06\u5176\u5bfc\u5165Forest Watcher\u3002\u5bfc\u5165\u5b8c\u6210\u540e\uff0c\u60a8\u53ef\u4ee5\u5728\u201c\u8bbe\u7f6e\u201d\u9875\u9762\u7684\u201c\u4e0a\u4e0b\u6587\u56fe\u5c42\u201d\u677f\u5757\u4e2d\u8bbf\u95ee\u4e0a\u4e0b\u6587\u56fe\u5c42\u3002", "7d704453e8922e4ddca96330d1148c1c": "Forest Watcher\u7f51\u9875\u7248\u63d0\u4f9b\u673a\u4f1a\u8ba9\u60a8\u5bf9\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u505a\u8fdb\u4e00\u6b65\u81ea\u5b9a\u4e49\uff0c\u5305\u62ec\u62a5\u544a\u6a21\u677f\u5b9a\u5236\u3001\u56e2\u961f\u7ba1\u7406\u548c\u6570\u636e\u7ba1\u7406\u3002", "0f9411559d056bd68529c7b299b60d51": "\u5982\u4f55\u68c0\u7d22\u62a5\u544a\u5e76\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u6570\u636e\uff1f", "27b471ec95438149824e704dfb56d4ed": "\u8bf7\u53c2\u9605\u6211\u4eec\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">\u9690\u79c1\u653f\u7b56</a>\uff0c\u4e86\u89e3\u6709\u5173\u4fe1\u606f\u5171\u4eab\u505a\u6cd5\u7684\u66f4\u591a\u8be6\u7ec6\u4fe1\u606f\u3002", "94be2970df32ec7711a4b60857a2b881": "\u8bf7\u53c2\u9605\u6211\u4eec\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">\u9690\u79c1\u653f\u7b56</a>\uff0c\u4e86\u89e3\u6709\u5173GFW\u5b89\u5168\u63aa\u65bd\u7684\u8be6\u7ec6\u4fe1\u606f\u3002", "365e0d445db861b5fe6577764e746b07": "\u9664\u4e86\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u5916\uff0cForest Watcher\u8fd8\u6709\u4e00\u4e2a\u5728\u7ebf\u754c\u9762Forest Watcher\u7f51\u9875\u7248\uff0c\u8be5\u754c\u9762\u901a\u8fc7\u53ef\u7f16\u8f91\u7684\u62a5\u544a\u6a21\u677f\u63d0\u4f9b\u66f4\u51fa\u8272\u7684\u81ea\u5b9a\u4e49\u529f\u80fd\uff0c\u5e76\u63d0\u4f9b\u9009\u9879\u4f9b\u521b\u5efa\u3001\u5ba1\u67e5\u548c\u5411\u56e2\u961f\u6210\u5458\u5206\u914d\u62a5\u544a\uff0c\u4ece\u800c\u4fc3\u8fdb\u534f\u4f5c\u3002", "bf33b02449d41341881937706364c98d": "\u8c01\u521b\u5efa\u4e86Forest Watcher\uff1f", "f8206d67bc0197fea0ee7911246cf195": "\u4f7f\u7528Forest Watcher\u5e94\u5177\u5907\u4ec0\u4e48\u8bbe\u5907\u89c4\u683c\uff1f", "8fbeb9b04199df58914aaba0610bb168": "Android\u8bbe\u5907\u6700\u4f4e\u89c4\u683c\uff1a", "71abbbcef70557a191315d83a13248e4": "\u53ef\u7528\u78c1\u76d8\u7a7a\u95f4\uff1a1 GB", "73d04dba8ce4097ee9057ede8bc1746c": "OS\uff1aAndroid 7.1+", "e7173641b0511e737b16d2d387e82b35": "RAM\uff1a3 GB", "d842c2d5623400fcb566ed805fb01a7a": "Android\u8bbe\u5907\u63a8\u8350\u89c4\u683c\uff1a", "e76a0531c612ee3b07e8ec3c33dac838": "\u8bbe\u7f6e\u8b66\u62a5\u548c\u5237\u65b0\u8b66\u62a5\u7684\u65f6\u95f4\u6bb5\u3002", "389928ced57fe16fdcb37ef24fac89a8": "\u8bb0\u5f55\u89c2\u5bdf\u53d1\u73b0\u5e76\u62cd\u7167\u3002", "464dd026c75de7549d4ac388254ecfbc": "\u4ec0\u4e48\u662f\u5173\u6ce8\u533a\u57df\uff1f", "941f8f4fa2c3aec97a3822abf13d610d": "\u5982\u4f55\u5206\u4eab\u548c\u63a5\u6536\u5173\u6ce8\u533a\u57df\uff1f", "2259ef520c7d3af69b4f6a3cd1f17a21": "\u901a\u8fc7\u60a8\u504f\u597d\u7684\u5206\u4eab\u9009\u9879\u6536\u5230\u5173\u6ce8\u533a\u57df\u6346\u7ed1\u5305\u540e\uff0c\u60a8\u53ef\u4ee5\u5c06\u5176\u5bfc\u5165Forest Watcher\u3002\u5bfc\u5165\u5b8c\u6210\u540e\uff0c\u60a8\u53ef\u4ee5\u5728\u201c\u533a\u57df\u201d\u9875\u9762\u4e2d\u8bbf\u95ee\u5173\u6ce8\u533a\u57df\u3002", "d6249201101ed37663ad04c3f112064c": "\u5982\u4f55\u5206\u4eab\u548c\u63a5\u6536\u4e0a\u4e0b\u6587\u56fe\u5c42\uff1f", "a88d6e6bca0e18177ebb68d11b63cf8b": "\u4f60\u4eec\u63d0\u4f9b\u54ea\u4e9b\u6570\u636e\uff0c\u5b83\u4eec\u6765\u81ea\u54ea\u91cc\uff1f", "b37bc6961a34c1449a75d376865715f4": "<strong>GLAD\u68ee\u6797\u780d\u4f10\u8b66\u62a5\uff1a</strong> \u7531\u9a6c\u91cc\u5170\u5927\u5b66\u5168\u7403\u571f\u5730\u5206\u6790\u4e0e\u53d1\u73b0\uff08GLAD\uff09\u5b9e\u9a8c\u5ba4\u5236\u4f5c\uff0c\u6bcf8\u5929\u66f4\u65b0\u4e00\u6b21\uff0c\u5206\u8fa8\u7387\u4e3a30\u7c73\u3002\u8fd9\u4e9b\u8b66\u62a5\u4f7f\u7528Landsat 7\u548c8\u536b\u661f\u6570\u636e\u6765\u8bc6\u522b\u70ed\u5e26\u5730\u533a\u53ef\u80fd\u53d1\u751f\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u533a\u57df\u3002", "74cb604f74a0de57dbcf30982460585f": "<strong>\u5e74\u5ea6\u6797\u6728\u8986\u76d6\u635f\u5931\uff1a</strong> \u7531GLAD Lab\u5236\u4f5c\uff0c\u6bcf\u5e74\u66f4\u65b0\uff0c\u5206\u8fa8\u7387\u4e3a30\u7c73\uff0c\u663e\u793a\u6797\u6728\u8986\u76d6\u9762\u79ef\u9010\u5e74\u53d8\u5316\u60c5\u51b5\u3002\u6b64\u6570\u636e\u76ee\u524d\u4ec5\u4f5c\u4e3a\u4e0a\u4e0b\u6587\u6570\u636e\u56fe\u5c42\u63d0\u4f9b\u2014\u2014\u60a8\u65e0\u6cd5\u50cf\u521b\u5efa\u5176\u4ed6\u8b66\u62a5\u90a3\u6837\u521b\u5efa\u5e74\u5ea6\u6797\u6728\u8986\u76d6\u635f\u5931\u62a5\u544a\u3002\u4f46\u662f\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u5e74\u5ea6\u6570\u636e\u521b\u5efa\u62a5\u544a\uff0c\u65b9\u6cd5\u662f\u70b9\u51fb\u5c4f\u5e55\u5e95\u90e8\u5e26\u6709\u52a0\u53f7\u7684\u56fe\u9489\uff0c\u7136\u540e\u5728\u8be5\u4f4d\u7f6e\u4e0a\u653e\u7f6e\u56fe\u9489\u3002", "6c527e8d5abf00f687ede176a9b03657": "\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u8b66\u62a5\u6709\u591a\u7cbe\u786e\uff1f", "0ea7129df3b6ca0fd56a4465ff1e5217": "\u5bf9VIIRS\u706b\u707e\u8b66\u62a5\u7684\u8bc4\u4f30\u53d1\u73b0\uff0c\u5728\u8bc4\u4f30\u5730\u533a\u4e2d\u5927\u591a\u6570\u5730\u533a\u7684\u8bef\u62a5\u7387\u63a5\u8fd10\uff0c\u6700\u9ad8\u4e3a1.2%\uff0c\u4e3b\u8981\u4e0e\u5c4b\u9876\u9633\u5149\u53cd\u5c04\u6709\u5173\u3002VIIRS\u706b\u707e\u8b66\u62a5\u65e0\u6cd5\u68c0\u6d4b\u5230\u89c4\u6a21\u592a\u5c0f\u6216\u6e29\u5ea6\u592a\u4f4e\u7684\u706b\u707e\uff08\u901a\u5e38\u5c0f\u4e8e100\u5e73\u65b9\u7c73\u6216\u4f4e\u4e8e700\u5f00\u5c14\u6587\uff09\u3002", "80ca09d443a153b0c7e845c24210b3ca": "\u662f\u5426\u53ef\u4ee5\u5728Forest Watcher\u4e2d\u4e0a\u4f20\u81ea\u5df1\u7684\u4e0a\u4e0b\u6587\u56fe\u5c42\u548c\u5e95\u56fe\uff1f", "41b3f52328d956bf804c84bcbab32835": "\u652f\u6301\u7684\u4e0a\u4e0b\u6587\u56fe\u5c42\u6587\u4ef6\u7c7b\u578b\u5305\u62ec\uff1a.json\u3001.geojson\u3001.topojson\u3001.gpx\u3001.zip\u3001.kmz\u548c.kml\u3002&nbsp;", "b92abbc8560218db811366a1eb5b50aa": "\u652f\u6301\u7684\u5e95\u56fe\u6587\u4ef6\u7c7b\u578b\u5305\u62ec\uff1a.mbtiles\u3002&nbsp;", "ddd62f171f730582e488f749d66e07df": "\u5982\u4f55\u6dfb\u52a0\u62a5\u544a\uff1f", "080254b18cba946d956c6f7ccd71ce24": "\u5982\u679c\u60a8\u5f00\u59cb\u7f16\u5199\u62a5\u544a\uff0c\u7136\u540e\u9000\u51fa\u62a5\u544a\uff0c\u5219\u5230\u76ee\u524d\u4e3a\u6b62\u7684\u5de5\u4f5c\u4ee5\u53ca\u542f\u52a8\u62a5\u544a\u7684\u4f4d\u7f6e\u7684GPS\u5750\u6807\u5c06\u81ea\u52a8\u4fdd\u5b58\u3002\u60a8\u53ef\u4ee5\u7a0d\u540e\u5728\u201c\u62a5\u544a\u201d\u9875\u9762\u4e0a\u8fd4\u56de\u5230\u62a5\u544a\u8349\u7a3f\u3002\u60a8\u8fd8\u53ef\u4ee5\u4f7f\u7528\u8bbe\u5907\u76f8\u673a\u62cd\u6444\u7167\u7247\uff0c\u7a0d\u540e\u518d\u5c06\u5176\u4e0a\u4f20\u5230\u62a5\u544a\u4e2d\u3002", "cd0350238a22b9bcd81e0c21ade4cdd8": "\u8bb0\u5f55\u8def\u7ebf\u65f6\uff0c\u6bcf\u969450\u7c73\u6293\u53d6\u4e00\u6b21\u70b9\u3002", "c4a80d396a6244d9b9b2024762535b14": "\u60a8\u53ef\u4ee5\u901a\u8fc7\u5bfc\u822a\u5230\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u7684\u201c\u62a5\u544a\u201d\u90e8\u5206\u5e76\u70b9\u51fb\u201c\u5206\u4eab\u62a5\u544a\u201d\u6765\u5206\u4eab\u62a5\u544a\u3002\u4ece\u8fd9\u91cc\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u8981\u5206\u4eab\u7684\u62a5\u544a\uff0c\u5e76\u9009\u62e9\u5c06\u6346\u7ed1\u5305\u5bfc\u51fa\u5230\u8bbe\u5907\u4e0a\u7684\u4f4d\u7f6e\u3002\u7136\u540e\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u60a8\u9009\u62e9\u7684\u5206\u4eab\u9009\u9879\uff08\u4f8b\u5982\u7535\u5b50\u90ae\u4ef6\uff0c\u84dd\u7259\u6216WhatsApp\uff09\u5206\u4eab\u62a5\u544a\u6346\u7ed1\u5305\u3002&nbsp;", "2964b19b72efb819c7800b20dd632d70": "\u901a\u8fc7\u60a8\u504f\u597d\u7684\u5206\u4eab\u9009\u9879\u6536\u5230\u62a5\u544a\u6216\u8def\u7ebf\u6346\u7ed1\u5305\u540e\uff0c\u60a8\u53ef\u4ee5\u5c06\u5176\u5bfc\u5165Forest Watcher\u3002\u5bfc\u5165\u5b8c\u6210\u540e\uff0c\u60a8\u53ef\u4ee5\u5728\u201c\u62a5\u544a\u201d\u90e8\u5206\u4e2d\u8bbf\u95ee\u62a5\u544a\u6216\u5728\u201c\u8def\u7ebf\u201d\u90e8\u5206\u4e2d\u8bbf\u95ee\u8def\u7ebf\u3002", "31b676e9c011c5ef08bb80c2b1c0882a": "\u4ec0\u4e48\u662fForest Watcher Web\uff1f", "2b6251a841e6d970040acf1a27b30177": "Forest Watcher\u63a5\u53d7\u54ea\u4e9b\u6587\u4ef6\u7c7b\u578b\u548c\u5927\u5c0f\uff1f", "2f0ae67903c32e2865c785dc2c99421c": "\uff0c\u5bfc\u822a\u5230\u201c\u62a5\u544a\u201d\u9009\u9879\u5361\uff0c\u7136\u540e\u70b9\u51fb\u201c\u4e0b\u8f7d\u7b54\u6848\u201d\u4ee5\u8bbf\u95ee\u60a8\u7684CSV\u6587\u4ef6\u3002\u7167\u7247\u53ef\u901a\u8fc7\u7535\u5b50\u8868\u683c\u4e2d\u7684\u7f51\u5740\u4e0b\u8f7d\u3002&nbsp;", "645f61920dacbcc2cb9e7f00364ff533": "\u5982\u679c\u60a8\u5bf9\u4e0a\u4f20\u6d41\u7a0b\u6709\u4efb\u4f55\u7591\u95ee\u3002", "1ff236b458cf95b9b7772e3d3dbdf0bd": "\u8981\u68c0\u7d22\u60a8\u7684\u62a5\u544a\u548c\u7167\u7247\uff0c\u8bf7\u767b\u5f55\u5230", "560df1de8ed21d3de4f5bf8b0682793c": "\u5982\u679c\u60a8\u60f3\u8981\u5728\u5730\u56fe\u4e0a\u67e5\u770b\u60a8\u7684\u6570\u636e\uff0c\u8bf7\u5bfc\u822a\u81f3", "fdf4defa003505e352e6f3329d40b238": "\u5e76\u767b\u5f55\u60a8\u7684Google\u5e10\u6237\uff08\u6216\u514d\u8d39\u521b\u5efa\u4e00\u4e2a\uff09\u3002\u7136\u540e\u70b9\u51fb\u201c\u65b0\u5efa\u5730\u56fe\u201d\u3002\u5728\u5de6\u4fa7\u9762\u677f\u4e0a\uff0c\u70b9\u51fb\u201c\u5bfc\u5165\u201d\u5e76\u4eceForest Watcher\u7f51\u9875\u4e0a\u4f20\u60a8\u7684CSV\u3002\u9009\u62e9\u201c\u62a5\u544a\u4f4d\u7f6e\u7eac\u5ea6\u201d\uff0c\u51fa\u73b0\u63d0\u793a\u65f6\uff0c\u9009\u62e9\u201c\u7eac\u5ea6\u201d\u3002\u9009\u62e9\u201c\u62a5\u544a\u4f4d\u7f6e\u7ecf\u5ea6\u201d\uff0c\u51fa\u73b0\u63d0\u793a\u65f6\uff0c\u9009\u62e9\u201c\u7ecf\u5ea6\u201d\u3002\u9009\u62e9\u201c\u7ee7\u7eed\u201d\uff0c\u7136\u540e\u9009\u62e9\u8981\u7528\u4e8e\u8bc6\u522b\u6240\u5728\u4f4d\u7f6e\u7684\u5217\u3002\u8bf7\u6ce8\u610f\uff0c\u4e0e\u8be5\u62a5\u544a\u76f8\u5173\u7684\u6570\u636e\u5c06\u6210\u4e3a\u5730\u56fe\u4e0a\u84dd\u8272", "62dc84f6bcd622470febedd515012f24": "\u56fe\u9489\u968f\u9644\u7684\u6807\u9898\u3002", "d3aefc7c22916bf684eb7f6b67b2a3c7": "\u662f\u7684\uff0cForest Watcher\u63d0\u4f9b\u897f\u73ed\u7259\u8bed\u3001\u6cd5\u8bed\u3001\u8461\u8404\u7259\u8bed\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u8bed\u3001\u8377\u5170\u8bed\u548c\u9a6c\u8fbe\u52a0\u65af\u52a0\u8bed\u7248\u672c\u3002\u8c03\u67e5\u95ee\u5377\u548c\u62a5\u544a\u7684\u8bed\u8a00\u53ef\u4ee5\u81ea\u5b9a\u4e49\u4e3a\u60a8\u9009\u62e9\u7684\u4efb\u4f55\u8bed\u8a00\u3002", "a6217b466cdb7dc6b5f0592a6765ab26": "\u6545\u969c\u6392\u9664\uff1a\u5982\u679c\u51fa\u73b0\u4ee5\u4e0b\u60c5\u51b5\uff0c\u6211\u8be5\u600e\u4e48\u529e\uff1f", "6233ca72c870d53add2d1a9a22b91286": "\u5982\u679c\u60a8\u770b\u4e0d\u5230\u5173\u6ce8\u533a\u57df\u7684\u8b66\u62a5\uff0c\u8bf7\u68c0\u67e5", "316b69e92cc9a0dc025a7f5ab0eaab0a": "\u6211\u7684\u62a5\u544a\u4f1a\u88ab\u5206\u4eab\u8fd8\u662f\u4fdd\u5bc6\uff1f", "d20b275df769fdef9a2909e37aa9251c": "GFW\u670d\u52a1\u6761\u6b3e", "e15b0efc96b95e094d4515ba6af98b9a": "\u6ce8\u518cForest Watcher\u5e10\u6237\u65f6\u4f1a\u6536\u96c6\u54ea\u4e9b\u4fe1\u606f\uff1f", "43d3b336585a4ca0388c8f9ac75a984c": "\u5f53\u60a8\u6ce8\u518cForest Watcher\u5e10\u6237\u65f6\uff0c\u6211\u4eec\u53ef\u80fd\u4f1a\u6536\u96c6\u4e24\u7c7b\u4fe1\u606f\u3002", "da911adc05c0670fa49eb585c4b31ae9": "\u4e3a\u4ec0\u4e48\u5f53\u6211\u6ce8\u518cForest Watcher\u5e10\u6237\u65f6\u4f1a\u6536\u96c6\u6211\u7684\u4fe1\u606f\uff1f", "1d8094caf429d4d77c2e3e4d43139a09": "\u6211\u4eec\u6536\u96c6\u60a8\u7684\u4fe1\u606f\uff0c\u76ee\u7684\u662f\u5e2e\u52a9\u4f7fForest Watcher\u5bf9\u60a8\u66f4\u6709\u7528\u3002\u4f8b\u5982\uff0c\u8fd9\u53ef\u80fd\u5305\u62ec\u7ba1\u7406\u548c\u6539\u8fdbForest Watcher\uff0c\u8ba9\u60a8\u7684Forest Watcher\u4f53\u9a8c\u66f4\u4e2a\u6027\u5316\uff0c\u4ee5\u53ca\u4fc3\u8fdbForest Watcher\u66f4\u52a0\u5b89\u5168\u548c\u53ef\u9760\u3002\u5c31Forest Watcher\u4e0e\u60a8\u8054\u7cfb\u3002\u6211\u4eec\u8fd8\u53ef\u80fd\u4f7f\u7528\u8fd9\u4e9b\u4fe1\u606f\u4e0e\u60a8\u8054\u7cfb\uff0c\u4ee5\u4e86\u89e3\u6709\u5173\u60a8\u5982\u4f55\u4f7f\u7528Forest Watcher\u4ea7\u54c1\u7684\u66f4\u591a\u4fe1\u606f\u3001\u8bf7\u6c42\u60a8\u63d0\u4f9b\u5bf9\u65b0\u529f\u80fd\u7684\u53cd\u9988\u548c/\u6216\u5206\u4eab\u91cd\u8981\u7684\u4ea7\u54c1\u66f4\u65b0\u3002", "7d0db380a5b95a8ba1da0bca241abda1": "\u5730\u5740\u4e3a", "0a5a05a3fa122118321d6ec05bd19153": "\u6211\u6709\u4e00\u4e2a\u6539\u8fdb\u5e94\u7528\u7a0b\u5e8f\u7684\u597d\u70b9\u5b50\u3002\u6211\u8be5\u600e\u4e48\u529e\uff1f", "e67e36480698b059943a766e37620b4f": "\u6211\u4eec\u4e5f\u4e00\u76f4\u5728\u5bfb\u6c42\u6539\u8fdb\u5e94\u7528\u7a0b\u5e8f\u4ee5\u6ee1\u8db3\u7528\u6237\u9700\u6c42\u3002\u8bf7\u8054\u7cfb\u6211\u4eec", "77c31401b78afa5afb6378b4bc6296b6": "\u6211\u5982\u4f55\u83b7\u53d6\u652f\u6301\uff1f", "94aea02d39752ad8a233761f4d8f825e": "\u82e5\u6709\u53cd\u9988\u6216\u95ee\u9898\u8981\u8054\u7cfb\u6211\u4eec\uff0c\u8bf7\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3", "ebddc93a6f399f413dc414e3b5eba9ae": "\u67d0\u4e9b\u7aef\u70b9\u8981\u6c42\u7528\u6237\u5728\u5176\u8bf7\u6c42\u4e2d\u5305\u542bAPI\u5bc6\u94a5\uff0c\u8fd9\u65b9\u9762\u7684\u66f4\u591a\u8be6\u60c5\u8bf7\u53c2\u9605<a href=\"{{0}}\">\u6b64\u5904</a>\u3002", "bd10bd754457535b8fc779ec717f5210": "GLAD\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u8be6\u89e3", "6cbf5a73d9f66d3a19e0a61d9ff62420": "\u65b0\u7684\u96f7\u8fbe\u8b66\u62a5\u7a7f\u900f\u4e91\u5c42\u76d1\u6d4b\u68ee\u6797", "01dceebb5fd037bc2559dc911639466d": "\u65b0\u7684\u96f7\u8fbe\u8b66\u62a5\uff08RADD\uff09\u52a9\u529b31\u4e2a\u56fd\u5bb6\u6539\u5584\u68ee\u6797\u780d\u4f10\u68c0\u6d4b\uff0c\u5e76\u5e2e\u52a9\u516c\u53f8\u8ffd\u6c42\u53ef\u6301\u7eed\u4f9b\u5e94\u94fe", "0c5b089c15be0ff341af0ef01d24faa8": "Small Grants Fund\u4e3a\u4e16\u754c\u5404\u5730\u7684\u7ec4\u7ec7\u63d0\u4f9b\u8d22\u653f\u548c\u6280\u672f\u652f\u6301\uff0c\u5e2e\u52a9\u4ed6\u4eec\u4f7f\u7528GFW\u7684\u5de5\u5177\u548c\u6570\u636e\u5c06\u68ee\u6797\u76d1\u6d4b\u4fe1\u606f\u8f6c\u5316\u4e3a\u884c\u52a8\u3002\u4e0e\u5f53\u5730\u7ec4\u7ec7\u5bc6\u5207\u5408\u4f5c\u4e5f\u6709\u52a9\u4e8eGFW\u4e86\u89e3\u5982\u4f55\u6700\u597d\u5730\u8c03\u6574\u6211\u4eec\u7684\u5de5\u5177\u4ee5\u6ee1\u8db3\u8be5\u7528\u6237\u7fa4\u4f53\u7684\u72ec\u7279\u9700\u6c42\u3002", "ced760f4ac64db5dc795ef17513abf70": "\u5927\u5b66&nbsp;", "6116f4554e4870287e30a16b360e7f0f": "\u4e2a\u4eba&nbsp;", "622f03993fcb35d607a685de298b9955": "\u79c1\u4eba\u54a8\u8be2\u673a\u6784", "20131b78355b47e17d9b7f2883bf1f4d": "\u6280\u672f\u7814\u7a76\u5458\u901a\u8fc7\u4e3a\u653f\u5e9c\u548c\u5f53\u5730\u6d3b\u52a8\u4eba\u58eb\u63d0\u4f9b\u57f9\u8bad\u548c\u6301\u7eed\u652f\u6301\uff0c\u5e2e\u52a9\u4ed6\u4eec\u5728\u5176\u5de5\u4f5c\u4e2d\u6709\u6548\u4f7f\u7528\u68ee\u6797\u6570\u636e\u548c\u76d1\u6d4b\u6280\u672f\uff0c\u5e76\u63d0\u9ad8\u4ed6\u4eec\u53c2\u4e0e\u76d1\u6d4b\u975e\u6cd5\u780d\u4f10\u68ee\u6797\u7684\u80fd\u529b\u3002\u8bf7\u53c2\u9605", "2fec9c13283bd334df049b2ead485653": "\u5173\u6ce8\u533a\u57df\u662f\u60a8\u5b9a\u4e49\u8981\u76d1\u89c6\u5176\u4e2d\u68ee\u6797\u53d8\u5316\u7684\u533a\u57df\u3002\u5f53\u60a8\u5728Forest Watcher\u4e0a\u521b\u5efa\u5173\u6ce8\u533a\u57df\u65f6\uff0c\u4f1a\u5f39\u51fa\u8be5\u533a\u57df\u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u3002&nbsp;", "ff3829a9137984d7b5565b2e599eade0": "\u79bb\u7ebf\uff1a", "108a98a26c33f65ac27ae599cd197436": "\u9009\u62e9\u5e76\u5bfc\u822a\u81f3\u8b66\u62a5\u3002", "a275bcc188a2c01114d06555b0ebb494": "\u8ddf\u8e2a\u60a8\u7684\u8def\u7ebf\u3002", "266f96667ea0baf6f07dce6f44103ecf": "\u5f53\u60a8\u79bb\u7ebf\u65f6\uff0c\u6211\u4eec\u5efa\u8bae\u60a8\u5728\u8bbe\u7f6e\u4e2d\u5c06\u5e94\u7528\u7a0b\u5e8f\u7f6e\u4e8e\u201c\u79bb\u7ebf\u6a21\u5f0f\u201d\uff0c\u4ee5\u63d0\u9ad8\u5e94\u7528\u7a0b\u5e8f\u7684\u7a33\u5b9a\u6027\u3002&nbsp;", "9acd8306eb8da6acabded89e046d8f03": "\u53ea\u6709\u6cd5\u5f8b\u8ba4\u5b9a\u4e3a\u975e\u8425\u5229\u548c\u975e\u653f\u5e9c\u7684\u7ec4\u7ec7\u624d\u6709\u8d44\u683c\u83b7\u5f97Small Grants Fund\u3002\u53ef\u4ee5\u5ba1\u67e5\u8d44\u683c\u6807\u51c6", "5fe446062455474e0c064e08b20b7f76": "\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002", "b9dedf8e54a6365cf7b3ebfe5d889e85": "4 GB+", "f2e8344a3bf1d65d475de416948538fe": "Forest Watcher\u79fb\u52a8\u7248\u5141\u8bb8\u7528\u6237\u521b\u5efa\u5173\u6ce8\u533a\u57df\u5e76\u76d1\u63a7\u5176\u4e2d\u7684\u8b66\u62a5\u3002\u5173\u6ce8\u533a\u57df\u53ef\u5728\u5e94\u7528\u7a0b\u5e8f\u542f\u52a8\u65f6\u6216\u5728\u201c\u533a\u57df\u201d\u9875\u9762\u4e2d\u6307\u5b9a\u3002\u60a8\u53ef\u4ee5\u67e5\u770b\u60a8\u5173\u6ce8\u7684\u533a\u57df\u7684\u6700\u65b0\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u8b66\u62a5\uff0c\u5e76\u4e0b\u8f7d\u5b83\u4eec\u4ee5\u79bb\u7ebf\u643a\u5e26\u548c\u5e26\u5165\u73b0\u573a\u3002\u4e0b\u8f7d\u540e\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u8be5\u5e94\u7528\u7a0b\u5e8f\u4f7f\u7528\u624b\u673a\u5185\u90e8GPS\u5f15\u5bfc\u60a8\u5230\u8fbe\u9644\u8fd1\u8b66\u62a5\u5730\u70b9\uff0c\u5e76\u968f\u65f6\u8ddf\u8e2a\u8bb0\u5f55\u60a8\u7684\u8def\u7ebf\uff0c\u7136\u540e\u586b\u5199\u8868\u683c\u5e76\u62cd\u7167\u4ee5\u8bb0\u5f55\u60a8\u7684\u89c2\u5bdf\u53d1\u73b0\u7ed3\u679c\u3002&nbsp;", "58de35730051dfcf1e3cfdd2862af77e": "\u8c01\u6709\u8d44\u683c\u7533\u8bf7Small Grants Fund\u548cTech Fellowship\uff1f", "ce756d4164773bca4d75988609380653": "\u7814\u7a76\u4eba\u5458", "38d47669a7749ae865447607ccbcc6df": "\u6211\u7684\u4fe1\u606f\u662f\u5426\u4f1a\u5206\u4eab\u7ed9GFW\u4ee5\u5916\u7684\u4eba\uff1f", "e0e52e4f1269ccbdeb93c62d50660f1a": "\u5728\u7ebf\uff1a", "ed8322f3adce2ee2f99f6922f18f2ffc": "Covid-19\u4f7f\u975e\u6cd5\u4f10\u6728\u8005\u6709\u673a\u4f1a\u4fb5\u5360\u65af\u91cc\u5170\u5361\u53d7\u4fdd\u62a4\u68ee\u6797\u3002Forest Watcher\u6b63\u5728\u5e2e\u52a9\u963b\u6b62\u4ed6\u4eec\u3002", "151c9066d27177376995b6b9bb3ff3ec": "\u536b\u661f\u6570\u636e\u5e2e\u52a9\u65af\u91cc\u5170\u5361\u68ee\u6797\u5b98\u5458\u5728\u75ab\u60c5\u671f\u95f4\u4ee5\u5b89\u5168\u8ddd\u79bb\u5de1\u903b", "282e049f3642babd112a1b9f54a1f9ca": "\u4ee5\u524d\u7684Small Grants Fund\u7533\u8bf7\u8005\u662f\u5426\u6709\u8d44\u683c\uff1f", "bdd27f27b18dd1720fe943e59d12950f": "\u8fd8\u53ef\u4ee5\u901a\u8fc7\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u62a5\u544a\u9875\u9762\u4e0a\u7684\u5bfc\u51fa\u529f\u80fd\u8bbf\u95ee\u62a5\u544a\u3002\u4f7f\u7528\u6b64\u529f\u80fd\uff0c\u60a8\u53ef\u4ee5\u5c06\u62a5\u544a\u76f4\u63a5\u4e0b\u8f7d\u5230\u60a8\u7684\u8bbe\u5907\uff0c\u5e76\u5728\u79bb\u7ebf\u65f6\u4e0e\u5176\u4ed6\u8bbe\u5907\u5206\u4eab\u8fd9\u4e9b\u62a5\u544a\u3002", "efd0dd048418372f399859da87263f73": "Forest Watcher\u662f\u5426\u63d0\u4f9b\u82f1\u8bed\u4ee5\u5916\u7684\u8bed\u8a00\u7248\u672c\uff1f", "18db27d4809bfb03259b6937e80d9557": "\u4ee5\u67e5\u770b\u6240\u9009\u65f6\u95f4\u8303\u56f4\u5185\u662f\u5426\u6709\u8be5\u4f4d\u7f6e\u7684\u6570\u636e\u3002\u5982\u679c\u6700\u8fd1\u6ca1\u6709\u68ee\u6797\u780d\u4f10\u6216VIIRS\u6d3b\u52a8\u706b\u707e\u8b66\u62a5\uff0c\u5219\u5f88\u53ef\u80fd\u6700\u8fd1\u6ca1\u6709\u68ee\u6797\u53d8\u5316\u6d3b\u52a8\u3002\u4e0d\u59a8\u8003\u8651\u4f7f\u7528\u5e74\u5ea6\u6797\u6728\u8986\u76d6\u635f\u5931\u4e0a\u4e0b\u6587\u56fe\u5c42\u6765\u67e5\u627e\u65e9\u524d\u635f\u5931\u8b66\u62a5\uff0c\u8fd9\u4ecd\u7136\u53ef\u4ee5\u4e3a\u8c03\u67e5\u6216\u5b9e\u5730\u8d70\u8bbf\u63d0\u4f9b\u4fe1\u606f\u3002", "6600d9b04fa49413c0306a58c97d1e7f": "\u5982\u4f55\u5206\u4eab\u548c\u63a5\u6536\u62a5\u544a\u548c\u8def\u7ebf\uff1f", "9560754a65b582685e99da757ae8f630": "Forest Watcher\u7f51\u9875\u7248\u662f\u4e0e\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u4e92\u8865\u7684\u5728\u7ebfWeb\u754c\u9762\uff0c\u53ef\u7528\u4e8e\u7ba1\u7406\u5173\u6ce8\u533a\u57df\u3001\u81ea\u5b9a\u4e49\u62a5\u544a\u6a21\u677f\u3001\u914d\u7f6e\u7528\u6237\u56e2\u961f\u4ee5\u53ca\u67e5\u770b\u548c\u4e0b\u8f7d\u901a\u8fc7\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u63d0\u4ea4\u7684\u62a5\u544a\u3002 \u7ba1\u7406\u5458\u548c\u56e2\u961f\u7ecf\u7406\u53ef\u4ee5\u4f7f\u7528Forest Watcher\u7f51\u9875\u7248\u4e3a\u5176\u56e2\u961f\u8bbe\u7f6e\u5e94\u7528\u7a0b\u5e8f\u3002\u7528\u6237\u5e94\u4f7f\u7528\u4e0e\u8bbf\u95ee\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u76f8\u540c\u7684\u767b\u5f55\u4fe1\u606f\u767b\u5f55Forest Watcher\u7f51\u9875\u7248\u3002\u6b32\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u8bbf\u95ee", "1f1a591b1dfbd575b3b54644a9d3fb56": "\u5efa\u8bae\u7684\u6700\u5927\u6587\u4ef6\u5927\u5c0f\u4e3a1 MB\uff0c\u66f4\u5927\u7684\u6587\u4ef6\u90fd\u53ef\u80fd\u65e0\u6cd5\u6b63\u5e38\u5de5\u4f5c\u3002\u590d\u6742\u7684\u5f62\u72b6\u4e5f\u53ef\u80fd\u6709\u95ee\u9898\u3002\u8bf7\u901a\u8fc7\u4ee5\u4e0b\u65b9\u5f0f\u8054\u7cfb\u6211\u4eec", "75a842add9084bb9bb9e9a894a0beef2": "\u6211\u80fd\u5426\u53ea\u7528Forest Watcher\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u800c\u4e0d\u7528Forest Watcher\u7f51\u9875\u7248\uff1f", "c6747774095886ce873dfb91132fad63": "\u4e3a\u4ec0\u4e48\u6211\u770b\u5230\u68ee\u6797\u780d\u4f10\u8b66\u62a5\uff0c\u4f46\u536b\u661f\u5f71\u50cf\u5e95\u56fe\u6ca1\u6709\u53d8\u5316\uff1f", "38d57526936de508d1f2f7c1d41ee1b5": "\u5bfc\u822a\u5230\u67d0\u4e2a\u8b66\u62a5\u6216\u533a\u57df\u65f6\uff0c\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u5730\u56fe\u53f3\u4e0b\u89d2\u7684\u62a5\u544a\u56fe\u6807\u6765\u6dfb\u52a0\u62a5\u544a\u3002\u60a8\u5c06\u80fd\u591f\u62cd\u6444\u6216\u9009\u62e9\u56fe\u7247\u5c06\u5176\u6dfb\u52a0\u5230\u62a5\u544a\u4e2d\uff0c\u7136\u540e\u586b\u5199\u8868\u683c\u4ee5\u8bb0\u5f55\u60a8\u7684\u89c2\u5bdf\u53d1\u73b0\u7ed3\u679c\u3002", "656d0570a3c31813263ad87ea3174859": "\u8981\u62a5\u544a\u4e00\u7ec4\u8b66\u62a5\uff0c\u60a8\u53ef\u4ee5\u70b9\u51fb\u6b63\u5728\u8c03\u67e5\u7684\u68ee\u6797\u780d\u4f10\u548c/\u6216VIIRS\u8b66\u62a5\uff0c\u7136\u540e\u70b9\u51fb\u5730\u56fe\u53f3\u4e0b\u89d2\u7684\u62a5\u544a\u6309\u94ae\u3002\u53ef\u4ee5\u9010\u4e00\u9009\u62e9\u8b66\u62a5\uff0c\u7136\u540e\u70b9\u51fb\u62a5\u544a\u6309\u94ae\uff0c\u8fd9\u6837\u5c31\u53ef\u4ee5\u62a5\u544a\u591a\u4e2a\u8b66\u62a5\u3002\u60a8\u8fd8\u53ef\u4ee5\u4f7f\u7528\u201c\u9009\u62e9\u6240\u6709\u5173\u8054\u8b66\u62a5\u201d\u6309\u94ae\u81ea\u52a8\u5bf9\u4e0e\u5f53\u524d\u6240\u9009\u8b66\u62a5\u5173\u8054\u7684\u8b66\u62a5\u8fdb\u884c\u5206\u7ec4\u3002\u9009\u4e2d\u540e\uff0c\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u5c06\u53d8\u4e3a\u7eff\u8272\uff0cVIIRS\u8b66\u62a5\u5c06\u53d8\u4e3a\u7d2b\u8272\u3002", "3e081bcb1caa902ba8576630d932ffe0": "\u8981\u8bb0\u5f55\u8def\u7ebf\uff0c\u60a8\u53ef\u4ee5\u70b9\u51fb\u5730\u56fe\u5de6\u4e0b\u89d2\u7684\u5f00\u59cb\u56fe\u6807\u3002\u8bb0\u5f55\u5b8c\u8def\u7ebf\u540e\uff0c\u60a8\u53ef\u4ee5\u70b9\u51fb\u505c\u6b62\u56fe\u6807\u5e76\u9009\u62e9\u662f\u4fdd\u5b58\u8def\u7ebf\u8fd8\u662f\u5220\u9664\u8def\u7ebf\u3002\u5982\u679c\u4fdd\u5b58\u8def\u7ebf\uff0c\u5219\u53ef\u4ee5\u5728\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u7684\u201c\u8def\u7ebf\u201d\u9875\u9762\u4e0a\u8bbf\u95ee\u5b83\u3002", "21385f5bd57b95894aafcc3952d31f1e": "\u60a8\u53ef\u4ee5\u901a\u8fc7\u5bfc\u822a\u5230\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u201c\u8bbe\u7f6e\u201d\u9875\u9762\u7684\u201c\u4e0a\u4e0b\u6587\u56fe\u5c42\u201d\u90e8\u5206\u5e76\u70b9\u51fb\u201c\u5206\u4eab\u201d\u6765\u5206\u4eab\u4e0a\u4e0b\u6587\u56fe\u5c42\u3002\u4ece\u8fd9\u91cc\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u8981\u5206\u4eab\u7684\u4e0a\u4e0b\u6587\u56fe\u5c42\uff0c\u5e76\u9009\u62e9\u5c06\u6346\u7ed1\u5305\u5bfc\u51fa\u5230\u8bbe\u5907\u4e0a\u7684\u4f4d\u7f6e\u3002\u7136\u540e\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u60a8\u9009\u62e9\u7684\u5206\u4eab\u9009\u9879\uff08\u4f8b\u5982\u7535\u5b50\u90ae\u4ef6\uff0c\u84dd\u7259\u6216WhatsApp\uff09\u5206\u4eab\u4e0a\u4e0b\u6587\u56fe\u5c42\u6346\u7ed1\u5305\u3002&nbsp;", "346a0e5408d5f74e0b5df0e6466e2ae5": "GFW\u5728Forest Watcher\u4e0a\u63d0\u4f9b\u9884\u52a0\u8f7d\u7684\u68ee\u6797\u53d8\u5316\u548c\u4e0a\u4e0b\u6587\u6570\u636e\u3002\u9884\u52a0\u8f7d\u7684\u6570\u636e\u5305\u62ec\u4e09\u79cd\u7c7b\u578b\u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5\uff08GLAD\u3001GLAD-S2\u3001RADD\uff09\u3001VIIRS\u6d3b\u52a8\u706b\u707e\u8b66\u62a5\u3001\u5e74\u5ea6\u6797\u6728\u8986\u76d6\u635f\u5931\u548c\u4fdd\u62a4\u533a\u3002\u6709\u5173\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u3001VIIRS\u6d3b\u52a8\u706b\u707e\u8b66\u62a5\u548c\u5e74\u5ea6\u6797\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u7684\u4fe1\u606f\u5982\u4e0b\u6240\u793a\u3002", "f11e5afe9981df8400614eb81e5eecf3": "<strong>RADD\u68ee\u6797\u780d\u4f10\u8b66\u62a5\uff1a</strong> \u7531\u74e6\u8d6b\u5b81\u6839\u5927\u5b66\u548c\u7814\u7a76\u4e2d\u5fc3\uff08WUR\uff09\u5730\u7406\u4fe1\u606f\u79d1\u5b66\u4e0e\u9065\u611f\u5b9e\u9a8c\u5ba4\u5236\u4f5c\uff0c\u6bcf6\u523012\u5929\u66f4\u65b0\u4e00\u6b21\uff0c\u5206\u8fa8\u7387\u4e3a10\u7c73\u3002\u8fd9\u4e9b\u8b66\u62a5\u4f7f\u7528\u6b27\u6d32\u822a\u5929\u5c40Sentinel-1\u536b\u661f\u7684\u7a7f\u4e91\u96f7\u8fbe\u6570\u636e\u6765\u8bc6\u522b\u53ef\u80fd\u53d1\u751f\u539f\u59cb\u6797\u635f\u5931\u7684\u533a\u57df\u3002\u5f53\u524d\u7248\u672c\u53d1\u5e03\u65f6\uff082021\u5e747\u6708\uff09\u53ef\u63d0\u4f9b\u6492\u54c8\u62c9\u4ee5\u5357\u975e\u6d32\u548c\u4e1c\u5357\u4e9a\u5c9b\u5c7f\u5730\u533a\u7684\u8b66\u62a5\u3002", "7f9a1d3ac1b6142360606498f34e1a03": "<strong>VIIRS\u6d3b\u52a8\u706b\u707e\u8b66\u62a5\uff1a</strong> \u7531NASA\u5236\u4f5c\uff0c\u6bcf\u5929\u66f4\u65b0\uff0c\u5206\u8fa8\u7387\u4e3a375\u7c73\u3002\u8fd9\u4e9b\u8b66\u62a5\u663e\u793a\u4e0a\u5468\u7591\u4f3c\u53d1\u751f\u706b\u707e\u7684\u5730\u70b9\u3002", "173bae030b24da442f575a23aea6228c": "\u60a8\u8fd8\u53ef\u4ee5\u4eceGFW\u6dfb\u52a0\u5176\u4ed6\u4e0a\u4e0b\u6587\u56fe\u5c42\uff0c\u5305\u62ecLandMark\u571f\u8457\u548c\u793e\u533a\u571f\u5730\uff0c\u4ee5\u53ca\u5404\u79cd\u7279\u8bb8\u9886\u5730\u548c\u751f\u7269\u591a\u6837\u6027\u6570\u636e\uff0c\u6216\u8005\u60a8\u53ef\u4ee5\u901a\u8fc7\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u4e0a\u4f20\u81ea\u5b9a\u4e49\u4e0a\u4e0b\u6587\u56fe\u5c42\u3002Forest Watcher\u79fb\u52a8\u7248\u652f\u6301\u4ee5\u4e0b\u6587\u4ef6\u7c7b\u578b\u4e0a\u4f20\uff1a.json\u3001.geojson\u3001.topojson\u3001.gpx\u3001.zip\u3001.kmz\u548c.kml\u3002&nbsp;", "bcaac836a822aa06af121b53097862fe": "\u6bcf\u4e2a\u6570\u636e\u5c42\u90fd\u7ecf\u8fc7\u4e25\u683c\u7684\u79d1\u5b66\u6d4b\u8bd5\uff0c\u5e76\u5177\u6709\u4e00\u7ec4\u72ec\u7279\u7684\u9650\u5236\u6761\u4ef6\u3002&nbsp;", "b1ca243fb1a604e6ec3c2abdffeaefde": "\u7528\u6237\u5e94\u8bb0\u4f4f\uff0cForest Watcher\u4e2d\u63d0\u4f9b\u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u68c0\u6d4b\u6240\u6709\u7c7b\u578b\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\uff0c\u65e0\u8bba\u662f\u7531\u4eba\u4e3a\u539f\u56e0\uff08\u5982\u4f10\u6728\uff09\u8fd8\u662f\u81ea\u7136\u539f\u56e0\uff08\u5982\u5c71\u4f53\u6ed1\u5761\uff09\u5f15\u8d77\u7684\u3002\u8b66\u62a5\u4e0d\u533a\u5206\u5929\u7136\u6797\u8986\u76d6\u548c\u4eba\u9020\u6797\u8986\u76d6\u3002", "827857c758cd8b28cdc3e455363fe9d4": "2016\u5e74\uff0c Jane Goodall Institute\uff08JGI\uff09\u3001GFW\u3001Touchlab\u548cGoogle\u5408\u4f5c\u521b\u5efa\u4e86\u4e00\u4e2a\u6d4b\u8bd5\u7248\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\uff0c\u7528\u4e8e\u79bb\u7ebf\u76d1\u63a7\u4e4c\u5e72\u8fbe\u7684\u4fdd\u62a4\u533a\u3002\u5728\u6210\u529f\u7684\u8bd5\u70b9\u9636\u6bb5\u4e4b\u540e\uff0cGFW\u3001JGI\u548cVizzuality\u521b\u5efa\u4e86Forest Watcher\uff0c\u4ee5\u4fbf\u7528\u4e8e\u79bb\u7ebf\u548c\u73b0\u573a\u8bbf\u95eeGFW\u6570\u636e\u3002\u8be5\u5e94\u7528\u7a0b\u5e8f\u76ee\u524d\u7531GFW\u548c3 Sided Cube\u7ef4\u62a4\u3002", "1566157f09142dc6f9f5484564b4ef8a": "Forest Watcher\u53ef\u4ee5\u5728\u4efb\u4f55iOS 13\u53ca\u66f4\u9ad8\u7248\u672c\u7684 iPhone\u4e0a\u8fd0\u884c\u3002\u4e0b\u9762\u5217\u51fa\u4e86Android\u8bbe\u5907\u7684\u6700\u4f4e\u548c\u63a8\u8350\u89c4\u683c\u3002", "05a1e5d68d97c9321059b034d0013bec": "RAM\uff1a1.5 GB", "7aaf13bbabce8c0bed9fb06dc4b6e42b": "\u9664\u975e\u6cd5\u5f8b\u5141\u8bb8\uff0c\u5426\u5219\u6211\u4eec\u4e0d\u4f1a\u4e0e\u4efb\u4f55\u4e0d\u76f4\u63a5\u534f\u52a9GFW\u63d0\u4f9b\u670d\u52a1\u7684\u4eba\u5206\u4eab\u4e2a\u4eba\u7528\u6237\u4fe1\u606f\u3002\u6211\u4eec\u4e0d\u4f1a\u51fa\u4e8e\u8425\u9500\u76ee\u7684\u5206\u4eab\u6216\u51fa\u552e\u60a8\u7684\u4fe1\u606f\u3002", "2008545a3b35daa318e1f9542700aef2": "\u6211\u5728MyGFW\u4e0a\u7684\u4fe1\u606f\u6709\u591a\u5b89\u5168\uff1f", "079a7603209757f99459ad18f24b8ccd": "Rainforest Foundation US\uff08RFUS\uff09\u5df2\u57f9\u8bad\u79d8\u9c81\u8fd1 40 \u4e2a\u571f\u8457\u793e\u533a\u4f7f\u7528Forest Watcher\u6765\u68c0\u6d4b\u3001\u8c03\u67e5\u548c\u5904\u7406\u5176\u9886\u5730\u5185\u7684\u5404\u79cd\u975e\u6cd5\u6d3b\u52a8\u3002", "b5badd5830b7a96ecae8846e9e631a7d": "Amazon Conservation Team\u57f9\u8bad\u82cf\u91cc\u5357\u4e2d\u90e8\u548c\u5357\u90e8\u7684\u571f\u8457\u793e\u533a\u548c\u62a4\u6797\u5458\u4f7f\u7528Forest Watcher\u8c03\u67e5GLAD\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u7684\u539f\u56e0\uff0c\u4ece\u800c\u52a0\u5f3a\u5bf9\u8be5\u5730\u533a\u539f\u59cb\u6797\u666f\u89c2\u7684\u793e\u533a\u76d1\u6d4b\u548c\u4fdd\u62a4\u5de5\u4f5c\u3002", "55d2995e4c5230147180b3ca43e28589": "SAILD\u548cMadeleine Ngegunga\u57f9\u8bad\u8bb0\u8005\u7f51\u7edc\u548c\u5f53\u5730\u793e\u533a\u4f7f\u7528Forest Watcher\u4f5c\u4e3a\u8c03\u67e5\u5de5\u5177\uff0c\u91cd\u70b9\u662f\u62a5\u9053\u548c\u5448\u73b0\u5580\u9ea6\u9686Deng Deng\u68ee\u6797\u4fdd\u62a4\u533a\u5468\u56f4\u7684\u68ee\u6797\u53d8\u5316\u6545\u4e8b\u548c\u4fb5\u72af\u5f53\u5730\u793e\u533a\u6743\u5229\u7684\u884c\u4e3a\u3002", "fd23a433a98daa0c3e56eb6994e4dc96": "\u793e\u533a\u68ee\u6797\u76d1\u6d4b\u5458\u3001\u516c\u56ed\u62a4\u6797\u5458\u3001\u4fdd\u62a4\u7ec4\u7ec7\u3001\u4fdd\u62a4\u533a\u7ba1\u7406\u4eba\u5458\u3001\u8bb0\u8005\u548c\u73af\u5883\u8b66\u5bdf\u4f7f\u7528Forest Watcher\u6765\u68c0\u6d4b\u68ee\u6797\u5e72\u6270\u533a\u57df\uff0c\u544a\u77e5\u4ed6\u4eec\u7684\u5de1\u903b\u8def\u7ebf\u5e76\u6536\u96c6\u6709\u5173\u4ed6\u4eec\u89c2\u5bdf\u53d1\u73b0\u7684\u6570\u5b57\u4fe1\u606f\u3002", "dcfb08657003433e0bbb8881d8e50be8": "\u8bf7\u53c2\u9605\u6211\u4eec\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">\u9690\u79c1\u653f\u7b56</a>\u4e86\u89e3\u66f4\u591a\u7ec6\u8282\u3002", "90ed27d874988cdd9be3f6d12f52a245": "\u4e3a\u4ec0\u4e48\u5728\u6211\u6ce8\u518cMyGFW\u5e10\u6237\u65f6\u8981\u6536\u96c6\u6211\u7684\u4fe1\u606f\uff1f", "074ed43a636a0cb047b78b92fab78aa4": "\u6211\u4eec\u6536\u96c6\u60a8\u7684\u4fe1\u606f\uff0c\u76ee\u7684\u662f\u5e2e\u52a9\u4f7fGFW\u5bf9\u60a8\u66f4\u6709\u7528\u3002\u4f8b\u5982\uff0c\u8fd9\u53ef\u80fd\u5305\u62ec\u7ba1\u7406\u548c\u6539\u8fdbGFW\uff0c\u8ba9\u60a8\u7684GFW\u4f53\u9a8c\u66f4\u4e2a\u6027\u5316\uff0c\u4ee5\u53ca\u4fc3\u8fdbGFW\u66f4\u52a0\u5b89\u5168\u548c\u53ef\u9760\u3002\u6211\u4eec\u8fd8\u53ef\u80fd\u4f7f\u7528\u8fd9\u4e9b\u4fe1\u606f\u4e0e\u60a8\u8054\u7cfb\uff0c\u4ee5\u4e86\u89e3\u6709\u5173\u60a8\u5982\u4f55\u4f7f\u7528GFW\u4ea7\u54c1\u7684\u66f4\u591a\u4fe1\u606f\u3001\u8bf7\u6c42\u60a8\u63d0\u4f9b\u5bf9\u65b0\u529f\u80fd\u7684\u53cd\u9988\u548c/\u6216\u5206\u4eab\u91cd\u8981\u7684\u4ea7\u54c1\u66f4\u65b0\u3002", "98bbf7a09c2c9db95a339250554a03c3": "\u963f\u9a6c\u5e15\u5dde\u68ee\u6797\u8b66\u5bdf\u4f7f\u7528Forest Watcher\u4e0a\u7684GLAD\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u6765\u53d1\u73b0\u5176\u7ba1\u8f96\u8303\u56f4\u5185\u7684\u975e\u6cd5\u6bc1\u6797\u4e8b\u4ef6\uff0c\u5e76\u66f4\u53ca\u65f6\u5730\u91c7\u53d6\u884c\u52a8\u5e94\u5bf9\u5df4\u897f\u4e9a\u9a6c\u900a\u5730\u533a\u7684\u706b\u707e\u548c\u5176\u4ed6\u68ee\u6797\u780d\u4f10\u6d3b\u52a8\u3002", "20fd88d02e4da1101943197ded2d8c4f": "\u4ec0\u4e48\u662fForest Watcher\uff1f", "aa4008541bdcf74c96ab68a2eb193fb6": "Forest Watcher\u662f\u4e00\u4e2a\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u548c\u57fa\u4e8eWeb\u7684\u5e73\u53f0\uff0c\u65e8\u5728\u65b9\u4fbf\u901a\u8fc7GFW\u79bb\u7ebf\u8bbf\u95ee\u6709\u5173\u68ee\u6797\u53d8\u5316\u7684\u6570\u636e\u3002GFW\u662f\u4e00\u4e2a\u5728\u7ebf\u68ee\u6797\u76d1\u6d4b\u548c\u8b66\u62a5\u7cfb\u7edf\uff0c\u5b83\u6c47\u96c6\u4e86\u536b\u661f\u6280\u672f\uff0c\u4e91\u8ba1\u7b97\u548c\u5f00\u653e\u6570\u636e\uff0c\u4ee5\u63d0\u4f9b\u6709\u5173\u68ee\u6797\u7684\u53ca\u65f6\u4fe1\u606f\u3002Forest Watcher\u4f7f\u4efb\u4f55\u4eba\u90fd\u80fd\u591f\u901a\u8fc7\u79fb\u52a8\u8bbe\u5907\u67e5\u770b\u68ee\u6797\u780d\u4f10\u548c\u706b\u707e\u8b66\u62a5\uff0c\u79bb\u7ebf\u5bfc\u822a\u5230\u8b66\u62a5\u7684\u4f4d\u7f6e\u5e76\u6536\u96c6\u6709\u5173\u4ed6\u4eec\u53d1\u73b0\u7684\u4fe1\u606f\u3002&nbsp;", "ac58c8277e0413d38885e7a4e240be75": "OS\uff1aAndroid 5.0", "a64dfb39d4b2835f83749ddd1fc001b7": "\u6700\u5927\u53ef\u4ee5\u521b\u5efa\u591a\u5927\u7684\u5173\u6ce8\u533a\u57df\uff1f", "2cfa736bd1a5d86d381d1610f281f007": "\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u4e0a\u5173\u6ce8\u533a\u57df\u6700\u5927\u9762\u79ef\u4e3a20,000\u5e73\u65b9\u516c\u91cc\uff082,000,000 \u516c\u9877\uff09\u3002\u5982\u679c\u5c1d\u8bd5\u5efa\u7acb\u5927\u4e8e20,000\u5e73\u65b9\u516c\u91cc\u7684\u533a\u57df\uff0c\u60a8\u5c06\u6536\u5230\u4e00\u6761\u51fa\u9519\u6d88\u606f\uff0c\u6307\u51fa\u9762\u79ef\u592a\u5927\u3002", "4fe20c4afbf762cd87f86c5079a3ee5b": "<strong>GLAD-S2\u68ee\u6797\u780d\u4f10\u8b66\u62a5\uff1a</strong> \u4e5f\u7531GLAD Lab\u5236\u4f5c\uff0c\u6bcf5\u5929\u66f4\u65b0\u4e00\u6b21\uff0c\u5206\u8fa8\u7387\u4e3a10\u7c73\u3002\u8fd9\u4e9b\u8b66\u62a5\u4f7f\u7528\u6b27\u6d32\u822a\u5929\u5c40Sentinel-2\u536b\u661f\u6570\u636e\u6765\u786e\u5b9a\u53ef\u80fd\u53d1\u751f\u539f\u751f\u6797\u635f\u5931\u7684\u533a\u57df\u3002\u5f53\u524d\u7248\u672c\u53d1\u5e03\u65f6\uff082021\u5e747\u6708\uff09\u53ef\u63d0\u4f9b\u4e9a\u9a6c\u900a\u76c6\u5730\u7684\u8b66\u62a5\u3002", "3ea72aa09d382033ac45112f278511ab": "\u4e0a\u4f20\u5176\u4ed6\u4e0a\u4e0b\u6587\u56fe\u5c42\u65f6\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u4e0b\u8f7d\u6570\u636e\u4ee5\u4f9b\u79bb\u7ebf\u4f7f\u7528\u6216\u4ec5\u5728\u7ebf\u8bbf\u95ee\u6570\u636e\u3002\u8fd9\u4e9b\u9009\u9879\u4e3a\u5b58\u50a8\u5728\u8bbe\u5907\u4e0a\u7684\u6570\u636e\u63d0\u4f9b\u4e86\u66f4\u5927\u7684\u7075\u6d3b\u6027\u3002", "fdf8bdb0dd6c5c3ed884fc1904cd569a": "\u9274\u4e8e\u5176\u9884\u671f\u7528\u9014\u662f\u5b9e\u5730\u52d8\u5de1\uff0c\u8b66\u62a5\u5728\u8bbe\u8ba1\u4e0a\u504f\u4fdd\u5b88\uff08\u4f8b\u5982\uff0c\u5df2\u786e\u8ba4GLAD\u8b66\u62a5\u7684\u8bef\u62a5\u7387\u4e3a1%\uff0c\u800c\u6f0f\u62a5\u7387\u4e3a 33%\uff1b\u5df2\u786e\u8ba4RADD\u8b66\u62a5\u7684\u8bef\u62a5\u7387\u4e3a2%\uff0c\u800c\u6f0f\u62a5\u7387\u4e3a5%\uff09\u3002\u6b64\u5916\uff0c\u867d\u7136\u8b66\u62a5\u4f1a\u5b9a\u671f\u66f4\u65b0\uff0c\u4f46\u6301\u7eed\u7684\u4e91\u5c42\u8986\u76d6\u53ef\u80fd\u610f\u5473\u7740\u5728\u4e8b\u4ef6\u53d1\u751f\u540e\u51e0\u5468\u751a\u81f3\u51e0\u4e2a\u6708\u5185\u90fd\u4e0d\u4f1a\u68c0\u6d4b\u5230GLAD\u548cGLAD-S2\u8b66\u62a5\u3002", "3a061383b2823368b26a37bc122aa4c5": "GFW\u63d0\u4f9b\u7684\u536b\u661f\u5f71\u50cf\u5e95\u56fe\u7684\u66f4\u65b0\u9891\u7387\u4f4e\u4e8e\u8b66\u62a5\u6570\u636e\u3002\u56e0\u6b64\uff0c\u60a8\u53ef\u80fd\u4f1a\u6ce8\u610f\u5230\u67d0\u533a\u57df\u53d1\u751f\u8b66\u62a5\uff0c\u4f46\u536b\u661f\u5f71\u50cf\u5e95\u56fe\u4ecd\u663e\u793a\u8be5\u533a\u57df\u672a\u53d7\u5e72\u6270\u3002\u8981\u67e5\u770b\u65b0\u8fd1\u536b\u661f\u5f71\u50cf\uff0c\u6211\u4eec\u5efa\u8bae\u60a8\u4f7f\u7528GFW\u4e0a\u63d0\u4f9b\u7684\u65b0\u8fd1\u536b\u661f\u5f71\u50cf\u5de5\u5177\u3002\u8d70\u8bbf\u8b66\u62a5\u73b0\u573a\u662f\u9a8c\u8bc1\u662f\u5426\u53d1\u751f\u53d8\u5316\u6700\u51c6\u786e\u7684\u65b9\u6cd5\uff0c\u4f46\u901a\u5e38\u4e5f\u662f\u6210\u672c\u6700\u9ad8\u7684\u3002\u56e0\u6b64\uff0c\u6211\u4eec\u5efa\u8bae\u60a8\u5728\u8ba1\u5212\u5b9e\u5730\u8003\u5bdf\u4e4b\u524d\u5c3d\u53ef\u80fd\u4f7f\u7528\u65b0\u8fd1\u536b\u661f\u5f71\u50cf\u5de5\u5177\uff0c\u4ee5\u786e\u5b9a\u5e72\u6270\u80cc\u540e\u53ef\u80fd\u7684\u9a71\u52a8\u56e0\u7d20\u3002", "0bb644adcdc754bd5154ee0b1391d63c": "\u6216\u8005\uff0c\u60a8\u4e5f\u53ef\u4ee5\u4e0a\u4f20\u81ea\u5df1\u7684\u536b\u661f\u5f71\u50cf\u548c\u5e95\u56fe\uff0c\u65b9\u6cd5\u662f\u5bfc\u822a\u5230\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u201c\u8bbe\u7f6e\u201d\u9875\u9762\u4e0a\u7684\u201c\u5e95\u56fe\u201d\u90e8\u5206\uff0c\u7136\u540e\u70b9\u51fb\u9875\u9762\u53f3\u4e0a\u89d2\u7684+\u53f7\u3002", "086ca3b11f853fdb33d432879b1fe2ac": "\u662f\u7684\u3002\u73b0\u5728\u60a8\u53ef\u4ee5\u5c06\u81ea\u5df1\u7684\u4e0a\u4e0b\u6587\u56fe\u5c42\u548c\u5e95\u56fe\u76f4\u63a5\u4e0a\u4f20\u5230\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u4e2d\uff0c\u5373\u4f7f\u5728\u79bb\u7ebf\u65f6\u4e5f\u53ef\u4ee5\u3002\u8981\u6dfb\u52a0\u81ea\u5b9a\u4e49\u4e0a\u4e0b\u6587\u56fe\u5c42\u548c\u5e95\u56fe\uff0c\u8bf7\u5bfc\u822a\u5230\u201c\u8bbe\u7f6e\u201d\u9875\u9762\u7684\u201c\u5e95\u56fe\u201d\u90e8\u5206\u6216\u201c\u4e0a\u4e0b\u6587\u56fe\u5c42\u201d\u90e8\u5206\uff0c\u7136\u540e\u70b9\u51fb\u9875\u9762\u53f3\u4e0a\u89d2\u7684+\u53f7\u3002&nbsp;", "9ddb987b49af55fb7b64d8d827aeebea": "\u5982\u4f55\u62a5\u544a\u4e00\u7ec4\u8b66\u62a5\uff1f", "cf24741a54f2d2f60ee9b097a3492573": "\u5982\u4f55\u8bb0\u5f55\u8def\u7ebf\uff1f", "a920b9a64017656ae6655bd83d9b8e6d": "\u6211\u7684\u8def\u7ebf\u591a\u4e45\u521b\u5efa\u4e00\u6b21\u70b9\uff1f", "83d888315f0db4fc37791f0f35e991b7": "\u540c\u6837\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u5bfc\u822a\u5230\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u7684\u201c\u8def\u7ebf\u201d\u90e8\u5206\u5e76\u70b9\u51fb\u201c\u5206\u4eab\u8def\u7ebf\u201d\u6765\u5206\u4eab\u8def\u7ebf\u3002\u4ece\u8fd9\u91cc\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u8981\u5206\u4eab\u7684\u8def\u7ebf\uff0c\u5e76\u9009\u62e9\u5c06\u6346\u7ed1\u5305\u5bfc\u51fa\u5230\u8bbe\u5907\u4e0a\u7684\u4f4d\u7f6e\u3002\u7136\u540e\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u60a8\u9009\u62e9\u7684\u5206\u4eab\u9009\u9879\uff08\u4f8b\u5982\u7535\u5b50\u90ae\u4ef6\uff0c\u84dd\u7259\u6216WhatsApp\uff09\u5206\u4eab\u8def\u7ebf\u6346\u7ed1\u5305\u3002&nbsp;", "f691b32fe5cb456b884d5f47f9ebc836": "\u60a8\u53ef\u4ee5\u901a\u8fc7Forest Watcher\u7f51\u9875\u7248\u6216Forest Watcher\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u4e0a\u4f20\u81ea\u5b9a\u4e49\u4e0a\u4e0b\u6587\u56fe\u5c42\u3002Forest Watcher\u652f\u6301\u4e0a\u4f20\u4ee5\u4e0b\u6587\u4ef6\u7c7b\u578b\u8fdb\uff1a.json\u3001.geojson\u3001.topojson\u3001.gpx\u3001.zip\u3001.kmz\u548c.kml\u3002&nbsp;", "bba8911f3d3173190cc99293883f0cfc": "\u5b8c\u6210\u8fd9\u4e9b\u6b65\u9aa4\u540e\uff0c\u60a8\u7684\u5730\u56fe\u5c06\u51c6\u5907\u5c31\u7eea\u5e76\u81ea\u52a8\u4fdd\u5b58\u3002\u60a8\u53ef\u4ee5\u70b9\u51fb\u84dd\u8272\u56fe\u9489\u4ee5\u67e5\u770b\u62a5\u544a\u7684\u8be6\u7ec6\u4fe1\u606f\uff0c\u5305\u62ec\u7167\u7247\u3002\u8981\u66f4\u6539\u540d\u79f0\uff0c\u8bf7\u5355\u51fb\u5de6\u4e0a\u89d2\u7684\u201c\u65e0\u6807\u9898\u5730\u56fe\u201d\u3002", "13a8467a82f423edfd69fa1ff7278de9": "\u662f\u7684\u3002Forest Watcher\u79fb\u52a8\u7248\u65e8\u5728\u72ec\u7acb\u4e8eForest Watcher\u7f51\u9875\u7248\u4f7f\u7528\u3002\u5728\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u4e0a\uff0c\u60a8\u53ef\u4ee5\u521b\u5efa\u5173\u6ce8\u533a\u57df\u3001\u4e0b\u8f7d\u5e76\u5bfc\u822a\u5230\u8b66\u62a5\u3001\u6cbf\u9014\u8ddf\u8e2a\u8bb0\u5f55\u8def\u7ebf\u5e76\u8bb0\u5f55\u60a8\u7684\u89c2\u5bdf\u53d1\u73b0\u3002\u60a8\u8fd8\u53ef\u4ee5\u76f4\u63a5\u901a\u8fc7\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u4e0a\u4f20\u81ea\u5df1\u7684\u4e0a\u4e0b\u6587\u56fe\u5c42\u548c\u5e95\u56fe\uff0c\u5e76\u5728\u79bb\u7ebf\u65f6\u4e0e\u5176\u4ed6\u8bbe\u5907\u5206\u4eab\u5e94\u7528\u7a0b\u5e8f\u5185\u5bb9\uff08\u8def\u7ebf\u3001\u62a5\u544a\u3001\u533a\u57df\u3001\u8b66\u62a5\u3001\u4e0a\u4e0b\u6587\u6570\u636e\u56fe\u5c42\u3001\u5e95\u56fe\u56fe\u5757\u6216\u6240\u6709\u5e94\u7528\u7a0b\u5e8f\u5185\u5bb9\uff09\u3002&nbsp;", "4221fd1ec57fb0fc05517296697f1284": "\u6211\u770b\u4e0d\u5230\u4efb\u4f55\u8b66\u62a5\u6570\u636e\uff1f", "0877a32a49662c968f54918f9e877ad1": "\u62a5\u8868\u5f52\u7528\u6237\u6240\u6709\uff0c\u4e0d\u516c\u5f00\u5206\u4eab\u3002\u6709\u5173\u66f4\u591a\u8be6\u7ec6\u4fe1\u606f\uff0c\u8bf7\u8bbf\u95ee", "3d689ac65c6e47c3bb98b0a68f44ad29": "\u7528\u6237\u63d0\u4f9b\u65f6\u5b58\u50a8\u7684\u4fe1\u606f\uff1a\u8fd9\u53ef\u80fd\u5305\u62ec\u60a8\u7684\u7535\u8bdd\u53f7\u7801\u3001\u804c\u4f4d\u3001\u96c7\u4e3b\u3001\u60a8\u7ed8\u5236\u6216\u4e0a\u4f20\u5e76\u4fdd\u5b58\u5230\u60a8\u7684MyGFW\u5e10\u6237\u7684\u5173\u6ce8\u533a\u57df\u8fb9\u754c\u3001\u62a5\u544a\u6a21\u677f\u3001\u62a5\u544a\u5185\u5bb9\u3001\u8def\u7ebf\uff0c\u4ee5\u53ca\u60a8\u6216\u5176\u4ed6\u4eba\u901a\u8fc7\u5e94\u7528\u7a0b\u5e8f\u63d0\u4f9b\u7684\u4efb\u4f55\u5176\u4ed6\u5185\u5bb9\u3002", "20a3fe1dd7e31472a1f3cb54aeb85ee4": "\u6211\u5728Forest Watcher\u4e0a\u7684\u4fe1\u606f\u6709\u591a\u5b89\u5168\uff1f", "f1f951fa7d52b0f6496fe6a1e3b0807c": "\u5982\u679c\u6709\u5176\u4ed6\u6709\u7528\u529f\u80fd\u7684\u8bdd\u3002", "36007b28537e86b1d510955f041804f8": "GLAD\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u6bcf\u5468\u66f4\u65b0\u4e00\u6b21\uff0c\u5411\u68ee\u6797\u5b88\u62a4\u8005\u663e\u793a\u6700\u8fd1\u70ed\u5e26\u5730\u533a\u53d1\u751f\u6797\u6728\u635f\u5931\u7684\u533a\u57df\uff0c\u4ee5\u9f13\u52b1\u91c7\u53d6\u884c\u52a8\u3002", "dfc3c619ff94e23eaed11dc2a2f5461b": "\u7814\u7a76\u673a\u6784", "54d29c52df08406f181ebbebf506b7da": "\u3002\u5f88\u9057\u61be\uff0c\u6211\u4eec\u4e0d\u63a5\u53d7\u4ee5\u4e0b\u7533\u8bf7\uff1a&nbsp;", "ba21c7574f057468f8f82f4eaa18e4f7": "\u4e0e\u5176\u4ed6\u8bbe\u5907\u5206\u4eab\u5e94\u7528\u7a0b\u5e8f\u5185\u5bb9\uff08\u533a\u57df\u3001\u8def\u5f84\u3001\u62a5\u544a\u3001\u4e0a\u4e0b\u6587\u56fe\u5c42\u3001\u5e95\u56fe\u56fe\u5757\u6216\u6240\u6709\u5e94\u7528\u7a0b\u5e8f\u5185\u5bb9\uff09\u3002", "5a41477179aaf375fbed8e981ddfcb28": "\u4ec0\u4e48\u662fSmall Grants Fund\u548cTech Fellowship\uff1f", "03e85383e5a29a0f3ed9a6767278437b": "Tech Fellowship\u662f\u4e00\u9879\u4e00\u5e74\u671f\u8ba1\u5212\uff0c\u65e8\u5728\u652f\u6301\u68ee\u6797\u5b88\u62a4\u8005\u5229\u7528\u6280\u672f\u6765\u5e94\u5bf9\u65e5\u76ca\u589e\u957f\u7684\u68ee\u6797\u780d\u4f10\u5a01\u80c1\u3002\u8be5\u5956\u5b66\u91d1\u8ba1\u5212\u7684\u76ee\u6807\u662f\u901a\u8fc7\u57f9\u517b\u4e00\u4e2aGFW\u9ad8\u7ea7\u7528\u6237\u548c\u62e5\u62a4\u8005\u7fa4\u4f53\u6765\u652f\u6301\u8be5\u5e73\u53f0\u5728\u4f18\u5148\u56fd\u5bb6/\u5730\u533a\u7684\u5e94\u7528\uff0c\u4ece\u800c\u6269\u5927\u5e73\u53f0\u5f71\u54cd\u529b\uff0c\u5e76\u5c31\u5982\u4f55\u4f7f\u7528GFW\u5de5\u5177\u548c\u5176\u4ed6\u68ee\u6797\u76d1\u6d4b\u6280\u672f\u6765\u4fdd\u62a4\u5168\u7403\u4f18\u5148\u5730\u533a\u7684\u68ee\u6797\u5f62\u6210\u5171\u540c\u613f\u666f\u3002", "10a3fb2cacd291e4f9e1be239f487d5e": "\u5982\u679c\u60a8\u4e0d\u786e\u5b9a\u8bbe\u5907\u517c\u5bb9\u6027\uff0c\u8bf7\u901a\u8fc7\u4ee5\u4e0b\u65b9\u5f0f\u8054\u7cfb\u6211\u4eec", "654b9d0edc19b3e4b397952af00c9ce4": "\u6211\u53ef\u4ee5\u7528Forest Watcher\u505a\u4ec0\u4e48\uff1f", "6c92285fa6d3e827b198d120ea3ac674": "\u5728\u6b64", "69088f43d78a5499d48ae604906e0437": "Grants\u548cFellowships\u9875\u9762", "eb34f20ad5d86c509cf15100dda68283": "Forest Watcher\u7f51\u9875\u7248\u901a\u8fc7\u53ef\u7f16\u8f91\u7684\u62a5\u544a\u6a21\u677f\u63d0\u4f9b\u66f4\u51fa\u8272\u7684\u81ea\u5b9a\u4e49\u529f\u80fd\uff0c\u5e76\u63d0\u4f9b\u9009\u9879\u4f9b\u60a8\u521b\u5efa\u3001\u67e5\u770b\u548c\u5c06\u62a5\u544a\u5206\u914d\u7ed9\u56e2\u961f\u6210\u5458\u4ee5\u4fc3\u8fdb\u534f\u4f5c\u3002", "ea699f577771c603f5503b6cf4dd510c": "\u867d\u7136Forest Watcher\u79fb\u52a8\u7248\u4e3b\u8981\u8bbe\u8ba1\u7528\u4e8e\u79bb\u7ebf\u4f7f\u7528\uff0c\u4f46\u67d0\u4e9b\u5173\u952e\u529f\u80fd\u9700\u8981\u8fde\u63a5\u4e92\u8054\u7f51\u624d\u80fd\u6267\u884c\u3002Forest Watcher\u5728\u7ebf/\u79bb\u7ebf\u4f7f\u7528\u7684\u5178\u578b\u5de5\u4f5c\u6d41\u7a0b\u5982\u4e0b\u3002&nbsp;", "40f5500fc2e4f5b1660904551fcd3e7e": "\u6309\u60a8\u7684\u5730\u70b9\u6216\u8b66\u62a5\u521b\u5efa\u4e00\u4efd\u62a5\u544a\u3002", "2f703f027af58c1060e03e09a53be24a": "\u6709\u5173 GFW \u5982\u4f55\u5b9a\u4e49\u5173\u952e\u672f\u8bed\u7684\u5feb\u901f\u56fe\u8868\u6307\u5357\uff0c\u8bf7\u9605\u8bfb\u6211\u4eec\u7684\u535a\u5ba2", "250bbd6aac92bc661ce4f82076ddf17c": "\u201c\u5168\u7403\u68ee\u6797\u89c2\u6d4b\u548c\u68ee\u6797\u8d44\u6e90\u8bc4\u4f30\uff0c\u4ee5 5 \u5f20\u56fe\u8868\u89e3\u91ca\u201d (Global Forest Watch and the Forest Resources Assessment, Explained in 5 Graphics)", "79839657ad8987870518879f80309875": "\u67e5\u770b\u4e0b\u6587\uff0c\u4e86\u89e3\u6709\u5173\u5404\u672f\u8bed\u7684\u8be6\u7ec6\u63cf\u8ff0\u3002", "07fd185dd74a915cb5f431e25396326d": "\u68ee\u6797\u7684\u5b9a\u4e49\u4e3a\uff1a\u4ee5 30 \u7c73 Landsat \u50cf\u7d20\u6bd4\u4f8b\u7ed8\u5236\u65f6\u6811\u51a0\u90c1\u95ed\u5ea6\u5927\u4e8e 30%\u3001\u9ad8\u5ea6\u5927\u4e8e 5 \u7c73\u7684\u6811\u6728\u8986\u76d6\u533a\u57df\u3002", "150d3c89823c32683e9e4e4287f51859": "\u201c\u68ee\u6797\u201d\u4e00\u8bcd\u5b58\u5728\u591a\u79cd\u5b9a\u4e49\uff0cGFW \u5e76\u4e0d\u81f4\u529b\u4e8e\u63d0\u4f9b\u516c\u8ba4\u7684\u5b9a\u4e49\u3002GFW \u6258\u7ba1\u7684\u5404\u7c7b\u6570\u636e\u53ef\u80fd\u4f1a\u5bf9\u201c\u68ee\u6797\u201d\u4e00\u8bcd\u7ed9\u51fa\u4e0d\u540c\u7684\u5b9a\u4e49\uff0c\u6216\u53ef\u80fd\u4e0e\u4e0d\u540c\u7c7b\u578b\u7684\u68ee\u6797\u76f8\u5173\uff08\u539f\u751f\u6797\u3001\u6b21\u751f\u6797\u3001\u4eba\u5de5\u79cd\u690d\u6797\u7b49\uff09\u3002\u6839\u636e", "70ba1569ac46d59a7a57757d820dc640": ".\u9664\u975e\u53e6\u6709\u8bf4\u660e\uff0c\u6211\u4eec\u901a\u5e38\u4f1a\u4f7f\u7528\u201c\u68ee\u6797\u6ee5\u4f10\u603b\u91cf\u201d\uff08\u68ee\u6797\u635f\u5931\u7684\u603b\u9762\u79ef\uff09\u800c\u4e0d\u662f\u201c\u68ee\u6797\u6ee5\u4f10\u51c0\u989d\u201d\uff08\u68ee\u6797\u635f\u5931\u7684\u603b\u9762\u79ef\u51cf\u53bb\u68ee\u6797\u589e\u52a0\u7684\u9762\u79ef\uff09\u6765\u6307\u4ee3\u3002", "15410f665dffff48a931b15099e864f9": "\u201c\u68ee\u6797\u6ee5\u4f10\u201d\u7684\u5b9a\u4e49\u901a\u5e38\u662f\u6839\u636e\u201c\u68ee\u6797\u201d\u7684\u5b9a\u4e49\u5f62\u6210\u7684\u3002\u5982\u4e0a\u6587\u6240\u8ff0\uff0c\u201c\u68ee\u6797\u201d\u4e00\u8bcd\u5b58\u5728\u591a\u79cd\u5b9a\u4e49\uff0cGFW \u5e76\u4e0d\u81f4\u529b\u4e8e\u63d0\u4f9b\u516c\u8ba4\u7684\u89c2\u70b9\u3002\u76f8\u5e94\u5730\uff0cGFW \u4e5f\u5e76\u4e0d\u63d0\u4f9b\u5173\u4e8e\u201c\u68ee\u6797\u6ee5\u4f10\u201d\u7684\u5355\u72ec\u5b9a\u4e49\u3002", "e0aef302f136b3aa1efb5d7fad9f5c22": "\u4e86\u89e3\u8be6\u60c5\u548c\u533a\u522b\uff09\u3002", "8714e747eeb81d3d94fe43c6f3067c0f": "\u53ef\u80fd\u7531\u591a\u79cd\u56e0\u7d20\u9020\u6210\u7684\u6811\u6728\u8986\u76d6\u7684\u79fb\u9664\u6216\u6b7b\u4ea1\uff0c\u5982\u673a\u68b0\u91c7\u4f10\u3001\u706b\u707e\u3001\u75be\u75c5\u6216\u98ce\u66b4\u7834\u574f\u3002\u56e0\u6b64\uff0c\u201c\u635f\u5931\u201d\u5e76\u4e0d\u7b49\u540c\u4e8e\u68ee\u6797\u6ee5\u4f10\u3002&nbsp;", "22dcc3b21a368c8fe11ad4d1871ee583": "\u9644\u4e0a\u8be5\u5730\u70b9\u7684\u7b80\u8981\u63cf\u8ff0\u3001\u6709\u95ee\u9898\u7684\u6570\u636e\u4ee5\u53ca\u60a8\u89c2\u5bdf\u5230\u7684\u95ee\u9898\u3002\u6211\u4eec\u7684\u56e2\u961f\u4f1a\u6807\u8bb0\u6b64\u533a\u57df\u4ee5\u4f9b\u8fdb\u4e00\u6b65\u8c03\u67e5\u3002", "9b11e765b2fb9d6344cf51f5f7b09857": "\u5e76\u975e\u6240\u6709\u68ee\u6797\u90fd\u6709\u76f8\u540c\u7684\u8986\u76d6\u533a\u3002\u6709\u7684\u68ee\u6797\u5f88\u8302\u5bc6\uff0c\u6bd4\u5982\u4e9a\u9a6c\u5b59\u70ed\u5e26\u96e8\u6797\uff0c\u6811\u51a0\u5982\u5730\u6bef\u822c\u7ef5\u5ef6\u6570\u82f1\u91cc\uff0c\u51e0\u4e4e\u906e\u853d\u4e86\u6bcf\u4e00\u5bf8\u571f\u5730\u3002\u800c\u53e6\u4e00\u4e9b\u68ee\u6797\u5219\u5f88\u758f\u9614\uff0c\u6bd4\u5982\u5317\u975e\u7684\u7a00\u6811\u8349\u539f\u548c\u6797\u5730\uff0c\u6811\u51a0\u5e76\u4e0d\u4f1a\u95ed\u5408\u6216\u4ea4\u9519\uff0c\u5f7c\u6b64\u4e4b\u95f4\u6709\u8bb8\u591a\u6811\u836b\u3002\u56e0\u6b64\uff0c\u201c\u9700\u8981\u8fbe\u5230\u6811\u6728\u8986\u76d6\u7387\u624d\u80fd\u79f0\u4e4b\u4e3a\u68ee\u6797\u201d\u8fd9\u4e2a\u95ee\u9898\u662f\u6ca1\u6709\u8fbe\u6210\u5168\u7403\u5171\u8bc6\u7684\uff0c\u80fd\u591f\u6839\u636e\u4e0d\u540c\u7684\u201c\u68ee\u6797\u201d\u5b9a\u4e49\u8c03\u6574\u6811\u6728\u8986\u76d6\u90c1\u95ed\u5ea6\u4e5f\u5f88\u91cd\u8981\u3002", "841e41c0a8350ef0a66c1d702271b644": "\u571f\u5730\u5229\u7528\u6570\u636e\uff0c\u5982\u81ea\u7136\u8d44\u6e90\u5f00\u91c7\u7279\u8bb8\u533a\u6216\u519c\u4e1a\u751f\u4ea7\u7279\u8bb8\u533a\uff0c\u5168\u7403\u4fdd\u62a4\u533a\u7684\u8fb9\u754c\uff0c\u4ee5\u53ca\u5305\u62ec\u571f\u5730\u4f7f\u7528\u6743\u5728\u5185\u7684\u4eba\u5458\u6570\u636e\u3002", "31154645410717ca1f63fcfc05baa614": "\u4e3a\u4ec0\u4e48\u4e0d\u540c\u7684\u6570\u636e\u5c42\u4f1a\u76f8\u4e92\u77db\u76fe\uff0c\u6216\u65e0\u6cd5\u5b8c\u5168\u53e0\u52a0\uff1f", "655c6e57ef65d4210e59564c0f274283": "\u4e0d\u540c\u7684\u6570\u636e\u5c42\u6d4b\u91cf\u7684\u5bf9\u8c61\u4e0d\u540c\uff0c\u6240\u4f7f\u7528\u7684\u65b9\u6cd5\u4e5f\u4e0d\u540c\u3002\u8fd9\u4e9b\u5dee\u5f02\u53ef\u80fd\u5bfc\u81f4\u6570\u636e\u5c42\u5728 GFW \u4e0a\u8868\u73b0\u51fa\u77db\u76fe\u3002\u5728\u67d0\u4e9b\u60c5\u5f62\u4e0b\uff0c\u7f3a\u5c11\u53ef\u7528\u7684\u9ad8\u8d28\u91cf\u6570\u636e\u53ef\u80fd\u5bfc\u81f4\u67d0\u4e9b\u6570\u636e\u5c42\u7684\u8bef\u5dee\u5e45\u5ea6\u66f4\u5927\u3002", "c5796b85e39b0dd60bde18b02ec44da9": "\u5b8c\u6574\u68ee\u6797\u666f\u89c2 vs \u6811\u6728\u8986\u76d6\uff1a\u8fd9\u4e9b\u6570\u636e\u5c42\u6d4b\u91cf\u7684\u5bf9\u8c61\u4e0d\u540c\u3002\u201c\u6811\u6728\u8986\u76d6\u201d\u663e\u793a\u7684\u662f\u6240\u6709\u6ee1\u8db3\u4e86\u6811\u6728\u8986\u76d6\u6700\u4f4e\u9650\u503c\uff0825% \u6811\u51a0\u8986\u76d6\u7387\uff09\u7684 30x30 \u7c73\u533a\u57df\uff0c\u800c\u201c\u5b8c\u6574\u68ee\u6797\u666f\u89c2\u201d\u4ec5\u663e\u793a\u6ca1\u6709\u660e\u663e\u4eba\u7c7b\u6d3b\u52a8\u8ff9\u8c61\u7684\u68ee\u6797\uff08\u53c2\u9605", "693c031636f7fbc5758096fc07c91597": "\u8c03\u67e5\u6027\u65b0\u95fb\u7ec4\u7ec7 Reporter Brasil \u4f7f\u7528\u4e86 GFW \u7684\u6570\u636e\uff0c\u4f7f\u5176<a href=\"{{0}}\" target=\"_blank\" aria-label=\"undefined (opens in a new tab)\" rel=\"noreferrer noopener\">\u8c03\u67e5\u62a5\u544a</a>\u5185\u5bb9\u8be6\u5b9e\u5e76\u53ef\u89c6\u5316\u3002", "5e0e02c3154ac72b8c6cf8765d873773": "GFW \u662f\u5982\u4f55\u6784\u5efa\u7684\uff1f", "334412204e20c2c091d1c57ebdd13cb4": "GFW \u5e94\u7528\u7a0b\u5e8f\u662f\u4e0e\u6211\u4eec\u7684\u5916\u90e8\u5408\u4f5c\u4f19\u4f34\u5408\u4f5c\u6784\u5efa\u7684\u3002\u8bf7\u8bbf\u95ee\u5e94\u7528\u7a0b\u5e8f\u7f51\u7ad9\uff0c\u4e86\u89e3\u5173\u4e8e\u5e94\u7528\u7a0b\u5e8f\u5f00\u53d1\u3001\u8bbe\u8ba1\u548c\u6570\u636e\u653f\u7b56\u7684\u66f4\u591a\u4fe1\u606f\u3002", "eed4134e3a7c5a046732c48dca76746c": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240 (World Resources Institute)</a> \u9886\u5bfc\u4e86 GFW \u7684\u5408\u4f5c\u4f19\u4f34\u5173\u7cfb\uff0c\u5305\u62ec\u7ba1\u7406\u4e0e <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener\">Vizzuality</a> \u5408\u4f5c\u8bbe\u8ba1\u7684\u5f00\u6e90\u5e73\u53f0\u3002", "9f3b6701b540f33fb8dbe866fbb258ca": "\u6216", "b83f4a7b9db1fcd6100f09c115164590": "\u6216<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">\u6b64\u5904\u7684\u7b2c 2 \u90e8\u5206</a>", "f8784a48dbfd2b1f7bd53af1d32c2e9f": "GFW \u4e0a\u53ef\u83b7\u5f97\u54ea\u4e9b\u7c7b\u578b\u7684\u6570\u636e\uff1f", "7346f2bf250616bd36187dcb9aba58d8": "\u8981\u8d21\u732e\u6570\u636e\u6216\u9488\u5bf9\u6570\u636e\u63d0\u51fa\u5efa\u8bae\uff0c\u8bf7", "5e0b4f8d07357c1375efddfd0b1c4075": "\u6392\u653e\u4f30\u7b97\u6709\u591a\u7cbe\u51c6\uff1f", "081ac522a553f8a09609498437938add": "\u4e3a REDD+ \u5efa\u7acb\u575a\u5b9e\u7684 MRV \u7cfb\u7edf\uff0c\u662f\u6210\u529f\u5b9e\u73b0\u78b3\u51cf\u6392\u6218\u7565\u7684\u5173\u952e\u7ec4\u6210\u90e8\u5206\u3002GFW \u65e0\u610f\u53d6\u4ee3\u56fd\u5bb6/\u5730\u533a\u4e3b\u5bfc\u7684 MRV \u5de5\u4f5c\uff0c\u540e\u8005\u5e94\u56ca\u62ec\u6709\u5173\u8ba1\u5212\u6216\u5df2\u5b9e\u65bd\u653f\u7b56\u548c\u63aa\u65bd\u6240\u5e26\u6765\u6e29\u5ba4\u6c14\u4f53\u5f71\u54cd\u7684\u66f4\u591a\u8be6\u7ec6\u4fe1\u606f\u3002\u7136\u800c\uff0cGFW \u53ef\u4f5c\u4e3a\u72ec\u7acb\u5de5\u5177\uff0c\u7528\u4ee5\u8bc4\u4f30\u68ee\u6797\u7684\u53c2\u8003\u6392\u653e\u6c34\u5e73\u548c\u5176\u4ed6\u56fd\u5bb6\u62a5\u544a\u7684\u4f30\u7b97\u6570\u989d\u3002\u6709\u5173 GFW \u6570\u636e\u548c\u56fd\u5bb6 REDD+ \u6d4b\u91cf\u6570\u636e\u7684\u533a\u522b\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605", "ad1dfe573afbbf9c9650cd8e7961768f": "\u5982\u679c\u4f7f\u7528\u63a8\u8350\u7684\u6d4f\u89c8\u5668\uff0c\u9519\u8bef\u4f9d\u7136\u5b58\u5728\uff0c", "4d867020a48aa59d07476469029ef3c3": ".\u5982\u679c\u60a8\u80fd\u5411\u6211\u4eec\u53d1\u9001\u9047\u5230\u95ee\u9898\u7684\u9875\u9762\u6216\u6570\u636e\u5c42\u7684\u94fe\u63a5\uff0c\u5e76\u5c06\u60a8\u4f7f\u7528\u7684\u6d4f\u89c8\u5668\u544a\u77e5\u6211\u4eec\uff0c\u5c06\u5bf9\u6211\u4eec\u89e3\u51b3\u95ee\u9898\u5927\u6709\u5e2e\u52a9\u3002&nbsp;", "c7dcef1a44cc682b3380684102bbc840": "\u4e3a\u4ec0\u4e48\u6211\u611f\u5174\u8da3\u7684\u6570\u636e\u65e0\u6cd5\u4ece GFW \u4e0b\u8f7d\uff1f", "80f955b014f21a72da7c5d48963c87c9": "\u6570\u636e\u5c42\u65e0\u6cd5\u4e0b\u8f7d\u7684\u4e00\u4e2a\u539f\u56e0\u662f\u539f\u59cb\u6570\u636e\u63d0\u4f9b\u8005\u5bf9\u6570\u636e\u8fdb\u884c\u4e86\u9650\u5236\u3002\u5982\u679c\u60a8\u9700\u8981\u6709\u5173\u6570\u636e\u8bb8\u53ef\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7", "b4f8cc0732a9ff541336beb7f921b11f": "\u7531\u7528\u6237\u63d0\u4f9b\u65f6\u50a8\u5b58\u7684\u4fe1\u606f\uff1a\u8fd9\u53ef\u80fd\u5305\u62ec\u60a8\u7684\u7535\u8bdd\u53f7\u7801\u3001\u804c\u79f0\u3001\u96c7\u4e3b\uff0c\u4ee5\u53ca\u60a8\u7ed8\u5236\u3001\u4e0a\u4f20\u548c\u4fdd\u5b58\u81f3 MyGFW \u8d26\u6237\u7684\u611f\u5174\u8da3\u533a\u7684\u8fb9\u754c\uff0c\u4ee5\u53ca\u60a8\u6216\u5176\u4ed6\u4eba\u901a\u8fc7 MyGFW \u63d0\u4f9b\u7684\u5176\u4ed6\u5185\u5bb9\u3002", "1c17e24fc56420df18e5c05df7c668df": "\u54ea\u4e9b\u4eba\u53ef\u4ee5\u4f7f\u7528 GFW\uff1f", "02d4c27c2d2f427dd1a2388472d74a4d": "GFW \u65e8\u5728\u4ece\u6839\u672c\u4e0a\u63d0\u9ad8\u68ee\u6797\u6570\u636e\u5bf9\u6240\u6709\u4eba\u7684\u53ef\u7528\u6027\u3001\u6570\u636e\u8d28\u91cf\u53ca\u5176\u4fbf\u5229\u6027\u3002\u6bd4\u5982\uff1a", "e8a5b44ff70f223251d51c4657eed5ea": "\u7814\u7a76\u8005\u53ef\u5206\u6790\u67d0\u4e2a\u5730\u533a\u6216\u5168\u7403\u8303\u56f4\u5185\u7684\u68ee\u6797\u53d8\u5316\u8d8b\u52bf\uff0c\u66f4\u597d\u5730\u4e86\u89e3\u68ee\u6797\u53d8\u5316\u7684\u539f\u56e0\u3002", "965c80a7002cf76a90da26e4491417b3": "\u516c\u53f8\u548c\u91d1\u878d\u7814\u7a76\u6240\u53ef\u4ee5", "e443ab9b1bd7c992244a9427ca04d9c2": "\u5b66\u751f\u548c\u6559\u5e08\u4e5f\u80fd\u66f4\u6df1\u5165\u5730\u4e86\u89e3\u5f53\u5730\u548c\u5168\u7403\u8303\u56f4\u5185\u7684\u68ee\u6797\u3002", "50132835a6bd1866a7a7266dd1a1baa5": "\u91cf\u5316\u548c\u7ba1\u7406\u6ee1\u8db3\u6709\u5173\u68ee\u6797\u6ee5\u4f10\u9632\u62a4\u627f\u8bfa\u7684\u8fdb\u5ea6\u3002", "6b4769d41261e3533ac4714583300ba5": "GFW \u5f97\u5230\u4e86\u5404\u79cd\u5408\u4f5c\u4f19\u4f34\u7684\u652f\u6301\uff0c\u4e3a\u5e73\u53f0\u8d21\u732e\u6570\u636e\u3001\u6280\u672f\u80fd\u529b\u3001\u8d44\u91d1\u548c\u4e13\u4e1a\u77e5\u8bc6\u3002\u8fd9\u79cd\u5408\u4f5c\u4f19\u4f34\u5173\u7cfb\u662f\u7531\u2026\u2026\u53ec\u96c6\u7684", "14fea8915502c98f56d303146c7c07f4": "\u901a\u8fc7\u9875\u9762\u5e95\u90e8\u7684\u8868\u683c\u8054\u7cfb\u6211\u4eec", "47ffbf1c9f4781e17720e850dec306e1": "\u5c3d\u7ba1\u6700\u8fd1\u4e00\u4e9b\u5730\u533a\u5df2\u91c7\u53d6\u884c\u52a8\u6253\u51fb\u6709\u5bb3\u7684\u68ee\u6797\u6ee5\u4f10\u884c\u4e3a\uff0c\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u4ecd\u9762\u4e34\u7740\u5a01\u80c1\u3002\u591a\u6570\u5982\u4eca\u4ecd\u7136", "eac0481454b91183c175dfa7185a0db1": "<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">\u63a7\u5236\u9762\u677f</a>\u4e0a\u7684\u6570\u636e\u56fe\u8868", "8ff950cbe090d4825781b609d7dabec1": "\u7136\u800c\uff0cGFW \u4e0a\u53ef\u7528\u7684\u4e0a\u4e0b\u6587\u56fe\u5c42\u53ef\u4ee5\u5e2e\u52a9\u7528\u6237\u5c31\u68ee\u6797\u53d8\u5316\u4e8b\u4ef6\u7684\u6027\u8d28\u548c\u9a71\u52a8\u56e0\u7d20\u5f97\u51fa\u66f4\u6709\u6839\u636e\u7684\u7ed3\u8bba\u3002\u6bd4\u5982\uff0c\u7528\u6237\u53ef\u4ee5\u5728\u53d7\u4fdd\u62a4\u533a\u57df\u56fe\u5c42\u4e0a\u53e0\u52a0\u68ee\u6797\u53d8\u5316\u6570\u636e\uff0c\u4ee5\u6807\u8bb0\u5b58\u5728\u6f5c\u5728\u95ee\u9898\u7684\u533a\u57df\uff1b\u6216\u8005\uff0c\u7528\u6237\u4e5f\u53ef\u4ee5\u62c9\u53d6\u6700\u8fd1\u7684\u536b\u661f\u56fe\u50cf\uff0c\u67e5\u770b\u201c\u70e7\u75d5\u201d\u3001\u201c\u6392\u6c61\u201d\u3001\u4f10\u6728\u9053\u8def\u7b49\u3002", "06fba6ec5624cbd2d03b8f58e11f3e96": "\u4ece GFW \u4e0a\u6258\u7ba1\u7684\u51e0\u4e2a\u5173\u952e\u6570\u636e\u5c42\uff08\u5305\u62ec 2000 \u5e74\u6811\u6728\u8986\u76d6\u3001\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u635f\u5931\u548c\u589e\u52a0\u3001GLAD-L\u3001GLAD-S2 \u548c RADD \u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u3001VIIRS \u4e3b\u52a8\u5f0f\u706b\u8b66\u8b66\u62a5\uff09\u65e0\u6cd5\u533a\u5206\u4eba\u5de5\u79cd\u690d\u6797\u548c\u5929\u7136\u68ee\u6797\u3002\u6811\u6728\u8986\u76d6\u635f\u5931\u53ef\u80fd\u5305\u62ec\u4eba\u5de5\u79cd\u690d\u6797\u91c7\u4f10\u7684\u60c5\u5f62\uff0c\u6811\u6728\u8986\u76d6\u589e\u52a0\u4e5f\u53ef\u80fd\u5305\u62ec\u5929\u7136\u68ee\u6797\u88ab\u4eba\u5de5\u79cd\u690d\u6797\u53d6\u4ee3\u7684\u60c5\u51b5\u3002\u9605\u8bfb\u6211\u4eec\u7684\u535a\u5ba2", "dabd39a1be1e12d02a09dc99c149d18d": ".\u7528\u6237\u53ef\u5e94\u7528\u4eba\u5de5\u79cd\u690d\u6797\u5730\u56fe\uff0c\u4ee5\u66f4\u597d\u5730\u533a\u5206\u68ee\u6797\u53d8\u5316\u6570\u636e\u4e2d\u7684\u79cd\u690d\u6797\u91c7\u4f10\u548c\u4f10\u6797\u9020\u5730\u3002", "97e1388359e11ba4191ec38985c61da1": "GFW \u4e0a\u663e\u793a\u7684\u6570\u636e\u6709\u591a\u7cbe\u51c6\uff1f", "d8ff67ed1f2dca7cc345b90f6576b641": "GFW \u5c3d\u53ef\u80fd\u53ea\u5305\u542b\u6700\u51c6\u786e\u7684\u6570\u636e\uff0c\u5e76\u8ba9\u7528\u6237\u610f\u8bc6\u5230\u6570\u636e\u4e0d\u51c6\u786e\u5b58\u5728\u7684\u98ce\u9669\u3002GFW \u4e0d\u5bf9\u5176\u4ed6\u6765\u6e90\u7684\u6570\u636e\u8d1f\u8d23\u3002\u6709\u5173 GFW \u6570\u636e\u5904\u7406\u65b9\u6cd5\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u8bbf\u95ee\u6211\u4eec\u7684", "38f92f2777c793f86169ea5192b4a646": "\u6b64\u5916\uff0c\u4e3a\u5e94\u5bf9\u6b64\u6311\u6218\uff0c\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240\u7684\u7814\u7a76\u4eba\u5458\u4f7f\u7528\u4ece\u5404\u56fd/\u5730\u533a\u653f\u5e9c\u3001\u975e\u653f\u5e9c\u7ec4\u7ec7\u548c\u72ec\u7acb\u7814\u7a76\u4eba\u5458\u5904\u83b7\u5f97\u7684\u6570\u636e\uff0c\u7ed8\u5236\u4e86 82 \u4e2a\u56fd\u5bb6\u548c\u5730\u533a\u7684\u4eba\u5de5\u79cd\u690d\u6797\u4f4d\u7f6e\u548c\u8303\u56f4\u3002\u9605\u8bfb GFW \u7684", "901cac245276d4206e012cf7cc256d19": "\u83b7\u5f97\u6982\u89c8\uff0c\u9605\u8bfb", "84c88894fffa22020ca6314387481b32": "\u6211\u5982\u4f55\u5c06 GFW \u4f5c\u4e3a\u6570\u636e\u6e90\u5f15\u7528\uff1f", "6d5ed0805b9710a16d89f78bbb4c6067": "\u535a\u5ba2\u6587\u7ae0", "e16704d9e243b23b4f4e557748d6eef6": "\u51fa\u7248\u5185\u5bb9", "bfcd8431f12a2e4d35a05de1f22aafee": "\u83b7\u5f97\u6709\u5173\u8fd9\u4e9b\u65b9\u6cd5\u548c\u53d1\u73b0\u7684\u5b8c\u6574\u8bf4\u660e\uff0c\u6216\u8005", "b5d8b9e64463b5910443241dca1b6883": "\u5728\u5730\u56fe\u4e0a\u63a2\u7d22\u6570\u636e", "52c77fe132e2fd5fc7b089a2d779cbea": "GFW \u4e0a\u663e\u793a\u7684\u6570\u636e\u7684\u51c6\u786e\u6027\u5404\u4e0d\u76f8\u540c\u3002\u6709\u5173\u7279\u5b9a\u6570\u636e\u5c42\u7684\u65b9\u6cd5\u548c\u6ce8\u610f\u4e8b\u9879\uff0c\u8bf7\u8bbf\u95ee", "99159138460bde218d39b36086089409": "\uff1b\u60a8\u4e5f\u53ef\u4ee5\u70b9\u51fb\u56fe\u4f8b\u6216\u6570\u636e\u83dc\u5355\u4e2d\u7684\u4fe1\u606f \"i\" \u56fe\u6807\uff0c\u5728\u5730\u56fe\u4e0a\u8bbf\u95ee\u6b64\u4fe1\u606f\u3002", "6954230fbe1be8cc81b42495f7aaf18f": "\u6211\u4eec\u7684\u535a\u5ba2\u7cfb\u5217\u6587\u7ae0\u63cf\u8ff0\u4e86\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u635f\u5931\u548c\u589e\u52a0\u6570\u636e\u7684\u7cbe\u51c6\u6027\u8bc4\u4f30\uff0c\u8bf7\u53c2\u9605<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">\u6b64\u5904\u7684\u7b2c 1 \u90e8\u5206</a>", "9d8be72017650ebf58e0b72839dc28f1": ".\u5173\u4e8e GLAD \u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u9605\u8bfb\u6211\u4eec\u7684 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">GLAD \u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\uff0c\u89e3\u91ca\u535a\u5ba2</a>\u3002&nbsp;", "4c75cfe0bc1db41b4a24719a2adb0b5a": "\u6570\u636e\u653f\u7b56", "8b73b4f3ea44e5e547228859404878e4": ".\u6211\u4eec\u53ea\u8981\u6c42\u60a8\u63d0\u4f9b\u5f15\u7528\u6216\u89c6\u89c9\u6548\u679c\uff0c\u8868\u660e\u60a8\u6240\u4f7f\u7528\u7684\u6750\u6599\u6e90\u81ea GFW \u5373\u53ef\u3002", "4a84353e8b2ae1d72b5c098400d25c38": "GFW \u6709\u5f00\u653e\u6570\u636e\u653f\u7b56\u3002\u6211\u4eec\u5236\u4f5c\u7684\u6240\u6709\u6570\u636e\u3001\u56fe\u5f62\u3001\u56fe\u8868\u548c\u5730\u56fe\u90fd\u5177\u6709", "a89ed3acebcb03fddb06d22d101ab272": "GFW \u5982\u4f55\u5b9a\u4e49\u5173\u952e\u672f\u8bed\uff1f", "9bf1ccbc85f041fcebcad2cfb80220a5": "GFW \u7684\u6570\u636e\u6709\u591a\u79cd\u6765\u6e90\u3002\u5927\u591a\u6570\u6570\u636e\u6765\u6e90\u4e8e\u516c\u7528\u9886\u57df\uff0c\u7531\u653f\u5e9c\u3001\u975e\u653f\u5e9c\u7ec4\u7ec7\u3001\u7814\u7a76\u673a\u6784\u6216\u516c\u53f8\u6784\u5efa\u3002\u8bf7\u6ce8\u610f\uff0c\u8fd9\u4e9b\u6570\u636e\u6709\u591a\u79cd\u683c\u5f0f\uff0c\u5176\u51c6\u786e\u5ea6\u3001\u53ca\u65f6\u6027\u548c\u5730\u7406\u8303\u56f4\u4e5f\u5404\u4e0d\u76f8\u540c\u3002", "7308d90489d0ccbbd45b90e42642dcfb": "\u5982\u9700\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u8bbf\u95ee GFW \u7684", "191a77422ca5a77fa26ee132a71b8770": "\u6570\u636e\u653f\u7b56", "5b8a9d2af19d93840de742a60e64c02a": "\u6211\u80fd\u5426\u5bf9\u6bd4\u6811\u6728\u8986\u76d6\u3001\u635f\u5931\u548c\u589e\u52a0\u7684\u7edf\u8ba1\u6570\u636e\uff0c\u4ee5\u8ba1\u7b97\u201c\u51c0\u201d\u6811\u6728\u8986\u76d6\u548c\u6811\u6728\u8986\u76d6\u635f\u5931\uff1f", "5477bcc687c3ef2ec40154ef30d906e5": "&nbsp;\u4ee5\u53ca<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener\">\u4ea4\u4e92\u5f0f\u5730\u56fe</a>\u4e0a\u7684\u5206\u6790", "09a66737e1cfb8d6bd3ce9837931cc41": "\u5982\u9700\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u8bbf\u95ee", "264e2cc4fcbf15bd02825ba8acf628ce": "&nbsp;\u5141\u8bb8\u60a8\u6d4f\u89c8\u4f7f\u7528\u9a6c\u91cc\u5170\u5927\u5b66\u548c Google \u7684\u6570\u636e\u8ba1\u7b97\u7684\u6811\u6728\u8986\u76d6\u3001\u635f\u5931\u548c\u589e\u52a0\u7684\u7edf\u8ba1\u6570\u636e\u3002\u7531\u4e8e\u7814\u7a76\u65b9\u6cd5\u548c\u5185\u5bb9\u65e5\u671f\u7684\u4e0d\u540c\uff0c\u6811\u6728\u8986\u76d6\u3001\u635f\u5931\u548c\u589e\u52a0\u6570\u636e\u5f7c\u6b64\u4e4b\u95f4\u4e0d\u80fd\u7cbe\u786e\u6bd4\u8f83\u3002\u76f8\u5e94\u5730\uff0c\u201c\u51c0\u201d\u635f\u5931\u6570\u503c\u4e5f\u65e0\u6cd5\u901a\u8fc7\u7528\u6811\u6728\u8986\u76d6\u635f\u5931\u51cf\u53bb\u6811\u6728\u8986\u76d6\u589e\u52a0\u6570\u503c\u800c\u8ba1\u7b97\uff0c\u5f53\u524d\uff08\u6216 2000 \u5e74\u4e4b\u540e\uff09\u7684\u6811\u6728\u8986\u76d6\u6570\u503c\u4e5f\u65e0\u6cd5\u901a\u8fc7\u7528 2000 \u5e74\u7684\u6811\u6728\u8986\u76d6\u51cf\u53bb\u6bcf\u5e74\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u503c\u800c\u8ba1\u7b97\u3002", "7db5bb9d1ba0f7dcf25d5732e0aa33be": "GFW \u4e0a\u7684\u6570\u636e\u662f\u5426\u80fd\u63ed\u793a\u68ee\u6797\u7ba1\u7406\u8d28\u91cf\uff1f\u80fd\u5426\u533a\u5206\u81ea\u7136\u539f\u56e0\u548c\u4eba\u4e3a\u539f\u56e0\u5bfc\u81f4\u7684\u68ee\u6797\u53d8\u5316\uff1f", "99665a4171d88b7e5e9f3030073c7d69": "GFW \u4e0a\u663e\u793a\u7684\u68ee\u6797\u53d8\u5316\u6570\u636e\uff08\u5982\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u635f\u5931\u548c\u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\uff09\u5e76\u4e0d\u4e00\u5b9a\u80fd\u533a\u5206\u68ee\u6797\u7ba1\u7406\u7684\u8d28\u91cf\uff08\u5982\u662f\u5426\u5177\u5907\u53ef\u6301\u7eed\u6027\uff09\uff0c\u4e5f\u4e0d\u4e00\u5b9a\u80fd\u533a\u5206\u68ee\u6797\u53d8\u5316\u4e8b\u4ef6\u7684\u5408\u6cd5\u6027\uff08\u5982\u662f\u5426\u8fdd\u6cd5\uff09\u6216\u539f\u56e0\uff08\u5982\u81ea\u7136\u6216\u4eba\u4e3a\u539f\u56e0\uff09\u3002\u6bd4\u5982\uff0cGFW \u4e0a\u53ef\u7528\u7684\u68ee\u6797\u53d8\u5316\u6570\u636e\u4f1a\u5305\u62ec\u6811\u6728\u91c7\u4f10\u3001\u706b\u707e\u3001\u866b\u5bb3\u6216\u519c\u4e1a\u4f10\u6797\u5bfc\u81f4\u7684\u68ee\u6797\u53d8\u5316\u3002", "c999904e578ec1c04e31c83a7d7116ff": "\u60a8\u662f\u5426\u62e5\u6709\u6240\u6709\u56fd\u5bb6/\u5730\u533a\u7684\u6b64\u7c7b\u6570\u636e\u5c42\uff1f", "76f87201f4283205e2071f3fe80c802c": "GFW \u81f4\u529b\u4e8e\u63d0\u4f9b\u8986\u76d6\u5168\u7403\u7684\u6570\u636e\uff0c\u4f46\u8fd9\u4e00\u76ee\u6807\u5e76\u975e\u603b\u80fd\u5b9e\u73b0\u3002\u6bcf\u4e2a\u6570\u636e\u5c42\u7684\u5730\u7406\u8986\u76d6\u8303\u56f4\u5df2\u5728\u2026\u2026\u4e2d\u505a\u51fa\u4e86\u63cf\u8ff0", "ca362bd81e25ef7270d3b87bd684218e": "\u901a\u8fc7\u9875\u9762\u5e95\u90e8\u7684\u8868\u683c\u8054\u7cfb\u6211\u4eec", "337f8d4ac52a15e74e2c791257abbc51": "&nbsp;\u4ee5\u544a\u77e5\u6211\u4eec\u3002", "24a1e190e26f3963c876d073f3fd0e2d": "\u201c\u5168\u7403\u68ee\u6797\u89c2\u6d4b\u548c\u68ee\u6797\u8d44\u6e90\u8bc4\u4f30\uff0c\u4ee5 5 \u5f20\u56fe\u8868\u89e3\u91ca\u201d (Global Forest Watch and the Forest Resources Assessment, Explained in 5 Graphics)", "95c9de1639a631aed8e1a9a535a6d4d9": "\u4e86\u89e3 GFW \u5982\u4f55\u6d4b\u91cf\u81ea\u7136\u68ee\u6797\u3001\u4eba\u5de5\u79cd\u690d\u6797\u548c\u68ee\u6797\u53d8\u5316\u3002", "7dfdc45699476f092722d713a0d79ae7": "\u653f\u5e9c\u53ef\u4f7f\u7528 GFW \u68c0\u6d4b\u8fdd\u6cd5\u68ee\u6797\u5f00\u57a6\uff0c\u5e76\u6709\u9488\u5bf9\u6027\u5730\u5f00\u5c55\u6267\u6cd5\u884c\u52a8\u3002", "3b28a3589ac89d982071462ae82fea99": "\u539f\u4f4f\u6c11\u793e\u533a\u53ef\u76d1\u6d4b\u81ea\u5df1\u7684\u9886\u5730\uff0c\u5e76\u5728\u5176\u60ef\u6709\u68ee\u6797\u53d7\u5230\u5a01\u80c1\u65f6\u53d1\u51fa\u8b66\u62a5\u3002", "05ed5bdc3fb897c01eeb047537c82bac": "\u975e\u653f\u5e9c\u7ec4\u7ec7\u548c\u6c11\u6743\u793e\u4f1a\u53ef\u8bc6\u522b\u68ee\u6797\u6ee5\u4f10\u70ed\u70b9\uff0c\u5e76\u52a0\u5f3a\u8c03\u67e5\u3001\u5ba3\u4f20\u548c\u8fd0\u52a8\u3002", "6e008167abe05fde09a91c00859b4ecc": "\u5a92\u4f53\u53ef\u6536\u96c6\u8bc1\u636e\u3001\u6570\u636e\u548c\u56fe\u8868\u7528\u4ee5\u62a5\u9053\u3002", "7bd4e2867aa0ac8b2a03bf045f75be6d": "GFW \u6c47\u805a\u4e86\u4e00\u4e2a\u5145\u6ee1\u6d3b\u529b\u7684\u5408\u4f5c\u4f19\u4f34\u793e\u533a\uff0c\u5177\u6709\u68ee\u6797\u79d1\u5b66\u3001\u81ea\u7136\u4fdd\u62a4\u3001\u4f9b\u5e94\u94fe\u7ba1\u7406\u3001\u7f51\u9875\u5f00\u53d1\u3001\u516c\u6c11\u79d1\u5b66\u3001\u793e\u533a\u5916\u5c55\u5de5\u4f5c\u548c\u5bf9\u4e16\u754c\u5404\u5730\u91cd\u70b9\u68ee\u6797\u7684\u6df1\u5165\u4e86\u89e3\u7b49\u65b9\u9762\u7684\u4e13\u4e1a\u77e5\u8bc6\u3002", "01af837ea89e2450af8368198f6bf47c": "\u5168\u7403\u5404\u5730\u7684\u5173\u5fc3\u4eba\u58eb\u4e5f\u80fd\u4e86\u89e3\u68ee\u6797\u7684\u73b0\u72b6\uff0c\u5e76\u53c2\u4e0e\u5230\u68ee\u6797\u76d1\u6d4b\u4e2d\u6765\u3002", "10c76df623813cec099b19615167487b": ".\u8bbf\u95ee", "fe7dbb168a50e08a8b53e2796d506069": "\u5408\u4f5c\u4f19\u4f34\u7684\u5b8c\u6574\u5217\u8868\u3002", "f6b91fd6ca9441c972a8ede7d9cbc1d2": "\u6709\u610f\u52a0\u5165 GFW \u5408\u4f5c\u4f19\u4f34\u5173\u7cfb\uff1f", "9897312538fc2f9e2e5b305357f8d902": "\u4eba\u7c7b\u793e\u4f1a\u548c\u5168\u7403\u7ecf\u6d4e\u4e0e\u68ee\u6797\u6709\u7740\u5343\u4e1d\u4e07\u7f15\u7684\u8054\u7cfb\u3002\u8d85\u8fc7\u5341\u4ebf\u4eba\u53e3\u4f9d\u9760\u68ee\u6797\u7ef4\u6301\u751f\u8ba1\u3002\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u5728\u7a33\u5b9a\u6c14\u5019\u65b9\u9762\u53d1\u6325\u7740\u5173\u952e\u4f5c\u7528\uff1b\u4e3a\u4eba\u4eec\u63d0\u4f9b\u98df\u7269\u3001\u6c34\u8d44\u6e90\u3001\u6728\u6750\u4ea7\u54c1\u548c\u91cd\u8981\u836f\u6750\uff1b\u5168\u7403\u5927\u591a\u6570\u7684\u751f\u7269\u591a\u6837\u6027\u4e5f\u6709\u8d56\u4e8e\u68ee\u6797\u751f\u6001\u7cfb\u7edf\u7684\u652f\u6491\u3002\u67e5\u770b\u6211\u4eec\u7684", "66e5ba2dbd83f67b275816585d4f6d21": "\u68ee\u6797\u4e3a\u4f55\u91cd\u8981\uff1f", "771e68cbf0742f26dd1fde10e6c87aab": "\u63a2\u7d22\u68ee\u6797\u4e0e\u5bf9\u53ef\u6301\u7eed\u6027\u81f3\u5173\u91cd\u8981\u7684\u6570\u4e2a\u5173\u952e\u4e3b\u9898\u4ee5\u53ca\u4eba\u7c7b\u672a\u6765\u751f\u6001\u7cfb\u7edf\u5065\u5eb7\u4e4b\u95f4\u7684\u8054\u7cfb\u3002", "600a09b03fbad14f6796618fd8b0eee4": "\u5987\u5973\u7814\u7a76\u6240 (The Women Research Institute, WRI) <a aria-label=\"undefined (opens in a new tab)\" href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u5728\u5370\u5ea6\u5c3c\u897f\u4e9a\u5404\u5730\u57f9\u8bad\u5973\u6027</a>\u5728\u5730\u56fe\u4e0a\u53e0\u52a0\u6570\u636e\u2014\u2014\u5982\u9002\u7528\u4e8e\u68d5\u6988\u6cb9\u52a0\u5de5\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u548c\u706b\u707e\u8b66\u62a5\u7b49\uff0c\u4ee5\u534f\u52a9\u660e\u786e\u516c\u53f8\u8fd0\u8425\u4e0e\u5bf9\u8fd9\u4e9b\u5973\u6027\u7684\u5bb6\u5ead\u548c\u793e\u533a\u9020\u6210\u5f71\u54cd\u7684\u73af\u5883\u95ee\u9898\u4e4b\u95f4\u5b58\u5728\u7684\u5173\u8054\u3002", "25bfc6462f25c145db51752f36166765": "\u9a6c\u6765\u897f\u4e9a\u68ee\u6797\u76d1\u6d4b\u5b9e\u9a8c\u5ba4 (The Malaysian Forest Monitoring Lab) \u901a\u8fc7 GFW \u8ba2\u9605\u4e86\u68ee\u6797\u6ee5\u4f10\u548c\u706b\u707e\u8b66\u62a5\uff0c\u4ee5\u4fbf\u5728\u68ee\u6797\u53d1\u751f\u53d8\u5316\u65f6\u6536\u5230\u901a\u77e5\u5e76\u53ca\u65f6\u54cd\u5e94\u3002", "705b1f63a81ec8d67f8e3d2f0d158e5b": "\u65b0\u95fb\u7ec4\u7ec7 <a href=\"{{0}}\" target=\"_blank\" aria-label=\"undefined (opens in a new tab)\" rel=\"noreferrer noopener\">Mongabay</a> \u4f7f\u7528 GFW \u7684\u5730\u56fe\u6765\u8bc6\u522b\u65b0\u4ea7\u751f\u7684\u6797\u5730\u7686\u4f10\u533a\uff0c\u5e76\u62a5\u9053\u4ee5\u6570\u636e\u4e3a\u652f\u6491\u7684\u53ca\u65f6\u65b0\u95fb\u8baf\u606f\uff0c\u5c55\u73b0\u4e16\u754c\u68ee\u6797\u7684\u53d8\u5316\u8d8b\u52bf\u3002", "84e62e01ecefc2c3aedb8c9ef2130a4e": "GFW \u7684\u80cc\u540e\u662f\u8c01\uff1f", "663ddc1b33dd94367ec70ace14711935": "\u8bdd\u9898\u9875\u9762", "72129ffe0e8c4c58fcebe5d72e299c1a": "\u672a\u906d\u635f\u574f\u7684\u68ee\u6797\u666f\u89c2\u4ec5\u5360\u5168\u7403\u68ee\u6797\u8986\u76d6\u603b\u9762\u79ef\u7684 13%", "f6d97022f8a0eafe1ef3771ce4122977": "\u8981\u5e73\u8861\u4eba\u7c7b\u5bf9\u81ea\u7136\u8d44\u6e90\u7684\u9700\u6c42\u548c\u4fdd\u62a4\u91cd\u8981\u751f\u6001\u7cfb\u7edf\u7684\u9700\u6c42\uff0c\u8d44\u6e90\u7ba1\u7406\u8005\u4eec\u9700\u8981\u7fd4\u5b9e\u7684\u6570\u636e\u624d\u80fd\u505a\u51fa\u826f\u597d\u7684\u51b3\u7b56\u3002GFW \u53ef\u4ee5\u63d0\u4f9b\u5168\u7403\u8303\u56f4\u7684\u6b64\u7c7b\u6570\u636e\uff0c\u4ece\u800c\u63d0\u4f9b\u5e2e\u52a9\u3002", "f28fc4178381ae6167bcf6a94f633f00": "\u5c79\u7acb\u4e0d\u5012\u7684\u68ee\u6797\uff0c\u5b9e\u5219\u5df2\u7ecf\u9000\u5316\u6216\u56db\u5206\u4e94\u88c2\u3002\u4e00\u9879\u6570\u636e\u663e\u793a\uff0c", "f1c41ca1ad0295686e9af852c5762f7f": "GFW \u7684\u6570\u636e\u6765\u81ea\u54ea\u91cc\uff1f", "f5273d93f15601824c974232c253ebde": "GFW \u662f\u5426\u80fd\u533a\u5206\u4eba\u5de5\u79cd\u690d\u6797\u548c\u5929\u7136\u68ee\u6797\uff1f", "372d9ace5be6e1cacc96376482588bb0": "\u751f\u7269\u591a\u6837\u6027\u6570\u636e\uff0c\u5305\u62ec\u5168\u7403\u751f\u7269\u591a\u6837\u6027\u610f\u4e49\uff0c\u751f\u7269\u591a\u6837\u6027\u70ed\u70b9\u548c\u7279\u6709\u9e1f\u7c7b\u533a\u3002", "cc1a4d6c0b2ff02d7d71b226ac406937": "\u6211\u53ef\u4ee5\u4f7f\u7528\u672c\u7f51\u7ad9\u5bf9 REDD+ \u8fdb\u884c\u9879\u76ee\u7ea7\u76d1\u6d4b\u548c\u8bc4\u4f30\u5417\uff1f", "82f9611d14e7ebcd33f19140a4cd562e": ".\u540c\u65f6\u4e5f\u5efa\u8bae\u60a8\u5b89\u88c5", "633eab1170db263beb3486c559786661": ".\u6211\u4eec\u4f1a\u5c3d\u6700\u5927\u52aa\u529b\u5e2e\u52a9\u60a8\u83b7\u5f97\u6240\u9700\u6570\u636e\u3002", "ed3851988a900235aa42ebbc8d5a63b0": "\u6ce8\u518c\u65f6\u6536\u96c6\u7684\u4fe1\u606f\uff1a\u8fd9\u53ef\u80fd\u5305\u62ec\u60a8\u7684\u59d3\u540d\u3001\u7535\u5b50\u90ae\u7bb1\u5730\u5740\u3001\u7528\u6237\u540d\u548c\u901a\u8fc7\u793e\u4ea4\u5a92\u4f53\u767b\u5f55\u5206\u4eab\u7684\u4fe1\u606f\u3002", "034d79cf74754db0604355ab5f075519": "\u51fa\u4e8e\u5404\u79cd\u539f\u56e0\uff0c\u6570\u636e\u8986\u76d6\u8303\u56f4\u53ef\u80fd\u6709\u9650\u3002GFW \u81f4\u529b\u4e8e\u5c3d\u5feb\u7eb3\u5165\u65b0\u6570\u636e\uff0c\u5982\u679c\u60a8\u53d1\u73b0\u6709\u6211\u4eec\u5c1a\u672a\u6574\u5408\u7684\u516c\u5171\u53ef\u7528\u6570\u636e\u5c42\uff0c\u8bf7", "d2bd0100d9ec3ea385de01c3007ca039": "\u201c\u6811\u6728\u8986\u76d6\u635f\u5931\u201d\u662f\u6307", "b1e0f92f0656b92a848c0838380b897f": "\u4ee5\u4e86\u89e3\u66f4\u591a\u8be6\u60c5\u3002&nbsp;", "c4b9bc8875c255469d0736664d2bc520": "\u6c14\u5019\u6570\u636e\u4e0e\u56fd\u5bb6/\u5730\u533a\u5c42\u9762\u7684\u6d4b\u91cf\u3001\u62a5\u544a\u548c\u9a8c\u8bc1 (MRV) \u6709\u4f55\u5173\u8054\uff1f", "198b0945bf501bced7b631e22fe8873b": "\u6211\u5fd8\u8bb0\u4e86 MyGFW \u5bc6\u7801\uff0c\u600e\u4e48\u529e\uff1f", "94eaf7b43e9ee8089b5da00def9f9915": "\u8bf7\u8054\u7cfb\u6211\u4eec", "c9842c24c176fc1a4cd1c39138f8a58c": "\u4f7f\u7528\u672c\u9875\u9762\u5e95\u90e8\u7684\u8868\u683c\u6216", "a488323e4ed98128362a4bdcbe60b00a": "\u6216\u8005\uff0c\u5730\u56fe\u7684\u4fe1\u606f\u7a97\u53e3\uff08\u901a\u8fc7 \"i\" \u56fe\u6807\u8bbf\u95ee\uff09\u901a\u5e38\u4f1a\u5305\u542b\u64cd\u4f5c\u8bf4\u660e\u6216\u94fe\u63a5\u4ee5\u65b9\u4fbf\u8fd9\u4e00\u8fc7\u7a0b\u3002", "2201cd209216e19b3879cf7ebbc03bd2": "\u53e6\u4e00\u4e2a\u539f\u56e0\u662f\uff0c\u6570\u636e\u63d0\u4f9b\u8005\u8981\u6c42\u6570\u636e\u4f7f\u7528\u8005\u76f4\u63a5\u4ece\u63d0\u4f9b\u8005\u6240\u5728\u7684\u7ec4\u7ec7\u7533\u8bf7\u6570\u636e\u3002\u5982\u679c\u662f\u8fd9\u6837\uff0c", "9389aa7ff496dcd055892a27bec6aca0": "\u6b64\u5916\uff0c\u60a8\u9700\u8981\u7684\u6570\u636e\u53ef\u80fd\u4e0d\u662f\u60a8\u60f3\u8981\u7684\u683c\u5f0f\u3002\u5982\u679c\u60a8\u6709\u610f\u4ee5\u5176\u4ed6\u683c\u5f0f\u83b7\u53d6\u67d0\u4e00\u6570\u636e\u5c42\uff0c\u6216\u5e0c\u671b\u83b7\u53d6\u4efb\u4f55\u6570\u636e\u5c42\u7684\u5b50\u96c6\uff0c\u8bf7", "7ec72bd2cdbe6e7e764aabbda3d03558": "\u5982\u679c\u60a8\u5728\u4f7f\u7528\u53ef\u7528\u4e0b\u8f7d\u94fe\u63a5\u65f6\u9047\u5230\u4e86\u95ee\u9898\uff0c\u8bf7", "07d7b242e538ae0f924894d5bf615b03": "\u5982\u679c\u60a8\u6709\u60f3\u4e0b\u8f7d\u7684\u6570\u636e\u5c42\uff0c\u4f46\u5b83\u65e0\u6cd5\u4ece\u5730\u56fe\u3001\u63a7\u5236\u9762\u677f\u6216", "6bc87f662e519aa52e446badc0fab402": "\u4e0a\u4e0b\u8f7d\uff0c\u4e14\u6ca1\u6709\u5176\u4ed6\u4fe1\u606f\u8bf4\u660e\u4e3a\u4f55\u8be5\u6570\u636e\u53ef\u80fd\u6301\u4e25\u683c\u8bb8\u53ef\uff0c\u8bf7", "547b6e517667eb39eb6166a9af9c490a": "\u5f53\u6211\u6ce8\u518c MyGFW \u8d26\u6237\u65f6\uff0c\u4f1a\u88ab\u6536\u96c6\u54ea\u4e9b\u6570\u636e\uff1f", "4d5a08f4ced783e9614720e10f7d2c44": "\u5f53\u60a8\u6ce8\u518c MyGFW \u8d26\u6237\u65f6\uff0c\u6211\u4eec\u53ef\u80fd\u4f1a\u6536\u96c6\u4e24\u79cd\u7c7b\u578b\u7684\u4fe1\u606f\u3002", "fc821eadaf84e044aef2c39096b09893": "\u571f\u5730\u8986\u76d6\u6570\u636e\uff0c\u5982\u5168\u7403\u6811\u6728\u8986\u76d6\u3001\u539f\u751f\u6797\u3001\u5b8c\u6574\u68ee\u6797\u666f\u89c2\u548c\u4eba\u5de5\u79cd\u690d\u6797\u3002", "8fb134e34712713512eec9651bd793cd": "\u6c14\u5019\u6570\u636e\uff0c\u5982\u6811\u6728\u8986\u76d6\u635f\u5931\u9020\u6210\u7684\u4e8c\u6c27\u5316\u78b3\u6392\u653e\u3001\u6811\u6728\u751f\u7269\u91cf\u5bc6\u5ea6\u3001\u571f\u58e4\u78b3\u5bc6\u5ea6\u548c\u68ee\u6797\u518d\u751f\u7684\u9884\u8ba1\u78b3\u5c01\u5b58\u91cf\u3002", "f253ef19eb583a474b84520fcea71808": "\u901a\u8fc7\u76d1\u6d4b\u8fd9\u4e9b\u6570\u636e\u5c42\u968f\u65f6\u95f4\u7684\u53d8\u5316\uff0c\u7528\u6237\u53ef\u4ee5\u66f4\u597d\u5730\u4e86\u89e3\u5168\u7403\u68ee\u6797\u635f\u5931\u7684\u9a71\u52a8\u56e0\u7d20\u548c\u6a21\u5f0f\u3002\u67e5\u770b\u6211\u4eec\u7684", "d41d425a02491f1096bebb55cdea7191": "Google \u5e95\u56fe vs \u56fd\u5bb6/\u5730\u533a\u6570\u636e\u5c42\uff1a\u5728\u67d0\u4e9b\u60c5\u5f62\u4e0b\uff0c\u56fd\u5bb6/\u5730\u533a\u6570\u636e\u5c42\u4e0e Google \u5e95\u56fe\u5e76\u4e0d\u4e00\u81f4\uff0c\u6570\u636e\u53ef\u80fd\u5728\u56fd\u754c\u7ebf/\u5730\u533a\u8fb9\u754c\u5916\u663e\u793a\u3002\u4e0d\u662f\u6240\u6709\u7684\u56fd\u5bb6/\u5730\u533a\u56fe\u5c42\u90fd\u4f7f\u7528\u4e86\u540c\u4e00\u4e2a\u5e95\u56fe\u5bfc\u51fa\uff0c\u56e0\u6b64\u53ef\u80fd\u5b58\u5728\u8f7b\u5fae\u7684\u4e0d\u4e00\u81f4\u3002", "d40459eef8d61f02b67fa8de1058b56b": "\u7528\u6237\u53ef\u80fd\u4f1a\u53d1\u73b0\u6811\u6728\u8986\u76d6\u4e0d\u5728\u5b8c\u6574\u68ee\u6797\u666f\u89c2\u8fb9\u754c\u5185\u7684\u60c5\u51b5\uff0c\u8fd9\u662f\u56e0\u4e3a\u5b8c\u6574\u68ee\u6797\u666f\u89c2\u56fe\u5c42\u662f\u57fa\u4e8e MODIS\uff08250 \u7c73\u5206\u8fa8\u7387\u536b\u661f\u56fe\u50cf\uff09\u751f\u6210\u7684\uff0c\u4f17\u6240\u5468\u77e5\uff0cMODIS \u4f1a\u9ad8\u4f30\u4f4e\u77ee\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\uff1b\u800c\u6811\u6728\u8986\u76d6\u56fe\u5c42\u662f\u57fa\u4e8e Landsat\uff0830 \u7c73\u5206\u8fa8\u7387\u536b\u661f\u56fe\u50cf\uff09\u751f\u6210\u7684\u3002\u56e0\u6b64\uff0c\u5728\u5b8c\u6574\u68ee\u6797\u666f\u89c2\u591a\u8fb9\u5f62\u4e2d\u7684\u6811\u6728\u8986\u76d6\u533a\u57df\uff0c\u53ef\u80fd\u4e0d\u4f1a\u5728\u6811\u6728\u8986\u76d6\u56fe\u5c42\u4e2d\u663e\u793a\u3002", "3cdca510758baca04742c0dd179c1336": "\u4e86\u89e3\u8be6\u60c5\uff09\u3002", "064d7eef2d2e71b36c7ff600e176e0e5": "\u5c3d\u7ba1 GFW \u4e0a\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u548c\u78b3\u6392\u653e\u4f30\u7b97\u5728\u65f6\u95f4\u548c\u7a7a\u95f4\u7ef4\u5ea6\u4e0a\u90fd\u662f\u660e\u786e\u7684\uff0c\u4f46\u7531\u4e8e\u78b3\u5bc6\u5ea6\u6570\u636e\u7684\u5c3a\u5ea6\uff0c\u4ee5\u53ca\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u7684\u9010\u5e74\u4e0d\u786e\u5b9a\u6027\uff0c\u6211\u4eec\u4ecd\u4e0d\u5efa\u8bae\u5c06\u5176\u5e94\u7528\u4e8e REDD+ \u7684\u9879\u76ee\u7ea7\u8bc4\u4f30\u3002\u6bd4\u5982\uff0c\u5355\u4e2a\u50cf\u7d20\u4e2d\u7684\u5730\u9762\u6d3b\u6728\u751f\u7269\u91cf\u5bc6\u5ea6\u503c\u5728\u4e0e\u7528\u4e8e\u9a8c\u8bc1\u7684\u5c0f\u5730\u5757\u76f8\u6bd4\u8f83\u65f6\uff0c\u5c31\u53ef\u80fd\u4f1a\u6709\u5f88\u5927\u7684\u4e0d\u786e\u5b9a\u6027\u3002\u56e0\u6b64\uff0c\u5730\u56fe\u4e0a\u7684\u53ef\u89c6\u5316\u68ee\u6797\u53d8\u5316\u5145\u5176\u91cf\u53ea\u80fd\u88ab\u89c6\u4e3a\u6307\u793a\u6027\u7684\u6570\u636e\uff0c\u53ef\u80fd\u9700\u8981\u5b9e\u5730\u8bc4\u4f30\u6216\u66f4\u9ad8\u5206\u8fa8\u7387\u56fe\u50cf\u4ee5\u4f5c\u8fdb\u4e00\u6b65\u9a8c\u8bc1\u3002", "93e3e004973eb733a9c20b3a163c0211": "\u7531\u4e8e\u5730\u9762\u751f\u7269\u91cf\u50a8\u91cf\u548c\u6811\u6728\u8986\u76d6\u635f\u5931\u7b49\u8f93\u5165\u6570\u636e\u4e2d\u56fa\u6709\u7684\u4f30\u7b97\u8bef\u5dee\uff0c\u6392\u653e\u4f30\u7b97\u7684\u51c6\u786e\u6027\u53ef\u80fd\u5404\u5f02\u3002\u5c3d\u7ba1\u6392\u653e\u6570\u636e\u6ca1\u6709\u6b63\u5f0f\u7684\u4e0d\u786e\u5b9a\u6027\u8bc4\u4f30\uff0c\u4f46\u5730\u56fe\u548c\u63a7\u5236\u9762\u677f\u4f1a\u5728\u96c6\u6210\u81f3\u5927\u9762\u79ef\uff08&gt; 5,000 \u81f3 10,000 \u516c\u9877\uff09\u4ee5\u8fdb\u884c\u9879\u76ee\u548c\u533a\u57df\u7ea7\u8bc4\u4f30\u65f6\uff0c\u63d0\u4f9b\u5bf9\u5730\u9762\u78b3\u50a8\u91cf\u548c\u5730\u9762\u78b3\u5bc6\u5ea6\u7684\u51c6\u786e\u4f30\u8ba1\u3002\u5355\u4e2a\u50cf\u7d20\u4e2d\u7684\u751f\u7269\u91cf\u5bc6\u5ea6\u503c\u5728\u4e0e\u7528\u4e8e\u9a8c\u8bc1\u7684\u5c0f\u5730\u5757\u76f8\u6bd4\u8f83\u65f6\uff0c\u5c31\u53ef\u80fd\u4f1a\u6709\u5f88\u5927\u7684\u4e0d\u786e\u5b9a\u6027\u3002\u6b64\u5916\uff0c\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u4e5f\u4f1a\u5b58\u5728\u9010\u5e74\u4e0d\u786e\u5b9a\u6027\u3002Hansen et al (2013) \u8ba4\u4e3a\uff0c\u635f\u5931\u53d1\u751f\u5728\u6240\u8ff0\u5e74\u4efd\u7684\u7f6e\u4fe1\u5ea6\u4e3a75%\uff0c\u53d1\u751f\u5728\u6240\u8ff0\u5e74\u4efd\u524d\u540e\u4e00\u5e74\u7684\u65f6\u95f4\u6bb5\u5185\u7684\u7f6e\u4fe1\u5ea6\u4e3a 97%\u3002", "b8d95a6e53430c76137460e238c9a2fc": "\u751f\u7269\u91cf\u548c\u78b3\u6709\u4f55\u533a\u522b\uff1f", "6c0f344a52eaad1a8419c7af9a727485": "\u6728\u8d28\uff08\u830e\u5e72\u3001\u679d\u6761\u548c\u6839\u90e8\uff09\u548c\u53f6\u7247\u4e2d\u7684\u78b3\u542b\u91cf\u7ea6\u5360\u5176\u603b\u8d28\u91cf\uff08\u5373\u751f\u7269\u91cf\uff09\u7684 50%\u3002\u7528\u603b\u751f\u7269\u91cf\u4e58\u4ee5\u8be5\u751f\u7269\u91cf\u4e2d\u78b3\u7684\u6bd4\u4f8b\uff0c\u5373\u53ef\u4ee5\u4f30\u7b97\u51fa\u4e00\u68f5\u6811\u6216\u4e00\u4e2a\u5730\u533a\u5185\u7684\u50a8\u5b58\u7684\u78b3\u603b\u91cf\u3002", "07dfe65cc0ff3fab15f1d211c4db0337": "\u6839\u636e\u60a8\u767b\u5f55 MyGFW \u6240\u4f7f\u7528\u7684\u65b9\u5f0f\uff0c\u60a8\u9700\u8981\u8f93\u5165\u7535\u5b50\u90ae\u7bb1\u4ee5\u63a5\u6536\u5bc6\u7801\u91cd\u7f6e\u64cd\u4f5c\u8bf4\u660e\uff0c\u6216\u662f\u524d\u5f80 Facebook\u3001Google \u6216 Twitter \u4ee5\u6062\u590d\u5bc6\u7801\u3002", "84c11dc01d723cb8cdd0d22449d39bae": "\u6211\u8bbf\u95ee\u7f51\u7ad9\u65f6\u9047\u5230\u4e86\u95ee\u9898\uff0c\u600e\u4e48\u529e\uff1f", "8ae76a785788092e1b97175b7d25f1d4": "\u9996\u5148\uff0c\u8bf7\u786e\u4fdd\u60a8\u4f7f\u7528\u4e86\u5408\u9002\u7684\u7f51\u9875\u6d4f\u89c8\u5668\u3002\u6211\u4eec\u63a8\u8350\u60a8\u4f7f\u7528\u6700\u65b0\u7248\u672c\u7684", "e236603b8c1efbb186e038185a0e948d": "\u518d\u4f7f\u7528 GFW \u7f51\u7ad9\u3002", "47cf8832c39c8d9cbd260ceff0f25b6c": "\u5728 GitHub \u4e0a\u63d0\u4ea4\u95ee\u9898", "3103c9d641a201b91803f74d384f6678": "\u68ee\u6797\u6ee5\u4f10", "7dba7ba24a3cbe0ff7414817fba1223e": "\u5728\u4e00\u822c\u5199\u4f5c\u4e2d\uff0cGFW \u4f7f\u7528\u201c\u68ee\u6797\u6ee5\u4f10\u201d\u6765\u8868\u793a", "4288a2873b4c438e7d623262c076ec1f": "\u68ee\u6797\u6c38\u4e45\u6027\u5730\u6539\u53d8\u4e3a\u53e6\u4e00\u79cd\u571f\u5730\u8986\u76d6", "f8e5143baebd1fde17d58e9853d39552": "\u201c\u6811\u6728\u8986\u76d6\u201d\u662f\u6307", "eab1de24eeb950982b74206f1d570e59": "\u6240\u6709\u9ad8\u5ea6\u8d85\u8fc7\u4e94\u7c73\u7684\u690d\u88ab\uff0c\u53ef\u80fd\u662f\u5929\u7136\u68ee\u6797\u7684\u5f62\u5f0f\uff0c\u4e5f\u53ef\u80fd\u662f\u4eba\u5de5\u79cd\u690d\u6797\u7684\u5f62\u5f0f\uff0c\u5176\u90c1\u95ed\u5ea6\u4e5f\u53ef\u80fd\u5404\u4e0d\u76f8\u540c", "4cd65838e1805b6f7ea92de228e0e97d": ".\u5c06\u6240\u6709\u7c7b\u578b\u7684\u4eba\u5de5\u79cd\u690d\u6797\u7eb3\u5165\u201c\u6811\u6728\u8986\u76d6\u201d\u4e00\u8bcd\u5b9a\u4e49\u4e2d\uff0c\u4f7f\u5f97\u201c\u6811\u6728\u8986\u76d6\u201d\u8fd9\u4e00\u5b9a\u4e49\u660e\u663e\u533a\u522b\u4e8e\u201c\u68ee\u6797\u201d\u4e00\u8bcd\u7684\u67d0\u4e9b\u5b9a\u4e49\u3002\u76f8\u5e94\u5730\uff0c\u201c\u6811\u6728\u8986\u76d6\u201d\u548c\u201c\u68ee\u6797\u201d\u4e0d\u5e94\u4e92\u6362\u4f7f\u7528\u3002&nbsp;", "c79299a8a3375cd973e69c486d857edd": "\u4e0d\u540c\u7684\u6570\u636e\u5c42\u4f7f\u7528\u9644\u52a0\u53c2\u6570\uff0c\u8fdb\u4e00\u6b65\u5b9a\u4e49\u4e86\u201c\u6811\u6728\u8986\u76d6\u201d\uff08\u8bf7\u53c2\u9605", "0adeb6adaefcf5341cb964854ffd001b": "\u6211\u5f88\u719f\u6089\u67d0\u4e2a\u5730\u7406\u533a\u57df\uff0c\u5e76\u786e\u4fe1\u4f60\u4eec\u7684\u6570\u636e\u4e0d\u51c6\u786e\u3002\u6211\u5e94\u8be5\u600e\u4e48\u529e\uff1f", "6a1ef1fbec150b5b4dffacef31fa1002": "\u9996\u5148\uff0c\u8bf7\u786e\u4fdd\u60a8\u4e86\u89e3\u6570\u636e\u4e4b\u95f4\u7684\u533a\u522b\u4ee5\u53ca\u5b83\u4eec\u5404\u81ea\u7684\u65b9\u6cd5\u5b66\u3002\u5982\u679c\u60a8\u4ecd\u7136\u8ba4\u4e3a\u6211\u4eec\u7684\u6570\u636e\u4e0d\u51c6\u786e\uff0c\u8bf7", "2b8d568e97d58d505efcaad7b23fd4e0": "\u6811\u6728\u90c1\u95ed\u5ea6\u662f\u4ec0\u4e48\uff1f\u6211\u53ef\u4ee5\u5728\u54ea\u4e9b\u56fe\u5c42\u4e2d\u8c03\u6574\u5b83\uff1f", "0d5d76c4a64a32543312e21a6689b615": "\u8fd9\u4e9b\u767e\u5206\u6bd4\u4ee3\u8868\u4ec0\u4e48\uff1f\u4ece\u6280\u672f\u89d2\u5ea6\u6765\u8bf4\uff0c\u6811\u6728\u8986\u76d6\u90c1\u95ed\u5ea6\u662f\u6839\u636e\u536b\u661f\u56fe\u50cf\u5206\u6790\u800c\u786e\u5b9a\u7684\uff0c\u5b83\u4ee3\u8868\u5728 2000 \u5e74\u7684\u536b\u661f\u56fe\u50cf\u4e0a\uff0c\u88ab\u6811\u51a0\u8986\u76d6\u7684\u50cf\u7d20\u7684\u4f30\u7b97\u767e\u5206\u6bd4\u3002\u5728\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u4e2d\uff0c\u6811\u6728\u8986\u76d6\u90c1\u95ed\u5ea6\u5219\u56e0\u800c\u76f8\u5f53\u4e8e\u635f\u5931\u53d1\u751f\u4e4b\u524d\u7684\u6811\u6728\u8986\u76d6\u5bc6\u5ea6\u3002\u6bd4\u5982\uff0c\u5982\u679c\u60a8\u5c06\u6700\u4f4e\u6811\u6728\u8986\u76d6\u90c1\u95ed\u5ea6\u8bbe\u7f6e\u4e3a 25%\uff0c\u90a3\u4e48\uff0c\u60a8\u53ea\u4f1a\u770b\u5230\u539f\u59cb\u6811\u6728\u8986\u76d6\u90c1\u95ed\u5ea6\u9ad8\u4e8e 25% \u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u50cf\u7d20\u3002", "400bd82ab92b101cb52953fd597087e5": "\u6811\u6728\u8986\u76d6\u90c1\u95ed\u5ea6\u7684\u6700\u4f4e\u503c\u53ea\u80fd\u5728\u9a6c\u91cc\u5170\u5927\u5b66 (UMD) \u548c Google \u7684\u6811\u6728\u8986\u76d6\u548c\u635f\u5931\u6570\u636e\u5c42\u4e2d\u8fdb\u884c\u8c03\u6574\u3002\u5728\u5730\u56fe\u4e0a\u6fc0\u6d3b\u8fd9\u4e9b\u6570\u636e\u5c42\u540e\uff0c\u60a8\u53ef\u4ee5\u5728\u56fe\u4f8b\u4e0a\u8c03\u6574\u90c1\u95ed\u5ea6\u7684\u6700\u4f4e\u767e\u5206\u6bd4\u3002\u5728\u4f7f\u7528\u4e86 UMD \u548c Google \u68ee\u6797\u7edf\u8ba1\u6570\u636e\u7684\u7f51\u7ad9\u5176\u4ed6\u533a\u57df\uff08\u5982\u63a7\u5236\u9762\u677f\uff09\uff0c\u60a8\u4e5f\u53ef\u4ee5\u8fdb\u884c\u6b64\u8c03\u6574\u3002", "e3491fc3cd617c0f9916cec6f74995db": "\u8bf7\u6ce8\u610f\uff1a\u8c03\u6574\u6811\u6728\u8986\u76d6\u90c1\u95ed\u5ea6\u7684\u6700\u4f4e\u503c\u53ea\u4f1a\u5f71\u54cd UMD \u6811\u6728\u8986\u76d6\u548c\u635f\u5931\u6570\u636e\u5c42\u3002\u6b64\u529f\u80fd\u4e0d\u9002\u7528\u4e8e UMD \u6811\u6728\u8986\u76d6\u589e\u52a0\u6570\u636e\u5c42\uff0c\u4e5f\u4e0d\u9002\u7528\u4e8e\u5176\u4ed6\u6570\u636e\u5c42\u6216\u7edf\u8ba1\u6570\u636e\u3002UMD \u6811\u6728\u8986\u76d6\u589e\u52a0\u56fe\u5c42\u4e2d\uff0c\u6811\u6728\u8986\u76d6\u90c1\u95ed\u5ea6\u7684\u6700\u4f4e\u503c\u88ab\u8bbe\u5b9a\u4e3a 50%\u3002", "27a45608adf51f14e8a6c91f0ae24c49": "GFW \u81f4\u529b\u4e8e\u6c47\u96c6\u6700\u65b0\u3001\u53ef\u9760\u548c\u7fd4\u5b9e\u7684\u6570\u636e\uff0c\u4ee5\u76d1\u6d4b\u5168\u7403\u7684\u68ee\u6797\u53d8\u5316\u3002GFW \u6c47\u96c6\u5e76\u6574\u5408\u4e86\u53ef\u4ee5\u53e0\u52a0\u548c\u5bf9\u6bd4\u7684\u591a\u79cd\u6570\u636e\uff0c\u5305\u62ec\uff1a", "eb629df702ed42fd12efb610b8a9e74d": "\u68ee\u6797\u53d8\u5316\u6570\u636e\uff0c\u5982\u5168\u7403\u6811\u6728\u8986\u76d6\u635f\u5931\u548c\u589e\u52a0\uff0c\u8fd1\u5b9e\u65f6 GLAD-L\uff0cGLAD-S2\uff0c\u4ee5\u53ca RADD \u68ee\u6797\u6ee5\u4f10\u8b66\u62a5\u548c\u8fd1\u5b9e\u65f6 VIIRS \u4e3b\u52a8\u5f0f\u706b\u707e\u8b66\u62a5\u3002", "cb9ddd666d6ab4189209e1f726a54e2b": "\u5f15\u7528\u6a21\u677f\uff1a", "d85b8e4309cd54d1045d2cfe9c05e317": "\u5728\u6211\u4eec\u7684\u4e00\u822c\u5199\u4f5c\u4e2d\uff0c", "e33d0a4b4103dadfa4aa38be943d115c": "\u4e0a\u7684\u4fe1\u606f\uff0c\u6211\u4eec\u7684\u76ee\u6807\u662f\u5bf9\u6bcf\u4e2a\u6570\u636e\u5c42\u6240\u8f93\u5165\u7684\u8bbe\u60f3\u548c\u5b9a\u4e49\u4fdd\u6301\u900f\u660e\u3002", "1b96ba13b60d0e87e2e207a7b0749f7e": "\u7531\u4e8e\u5168\u7403\u68ee\u6797\u76d1\u6d4b\u6570\u636e\u6e90\u7684\u89c4\u6a21\u548c\u590d\u6742\u6027\u65e5\u76ca\u589e\u52a0\uff0c\u8fd9\u4e9b\u6570\u636e\u7684\u5206\u6790\u548c\u89e3\u91ca\u5de5\u5177\u5bf9\u4e8e\u5e72\u9884\u5de5\u4f5c\u8d8a\u6765\u8d8a\u91cd\u8981\uff0c\u5b83\u4eec\u53ef\u4ee5\u5feb\u901f\u8bc6\u522b\u548c\u89e3\u91ca\u91cd\u5927\u68ee\u6797\u635f\u5931\u3002\u65b0\u5174\u70ed\u70b9\u6570\u636e\u96c6\u786e\u5b9a\u4e86 2002 \u5e74\u81f3 2023 \u5e74\u95f4\u56fd\u5bb6\u5c42\u9762\u70ed\u5e26\u8303\u56f4\u5185\u539f\u59cb\u68ee\u6797\u635f\u5931\u6700\u4e25\u91cd\u7684\u96c6\u7fa4\u3002\u672f\u8bed\u201c\u70ed\u70b9\u201d\u7684\u5b9a\u4e49\u662f\u5728\u635f\u5931\u7684\u7a7a\u95f4\u6a21\u5f0f\u4e2d\u663e\u73b0\u51fa\u7edf\u8ba1\u610f\u4e49\u4e0a\u7684\u805a\u96c6\u7684\u533a\u57df\u3002\u5728\u8fd9\u4e00\u5206\u6790\u4e2d\uff0c\u89c2\u5bdf\u5230\u7684\u539f\u59cb\u68ee\u6797\u635f\u5931\u6a21\u5f0f\u53ef\u80fd\u5f52\u56e0\u4e8e\u6f5c\u5728\u7684\u7a7a\u95f4\u8fc7\u7a0b\uff0c\u800c\u4e0d\u662f\u968f\u673a\u7684\u7a7a\u95f4\u8fc7\u7a0b\u3002\u4e0d\u540c\u7c7b\u522b\u7684\u70ed\u70b9\u63cf\u8ff0\u5982\u4e0b\uff1a", "721bcc06bf108c55ef5d5f5a195d902f": "\u5982\u9700\u4e86\u89e3\u76f8\u5173\u6570\u636e\uff0c\u8bf7\u53c2\u9605 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">https://glad.umd.edu/dataset/Fire_GFL/</a>\"", "68945fdee36800e05e0858e338cf21c9": "\u8be5\u6570\u636e\u7531\u9a6c\u91cc\u5170\u5927\u5b66\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u5168\u7403\u571f\u5730\u5206\u6790\u4e0e\u53d1\u73b0 (GLAD) \u5b9e\u9a8c\u5ba4</a>\u751f\u6210\uff0c\u7528\u4e8e\u6d4b\u91cf\u5168\u7403\u9646\u5730\uff08\u9664\u5357\u6781\u6d32\u548c\u5176\u4ed6\u5317\u6781\u5c9b\u5c7f\u5916\uff09\u4e0a\u76f8\u8f83\u4e8e\u6240\u6709\u5176\u4ed6\u9a71\u52a8\u56e0\u7d20\uff0c\u56e0\u706b\u707e\u9020\u6210\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u9762\u79ef\uff0c\u6d4b\u91cf\u5206\u8fa8\u7387\u7ea6\u4e3a 30\u00d730 \u7c73\u3002\u8be5\u6570\u636e\u662f\u4f7f\u7528 2001-2023 \u5e74\u57fa\u4e8e\u5168\u7403\u9646\u5730\u536b\u661f\u7684\u5e74\u5ea6\u53d8\u5316\u68c0\u6d4b\u6307\u6807\u751f\u6210\u7684\uff0c\u4f5c\u4e3a\u8f93\u5165\u6570\u636e\u6765\u6309\u533a\u57df\u6821\u51c6\u5206\u7c7b\u6811\u96c6\u6210\u6a21\u578b\u3002\u6620\u5c04\u8fc7\u7a0b\u7684\u7ed3\u679c\u53ef\u4ee5\u89c6\u4e3a\u4e00\u7ec4\u4e8c\u5143\u6620\u5c04\u5730\u56fe\uff08\u56e0\u706b\u707e\u5bfc\u81f4\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u4e0e\u56e0\u6240\u6709\u5176\u4ed6\u9a71\u52a8\u56e0\u7d20\u5bfc\u81f4\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\uff09\u3002", "a461d99e10e9c5bc39953008612a3e87": "\u8be5\u9879\u76ee\u5c06\u81f4\u529b\u4e8e\u63d0\u9ad8\u516c\u4f17\u610f\u8bc6\uff0c\u52a0\u5f3a\u2026\u2026", "3c483f628e394dd017b90fbbeff9f1a5": "\u8be5\u6570\u636e\u96c6\u7531\u9a6c\u91cc\u5170\u5927\u5b66 GLAD\uff08\u5168\u7403\u571f\u5730\u5206\u6790\u4e0e\u53d1\u73b0\uff09\u5b9e\u9a8c\u5ba4\u3001Google\u3001USGS \u548c NASA \u5408\u4f5c\u6784\u5efa\uff0c\u6d4b\u91cf\u4e86\u5168\u7403\u6240\u6709\u571f\u5730\uff08\u5357\u6781\u6d32\u548c\u5176\u4ed6\u5317\u6781\u5c9b\u5c7f\u9664\u5916\uff09\u4ee5\u884c\u653f\u533a\u57df\u5212\u5206\u7684\u51c0\u6797\u6728\u8986\u76d6\u9762\u79ef\u53d8\u5316\u3002\u6570\u636e\u53ef\u663e\u793a\u6307\u5b9a\u533a\u57df\uff08\u56fd\u5bb6\u3001\u5dde/\u7701\u6216\u53bf/\u5e02\uff09 \u76f8\u6bd4\u4e8e 2000 \u5e74\u7684\u6797\u6728\u8986\u76d6\u60c5\u51b5\uff0c\u5176\u5728 2020 \u5e74\u7684\u6797\u6728\u8986\u76d6\u589e\u52a0\u6216\u51cf\u5c11\u4e86\u591a\u5c11\u3002\u8fd9\u4e0d\u662f\u4e00\u4e2a\u5e74\u5ea6\u6570\u636e\u96c6\uff0c\u5176\u663e\u793a\u7684\u662f\u7d2f\u79ef 20 \u5e74\u53d8\u5316\u7684\u56fe\u5c42\uff0c\u5176\u4e2d\u7684\u57fa\u51c6\u5e74\u4e3a 2000 \u5e74\uff0c\u672b\u5e74\u4e3a 2020 \u5e74\u3002\u6797\u6728\u8986\u76d6\u53d8\u5316\u662f\u6839\u636e 2000 \u5e74\u548c 2020 \u5e74\u7684\u6797\u6728\u8986\u76d6\u8303\u56f4\u786e\u5b9a\u7684\uff0c\u8be5\u8303\u56f4\u53d6\u51b3\u4e8e\u6811\u6728\u9ad8\u5ea6\u4fe1\u606f\u3002\u6811\u6728\u9ad8\u5ea6\u662f\u7531\u5168\u7403\u751f\u6001\u7cfb\u7edf\u52a8\u529b\u5b66\u8c03\u67e5 (GEDI) \u6fc0\u5149\u96f7\u8fbe\u7684\u68ee\u6797\u7ed3\u6784\u6d4b\u91cf\u6570\u636e\u548c\u9646\u5730\u536b\u661f\u5206\u6790\u5c31\u7eea\u6570\u636e\u65f6\u95f4\u5e8f\u5217\u7efc\u5408\u786e\u5b9a\u3002NASA GEDI \u662f\u4e00\u79cd\u661f\u8f7d\u6fc0\u5149\u96f7\u8fbe\u4eea\u5668\uff0c\u81ea 2019 \u5e74 4 \u6708\u8d77\u5728\u56fd\u9645\u7a7a\u95f4\u7ad9\u4e0a\u8fd0\u884c\u3002\u5b83\u63d0\u4f9b\u4e86\u57fa\u4e8e\u70b9\u7684\u690d\u88ab\u7ed3\u6784\u6d4b\u91cf\uff0c\u5305\u62ec\u5168\u7403\u5317\u7eac 52\u00b0 \u81f3\u5357\u7eac 52\u00b0 \u4e4b\u95f4\u7684\u68ee\u6797\u51a0\u5c42\u9ad8\u5ea6\u30022000 \u5e74\u548c 2020 \u5e74\u7684\u6797\u6728\u8986\u76d6\u8303\u56f4\u56fe\u662f\u901a\u8fc7\u5c06\u9ad8\u5ea6 \u22655 \u7c73\u7684\u50cf\u5143\u4f5c\u4e3a\u6797\u6728\u8986\u76d6\u8303\u56f4\u6765\u7ed8\u5236\u7684\u3002\u901a\u8fc7\u6bd4\u8f83 2000 \u5e74\u548c 2020 \u5e74\u7684\u5730\u56fe\u53ef\u5f97\u51fa\u6797\u6728\u8986\u76d6\u662f\u589e\u52a0\u8fd8\u662f\u51cf\u5c11\uff0c\u5728\u6bd4\u8f83\u65f6\u8fd8\u91c7\u53d6\u4e86\u63aa\u65bd\u6d88\u9664\u9ad8\u5ea6\u4e0a\u7684\u5fae\u5c0f\u53d8\u5316\uff08\u5373\u6570\u636e\u4e2d\u7684\u201c\u5e72\u6270\u4fe1\u606f\u201d\uff09\u3002\u51c0\u53d8\u5316\u7b49\u4e8e\u603b\u589e\u52a0\u9762\u79ef\u51cf\u53bb\u603b\u635f\u5931\u9762\u79ef\uff0c\u53cd\u6620\u51fa\u7684\u662f\u603b\u4f53\u53d8\u5316\u3002\u7136\u540e\uff0c\u6bcf\u4e2a\u884c\u653f\u533a\u57df\u7684\u51c0\u53d8\u5316\u767e\u5206\u6bd4\u662f\u901a\u8fc7\u8ba1\u7b97\u6797\u6728\u8986\u76d6\u589e\u51cf\u5360 2000 \u5e74\u57fa\u51c6\u6797\u6728\u8986\u76d6\u9762\u79ef\u7684\u767e\u5206\u6bd4\u5f97\u51fa\u7684\u3002", "a6a99e3844af80c79d9c48e89920202b": "2001 \u5e74-2023 \u5e74\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\u9020\u6210\u7684\u6797\u6728\u8986\u76d6\u635f\u5931", "ef1f84d41f0fe7a2b5a1256576422b05": "2020 - \u54e5\u4f26\u6bd4\u4e9a", "40074e0dc0947a6e959ad47c229ac082": "\u663e\u793a\u4e86 2001 \u5e74\u81f3 2023 \u5e74\u95f4\u6bcf10 \u516c\u91cc\u7f51\u683c\u5355\u5143\u5185\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\u53ca\u5176\u635f\u5931\u7a0b\u5ea6\u3002", "b9c11e1cab8f83977d6d5375270504a0": "\u8be5\u6570\u636e\u96c6\u4f7f\u7528\u4ee5\u4e0b\u4e94\u4e2a\u7c7b\u522b\u663e\u793a\u4e86 2001 \u5e74\u81f3 2023 \u5e74\u671f\u95f4<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6797\u6728\u8986\u76d6\u635f\u5931</a>\u7684\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\uff1a", "3718382e8ac80abf3df1a5e159378355": "\u8be5\u6570\u636e\u96c6\u5f88\u5feb\u5c31\u4f1a\u4ece Global Forest Watch \u4e2d\u5220\u9664\u3002", "f1cf1102f909b27db930ada8e9b36e26": "2001 \u5e74-2023 \u5e74\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u91cf", "cf39fd38921184814c51da4878cb703f": "OGF \u5c06\u5728\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u5883\u5185\u5f00\u5c55\u5de5\u4f5c\uff0c\u963b\u6b62\u2026\u2026", "34478206a798689af182b3e9afb4fa6f": "2023 - \u79d8\u9c81", "6f326696e00b3862e2460a46fe246dda": "JPIK \u7684\u9879\u76ee\u5c06\u81f4\u529b\u4e8e\u63d0\u9ad8 JPIK \u4f1a\u5458\u7684\u76d1\u6d4b\u80fd\u529b\uff0c\u2026\u2026", "64bfd0bdd65e93622b1514401483b839": "Alliance GSAC \u5c06\u52a0\u5f3a\u5f53\u5730\u7684\u68ee\u6797\u76d1\u6d4b\u80fd\u529b\u2026\u2026", "0593f2ebaa5268b1e9c5314320f5e0ee": "\u8be5\u9879\u76ee\u5c06\u81f4\u529b\u4e8e\u5229\u7528\u6709\u6548\u7684\u76d1\u6d4b\u6765\u4fc3\u8fdb\u53ef\u6301\u7eed\u53d1\u5c55\u2026\u2026", "cf63930303fc9ff781b2a485edd87424": "AMPA \u5c06\u4e0e\u79d8\u9c81\u5723\u9a6c\u4e01\u7684\u79c1\u8425\u7279\u8bb8\u7ecf\u8425\u7f51\u7edc\u5408\u4f5c\uff0c\u76d1\u6d4b\u2026\u2026", "e0d790b1f1806e59cb1ba05fb808daa0": "2021 - \u5580\u9ea6\u9686\u3001\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd", "e7dce3b33f9c6ef74733b8cbf39455cc": "\u6392\u653e\u6570\u636e\u5b58\u5728\u65f6\u95f4\u4e0a\u4e0d\u4e00\u81f4\u7684\u60c5\u51b5\u3002\u968f\u7740\u65b0\u7684\u536b\u661f\u6570\u636e\u7684\u5f15\u5165\u548c\u65b9\u6cd5\u7684\u6539\u53d8\uff0c2011 \u5e74\u81f3 2015 \u5e74\u671f\u95f4\u5bf9\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u68c0\u6d4b\u51c6\u786e\u6027\u6709\u6240\u63d0\u9ad8\uff0c\u8fd9\u53ef\u80fd\u4f1a\u5bfc\u81f4\u8fd1\u51e0\u5e74\u5bf9\u4e8e\u6392\u653e\u7684\u4f30\u8ba1\u503c\u9ad8\u4e8e\u65e9\u4e9b\u5e74\u7684\u4f30\u8ba1\u503c\u3002\u8bf7\u53c2\u9605<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002", "2b6c245f65ebf53001abed517b76c522": "\u6392\u653e\u91cf\u53cd\u6620\u7684\u662f\u4e00\u4e2a\u7c97\u7565\u7684\u4f30\u7b97\uff0c\u5373\u672a\u5305\u62ec\u968f\u540e\u68ee\u6797\u518d\u751f\u4ea7\u751f\u7684\u78b3\u6e05\u9664\u91cf\u3002\u800c\u56e0\u6bc1\u574f\u540e\u7684\u518d\u751f\u800c\u4ea7\u751f\u7684\u603b\u78b3\u6e05\u9664\u91cf\u8ba1\u5165\u4e86\u9644\u5e26\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u68ee\u6797\u78b3\u6e05\u9664\u56fe\u5c42</a>\u4e2d\u3002\u6bcf\u4e2a\u50cf\u5143\u5728\u53d7\u5230\u5e72\u6270\u65f6\u6392\u653e\u7684\u78b3\u91cf\uff08\u6392\u653e\u56e0\u5b50\uff09\u53d7\u591a\u79cd\u56e0\u7d20\u5f71\u54cd\uff0c\u5305\u62ec\u5e72\u6270\u7684\u76f4\u63a5\u9a71\u52a8\u56e0\u7d20\u3001\u662f\u5426\u5728\u89c2\u5bdf\u5230\u7684\u5e72\u6270\u4e8b\u4ef6\u5f53\u5e74\u6216\u4e4b\u524d\u89c2\u5bdf\u5230\u706b\u707e\u3001\u5e72\u6270\u662f\u5426\u53d1\u751f\u5728\u6ce5\u70ad\u5730\u7b49\u3002\u5047\u8bbe\u6240\u6709\u6392\u653e\u90fd\u53d1\u751f\u5728\u5e72\u6270\u5e74\u4efd\u3002\u4f7f\u7528 Hansen \u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u53ef\u4ee5\u5c06\u6392\u653e\u91cf\u5206\u914d\u5230\u7279\u5b9a\u5e74\u4efd\uff1b\u4f46 GFW \u6ca1\u6709\u4e3a\u6bcf\u5e74\u6392\u653e\u91cf\u63d0\u4f9b\u5355\u72ec\u7684\u6805\u683c\u3002\u6240\u6709\u8f93\u5165\u56fe\u5c42\u5747\u91cd\u65b0\u91c7\u6837\uff0c\u91c7\u7528\u4e0e Hansen et al. (2013) \u76f8\u540c\u7684\u5206\u8fa8\u7387\uff0c\u5373\u6bcf\u5c42 0.00025 \u00d7 0.00025 \u5ea6\u3002", "ba731cbee1d29da613323e318dd634c3": "\u6797\u6728\u8986\u76d6\u6307\u5305\u62ec\u5929\u7136\u6797\u548c\u4eba\u5de5\u6797\u5728\u5185\u7684\u6811\u51a0\u5bc6\u5ea6\u4e0d\u540c\u3001\u6240\u6709\u9ad8\u5ea6\u8d85\u8fc7 5 \u7c73\u7684\u690d\u88ab\u3002\u6797\u6728\u8986\u76d6\u635f\u5931\u662f\u6307\u201c\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u201d\uff0c\u5373\u5728 30 \u7c73\u7684\u50cf\u5143\u5185\u81f3\u5c11\u4e00\u534a\u6797\u6728\u8986\u76d6\u906d\u6bc1\u574f\u7684\u60c5\u51b5\u3002\u786e\u5207\u7684\u9608\u503c\u53d7\u7a7a\u95f4\u548c\u65f6\u95f4\u5f71\u54cd\uff0c\u5e76\u4e14\u53d6\u51b3\u4e8e\u751f\u7269\u7fa4\u843d\u3002\u6797\u6728\u8986\u76d6\u635f\u5931\u5e76\u4e0d\u7b49\u540c\u4e8e\u68ee\u6797\u780d\u4f10\u3002", "b65cc2646d4e17a568752d64647a48a5": "\u5728\u6b64\u6570\u636e\u96c6\u4e2d\uff0c\u201c\u6797\u6728\u8986\u76d6\u201d\u6307\u5305\u62ec\u5929\u7136\u6797\u548c\u4eba\u5de5\u6797\u5728\u5185\u7684\u6811\u51a0\u5bc6\u5ea6\u4e0d\u540c\u3001\u6240\u6709\u9ad8\u5ea6\u8d85\u8fc7 5 \u7c73\u7684\u690d\u88ab\u3002\u6797\u6728\u8986\u76d6\u635f\u5931\u662f\u6307\u201c\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u201d\uff0c\u5373\u5728 30 \u7c73\u7684\u50cf\u5143\u5185\u81f3\u5c11\u4e00\u534a\u6797\u6728\u8986\u76d6\u906d\u6bc1\u574f\u7684\u60c5\u51b5\u3002\u786e\u5207\u7684\u9608\u503c\u53d7\u7a7a\u95f4\u548c\u65f6\u95f4\u5f71\u54cd\uff0c\u5e76\u4e14\u53d6\u51b3\u4e8e\u751f\u7269\u7fa4\u843d\u3002\u706b\u707e\u9020\u6210\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u53ef\u80fd\u662f\u7531\u81ea\u7136\u6216\u4eba\u4e3a\u5f15\u8d77\u7684\u706b\u707e\u6d3b\u52a8\u9020\u6210\u7684\u3002", "77bc5cf9f6b7642ec5b2470ec97a34d1": "\u4e0e GFW \u53d1\u5e03\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u5730\u56fe\u4e00\u81f4\uff0c\u8be5\u6570\u636e\u4ec5\u63cf\u7ed8\u4e86\u5728 2001 \u5e74\u81f3 2023 \u5e74\u95f4\u5404\u4e2a\u50cf\u5143\u9996\u6b21\u53d1\u751f\u7684\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u3002\u8be5\u6570\u636e\u4e2d\u672a\u53d1\u73b0\u5728\u7814\u7a76\u65e9\u671f\u521d\u6b21\u53d1\u751f\u5e72\u6270\u540e\u68ee\u6797\u518d\u751f\u65f6\u53d1\u751f\u7684\u706b\u707e\u9020\u6210\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u533a\u57df\u3002", "301d0939cd5c2013425336db47d906fc": "\u663e\u793a\u6570\u636e\u7684\u6797\u6728\u8986\u76d6\u5bc6\u5ea6\u4f1a\u6839\u636e\u9009\u62e9\u800c\u6709\u6240\u4e0d\u540c\u2014\u2014\u4f7f\u7528\u5730\u56fe\u4e0a\u7684\u56fe\u4f8b\u6765\u66f4\u6539\u6700\u5c0f\u6797\u6728\u8986\u76d6\u51a0\u5c42\u5bc6\u5ea6\u9608\u503c\u3002<br>\u6b64\u6570\u636e\u53ef\u5728<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u4e0b\u8f7d\uff0c\u4e5f\u53ef\u4f7f\u7528\u4ee5\u4e0b\u56fe\u50cf ID \u901a\u8fc7 Google Earth Engine \u8bbf\u95ee\uff08\u6709\u5173\u8be6\u60c5\uff0c\u8bf7\u53c2\u9605 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">https://glad.umd.edu/dataset/Fire_GFL/</a>\uff09\uff1a", "953cd10ce6f317003ec3860543b466c1": "\u6b64\u6570\u636e\u96c6\u4f7f\u7528 GFW \u7684\u57fa\u7840\u6797\u6728\u8986\u76d6\u635f\u5931\u5730\u56fe\u4f5c\u4e3a\u8f93\u5165\u6570\u636e\uff0c\u9488\u5bf9\u8be5\u5730\u56fe\u7684\u5206\u6790\u65b9\u6cd5\u7ecf\u8fc7\u4e86\u591a\u65b9\u9762\u4fee\u6539\uff0c\u4ee5\u6539\u8fdb\u5bf9 2011-2023 \u5e74\u671f\u95f4\u6570\u636e\u56e0\u706b\u707e\u3001\u70ed\u5e26\u68ee\u6797\u5c0f\u519c\u8f6e\u4f5c\u519c\u4e1a\u3001\u9009\u62e9\u6027\u4f10\u6728\u548c\u77ed\u5468\u671f\u4eba\u5de5\u6797\u9020\u6210\u7684\u5317\u65b9\u68ee\u6797\u635f\u5931\u7684\u76d1\u6d4b\u3002\u9274\u4e8e\u8fd9\u4e9b\u53d8\u5316\u7684\u5b58\u5728\uff0c\u5728\u6bd4\u8f83 2000-2010 \u5e74\u548c 2011-2023 \u5e74\u671f\u95f4\u7684\u8d8b\u52bf\u65f6\u52a1\u5fc5<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u614e\u91cd\u8fdb\u884c</a>\u3002\u60a8\u53ef\u4ee5\u5728<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u8be6\u7ec6\u4e86\u89e3\u5efa\u6a21\u6d41\u7a0b\u7684\u66f4\u65b0\u3002", "2caa254321ff6e43f62f5c2fe49e8203": "<strong>\u7a33\u5b9a\u68ee\u6797</strong>\u2014\u20142000 \u5e74\u81f3 2020 \u5e74\u95f4\u9ad8\u5ea6\u4fdd\u6301\u5728 5 \u7c73\u6216\u4ee5\u4e0a\u7684\u6797\u6728\u8986\u76d6\u533a\u57df\u3002<br><strong>\u589e\u52a0</strong>\u2014\u20142000 \u5e74\u9ad8\u5ea6\u4f4e\u4e8e 5 \u7c73\u4f46\u5230 2020 \u5e74\u9ad8\u5ea6\u8fbe\u5230\u6216\u8d85\u8fc7 5 \u7c73\u7684\u6797\u6728\u8986\u76d6\u533a\u57df\u3002<br><strong>\u635f\u5931</strong>\u2014\u20142000 \u5e74\u9ad8\u5ea6\u8fbe\u5230\u6216\u8d85\u8fc7 5 \u7c73\u4f46\u5230 2020 \u5e74\u9ad8\u5ea6\u4f4e\u4e8e 5 \u7c73\u7684\u6797\u6728\u8986\u76d6\u533a\u57df\u3002<br><strong>\u53d7\u5e72\u6270</strong>\u2014\u2014\u4ee3\u8868 2000 \u5e74\u81f3 2020 \u5e74\u95f4\u7ecf\u5386\u8fc7\u635f\u5931\u548c\u589e\u52a0\u7684\u533a\u57df\u3002", "a831af4618568f602154380420a55a98": "CH4 \u548c N2O \u7684\u5168\u7403\u53d8\u6696\u6f5c\u52bf (GWP) \u5e38\u6570\u3002\u6b64\u524d\u4f7f\u7528\u7684 GWP \u6765\u81ea IPCC \u7b2c\u4e94\u6b21\u8bc4\u4f30\u62a5\u544a\uff1b\u73b0\u5728\u4f7f\u7528 IPCC <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u7b2c\u516d\u6b21\u8bc4\u4f30\u62a5\u544a</a>\u4e2d\u7684 GWP\u3002", "19d7d860d5e905bca28e3f334618265f": "\u4f7f\u7528\u6761\u6b3e\u53ca\u6761\u4ef6", "7346674bfe04dbb3e93934b868da3713": "\u5c3d\u7ba1\u6bcf\u4e2a\u50cf\u5143\u7684\u6392\u653e\u91cf\u4e0e\u7279\u5b9a\u7684\u5e72\u6270\u5e74\u4efd\u76f8\u5173\uff0c\u4f46\u611f\u5174\u8da3\u533a\u57df\u7684\u6392\u653e\u91cf\u53cd\u6620\u4e86 2001-2023 \u5e74\u6a21\u578b\u6301\u7eed\u671f\u95f4\u7684\u603b\u91cf\u3002\u56e0\u6b64\uff0c\u6570\u503c\u5fc5\u987b\u9664\u4ee5 23 \u624d\u80fd\u8ba1\u7b97\u5e73\u5747\u5e74\u6e05\u9664\u91cf\u3002", "01db792079b51cd2c6126228144af4c1": "\u6570\u503c\u4ec5\u9002\u7528\u4e8e\u68ee\u6797\u533a\u57df\uff08\u6811\u51a0\u8986\u76d6\u7387 > 30% \u4e14\u9ad8\u5ea6 > 5 \u7c73\uff0c\u6216\u6797\u6728\u8986\u76d6\u7387\u589e\u52a0\u7684\u533a\u57df\uff09\u3002\u6709\u5173\u5206\u6790\u4e2d\u4f7f\u7528\u7684\u68ee\u6797\u5b9a\u4e49\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al.(2021)</a>\u3002", "4b54dd2851fb355287ab9c9e6f4da300": "\u706b\u707e\u6570\u636e\u6765\u6e90\u3002\u6b64\u524d\u4f7f\u7528\u7684\u662f MODIS \u6d4b\u5f97\u7684\u70e7\u6bc1\u533a\u57df\uff1b\u73b0\u5728\u53c2\u7167 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Tyukavina et al. 2022</a> \u4e2d\u6d4b\u5f97\u7684\u706b\u707e\u9020\u6210\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u3002", "358f481d5a5cc8c9bdcf37c8467989d4": "\u6ce5\u70ad\u5730\u56fe\u7684\u6765\u6e90\u3002\u65b0\u589e\u4e86\u70ed\u5e26\u6570\u636e\u96c6\uff0c\u5e76\u66f4\u6539\u4e86\u5317\u7eac 40 \u5ea6\u4ee5\u4e0a\u7684\u6570\u636e\u96c6\u3002", "c18f667eb74ab3467158adfeb701c9f8": "\u690d\u6811\u7684\u8303\u56f4\u548c\u6e05\u9664\u56e0\u5b50\u3002\u6b64\u524d\u4f7f\u7528\u690d\u6811\u7a7a\u95f4\u6570\u636e\u5e93 (SDPT) <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">1.0 \u7248</a>\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">SDPT 2.0 \u7248</a>\u548c\u76f8\u5173\u7684\u6e05\u9664\u56e0\u5b50\u3002", "0303d1d7c1eadf33b398b32f06a6b4e5": "2001 \u5e74-2023 \u5e74\u51c0\u68ee\u6797\u6e29\u5ba4\u6c14\u4f53\u901a\u91cf", "ebc5ff58f4a4f16212354c679b0244b6": "\u968f\u7740\u65b0\u7684\u536b\u661f\u6570\u636e\u7684\u5f15\u5165\u548c\u65b9\u6cd5\u7684\u6539\u53d8\uff0c2011 \u5e74\u81f3 2015 \u5e74\u671f\u95f4\u5bf9\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u68c0\u6d4b\u51c6\u786e\u6027\u6709\u6240\u63d0\u9ad8\uff0c\u8fd9\u53ef\u80fd\u4f1a\u5bfc\u81f4\u8fd1\u51e0\u5e74\u5bf9\u4e8e\u6392\u653e\u7684\u4f30\u8ba1\u503c\u9ad8\u4e8e\u65e9\u4e9b\u5e74\u7684\u4f30\u8ba1\u503c\u3002\u8bf7\u53c2\u9605<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002", "e8b3d5633eeff99eaefacd712e238ad6": "\u5730\u4e0b\u78b3\u4e0e\u5730\u4e0a\u78b3\u6bd4\u503c\u7684\u6765\u6e90\u3002\u6b64\u524d\u4f7f\u7528\u7684\u662f\u4e00\u4e2a\u5168\u5c40\u5e38\u91cf\uff1b\u73b0\u5728\u53c2\u7167 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Huang et al. 2021</a> \u4e2d\u63d0\u4f9b\u7684\u5730\u56fe", "324ce8f6007cf09645a094ff2e895959": "\u78b3\u6e05\u9664\u91cf\u53cd\u6620\u4e86 2001-2023 \u5e74\u6a21\u578b\u6301\u7eed\u671f\u95f4\u7684\u603b\u6e05\u9664\u91cf\uff0c\u800c\u4e0d\u662f\u53ef\u4ee5\u5f97\u51fa\u8d8b\u52bf\u7684\u5e74\u5ea6\u65f6\u95f4\u5e8f\u5217\u3002\u56e0\u6b64\uff0c\u503c\u5fc5\u987b\u9664\u4ee5 23 \u624d\u80fd\u8ba1\u7b97\u5e73\u5747\u5e74\u6e05\u9664\u91cf\u3002", "0868314fa1ca693a6b139285c91c2dad": "\u76f8\u6bd4\u4e8e\u6392\u653e\u91cf\uff0c\u603b\u6e05\u9664\u91cf\u7684\u4e0d\u786e\u5b9a\u6027\u8981\u66f4\u9ad8\uff0c\u975e\u5e38\u53d7\u6e05\u9664\u56e0\u5b50\u7684\u4e0d\u786e\u5b9a\u6027\u5f71\u54cd\u3002", "c37c1e90fac529835d1839d487e7c542": "\u8be5\u56fe\u8868\u663e\u793a\u4e86\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\u9020\u6210\u7684\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u6240\u4ea7\u751f\u7684\u5e74\u5ea6\u6e29\u5ba4\u6c14\u4f53<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6392\u653e\u91cf</a>\u3002\u6392\u653e\u91cf\u5305\u62ec\u4e86\u6240\u6709\u76f8\u5173\u7684\u751f\u6001\u7cfb\u7edf\u78b3\u5e93\uff08\u5730\u4e0a\u751f\u7269\u91cf\u3001\u5730\u4e0b\u751f\u7269\u91cf\u3001\u67af\u6728\u3001\u67af\u679d\u8d25\u53f6\u3001\u571f\u58e4\uff09\u548c\u6e29\u5ba4\u6c14\u4f53\uff08\u4e8c\u6c27\u5316\u78b3\u3001\u7532\u70f7\u3001\u4e00\u6c27\u5316\u4e8c\u6c2e\uff09\uff0c\u5e76\u4e14\u5047\u8bbe\u6392\u653e\u90fd\u53d1\u751f\u5728\u5e72\u6270\u5e74\u4efd\u3002<a href=\"{{1}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a> \u4e2d\u63cf\u8ff0\u4e86\u7528\u4e8e\u8ba1\u7b97\u6392\u653e\u91cf\u7684\u65b9\u6cd5\uff0c\u5176\u4e2d\u5f15\u5165\u4e86\u7528\u4e8e\u4f30\u7b97\u5168\u7403\u68ee\u6797\u78b3\u901a\u91cf\u7684\u5730\u7406\u7a7a\u95f4\u76d1\u6d4b\u6846\u67b6\u3002\u8fd9\u4e9b\u65b9\u6cd5\u9075\u5faa\u53d1\u751f\u6797\u5206\u66ff\u4ee3\u5e72\u6270\u7684 IPCC <a href=\"{{2}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355</a>\u6307\u5357\uff0c\u5982 <a href=\"{{3}}\" target=\"_blank\" rel=\"noopener noreferrer\">Hansen et al. (2013)</a> \u7684\u5168\u7403\u68ee\u6797\u53d8\u5316\u5e74\u5ea6\u6797\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u6240\u793a\u3002<br>\u6392\u653e\u91cf\u53cd\u6620\u7684\u662f\u4e00\u4e2a\u7c97\u7565\u7684\u4f30\u7b97\uff0c\u5373\u672a\u5305\u62ec\u968f\u540e\u68ee\u6797\u518d\u751f\u4ea7\u751f\u7684\u78b3\u6e05\u9664\u91cf\u3002\u6709\u5173\u6240\u9009\u533a\u57df\u7684\u6e05\u9664\u91cf\u548c\u51c0\u901a\u91cf\u7684\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605\u51c0\u901a\u91cf\u56fe\u3002\u6392\u653e\u91cf\u5305\u62ec\u9ad8\u4e8e\u6240\u9009\u6797\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u5730\u533a\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\uff0c\u4ee5\u53ca\u6797\u6728\u8986\u76d6\u867d\u589e\u52a0\u4f46\u672a\u8fbe\u5230\u6797\u6728\u8986\u76d6\u5bc6\u5ea6\u9608\u503c\u7684\u5730\u533a\u3002<br>\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u4e94\u4e2a\u9a71\u52a8\u56e0\u7d20\u5b9a\u4e49\u5982\u4e0b\uff1a<br>- <strong>\u5927\u5b97\u5546\u54c1\u9a71\u52a8\u7684\u68ee\u6797\u780d\u4f10</strong>\uff1a\u4e3b\u8981\u4e0e\u5546\u4e1a\u6027\u519c\u4e1a\u6269\u5f20\u76f8\u5173\u7684\u5927\u89c4\u6a21\u68ee\u6797\u780d\u4f10\u3002<br>- <strong>\u8fc1\u79fb\u519c\u4e1a</strong>\uff1a\u7531\u4e8e\u4e2d\u5c0f\u89c4\u6a21\u519c\u4e1a\u9020\u6210\u7684\u6682\u65f6\u635f\u5931\u6216\u6c38\u4e45\u6027\u6bc1\u6797\u3002<br>- <strong>\u6797\u4e1a</strong>\uff1a\u4eba\u5de5\u6797\u548c\u5929\u7136\u6797\u91c7\u4f10\u9020\u6210\u7684\u6682\u65f6\u635f\u5931\uff0c\u5176\u4e2d\u4f1a\u4f34\u6709\u4e00\u4e9b\u539f\u59cb\u68ee\u6797\u906d\u5230\u780d\u4f10\u3002<br>- <strong>\u68ee\u6797\u706b\u707e</strong>\uff1a\u6682\u65f6\u635f\u5931\uff0c\u4e0d\u5305\u62ec\u4e3a\u53d1\u5c55\u519c\u4e1a\u800c\u8fdb\u884c\u7684\u653e\u706b\u6bc1\u6797\u3002<br>- <strong>\u57ce\u5e02\u5316</strong>\uff1a\u4e3a\u57ce\u5e02\u4e2d\u5fc3\u6269\u5f20\u800c\u780d\u4f10\u68ee\u6797\u3002<br>\u5927\u5b97\u5546\u54c1\u9a71\u52a8\u578b\u68ee\u6797\u780d\u4f10\u548c\u57ce\u5e02\u5316\u8fd9\u4e24\u5927\u7c7b\u4ee3\u8868\u4e86\u6c38\u4e45\u6027\u6bc1\u6797\uff0c\u800c\u53d7\u5176\u4ed6\u51e0\u7c7b\u9a71\u52a8\u56e0\u7d20\u5f71\u54cd\u7684\u6797\u6728\u8986\u76d6\u901a\u5e38\u53ef\u518d\u751f\u3002\u9a71\u52a8\u56e0\u7d20\u6570\u636e\u96c6\u6ca1\u6709\u8bf4\u660e\u6797\u6728\u8986\u76d6\u635f\u5931\u53d1\u751f\u540e\u571f\u5730\u8986\u76d6\u7684\u7a33\u5b9a\u6027\u6216\u72b6\u51b5\uff0c\u4e5f\u6ca1\u6709\u533a\u5206\u81ea\u7136\u539f\u56e0\u548c\u4eba\u4e3a\u539f\u56e0\u7684\u68ee\u6797\u706b\u707e\u3002&nbsp;<br>\u6b64\u9a71\u52a8\u56e0\u7d20\u6570\u636e\u96c6\u91c7\u96c6\u8fd1 5,000 \u4e2a\u6837\u672c\u70b9\uff0c\u5e76\u4ee5\u6797\u6728\u8986\u76d6\u3001\u6797\u6728\u8986\u76d6\u635f\u5931\u3001\u6797\u6728\u8986\u76d6\u589e\u52a0\u3001\u4eba\u53e3\u5bc6\u5ea6\u3001\u571f\u5730\u8986\u76d6\u548c\u706b\u707e\u6570\u636e\u6784\u5efa\u7684\u6a21\u578b\u4e3a\u57fa\u7840\uff0c\u8868\u660e\u4e86 10 \u516c\u91cc\u7f51\u683c\u5355\u5143\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\u3002\u968f\u540e\u5c06\u6bcf\u4e2a\u5355\u5143\u7684\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\u4e0e\u6bcf\u5e74\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u8fdb\u884c\u4ea4\u53c9\uff0c\u4ece\u800c\u8ba1\u7b97\u51fa\u6b64\u5904\u63d0\u4f9b\u7684\u7edf\u8ba1\u6570\u636e\u3002\u5728\u7edf\u8ba1\u671f\u95f4\uff0c\u6797\u6728\u8986\u76d6\u635f\u5931\u7387\u5c0f\u4e8e 0.5% \u7684\u7f51\u683c\u5355\u5143\u672a\u88ab\u5206\u914d\u7c7b\u522b\uff0c\u4e5f\u6ca1\u6709\u5728\u6b64\u7edf\u8ba1\u6570\u636e\u4e2d\u4f53\u73b0\u3002 <br>\u8bf7\u6ce8\u610f\uff0c\u8be5\u6570\u636e\u96c6\u65e8\u5728\u7528\u4e8e\u5168\u7403\u6216\u533a\u57df\u4e00\u7ea7\u7684\u5206\u6790\uff0c\u56e0\u6b64\u5728\u67e5\u770b\u5c0f\u7247\u5730\u533a\u6216\u7279\u5b9a\u5730\u7406\u533a\u57df\u65f6\u53ef\u80fd\u5b58\u5728\u4e0d\u51c6\u786e\u6027\u3002GFW \u4e0a\u7684\u5168\u7403\u548c\u533a\u57df\u603b\u6570\u53cd\u6620\u7684\u662f\u50cf\u5143\u6570\uff0c\u800c\u4e0d\u662f\u57fa\u4e8e\u6837\u672c\u7684\u9762\u79ef\u4f30\u8ba1\u3002\u5728\u5168\u7403\u548c\u533a\u57df\u5c3a\u5ea6\u4e0a\uff0c\u6309\u50cf\u5143\u8ba1\u6570\u65b9\u6cd5\u5f97\u51fa\u7684\u9762\u79ef\u4f30\u8ba1\u503c\u5728\u6309\u6837\u672c\u8ba1\u7b97\u7684\u9762\u79ef\u4f30\u8ba1\u503c\u7684\u8bef\u5dee\u8303\u56f4\u5185\uff0c\u56e0\u6b64\u5730\u56fe\u4e0a\u7684\u8f93\u51fa\u6570\u636e\u53ef\u76f4\u63a5\u7528\u4e8e\u8ba1\u7b97\u9762\u79ef\u3002&nbsp;<br>\u6570\u636e\u96c6\u7684\u51c6\u786e\u5ea6\u56e0\u7c7b\u522b\u548c\u5730\u7406\u4f4d\u7f6e\u800c\u5f02\u3002\u6bcf\u4e2a\u7c7b\u522b\u7684\u5168\u5c40\u51c6\u786e\u7387\u5982\u4e0b\u6240\u793a\uff1b\u533a\u57df\u51c6\u786e\u7387\u53ef\u53c2\u9605 <a href=\"{{4}}\" target=\"_blank\" rel=\"noopener noreferrer\">Curtis et al. 2018</a> \u7684\u8865\u5145\u8d44\u6599\u3002<br>\u6797\u6728\u8986\u76d6\u635f\u5931\u3001<a href=\"{{5}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u9a71\u52a8\u56e0\u7d20</a>\u548c\u70e7\u6bc1\u9762\u79ef\u6bcf\u5e74\u90fd\u4f1a\u66f4\u65b0\u3002\u5728 2023 \u5e74\u548c 2024 \u5e74\uff0c\u5176\u4e2d\u7684\u4e00\u4e9b\u6a21\u578b\u8f93\u5165\u6570\u636e\u96c6\u548c\u5e38\u91cf\u4e5f\u53d1\u751f\u4e86\u53d8\u5316\uff0c\u5177\u4f53\u5982\u4e0b\u3002\u8bf7\u53c2\u9605<a href=\"{{6}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8fd9\u7bc7\u535a\u6587</a>\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002<br><br>1. \u5730\u4e0b\u78b3\u4e0e\u5730\u4e0a\u78b3\u6bd4\u503c\u7684\u6765\u6e90\u3002\u6b64\u524d\u4f7f\u7528\u7684\u662f\u4e00\u4e2a\u5168\u5c40\u5e38\u91cf\uff1b\u73b0\u5728\u53c2\u7167<a href=\"{{7}}\" target=\"_blank\" rel=\"noopener noreferrer\">Huang et al. 2021</a> \u4e2d\u63d0\u4f9b\u7684\u5730\u56fe\u3002&nbsp;<br>2. \u6797\u6728\u8986\u76d6\u589e\u52a0\u7684\u5e74\u4efd\u3002\u6b64\u524d\u4f7f\u7528\u7684\u662f 2000 \u5e74-2012 \u5e74\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{8}}\" target=\"_blank\" rel=\"noopener noreferrer\">Potapov et al. 2022</a> \u4e2d\u63d0\u51fa\u7684 2000 \u5e74-2020 \u5e74\u3002&nbsp;<br>3. \u706b\u707e\u6570\u636e\u6765\u6e90\u3002\u6b64\u524d\u4f7f\u7528\u7684\u662f MODIS \u6d4b\u5f97\u7684\u70e7\u6bc1\u533a\u57df\uff1b\u73b0\u5728\u53c2\u7167 <a href=\"{{9}}\" target=\"_blank\" rel=\"noopener noreferrer\">Tyukavina et al. 2022</a> \u4e2d\u6d4b\u5f97\u7684\u706b\u707e\u9020\u6210\u7684\u6797\u6728\u8986\u76d6\u635f\u5931\u3002<br>4. \u6ce5\u70ad\u5730\u56fe\u7684\u6765\u6e90\u3002\u65b0\u589e\u4e86\u70ed\u5e26\u6570\u636e\u96c6\uff0c\u5e76\u66f4\u6539\u4e86\u5317\u7eac 40 \u5ea6\u4ee5\u4e0a\u7684\u6570\u636e\u96c6\u3002&nbsp;<br>5. CH4 \u548c N2O \u7684\u5168\u7403\u53d8\u6696\u6f5c\u52bf (GWP) \u5e38\u6570\u3002\u6b64\u524d\u4f7f\u7528\u7684 GWP \u6765\u81ea IPCC \u7b2c\u4e94\u6b21\u8bc4\u4f30\u62a5\u544a\uff1b\u73b0\u5728\u4f7f\u7528 <a href=\"{{10}}\" target=\"_blank\" rel=\"noopener noreferrer\">IPCC \u7b2c\u516d\u6b21\u8bc4\u4f30\u62a5\u544a</a>\u4e2d\u7684 GWP\u3002<br>6. \u8f83\u8001\u7684\uff0820 \u5e74\u4ee5\u4e0a\uff09\u6b21\u751f\u6e29\u5e26\u68ee\u6797\u7684\u6e05\u9664\u56e0\u5b50\u53ca\u5176\u76f8\u5173\u7684\u4e0d\u786e\u5b9a\u6027\u3002\u6b64\u524d\u4f7f\u7528\u7684\u6e05\u9664\u56e0\u5b50\u89c1 \u300a2006 \u5e74 IPCC \u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355\u6307\u5357 2019 \u4fee\u8ba2\u7248\u300b<a href=\"{{11}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u8868 4.9</a>\uff1b\u73b0\u5728\u4f7f\u7528\u7684\u662f\u300a2006 \u5e74 IPCC \u56fd\u5bb6\u6e29\u5ba4\u6c14\u4f53\u6e05\u5355\u6307\u5357 2019 \u4fee\u8ba2\u7248\u300b<a href=\"{{12}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u7b2c\u56db\u6b21\u66f4\u6b63</a>\u4e2d\u4fee\u6b63\u7684\u6e05\u9664\u56e0\u5b50\u548c\u4e0d\u786e\u5b9a\u6027\u3002<br>7. \u690d\u6811\u7684\u8303\u56f4\u548c\u6e05\u9664\u56e0\u5b50\u3002\u6b64\u524d\u4f7f\u7528\u690d\u6811\u7a7a\u95f4\u6570\u636e\u5e93 (SDPT) <a href=\"{{13}}\" target=\"_blank\" rel=\"noopener noreferrer\">1.0 \u7248</a>\uff1b\u73b0\u5728\u4f7f\u7528 SDPT<a href=\"{{14}}\" target=\"_blank\" rel=\"noopener noreferrer\"> 2.0 \u7248</a>\u548c\u76f8\u5173\u7684\u6e05\u9664\u56e0\u5b50\u3002", "b608ecf8e5ae948e315037dc72925cb1": "\u6392\u653e\u6570\u636e\u5b58\u5728\u65f6\u95f4\u4e0a\u7684\u5dee\u5f02\u3002\u968f\u7740\u65b0\u7684\u536b\u661f\u6570\u636e\u7684\u5f15\u5165\u548c\u65b9\u6cd5\u7684\u6539\u53d8\uff0c2011 \u5e74\u81f3 2015 \u5e74\u671f\u95f4\u5bf9\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u68c0\u6d4b\u51c6\u786e\u6027\u6709\u6240\u63d0\u9ad8\uff0c\u8fd9\u53ef\u80fd\u4f1a\u5bfc\u81f4\u8fd1\u51e0\u5e74\u5bf9\u4e8e\u6392\u653e\u7684\u4f30\u8ba1\u503c\u9ad8\u4e8e\u65e9\u4e9b\u5e74\u7684\u4f30\u8ba1\u503c\u3002\u8bf7\u53c2\u9605<a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">\u6b64\u5904</a>\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002", "f5bcec170fd37524baebf4a1d50aa7bf": "\u6392\u653e\u6570\u636e\u662f\u901a\u8fc7\u5efa\u6a21\u5f97\u5230\u7684\u4ea7\u7269\uff0c\u56e0\u6b64\u5176\u672c\u8eab\u5b58\u5728\u4e00\u5b9a\u7684\u8bef\u5dee\u548c\u4e0d\u786e\u5b9a\u6027\u3002\u5728\u4f7f\u7528\u6570\u636e\u4e4b\u524d\uff0c\u5f3a\u70c8\u5efa\u8bae\u7528\u6237\u9605\u8bfb\u5e76\u5145\u5206\u7406\u89e3\u5143\u6570\u636e\u548c\u5176\u4ed6\u63d0\u4f9b\u7684\u6587\u6863\u3002", "da9df1fa2144ae305aa28f761f583abb": "2001 \u5e74-2023 \u5e74\uff0c10 \u516c\u91cc\uff0c\u5168\u7403\uff0cHansen/UMD/Google/USGS/NASA", "bc47ade6fded0a85dc358a649eadd270": "\u4e3a\u4fdd\u62a4\u519c\u6c11\u9690\u79c1\uff0c\u53ef\u53ef\u5730\u5757\u591a\u8fb9\u5f62\u6570\u636e\u5df2\u8f6c\u6362\u4e3a\u5bc6\u5ea6\u56fe\u3002\u67e5\u770b<a href=\"{{0}}\" target=\"_blank\">\u6211\u4eec\u7684\u535a\u5ba2</a>\uff0c\u8be6\u7ec6\u4e86\u89e3\u6b64\u6570\u636e\u96c6\u3002", "fc0221818728af78bab2255a5a233efe": "2002 \u5e74-2023 \u5e74\uff0c\u70ed\u5e26\u5730\u533a\uff0cHarris et al.", "5770406a98ea3c96cf53e67fa4d01638": "2002 \u5e74-2023 \u5e74\u7684\u65b0\u5174\u70ed\u70b9", "316f0c895819d00587adc733191e216d": "<strong>\u65b0</strong>\uff1a\u4ec5\u5728 2023 \u5e74\u624d\u6210\u4e3a\u5177\u6709\u7edf\u8ba1\u610f\u4e49\u7684\u70ed\u70b9\u4e14\u4e4b\u524d\u4ece\u672a\u6210\u4e3a\u70ed\u70b9\u7684\u4f4d\u7f6e\u3002", "7dfe7afba9bd72f2a9f8a1e920978626": "<strong>\u5076\u7136</strong>\uff1a\u975e\u6301\u7eed\u6027\u7684\u70ed\u70b9\u4f4d\u7f6e\u300222 \u5e74\u4e2d\u53ea\u6709\u5728\u4e0d\u5230 20 \u5e74\u91cc\u662f\u7edf\u8ba1\u610f\u4e49\u4e0a\u7684\u70ed\u70b9\u3002", "dcc1255c9a8ad5ce96972f5a5f07ddc6": "<strong>\u52a0\u5267</strong>\uff1a\u5728 22 \u5e74\u4e2d\u6709\u8d85\u8fc7 19 \u5e74 (> 90%)\uff0c\u5305\u62ec\u6700\u8fd1\u4e00\u5e74\uff082023 \u5e74\uff09\u662f\u7edf\u8ba1\u610f\u4e49\u4e0a\u7684\u70ed\u70b9\u5730\u533a\u3002\u4e0d\u4ec5\u5982\u6b64\uff0c\u6bcf\u5e74\u9ad8\u8ba1\u6570\u7684\u805a\u96c6\u5f3a\u5ea6\u90fd\u5728\u589e\u52a0\u3002", "2bd47e21ace9c4913a39e5505a475307": "\u5168\u7403\u706b\u9669\u6c14\u8c61\u6307\u6570 - 2024 \u5e74 4 \u6708 27 \u65e5", "2a49f2292cbe3fe13bdc778f209deeaf": "\u6b64\u56fe\u8868\u5df2\u8fdb\u884c\u66f4\u65b0\uff0c\u73b0\u5df2\u4e0d\u540c\u4e8e\u6700\u521d\u53d1\u5e03\u7684\u7248\u672c\u3002\u8bf7\u53c2\u9605\u6982\u8ff0\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002", "94fb66a7404ef9c7722fb7ba3f5d1f12": "\u6392\u653e\u91cf\u3001\u6e05\u9664\u91cf\u548c\u51c0\u901a\u91cf\u53cd\u6620\u4e86\u6a21\u578b\u671f\u95f4\u7684\u5e74\u5e73\u5747\u503c\u3002\u65f6\u95f4\u5e8f\u5217\u4ec5\u9002\u7528\u4e8e\u603b\u6392\u653e\u91cf\uff08\u8bf7\u53c2\u9605\u201c\u6c14\u5019\u201d\u9009\u9879\u5361\u4e2d\u7684\u5176\u4ed6\u56fe\u8868\uff09\u3002&nbsp;&nbsp;\u2022 \u6570\u503c\u9002\u7528\u4e8e\u68ee\u6797\u533a\u57df\uff08\u6811\u51a0\u8986\u76d6\u7387 > 30% \u4e14\u9ad8\u5ea6 > 5 \u7c73\uff09\u548c\u6797\u6728\u8986\u76d6\u7387\u589e\u52a0\u7684\u533a\u57df\u3002\u6709\u5173\u5206\u6790\u4e2d\u4f7f\u7528\u7684\u68ee\u6797\u5b9a\u4e49\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. 2021</a>\u3002", "67cc5678b1c436ed8f3424e66fa8e4ab": "\u76f8\u6bd4\u4e8e\u6392\u653e\u91cf\uff0c\u603b\u6e05\u9664\u91cf\u7684\u4e0d\u786e\u5b9a\u6027\u8981\u66f4\u9ad8\uff0c\u975e\u5e38\u53d7\u6e05\u9664\u56e0\u5b50\u7684\u4e0d\u786e\u5b9a\u6027\u5f71\u54cd\u3002\u8fd9\u4e9b\u4e0d\u786e\u5b9a\u6027\u4f1a\u52a0\u5267\u51c0\u901a\u91cf\u7684\u4e0d\u786e\u5b9a\u6027\u3002&nbsp;&nbsp;", "65f6731e32912b2cb33cae5366c818d0": "\u6570\u503c\u9002\u7528\u4e8e\u68ee\u6797\u533a\u57df\uff08\u6811\u51a0\u8986\u76d6\u7387 > 30% \u4e14\u9ad8\u5ea6 > 5 \u7c73\uff0c\u6216\u6797\u6728\u8986\u76d6\u7387\u589e\u52a0\u7684\u533a\u57df\uff09\u3002\u6709\u5173\u5206\u6790\u4e2d\u4f7f\u7528\u7684\u68ee\u6797\u5b9a\u4e49\u7684\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u9605 <a href=\"{{0}}\" target=\"_blank\" rel=\"noopener noreferrer\">Harris et al. (2021)</a>\u3002&nbsp;", "cc76a98a07bdd5a265b3e35567275ce8": "\u4f5c\u4e3a\u4f30\u8ba1\u57fa\u7840\u7684\u6d3b\u52a8\u6570\u636e\u5b58\u5728\u65f6\u95f4\u4e0a\u7684\u4e0d\u4e00\u81f4\u6027\uff1a&nbsp;", "ea71aceca6ea82753e98e109cd37e4ff": "\u968f\u7740\u65b0\u7684\u536b\u661f\u6570\u636e\u7684\u5f15\u5165\u548c\u65b9\u6cd5\u7684\u6539\u53d8\uff0c2011 \u5e74\u81f3 2015 \u5e74\u671f\u95f4\u5bf9\u6797\u6728\u8986\u76d6\u635f\u5931\u7684\u68c0\u6d4b\u51c6\u786e\u6027\u6709\u6240\u63d0\u9ad8\uff0c\u8fd9\u53ef\u80fd\u4f1a\u5bfc\u81f4\u8fd1\u51e0\u5e74\u5bf9\u4e8e\u6392\u653e\u7684\u4f30\u8ba1\u503c\u9ad8\u4e8e\u65e9\u4e9b\u5e74\u7684\u4f30\u8ba1\u503c\u3002\u8bf7\u53c2\u9605\u6b64\u5904\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002", "cb3182600e9dbaf3c7b9b6ff6160c737": "30 \u7c73\uff0c\u5168\u7403\uff0c2001 \u5e74-2023 \u5e74\uff0cHarris et al. 2021", "90bbd029e3ec82f37dba0df752094f58": "\u6392\u653e\u6570\u636e\u662f\u901a\u8fc7\u5efa\u6a21\u5f97\u5230\u7684\u4ea7\u7269\uff0c\u56e0\u6b64\u5176\u672c\u8eab\u5b58\u5728\u4e00\u5b9a\u7684\u8bef\u5dee\u548c\u4e0d\u786e\u5b9a\u6027\u3002\u5728\u4f7f\u7528\u6570\u636e\u4e4b\u524d\uff0c\u5f3a\u70c8\u5efa\u8bae\u7528\u6237\u9605\u8bfb\u5e76\u5145\u5206\u7406\u89e3\u5143\u6570\u636e\u548c\u5176\u4ed6\u63d0\u4f9b\u7684\u6587\u6863\u3002&nbsp;&nbsp;", "17537a146994ea218136e1aef1fb647b": "\u5728 2010 \u5e74\uff0c{location} \u62e5\u6709 {naturalForest} \u7684\u5929\u7136\u6797\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684 {percentage} \u4ee5\u4e0a\u3002\u5230\u4e86 {year} \u5e74\uff0c\u6b64\u5730\u635f\u5931\u4e86 {naturalLoss} \u7684\u5929\u7136\u6797\uff0c\u76f8\u5f53\u4e8e {emissionsTreeCover} \u4e8c\u6c27\u5316\u78b3\u6392\u653e\u91cf\u3002", "c08e65a920d77691e56c110a8b28ebfa": "\u5728 2001 \u5e74\uff0c{location} \u62e5\u6709 {primaryForest} \u7684\u539f\u59cb\u68ee\u6797*\uff0c\u5360\u5176\u571f\u5730\u9762\u79ef\u7684 {percentagePrimaryForest} \u4ee5\u4e0a\u3002\u5230\u4e86 {year} \u5e74\uff0c\u6b64\u5730\u635f\u5931\u4e86 {primaryLoss} \u7684\u539f\u59cb\u68ee\u6797*\uff0c\u76f8\u5f53\u4e8e {emissionsPrimary} \u4e8c\u6c27\u5316\u78b3\u6392\u653e\u91cf\u3002\u6839\u636e MoEF-WRI \u7684\u5206\u6790\uff0c\u635f\u5931\u7684\u68ee\u6797\u4e2d\u6709 <b>144 kha</b> \u5c5e\u4e8e\u5370\u5ea6\u5c3c\u897f\u4e9a\u5b98\u65b9\u68ee\u6797\u571f\u5730\u8986\u76d6\u7c7b\u522b\uff0c\u68ee\u6797\u6591\u5757\u9762\u79ef\u8d85\u8fc7\u4e24\u516c\u9877\u3002", "203cae1762555e74ada541954d4a80d9": "\u6211\u4eec\u5f88\u9ad8\u5174\u63a8\u51faGFW\u516c\u544a\u677f\uff01\u5728\u8fd9\u91cc\uff0c\u60a8\u80fd\u770b\u5230\u6709\u5173\u65b0\u6570\u636e\u96c6\u3001\u51fa\u7248\u7269\u548c\u8fd1\u671f\u6d3b\u52a8\u7684\u91cd\u8981\u4fe1\u606f\u3002\u60a8\u53ef\u4ee5\u968f\u65f6\u70b9\u51fb\u4e3b\u83dc\u5355\u4e2d\u7684\u94c3\u94db\u56fe\u6807\u8fdb\u5165\u6b64\u516c\u544a\u677f\u3002\u8bf7\u7559\u610f\u8be5\u6309\u94ae\u4e0a\u7684\u7ea2\u8272\u6307\u793a\u70b9\uff0c\u8fd9\u8868\u793a\u6709\u65b0\u901a\u77e5\u9700\u8981\u9605\u8bfb\u3002", "4a32527ec232cb984b1dcd1e55ae8eb3": "\u8bf7\u4e8e\u7f8e\u56fd\u4e1c\u90e8\u65f6\u95f42023\u5e7410\u670819\u65e5\u4e0a\u53488\u70b9\u52a0\u5165\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240\u975e\u6d32\u5206\u90e8\u548c\u5168\u7403\u68ee\u6797\u89c2\u5bdf\u7684\u884c\u5217\uff0c\u53c2\u52a0\u9898\u4e3a \u300a2022\u5e74\u521a\u679c\u76c6\u5730\u68ee\u6797\u53d1\u751f\u4e86\u4ec0\u4e48\uff1f\u6c11\u95f4\u793e\u4f1a\u7684\u89c6\u89d2\u300b\u7684\u5728\u7ebf\u6d3b\u52a8\u3002<a href=\"{{0}}\" rel=\"noopener\" target=\"_blank\">\u66f4\u591a\u4fe1\u606f\u53ef\u5728\u6b64\u5904\u83b7\u5f97</a>\u3002\n", "7d8459c319ed6da4714d2e75c2c1abdf": "\u63a8\u51fa\u5168\u65b0GFW\u516c\u544a\u677f\uff01", "22203745cabcbf4c9d8c8f64f603c8