u6743\u5229\u884c\u52a8\u201d\uff08ERA\uff09\u548c\u201c\u5c3c\u65e5\u5229\u4e9a\u5730\u7403\u4e4b\u53cb\u201d\uff08FoE\uff09\u81f4\u529b\u4e8e\u901a\u8fc7\u4f7f\u7528 GFW \u7ed8\u5236\u3001\u76d1\u6d4b\u548c\u901a\u62a5\u62a2\u5730\u548c\u6ee5\u4f10\u4e8b\u4ef6\uff0c\u589e\u5f3a\u5c3c\u65e5\u5229\u4e9a\u5357\u5357\u6c5f\u6237\u5dde\u5f53\u5730\u793e\u533a\u7684\u6743\u5229\uff0c\u5021\u5bfc\u53cd\u5bf9\u901a\u8fc7\u62a2\u5730\u548c\u6ee5\u4f10\u6269\u5927\u79cd\u690d\u56ed\u89c4\u6a21\u3002\u7531\u6b64\u4ea7\u751f\u7684\u8fd0\u52a8\u3001ERA/FoE \u548c\u793e\u533a\u5411\u6c5f\u6237\u5dde\u653f\u5e9c\u63d0\u51fa\u7684\u8054\u5408\u8bf7\u613f\u4ee5\u53ca\u4e0e\u5730\u65b9\u653f\u5e9c\u5b98\u5458\u7684\u4f1a\u6664\uff0c\u5e2e\u52a9\u6210\u529f\u6536\u56de\u88ab\u4e00\u5bb6\u79cd\u690d\u56ed\u516c\u53f8\u5360\u53d6\u7684\u8fd1 13\uff0c750 \u516c\u9877\u7684\u571f\u5730\u3002", "88868235d158d24806c9653cff332a09": "\u201c\u8054\u5408\u5229\u534e\u516c\u53f8\u201d\uff08Unilever \uff09\u4f7f\u7528 GFW \u7684\u68d5\u6988\u6cb9\u98ce\u9669\u5de5\u5177\u6765\u786e\u5b9a\u4f9b\u5e94\u94fe\u4e2d\u7684 29 \u5bb6\u9ad8\u98ce\u9669\u68d5\u6988\u6cb9\u5382\uff0c\u5b83\u4eec\u73b0\u5728\u53ef\u4ee5\u53c2\u4e0e\u51cf\u5c11\u68ee\u6797\u780d\u4f10\u5e76\u91c7\u53d6\u66f4\u52a0\u53ef\u6301\u7eed\u7684\u505a\u6cd5\u3002", "632a92cf7c505b9633b680f958dbfea5": "\u672a\u627e\u5230\u56fd\u5bb6", "bc908652d94ee0e56bcfdf0c6f0b0c88": "\u4fdd\u62a4\u533a", "6f315a5e5af29bd80c385704e0bf2c07": "\u663e\u793a\u57fa\u4e8e\u9009\u5b9a\u533a\u57df\u5185\u6240\u9009\u68ee\u6797\u7c7b\u578b\u7684\u533a\u57df\u6392\u540d\u3002", "0e7ccccc9f3d401199d803f635156b37": "\u5168\u7403", "b7824e443d1a71c597e96814274fe0c0": "\u6811\u6728\u8986\u76d6\u6570\u636e\u96c6\u662f\u9a6c\u91cc\u5170\u5927\u5b66\u3001Google\u3001USGS\uff08\u7f8e\u56fd\u5730\u8d28\u52d8\u63a2\u5c40\uff09\u548c NASA\uff08\u7f8e\u56fd\u822a\u5929\u5c40\uff09\u7684\u5408\u4f5c\u9879\u76ee\uff0c\u4f7f\u7528 Landsat \u536b\u661f\u56fe\u50cf\u4ee5 30 \u7c73\u7684\u5206\u8fa8\u7387\u7ed8\u5236 2000 \u5e74 \u548c 2010 \u5e74\u7684\u5168\u7403\u68ee\u6797\u8986\u76d6\u5730\u56fe\u3002\u8bf7\u6ce8\u610f\uff0c\u201c\u68ee\u6797\u8986\u76d6\u201d\u662f\u6811\u6728\u7684\u751f\u7269\u7269\u7406\u5b58\u5728\uff0c\u53ef\u4ee5\u662f\u751f\u957f\u4e8e\u4e00\u5b9a\u7684\u6811\u51a0\u5bc6\u5ea6\u8303\u56f4\u7684\u5929\u7136\u6797\u6216\u79cd\u690d\u56ed\u3002", "f554c2fef551ea167b60966119ba00f4": "\u7b5b\u9009\u548c\u81ea\u5b9a\u4e49\u6570\u636e", "5c0c1a1313033a7f9f6faefb4ccbc4e4": "\u5171\u4eab\u6216\u5d4c\u5165\u6b64\u5c0f\u90e8\u4ef6", "f7e288935cdd6d4d1e818c400190bbcb": "\u5728\u5168\u7403\u5730\u56fe\u4e0a\u63a2\u7d22\u6570\u636e", "063edb4cc2ac0d4e22c6eb00702b71af": "\u539f\u751f\u6797", "d17febccf8d10c789263953901d2b2ad": "\u5176\u4ed6\u68ee\u6797\u8986\u76d6", "de68388f025c692243533c3639a18eb9": "\u5b89\u54e5\u62c9 FAO \u9020\u6797", "ebc274e36c6f04a4ece0ac8a8e954a2b": "\u5b89\u54e5\u62c9 FAO \u6ee5\u4f10", "eacc4de42cc985b48d0ffc1e5b856acb": "\u5728\u6709\u79cd\u690d\u56ed\u6570\u636e\u7684\u60c5\u51b5\u4e0b\uff0c\u6ca1\u6709\u4e0e\u539f\u59cb\u68ee\u6797\u6216\u79cd\u690d\u56ed\u91cd\u53e0\u7684\u68ee\u6797\u8986\u76d6\u533a\u57df\u88ab\u89c6\u4e3a\u201c\u6b21\u751f\u6797\u201d\u3002", "62f5d708d6ad1fa1ddd9429a65cccbea": "\u6240\u6709\u7c7b\u522b", "9fc6679e2c4ee1ad1d24f47958741dca": "\u9009\u62e9\u60a8\u60f3\u8981\u63a2\u7d22\u7684\u56fd\u5bb6", "fb3949bd603453e8ac6fc17704df323f": "\u5929\u7136\u518d\u751f\u6797", "202e0ccca4f7566694864653dbd1e081": "\u79cd\u690d\u6797", "2938c7f7e560ed972f8a4f68e80ff834": "\u64cd\u4f5c\u9762\u677f", "c15b06eeb94ee3c4366dfd575a27d09c": "\u663e\u793a\u9009\u5b9a\u533a\u57df\u4e2d 2000 \u5e74\u6216 2010 \u5e74\u7684\u68ee\u6797\u8986\u76d6\u8303\u56f4\u3002\u5b83\u662f\u6307\u9ad8\u5ea6\u8d85\u8fc7 5 \u7c73\u7684\u6240\u6709\u690d\u88ab\u3002", "b3d58bfe7d9e1083904bb564a90e6f90": "GFW \u5728\u884c\u52a8", "74521e1ee92d17b6199819c68b297fd2": "\u5f71\u54cd", "5e4c2b30e54de67b17ff0f2456dbc71a": "\u5408\u4f5c\u4f19\u4f34", "adcd01e00ae3c626762b6475e8fae209": "\u4e16\u754c\u5404\u5730\u6bcf\u5929\u6709\u6210\u5343\u4e0a\u4e07\u7684\u4eba\u4f7f\u7528 GFW \u6765\u76d1\u6d4b\u548c\u7ba1\u7406\u68ee\u6797\uff0c\u5236\u6b62\u975e\u6cd5\u780d\u4f10\u68ee\u6797\u548c\u963b\u6b62\u706b\u707e\uff0c\u53f7\u53ec\u6d88\u9664\u4e0d\u53ef\u6301\u7eed\u7684\u6d3b\u52a8\uff0c\u4fdd\u62a4\u4ed6\u4eec\u7684\u571f\u5730\u548c\u8d44\u6e90\uff0c\u53ef\u6301\u7eed\u5730\u83b7\u53d6\u5546\u54c1\uff0c\u5e76\u5728\u4fdd\u80b2\u7684\u524d\u6cbf\u8fdb\u884c\u7814\u7a76\u3002", "96bba181c3d3a1d08d55a9ca7be38f55": "\u4e86\u89e3\u5982\u4f55\u4f7f\u7528 GFW", "d22f56a234213127e05577e8094f7f9f": "GFW \u5982\u4f55\u521b\u9020\u53d8\u5316\uff1f", "776c84b3b6796849c53e10c983b6c084": "<span></span>\u900f\u660e\u5ea6", "d3a22099ef1b9fd2063f365b4e318e6a": "\u5f88\u96be\u7ba1\u7406\u65e0\u6cd5\u68c0\u6d4b\u7684\u4e1c\u897f\u3002Global Forest Watch \u5728\u7ebf\u514d\u8d39\u63d0\u4f9b\u6709\u5173\u68ee\u6797\u6700\u4f73\u7684\u53ef\u7528\u6570\u636e\uff0c\u521b\u9020\u4e86\u524d\u6240\u672a\u6709\u7684\u900f\u660e\u5ea6\uff0c\u8ba9\u4eba\u4eec\u4e86\u89e3\u5168\u7403\u5404\u5730\u68ee\u6797\u7684\u5b9e\u65f6\u60c5\u51b5\u3002\u66f4\u597d\u7684\u4fe1\u606f\u6709\u52a9\u4e8e\u505a\u51fa\u66f4\u52a0\u660e\u667a\u7684\u51b3\u7b56\uff0c\u5e2e\u52a9\u4eba\u4eec\u548c\u5b50\u5b59\u540e\u4ee3\u7ba1\u7406\u548c\u4fdd\u62a4\u68ee\u6797\uff0c\u800c\u66f4\u9ad8\u7684\u900f\u660e\u5ea6\u6709\u52a9\u4e8e\u516c\u4f17\u8ba9\u653f\u5e9c\u548c\u516c\u53f8\u627f\u62c5\u5176\u51b3\u7b56\u5bf9\u68ee\u6797\u7684\u5f71\u54cd\u7684\u8d23\u4efb\u3002\u653f\u5e9c\u3001\u516c\u53f8\u3001\u6c11\u95f4\u793e\u4f1a\u7ec4\u7ec7\u3001\u8bb0\u8005\u548c\u5173\u5fc3\u5f53\u5730\u68ee\u6797\u7684\u666e\u901a\u4eba\u6bcf\u5929\u90fd\u53ef\u4ee5\u8bbf\u95ee GFW \u6570\u636e\u3002", "3cd8ac197b0a156cfb09b6af30713313": "<span></span>\u53c2\u4e0e", "22773f042ed1385817ac4c898c92efef": "<span></span>\u793e\u533a", "5d5c06b7a01b20d119dc328eaa09da00": "\u201c\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240\u201d\uff08WRI\uff09\u4e8e 1997 \u5e74\u521b\u7acb\u4e86 Global Forest Watch\uff0c\u662f\u68ee\u6797\u524d\u6cbf\u5021\u8bae\u7684\u4e00\u90e8\u5206\u3002Global Forest Watch \u6700\u521d\u662f\u4e00\u4e2a\u975e\u653f\u5e9c\u7ec4\u7ec7\uff08NGO\uff09\u7f51\u7edc\uff0c\u63d0\u4f9b\u5580\u9ea6\u9686\u3001\u52a0\u62ff\u5927\u3001\u52a0\u84ec\u548c\u5370\u5ea6\u5c3c\u897f\u4e9a\u7b49\u56db\u4e2a\u8bd5\u70b9\u56fd\u5bb6\u68ee\u6797\u72b6\u51b5\u7684\u6700\u65b0\u62a5\u544a\u3002", "c22cda25902b6ca897fbf9cced304919": "2002 \u5e74\uff0cGFW \u7684\u5de5\u4f5c\u8303\u56f4\u5df2\u6269\u5c55\u81f3\u667a\u5229\u3001\u4fc4\u7f57\u65af\u3001\u59d4\u5185\u745e\u62c9\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u3001\u521a\u679c\u6c11\u4e3b\u5171\u548c\u56fd\u548c\u7f8e\u56fd\uff0c\u53d1\u8868\u4e86\u68ee\u6797\u8986\u76d6\u548c\u72b6\u51b5\u4ee5\u53ca\u5f71\u54cd\u68ee\u6797\u7684\u6d3b\u52a8\uff08\u5982\u7279\u8bb8\u6743\u548c\u57fa\u7840\u8bbe\u65bd\uff09\u7684\u76f8\u5173\u62a5\u544a\u3002GFW \u8ba1\u5212\u5230 2005 \u5e74\u5728 21 \u4e2a\u56fd\u5bb6\u5efa\u7acb\u548c\u8fd0\u884c\u5176\u68ee\u6797\u76d1\u6d4b\u7f51\u7edc\u3002", "023af17b3415d45ebc459ba7a8913bd5": "GFW \u5f00\u59cb\u4e0e\u4e2d\u975e\u7684\u653f\u5e9c\u5408\u4f5c\uff0c\u521b\u5efa\u4e86\u540d\u4e3a Forestry Atlases \u7684\u4ea4\u4e92\u5f0f\u68ee\u6797\u548c\u571f\u5730\u4f7f\u7528\u5728\u7ebf\u5730\u56fe\u3002\u7b2c\u4e00\u5f20\u5730\u56fe\u662f\u4e0e\u201c\u5580\u9ea6\u9686\u73af\u5883\u548c\u68ee\u6797\u90e8\u201d\uff08MINEF\uff09\u5408\u4f5c\uff0c\u4e3a\u5580\u9ea6\u9686\u521b\u5efa\u7684\u3002 \u57fa\u4e8e ESRI \u7684 ArcGIS Server \u6784\u5efa\u7684\u4ea4\u4e92\u5f0f\u5730\u56fe\u5f88\u5feb\u6269\u5c55\u5230 GFW \u6db5\u76d6\u7684\u6240\u6709\u56fd\u5bb6\u3002", "4b9e1df645aa20450c145d7ef517d34a": "\u63a5\u4e0b\u6765\u7684\u516d\u5e74\u91cc\uff0cGFW \u7ee7\u7eed\u5236\u4f5c\u5168\u7403\u548c\u5730\u533a\u68ee\u6797\u5730\u56fe\u548c\u5206\u6790\uff0c\u540c\u65f6\u8fd8\u6269\u5927\u4e0e\u5404\u56fd\u653f\u5e9c\u7684\u56fd\u5bb6\u6d4b\u7ed8\u9879\u76ee\u30022006 \u5e74\uff0cGFW \u4e0e\u7eff\u8272\u548c\u5e73\u7ec4\u7ec7\u4e00\u8d77\u7ed8\u5236\u4e86\u7b2c\u4e00\u5f20\u539f\u751f\u6797\u666f\u89c2\u7684\u5168\u7403\u5730\u56fe\u3002", "bd356acdf054e88202c05cd12ac65b15": "2014\u5e74\uff0cWRI \u53d1\u5e03\u4e86 GFW 2.0\u3002\u5b83\u4ee5\u8fd1 20 \u5e74\u7684\u5de5\u4f5c\u4e3a\u57fa\u7840\uff0c\u521b\u5efa\u4e86\u4e00\u4e2a\u5b8c\u5168\u4ea4\u4e92\u7684\u5728\u7ebf\u5e73\u53f0\uff0c\u4e3a\u5168\u4e16\u754c\u63d0\u4f9b\u68ee\u6797\u76d1\u6d4b\u6570\u636e\u3002GFW \u7684\u65b0\u4e00\u8f6e\u8fed\u4ee3\u5f97\u76ca\u4e8e\u68ee\u6797\u76d1\u6d4b\u6280\u672f\u7684\u8fdb\u6b65\u548c\u66f4\u591a\u7684\u5408\u4f5c\u4f19\u4f34\u3002", "d8aafd1ffeab30711edc319f83df12db": "\u201c\u4e9a\u9a6c\u900a\u4fdd\u62a4\u534f\u4f1a\u201d\uff08ACA \uff09\u5229\u7528 GFW \u7684\u536b\u661f\u6570\u636e\u53d1\u73b0\u4e86\u201c\u8054\u5408\u53ef\u53ef\uff08United Cacao\uff09\u516c\u53f8\u201d\u975e\u6cd5\u780d\u4f10\u79d8\u9c81\u539f\u751f\u6797\u7684\u884c\u4e3a\u3002GFW \u7684\u6570\u636e\u6709\u52a9\u4e8e ACA \u8c03\u67e5\u6b64\u6848\u5e76\u901a\u62a5\u7834\u574f\u7a0b\u5ea6\uff0c\u4f7f\u8054\u5408\u53ef\u53ef\u516c\u53f8\uff08United Cacao\uff09 \u6700\u7ec8\u5931\u53bb\u5728\u4f26\u6566\u8bc1\u5238\u4ea4\u6613\u6240\u4e0a\u5e02\u7684\u8d44\u683c\u3002", "dfe92a57672ca4f27e8ddb13e091c0e8": "\u201c\u4e4c\u5e72\u8fbe\u56fd\u5bb6\u68ee\u6797\u7ba1\u7406\u5c40\u201d\uff08NFA \uff09\u7684\u68ee\u6797\u76d1\u6d4b\u5458\u5229\u7528 GFW \u7684 GLAD \u6ee5\u4f10\u8b66\u62a5\u53d1\u73b0\u4e86 Kasyoha Kitomi \u68ee\u6797\u4fdd\u62a4\u533a\u7684\u4e00\u4e2a\u5c0f\u578b\u975e\u6cd5\u91c7\u4f10\u8425\u5730\u3002NFA \u901a\u8fc7 GFW \u6570\u636e\u8d77\u8bc9\u4e86\u4f10\u6728\u5de5\u4eba\uff0c\u5bf9\u5176\u8fdd\u6cd5\u884c\u4e3a\u8fdb\u884c\u4e86\u7f5a\u6b3e\u3002", "69be46de2a08709dc2cdd7b0ed513b5f": "\u521b\u59cb\u5408\u4f5c\u4f19\u4f34", "bdde7645322896474fe113a628ca6d07": "\u7ed9\u6211\u4eec\u53d1\u9001\u7535\u5b50\u90ae\u4ef6", "c7097185a1a9d3d60af33bd7c16cdf03": "\u968f\u7740\u536b\u661f\u6280\u672f\u7684\u8fdb\u4e00\u6b65\u53d1\u5c55\uff0cGFW \u9664\u4e86\u53ef\u4ee5\u63d0\u4f9b\u68ee\u6797\u5e74\u5ea6\u6570\u636e\uff0c\u8fd8\u5f00\u59cb\u63d0\u4f9b\u6bcf\u6708\u548c\u6bcf\u5468\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u3002\u901a\u8fc7\u7535\u5b50\u90ae\u4ef6\u8ba2\u9605\u53ef\u5c06\u8fd9\u4e9b\u8b66\u62a5\u76f4\u63a5\u53d1\u9001\u7528\u6237\u624b\u4e2d\uff0c\u63d0\u9ad8\u4e86\u4ed6\u4eec\u8fd1\u5b9e\u65f6\u54cd\u5e94\u65b0\u6d3b\u52a8\u7684\u80fd\u529b\u3002", "06febfdcdb3288f1896f091813b6a730": "2017 \u5e74\uff0cGFW \u63a8\u51fa\u4e86\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f Forest Watcher\uff0c\u53ef\u8ba9\u7528\u6237\u5728\u79bb\u7ebf\u72b6\u6001\u4e0b\u83b7\u53d6 GFW \u7684\u6570\u636e\u5e76\u5e26\u5165\u73b0\u573a\u3002\u8fd9\u6b3e\u5e94\u7528\u4ee3\u8868\u7740\uff0c\u5c06\u68ee\u6797\u5de5\u4f5c\u4eba\u5458\u4e0e\u4fdd\u62a4\u68ee\u6797\u6240\u9700\u4fe1\u606f\u76f4\u63a5\u8054\u7cfb\u8d77\u6765\u53d6\u5f97\u4e86\u65b0\u8fdb\u6b65\u3002", "b72c76c87dc67519a1f0e103dead9081": "\u95ee\u9898\u3001\u8bc4\u8bba\u3001\u8bf7\u6c42\u3001\u53cd\u9988\uff1f\u6211\u4eec\u5e0c\u671b\u6536\u5230\u60a8\u7684\u5efa\u8bae\u3002\u5b8c\u6210\u53f3\u4fa7\u7684\u8868\u683c\uff0c\u5e2e\u52a9\u6211\u4eec\u6539\u8fdb Global Forest Watch\u3002", "2b5057e79c902bb03f7479fff1d35895": "\u63a2\u7d22\u56e2\u961f", "0f54053e821ea8e52c97fd5054abb0b3": "\u63a2\u7d22\u5de5\u4f5c", "503281d0e5b3c6ca8ec12c195a907d0e": "\u5168\u7403\u91ce\u751f\u52a8\u7269\u4fdd\u62a4\u7ec4\u7ec7\u4e0e\u5c3c\u52a0\u62c9\u74dc\u7684 Rama \u548c Kriol \u793e\u533a\u5408\u4f5c\uff0c\u5efa\u7acb\u4e86\u4e00\u4e2a\u65b0\u7684\u571f\u8457\u68ee\u6797\u62a4\u6797\u5458\u9879\u76ee\uff0c\u4fdd\u62a4 Indio-Maiz \u4fdd\u62a4\u533a\u3002\u571f\u8457\u68ee\u6797\u62a4\u6797\u5458\u4f7f\u7528 Global Forest Watch \u7684\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u548c\u706b\u707e\u6570\u636e\u3002\u8fd9\u4e24\u9879\u6570\u636e\u6709\u52a9\u4e8e\u901a\u8fc7\u786e\u5b9a\u5f53\u524d\u9762\u4e34\u5a01\u80c1\u6700\u5927\u7684\u533a\u57df\u5236\u5b9a\u62a4\u6797\u5458\u7684\u5de1\u903b\u8def\u7ebf\uff0c\u5e76\u901a\u8fc7\u5bfc\u822a\u8b66\u62a5\u8bb0\u5f55\u975e\u6cd5\u6ee5\u4f10\u68ee\u6797\u7684\u60c5\u51b5\u3002\u62a4\u6797\u5458\u5df2\u6210\u529f\u8ba9\u5730\u65b9\u5f53\u5c40\u5c06\u975e\u6cd5\u6b96\u6c11\u8005\u9a71\u9010\u51fa\u4fdd\u62a4\u533a\u3002", "c8d653357337b4407664e48054cf317e": "\u201c\u5fb7\u96f7\u5c14\u91ce\u751f\u52a8\u7269\u4fdd\u62a4\u4fe1\u6258\u57fa\u91d1\u4f1a\u201d\uff08Durrell Wildlife Conservation Trust\uff09\u5c06 GFW \u7684\u5e74\u5ea6\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u6570\u636e\u4f5c\u4e3a\u9a6c\u8fbe\u52a0\u65af\u52a0 Menabe-Antimena \u4fdd\u62a4\u533a\u6700\u8fd1\u53d1\u751f\u707e\u96be\u6027\u68ee\u6797\u51cf\u5c11\u7684\u8bc1\u636e\u3002\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u6570\u636e\u6709\u52a9\u4e8e\u8bf4\u670d\u73af\u5883\u90e8\u589e\u52a0\u5de1\u903b\uff0c\u76d1\u6d4b\u4fdd\u62a4\u533a\uff0c\u5e76\u5c06\u975e\u6cd5\u5f00\u53d1\u571f\u5730\u7684\u4eba\u6e05\u9664\u51fa\u53bb\u3002", "15f82662104f4552ac71fd93e39faea7": "GFW\u6570\u636e\u663e\u793a\u4e86\u5546\u54c1\u9a71\u52a8\u7684\u68ee\u6797\u780d\u4f10\u3002", "e8b4998cc9ec1b3c12d05f7a44b0d2f8": "\u622a\u81f32001\u5e74\uff0c{location}\u603b\u6811\u6728\u8986\u76d6\u7684{percentage}\u4e3a<b>primary forest</b>\u3002", "e017bd9c3cef4edfed9bdbda55b45181": "\u9605\u8bfb\u4e86\u89e3\u68ee\u6797\u662f\u5982\u4f55\u6709\u5229\u4e8e\u5168\u7403\u6c34\u6e90\u4f9b\u5e94\u7684\u3002", "3b88ed4de60e2e13ede1bbf6413d78ea": "\u9605\u8bfb\u4e86\u89e3\u68ee\u6797\u5982\u4f55\u6e05\u9664\u5927\u6c14\u4e2d\u7684\u78b3\u3002", "1cf242c11c817738e1a6ecf178822d47": "\u6839\u636eFAO\u7edf\u8ba1\uff0c{year}\u5e74{location}\u7684\u68ee\u6797\u780d\u4f10\u7387\u4e3a\u6bcf\u5e74{rate}\u3002", "9360f88791630753e2da0074dea536a9": "\u5728\u8fc7\u53bb{timeframe}\u4e2d\uff0c\u5728{location}\u68c0\u6d4b\u5230{count}\u6b21GLAD\u8b66\u62a5\uff0c\u5f71\u54cd\u4e86\u5927\u7ea6{area}\u7684\u533a\u57df\u3002\u524d{topRegions}\u591a\u7684\u5730\u533a\u5360\u6240\u6709GLAD\u8b66\u62a5\u7684{topPercent}\u3002", "5d950ab3b295c7b294ed2742b0540400": "\u4e86\u89e3\u4e3a\u786e\u4fdd\u7f8e\u56fd\u68ee\u6797\u548c\u5176\u4ed6\u751f\u6001\u7cfb\u7edf\u7f51\u7edc\u7684\u6c34\u76f8\u5173\u529f\u80fd\u6240\u505a\u51fa\u7684\u6210\u529f\u52aa\u529b\u3002", "4409db5b12407c6d18f4ca52c6451f3b": "\u65f6\u523b\u4e86\u89e3\u5168\u7403\u68ee\u6797\u7684\u6700\u65b0\u60c5\u51b5", "200a23961e1e0954455889850d0d0da2": "\u60a8\u53ef\u80fd\u8f93\u5165\u4e86\u9519\u8bef\u7684\u5730\u5740\uff0c\u6216\u8005\u9875\u9762\u53ef\u80fd\u5df2\u7ecf\u88ab\u79fb\u9664\u3002", "810c515611f8d5e8edfb50febcd03043": "\u5065\u5eb7\u6d41\u57df\u7684\u68ee\u6797\u89e3\u51b3\u65b9\u6848", "9bfee77436a05cbe7b9f1f71d5d37a26": "\u63a2\u7d22\u6570\u636e", "b7153240c6c1e3994a0d40c61709980d": "GFW Pro\u5e2e\u52a9\u4f01\u4e1a\u7ba1\u7406\u5176\u4f9b\u5e94\u94fe\u4e2d\u7684\u68ee\u6797\u780d\u4f10\u98ce\u9669\u3002", "8d321b1475baff56fa8fe7fb6a882247": "\u4e86\u89e3\u4f20\u7edf\u8015\u4f5c\u65b9\u6cd5\u548c\u780d\u4f10\u68ee\u6797\u4e4b\u95f4\u7684\u533a\u522b\u3002", "abbec555526e6638cd920133d808afec": "GFW\u6570\u636e\u663e\u793a\u4e86\u70ed\u5e26\u6811\u6728\u8986\u76d6\u635f\u5931\u5bfc\u81f4\u7684\u78b3\u6392\u653e\u91cf\u3002", "b719ce180ec7bd9641fece2f920f4817": "\u5973\u6027", "5a9f673bac3e2eafde53fda6ac47a071": "\u9605\u8bfb\u4e86\u89e3\u706b\u707e\u548c\u5546\u54c1\u751f\u4ea7\u4e4b\u95f4\u7684\u8054\u7cfb", "0a06de72b7d9d0be0897797feebdc7ce": "GFW\u7ed8\u5236\u51fa\u5728\u539f\u751f\u6797\u3001\u539f\u59cb\u6797\u548c\u6ce5\u70ad\u6797\u65c1\u7684\u7279\u8bb8\u6743\u8fb9\u754c\uff0c\u4ee5\u7a81\u51fa\u5546\u54c1\u9a71\u52a8\u7684\u68ee\u6797\u780d\u4f10\u98ce\u9669\u6700\u5927\u7684\u5730\u533a\u3002", "3218cbbd69118d6976e91ebb8693de5f": "\u627e\u4e0d\u5230\u9875\u9762", "3d4b88423cfccf6880c0d905efb3f44d": "GLOBAL FOREST WATCH\u662f\u4ec0\u4e48\uff1f", "96bf1e14246d1a8d85993ebafa423847": "\u6839\u636eFAO\u7edf\u8ba1\uff0c{year}\u5e74{location}\u7684\u91cd\u65b0\u9020\u6797\u7387\u4e3a\u6bcf\u5e74{rate}\u3002", "5fb28ae70a59fb6a302161a66743eaf0": "\u67e5\u770b\u535a\u5ba2", "548684f2f04f75df4a1c20efc9859ad5": "\u4e86\u89e3\u68ee\u6797\u6062\u590d\u5982\u4f55\u5e2e\u52a9\u5b9e\u73b0\u6c14\u5019\u76ee\u6807\u3002", "f9c2e0b945713b4c1931132abc202944": "\u6839\u636e\u60a8\u7684\u5174\u8da3\u8ba2\u9605GFW\u6708\u5ea6\u65f6\u4e8b\u901a\u8baf\u548c\u66f4\u65b0\u3002", "05900a63e1a7c9149be0302140fd96ec": "\u9605\u8bfb\u4e86\u89e3\u539f\u4f4f\u6c11\u793e\u533a\u5982\u4f55\u4f7f\u7528GFW\u6570\u636e\u6765\u76d1\u6d4b\u548c\u4fdd\u62a4\u4ed6\u4eec\u7684\u571f\u5730\u3002", "8e89bfe4e23a0c64bd554e6c9722b5ad": "\u63a2\u7d22GFW Pro", "3280c3337980d71b965969f897d4ebf2": "\u9605\u8bfb\u4e86\u89e3GFW\u76d1\u6d4b\u6570\u636e\u5982\u4f55\u652f\u6301\u68ee\u6797\u4fdd\u62a4\u76ee\u6807\u7684\u5b9e\u73b0\u3002", "e057be76b08604fca947b4c48eef2e1a": "\u4e86\u89e3\u5065\u5eb7\u7684\u68ee\u6797\u5bf9\u6c34\u6e90\u7684\u91cd\u8981\u6027\u3002", "dbf8e149bd8bbe7f17d3120457abb80f": "\u4ece{startYear}\u5230{endYear}\uff0c{location}\u635f\u5931\u4e86{loss}\u76f8\u5bf9\u6811\u8986\u76d6\uff0c\u76f8\u5f53\u4e8e{extentYear}\u4ee5\u6765{localPercent}\u7684\u51cf\u5c11\u91cf\u4ee5\u53ca\u5168\u7403\u603b\u91cf\u7684{globalPercent}\u3002", "679f4ef7b6c5cb138f3002edea5a94ec": "\u60a8\u7684\u6d41\u57df\u7684\u5065\u5eb7\u7a0b\u5ea6\u5982\u4f55\uff1f", "fc9022a6e8c09b293363431f2b7486fe": "GFW\u53d1\u5e03\u4e86\u65b0\u6570\u636e\uff0c\u8be5\u6570\u636e\u663e\u793a\u4e86\u6811\u6728\u8986\u76d6\u635f\u5931\u7684\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\uff0c\u5305\u62ec\u90a3\u4e9b\u5bfc\u81f4\u68ee\u6797\u780d\u4f10\u7684\u56e0\u7d20\u3002 GFW\u8fd8\u53d1\u5e03\u4e86\u6539\u8fdb\u540e\u7684\u65b0\u63a7\u5236\u9762\u677f\uff0c\u4ee5\u63d0\u4f9b\u5173\u4e8e\u68ee\u6797\u53d8\u5316\u7684\u539f\u56e0\u548c\u5f71\u54cd\u7684\u6d1e\u89c1\u3002", "00f59a73cea42d02ee62c4f42ee3cae1": "GFW\u5f00\u542f\u5bf9\u6d41\u57df\u5730\u533a\u7684\u8c03\u67e5\u3002", "b9d97bafb8794e04df00b7dd1ed5f891": "\u4e86\u89e3\u5723\u4fdd\u7f57\u5e02\u5982\u4f55\u5229\u7528\u68ee\u6797\u6e05\u6d01\u6c34\u6e90\u3002", "25f89dcdfe706e4442066cb9de372ccf": "\u4e86\u89e3\u4e3a\u4ec0\u4e48\u65e0\u68ee\u6797\u780d\u4f10\u4f9b\u5e94\u94fe\u5bf9\u516c\u53f8\u7684\u5229\u6da6\u66f4\u6709\u5229\u3002", "d650a4974ad580d09758818ac6b171a7": "\u5728GFW\u4e0a\u53ef\u4ee5\u770b\u5230\u4e16\u754c\u5404\u5730\u7684\u7ea2\u6811\u6797\u3002", "74bc8f525fd552be4f3076976e5c83a6": "GFW\u8ddf\u8e2a\u4e16\u754c\u4e3b\u8981\u6d41\u57df\u7684\u706b\u707e\u548c\u6700\u8fd1\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u60c5\u51b5\u3002", "0758ea99dd504ad036027ed4e15ebb3c": "\u9605\u8bfb\u4e86\u89e3\u68ee\u6797\u780d\u4f10\u5982\u4f55\u52a0\u5267\u96c5\u52a0\u8fbe\u7684\u6c34\u8d44\u6e90\u5371\u673a\u3002", "c3f381a5815d2de6023b0a7214c5a9a2": "\u4e86\u89e3\u68ee\u6797\u635f\u5931\u5982\u4f55\u5f71\u54cd\u60a8\u7684\u6c34\u6e90\u4f9b\u5e94\u3002", "af1e3df6449a9007be51fddc388153ae": "\u6d4b\u91cf\u60a8\u7684\u6d41\u57df\u4e2d\u7684\u68ee\u6797\u5e76\u8ddf\u8e2a\u6700\u8fd1\u7684\u68ee\u6797\u635f\u5931\u3002", "d27cfa045304b14ee2250346ee83aa92": "\u6839\u636eFAO\u7684\u7edf\u8ba1\uff0c\u5728{year}\uff0c\u6709 {value}\u4eba\u53d7\u96c7\u4e8e{location}\u6797\u4e1a\u90e8\u95e8\uff0c\u5176\u4e2d{percent}\u4e3a\u5973\u6027\u3002", "36d5cc19cc1b80ebf2b0d8bc38292c8b": "\u4e86\u89e3\u968f\u7740\u5168\u7403\u6c14\u6e29\u4e0a\u5347\uff0c\u6781\u7aef\u706b\u707e\u5982\u4f55\u53d8\u5f97\u8d8a\u6765\u8d8a\u666e\u904d\u3002", "c44c044724f44cec015c2571d70d3332": "\u6839\u636eFAO\u7684\u7edf\u8ba1\uff0c\u5728{year}\u6797\u4e1a\u90e8\u95e8\u5bf9\u7ecf\u6d4e\u7684\u51c0\u8d21\u732e\u4e3a{value}\uff0c\u7ea6\u4e3a{location}GDP\u7684{percentage} \u3002", "63889cfb9d3cbe05d1bd2be5cc9953fd": "\u7537\u6027", "d18658ae15c64fe3186ad52284a8f170": "GFW\u7ed8\u5236\u4e86\u901a\u8fc7\u6811\u6728\u8986\u76d6\u589e\u52a0\u51cf\u5c11\u5927\u6c14\u4e2d\u78b3\u542b\u91cf\u7684\u533a\u57df\u3002", "ef643d92b61f86d8b2813e51aeebddea": "*\u539f\u751f\u6797\u7684\u5b9a\u4e49\u662f\u5728\u6700\u8fd1\u7684\u5386\u53f2\u4e2d\u6ca1\u6709\u7ecf\u5386\u5b8c\u5168\u6e05\u9664\u5e76\u518d\u751f\u7684\u6f6e\u6e7f\u70ed\u5e26\u6210\u719f\u81ea\u7136\u68ee\u6797\u3002", "ccf9bc7f94ef1406b34d650e9c8876c5": "\u67e5\u770b\u51fa\u7248\u7269", "c265115c4c1abc388ca0cd37e8c5092c": "\u5bf9\u4e8e\u4ece Global Forest Watch Pro \u83b7\u53d6\u6216\u63d0\u53d6\u7684\u6570\u636e\uff0c\u5fc5\u987b\u6839\u636e\u5e73\u53f0\u7684<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">\u8bb8\u53ef\u534f\u8bae</a>\u548c<a href=\"{{1}}\" target=\"_blank\" rel=\"noreferrer noopener\" class=\"\">\u670d\u52a1\u6761\u6b3e</a>\u6ce8\u660e\u51fa\u5904\u3002\u6b64\u8981\u6c42\u6db5\u76d6\u4ee5\u4e00\u5207\u5f62\u5f0f\u5206\u4eab\u7684\u5185\u5bb9\uff0c\u5305\u62ec\u6570\u5b57\u3001\u5370\u5237\u6216\u7167\u7247\u5f62\u5f0f\uff0c\u4ee5\u53ca\u6839\u636e\u4ece GFW Pro \u83b7\u5f97\u7684\u5185\u5bb9\u800c\u884d\u751f\u6216\u6539\u7f16\u7684\u5185\u5bb9\u3002\u6b64\u5916\uff0c\u5bf9\u4e8e\u5728\u5730\u56fe\u6216\u5b9a\u91cf\u8f93\u51fa\u4e2d\u4f7f\u7528\u7684\u7b2c\u4e09\u65b9\u4ea7\u54c1\uff0c\u5fc5\u987b\u6ce8\u660e\u5177\u4f53\u51fa\u5904\u3002&nbsp;", "3965207478e6a58f7c87af5d49a0c165": "\u53cd\u9988", "080e49e60353b8bbda00c8d7883246e7": "\u5728\u5730\u56fe\u4e0a\u67e5\u770b", "6dac557c68aa646318c01e4f6d6cb5a6": "\u62d6\u52a8\u624b\u67c4\uff0c\u8c03\u6574\u6700\u4f4e\u68ee\u6797\u8986\u76d6\u5c42 (TCC) \u5bc6\u5ea6\uff0c\u5bf9\u6c49\u68ee (Hansen) / \u9a6c\u91cc\u5170\u5927\u5b66 (UMD) /\u8c37\u6b4c (Google) /\u7f8e\u56fd\u5730\u8d28\u52d8\u63a2\u5c40 (USGS) /\u7f8e\u56fd\u5b87\u822a\u5c40 (NASA) \u63d0\u4f9b\u7684\u68ee\u6797\u8986\u76d6\u53ca\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u6570\u636e\u8fdb\u884c\u53ef\u89c6\u5316\u663e\u793a\u548c\u5206\u6790\u3002TCC \u5bc6\u5ea6\u8868\u793a 2000 \u5e74\u88ab\u6797\u51a0\u8986\u76d6\u7684\u50cf\u7d20\u767e\u5206\u6bd4\u7684\u4f30\u8ba1\u503c\uff0c\u8be5\u6570\u503c\u7531\u5bf9\u536b\u661f\u5f71\u50cf\u56fe\u7684\u5206\u6790\u6765\u786e\u5b9a\u3002\u800c\u76f8\u5e94\u5730\uff0c\u5728\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u6570\u636e\u4e2d\uff0cTCC \u5bc6\u5ea6\u8868\u793a\u51cf\u5c11\u53d1\u751f\u4e4b\u524d\u7684\u68ee\u6797\u8986\u76d6\u5bc6\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u9009\u62e9\u7684\u6700\u4f4e TCC \u5bc6\u5ea6\u4e3a 25%\uff0c\u60a8\u5c31\u53ea\u80fd\u770b\u5230\u539f\u68ee\u6797\u8986\u76d6\u5bc6\u5ea6\u5927\u4e8e 25% \u7684\u68ee\u6797\u8986\u76d6\u51cf\u5c11\u50cf\u7d20\u70b9\u3002", "a6253619508c6439a964eb01c5491c5b": "\u6c38\u4e45\u6027\u6ee5\u4f10\u7684\u9a71\u52a8\u56e0\u7d20", "87955f4ab5c7d87368cf925356bfc010": "\u539f\u751f\u6797", "ee6ea2c72cc24bed200cd75cf6fbf861": "\u79cd\u690d\u56ed", "490060aeb20eb89a53af0ff145bb2757": "\u53d8\u5316\u7684\u9a71\u52a8\u56e0\u7d20", "c2cc01feee9bd184b9ba8f6092dc4cae": "\u5168\u90e8\u68ee\u6797\u8986\u76d6", "c6e59c77d0b0e6b881a3e09d2fbd5276": "\u63a2\u7d22\u68ee\u6797\u548c\u51e0\u4e2a\u5173\u952e\u4e3b\u9898\u95f4\u7684\u5173\u7cfb\uff0c\u5bf9\u53ef\u6301\u7eed\u53d1\u5c55\u548c\u672a\u6765\u751f\u6001\u7cfb\u7edf\u7684\u5065\u5eb7\u90fd\u5341\u5206\u91cd\u8981\u3002", "52efcfdda819c6ec646503684eb52163": "\u6839\u636e FAO\uff0c{year} \u5e74 {location} \u7684\u91cd\u65b0\u9020\u6797\u7387\u4e3a\u6bcf\u5e74 {rate}\u3002", "4bc9ad3b1943f96b8c582b69e5065f2c": "\u5efa\u7acb\u60a8\u81ea\u5df1\u7684\u5206\u6790", "ca80caeb89b39d0e5575415e66f76151": "\u7c7b\u522b\u540d\u79f0", "ff2e824fab6b0c6b8ec95d4944850f63": "\u68ee\u6797\u6709\u52a9\u4e8e\u83b7\u5f97\u5145\u8db3\u3001\u6e05\u6d01\u7684\u6c34\uff0c\u5e76\u62b5\u5fa1\u6d2a\u6c34\u548c\u5e72\u65f1\u7b49\u81ea\u7136\u707e\u5bb3\uff0c\u662f\u4e00\u79cd\u5929\u7136\u7684\u3001\u5177\u6709\u6210\u672c\u6548\u76ca\u7684\u5b58\u5728\u3002", "ef17c085bae1494ee75017cffac9919f": "\u7814\u7a76\u5458", "0cf4718a538fec1b5f07ae24fe081e65": "\u6ce8\u610f\uff1a\u6b64\u529f\u80fd\u8ba1\u7b97\u591a\u8fb9\u5f62\u5185\u7684\u8b66\u62a5\u6216\u516c\u9877\u6570\uff1b\u56e0\u6b64\uff0c<strong>\u53ea\u652f\u6301\u591a\u8fb9\u5f62\u6570\u636e\uff0c</strong>\u4e0d\u652f\u6301\u70b9\u548c\u7ebf\u6570\u636e\u3002\u8bf7\u786e\u4fdd\u60a8\u7684\u6587\u4ef6\u53ea\u5305\u542b\u591a\u8fb9\u5f62\u6570\u636e\u3002\u5355\u6b21\u4e0a\u4f20\u6700\u591a\u53ef\u5206\u6790 1,000 \u5f20\u56fe\u7247\uff0c\u5305\u542b\u5728\u4e00\u4e2a\u5355\u5c42\u4e2d\u3002\u4e0d\u652f\u6301\u591a\u5c42\u3002", "4d5cfbd43a64e6efb6e8f3bc1960f691": "\u5f53\u524d\u663e\u793a", "eccd021ccbcfa3a1b05d0e418eda45bc": "\u6811\u6728\u8986\u76d6\u51a0\u5c42\u5bc6\u5ea6", "f8061c37e4e24eddc11acc631d07f71a": "\u81ea\u7136\u72b6\u6001", "6959713228c95f2348e8842f404e77a1": "\u67e5\u770b\u78b3\u6392\u653e\u7edf\u8ba1\u6570\u636e", "5c093457c17727425823cb2569a5cc62": "\u672c\u57fa\u672c\u5730\u56fe\u7cfb\u5217\u63d0\u4f9b\u5168\u7403\u8303\u56f4\u5185\u57fa\u672c\u5730\u7406\u7279\u5f81\u3001\u653f\u6cbb\u8fb9\u754c\u548c\u57fa\u7840\u8bbe\u65bd\u7684\u76f8\u5173\u4fe1\u606f\uff0c\u5e76\u4e3a\u4ea4\u4e92\u5f0f\u5730\u56fe\u4e0a\u663e\u793a\u7684\u6240\u6709\u6570\u636e\u96c6\u63d0\u4f9b\u91cd\u8981\u7684\u73af\u5883\u3002", "6a284670f61f7a4cec3c541cd6829871": "\u6570\u636e\u96c6\u7684\u51c6\u786e\u6027\u56e0\u7c7b\u522b\u548c\u5730\u7406\u4f4d\u7f6e\u800c\u5f02\u3002\u6bcf\u4e00\u7c7b\u7684\u5168\u5c40\u7cbe\u5ea6\u5982\u4e0b\u6240\u793a\uff1b\u300a\u8865\u5145\u8d44\u6599\u300b\u4e2d\u6709\u533a\u57df\u7cbe\u786e\u5ea6\u3002", "8ba30531e2a1792a3a359829c9acd063": "\u9605\u8bfb GFW \u535a\u5ba2\u4e0a\u5173\u4e8e\u68ee\u6797\u548c\u6c14\u5019\u7684\u5185\u5bb9\u3002", "90dd36fd39f266e4ef826608c030376f": "\u67e5\u770b\u5730\u56fe\u4e0a\u7684\u6570\u636e", "6a074a54ec8766e32ac076f4cf70c04a": "\u5305\u62ec\u725b\u8089\u3001\u5927\u8c46\u3001\u68d5\u6988\u6cb9\u3001\u7eb8\u6d46\u3001\u7eb8\u5f20\u3001\u80fd\u6e90\u548c\u77ff\u4ea7\u5728\u5185\u7684\u5927\u5b97\u5546\u54c1\u7684\u751f\u4ea7\uff0c\u662f\u68ee\u6797\u780d\u4f10\u7684\u4e3b\u8981\u539f\u56e0\u3002\u66f4\u52a0\u53ef\u6301\u7eed\u7684\u5546\u54c1\u751f\u4ea7\u5bf9\u4fdd\u62a4\u68ee\u6797\u548c\u51cf\u7f13\u6c14\u5019\u53d8\u5316\u81f3\u5173\u91cd\u8981\u3002", "678ac4abcf1c562ec774e04956ad550f": "\u60a8\u5e0c\u671b\u5728 GFW \u4e0a\u770b\u5230\u5176\u4ed6\u54ea\u4e9b\u6c14\u5019\u6570\u636e\u548c\u5206\u6790\uff1f", "6db9eb7a887a2f8691c7f2e84609e330": "\u7528\u6237\u51c6\u786e\u6027", "d6e86fc4af5572d0f5075cccd3b31a47": "\u4e94\u9879\u56e0\u7d20\u5b9a\u4e49\u5982\u4e0b\uff1a", "815f6a04015967b0c1cad6d3a2818b75": "\u5206\u4eab\u6b64\u663e\u793a\u677f", "4f84856af019e8e007a0b73f3fd87fec": "\u780d\u4f10\u8fc7\u7684\u6d41\u57df\u65e0\u6cd5\u9002\u5f53\u5730\u8fc7\u6ee4\u6c34\uff0c\u4e5f\u65e0\u6cd5\u4e3a\u4f9d\u8d56\u5b83\u4eec\u7684\u793e\u533a\u8c03\u8282\u4f9b\u6c34\u3002\u5982\u679c\u6ca1\u6709\u68ee\u6797\u6765\u56fa\u5b9a\u6ce5\u6c99\u5e76\u5728\u5730\u4e0b\u5f15\u5bfc\u964d\u6c34\uff0c\u5c31\u4f1a\u589e\u52a0\u4fb5\u8680\u3001\u6d2a\u6c34\u548c\u6ed1\u5761\u7684\u98ce\u9669\u3002\u780d\u4f10\u8fc7\u7684\u6d77\u5cb8\u66f4\u6613\u906d\u53d7\u98ce\u66b4\u6f6e\u548c\u6e14\u4e1a\u7684\u5f71\u54cd\u3002", "f1c7579c8aa5b203ed69fff74da04e94": "{location}\u4ece{startYear}\u81f3{endYear}\uff0c\u635f\u5931\u4e3b\u56e0\u662f{deforestation}\u7684\u5730\u533a<b>\u672a</b>\u51fa\u73b0\u6811\u6728\u8986\u76d6\u635f\u5931\u3002", "68a1239a6bca63010fec7bd7f1ad029c": "\u571f\u58e4\u6709\u673a\u78b3\u5bc6\u5ea6", "07d62aa19a9a95c07515769b604bad36": "\u4fc4\u7f57\u65af\u8054\u90a6", "6cf356ec4dad8e29574907c4271acefd": "\u5c42\u4fe1\u606f", "daa031cf7403bef061ebfbff92b5197a": "\u5168\u90e8\u9a71\u52a8\u56e0\u7d20", "af98e41b09bee1c0fb845ff955daff5e": "\u73cd\u53e4\u5fb7\u534f\u4f1a", "2f453cfe638e57e27bb0c9512436111e": "\u7ee7\u7eed", "24c9a02e63f81fc435e8af5f970c7c0c": "\u663e\u793a\u63d0\u793a", "7e6d11dd9dbeef53c1cb3cb896bce476": "\u5bc6\u5ea6", "c2be3ae8fc1a385232089307fe2316e6": "\u5b9e\u65f6\u76d1\u6d4b\u8fdb\u7a0b", "59a0b41c8c3b96d84b73561f0c306690": "\u60a8\u5e0c\u671b\u5728 GFW \u4e0a\u770b\u5230\u5176\u4ed6\u54ea\u4e9b\u4e0e\u6c34\u6709\u5173\u7684\u6570\u636e\u548c\u5206\u6790\uff1f", "4aaed930bd982db9c5fe5466e8032d92": "\u7531\u4e8e\u80fd\u591f\u5e2e\u52a9\u5438\u6536\u548c\u8c03\u8282\u5927\u6c14\u5c42\u78b3\u7684\u6811\u6728\u8d8a\u6765\u8d8a\u5c11\uff0c\u5bfc\u81f4\u5730\u7403\u6e29\u5ea6\u4e0a\u5347\uff0c\u6c14\u5019\u53d8\u5316\u5e26\u6765\u7684\u5f71\u54cd\u4e5f\u8d8a\u6765\u8d8a\u5927\u3002", "34bd9a78d9a5e9ea6bf24f80fd4442eb": "GFW\u7684\u6700\u65b0\u7814\u7a76\u548c\u89c1\u89e3", "8a43ee1fb7f210da40f8b78957e3de9b": "2010 \u5e74\uff0c {location}\u6709{extent}\u68ee\u6797\u8986\u76d6\uff0c \u8d85\u8fc7\u5176\u9646\u5730\u9762\u79ef\u7684{percentage}\u3002", "a644b7add07671e3b96325ba0b4d0ac6": "<strong>\u4eba\u5de5\u6797</strong><br>Transparent World \u5728 Global Forest Watch \u7684\u652f\u6301\u4e0b\uff0c\u5229\u7528\u536b\u661f\u56fe\u50cf\u7684\u76ee\u89c6\u5224\u8bfb\u7ed8\u5236\u4e86\u4eba\u5de5\u6797\u5730\u56fe\u3002\u7ed8\u5236\u7684\u4eba\u5de5\u6797\u5730\u56fe\u5c55\u793a\u4e86 2013/2014 \u5e74\u7684\u60c5\u51b5\uff0c\u9002\u7528\u4e8e\u5df4\u897f\u3001\u67ec\u57d4\u5be8\u3001\u54e5\u4f26\u6bd4\u4e9a\u3001\u5370\u5ea6\u5c3c\u897f\u4e9a\u3001\u5229\u6bd4\u91cc\u4e9a\u3001\u9a6c\u6765\u897f\u4e9a\u548c\u79d8\u9c81\u3002", "573b02b93f6221ad136d3695af3bfc60": "\u4e00\u6d41\u5e95\u56fe\u56fe\u5c42", "0ba8218cdf491a02ed9efd8e25f79b94": "\u6062\u590d\u548c\u4fdd\u62a4\u68ee\u6797\u6709\u52a9\u4e8e\u9884\u9632\u6d2a\u6c34\uff0c\u63d0\u9ad8\u5b89\u5168\u6027\u3002\u7531\u4e8e\u8fd9\u4e9b\u5173\u952e\u571f\u5730\u80fd\u591f\u5728\u7ecf\u6d4e\u3001\u73af\u5883\u548c\u516c\u5171\u536b\u751f\u65b9\u9762\u5e26\u6765\u76ca\u5904\uff0c\u51fa\u4e8e\u9632\u6d2a\u76ee\u7684\u6295\u8d44\u68ee\u6797\u9010\u6e10\u6210\u4e3a\u4e00\u79cd\u98ce\u6f6e\u3002", "1855ebb6505036646e82ea9b2533600d": " \u8fbe\u5361", "71342429994b9384c6af2103acc8ad4e": "\u8ba4\u8bc6\u53d7\u8ba9\u4eba\u548c\u7814\u7a76\u5458", "0936cc9aee5f06b8ca47d0c72681e813": "\u6bcf\u4e2a\u591a\u8fb9\u5f62\u90fd\u6807\u6709\u79cd\u690d\u7c7b\u578b\uff0c\u6761\u4ef6\u5141\u8bb8\u65f6\u8fd8\u6807\u6709\u7269\u79cd\u3002\u7c7b\u578b\u5b9a\u4e49\u5982\u4e0b\uff1a<br>- <strong>\u5927\u578b\u5de5\u4e1a\u4eba\u5de5\u6797\uff1a</strong> \u5355\u4e00\u4eba\u5de5\u6797\u9762\u79ef\u5927\u4e8e 100 \u516c\u9877<br>- <strong>\u4e2d\u578b\u4eba\u5de5\u6797\u7684\u9a6c\u8d5b\u514b\u591a\u8fb9\u5f62\uff1a</strong> \u79cd\u690d\u9762\u79ef &lt; 100 \u516c\u9877\u5e76\u6df7\u5408\u5728\u5176\u4ed6\u7528\u9014\u571f\u5730\u533a\u5757\u4e2d\u7684\u9a6c\u8d5b\u514b\u591a\u8fb9\u5f62 <br>- <strong>\u5c0f\u578b\u4eba\u5de5\u6797\u7684\u9a6c\u8d5b\u514b\u591a\u8fb9\u5f62\uff1a</strong> \u79cd\u690d\u9762\u79ef &lt; 10 \u516c\u9877\u5e76\u6df7\u5408\u5728\u5176\u4ed6\u7528\u9014\u571f\u5730\u533a\u5757\u4e2d\u7684\u9a6c\u8d5b\u514b\u591a\u8fb9\u5f62\u3002<br>- <strong>\u7a7a\u65f7\u5730/\u975e\u5e38\u5e74\u8f7b\u7684\u4eba\u5de5\u6797\uff1a</strong> \u4e00\u4e9b\u73af\u5883\u7ebf\u7d22\uff08\u5982\u7a7a\u5730\u7684\u5f62\u72b6\u6216\u6a21\u5f0f\u3001\u9760\u8fd1\u5176\u4ed6\u4eba\u5de5\u6797\u3001\u72ec\u7279\u7684\u9053\u8def\u7f51\u7b49\uff09\u8868\u660e\u88f8\u9732\u7684\u571f\u5730\u5c06\u6210\u4e3a\u4e00\u7247\u4eba\u5de5\u6797", "25d6bf0f7df077b0668edd7c99d55929": "\u68ee\u6797\u80fd\u4e3a\u4fdd\u6301\u5168\u7403\u53d8\u6696\u5347\u6e29\u4e0d\u8d85\u8fc7 2\u00b0C \u505a\u51fa 30% \u7684\u8d21\u732e\u3002", "ef2076a2f92471f2f62a8d7180b4d5f0": "\u5c06\u6587\u4ef6\u653e\u5728\u6307\u5b9a\u533a\u57df\u8fdb\u884c\u5206\u6790\u6216\u8ba2\u9605\u3002\u5efa\u8bae <strong>\u6587\u4ef6\u6700\u5927\u4e0d\u8981\u8d85\u8fc7 1MB\u3002</strong> \u5927\u4e8e\u6b64\u9650\u5236\u7684\u6587\u4ef6\u53ef\u80fd\u65e0\u6cd5\u6b63\u5e38\u5de5\u4f5c\u3002", "2ad89447c2b05c857926b0e8c4b11946": "FAO 2015 \u5e74\u7684\u6570\u636e\u663e\u793a{location}\u62e5\u6709{extent}\u68ee\u6797\uff0c\u5176\u4e2d\u539f\u751f\u6797\u5360\u8be5\u56fd\u7684{primaryPercent}\u3002", "7f6749b72263bc18c704d5564f3b2b96": "\u5230 2050 \u5e74\uff0c\u5168\u7403\u8fd1 20% \u7684\u4eba\u53e3\u5c06\u9762\u4e34\u6d2a\u6c34\u5a01\u80c1\u3002", "9639e32cab248434a17ab32237cb3b71": "\u5e94\u7528", "3803a2ef2a3b931e898087549a5f10ba": "\u622a\u6b62 {year} \u5728{location} \uff0c\u68ee\u6797\u8986\u76d6\u6392\u524d {count} \u7684\u5730\u533a\u5360\u5168\u90e8\u68ee\u6797\u8986\u76d6\u7684{percentage}\u3002 \u76f8\u6bd4\u4e8e\u5e73\u5747\u503c\u7684 {average}\uff0c{region} \u62e5\u6709\u6700\u9ad8\u7684 {value} \u76f8\u5bf9\u68ee\u6797\u8986\u76d6\u3002", "39d07cbea28587670f3a723fab9b377f": "\u53ef\u6301\u7eed\u68ee\u6797\u7ba1\u7406\u3001\u6539\u5584\u571f\u5730\u4f7f\u7528\u6743\u3001\u4fdd\u62a4\u548c\u6062\u590d\u68ee\u6797\u90fd\u662f\u4fdd\u62a4\u68ee\u6797\u3001\u5e94\u5bf9\u81ea\u7136\u6c14\u5019\u95ee\u9898\u7684\u826f\u597d\u89e3\u51b3\u65b9\u6848\u3002\u8fd9\u4e9b\u89e3\u51b3\u65b9\u6848\u53ef\u4ee5\u5728\u7ecf\u6d4e\u3001\u751f\u7269\u591a\u6837\u6027\u548c\u793e\u4f1a\u5c42\u9762\u4ea7\u751f\u79ef\u6781\u7684\u5f71\u54cd\u3002\u68ee\u6797\u76d1\u6d4b\u6570\u636e\u548c\u6280\u672f\u7684\u6539\u8fdb\u6709\u52a9\u4e8e\u8fd9\u4e9b\u89e3\u51b3\u65b9\u6848\u7684\u843d\u5b9e\u3002", "30e96050bfa658637f640a74b5e3c91a": "\u5766\u6851\u5c3c\u4e9a\u8054\u5408\u5171\u548c\u56fd", "4d36f7b2e9ddaae0c63394c1a4009297": "\u8bf7\u6ce8\u610f\uff0c\u8be5\u6570\u636e\u96c6\u65e8\u5728\u5168\u7403\u6216\u8f83\u5927\u533a\u57df\u8303\u56f4\u5185\u4f7f\u7528\uff0c\u56e0\u6b64\u5728\u67e5\u770b\u8f83\u5c0f\u533a\u57df\u6216\u7279\u5b9a\u5730\u7406\u533a\u57df\u65f6\u53ef\u80fd\u4f1a\u51fa\u73b0\u4e0d\u51c6\u786e\u4e4b\u5904\u3002GFW \u7684\u5168\u7403\u548c\u533a\u57df\u603b\u8ba1\u53cd\u6620\u7684\u662f\u57fa\u4e8e\u50cf\u7d20\u6570\u91cf\u9884\u8ba1\u7684\u9762\u79ef\u503c\uff0c\u800c\u4e0d\u662f\u57fa\u4e8e\u6837\u672c\u9884\u8ba1\u7684\u9762\u79ef\u503c\u3002\u5728\u5168\u7403\u548c\u533a\u57df\u8303\u56f4\u5185\uff0c\u5229\u7528\u50cf\u7d20\u8ba1\u6570\u6cd5\u9884\u4f30\u7684\u9762\u79ef\u503c\u5728\u57fa\u4e8e\u6837\u672c\u7684\u9762\u79ef\u9884\u4f30\u503c\u7684\u8bef\u5dee\u8303\u56f4\u5185\uff0c\u56e0\u6b64\u5730\u56fe\u8f93\u51fa\u6570\u636e\u53ef\u4ee5\u76f4\u63a5\u7528\u4e8e\u9762\u79ef\u8ba1\u7b97\u3002", "c87937beb2aaf8c5b58788b1327cc97a": "FAO \u68ee\u6797\u780d\u4f10", "fc4d6109da6e890892d2588aa73dce22": "\u51cf\u5c11\u70ed\u5e26\u68ee\u6797\u780d\u4f10\u7684\u653f\u6cbb\u610f\u613f\u4ece\u672a\u5982\u6b64\u5f3a\u70c8\u3002\u5404\u56fd\u6b63\u5728\u5c65\u884c\u627f\u8bfa\u5417\uff1f\u8bf7\u5728\u4e0b\u9762\u9009\u62e9\u4e00\u4e2a\u56fd\u5bb6\u8fdb\u884c\u67e5\u770b\u3002", "4b2fbfa9d5ef07f4dbbe7c096ab2c54d": "\u67e5\u770b\u6570\u636e", "1050131cdf4caa74ff797cb5e8e45162": "\u5546\u54c1\u76ee\u7684\u7684\u68ee\u6797\u780d\u4f10", "613e579185a5f009dbcf6602f1db8e99": "\u53d7\u8ba9\u4eba", "42e51d8db2859ad67bc43a92731a0b62": "\u7531\u4e8e\u6570\u636e\u5e93\u4e2d\u4f7f\u7528\u4e0d\u540c\u7684\u6570\u636e\u6e90\uff0c\u4e16\u754c\u571f\u58e4\u6570\u636e\u5e93\uff08Harmonized World Soil Database\uff09\u4e2d\u6240\u542b\u4fe1\u606f\u7684\u53ef\u9760\u6027\u5404\u4e0d\u76f8\u540c\u3002\u5317\u7f8e\u3001\u6fb3\u5927\u5229\u4e9a\u3001\u897f\u975e\u548c\u5357\u4e9a\u88ab\u8ba4\u4e3a\u4e0d\u592a\u53ef\u9760\uff0c\u800c\u4e2d\u90e8\u548c\u5357\u90e8\u975e\u6d32\u3001\u62c9\u4e01\u7f8e\u6d32\u548c\u52a0\u52d2\u6bd4\u3001\u4e2d\u6b27\u548c\u4e1c\u6b27\u7684\u53ef\u9760\u6027\u6700\u9ad8\u3002", "b9fd443ed362de766114855608af1803": "\u6811\u6728\u8986\u76d6\u635f\u5931\u7684\u5b9a\u4e49\u662f\u5927\u4e8e5\u7c73\u7684\u6797\u5206\u66f4\u66ff\u3002\u6811\u6728\u8986\u76d6\u635f\u5931\u6570\u636e\u96c6\u662f\u9a6c\u91cc\u5170\u5927\u5b66\u3001\u8c37\u6b4c\u3001\u7f8e\u56fd\u5730\u8d28\u52d8\u63a2\u5c40\u548c\u7f8e\u56fd\u56fd\u5bb6\u822a\u7a7a\u822a\u5929\u5c40\u7684\u5408\u4f5c\u9879\u76ee\uff0c\u4f7f\u7528Landsat\u536b\u661f\u56fe\u50cf\u4ee530 \u00d7 30\u7c73\u7684\u5206\u8fa8\u7387\u7ed8\u5236\u5e74\u5ea6\u6811\u6728\u8986\u76d6\u635f\u5931\u56fe\u3002", "4aa17abbdfb89d86ee3d7830ded2f4ea": "\u5728\u6709\u4eba\u5de5\u6797\u6570\u636e\u7684\u60c5\u51b5\u4e0b\uff0c\u672a\u88abIFLs\u6216\u4eba\u5de5\u6797\u8986\u76d6\u7684\u533a\u57df\u88ab\u89c6\u4e3a\u201c\u9000\u5316\u68ee\u6797\u201d\u3002", "1e09da7365e827d5eec3342702fa9b7f": "\u780d\u4f10\u68ee\u6797\u635f\u5bb3\u6d41\u57df\u5065\u5eb7\uff0c\u589e\u52a0\u6d2a\u6c34\u548c\u5e72\u65f1\u7684\u98ce\u9669\u3002\u6c14\u5019\u53d8\u5316\u52a0\u5267\u7684\u66f4\u9891\u7e41\u548c\u66f4\u4e25\u91cd\u7684\u68ee\u6797\u706b\u707e\u4f1a\u6c61\u67d3\u6c34\u6e90\u3001\u964d\u4f4e\u68ee\u6797\u8986\u76d6\u7387\u5e76\u6467\u6bc1\u793e\u533a\u3002", "e0fd6fbde078d23262895d86ec96f066": "2001\u5e74\u52302012\u5e74\uff0c {location}\u7684\u6811\u6728\u8986\u76d6\u9762\u79ef\u589e\u52a0\u4e86{gain}\u3002", "7ed6f742d3d1bff0375139ac02e6b14e": "\u82f1\u56fd\u96e8\u6797\u57fa\u91d1\u4f1a", "1aa31af738ecd1e6519d4ea2eb4112b4": "\u67e5\u770b\u751f\u7269\u91cf\u5bc6\u5ea6\u548c\u635f\u8017\u3001\u6392\u653e\u91cf\u7b49\u3002", "e8392e473f60bd31e46e25dca917c36d": "\u8d44\u52a9\u91d1\u548c\u7814\u7a76\u57fa\u91d1", "c89ae42b629addc6274d45c5b30077a0": "\u5728{location}\u4e2d\uff0c\u524d {percentileLength}\u5730\u533a\u5bfc\u81f4\u4e86{startYear}\u548c{endYear}\u4e4b\u95f4\u6240\u6709\u6811\u8986\u76d6\u7387\u635f\u5931\u7684{topLoss}\u3002 \u4e0e\u5e73\u5747\u503c{average}\u76f8\u6bd4\uff0c{region}\u5730\u533a\u7684\u6811\u8986\u76d6\u7387\u635f\u5931\u76f8\u5bf9\u6700\u5927\uff0c\u4e3a{value}\u3002", "82db7a44f8d50e73cbf62986859f1711": "\u9009\u62e9\u4e00\u4e2a\u533a\u57df", "478577caa5d2e6eb7f7845ed70d7d510": "\u8f6c\u5230Pro\u7248", "b0667f833d46222e231e2b7d440b3ce2": "\u663e\u793a\u4eba\u5de5\u6797\u5185\u5916\u9010\u5e74\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u3002\u79cd\u690d\u56ed\u5185\u7684\u635f\u5931\u53ef\u88ab\u89c6\u4e3a\u79cd\u690d\u56ed\u6536\u83b7\uff0c\u800c\u79cd\u690d\u56ed\u5916\u7684\u635f\u5931\u901a\u5e38\u662f\u5929\u7136\u6797\u635f\u5931\u3002", "dc141ae746b4ce4bc6e7bdf8c5d622e2": "\u68ee\u6797\u5bf9\u4e8e\u4e3a\u4e16\u754c\u5404\u5730\u63d0\u4f9b\u6e05\u6d01\u548c\u5145\u8db3\u7684\u6c34\u81f3\u5173\u91cd\u8981\u3002\u5065\u5eb7\u7684\u68ee\u6797\u53ef\u4ee5\u8fc7\u6ee4\u6c34\u3001\u51cf\u5c11\u4fb5\u8680\u3001\u8c03\u8282\u964d\u96e8\u3001\u8865\u7ed9\u5730\u4e0b\u6c34\u4f4d\u3001\u5e76\u4e14\u7f13\u51b2\u5e72\u65f1\u548c\u6d2a\u6c34\u7684\u5f71\u54cd\u3002\u6cbf\u6d77\u68ee\u6797\u5728\u4fdd\u62a4\u6d77\u6d0b\u514d\u53d7\u5de8\u6d6a\u4fb5\u88ad\u65b9\u9762\u5c24\u5176\u91cd\u8981\uff0c\u662f\u6d77\u6d0b\u751f\u7269\u7684\u91cd\u8981\u7e41\u6b96\u5730\u3002", "fa82085aca4b8fbbdaa2b34b541be4ac": "\u751f\u4ea7\u8005\u7684\u51c6\u786e\u6027", "fefe83ff5dd59430573663a423247844": "\u53d7\u635f\u72b6\u6001", "34e8db6c9bd617c05757c62c48cf469e": "\u4e3a\u4e86\u8ba1\u7b97\u8868\u5c42\u571f\u58e4\u6709\u673a\u78b3\u5bc6\u5ea6\uff0c\u6211\u4eec\u4f7f\u7528\u6765\u81ea\u4e16\u754c\u571f\u58e4\u6570\u636e\u5e93\uff08HWSD\uff09\u7684\u6570\u636e\uff0c\u8be5\u6570\u636e\u5e93\u7531\u56db\u4e2a\u571f\u58e4\u6570\u636e\u5e93\u6c47\u7f16\u800c\u6210\uff1a\u6b27\u6d32\u571f\u58e4\u6570\u636e\u5e93\uff08ESDB\uff09\uff0c\u4e2d\u56fd\u76841\uff1a1\u767e\u4e07\u571f\u58e4\u5730\u56fe\uff0c\u5404\u79cd\u5730\u533aSOTER\u6570\u636e\u5e93\uff08 SOTWIS\u6570\u636e\u5e93\uff09\u548c\u4e16\u754c\u571f\u58e4\u5730\u56fe\u3002HWSD\u5305\u542b\u6709\u5173\u571f\u58e4\u53c2\u6570\u7684\u4fe1\u606f\uff0c\u4f8b\u5982\u6709\u673a\u78b3\uff0cpH\uff0c\u50a8\u6c34\u91cf\uff0c\u571f\u58e4\u6df1\u5ea6\uff0c\u53ef\u4ea4\u6362\u603b\u517b\u5206\u548c\u603b\u76d0\u5ea6\u3002\u957f\u671f\u4ee5\u6765\uff0c\u4eba\u4eec\u4e00\u76f4\u8ba4\u4e3a\u571f\u58e4\u78b3\u4f30\u7b97\u503c\u548c\u603b\u4f53\u571f\u58e4\u4fe1\u606f\u5177\u6709\u9ad8\u5ea6\u4e0d\u786e\u5b9a\u6027\uff0c\u800cHWSD\u901a\u8fc7\u5c06\u5168\u7403\u533a\u57df\u548c\u56fd\u5bb6\u7684\u73b0\u6709\u571f\u58e4\u4fe1\u606f\u6574\u5408\u4e3a\u7edf\u4e00\u683c\u5f0f\uff0c\u53d6\u5f97\u4e86\u91cd\u5927\u8fdb\u6b65\u3002\u76ee\u524d\uff0c\u8be5\u6570\u636e\u96c6\u5efa\u6784\u4e86\u5927\u591a\u6570\u5730\u533a\u53ef\u83b7\u5f97\u7684\u6700\u4f73\u7a7a\u95f4\u660e\u6670\u571f\u58e4\u78b3\u6570\u636e\u3002\u6570\u636e\u7684\u7a7a\u95f4\u5206\u8fa8\u7387\u4e3a1\u516c\u91cc\u3002", "7308cfeec12685b72fcf123ee193e5a8": "\u9605\u8bfb\u535a\u5ba2", "e773dddca24e7c9367bea4aff79d872d": "\u6570\u5343\u5e74\u6765\uff0c\u4e16\u754c\u5404\u5730\u7684\u793e\u4f1a\u90fd\u4f9d\u8d56\u9644\u8fd1\u7684\u68ee\u6797\u6765\u83b7\u53d6\u98df\u7269\u3001\u71c3\u6599\u548c\u836f\u7269\u3002\u4f20\u7edf\u65b9\u5f0f\uff08\u5982\u519c\u6797\u590d\u5408\u7ecf\u8425\u548c\u5c0f\u89c4\u6a21\u79fb\u52a8\u519c\u4e1a\uff09\u5bf9\u5468\u56f4\u73af\u5883\u7684\u5f71\u54cd\u8f83\u5c0f\uff0c\u5e76\u4e3a\u5f53\u5730\u793e\u533a\u5e26\u6765\u4e86\u793e\u4f1a\u7ecf\u6d4e\u6548\u76ca\u3002", "54e1d44609e3abed11f6e1eb6ae54988": "\u9879\u76ee", "5fe795938527786e776711a19a23315f": "\u544a\u8bc9\u6211\u4eec\uff01", "8bf45d8adc3927f0b33b0b0ffe9ffefd": "\u8f93\u5165\u641c\u7d22", "c496ce60525c6e406625074dd73434d4": "\u516c\u53f8\u548c\u91d1\u878d\u673a\u6784\u6709\u6548\u7ba1\u7406\u5546\u54c1\u4f9b\u5e94\u94fe\u4e2d\u7684\u6bc1\u6797\u98ce\u9669\u7684\u65b0\u5e94\u7528\u7a0b\u5e8f\u3002", "f9d7a34f5ef6d055be88baee2b0e3720": "\u968f\u7740\u4eba\u4eec\u5bf9\u5927\u5b97\u5546\u54c1\u9700\u6c42\u7684\u589e\u957f\uff0c\u5de5\u4e1a\u89c4\u6a21\u7684\u519c\u4e1a\u9020\u6210\u68ee\u6797\u780d\u4f10\u3001\u975e\u6cd5\u91c7\u4f10\u6728\u6750\u548c\u91c7\u77ff\u6d3b\u52a8\u589e\u52a0\u3002\u7531\u4e8e\u65e0\u6cd5\u8ffd\u8e2a\u4ea7\u54c1\u7684\u6765\u6e90\uff0c\u4ee5\u53ca\u7f3a\u4e4f\u5bf9\u73af\u5883\u8f93\u51fa\u7684\u5f71\u54cd\uff0c\u56e0\u6b64\u5f88\u96be\u904f\u5236\u8fd9\u4e9b\u884c\u4e1a\u6240\u5e26\u6765\u7684\u540e\u679c\u3002", "c3645bef354ff8b1724b5be410fa1fe0": "\u6839\u636eFAO\u7684\u8bf4\u6cd5\uff0c{year}\u4e2d{location}\u68ee\u6797\u780d\u4f10\u901f\u7387\u4e3a\u6bcf\u5e74{rate}\u3002", "469021feb2da0b4f481cd013514b8b6a": "\u5546\u54c1\u5f15\u53d1\u7684\u68ee\u6797\u780d\u4f10\u548c\u57ce\u5e02\u5316\u7c7b\u522b\u4ee3\u8868\u6c38\u4e45\u6027\u7684\u68ee\u6797\u780d\u4f10\uff0c\u800c\u53d7\u5176\u4ed6\u7c7b\u522b\u5f71\u54cd\u7684\u6811\u6728\u8986\u76d6\u7ecf\u5e38\u4f1a\u91cd\u65b0\u751f\u957f\u3002\u8be5\u6570\u636e\u96c6\u5e76\u6ca1\u6709\u6807\u660e\u6811\u6728\u8986\u76d6\u635f\u5931\u53d1\u751f\u540e\u571f\u5730\u8986\u76d6\u7684\u7a33\u5b9a\u6027\u6216\u72b6\u51b5\uff0c\u4e5f\u6ca1\u6709\u533a\u5206\u81ea\u7136\u91ce\u706b\u548c\u4eba\u4e3a\u91ce\u706b\u3002", "5ddd782548b67ded15a16b99a849260d": "{location}\u4ece{startYear}\u81f3{endYear}\uff0c\u53d1\u751f\u7684{permPercent}\u7684\u6811\u6728\u8986\u76d6\u635f\u5931\u7684\u4e3b\u56e0\u662f{deforestation}\u3002", "eb0e52c48be3fcc1366eb8db8be4a62b": "\u6062\u590d\u72b6\u6001", "0185a3e9c1aba17ad36e584b0aeed1dc": "\u663e\u793a\u6240\u9009\u533a\u57df\u4e2d\u7684\u6811\u6728\u8986\u76d6\u7387\u635f\u5931\uff082001\u5e74 - \u73b0\u5728\uff09\u4e0e\u5176\u4ed6\u533a\u57df\u7684\u6bd4\u8f83\u3002", "4dd2f7814593ce055f5ea203f6839cb9": "\u5229\u7528 GFW Pro", "98913e60524fded284f1ff17a0cbff63": "\u67e5\u770b\u5546\u54c1\u751f\u4ea7\u533a\u57df\u3001\u6797\u6728\u690d\u88ab\u6d41\u5931\u7b49\u76f8\u5173\u4fe1\u606f\u3002", "9c2756d530e86aa08795910d01f998b6": "\u6700\u5c0fTCC\u5bc6\u5ea6\u7684\u8c03\u6574\u53ea\u4f1a\u5f71\u54cd\u6811\u6728\u8986\u76d6\u7387\u548c\u6811\u6728\u8986\u76d6\u7387\u635f\u5931\u6570\u636e\u5c42\u3002\u6b64\u529f\u80fd\u4e0eHansen/UMD/Google/USGS/NASA\u6811\u6728\u8986\u76d6\u589e\u76ca\u6216\u5176\u4ed6GFW\u6570\u636e\u5c42\u6216\u7edf\u8ba1\u4fe1\u606f\u65e0\u5173\u3002\u6811\u6728\u7684\u8986\u76d6\u589e\u76ca\u4ee5\u5927\u4e8e50\uff05\u7684\u56fa\u5b9a\u6700\u5c0fTCC\u5bc6\u5ea6\u663e\u793a\u3002", "2668735531776127f506efa07fb33277": "\u5168\u7403\u5730\u4e0a\u5b58\u6d3b\u6797\u6728\u751f\u7269\u91cf", "07830c670cb93fdd17db78f569dcad73": "\u663e\u793a\u6240\u9009\u533a\u57df\u4e2d\u6309\u6811\u79cd\u6216\u7c7b\u578b\u5212\u5206\u7684\u4eba\u5de5\u6797\u8303\u56f4\u3002", "bdbed95741cdbf8702cde55f302c42b1": "\u67e5\u770b\u6700\u8fd1\u7684\u68ee\u6797\u780d\u4f10\u8b66\u62a5\u548c\u536b\u661f\u56fe\u50cf\uff0c\u5e76\u8ba2\u9605\u8b66\u62a5\u3002", "3cb5c2204a3d795d9ff3004a86f7297e": "\u5b8c\u6574\u68ee\u6797\u666f\u89c2\uff08IFL\uff09\u6570\u636e\u96c6\u786e\u5b9a\u4e86\u68ee\u6797\u8303\u56f4\u5185\u81ea\u7136\u751f\u6001\u7cfb\u7edf\u7684\u5e7f\u9614\u8303\u56f4\uff0c\u8fd9\u4e9b\u8303\u56f4\u5185\u6ca1\u6709\u663e\u793a\u51fa\u660e\u663e\u7684\u4eba\u7c7b\u6d3b\u52a8\u8ff9\u8c61\uff0c\u5e76\u4e14\u8db3\u591f\u5927\uff0c\u53ef\u4ee5\u4fdd\u7559\u6240\u6709\u672c\u5730\u751f\u7269\u591a\u6837\u6027\uff0c\u5305\u62ec\u5927\u8303\u56f4\u7269\u79cd\u7684\u6210\u6d3b\u79cd\u7fa4\u3002IFL\u662f\u901a\u8fc7\u5bf9Landsat\u56fe\u50cf\u7684\u89c6\u89c9\u68c0\u67e5\uff0c\u4f7f\u7528\u4e00\u7ec4\u5927\u5c0f\u548c\u8ddd\u79bb\u6807\u51c6\u7ed8\u5236\u7684\u3002\u8be5\u5206\u6790\u4f7f\u7528\u622a\u81f32013\u5e74\u7684IFL\u8303\u56f4\u3002", "c98ea8c899cb2d24208dfc334cc9f5ee": "\u76f8\u5173\u5de5\u5177", "eeddbbf8e8c22d7468ae00705da6ea0d": "\u6811\u6728\u8986\u76d6\u635f\u5931\u4e0e\u5176\u4ed6\u5730\u533a\u6bd4\u8f83", "9504721b68c2151ccf4debc31dafc1e8": "\u5728 GFW \u535a\u5ba2\u4e0a\u9605\u8bfb\u6709\u5173\u68ee\u6797\u548c\u5546\u54c1\u7684\u5185\u5bb9\u3002", "68a8d5414a5a0cb9b257cfd7870b0624": "\u4f7f\u7528\u81ea\u5b9a\u4e49\u6570\u636e\u96c6\u4e0b\u8f7d\u5668\uff0c\u67e5\u627e\u4e0e\u68ee\u6797\u548c\u6c14\u5019\u76f8\u5173\u7684\u4fe1\u606f\u3002", "cad153ecca62236d046ab09ee6742c35": "\u622a\u81f3{extentYear}\uff0c{location}\u62e5\u6709{extent}\u7684\u6811\u6728\u8986\u76d6\u8303\u56f4\uff0c\u76f8\u5f53\u4e8e\u571f\u5730\u9762\u79ef\u7684{landPercentage}\u4ee5\u53ca\u5168\u7403\u603b\u9762\u79ef\u7684{globalPercentage}\u3002", "6e0321c9fe5c0e0ed99c354564256e65": "\u538b\u7f29\uff1a.shp\uff08\u538b\u7f29\u7684\u5f62\u72b6\u6587\u4ef6\u5fc5\u987b\u5305\u542b .shp\u3001.shx\u3001.dbf \u548c .prj \u6587\u4ef6\uff09", "1332da1bff30f5cd21cfba1de0005554": "\u5927\u6570\u636e\u6c14\u5019\u6311\u6218", "fcc69fecd216cf7391c4ec921aa63a5b": "\u82f1\u56fd", "ccdcb576a303e8c560c0df6f66a8b199": "FAO \u68ee\u6797\u8986\u76d6", "a1197766a1c7f13e00990153e0a59e40": "\u5916\u4ea4\u90e8", "f0dc0da88df27f76f44afbfacb9c0dd6": "\u5546\u54c1\u751f\u4ea7\u7684\u4e0d\u53ef\u6301\u7eed\u6027\u6269\u5f20\u4f1a\u6c38\u4e45\u7834\u574f\u751f\u6001\u7cfb\u7edf\uff0c\u53d6\u4ee3\u533a\u57df\u7fa4\u843d\uff0c\u52a0\u5267\u6c14\u5019\u53d8\u5316\u5e76\u52a0\u901f\u751f\u7269\u591a\u6837\u6027\u7684\u4e27\u5931\u3002", "946523c5340c54ed02f5d04840c289e0": "\u60a8\u8fd8\u60f3\u5728 GFW \u4e0a\u770b\u5230\u54ea\u4e9b\u5546\u54c1\u6570\u636e\u548c\u5206\u6790\uff1f", "5b50673f642771cbdbba0d20dff8dfae": "\u6eda\u52a8\u67e5\u627e", "91280c72e717e52c82196d404556fb33": "\u8d8a\u5357", "aaf91962447200faaeb14f0f6a9c6e72": "\u663e\u793a\u9009\u5b9a\u533a\u57df\u4e2d\u5b8c\u6574\u68ee\u6797\u7684\u8303\u56f4\uff0c\u6b64\u5904\u8303\u56f4\u7684\u5b9a\u4e49\u662f\u6811\u6728\u8986\u76d6\u4e0e\u5b8c\u6574\u68ee\u6797\u666f\u89c2\uff08IFL\uff09\u7684\u91cd\u53e0\u90e8\u5206\u3002", "127d0e1929391a965f6995fbef1f9b42": "\u7ecf\u56fd\u9645\u5e94\u7528\u7cfb\u7edf\u5206\u6790\u7814\u7a76\u6240\uff08IIASA\uff09\u8bb8\u53ef\u4f7f\u7528", "de1f4a33206621dc032a9a982507420d": "<strong>\u6797\u6728\u690d\u88ab</strong> <br>\u6797\u6728\u690d\u88ab\u6307\u6240\u6709\u9ad8\u5ea6\u8d85\u8fc7 5 \u7c73\u7684\u690d\u88ab\u3002\u6797\u6728\u690d\u88ab\u6570\u636e\u96c6\u7531\u9a6c\u91cc\u5170\u5927\u5b66\u3001Google\u3001USGS \u548c NASA \u5171\u540c\u7f16\u5236\uff0c\u901a\u8fc7\u4f7f\u7528 Landsat \u536b\u661f\u56fe\u50cf\u4ee5 30 \u7c73\u7684\u5206\u8fa8\u7387\u5bf9 2000 \u81f3 2010 \u5e74\u95f4\u7684\u5168\u7403\u6797\u6728\u690d\u88ab\u8fdb\u884c\u7ed8\u5236\u3002\u8bf7\u6ce8\u610f\uff0c\u201c\u6797\u6728\u690d\u88ab\u201d\u662f\u6811\u6728\u7684\u751f\u7269\u7269\u7406\u5b66\u5b58\u5728\uff0c\u53ef\u4ee5\u4ee5\u5929\u7136\u6797\u6216\u4eba\u5de5\u6797\u7684\u5f62\u5f0f\u5b58\u5728\u4e8e\u5728\u8f83\u5927\u7684\u6797\u51a0\u5bc6\u5ea6\u8303\u56f4\u5185\u3002", "9735ab8ce531d5d5f5dd7e6d38c1604d": "\u97e9\u56fd", "41be7dfa27a09cd539eb79b44c30998a": "\u68ee\u6797\u4ece\u5927\u6c14\u4e2d\u5438\u9644\u5e76\u50a8\u5b58\u78b3\uff0c\u8fd9\u662f\u7f13\u89e3\u6c14\u5019\u53d8\u5316\u6700\u7ecf\u6d4e\u6709\u6548\u7684\u65b9\u6cd5\u4e4b\u4e00\u3002\u68ee\u6797\u7684\u6d41\u5931\u6216\u9000\u5316\u964d\u4f4e\u4e86\u5176\u51c0\u5316\u6392\u653e\u7269\u7684\u80fd\u529b\u3002", "c0c98905152f6b5667e3e049d51fee02": "{region}\u7684\u6700\u5927\u76f8\u5bf9\u79cd\u690d\u9762\u79ef\u4f4d\u4e8e{location}\uff0c\u5360\u6bd4{percentage}\uff0c\u5176\u4e2d\u5927\u90e8\u5206\u4e3a{topType}\u3002", "aae425097365f086b6655d917328a214": "\u9009\u62e9\u60a8\u60f3\u63a2\u7d22\u7684\u5730\u533a", "1a330808634d37acce6d3c6a93160c59": "\u4f34\u968f\u519c\u4e1a\u7528\u5730\u7684\u5f00\u57a6\uff0c\u4ee5\u53ca\u5546\u54c1\u751f\u4ea7\u3001\u57ce\u5e02\u5316\u3001\u75be\u75c5\u548c\u68ee\u6797\u706b\u707e\u7b49\uff0c\u68ee\u6797\u4ece\u5927\u6c14\u4e2d\u5438\u78b3\u7684\u80fd\u529b\u5c06\u5927\u6253\u6298\u6263\u3002\u5f53\u6811\u6728\u71c3\u70e7\u6216\u8150\u70c2\u65f6\uff0c\u5176\u50a8\u5b58\u7684\u78b3\u4f1a\u91ca\u653e\u5230\u5927\u6c14\u4e2d\uff0c\u8fdb\u800c\u52a0\u5267\u6c14\u5019\u53d8\u5316\u3002", "0e3b69c67761a32d0fdc7e881e9223a9": "FAO \u83f2\u5f8b\u5bbe\u68ee\u6797\u8986\u76d6", "56a7cae060e66911760f0c853b74ebae": "<strong>\u539f\u59cb\u68ee\u6797\u666f\u89c2</strong> <br>\u663e\u793a\u6240\u9009\u533a\u57df\u4e2d\u539f\u59cb\u68ee\u6797\u7684\u8303\u56f4\uff0c\u6b64\u5904\u662f\u6307\u622a\u81f3 2010 \u5e74\u6797\u6728\u690d\u88ab\u4e0e\u539f\u59cb\u68ee\u6797\u666f\u89c2\uff08IFL\uff09\u7684\u91cd\u53e0\u60c5\u51b5\u3002", "4be281f13e0ca1c43364f683c90cd43c": "\u4f0a\u6717\uff08\u4f0a\u65af\u5170\u5171\u548c\u56fd\uff09", "e2f4f6f5a18c36c84c5324233c70e711": "\u622a\u6b62{year}\uff0c\u5728{percentage}\uff0c {location}\u7684\u571f\u5730\u8986\u76d6\u4e3a\u6797\u6728\u690d\u88ab\u3002", "40eeacb8300fd23af8a6dad81f652841": "2015 \u5e74\u7684 FAO \u6570\u636e\u663e\u793a\uff0c{extent}\u7684\u68ee\u6797\u89c4\u6a21\u4e3a{location}\uff0c\u5176\u4e2d\u539f\u59cb\u68ee\u6797\u5360\u4e16\u754c\u7684{primaryPercent}\u3002", "9270cd8ea939efafafc2dfd439f67bbb": "<strong>\u652f\u6301\u7684\u6587\u4ef6\u683c\u5f0f\u5217\u8868</strong>\uff1a", "e7a266a15d5539c7459732d74755043a": "\u67e5\u627e\u5168\u7403\u6709\u5173\u78b3\u548c\u6392\u653e\u95ee\u9898\u7684\u7b54\u6848\uff0c\u6309\u56fd\u5bb6\u6216\u56fd\u5bb6\u5185\u5730\u65b9\u641c\u7d22", "8ca469fecab8734ec6c3201748403906": "Hansen/UMD/Google/USGS/NASA\uff0c2000 \u5e74\u6797\u6728\u8986\u76d6\u5ea6", "5adc8b14ffee6f8cdb7b1014c14d573b": "\u68ee\u6797\u63d0\u4f9b\u4e86\u51cf\u5c11\u5927\u6c14\u4e2d\u78b3\u5143\u7d20\u7684\u81ea\u7136\u89e3\u51b3\u65b9\u6848\u3002\u68ee\u6797\u5438\u6536\u3001\u50a8\u5b58\u4eba\u7c7b\u71c3\u70e7\u7164\u3001\u5929\u7136\u6c14\u548c\u77f3\u6cb9\u7b49\u8fd9\u7c7b\u5316\u77f3\u71c3\u6599\u7b49\u6d3b\u52a8\u4ea7\u751f\u7684\u78b3\u6392\u653e\u3002", "8ad7037ebfa4e38d163ebcc86890a31f": "\u5929\u7136\u6797", "c3591bfc7f4c72eda6e374599395bca0": "\u632a\u5a01\u653f\u5e9c", "1a0a5dcd8ebf725c952c67bb270f72e0": "\u83f2\u5f8b\u5bbe\u7684\u539f\u59cb\u68ee\u6797", "8644188a91d1b8f041f1c121931dbb42": "\u5206\u4eab\u5c0f\u5de5\u5177", "714043c476544b8c5a8cdd7476286faf": "\u8c03\u67e5\u548c\u76d1\u6d4b\u5546\u4e1a\u751f\u4ea7\u533a\u57df", "af82e229389486e08a5806301c049521": "\u5728{location}\uff0c2001\u5e74\u81f32012\u5e74\u671f\u95f4\u524d{percentileLength}\u533a\u57df\u5185\u7684\u6811\u6728\u8986\u76d6\u589e\u957f\u5360\u636e\u4e86\u603b\u589e\u957f\u91cf\u7684{topGain}\u3002{region}\u5728{value}\u5904\u7684\u6811\u6728\u8986\u76d6\u7387\u589e\u5e45\u6700\u5927\uff0c\u800c\u5e73\u5747\u503c\u4e3a{average}\u3002", "30b090a565a8a024bb767690e750fc04": "40%\u7684\u5168\u7403\u6bc1\u6797\u90fd\u662f\u7531\u5546\u4e1a\u9a71\u52a8\u7684\u3002", "1e1776132e2d42a5abfdd13604e7a38f": "\u68ee\u6797\u3001\u6811\u6728\u548c\u519c\u6797\u4e1a", "f003f670c6e88678bb442e0fd1a2691d": "\u571f\u58e4\u6709\u673a\u78b3(SOC)\u662f\u571f\u58e4\u6709\u673a\u8d28\u7684\u91cd\u8981\u7ec4\u6210\u90e8\u5206\uff0c\u5b83\u6765\u6e90\u4e8e\u571f\u58e4\u4e2d\u6b8b\u7559\u3001\u5206\u89e3\u7684\u52a8\u690d\u7269\u7269\u8d28\u3002\u81ea\u7136\u56e0\u7d20\uff08\u5982\u571f\u5730\u8986\u76d6\u3001\u690d\u88ab\u3001\u5730\u5f62\u548c\u6c14\u5019\uff09\u4ee5\u53ca\u4eba\u4e3a\u56e0\u7d20\uff08\u5982\u571f\u5730\u5229\u7528\u548c\u7ba1\u7406\uff09\u53ef\u4ee5\u5f71\u54cd\u571f\u58e4\u4e2d\u6709\u673a\u8d28\u7684\u6570\u91cf\uff0c\u4ece\u800c\u5f71\u54cd\u571f\u58e4\u4e2d\u7684\u6709\u673a\u78b3\u3002", "80581ac3f94d5061f51c59798bcc8163": "\u8fd9\u7ec4\u6570\u636e\u57fa\u4e8e\u8fd15000\u4e2a\u6837\u672c\u70b9\u548c\u57fa\u4e8e\u6811\u6728\u8986\u76d6\u3001\u6811\u6728\u8986\u76d6\u51cf\u5c11\u3001\u6811\u6728\u8986\u76d6\u589e\u52a0\u3001\u4eba\u53e3\u5bc6\u5ea6\u3001\u571f\u5730\u8986\u76d6\u548c\u706b\u707e\u6570\u636e\u5efa\u7acb\u7684\u6a21\u578b\uff0c\u63ed\u793a\u4e8610\u516c\u91cc\u8fb9\u957f\u7684\u7f51\u683c\u5355\u5143\u5185\u6811\u6728\u8986\u76d6\u51cf\u5c11\u7684\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\u3002\u7136\u540e\u5c06\u6bcf\u4e2a\u5355\u5143\u7684\u4e3b\u8981\u9a71\u52a8\u56e0\u7d20\u4e0e\u6bcf\u5e74\u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u91cf\u76f8\u7ec4\u5408\uff0c\u8ba1\u7b97\u5904\u8fd9\u91cc\u663e\u793a\u7684\u7edf\u8ba1\u6570\u636e\u3002\u5728\u4e00\u6bb5\u65f6\u95f4\u5185\u6811\u6728\u8986\u76d6\u51cf\u5c11\u91cf\u5c0f\u4e8e0.5%\u7684\u7f51\u683c\u5355\u5143\u6ca1\u6709\u8fdb\u884c\u7c7b\u522b\u5206\u914d\uff0c\u4e5f\u6ca1\u6709\u5728\u8fd9\u4e9b\u7edf\u8ba1\u6570\u636e\u4e2d\u5c55\u793a\u3002", "552a4b92c86818e7d65faaf1ef7c3217": "\u6811\u6728\u8986\u76d6\u5b9a\u4e49\u4e3a\u6307\u622a\u81f32010\u5e74\uff0c\u6240\u6709\u9ad8\u5ea6\u8d85\u8fc75\u7c73\u7684\u690d\u88ab\u3002\u6811\u6728\u8986\u76d6\u6570\u636e\u662f\u9a6c\u91cc\u5170\u5927\u5b66\u3001Google\u3001USGS\u548c NASA \u7684\u5408\u4f5c\u6210\u679c\uff0c\u4f7f\u7528\u4e86\u9646\u5730\u536b\u661f\u56fe\u50cf\uff0c\u7ed8\u5236\u4e862000\u5e74\u548c2010\u5e7430\u7c73\u5206\u8fa8\u7387\u7684\u5168\u7403\u6811\u6728\u8986\u76d6\u56fe\u3002\u8bf7\u6ce8\u610f\uff0c\u201c\u6811\u6728\u8986\u76d6\u201d\u662f\u6307\u6811\u6728\u7684\u751f\u7269\u7269\u7406\u5b58\u5728\uff0c\u53ef\u80fd\u4ee5\u5929\u7136\u6797\u6216\u4eba\u5de5\u6797\u7684\u5f62\u5f0f\u5b58\u5728\uff0c\u5177\u6709\u4e0d\u540c\u7684\u6797\u51a0\u5bc6\u5ea6\u3002", "7595bdc53281342ab0036c4eb0bc809c": "\u641c\u7d22 | Global Forest Watch", "a0597801f90eb9ebaf1e4cc26eae0015": "\u81ea {startYear} \u5e74\u8d77\u81f3 {endYear} \u5e74\u4e3a\u6b62\uff0c{location} \u7684\u6797\u6728\u8986\u76d6\u8303\u56f4\u603b\u8ba1\u635f\u5931 {loss}\uff0c\u76f8\u5f53\u4e8e\u81ea {extentYear} \u5e74\u65f6\u7684\u6797\u6728\u8986\u76d6\u7387\u964d\u4f4e\u4e86 {percent}\uff0c\u4ea6\u76f8\u5f53\u4e8e {emissions} \u7684 CO\u2082 \u6392\u653e\u91cf\u3002", "c3211cf83d2f85c18abfc7a34dfd7f19": "\u622a\u81f3 2016 \u5e74\uff0c {location} \u7684\u6797\u6728\u8986\u76d6\u4e2d\u6709 {percentage} \u4e3a<b>\u539f\u59cb\u68ee\u6797</b>\u3002", "c594a3510e338a2e762ca70d23d1265c": "\u65e0\u9700\u53bb\u68ee\u6797\u5316\u7684\u5546\u54c1\u751f\u4ea7\u662f\u53ef\u884c\u7684\u3002\u7ecf\u8fc7\u6539\u5584\u540e\u7684\u68ee\u6797\u76d1\u6d4b\u5c06\u6709\u52a9\u4e8e\u5404\u516c\u53f8\u505a\u51fa\u66f4\u5177\u53ef\u6301\u7eed\u6027\u7684\u8d2d\u4e70\u51b3\u5b9a\u3001\u4fc3\u8fdb\u9488\u5bf9\u975e\u6cd5\u780d\u4f10\u7684\u884c\u52a8\uff0c\u5e76\u4f7f\u51b3\u7b56\u8005\u80fd\u591f\u5236\u5b9a\u66f4\u660e\u667a\u7684\u571f\u5730\u4f7f\u7528\u5206\u914d\u65b9\u6cd5\u3002", "697d996f0ca8f935418d595c70a37b02": "\u5e7f\u6cdb\u8986\u76d6", "484aceeb858133514ca7a4c85d3f7639": "\u67e5\u770b\u5580\u9ea6\u9686\u571f\u5730\u5229\u7528\u6570\u636e\u4e92\u52a8\u5730\u56fe\u3002", "e5e05b8cfb701a2e4a407de54df91a28": "\u67e5\u770b\u4e2d\u975e\u5171\u548c\u56fd\u5305\u542b\u571f\u5730\u4f7f\u7528\u6570\u636e\u7684\u4ea4\u4e92\u5730\u56fe\u3002", "67a0266e2c567c94d5aa777de84fae26": "\u67e5\u770b\u8d64\u9053\u51e0\u5185\u4e9a\u571f\u5730\u5229\u7528\u6570\u636e\u7684\u4ea4\u4e92\u5f0f\u5730\u56fe\u3002", "3cc6f81c1b64684efb2b77ee7ab87b19": "\u5317\u7f8e\u4e1c\u90e8\u65f6\u533a 9 \u6708 26 \u65e5\u4e0a\u5348 8:00\uff0c\u548c\u4e16\u754c\u8d44\u6e90\u7814\u7a76\u6240 (World Resource Institute) \u7684 Global Forest Watch \u4e00\u8d77\u5f00\u5c55\u7f51\u7edc\u7814\u8ba8\u4f1a\uff0c\u63a2\u8ba8 GFW \u4e0a\u7684\u706b\u707e\u6570\u636e\u548c\u6570\u636e\u7684\u6f5c\u5728\u7528\u4f8b\u3002<a href=\"{{0}}\">\u5728\u6b64\u62a5\u540d</a>\u3002", "52650a2079dd7622df5248658b35cedd": "\u7f51\u7edc\u7814\u8ba8\u4f1a\uff1a\u91ca\u653e\u706b\u707e\u6570\u636e\u7684\u80fd\u529b\uff1a\u76d1\u63a7", "c20465a90c3a4bd3d4ecfba2da8d72b7": "\u5fc5\u987b\u572810\u5230128\u4e2a\u5b57\u7b26\u4e4b\u95f4", "97d8f56bf41502f60ca6fdd5d5da8edc": "\u5b9a\u4e49", "2b1351f06413ffac5767fe6c84b073ac": "GFW Pro\u662f\u9002\u5408\u6211\u7684\u5e73\u53f0\u5417\uff1f", "0f98c90e4b9cf1dd82db439c63197705": "\u6211\u5e94\u8be5\u4ee5\u4f55\u79cd\u8bbe\u5907\u3001\u6d4f\u89c8\u5668\u548c\u7f51\u901f\u8fd0\u884cGFW Pro\uff1f", "e3a27766e057da58c120ecd249c2f4ed": "GFW Pro\u662f\u514d\u8d39\u7684\u5417\uff1f", "eb21b32f360d0b91f188219fb46f6b77": "\u548c\u8fd9\u4e2a", "2cd907b5745163fa3df342d391d75f42": "\u5982\u679c\u60a8\u662f\u88ab\u6dfb\u52a0\u5230\u73b0\u6709\u8d26\u53f7\u4e2d\u7684\u7528\u6237\uff0c\u8bf7\u786e\u8ba4\u60a8\u6240\u5728\u7ec4\u7ec7\u7684\u73b0\u6709Pro\u8d26\u53f7\u7ba1\u7406\u5458\u4e0d\u4ec5\u4e3a\u60a8<strong>\u521b\u5efa</strong>\u4e86\u65b0\u7684\u7528\u6237\u4e2a\u4eba\u8d44\u6599\uff0c\u8fd8\u8fd4\u56de\u4e86\u201d\u4e2a\u4eba\u8d44\u6599\u201c\u9875\u9762\uff0c\u5c06\u60a8<strong>\u6fc0\u6d3b</strong>\u4e3a\u73b0\u6709\u8d26\u53f7\u4e2d\u7684\u65b0\u7528\u6237\u3002", "ebdfb8738dbf9a0adf79bbd7763041b7": "\u5168\u7403", "c6797730dda30db280bdda846f000fa4": "\u5217\u8868\u542f\u7528\u7684\u6bcf\u79cd\u5217\u8868\u5206\u6790\u7c7b\u578b\u90fd\u5c06\u6d88\u8017\u5904\u7406\u516c\u9877\u6570\uff08HOP\uff09\u989d\u5ea6\uff0c\u5176\u6570\u503c\u7b49\u4e8e\u5217\u8868\u4e2d\u6bcf\u4e2a\u5730\u70b9\u603b\u9762\u79ef\u7684\u56db\u820d\u4e94\u5165\u6574\u6570\u503c\uff0c\u4ee5\u516c\u9877\u4e3a\u5355\u4f4d\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5217\u8868\u4ec5\u5305\u542b1\u4e2a\u9762\u79ef\u4e3a5\u516c\u9877\u7684\u5730\u70b9\uff08\u65e0\u8bba\u662f\u591a\u8fb9\u5f62\u8fd8\u662f\u5e26\u534a\u5f84\u7684\u70b9\uff09\uff0c\u4e14\u4ec5\u9009\u62e9\u4e861\u79cd\u5217\u8868\u5206\u6790\u7c7b\u578b\uff0c\u5219\u5217\u8868\u66f4\u65b0\u5c06\u6d88\u80175\u4e2aHOP\u3002\u5982\u679c\u5217\u8868\u542f\u7528\u4e863\u79cd\u5217\u8868\u5206\u6790\u7c7b\u578b\uff0c\u4e14\u5305\u542b5\u4e2a\u5730\u70b9\uff0c\u6bcf\u4e2a\u5730\u70b9\u9762\u79ef\u4e3a100\u516c\u9877\uff0c\u5219\u5c06\u6d88\u80171,500\u4e2aHOP\uff083 * 5 * 100\uff09\u3002&nbsp;", "09001523d44914d9ad3f8880992e62d8": "\u8d26\u53f7\u7ba1\u7406\u5458\u53ef\u53d1\u9001\u7535\u5b50\u90ae\u4ef6\u81f3<a href=\"{{0}}\" target=\"_blank\" rel=\"noreferrer noopener\">GFWPROsales@wri.org</a>\u8d2d\u4e70\u66f4\u591aMLA\u6216HOP\u989d\u5ea6\uff0c\u9644\u4e0a\u4f7f\u7528\u5957\u9910\u5217\u8868\u548c\u6240\u9700\u5957\u9910\u989d\u5ea6\u3002\u8d2d\u4e70\u83b7\u5f97\u6279\u51c6\u3001\u5b8c\u6210\u5e76\u786e\u8ba4\u4ed8\u6b3e\u540e\uff0cMLA\u6216HOP\u4e0a\u9650\u5c06\u589e\u52a0\u9002\u7528\u7684\u989d\u5ea6\uff0c\u5217\u8868\u66f4\u65b0\u529f\u80fd\u4e5f\u5c06\u91cd\u65b0\u542f\u7528\u3002\u7ba1\u7406\u5458\u53ef\u8bbf\u95eeGFW Pro\u4e2d\u201c\u6211\u7684\u4e2a\u4eba\u8d44\u6599\u201c&gt;\u201c\u4f7f\u7528\u91cf\u201d\u9875\u9762\uff0c\u76d1\u63a7\u5df2\u7528/\u53ef\u7528\u7684\u5206\u6790\u6b21\u6570\u548c\u5206\u6790\u9762\u79ef\uff0c\u4ee5\u53ca\u6bcf\u4e2a\u5e94\u7528\u7a0b\u5e8f\u7528\u6237\u7684\u76f8\u5bf9\u4f7f\u7528\u4efd\u989d\u3002<br>", "a2b2f04c84af5ac6585b4c520e30746d": "\u622a\u81f32020\u5e74\u5e95\u7684\u81ea\u7136\u68ee\u6797\u516c\u9877\u6570\u4ee5\u53ca\u5176\u540e\u635f\u5931\u7684\u516c\u9877\u6570\uff08\u6765\u81ea\u6bc1\u6797\u62a5\u544a\u5206\u6790\uff09\uff1b\u53ca&nbsp;", "ac2a5f72565793c13316c4d2b13b721c": "\u9605\u8bfb\u535a\u5ba2", "10cf2cfbee2ffdc38384a1a92dd89322": "\u6839\u636e FAO \u7684\u6570\u636e\uff0c{year} \u5e74\u6709 {value} \u4eba\u5728 {location} \u6797\u4e1a\u90e8\u95e8\u5de5\u4f5c\u3002", "f2fa06467fcae70a2c833f2d224896b3": "\u6c38\u4e45\u6027\u68ee\u6797\u780d\u4f10\u7684\u9a71\u52a8\u56e0\u7d20\u4e3b\u8981\u662f\u57ce\u5e02\u5316\u548c\u5546\u54c1\u9a71\u52a8\u7684\u68ee\u6797\u780d\u4f10\u3002\u519c\u4e1a\u8f6e\u57a6\u53ef\u80fd\u4f1a\u4e5f\u53ef\u80fd\u4e0d\u4f1a\u5bfc\u81f4\u68ee\u6797\u780d\u4f10\uff0c\u5177\u4f53\u53d6\u51b3\u4e8e\u519c\u4e1a\u6d3b\u52a8\u7684\u5f71\u54cd\u548c\u8868\u73b0\u3002", "88103a345d2b3a16598277a790ec3475": "{location} \u7684\u5730\u9762\u6d3b\u6728\u8d28\u751f\u7269\u91cf", "d1f4364727f7b782828a89707c603e5b": "FAO \u7684 {location} \u68ee\u6797\u8986\u76d6", "993a4999bb5af54661034164445deeca": "{location} \u7684\u539f\u59cb\u68ee\u6797", "4d36bb2da7b25eedbc34bf698e115581": "\u901a\u8fc7\u590d\u5236\u94fe\u63a5\u6216\u8005\u5728\u5176\u4ed6\u7f51\u7ad9\u4e2d\u5d4c\u5165\u60a8\u7684\u5730\u56fe\u89c6\u56fe\u6765\u5171\u4eab\u6b64\u5206\u6790\u3002", "bd07f2d4f133437bc9edd96b21f6b43c": "\u6ca1\u6709 {location} \u7684\u68ee\u6797\u518d\u9020\u6570\u636e\u3002", "4898e8ef42db6c4cde8cd07674020b53": "FAO \u7684 {location} \u68ee\u6797\u780d\u4f10", "1b6714ccd8e6dfb9380a926c83f7b24f": "{location} \u7684\u6811\u6728\u8986\u76d6\u51cf\u5c11\u4e0e\u5176\u4ed6\u533a\u57df\u5bf9\u6bd4", "8429f4d1cdbfd86647c83c21f95e24d8": "\u5730\u56fe\u5f52\