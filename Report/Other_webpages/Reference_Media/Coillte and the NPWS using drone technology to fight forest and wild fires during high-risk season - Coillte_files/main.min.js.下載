     * @param second_key - String
     * @param second_val - String
    */
    function update_url_params(current_key, current_val, second_key, second_val, third_key, third_val) {
      if (third_val) {
        window.location.href = window.location.pathname + '?paged=1&' + current_key + '=' + encodeURIComponent(current_val) + '&' + second_key + '=' + encodeURIComponent(second_val) + '&' + third_key + '=' + encodeURIComponent(third_val);
      } else if (second_val) {
        window.location.href = window.location.pathname + '?paged=1&' + current_key + '=' + encodeURIComponent(current_val) + '&' + second_key + '=' + encodeURIComponent(second_val);
