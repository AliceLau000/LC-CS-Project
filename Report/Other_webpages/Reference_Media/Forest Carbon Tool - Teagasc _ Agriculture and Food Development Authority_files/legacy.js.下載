    // Accessibility helper function for Slick sliders
    function manageSliderAccessibility($slider) {
        // Function to update tabindex on slides
        function updateSlideAccessibility() {
            $slider.find('.slick-slide, .slick-dots li').each(function() {
                var $slide = $(this);
                var isVisible = !$slide.attr('aria-hidden') || $slide.attr('aria-hidden') === 'false';
                
                // Find all focusable elements in the slide or dot
                var focusableElements = $slide.find('a, button, input, select, textarea, [tabindex]:not([tabindex="-1"]), [role="button"]');
                
                // Also check if the slide itself is focusable
                if ($slide.is('a, button, input, select, textarea, [tabindex]:not([tabindex="-1"]), [role="button"]')) {
                    focusableElements = focusableElements.add($slide);
                }
                
                if (isVisible) {
                    // Make focusable elements accessible
                    focusableElements.each(function() {
                        var $el = $(this);
                        var originalTabindex = $el.data('original-tabindex');
                        if (originalTabindex !== undefined) {
                            $el.attr('tabindex', originalTabindex);
                        } else {
                            $el.removeAttr('tabindex');
                        }
                    });
                } else {
                    // Make focusable elements inaccessible
                    focusableElements.each(function() {
                        var $el = $(this);
                        if (!$el.data('original-tabindex')) {
                            $el.data('original-tabindex', $el.attr('tabindex') || '0');
                        }
                        $el.attr('tabindex', '-1');
                    });
                }
            });
        }

        // Set up event listeners
        $slider.on('afterChange', updateSlideAccessibility);
        $slider.on('init', updateSlideAccessibility);
        
        // Initial setup if slider is already initialized
        if ($slider.hasClass('slick-initialized')) {
            updateSlideAccessibility();
        }
    }

    // Apply accessibility management to all slick sliders
    function initGlobalSliderAccessibility() {
        // Wait for all sliders to initialize, then apply accessibility
        setTimeout(function() {
            $('.slick-initialized').each(function() {
                manageSliderAccessibility($(this));
            });
        }, 100);
    }

