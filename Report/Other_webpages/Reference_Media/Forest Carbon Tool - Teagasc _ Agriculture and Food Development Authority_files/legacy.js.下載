    // Navigation Toggle Handlers
    function initNavigationToggles() {


        // The click handlers map
        //  key is the element to bind the onclick event to
        //  value is the target
        var clickHandlers = {
            '#toggle-nav-organisation' : '#nav-organisation',
            '#toggle-search' : '#search-site',
            '#toggle-secondary' : '#content-secondary-inner',
            '#toggle-quicklinks' : '#quicklinks',
            '#toggle-topics' : '#nav-topics'
        };

        var activeClass = 'active';

        // Loop through all the click handlers and bind the event
        $.each(clickHandlers, function(clickHandler, target) {

            $(clickHandler).on('click', function(event) {
            
                event.preventDefault();

                var previouslyVisible = $(target).is(':visible');
                $('.toggle-close').hide();

                // Remove active state from all other menus
                $.each(clickHandlers, function(clickHandlers2, target2) {
                    $(clickHandlers2).removeClass(activeClass);
                });

                if (previouslyVisible === false) {
                    $(target).show();
                    $(this).addClass(activeClass);
                }
            });
        });

        // Handles the opening of the mega mobile navigation menu
        var navTopics = $('#nav-topics');

        navTopics.find("> ul > li > a").on('click', function(event) {

            event.preventDefault();

            if($(this).parent().hasClass('active')) {
              $('.header-lower-sub-menu-container').hide();
              $(this).parent().removeClass('active')
            } else {
            // Remove active class from all other list items
              var activeClass = 'active';
              navTopics.find('> ul > li').removeClass(activeClass);
              $('.header-lower-sub-menu-container').hide();
              $(this).parent().addClass(activeClass);

              var subNav = $(this).next('.header-lower-sub-menu-container');
              subNav.show();
            }

        });
    }

    // Display png instead of svg
    function initTabs(){
        $('ul.nav-tabs').each(function(){
        // For each set of tabs, we want to keep track of
        // which tab is active and it's associated content
        var $active, $content, $links = $(this).find('a');

        // If the location.hash matches one of the links, use that as the active tab.
        // If no match is found, use the first link as the initial active tab.
        $active = $($links.filter('[href="'+location.hash+'"]')[0] || $links[0]);
        $active.addClass('active');

        $content = $($active[0].hash);

        // Hide the remaining content
        $links.not($active).each(function () {
          $(this.hash).hide();
        });

        // Bind the click event handler
        $(this).on('click', 'a', function(e){
          // Make the old tab inactive.
          $active.removeClass('active');
          $content.hide();

          // Update the variables with the new link and content
          $active = $(this);
          $content = $(this.hash);

          // Make the tab active.
          $active.addClass('active');
          $content.show();

          // Prevent the anchor's default click action
          e.preventDefault();
        });
      });
    }

